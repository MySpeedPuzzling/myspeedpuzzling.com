# The barcode scanner's zbar files (docs/features/barcode-scanner/README.md §5.9): the exact npm bytes of
# @undecaf/zbar-wasm and @undecaf/barcode-detector-polyfill, committed under public/barcode-scanner/ in a versioned
# directory. A path never changes its bytes - a new version is a new directory - so they are immutable for a year.
# Outside /build/ and /fonts/, so the service worker never touches them (no CACHE_VERSION bump, ever).
#
# Like online-detector.caddyfile: a site block of its own for a path of the base `:8080` address - Caddy tries the
# site with the longer path first, so the base block's php_server never sees these.
:8080/barcode-scanner/* {
	root * /app/public

	# Existing files only - a 404 must never be pinned for a year
	@file file
	header @file Cache-Control "public, max-age=31536000, immutable"

	@missing not file
	header @missing Cache-Control "no-store"

	# zbar.wasm (239 KB) compresses to about half; .wasm and .js get their types from /etc/mime.types
	encode zstd br gzip

	file_server
}
