APP_ENV=dev
APP_DEBUG=true
APP_SECRET=dummy
APP_URL=http://localhost:8080/
TRUSTED_PROXIES=PRIVATE_SUBNETS

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/speedpuzzling?serverVersion=16&charset=utf8"
LOCK_DSN="postgresql+advisory://postgres:postgres@postgres:5432/speedpuzzling?serverVersion=16&charset=utf8"
MESSENGER_TRANSPORT_DSN=doctrine://default

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
PROFILING_TRIGGER_SECRET=

MERCURE_JWT_SECRET="dummy-local-secret-key-for-development-only!"
MERCURE_URL="http://mercure/.well-known/mercure"
MERCURE_PUBLIC_URL="http://localhost:8082/.well-known/mercure"

###> pairs & teams (docs/features/pairs-and-teams/README.md) ###
# The Solo / Pair / Team picker of the add/edit time form. Public since launch (2026-09-20); set to 0 to fall
# back to the old co-puzzler rows for everybody but admins - the kill switch if the picker misbehaves.
PAIRS_TEAMS_PICKER_PUBLIC=1
###< pairs & teams ###

###> online competitions (docs/features/online-competitions/) ###
# Who may set up online timing of a round (OnlineRoundsFeature): admins always, the event's organisers only while
# this is 1. Off until the first public online competition - the test cups are set up by admins.
ONLINE_ROUNDS_FOR_ORGANISERS=0
# Evidence uploads (README §5.11, OnlineMediaStores): participant phones PUT photos straight into the S3_BUCKET through
# presigned URLs made for this endpoint - a browser must reach it. Empty = S3_ENDPOINT (production: Hetzner's endpoint
# is public). Locally compose.yml sets MinIO's host port (MINIO_API_PORT) - or put your LAN address into .env.local when
# testing with a phone. Keep this default empty: production has no override and must fall back to S3_ENDPOINT.
ONLINE_MEDIA_PUBLIC_ENDPOINT=
# The optional second store taking new uploads while the primary is down (Garage / SeaweedFS, OnlineStoreBreaker) -
# an empty endpoint = none. Its one endpoint must be public too.
ONLINE_MEDIA_SECONDARY_ENDPOINT=
ONLINE_MEDIA_SECONDARY_REGION=
ONLINE_MEDIA_SECONDARY_BUCKET=
ONLINE_MEDIA_SECONDARY_ACCESS_KEY=
ONLINE_MEDIA_SECONDARY_SECRET_KEY=
ONLINE_MEDIA_SECONDARY_PATH_STYLE=1
# Live video (README §5.12, LiveKitSettings): the self-hosted LiveKit server of the puzzle cameras, the host's voice,
# the studio and the spectators. An empty LIVEKIT_API_URL = video off: every video endpoint answers 409
# `video_unavailable` and no page shows video - production stays like this until its own server exists (ADR D78).
# All four values are needed, the secret at least 32 characters (HS256). To turn it on locally, put these four lines
# into .env.local (without the "# ") and start the server: `docker compose --profile video up -d livekit`
# (config/livekit/dev.yaml; with LIVEKIT_PORT changed, change the port of LIVEKIT_PUBLIC_URL too):
#   LIVEKIT_API_URL=http://livekit:7880
#   LIVEKIT_PUBLIC_URL=ws://localhost:7880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=devsecret-msp-local-livekit-not-for-production
LIVEKIT_API_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The public watch page's cap on spectators per studio (studio_full above it) until Phase 4's HLS - empty = 200
ONLINE_WATCH_MAX_SPECTATORS=
###< online competitions ###

###> social login (auth hardening PR 2, docs/features/auth-hardening/README.md) ###
# A provider is available iff its credentials are set (Google and Microsoft:
# id + secret, Facebook: app id + secret, Apple: client/team/key id + private
# key) - empty here, so local dev and tests show no social button. Real values
# live in Infisical.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# APPLE_CLIENT_ID is the Services ID; APPLE_PRIVATE_KEY holds the .p8 key CONTENT
# (with literal \n newlines), not a file path.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# The primary App ID (bundle id) the Services ID is grouped under: the `aud` of
# Apple's server-to-server notifications (POST /webhook/apple-sign-in). Not secret.
APPLE_APP_ID=
# Microsoft (personal accounts only, docs/features/auth-hardening/setup-microsoft.md):
# the app registration's Application (client) ID + a client secret VALUE. The
# client id also feeds /.well-known/microsoft-identity-association.json.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# YYYY-MM-DD from the portal's "Expires" column: a warning (Sentry) is logged
# daily from 30 days before, an error once expired. Empty = no reminder.
MICROSOFT_CLIENT_SECRET_EXPIRES_AT=
###< social login ###

GA_TRACKING=

UPLOADS_BASE_URL=http://localhost:19000

NGINX_PROXY_BASE_URL=http://localhost:19100
NGINX_PROXY_INTERNAL_URL=http://images-cache:80

S3_REGION=global
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=speedpuzzling
S3_SECRET_KEY=speedpuzzling
S3_BUCKET=puzzle

REDIS_CACHE_DSN=redis://redis:6379/1
# API usage counters (docs/features/api/usage-statistics.md): their own Redis -
# noeviction + AOF, where the cache Redis above is LRU without persistence
REDIS_STATE_DSN=redis://redis-state:6379

PUZZLE_PUZZLE_USERNAME=
PUZZLE_PUZZLE_PASSWORD=

MAILER_TRANSACTIONAL_DSN=smtp://mailer:1025
MAILER_NOTIFICATIONS_DSN=smtp://mailer:1025
BOUNCE_EMAIL_DOMAIN=

###> listmonk (newsletter engine) ###
# Empty LISTMONK_API_TOKEN disables the whole integration (closed-by-default).
# Dev credentials are seeded by the listmonk-seed compose service; production
# values come from Infisical (api-msp-web user on listmonk.myspeedpuzzling.com).
LISTMONK_API_URL=http://listmonk:9000
LISTMONK_API_USER=api-dev
LISTMONK_API_TOKEN=MVNawj1IBdVcCPvwfTd5GSsjT44HUMot
###< listmonk ###

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

###> WJPF player pairing (worldjigsawpuzzle.org) ###
# Shared static token, used in BOTH directions: our outbound lookups against their
# users_pr.php, and their inbound calls to POST /api/v0/wjpf-pairing.
# Empty token = integration disabled (closed-by-default), which is the dev default.
# Production value comes from Infisical.
WJPF_API_URL=https://worldjigsawpuzzle.org/users/users_pr.php
WJPF_API_TOKEN=
# Where /connect/wjpf hands the member back after they confirm. Configuration, never taken
# from the request - a caller-supplied redirect target right after a login prompt is the
# textbook open-redirect/phishing primitive. Empty disables the manual flow (404).
WJPF_PAIR_REDIRECT_URL=https://worldjigsawpuzzle.org/users/users_pr.php?accion=msp_pair_redirect
###< WJPF player pairing ###

# Static bearer token for the internal admin API (/internal-api/*).
# Leave empty to disable the API entirely (closed-by-default).
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Player credited as the reviewer for moderation done through the internal API
# (puzzle merge approvals/rejections). The API has no logged-in user of its own,
# so decisions are attributed to this player. Leave empty to disable those endpoints.
INTERNAL_API_REVIEWER_PLAYER_ID=

# Kudos: players whose karma shows as "∞", golden (comma-separated player ids, display only - InfiniteKarma).
# Set on production in the lily.srv compose file, never here (the repository is public).
KARMA_INFINITE_PLAYER_IDS=

