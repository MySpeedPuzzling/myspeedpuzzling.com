SENTRY_PROFILES_SAMPLE_RATE=0.0
PROFILING_TRIGGER_SECRET=

MERCURE_JWT_SECRET="dummy-local-secret-key-for-development-only!"
MERCURE_URL="http://mercure/.well-known/mercure"
MERCURE_PUBLIC_URL="http://localhost:8082/.well-known/mercure"

# Dev application
# Whitelisted domain is only localhost:8080
AUTH0_DOMAIN=speedpuzzling-dev.eu.auth0.com
AUTH0_CLIENT_ID=MMpjtzm78zdnhVdPv8p696QqxvMMAaxc
AUTH0_CLIENT_SECRET=gM0tToggyu5E9-R6a01-y-VLn-QmYumqXIPDcC3HB2IvPxolndSBeajiMDsR59bg

# Name of the Auth0 database connection, used to send password change emails.
# Must match the connection name in the Auth0 dashboard for the tenant above.
AUTH0_DB_CONNECTION=Username-Password-Authentication

AUTH0_ROUTE_CALLBACK=callback
AUTH0_ROUTE_SUCCESS=my_profile
AUTH0_ROUTE_FAILURE=homepage
AUTH0_ROUTE_LOGIN=login
AUTH0_ROUTE_LOGOUT=app_logout

# Auth0 -> native auth migration flags (issue #147). Deploy dark, flip via env.
# See docs/features/feature_flags.md for what each stage flips.
# NATIVE_REGISTRATION_ENABLED=1 is the Stage A flip (2026-07-30): native /register
# goes live on the deploy that carries it; Auth0 signups are frozen tenant-side.
# The test env inherits this baseline (tests face what users face; the other side
# of each flag is covered by explicit per-test overrides). Emergency rollback
# without a revert: set NATIVE_REGISTRATION_ENABLED=0 in the box .env (real env
# beats this file).
NATIVE_REGISTRATION_ENABLED=1
# NATIVE_LOGIN_ENABLED=1 is the Stage B flip (2026-07-30, same day as the hash
# import): /login serves the native form, Auth0 interactive login retires.
NATIVE_LOGIN_ENABLED=1
AUTH0_TRICKLE_LOGIN_ENABLED=0
# Transition-window escape hatch (Stage B -> Phase 6): keeps a subdued
# "old Auth0 sign-in" link on the native login page at /login/auth0.
# Retires with the Auth0 stack in Phase 6.
AUTH0_FALLBACK_LOGIN_ENABLED=1
# Advance notice about the sign-in migration. Unlike the flags above this one is
# ON: it announces the change to users before anything moves. Flip to 0 to retire
# the banner (the explainer page stays reachable either way).
SIGN_IN_CHANGES_NOTICE_ENABLED=1

###> social login (auth hardening PR 2, docs/features/auth-hardening/README.md) ###
# Staged rollout: while ADMIN_ONLY=1 no social buttons render for anyone (the
# /login and /register pages are anonymously cached and must stay uniform),
# admins test via the direct /login/social/{provider} URLs, the callback denies
# non-admin accounts, and social registration (rule 4) is disabled entirely.
# Flip to 0 after verifying every provider end-to-end = public launch.
SOCIAL_LOGIN_ADMIN_ONLY=1
# One flag per provider - code ships dark, flipped via Infisical once the
# provider console setup is done. Credentials stay empty in the repo.
SOCIAL_LOGIN_GOOGLE_ENABLED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SOCIAL_LOGIN_FACEBOOK_ENABLED=0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
SOCIAL_LOGIN_APPLE_ENABLED=0
# APPLE_CLIENT_ID is the Services ID; APPLE_PRIVATE_KEY holds the .p8 key CONTENT
# (with literal \n newlines), not a file path.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
###< social login ###

GA_TRACKING=

UPLOADS_BASE_URL=http://localhost:19000

NGINX_PROXY_BASE_URL=http://localhost:19100
NGINX_PROXY_INTERNAL_URL=http://images-cache:80

S3_REGION=global
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=speedpuzzling
S3_SECRET_KEY=speedpuzzling
S3_BUCKET=puzzle

REDIS_CACHE_DSN=redis://redis:6379/1

PUZZLE_PUZZLE_USERNAME=
PUZZLE_PUZZLE_PASSWORD=

MAILER_TRANSACTIONAL_DSN=smtp://mailer:1025
MAILER_NOTIFICATIONS_DSN=smtp://mailer:1025
BOUNCE_EMAIL_DOMAIN=

###> listmonk (newsletter engine) ###
# Empty LISTMONK_API_TOKEN disables the whole integration (closed-by-default).
# Dev credentials are seeded by the listmonk-seed compose service; production
# values come from Infisical (api-msp-web user on listmonk.myspeedpuzzling.com).
LISTMONK_API_URL=http://listmonk:9000
LISTMONK_API_USER=api-dev
LISTMONK_API_TOKEN=MVNawj1IBdVcCPvwfTd5GSsjT44HUMot
###< listmonk ###

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

###> WJPF player pairing (worldjigsawpuzzle.org) ###
# Shared static token, used in BOTH directions: our outbound lookups against their
# users_pr.php, and their inbound calls to POST /api/v0/wjpf-pairing.
# Empty token = integration disabled (closed-by-default), which is the dev default.
# Production value comes from Infisical.
WJPF_API_URL=https://worldjigsawpuzzle.org/users/users_pr.php
WJPF_API_TOKEN=
# Where /connect/wjpf hands the member back after they confirm. Configuration, never taken
# from the request - a caller-supplied redirect target right after a login prompt is the
# textbook open-redirect/phishing primitive. Empty disables the manual flow (404).
WJPF_PAIR_REDIRECT_URL=https://worldjigsawpuzzle.org/users/users_pr.php?accion=msp_pair_redirect
###< WJPF player pairing ###

# Static bearer token for the internal admin API (/internal-api/*).
# Leave empty to disable the API entirely (closed-by-default).
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=

