KERNEL_CLASS=SpeedPuzzling\Web\SymfonyApplicationKernel

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/speedpuzzling_test?serverVersion=16&charset=utf8"

LOCK_DSN="in-memory"

# Tests must never talk to a real Listmonk - empty token disables the integration
LISTMONK_API_TOKEN=

# Pinned so the inbound pairing endpoint is reachable in functional tests. Outbound
# calls never leave the process: WjpfClient is only exercised through MockHttpClient.
WJPF_API_TOKEN=test-wjpf-token

###> symfony/panther ###
# The Panther-managed web server (CI / local ChromeDriver path) must run the same
# `test` env as the web-test container does in Docker: the recipe default `panther`
# env loads neither config/packages/test/ (so the /_test/login controller does not
# exist and every logged-in test 404s) nor the per-test database override in
# public/index.php (gated on APP_ENV === 'test' and hardened 2026-07-30 against
# putenv/stat-cache leakage across requests in long-lived server processes).
PANTHER_APP_ENV=test
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
PANTHER_DEVTOOLS=0
###< symfony/panther ###

# Manual pairing flow needs a return URL to exist; kept identical to the .env default
# so functional tests assert the real redirect shape.
WJPF_PAIR_REDIRECT_URL=https://worldjigsawpuzzle.org/users/users_pr.php?accion=msp_pair_redirect

# The internal admin API (/internal-api/*) in functional tests: a dummy token, acting as
# the admin fixture player (PlayerFixture::PLAYER_ADMIN) - never a real token
INTERNAL_API_TOKEN=test-internal-api-token
INTERNAL_API_REVIEWER_PLAYER_ID=018d0000-0000-0000-0000-000000000003
# The Times boards' guest cache: off (query tests read a board twice within one kernel)
TIMES_BOARD_GUEST_CACHE=0

# Live video in functional tests: on, with made-up values - LiveKit's server API answers from LiveKitHttpMock
# (config/services_test.php), no test talks to a real server. Tests of "video off" empty LIVEKIT_API_URL themselves.
LIVEKIT_API_URL=http://livekit.test:7880
LIVEKIT_PUBLIC_URL=wss://livekit.test
LIVEKIT_API_KEY=test-livekit-key
LIVEKIT_API_SECRET=test-livekit-secret-of-at-least-32-characters
# The SES events endpoint (/-/ses-events) in functional tests: a made-up topic, messages signed with the test key
# of tests/SignsSnsMessages.php (the certificate comes from SnsHttpMock, never from AWS)
SES_EVENTS_TOPIC_ARNS=arn:aws:sns:eu-central-1:000000000000:msp-ses-events-test
# The completeness check of finish photos (Phase 3): off like production - tests of it turn it on themselves
# (tests/OnlineCvTesting.php), the CV worker answering from OnlineCvHttpMock (config/services_test.php)
ONLINE_CV_URL=

# Turnstile on in functional tests with made-up keys - siteverify answers from TurnstileHttpMock
# (config/services_test.php), no test talks to Cloudflare
TURNSTILE_SITE_KEY=test-turnstile-site-key
TURNSTILE_SECRET_KEY=test-turnstile-secret-key
# The candidate model's rows (v4): off like production - the tests that measure them switch it on
# (CandidatePredictionsSideBySideTest), so every other test's query budget is the production default's
PREDICTION_CANDIDATE_ROWS=0
# The pair/team model's rows: off like production (GroupPredictionModelTest writes them with --rows)
PREDICTION_GROUP_ROWS=0
