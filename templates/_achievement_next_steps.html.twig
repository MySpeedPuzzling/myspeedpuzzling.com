{#
    "Closest next steps" (docs/features/xp-levels/ux-polish/design-spec.md §1, amended by §8.6): the tiers the viewer is
    nearest to - on their own achievements page and on the members' catalogue only, never on somebody else's page.
    Compact: the next tier's seal in grey at 40 px, "Name → Tier", the bar with the numbers right-aligned; the
    requirement and the AP it brings join from 992 px (the side column). A row opens the sheet at that tier.
    The only bars that fill when seen (data-progress-fill-target="bar" - the page wraps it in data-controller="progress-fill").

    Inputs:
      - rows (list<AchievementCatalogueRow>): the steps, at most 3 (AchievementCatalogueLists::$closest)
      - title (string): the heading - "Closest next steps", or "Your first one is close" for the empty state
      - player_id (null|string): whose medal the sheet shows (the owner's page), null on the catalogue
#}
<section class="achievements-next" aria-labelledby="achievements-next-title">
    <h2 class="achievements-next-title" id="achievements-next-title">{{ title }}</h2>
    <ul class="achievements-next-list">
        {% for row in rows %}
            {%- set name = row.type.translationKey()|trans -%}
            {%- set next_tier = row.progress.nextTier -%}
            {%- set next_name = next_tier.translationKey()|trans -%}
            {%- if row.progress.unit.value == 'seconds' -%}
                {%- set numbers = row.progress.currentValue|puzzlingTime ~ ' → ' ~ row.progress.targetValue|puzzlingTime -%}
                {%- set progress_label = 'badges.shelf.a11y.progress_time'|trans({'%current%': row.progress.currentValue|puzzlingTime, '%target%': row.progress.targetValue|puzzlingTime, '%tier%': next_name}) -%}
            {%- else -%}
                {%- set numbers = row.progress.currentValue|plain_number ~ ' / ' ~ row.progress.targetValue|plain_number -%}
                {%- set progress_label = 'badges.shelf.a11y.progress'|trans({'%current%': row.progress.currentValue|plain_number, '%target%': row.progress.targetValue|plain_number, '%tier%': next_name}) -%}
            {%- endif -%}
            <li>
                <a href="{{ path('achievement_info', {type: row.type.value, tier: next_tier.value, player: player_id|default(null), from: 'shelf'}|merge(sheet_return|default({}))) }}"
                   data-turbo-frame="{{ layer_frame('modal-frame') }}" class="achievements-next-row"
                   aria-label="{{ name }} → {{ next_name }}, {{ progress_label }}">
                    {{ badge_art(row.type, next_tier, 40, locked = true, attrs = {alt: ''}) }}
                    <span class="achievements-next-body" aria-hidden="true">
                        <span class="achievements-next-name">{{ name }} → {{ next_name }}</span>
                        <span class="achievements-next-requirement">{{ ('badges.requirement.' ~ row.type.value ~ '_' ~ next_tier.value)|trans }} · +{{ next_tier.points|plain_number }} AP</span>
                        <span class="achievements-next-progress">
                            <span class="achievement-progress" role="progressbar" aria-valuenow="{{ row.progress.percent }}" aria-valuemin="0" aria-valuemax="100">
                                <span style="width: {{ row.progress.percent }}%" data-progress-fill-target="bar"></span>
                            </span>
                            <span class="achievements-next-numbers">{{ numbers }}</span>
                        </span>
                    </span>
                </a>
            </li>
        {% endfor %}
    </ul>
</section>
