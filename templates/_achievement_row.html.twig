{#
    One row of an achievements list (the catalogue badges_overview, a player's achievements page): badge, name → next
    tier, progress, requirement as text, rarity. Opens the achievement's info modal - or, for the owner's unrevealed
    tier, the reveal page.

    Inputs: row (AchievementCatalogueRow), personal (bool: the row shows a member's own tiers)
#}
{% set name = row.type.translationKey()|trans %}
{% set focus_tier = row.focusTier() %}
{% if row.unrevealed %}
<a href="{{ path('badge_reveals') }}" class="achievement-row">
    <span class="badge-art-mystery flex-shrink-0" style="--badge-art-size: 56px;" aria-hidden="true">?</span>
{% else %}
<a href="{{ path('achievement_info', {type: row.type.value}) }}" data-turbo-frame="modal-frame" class="achievement-row">
    {{ badge_art(row.type, row.displayTier, 56, locked = personal and row.earnedTier is null) }}
{% endif %}

    <span class="achievement-row-body">
        <span class="achievement-row-title d-block">
            {{ name }}
            {% if row.progress is not null %}
                <span class="achievement-row-next">→ {{ row.progress.nextTier.translationKey()|trans }}</span>
            {% elseif row.unrevealed %}
                <span class="achievement-row-next">· {{ 'badges.reveal'|trans }}</span>
            {% elseif row.earnedTier is not null %}
                <span class="achievement-row-next">· {{ row.earnedTier.translationKey()|trans }}</span>
            {% endif %}
        </span>

        {% if row.progress is not null %}
            <span class="achievement-progress d-block" role="progressbar"
                  aria-label="{{ 'badges.catalogue.progress_label'|trans({'%achievement%': name, '%tier%': row.progress.nextTier.translationKey()|trans}) }}"
                  aria-valuenow="{{ row.progress.percent }}" aria-valuemin="0" aria-valuemax="100">
                <span style="width: {{ row.progress.percent }}%"></span>
            </span>
            <span class="achievement-row-meta d-block">
                {{ include('_achievement_progress_numbers.html.twig', {progress: row.progress}) }}
                <span aria-hidden="true">·</span>
                {{ ('badges.requirement.' ~ row.type.value ~ '_' ~ row.progress.nextTier.value)|trans }}
                <span aria-hidden="true">·</span>
                <span class="text-nowrap">+{{ row.progress.nextTier.points }} AP</span>
            </span>
        {% elseif row.isComplete %}
            <span class="achievement-row-meta d-block">
                {{ 'badges.highest_earned'|trans }}
                <span aria-hidden="true">·</span>
                {{ include('_achievement_rarity.html.twig', {percent: row.rarityPercent}) }}
            </span>
        {% else %}
            <span class="achievement-row-meta d-block">
                {{ focus_tier.translationKey()|trans }}: {{ ('badges.requirement.' ~ row.type.value ~ '_' ~ focus_tier.value)|trans }}
                <span aria-hidden="true">·</span>
                {{ include('_achievement_rarity.html.twig', {percent: row.rarityPercent}) }}
            </span>
        {% endif %}
    </span>

    <i class="bi bi-chevron-right text-body-secondary flex-shrink-0" aria-hidden="true"></i>
</a>
