{% extends 'base.html.twig' %}

{# Shared frame of the sign-in / sign-up pages (docs/features/auth-ux-redesign.md):
   one borderless column (max 440px) - on a phone the page IS the form, no card -
   and the illustration next to it from md up.

   auth-email-handoff carries the typed address between these pages in
   sessionStorage (never in a URL); last-sign-in marks the method this device
   used last. Both are client-side only, so the pages stay session-free. #}

{# No bars on these pages (NAV-08, README §4.10, decision 25): the minimal header (logo + language) instead of the top
   bar, and neither the bottom bar, the Menu nor its shell - their search fields would be text inputs next to the form
   (iOS Password AutoFill on the code page). body.no-nav-chrome keeps the desktop column's width at 0 #}
{% set nav_chrome_off = true %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block header %}{% if is_web() %}{{ include('navigation/_auth_header.html.twig') }}{% endif %}{% endblock %}
{% block nav_chrome %}{% endblock %}
{% block nav_layers %}{% endblock %}

{# No newsletter e-mail field in the footer: a sign-in page must hold no text
   input but its own, or iOS Password AutoFill offers the saved login over the
   one-time code (sign_in_link_sent.html.twig) #}
{% block footer_newsletter %}{% endblock %}

{# No "Something wrong on this page? Tell us" line on the sign-in / sign-up pages (HELP-04) #}
{% block page_help_line %}{% endblock %}

{% block content %}
    <div class="row pb-2 auth-frame" data-controller="auth-email-handoff last-sign-in">
        <div class="col-md-7 col-lg-6">
            <div class="auth-page">
                {% block auth_content %}{% endblock %}
            </div>
        </div>

        <div class="col-md-5 offset-lg-1 d-none d-md-block text-center auth-illustration">
            <img class="img-fluid" src="{{ asset('img/puzzlie-1.png') }}" alt="" width="1000" height="949">
        </div>
    </div>
{% endblock %}
