{# blocked_users: rows of GetUserBlocks::forPlayer(). No profile links - a blocked player's profile is a 404 for the blocker. #}
<div class="list-group">
    {% for user in blocked_users %}
        <div class="list-group-item d-flex align-items-center justify-content-between py-3 gap-2">
            <div class="d-flex align-items-center min-width-0">
                <div class="me-2 me-sm-3 flex-shrink-0">
                    {{ include('messaging/_avatar.html.twig', {avatar: user.blocked_avatar, size: 48}) }}
                </div>
                <div class="min-width-0">
                    <span class="fw-bold">{{ user.blocked_name ?? user.blocked_code }}</span>
                    <code class="ms-1">#{{ user.blocked_code|upper }}</code>
                    {% if user.blocked_country %}
                        <span class="fi fi-{{ user.blocked_country }} shadow-custom ms-1" style="font-size: 0.75rem;"></span>
                    {% endif %}
                    <div class="text-muted small text-truncate">{{ 'blocklist.blocked_on'|trans }} {{ user.blocked_at|format_datetime('medium', 'none') }}</div>
                </div>
            </div>
            <form action="{{ path('unblock_user', {playerId: user.blocked_id}) }}" method="post" class="flex-shrink-0">
                <input type="hidden" name="_token" value="{{ csrf_token(constant('SpeedPuzzling\\Web\\Controller\\Messaging\\UnblockUserController::CSRF_TOKEN_ID')) }}">
                <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('{{ 'blocklist.unblock_confirm'|trans|e('js') }}')">
                    {{ 'blocklist.unblock'|trans }}
                </button>
            </form>
        </div>
    {% endfor %}
</div>
