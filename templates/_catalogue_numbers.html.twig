{# The puzzle database in four numbers (CatalogueNumbersProvider, 6 h snapshot).
   Expects `catalogue`; `variant`: 'cards' (tracker page) or 'compact' (homepage section).
   Each label is pluralised by its own number and the numbers follow the page's locale. #}
{% set catalogue_items = [
    {count: catalogue.puzzles, label: 'catalogue_numbers.puzzles'},
    {count: catalogue.brands, label: 'catalogue_numbers.brands'},
    {count: catalogue.puzzlesWithEan, label: 'catalogue_numbers.puzzles_with_ean'},
    {count: catalogue.solveTimes, label: 'catalogue_numbers.solve_times'},
] %}

{% if variant|default('cards') == 'compact' %}
    <ul class="catalogue-numbers list-unstyled row g-2 mt-3 mb-0">
        {% for item in catalogue_items %}
            <li class="col-6">
                <strong class="text-primary text-nowrap">{{ item.count|format_number([], 'decimal', 'default', app.request.locale) }}</strong>
                <span class="small">{{ item.label|trans({'%count%': item.count}) }}</span>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <ul class="catalogue-numbers list-unstyled row g-3 g-md-4 justify-content-center text-center mb-0">
        {% for item in catalogue_items %}
            <li class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <strong class="d-block fs-2 fw-bold text-primary mb-1 tabular-nums text-nowrap">{{ item.count|format_number([], 'decimal', 'default', app.request.locale) }}</strong>
                        <span class="text-muted">{{ item.label|trans({'%count%': item.count}) }}</span>
                    </div>
                </div>
            </li>
        {% endfor %}
    </ul>
{% endif %}
