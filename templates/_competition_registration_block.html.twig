{# The "I'm going" row of the event and edition pages (page sections, docs/features/competitions-management/public-page.md)
   - exactly main's row: an event that manages registration renders its registration card inside _event_attendance.html.twig.
   Expects: event (CompetitionEvent), attendance (EventAttendance), can_add_time (bool),
   show_add_time (bool, default true - the edition page has "Add my time" in its header). #}
<div class="mt-4 mb-3">
    {{ include('_event_attendance.html.twig', {competition_id: event.id, attendance: attendance}) }}
    {% if can_add_time and show_add_time|default(true) %}
        <a href="{{ path('puzzle_add', {competition: event.id}) }}" class="btn btn-sm btn-outline-primary ms-1 text-wrap">
            <i class="bi bi-stopwatch me-1"></i>{{ 'events.add_my_time'|trans }}
        </a>
    {% endif %}
</div>
