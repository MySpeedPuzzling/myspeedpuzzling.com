{# Schedule system section of an edition page: rounds with their puzzles (main's edition_detail markup).
   Expects: rounds (EditionRoundDetail[]), series, event #}
{% for round in rounds %}
    <div class="mt-4">
        <h2 class="h5 mb-3">
            <span class="badge me-2" style="background-color: {{ round.color }}; color: {{ round.textColor }};">
                {{ round.name }}
            </span>

            <span class="badge bg-secondary ms-1" data-round-category="{{ round.category.value }}">{{ ('competition.round.category.' ~ round.category.value)|trans }}</span>
        </h2>

        <div class="text-muted small mb-3">
            <i class="bi bi-calendar-event me-1"></i>{{ round.startsAt|date('d.m.Y H:i', round.timezone) }} <span class="text-muted" data-round-zone>({{ timezone_name(round.timezone, round.timezoneAssumed) }})</span>
            <span class="mx-1">&middot;</span>
            <i class="bi bi-stopwatch me-1"></i>{{ round.minutesLimit }} min
            {% if round.slug is not null and series.slug is not null and event.slug is not null %}
                <span class="mx-1">&middot;</span>
                <a href="{{ path('edition_round_results', {seriesSlug: series.slug, editionSlug: event.slug, roundSlug: round.slug}) }}">
                    <i class="bi bi-trophy me-1"></i>{{ 'round_results.link'|trans }}
                </a>
            {% endif %}
        </div>

        {% if round.puzzles|length > 0 %}
            <div class="row g-2 g-md-3">
                {% for puzzle in round.puzzles %}
                    <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                        <div class="card h-100 shadow-sm">
                            {% if puzzle.puzzleImage %}
                                <img src="{{ puzzle.puzzleImage|thumbnail('puzzle_small') }}" alt="{{ puzzle.puzzleName }}" class="card-img-top" {{ puzzle_image_dimensions(puzzle.puzzleImageRatio, 300) }}>
                            {% else %}
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 120px;">
                                    <i class="bi bi-puzzle text-muted" style="font-size: 2rem;"></i>
                                </div>
                            {% endif %}
                            <div class="card-body p-2">
                                <p class="card-text small mb-0">{{ puzzle.puzzleName }}</p>
                                <p class="card-text text-muted small">
                                    {{ 'pieces_count'|trans({'%count%': puzzle.piecesCount})|raw }}
                                    {% if puzzle.manufacturerName %}
                                        &middot; {{ puzzle.manufacturerName }}
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endfor %}
