{# Guests only: players are subscribed by default and switch it in notification settings
   (a player who switched it off gets one quiet line in the footer bar instead) #}
<section class="footer-newsletter" aria-labelledby="footer-newsletter-title">
    <div class="container px-3 footer-newsletter-inner">
        <div>
            <h2 class="footer-newsletter-title" id="footer-newsletter-title">{{ 'newsletter.footer.title'|trans }}</h2>
            <p class="mb-0">{{ 'newsletter.footer.pitch'|trans }}</p>
        </div>

        {# Sends nothing: opens the "Send the confirmation e-mail?" step in the modal, where the bot checks are
           (NewsletterSubscribeController). Without JavaScript the step is a page of its own. #}
        <form action="{{ path('newsletter_subscribe') }}" method="post" data-turbo-frame="modal-frame">
            <input type="hidden" name="_token" value="{{ csrf_token('newsletter-subscribe') }}">
            {% include 'newsletter/_honeypot.html.twig' %}
            <div class="input-group">
                <input type="email" class="form-control" name="email" required autocomplete="email"
                       placeholder="{{ 'newsletter.footer.email_placeholder'|trans }}"
                       aria-label="{{ 'newsletter.footer.email_placeholder'|trans }}">
                <button class="btn btn-primary" type="submit">{{ 'newsletter.footer.subscribe_button'|trans }}</button>
            </div>
            <p class="footer-newsletter-consent">{{ 'newsletter.footer.consent'|trans({'%privacyUrl%': path('privacy_policy')})|raw }}</p>
        </form>
    </div>
</section>
