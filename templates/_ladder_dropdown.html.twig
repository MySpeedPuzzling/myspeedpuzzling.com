{# The switcher between every leaderboard: the time ladders, then the MSP Rating and the progression boards.
   Included on /ladder, the per-pieces ladders, the MSP Rating ladder and the XP / AP leaderboard #}
{% set currentLadder = app.request.attributes.get('_route') %}
{% set active_country = active_country|default(null) %}
{% set progress_tabs = enum('SpeedPuzzling\\Web\\Value\\ProgressLeaderboardTab').cases() %}
{% set progress_tab = currentLadder == 'xp_leaderboard' and tab is defined ? tab : null %}

<div class="dropdown d-inline-block">
    <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        {# Every ladder route starts with "ladder", so the overview is the fallback, not the first test #}
        {% if currentLadder starts with 'ladder_solo_500_pieces' %}
            {{ 'ladder.solo'|trans }} - {{ 'pieces_count'|trans({ '%count%': 500 })|raw }}
        {% elseif currentLadder starts with 'ladder_solo_1000_pieces' %}
            {{ 'ladder.solo'|trans }} - {{ 'pieces_count'|trans({ '%count%': 1000 })|raw }}
        {% elseif currentLadder starts with 'ladder_pairs_500_pieces' %}
            {{ 'ladder.duo'|trans }} - {{ 'pieces_count'|trans({ '%count%': 500 })|raw }}
        {% elseif currentLadder starts with 'ladder_pairs_1000_pieces' %}
            {{ 'ladder.duo'|trans }} - {{ 'pieces_count'|trans({ '%count%': 1000 })|raw }}
        {% elseif currentLadder starts with 'ladder_groups_500_pieces' %}
            {{ 'ladder.team'|trans }} - {{ 'pieces_count'|trans({ '%count%': 500 })|raw }}
        {% elseif currentLadder starts with 'ladder_groups_1000_pieces' %}
            {{ 'ladder.team'|trans }} - {{ 'pieces_count'|trans({ '%count%': 1000 })|raw }}
        {% elseif currentLadder starts with 'msp_rating_ladder' %}
            {{ 'ladder.board.msp_rating'|trans }}
        {% elseif progress_tab is not null %}
            {{ (progress_tab.translationPrefix() ~ '.tab')|trans }}
        {% else %}
            {{ 'ladder.overview'|trans }}
        {% endif %}
    </button>
    <div class="dropdown-menu">
        <a href="{{ path('ladder' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="dropdown-item {{ currentLadder == 'ladder' ? 'active'}}">
            {{ 'ladder.overview'|trans }}
        </a>

        <a href="{{ path('ladder_solo_500_pieces' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="dropdown-item {{ currentLadder == 'ladder_solo_500_pieces' ? 'active'}}">
            {{ 'ladder.solo'|trans }} - {{ 'pieces_count'|trans({ '%count%': 500 })|raw }}
        </a>

        <a href="{{ path('ladder_solo_1000_pieces' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="dropdown-item {{ currentLadder == 'ladder_solo_1000_pieces' ? 'active'}}">
            {{ 'ladder.solo'|trans }} - {{ 'pieces_count'|trans({ '%count%': 1000 })|raw }}
        </a>

        <a href="{{ path('ladder_pairs_500_pieces' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="dropdown-item {{ currentLadder == 'ladder_pairs_500_pieces' ? 'active'}}">
            {{ 'ladder.duo'|trans }} - {{ 'pieces_count'|trans({ '%count%': 500 })|raw }}
        </a>

        <a href="{{ path('ladder_pairs_1000_pieces' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="dropdown-item {{ currentLadder == 'ladder_pairs_1000_pieces' ? 'active'}}">
            {{ 'ladder.duo'|trans }} - {{ 'pieces_count'|trans({ '%count%': 1000 })|raw }}
        </a>

        <a href="{{ path('ladder_groups_500_pieces' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="dropdown-item {{ currentLadder == 'ladder_groups_500_pieces' ? 'active'}}">
            {{ 'ladder.team'|trans }} - {{ 'pieces_count'|trans({ '%count%': 500 })|raw }}
        </a>

        <a href="{{ path('ladder_groups_1000_pieces' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="dropdown-item {{ currentLadder == 'ladder_groups_1000_pieces' ? 'active'}}">
            {{ 'ladder.team'|trans }} - {{ 'pieces_count'|trans({ '%count%': 1000 })|raw }}
        </a>

        <div class="dropdown-divider"></div>

        <a href="{{ path('msp_rating_ladder') }}" class="dropdown-item {{ currentLadder starts with 'msp_rating_ladder' ? 'active' }}">
            {{ 'ladder.board.msp_rating'|trans }}
        </a>

        {% for board_tab in xp_system_visible() ? progress_tabs : [] %}
            <a href="{{ path('xp_leaderboard', {tab: board_tab.value}) }}" class="dropdown-item {{ progress_tab == board_tab ? 'active' }}">
                {{ (board_tab.translationPrefix() ~ '.tab')|trans }}
            </a>
        {% endfor %}
    </div>
</div>