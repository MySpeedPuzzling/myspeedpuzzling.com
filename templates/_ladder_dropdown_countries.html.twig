{% set currentLadder = app.request.attributes.get('_route') %}

{% if logged_user.profile is not null and logged_user.profile.activeMembership %}
    {# Most players first, typing filters (country_typeahead_controller.js); every option's value is the page it opens #}
    {% set all_countries_route = currentLadder|replace({'_country': ''}) %}
    <div class="ladder-country-select">
        <select class="form-select form-select-sm country-typeahead"
                aria-label="{{ 'ladder.country'|trans }}"
                data-controller="country-typeahead select-navigate"
                data-country-typeahead-no-results-value="{{ 'players.scope.no_country'|trans }}"
                data-action="select-navigate#go">
            <option value="{{ path(all_countries_route) }}" data-icon="bi bi-globe2"{% if active_country is null %} selected{% endif %}>{{ 'forms.country_all'|trans }}</option>
            {% for player_country in countries|filter(player_country => player_country.countryCode is not null) %}
                <option value="{{ path(all_countries_route ~ '_country', {countryCode: player_country.countryCode.name}) }}" data-icon="fi fi-{{ player_country.countryCode.name }}" data-count="{{ player_country.playersCount|format_number }}"{% if active_country == player_country.countryCode %} selected{% endif %}>{{ player_country.countryCode.value }}</option>
            {% endfor %}
        </select>
    </div>
{% else %}
    <button
        class="btn btn-outline-primary btn-sm position-relative pe-4"
        data-bs-toggle="modal"
        data-bs-target="#membersExclusiveModal"
    >
        {{ 'forms.country_all'|trans }}
        <i class="ci-locked position-absolute fs-sm" style="right: 4px;top: 7px;"></i>
    </button>
{% endif %}
