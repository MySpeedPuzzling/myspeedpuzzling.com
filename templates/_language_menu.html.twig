{# The other five languages - the topbar switcher and the footer one share it.
   The links are language_switch_urls() - the one rule of the switch (decision 36, MENU-01), also behind the Menu's
   Language row; nav_surface (topbar / footer) is the data-nav surface of its links #}
{% set nav_surface = nav_surface|default('topbar') %}
{% set language_urls = language_switch_urls() %}
{% set language_names = {en: ['us', 'English'], de: ['de', 'Deutsch'], cs: ['cz', 'Čeština'], fr: ['fr', 'Français'], es: ['es', 'Español'], ja: ['jp', '日本語']} %}
<ul class="dropdown-menu dropdown-menu-end" data-controller="locale-preference">
    {% for locale, url in language_urls %}
        <li>
            <a class="dropdown-item pb-1" href="{{ url }}" data-action="click->locale-preference#save" data-locale-preference-locale-param="{{ locale }}" data-nav="{{ nav_surface }}/language/{{ locale }}">
                <span class="fi shadow-custom fi-{{ language_names[locale][0] }} me-1"></span> {{ language_names[locale][1] }}
            </a>
        </li>
    {% endfor %}
</ul>
