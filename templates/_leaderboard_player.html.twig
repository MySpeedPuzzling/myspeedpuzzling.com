{#
    One player of a leaderboard row: avatar (country flag on its corner), skill tier icon, name.

    Inputs:
      - player: PuzzleSolver, Puzzler or PlayerRatingEntry (playerId, playerName, playerCode, playerCountry - a
                CountryCode or a plain code, playerAvatar, isPrivate, skillTierName, rankingOptedOut - the last two
                may be missing where the list never holds private / opted-out players); a guest of a pair/team has
                no playerId
      - small (bool, optional): smaller avatar, for the members of a pair/team
      - links_turbo_frame (string, optional): data-turbo-frame of the profile link - "_top" inside a modal
      - profile_params (map, optional): extra query parameters of the profile link (e.g. ?return=)
      - show_tier (bool, optional, default true): the skill tier icon - off where the data has no tier
      - highlight_query (string, optional): marks the searched text in the name (search results)
      - name_nav (string, optional): data-nav of the profile link where the row sits in a navigation container (the
                Community landing's previews, docs/features/navigation COM-01)
      - player_card (bool, optional, default true): the name and the avatar open the player card
                (docs/features/navigation README §4.8, CARD-01b): both link to the profile and carry data-player-card +
                aria-haspopup="dialog" (server-rendered only - Live Components re-apply attributes JavaScript changed);
                the avatar is a second link to the same profile, out of the tab order and hidden from screen readers
                (decision 73). False inside a modal: no triggers there, the names link to the profile (README §4.8).
                The card's context comes from the closest data-player-card-context around the row.

    The name truncates with an ellipsis instead of widening the table - the row must never scroll sideways.
#}
{%- from 'puzzle_intelligence/_macros.html.twig' import skill_icon -%}
{%- set is_viewer = logged_user.profile is not null and player.playerId is not null and player.playerId == logged_user.profile.playerId -%}
{%- set hidden = (player.isPrivate ?? false) and not is_viewer -%}
{%- set country_code = player.playerCountry is null ? null : (player.playerCountry.name ?? player.playerCountry) -%}
{%- set country_name = player.playerCountry is null ? null : (player.playerCountry.value ?? null) -%}
{%- set name = player.playerName ?? ('#' ~ player.playerCode) -%}
{%- set linked = not hidden and player.playerId is not null -%}
{%- set card = linked and (player_card is defined ? player_card : true) -%}
{%- set profile_href = linked ? path('player_profile', {playerId: player.playerId}|merge(profile_params|default({}))) : null -%}
{%- set avatar -%}
    {{- include('_player_avatar.html.twig', {
        player_id: player.playerId,
        name: name,
        avatar: player.playerAvatar ?? null,
        country_code: country_code,
        country_name: country_name,
        hidden: hidden,
    }) -}}
{%- endset -%}
<span class="lb-player{{ small|default(false) ? ' lb-player-sm' }}">
    {%- if card -%}
        <a class="lb-avatar-link" href="{{ profile_href }}" tabindex="-1" aria-hidden="true" data-player-card aria-haspopup="dialog"{% if links_turbo_frame is defined %} data-turbo-frame="{{ links_turbo_frame }}"{% endif %}{% if name_nav is defined %} data-nav="{{ name_nav }}"{% endif %}>{{ avatar }}</a>
    {%- else -%}
        {{- avatar -}}
    {%- endif -%}

    {%- if hidden -%}
        <span class="lb-name text-muted">{{ 'secret_puzzler_name'|trans }}</span>
    {%- elseif player.playerId is not null -%}
        {%- if show_tier is defined and not show_tier -%}
        {%- elseif logged_user.profile is not null and logged_user.profile.activeMembership and not (player.rankingOptedOut ?? false) -%}
            {{ skill_icon(player.skillTierName ?? 'unknown', 16) }}
        {%- else -%}
            {{ skill_icon('locked', 16) }}
        {%- endif -%}
        <a class="lb-name" href="{{ profile_href }}"{% if card %} data-player-card aria-haspopup="dialog"{% endif %}{% if links_turbo_frame is defined %} data-turbo-frame="{{ links_turbo_frame }}"{% endif %}{% if name_nav is defined %} data-nav="{{ name_nav }}"{% endif %}>
            {%- if logged_user.profile is not null and player.playerId in logged_user.profile.favoritePlayers -%}
                <i class="ci-star-filled text-warning me-1"></i>
            {%- endif -%}
            {{- highlight_query is defined and highlight_query ? highlight(name, highlight_query) : name -}}
        </a>
    {%- else -%}
        <span class="lb-name lb-name-guest">{{ name }}</span>
    {%- endif -%}
</span>
