{#
    One player of a leaderboard row: avatar (country flag on its corner), skill tier icon, name.

    Inputs:
      - player: PuzzleSolver or Puzzler (playerId, playerName, playerCode, playerCountry, playerAvatar, isPrivate,
                skillTierName, rankingOptedOut); a guest of a pair/team has no playerId
      - small (bool, optional): smaller avatar, for the members of a pair/team
      - links_turbo_frame (string, optional): data-turbo-frame of the profile link - "_top" inside a modal

    The name truncates with an ellipsis instead of widening the table - the row must never scroll sideways.
#}
{%- from 'puzzle_intelligence/_macros.html.twig' import skill_icon -%}
{%- set is_viewer = logged_user.profile is not null and player.playerId is not null and player.playerId == logged_user.profile.playerId -%}
{%- set hidden = player.isPrivate and not is_viewer -%}
{%- set name = player.playerName ?? ('#' ~ player.playerCode) -%}
<span class="lb-player{{ small|default(false) ? ' lb-player-sm' }}">
    <span class="lb-avatar">
        {%- if hidden -%}
            <span class="lb-avatar-img lb-avatar-private"><i class="bi bi-incognito"></i></span>
        {%- elseif player.playerAvatar ?? null -%}
            <img class="lb-avatar-img" src="{{ player.playerAvatar|thumbnail('puzzle_small') }}" alt="" loading="lazy" decoding="async">
        {%- else -%}
            {# The tint follows the id, so a player keeps their colour on every page #}
            <span class="lb-avatar-img lb-avatar-initial lb-tint-{{ player.playerId is not null ? player.playerId|last : 'guest' }}" aria-hidden="true">
                {{- name|trim('#')|first|upper -}}
            </span>
        {%- endif -%}
        {%- if not hidden and player.playerCountry is not null -%}
            <span class="lb-flag fi fi-{{ player.playerCountry.name }}" title="{{ player.playerCountry.value }}"></span>
        {%- endif -%}
    </span>

    {%- if hidden -%}
        <span class="lb-name text-muted">{{ 'secret_puzzler_name'|trans }}</span>
    {%- elseif player.playerId is not null -%}
        {%- if logged_user.profile is not null and logged_user.profile.activeMembership and not player.rankingOptedOut -%}
            {{ skill_icon(player.skillTierName ?? 'unknown', 16) }}
        {%- else -%}
            {{ skill_icon('locked', 16) }}
        {%- endif -%}
        <a class="lb-name" href="{{ path('player_profile', {playerId: player.playerId}) }}"{% if links_turbo_frame is defined %} data-turbo-frame="{{ links_turbo_frame }}"{% endif %}>
            {%- if logged_user.profile is not null and player.playerId in logged_user.profile.favoritePlayers -%}
                <i class="ci-star-filled text-warning me-1"></i>
            {%- endif -%}
            {{- name -}}
        </a>
    {%- else -%}
        <span class="lb-name lb-name-guest">{{ name }}</span>
    {%- endif -%}
</span>
