{#
    Badges of a leaderboard time (attempts, 1st try, unboxed, event) - nothing when it has none.

    Inputs:
      - time: PuzzleSolver or PuzzleSolversGroup
      - attempts (int, optional): how many times the player/pair/team solved the puzzle - a pill from 2 on
      - team_page_label (string, optional): links a pair/team time to its team page - the team's name when it has one
      - skip_first_try (bool, optional): the caller shows "1st try" elsewhere (recent activity: next to the time)
      - show_date (bool, optional): the time's date first in the row (puzzle leaderboard - when was that best time)
#}
{%- set attempts = attempts|default(1) -%}
{%- set team_link = team_page_label is defined and time.teamId is defined and time.teamId is not null -%}
{%- set show_first_try = time.firstAttempt and not (skip_first_try is defined and skip_first_try) -%}
{%- set date = show_date is defined and show_date and time.finishedAt is not null ? time.finishedAt : null -%}
{%- if date or show_first_try or time.unboxed or time.competitionName or attempts > 1 or team_link -%}
    <div class="lb-badges">
        {%- if date -%}
            <time class="lb-badge-date tabular-nums" datetime="{{ date|date('Y-m-d') }}">{{ date|date('d.m.Y') }}</time>
        {%- endif -%}
        {%- if team_link -%}
            <a href="{{ path('puzzling_team_detail', {teamId: time.teamId}) }}" data-testid="team-link">
                <span class="badge rounded-pill lb-team-badge"><i class="bi bi-people-fill"></i> {{ time.teamName ?? team_page_label }}</span>
            </a>
        {%- endif -%}
        {%- if attempts > 1 -%}
            <span class="badge rounded-pill lb-attempts-badge"><i class="bi bi-arrow-repeat"></i> {{ 'puzzle_times.leaderboard.attempts'|trans({'%count%': attempts}) }}</span>
        {%- endif -%}
        {%- if show_first_try -%}
            <span class="badge rounded-pill bg-info">{{ 'first_attempt'|trans }}</span>
        {%- endif -%}
        {%- if time.unboxed -%}
            <span class="badge rounded-pill bg-warning"><i class="bi bi-eye-slash"></i> {{ 'unboxed'|trans }}</span>
        {%- endif -%}
        {{- include('_competition_badge.html.twig', {time: time}) -}}
    </div>
{%- endif -%}
