{#
    Details line of a leaderboard time: pair/team page · date · PPM (+ edit button).

    Inputs:
      - time: PuzzleSolver or PuzzleSolversGroup
      - pieces (int): pieces of the puzzle, for the PPM
      - editable (bool): the row is the viewer's own - the edit button shows when the viewer may edit this time
      - team_page_label (optional): link to the pair/team page, with its name when it has one
#}
<div class="lb-meta">
    {%- if team_page_label is defined and time.teamId is defined and time.teamId is not null -%}
        <a class="lb-team-link" href="{{ path('puzzling_team_detail', {teamId: time.teamId}) }}" data-testid="team-link">
            <i class="bi bi-people-fill"></i> <span>{{ time.teamName ?? team_page_label }}</span>
        </a>
    {%- endif -%}
    {%- if time.finishedAt is not null -%}
        <span class="lb-date"><i class="bi bi-calendar3"></i> {{ time.finishedAt|date('d.m.Y') }}</span>
    {%- endif -%}
    <span class="lb-ppm">{{ ppm(time.time, pieces) }} <abbr title="{{ 'puzzle_times.leaderboard.ppm'|trans }}">PPM</abbr></span>
    {%- if editable and time.isEditableBy(logged_user.profile.playerId) -%}
        {{ include('_edit_time_button.html.twig', {timeId: time.timeId, context: 'puzzle-detail'}) }}
    {%- endif -%}
</div>
