{# Countdown to the next automatic refresh of the feed it belongs to, and its WCAG 2.2.2 pause button.
   Lives inside a `live-refresh` controller element, outside the live component, so a re-render never morphs it
   (controllers/live_refresh_controller.js, docs/features/live-activity-feed.md) #}
<button
    type="button"
    class="live-refresh-ring"
    data-live-refresh-target="ring"
    data-action="live-refresh#toggle"
    data-state="running"
    data-running-title="{{ 'live_refresh.running'|trans }}"
    data-paused-title="{{ 'live_refresh.paused'|trans }}"
    data-idle-title="{{ 'live_refresh.idle'|trans }}"
    data-failed-title="{{ 'live_refresh.failed'|trans }}"
    title="{{ 'live_refresh.running'|trans }}"
    aria-label="{{ 'live_refresh.pause'|trans }}"
    aria-pressed="false"
>
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
        <circle class="live-refresh-track" cx="12" cy="12" r="10.5" pathLength="100"></circle>
        <circle class="live-refresh-progress" cx="12" cy="12" r="10.5" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" data-live-refresh-target="progress"></circle>
    </svg>
    <i class="bi bi-pause-fill live-refresh-icon-pause" aria-hidden="true"></i>
    <i class="bi bi-play-fill live-refresh-icon-play" aria-hidden="true"></i>
    <i class="bi bi-arrow-clockwise live-refresh-icon-retry" aria-hidden="true"></i>
</button>
