{# UX funnel §4 (issue #147): the inline rescue shown after any failed sign-in
   attempt. Identical for every failure reason - it must never hint whether the
   address has an account. The button submits the page's sign-in-link form
   (form="sign-in-link-form"), which already carries the typed address, so the
   rescue stays one click and the typed password stays on the login endpoint. #}
<div class="alert alert-info" role="alert">
    <h2 class="h6 mb-2">
        <i class="bi bi-key me-1"></i>{{ 'auth.failure_helper.title'|trans }}
    </h2>

    <p class="fs-sm mb-2">{{ 'auth.failure_helper.vault_tip'|trans({'%old_domain%': 'speedpuzzling.eu.auth0.com'}) }}</p>

    <p class="fs-sm mb-2">{{ 'auth.failure_helper.or_skip'|trans }}</p>

    <button type="submit" class="btn btn-sm btn-primary" form="sign-in-link-form">
        <i class="bi bi-envelope me-1"></i>{{ 'auth.sign_in_link.submit'|trans }}
    </button>
</div>
