{# The show/hide button inside a password field (password_toggle_controller.js).
   Place it right after the input, inside a .password-field wrapper.
   Ships hidden - the controller reveals it, so it never shows without JavaScript.
   Parameters: input_id. #}
<button
    type="button"
    class="password-toggle"
    aria-controls="{{ input_id }}"
    aria-pressed="false"
    data-controller="password-toggle"
    data-action="password-toggle#toggle"
    hidden
>
    <i class="bi bi-eye" aria-hidden="true"></i>
    <span class="visually-hidden">{{ 'auth.password.show'|trans }}</span>
</button>
