{# The profile's results list (PlayerSolvedPuzzles, kept one release - docs/features/navigation decision 97): one row
   per puzzle (solo) or per puzzle and pair/team, each row player/results/_row.html.twig like on the Results page. #}
<div class="custom-table-wrapper ps-wrapper">
    <table class="table table-hover ps-table mb-0">
        <tbody>
            {% for solved_puzzle in solved_puzzles %}
                {{ include('player/results/_row.html.twig', {
                    row: solved_puzzle,
                    position: loop.index,
                    ranking: this.ranking,
                    with_difficulty: this.withDifficulty,
                    difficulty_tiers: this.difficultyTiers,
                }) }}
            {% endfor %}
            {% if solved_puzzles|length < 1 %}
                <tr>
                    <td colspan="3" class="text-center">{{ 'profile.no_puzzles_solved'|trans }}</td>
                </tr>
            {% endif %}
        </tbody>
    </table>
</div>
