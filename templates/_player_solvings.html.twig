{# One row per puzzle (solo) or per puzzle and pair/team: a tap on the row opens the result detail - every attempt,
   deltas and the chart - in the modal, loaded on demand (docs/features/puzzle-result-detail.md).
   Same building blocks as the puzzle leaderboard (_leaderboard_player, _leaderboard_time_badges, monospace numbers):
   image · puzzle with its tags (takes the rest, truncates) · time - the table never scrolls sideways. #}
<div class="custom-table-wrapper ps-wrapper">
    <table class="table table-hover ps-table mb-0">
        <tbody>
            {% for solved_puzzle in solved_puzzles %}
                {% set puzzle = solved_puzzle[0] %}
                {% set is_owner = logged_user.profile is not null and logged_user.profile.playerId is same as puzzle.playerId %}
                <tr class="{{ puzzle.suspicious ? 'table-warning' }}" data-controller="row-link" data-action="click->row-link#open">
                    <td class="ps-image">
                        <div class="position-relative">
                            <a href="{{ path('puzzle_detail', {puzzleId: puzzle.puzzleId}) }}">
                                {{ lazy_puzzle_image(
                                    puzzle.puzzleImage,
                                    'puzzle_small',
                                    'puzzle_img_alt'|trans({'%puzzle%': puzzle.manufacturerName ~ ' ' ~ puzzle.puzzleName}),
                                    loop.index,
                                    60,
                                    'rounded-2',
                                    60,
                                    puzzle.puzzleImageRatio
                                ) }}
                            </a>

                            {# Share / edit / delete, like in the recent activity - whoever tracked the time and every group member #}
                            {% if logged_user.profile is not null and puzzle.isEditableBy(logged_user.profile.playerId) %}
                                {{ include('_time_actions_menu.html.twig', {
                                    time_id: puzzle.timeId,
                                    puzzle_name: puzzle.puzzleName,
                                    can_delete: puzzle.playerId is same as logged_user.profile.playerId,
                                    edit_context: 'profile',
                                }) }}
                            {% endif %}
                        </div>

                        {# The photo of the finished puzzle only for its owner - the large stripped preset, not the
                           uploaded original (older uploads may carry EXIF/GPS) #}
                        {% if is_owner and puzzle.finishedPuzzlePhoto is not null %}
                            <div class="gallery ps-photo">
                                <a class="gallery-item gallery-item-inline-block rounded-2" href="{{ puzzle.finishedPuzzlePhoto|thumbnail('puzzle_large') }}">
                                    <img alt="{{ 'puzzle_img_alt'|trans({'%puzzle%': puzzle.manufacturerName ~ ' ' ~ puzzle.puzzleName}) }}" class="rounded-2" loading="lazy" src="{{ puzzle.finishedPuzzlePhoto|thumbnail('puzzle_small') }}">
                                </a>
                            </div>
                        {% endif %}
                    </td>

                    <td class="ps-info">
                        <a class="ps-puzzle-name" href="{{ path('puzzle_detail', {puzzleId: puzzle.puzzleId}) }}">{{ puzzle.puzzleName }}</a>
                        <div class="ps-puzzle-meta">
                            {{ 'pieces_count'|trans({'%count%': puzzle.piecesCount})|raw }} · {{ puzzle.manufacturerName }}
                        </div>

                        {% if puzzle.players|length > 0 %}
                            <div class="ps-members">
                                {% for puzzle_solver in puzzle.players %}
                                    {{ include('_leaderboard_player.html.twig', {player: puzzle_solver, small: true, show_tier: false}) }}
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="ps-tags">
                            {# Rank for solo (only if ranking exists - won't exist for relax-only puzzles) #}
                            {% if puzzle.players is null and this.ranking[puzzle.puzzleId] is defined %}
                                <span class="pr-chip pr-chip-rank">
                                    {{ 'puzzle_result.rank'|trans({'%rank%': this.ranking[puzzle.puzzleId].rank, '%total%': this.ranking[puzzle.puzzleId].totalPlayers}) }}
                                </span>
                            {% endif %}

                            {{ include('_leaderboard_time_badges.html.twig', {
                                time: puzzle,
                                attempts: solved_puzzle|length,
                                team_page_label: (puzzle.players|length == 2 ? 'puzzling_team.pair_page' : 'puzzling_team.team_page')|trans,
                            }) }}

                            {% if puzzle.suspicious %}
                                <span class="badge rounded-pill bg-warning">
                                    <i class="bi bi-exclamation-triangle"></i> {{ 'badge.suspicious'|trans }}
                                </span>
                            {% endif %}

                        </div>
                    </td>

                    <td class="ps-time">
                        {# The row's real link to the result detail - a tap anywhere else on the row clicks it #}
                        <a
                            class="ps-time-value"
                            href="{{ path('puzzle_result_detail', {timeId: puzzle.timeId}) }}"
                            data-row-link-target="link"
                            data-turbo-frame="modal-frame"
                            rel="nofollow"
                        >
                            {%- if puzzle.time is not null -%}
                                {{ puzzle.time|puzzlingTime }}
                            {%- else -%}
                                <span class="badge rounded-pill bg-secondary"><i class="bi bi-cup-hot"></i> {{ 'badge.relax'|trans }}</span>
                            {%- endif -%}
                        </a>

                        {% if puzzle.finishedAt is not null %}
                            <time class="ps-date" datetime="{{ puzzle.finishedAt|date('Y-m-d') }}">{{ puzzle.finishedAt|date('d.m.Y') }}</time>
                        {% endif %}

                        {% if puzzle.time is not null %}
                            <span class="ps-ppm">
                                PPM <span class="font-monospace">{{ ppm(puzzle.time, puzzle.piecesCount) }}</span>
                                {%- if puzzle.players is not null %}
                                    <br>{{ puzzle.players|length }}× <span class="font-monospace">{{ ppm(puzzle.time, puzzle.piecesCount, puzzle.players|length) }}</span>
                                {%- endif %}
                            </span>
                        {% endif %}

                    </td>
                </tr>
            {% endfor %}
            {% if solved_puzzles|length < 1 %}
                <tr>
                    <td colspan="3" class="text-center">{{ 'profile.no_puzzles_solved'|trans }}</td>
                </tr>
            {% endif %}
        </tbody>
    </table>
</div>
