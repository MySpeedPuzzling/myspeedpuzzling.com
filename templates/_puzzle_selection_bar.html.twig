{#
    The floating bar of a list page while puzzles are selected (collection_selection_controller.js,
    docs/features/collections/bulk-actions.md). Its buttons post the selected ids into the modal frame - never in the
    URL. Expects `actions`: a list of {label, icon, url, short?, danger?}; the first one stays on phones (with its `short`
    label when it has one), the rest go behind ⋯ there.
#}
<form method="post" class="collection-selection-bar shadow-lg" hidden
      data-collection-selection-target="bar"
      data-turbo-frame="modal-frame"
      aria-label="{{ 'collection_selection.bar_label'|trans }}">
    <input type="hidden" name="_token" value="{{ csrf_token(constant('SpeedPuzzling\\Web\\Value\\PuzzleSelection::CSRF_TOKEN_ID')) }}">
    <div data-collection-selection-target="inputs"></div>

    <div class="collection-selection-bar-inner">
        <button type="button" class="btn btn-sm btn-link text-body p-1" data-action="collection-selection#clear"
                title="{{ 'collection_selection.clear'|trans }}" aria-label="{{ 'collection_selection.clear'|trans }}">
            <i class="bi bi-x-lg"></i>
        </button>
        <span class="fw-semibold text-nowrap" data-collection-selection-target="count" aria-live="polite"></span>
        <button type="button" class="btn btn-sm btn-link px-1 text-nowrap d-none d-sm-inline-block" data-action="collection-selection#selectAll"
                title="{{ 'collection_selection.select_all_title'|trans }}">
            {{ 'collection_selection.select_all'|trans }}
        </button>

        <div class="collection-selection-actions">
            {% for action in actions %}
                <button type="submit" formaction="{{ action.url }}"
                        class="btn btn-sm text-nowrap {{ loop.first ? 'btn-primary' : ((action.danger ?? false) ? 'btn-outline-danger' : 'btn-outline-primary') ~ ' d-none d-sm-inline-block' }}">
                    <i class="{{ action.icon }} me-1"></i>
                    {%- if loop.first and action.short is defined -%}
                        <span class="d-inline d-sm-none">{{ action.short }}</span><span class="d-none d-sm-inline">{{ action.label }}</span>
                    {%- else -%}
                        {{ action.label }}
                    {%- endif %}
                </button>
            {% endfor %}

            {# Phones: Select all and every action but the first behind ⋯ #}
            <div class="dropup d-sm-none">
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="dropdown"
                        aria-expanded="false" aria-label="{{ 'collection_selection.more_actions'|trans }}">
                    <i class="ci-menu"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <button type="button" class="dropdown-item" data-action="collection-selection#selectAll">
                            <i class="bi bi-check2-all me-1"></i>{{ 'collection_selection.select_all'|trans }}
                        </button>
                    </li>
                    {% for action in actions|slice(1) %}
                        <li>
                            <button type="submit" class="dropdown-item {{ (action.danger ?? false) ? 'text-danger' }}" formaction="{{ action.url }}">
                                <i class="{{ action.icon }} me-1"></i>{{ action.label }}
                            </button>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</form>
