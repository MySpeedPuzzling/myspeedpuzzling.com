{# safe_return_url rejects anything that could leave the site (//evil.com, /\evil.com,
   https://…, encoded variants) and falls back, so this href can never point off-site. #}
{% set returnUrl = safe_return_url(app.request.query.get('return'), fallbackUrl|default(null)) %}
{% set returnTitle = app.request.query.get('return_title') ?? fallbackTitle|default(null) %}
{% if returnUrl %}
    <div class="mb-2">
        <a href="{{ returnUrl }}" class="btn btn-outline-secondary py-1 px-2" style="font-size: 0.75rem;">
            <i class="ci-arrow-left me-1"></i> <small class="text-muted">{{ 'back_to'|trans }}</small> {{ returnTitle }}
        </a>
    </div>
{% endif %}
