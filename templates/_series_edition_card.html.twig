{#
    One edition on the public series page.
    Expects: edition (SeriesEdition), series (CompetitionSeriesOverview with a slug), past (bool: results link instead of registration link)
    The edition's own logo sits on the right like on the event cards; without one the card has none - the series
    logo is in the page header already.
#}
<div class="mb-3 mb-md-4 col-md-6" data-series-edition="{{ edition.competitionId }}">
    <div class="card shadow h-100">
        <div class="card-body d-flex w-100 p-3">
            <div class="flex-fill">
                <h3 class="h5 mb-2">
                    {% if edition.editionSlug %}
                        <a href="{{ path('edition_detail', {'seriesSlug': series.slug, 'editionSlug': edition.editionSlug}) }}" class="text-decoration-underline">
                            {{ edition.name }}
                        </a>
                    {% else %}
                        {{ edition.name }}
                    {% endif %}
                </h3>

                <div class="mt-1">
                    <i class="ci-calendar me-2 ps-1"></i>
                    {% if edition.startsAt %}
                        {{ edition.startsAt|date('d.m.Y H:i', edition.timezone) }}
                        <small class="text-muted ps-1">({{ edition.startsAt|ago }})</small>
                    {% elseif edition.dateFrom %}
                        {{ include('_event_date_range.html.twig', {date_from: edition.dateFrom, date_to: edition.dateTo}) }}
                        <small class="text-muted ps-1">({{ edition.dateFrom|ago }})</small>
                    {% else %}
                        <span class="text-muted" data-edition-date-not-set>{{ 'edition.date_not_set'|trans }}</span>
                    {% endif %}
                </div>

                <div class="d-flex flex-wrap gap-3 mt-2 text-muted small">
                    {% if edition.minutesLimit and edition.roundCount <= 1 %}
                        <span><i class="bi bi-clock me-1"></i>{{ edition.minutesLimit }} min</span>
                    {% endif %}
                    {% if edition.roundCount > 1 %}
                        <span><i class="bi bi-list-ol me-1"></i>{{ edition.roundCount }} {{ 'competition.rounds_count'|trans }}</span>
                    {% endif %}
                    <span><i class="bi bi-puzzle me-1"></i>{{ edition.puzzleCount }}</span>
                    <span><i class="bi bi-people me-1"></i>{{ edition.participantCount }}</span>
                </div>

                {% if past and edition.resultsLink %}
                    <div class="mt-2">
                        <a target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" href="{{ edition.resultsLink }}">
                            <i class="bi bi-trophy me-1"></i>{{ 'events.results_link'|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i>
                        </a>
                    </div>
                {% elseif not past and edition.registrationLink %}
                    <div class="mt-2">
                        <a target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" href="{{ edition.registrationLink }}">
                            <i class="bi bi-person-plus me-1"></i>{{ 'events.registration_link'|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i>
                        </a>
                    </div>
                {% endif %}
            </div>

            {% if edition.logo %}
                <div class="ms-3 flex-shrink-0 event-image">
                    <img style="max-height: 84px;" src="{{ edition.logo|thumbnail('puzzle_small') }}" alt="{{ edition.name }} logo" class="img-fluid" loading="lazy">
                </div>
            {% endif %}
        </div>
    </div>
</div>
