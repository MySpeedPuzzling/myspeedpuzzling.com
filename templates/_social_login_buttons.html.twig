{# Social sign-in buttons (auth hardening PR 2) on /login (below the email
   form, after an "or continue with" divider - every existing account has a
   password, social sign-in is the newcomer) and on /register (below "Continue
   with email"), docs/features/auth-ux-redesign.md §10. Which ones render depends on
   configuration only (SocialLoginSettings), never on the visitor - except in a
   social app's built-in browser (auth pages are no-store, so that is safe):
   there Google refuses to sign anybody in ("403 disallowed_useragent"), so its
   button points at the notice explaining the way out instead of into the dead
   end. It is re-targeted, never removed.

   The buttons themselves (provider branding) live in _social_provider_button.

   Parameters: existing_account_hint (bool, /login only), last_used (bool),
   divider_before (translated text of a divider above the buttons, optional). #}

{# Pass the page's ?return= on to the OAuth start route, so a social sign-in
   lands where a password sign-in would. The start route validates it before it
   enters the (server-side, single-use) OAuth state payload. #}
{% set returnParams = safe_return_url(app.request.query.get('return')) is null ? {} : {'return': safe_return_url(app.request.query.get('return'))} %}
{% set in_app = in_app_browser() %}

{% if social_login.isAnyEnabled() %}
    {% if divider_before|default(null) %}
        <div class="auth-divider">{{ divider_before }}</div>
    {% endif %}

    <div class="auth-social">
        {% if social_login.isProviderEnabled('google') %}
            {% if in_app is not null %}
                {{ include('_social_provider_button.html.twig', {provider: 'google', href: '#in-app-browser-notice', full_width: true, last_used: last_used|default(false), describedby: 'in-app-browser-notice'}) }}
            {% else %}
                {{ include('_social_provider_button.html.twig', {provider: 'google', href: path('social_login_start', {provider: 'google'}|merge(returnParams)), full_width: true, last_used: last_used|default(false)}) }}
            {% endif %}
        {% endif %}

        {# Personal Microsoft accounts only - many Hotmail/Outlook users do not
           know their mailbox is a "Microsoft account", hence the hint #}
        {% if social_login.isProviderEnabled('microsoft') %}
            <div>
                {{ include('_social_provider_button.html.twig', {provider: 'microsoft', href: path('social_login_start', {provider: 'microsoft'}|merge(returnParams)), full_width: true, last_used: last_used|default(false)}) }}
                <div class="text-muted text-center fs-xs mt-1">{{ 'auth.social.microsoft_hint'|trans }}</div>
            </div>
        {% endif %}

        {% if social_login.isProviderEnabled('apple') %}
            {{ include('_social_provider_button.html.twig', {provider: 'apple', href: path('social_login_start', {provider: 'apple'}|merge(returnParams)), full_width: true, last_used: last_used|default(false)}) }}
        {% endif %}

        {# Facebook Login is the only Meta sign-in open to us (Instagram's login
           API is business-only and shares no email), hence the Instagram hint. #}
        {% if social_login.isProviderEnabled('facebook') %}
            <div>
                {{ include('_social_provider_button.html.twig', {provider: 'facebook', href: path('social_login_start', {provider: 'facebook'}|merge(returnParams)), full_width: true, last_used: last_used|default(false)}) }}
                <div class="text-muted text-center fs-xs mt-1">{{ 'auth.social.facebook_hint'|trans }}</div>
            </div>
        {% endif %}
    </div>

    {# Promise only what linking rule 2 delivers: a matching address signs in to
       the existing account; a different one ends at the rule-4 question #}
    {% if existing_account_hint|default(false) %}
        <p class="auth-social-hint">{{ 'auth.social.existing_account_hint'|trans }}</p>
    {% endif %}
{% endif %}
