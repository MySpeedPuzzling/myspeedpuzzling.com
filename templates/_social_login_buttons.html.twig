{# Pass the login page's ?return= on to the OAuth start route, so a social
   sign-in lands where a password sign-in would. The start route validates it
   before it enters the (server-side, single-use) OAuth state payload. #}
{% set returnParams = safe_return_url(app.request.query.get('return')) is null ? {} : {'return': safe_return_url(app.request.query.get('return'))} %}
{# Social sign-in buttons (auth hardening PR 2). While SOCIAL_LOGIN_ADMIN_ONLY
   is on they render for NOBODY - the hosting pages serve every visitor the
   same markup and admins test via the direct /login/social/{provider} URLs.
   Brand guidelines: official logo + "Continue with {provider}" wording; the
   SVGs are inlined so no external image ever loads. #}
{% if not social_login_admin_only and (social_login_google_enabled or social_login_apple_enabled or social_login_facebook_enabled) %}
    <div class="text-center my-3 text-muted fs-sm">{{ 'auth.social.or_continue_with'|trans }}</div>

    <div class="d-grid gap-2">
        {% if social_login_google_enabled %}
            <a class="btn btn-outline-dark w-100" href="{{ path('social_login_start', {provider: 'google'}|merge(returnParams)) }}" data-turbo="false">
                <svg class="me-2" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>{{ 'auth.social.continue_with'|trans({'%provider%': 'Google'}) }}
            </a>
        {% endif %}

        {% if social_login_apple_enabled %}
            <a class="btn btn-dark w-100" href="{{ path('social_login_start', {provider: 'apple'}|merge(returnParams)) }}" data-turbo="false">
                <svg class="me-2" width="18" height="18" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>{{ 'auth.social.continue_with'|trans({'%provider%': 'Apple'}) }}
            </a>
        {% endif %}

        {# Meta brand rules: the 'f' is never used alone - always the round
           logo, here the white variant on Facebook Blue #1877F2 (the colour of
           Meta's own login button), at least 16 px wide. Facebook Login is
           also the only Meta sign-in open to us (Instagram's login API is
           business-only and shares no email), hence the Instagram hint. #}
        {% if social_login_facebook_enabled %}
            <div>
                <a class="btn w-100 text-white" style="background-color: #1877F2;" href="{{ path('social_login_start', {provider: 'facebook'}|merge(returnParams)) }}" data-turbo="false">
                    <svg class="me-2" width="18" height="18" viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true"><path d="M1024 512C1024 229.23 794.77 0 512 0S0 229.23 0 512c0 255.55 187.23 467.37 432 505.78V660H302V512h130V399.2C432 270.88 508.44 200 625.39 200 681.41 200 740 210 740 210v126h-64.56c-63.6 0-83.44 39.47-83.44 80v96h142l-22.7 148H592v357.78c244.77-38.41 432-250.23 432-505.78z"/></svg>{{ 'auth.social.continue_with'|trans({'%provider%': 'Facebook'}) }}
                </a>
                <div class="text-muted text-center fs-xs mt-1">{{ 'auth.social.facebook_hint'|trans }}</div>
            </div>
        {% endif %}
    </div>
{% endif %}
