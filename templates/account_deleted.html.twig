{% extends 'base.html.twig' %}

{% block title %}{{ 'account_deletion.deleted.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <div class="row gy-3 pb-4">
        <div class="col-lg-6 col-md-8">
            <h1 class="h2">{{ 'account_deletion.deleted.headline'|trans }}</h1>

            <div class="alert alert-success" role="alert">
                <i class="ci-check-circle me-2"></i>
                {{ 'account_deletion.deleted.done'|trans }}
            </div>

            <p>{{ 'account_deletion.deleted.farewell'|trans }}</p>
            <p>{{ 'account_deletion.deleted.come_back'|trans }}</p>

            <p>
                <a class="btn btn-primary" href="{{ path('homepage') }}">{{ 'account_deletion.deleted.to_homepage'|trans }}</a>
            </p>
        </div>

        <div class="col-lg-5 offset-lg-1 col-md-4 text-center d-none d-md-block">
            <img class="img-fluid" src="{{ asset('img/puzzlie-1.png') }}" alt="" width="1000" height="949">
        </div>
    </div>
{% endblock %}
