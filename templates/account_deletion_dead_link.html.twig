{% extends 'base.html.twig' %}

{% block title %}{{ headline }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <div class="row gy-3 pb-4">
        <div class="col-lg-6 col-md-8">
            <h1 class="h2">{{ headline }}</h1>

            <div class="alert alert-warning" role="alert">
                <i class="ci-close-circle me-2"></i>
                {{ message }}
            </div>

            <p class="mb-2">{{ 'account_deletion.dead_link.nothing_deleted'|trans }}</p>

            <p>
                {# A fresh link needs a signed-in session: the danger zone on the profile
                   settings page is where it is requested from #}
                <a class="btn btn-primary" href="{{ path('edit_profile') }}#danger-zone">
                    {{ 'account_deletion.dead_link.to_settings'|trans }}
                </a>
            </p>
        </div>

        <div class="col-lg-5 offset-lg-1 col-md-4 text-center d-none d-md-block">
            <img class="img-fluid" src="{{ asset('img/puzzlie-1.png') }}" alt="" width="1000" height="949">
        </div>
    </div>
{% endblock %}
