{% extends 'base.html.twig' %}

{% set type_label = (type.translationKey())|trans %}

{% block title %}{{ 'badges.detail.meta_title'|trans({'%name%': type_label}) }}{% endblock %}

{# One holder: a 44 px pill with the avatar (initial on a tint without a photo), name and flag #}
{% macro holder_pill(holder, first, badge_type) %}
    {% set name = holder.playerName ?? ('#' ~ holder.playerCode|upper) %}
    <a href="{{ path('player_profile', {playerId: holder.playerId}) }}" class="holder-pill{{ first ? ' holder-pill-first' }}">
        {% if badge_type is not null and holder.tier is not null %}
            {{ badge_art(badge_type, holder.tier, 28) }}
        {% endif %}
        {{ include('_player_avatar.html.twig', {
            player_id: holder.playerId,
            name: name,
            avatar: holder.avatar,
            country_code: holder.countryCode ? holder.countryCode.name : null,
            country_name: holder.countryCode ? holder.countryCode.localizedName(app.request.locale) : null,
        }) }}
        <span>{{ name }}</span>
        {% if first %}
            <span class="visually-hidden">({{ 'badges.detail.first_to_earn'|trans }})</span>
            <i class="bi bi-trophy-fill text-warning" aria-hidden="true"></i>
        {% endif %}
    </a>
{% endmacro %}

{% block content %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb fs-sm mb-2">
            <li class="breadcrumb-item"><a href="{{ path('badges_overview') }}">{{ 'badges.overview_title'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ type_label }}</li>
        </ol>
    </nav>

    <header class="mb-4 d-flex align-items-center gap-3 achievement-hero">
        {# The viewer's own tier stands for the achievement (members), else Bronze; each tier's own badge heads its section below #}
        {{ badge_art(type, hero_tier, 96, attrs = {class: 'flex-shrink-0', loading: 'eager', fetchpriority: 'high'}) }}

        <div>
            <h1 class="h3 mb-1">{{ type_label }}</h1>
            <p class="text-body-secondary mb-0">{{ ('badges.description.' ~ type.value)|trans }}</p>
            {% if viewer_tier is not null %}
                <p class="fs-sm mb-0 mt-1">{{ 'badges.info.you_hold'|trans({'%tier%': viewer_tier.translationKey()|trans}) }}</p>
            {% endif %}
        </div>
    </header>

    {% if countries|length > 0 %}
        <form method="get" class="mb-4 d-flex flex-wrap align-items-center gap-2" data-turbo="false" data-controller="auto-submit" data-action="change->auto-submit#submit">
            <label for="holder-country" class="form-label fs-sm mb-0 text-nowrap">{{ 'badges.detail.country_filter'|trans }}</label>
            <select id="holder-country" name="country" class="form-select" style="max-width: 260px;">
                <option value="">{{ 'badges.detail.all_countries'|trans }}</option>
                {% for country in countries %}
                    <option value="{{ country.code }}" {{ selected_country == country.code ? 'selected' }}>{{ country.name }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-outline-secondary" data-auto-submit-target="fallback">{{ 'badges.detail.apply_filter'|trans }}</button>
        </form>
    {% endif %}

    {% if newest_earners|length > 0 and selected_country is null %}
        <section class="mb-4">
            <h2 class="h6 text-body-secondary">{{ 'badges.detail.newest_earners'|trans }}</h2>
            <div class="d-flex flex-wrap gap-2">
                {% for earner in newest_earners %}
                    {{ _self.holder_pill(earner, false, type) }}
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% for section in tier_sections %}
        <section class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-2">
                    {{ badge_art(type, section.tier, 56, attrs = {class: 'flex-shrink-0'}) }}
                    <div class="flex-grow-1">
                        <h2 class="h6 mb-0">{{ (section.tier.translationKey())|trans }}</h2>
                        <p class="fs-sm text-body-secondary mb-0">{{ ('badges.requirement.' ~ type.value ~ '_' ~ section.tier.value)|trans }}</p>
                        {% if section.totalCount > 0 %}
                            <p class="fs-sm mb-0">{{ 'badges.detail.holders_count'|trans({'%count%': section.totalCount}) }}</p>
                        {% endif %}
                    </div>
                </div>

                {% if section.holders|length > 0 %}
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        {% for holder in section.holders %}
                            {{ _self.holder_pill(holder, loop.first, null) }}
                        {% endfor %}

                        {% if section.hiddenCount > 0 %}
                            <span class="d-inline-flex align-items-center px-2 fs-sm text-body-secondary" style="min-height: 44px;">
                                {{ 'badges.detail.more_puzzlers'|trans({'%count%': section.hiddenCount}) }}
                            </span>
                        {% endif %}
                    </div>
                {% elseif section.totalCount > 0 %}
                    <p class="fs-sm text-body-secondary mb-0 mt-2">
                        {{ 'badges.detail.only_hidden_holders'|trans({'%count%': section.totalCount}) }}
                    </p>
                {% else %}
                    <p class="fs-sm text-body-secondary mb-0 mt-2">
                        {{ 'badges.detail.nobody_yet'|trans }}
                    </p>
                {% endif %}
            </div>
        </section>
    {% endfor %}

    <p class="small text-body-secondary mt-3">
        {{ 'badges.detail.listing_note'|trans }}
    </p>
{% endblock %}
