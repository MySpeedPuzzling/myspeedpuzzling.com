{% extends 'base.html.twig' %}

{#
    Add an organization (docs/features/organizations/README.md "Forms", owner: workstream A): any signed-in player; it
    waits for an admin's approval, or stays a draft ("Save as draft").
    Variables: form, kept_photos
#}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'organization_page.form.add_title'|trans }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events.title'|trans, url: path('events')},
        {label: 'organization.directory_title'|trans, url: path('organizations')},
        {label: 'organization_page.form.add_title'|trans},
    ]}) }}
    {{ include('_return_back_button.html.twig', {fallbackUrl: path('organizations'), fallbackTitle: 'organization.directory_title'|trans}) }}

    <div class="pb-4">
        <div class="row gy-3 pb-3">
            <div class="col-lg-8">
                <h1 class="h2">{{ 'organization_page.form.add_title'|trans }}</h1>
                <p class="text-muted">{{ 'organization_page.form.add_info'|trans }}</p>

                <div class="card shadow my-4">
                    <div class="card-body">
                        {{ include('organization/_form.html.twig', {
                            form: form,
                            kept_photos: kept_photos,
                            current_logo: null,
                            slug_prefix: null,
                            submit_label: 'organization_page.form.submit',
                        }, with_context = false) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
