{% extends 'base.html.twig' %}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'competition.add_puzzle'|trans }} - {{ round.name }}{% endblock %}

{% block content %}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events.title'|trans, url: path('events')},
        {label: competition.name, url: path('edit_competition', {competitionId: competition.id})},
        {label: 'competition.manage_rounds'|trans, url: path('manage_competition_rounds', {competitionId: competition.id})},
        {label: round.name, url: path('manage_round_puzzles', {roundId: round.id})},
        {label: 'competition.add_puzzle'|trans},
    ]}) }}
    {{ include('_return_back_button.html.twig', {fallbackUrl: path('manage_round_puzzles', {roundId: round.id}), fallbackTitle: 'competition.manage_puzzles'|trans}) }}

    <div class="pb-4">
        <div class="row gy-3 pb-3">
            <div class="col-lg-8">
                <h1 class="h2">{{ 'competition.add_puzzle'|trans }}</h1>
                <p class="text-muted">{{ competition.name }} - {{ round.name }}</p>

                <div class="card shadow my-4">
                    <div class="card-body"
                         data-controller="time-form-autocomplete"
                         data-time-form-autocomplete-add-new-brand-message-value="{{ 'forms.add_new_brand'|trans }}"
                         data-time-form-autocomplete-add-new-puzzle-message-value="{{ 'forms.add_new_puzzle'|trans }}"
                         data-time-form-autocomplete-puzzle-required-message-value="{{ 'forms.required_field'|trans }}">
                        {{ form_start(form) }}
                            {# The automatic reveal named under "Hide until the round starts" - a secret puzzle is added only while
                               the round still has it (AddPuzzleToCompetitionRound) #}
                            <input type="hidden" name="automatic_reveal_at" value="{{ round.automaticRevealAt.timestamp }}">
                            {{ form_row(form.brand, {'attr': {'data-time-form-autocomplete-target': 'brand'}}) }}
                            {{ form_row(form.puzzle, {'attr': {'data-time-form-autocomplete-target': 'puzzle'}}) }}

                            <div data-time-form-autocomplete-target="newPuzzle" class="d-none">
                                {{ form_row(form.piecesCount) }}
                                <div class="mb-3">
                                    {{ form_label(form.puzzlePhoto) }}
                                    {{ include('photo_stash/_photo_drop_area.html.twig', {
                                        field: form.puzzlePhoto,
                                        stash_field: 'puzzlePhoto',
                                        kept_photo: (kept_photos|default({})).puzzlePhoto ?? null,
                                    }, with_context = false) }}
                                    {{ form_help(form.puzzlePhoto) }}
                                </div>
                                {{ include('puzzle/_code_inputs.html.twig', {field: form.puzzleEans, label: 'forms.ean'|trans}, with_context = false) }}
                                {{ include('puzzle/_code_inputs.html.twig', {field: form.puzzleBrandCodes, label: 'forms.identification_number'|trans}, with_context = false) }}
                            </div>

                            <div class="mb-3">
                                {{ form_row(form.hideUntilRoundStarts, {
                                    'attr': {'data-action': 'change->time-form-autocomplete#toggleHideOptions'},
                                    'help': revealed_right_away
                                        ? 'competition.round_puzzle.form.hide_help_round_started'|trans({'%date%': zoned_datetime(round.automaticRevealAt, round.displayTimezone, round.timezoneAssumed)})
                                        : 'competition.round_puzzle.form.hide_help'|trans({
                                            '%date%': zoned_datetime(round.automaticRevealAt, round.displayTimezone, round.timezoneAssumed),
                                            '%after_start%': 'competition.reveal.after_start'|trans({'%count%': round.revealDelayMinutes}),
                                        }),
                                }) }}

                                <div data-time-form-autocomplete-target="hideOptions" class="d-none ms-4 mt-2">
                                    <div class="mb-3" data-reveal-scope>
                                        <p class="form-text mt-0 mb-0"><i class="bi bi-info-circle me-1"></i>{{ 'competition.round_puzzle.form.hide_existing_puzzle'|trans }}</p>
                                    </div>
                                    {% for child in form.hideMode %}
                                        <div class="form-check mb-2">
                                            {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                                            {{ form_label(child, null, {'label_attr': {'class': 'form-check-label'}}) }}
                                            {% if child.vars.value == 'image_only' %}
                                                <div class="form-text">{{ 'competition.round_puzzle.form.hide_mode_image_only_help'|trans }}</div>
                                            {% elseif child.vars.value == 'entirely' %}
                                                <div class="form-text">{{ 'competition.round_puzzle.form.hide_mode_entirely_help'|trans }}</div>
                                                {# Only "entirely" keeps a new puzzle away from every page and every personal record - "image only" leaves its name public #}
                                                <div class="form-text"><i class="bi bi-eye-slash me-1"></i>{{ 'competition.round_puzzle.form.hide_new_puzzle'|trans }}</div>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary mt-3">
                                {{ 'competition.add_puzzle'|trans }}
                            </button>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
