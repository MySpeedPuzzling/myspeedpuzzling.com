{% extends 'base.html.twig' %}

{% block title %}{{ 'added_time_recap.meta.title'|trans }}{% endblock %}

{% block content %}
    <h1 class="h2">{{ 'added_time_recap.title'|trans }}</h1>

    {% if duplicates is not empty %}
        <div class="mt-3" data-testid="recap-duplicates">
            <p class="fs-sm mb-2"><i class="bi bi-files me-1"></i><strong>{{ 'review_results.recap.title'|trans }}</strong> {{ 'review_results.recap.intro'|trans }}</p>
            {% for set in duplicates %}
                {{ include('review_results/_set.html.twig', {set: set, player_id: viewer_player_id, via: 'recap', recap_time_id: solved_puzzle.timeId}) }}
            {% endfor %}
        </div>
    {% endif %}

    <div class="recap-actions my-4">
        <div class="btn-group btn-group-sm">
            <a rel="nofollow" href="{{ path('puzzle_add', {mode: 'speed_puzzling'}) }}" class="btn btn-primary pe-2"><i class="ci-add"></i> {{ 'added_time_recap.add_time'|trans }}</a>
            <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="visually-hidden">{{ 'forms.toggle_dropdown'|trans }}</span>
            </button>
            <ul class="dropdown-menu shadow-custom">
                <li><a class="dropdown-item" rel="nofollow" href="{{ path('puzzle_add', {puzzleId: solved_puzzle.puzzleId, mode: 'speed_puzzling'}) }}">{{ 'added_time_recap.the_same_puzzle'|trans }}</a></li>
            </ul>
        </div>

        <a href="{{ path('puzzle_detail', {'puzzleId': solved_puzzle.puzzleId}) }}" class="btn btn-sm btn-primary">{{ 'added_time_recap.puzzle_detail'|trans }}</a>

        <twig:AddToCollectionCta puzzleId="{{ solved_puzzle.puzzleId }}" />
    </div>

    {#
        Mobile first: the progress card right under the actions, then the share image, then prediction and history.
        From md up the share image sits in the right column next to both (.recap-layout grid areas).
    #}
    <div class="recap-layout">
        {# XP and achievements only while the progression is visible to the viewer (xp-system, launch ready or admin) #}
        {% set progression_visible = xp_system_visible() %}
        {% set has_competition_row = is_timed_solo and not player.rankingOptedOut and (has_rating or has_skill_tier) %}
        {% if progression_visible or ranking is not null or has_competition_row %}
            <section class="recap-card recap-layout-card" aria-label="{{ 'recap_progress.title'|trans }}">
                {% if progression_visible %}
                    <twig:XpRecapCelebration solvingTimeId="{{ solved_puzzle.timeId }}" :celebrate="celebrate" />
                {% endif %}
                {{ include('added_time_recap/_place_row.html.twig') }}
                {{ include('added_time_recap/_competition_row.html.twig') }}
            </section>
        {% endif %}

        <div class="recap-layout-share text-center">
            <div class="time-result-recap d-inline-block">
                <div class="button-wrapper">
                    <button
                        data-controller="share-image"
                        data-share-image-title-value="{{ solved_puzzle.puzzleName }}"
                        data-share-image-image-url-value="{{ path('result_image', {'timeId': solved_puzzle.timeId}) }}"
                        data-action="click->share-image#shareImageAsset"
                        class="btn btn-primary shadow-lg opacity-80"
                    >
                        <i class="ci-share"></i> {{ 'share'|trans }}
                    </button>
                </div>

                <img style="max-width: 320px; width: 100%;" width="800" height="800" src="{{ path('result_image', {'timeId': solved_puzzle.timeId}) }}" alt="">
            </div>
        </div>

        {% if is_timed_solo %}
            <div class="recap-layout-more">
                {{ include('added_time_recap/_performance_summary.html.twig') }}

                {% if not player.rankingOptedOut %}
                    {{ include('added_time_recap/_history.html.twig') }}
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
