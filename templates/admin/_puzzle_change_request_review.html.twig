{#
    The review form of a pending change request: the whole puzzle, every field editable.
    The player's proposal is prefilled and marked; puzzle_record_controller.js marks every field by what
    approving does with it (proposed / your edit / keeping current) and sums it up above the approve button,
    so the reviewer's own edits never get mixed up with the proposal.
#}
{% set review_fields = [
    {
        label: 'Name', widget: form.name, help: null,
        proposed: request.hasNameChange(),
        current: request.puzzleName, currentValue: request.puzzleName,
        proposedShown: request.proposedName, proposedValue: request.proposedName,
        original: request.originalName, originalDiffers: request.originalName != request.puzzleName,
    },
    {
        label: 'Alternative name', widget: form.alternativeName, help: null,
        proposed: false,
        current: request.puzzleAlternativeNames.legacyAlternativeName(), currentValue: request.puzzleAlternativeNames.legacyAlternativeName(),
        proposedShown: null, proposedValue: null, original: null, originalDiffers: false,
    },
    {
        label: 'Brand', widget: form.manufacturerId, help: null,
        proposed: request.hasManufacturerChange(),
        current: request.puzzleManufacturerName, currentValue: request.puzzleManufacturerId,
        proposedShown: request.proposedManufacturerName, proposedValue: request.proposedManufacturerId,
        original: request.originalManufacturerName, originalDiffers: request.originalManufacturerId != request.puzzleManufacturerId,
    },
    {
        label: 'Pieces', widget: form.piecesCount, help: null,
        proposed: request.hasPiecesCountChange(),
        current: request.puzzlePiecesCount, currentValue: request.puzzlePiecesCount,
        proposedShown: request.proposedPiecesCount, proposedValue: request.proposedPiecesCount,
        original: request.originalPiecesCount, originalDiffers: request.originalPiecesCount != request.puzzlePiecesCount,
    },
    {
        label: 'EAN', widget: form.ean, help: 'Comma-separated - one code per edition or region. Never reduce the list.',
        proposed: request.hasEanChange(),
        current: request.puzzleEan, currentValue: request.puzzleEan,
        proposedShown: request.proposedEan, proposedValue: request.proposedEan,
        original: request.originalEan, originalDiffers: request.originalEan != request.puzzleEan,
    },
    {
        label: 'Brand code', widget: form.identificationNumber, help: 'Comma-separated',
        proposed: request.hasIdentificationNumberChange(),
        current: request.puzzleIdentificationNumber, currentValue: request.puzzleIdentificationNumber,
        proposedShown: request.proposedIdentificationNumber, proposedValue: request.proposedIdentificationNumber,
        original: request.originalIdentificationNumber, originalDiffers: request.originalIdentificationNumber != request.puzzleIdentificationNumber,
    },
] %}

{{ form_start(form, {attr: {
    'data-controller': 'puzzle-record',
    'data-action': 'change->puzzle-record#update input->puzzle-record#update kept-photo:removed->puzzle-record#update',
    'data-puzzle-record-proposed-label-value': 'Proposed',
    'data-puzzle-record-edit-label-value': 'Your edit',
    'data-puzzle-record-kept-label-value': 'Keeping current',
    'data-puzzle-record-changes-heading-value': 'Approving saves:',
    'data-puzzle-record-kept-heading-value': 'Proposed, but not applied:',
    'data-puzzle-record-no-changes-value': 'Nothing on the puzzle changes - approving only closes the request.',
}}) }}

    {{ form_errors(form) }}

    <p class="small text-muted mb-3">
        Everything can be edited. What the player proposed is prefilled and marked
        <span class="badge bg-warning text-dark">Proposed</span>, whatever you change yourself is marked
        <span class="badge bg-accent">Your edit</span>.
    </p>

    {{ include('admin/_puzzle_record_fields.html.twig', {fields: review_fields}) }}
    {{ include('admin/_puzzle_record_image.html.twig', {
        current_image: request.puzzleImage,
        proposed_image: request.hasImageChange() ? request.proposedImage : null,
        kept_photo: kept_photos.puzzlePhoto ?? null,
    }) }}
    {{ include('admin/_puzzle_record_note.html.twig') }}

    <div class="pt-3 mt-2 border-top">
        <div class="small mb-3" data-puzzle-record-target="summary" aria-live="polite"></div>

        <div class="d-grid d-sm-flex gap-2">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-lg me-1"></i> Approve and save
            </button>

            <button type="button"
                    class="btn btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#rejectModal">
                <i class="bi bi-x-lg me-1"></i> Reject
            </button>
        </div>
    </div>

{{ form_end(form) }}
