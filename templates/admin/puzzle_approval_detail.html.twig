{% extends 'base.html.twig' %}

{% import 'admin/_puzzle_macros.html.twig' as macros %}

{% block title %}Approve - {{ puzzle.puzzleName }}{% endblock %}

{#
    One newly added puzzle: the similar puzzles in the catalogue to compare it with - search results, not claimed
    duplicates - and the approval form (the moderators' record form: field cards marked by puzzle_record_controller.js,
    a new photo, a note) with the brand settled. No card around it all - on a phone the inner cards are enough.
#}
{% macro similar_puzzle(candidate, puzzle) %}
    {% import 'admin/_puzzle_macros.html.twig' as macros %}
    {% set likelihood = candidate.likelihood %}
    <div class="col-12 col-md-6">
        <div class="border rounded-3 p-3 h-100 shadow-sm {{ likelihood == 'likely' ? 'border-2 border-danger' : (likelihood == 'possible' ? 'border-2 border-warning') }}">
            <div class="mb-2">
                {% if likelihood == 'likely' %}
                    <span class="badge bg-danger">Same EAN - very likely the same puzzle</span>
                {% elseif likelihood == 'possible' %}
                    <span class="badge bg-warning text-dark">{{ candidate.sameBrand ? 'Same brand' : 'Probably the same brand' }} - compare the box</span>
                {% else %}
                    <span class="badge bg-light text-dark border">Another brand - usually a different puzzle</span>
                {% endif %}
            </div>

            <div class="d-flex gap-3">
                <div class="flex-shrink-0" style="width: 96px;">
                    {{ macros.thumbnail(candidate.image, candidate.puzzleName, 96) }}
                </div>
                <div class="min-w-0">
                    <a href="{{ path('puzzle_detail', {puzzleId: candidate.puzzleId}) }}" target="_blank" class="fw-semibold text-break">{{ candidate.puzzleName }}</a>
                    <div class="small text-muted text-break">
                        {{ candidate.manufacturerName ?? 'No brand' }} &bull; {{ candidate.piecesCount }} pieces
                        {% if candidate.ean %}&bull; EAN {{ candidate.ean }}{% endif %}
                    </div>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        <span class="badge bg-light text-dark border">{{ candidate.sameName ? 'Same name' : 'Similar name' }}</span>
                        {% if candidate.approved %}
                            <span class="badge bg-light text-dark border">In the catalogue</span>
                        {% else %}
                            <span class="badge bg-warning text-dark">Also waiting for approval</span>
                        {% endif %}
                        <span class="badge bg-light text-dark border">{{ candidate.solvedTimes }} {{ candidate.solvedTimes == 1 ? 'time' : 'times' }}</span>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-3">
                <form action="{{ path('admin_merge_unapproved_puzzle', {puzzleId: puzzle.puzzleId}) }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('merge-puzzle-' ~ puzzle.puzzleId) }}">
                    <input type="hidden" name="target_puzzle" value="{{ candidate.puzzleId }}">
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-intersect me-1"></i> It's the same puzzle - merge
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endmacro %}

{% block content %}
    {% include '_return_back_button.html.twig' with {fallbackUrl: path('admin_puzzle_approvals'), fallbackTitle: 'Puzzle approvals'} %}

    {% set new_brand = puzzle.manufacturerId is not null and not puzzle.manufacturerApproved %}

    <div class="row">
        <div class="col-lg-8 mb-4">
            <h1 class="h4 mb-3">
                New puzzle
                {% if puzzle.approved %}
                    <span class="badge bg-success align-middle ms-1">Approved</span>
                {% else %}
                    <span class="badge bg-warning text-dark align-middle ms-1">Waiting for approval</span>
                {% endif %}
            </h1>

            {# The puzzle as the player added it #}
            <div class="d-flex flex-column flex-sm-row gap-3 mb-3 p-2 p-md-3 bg-light rounded gallery">
                <div class="flex-shrink-0" style="width: 160px; max-width: 100%;">
                    {{ macros.thumbnail(puzzle.image, puzzle.puzzleName, 160) }}
                </div>
                <div class="min-w-0">
                    <h2 class="h5 mb-1 text-break">
                        <a href="{{ path('puzzle_detail', {puzzleId: puzzle.puzzleId}) }}" target="_blank">{{ puzzle.puzzleName }}</a>
                    </h2>
                    <p class="text-muted mb-2 text-break">
                        {{ puzzle.manufacturerName ?? 'No brand' }}
                        {% if new_brand %}<span class="badge bg-warning text-dark ms-1">New brand</span>{% endif %}
                        &bull; {{ puzzle.piecesCount }} pieces
                    </p>
                    <dl class="row small mb-0">
                        <dt class="col-5 col-sm-4 fw-normal text-muted">EAN</dt>
                        <dd class="col-7 col-sm-8 text-break mb-1">{{ macros.shown(puzzle.ean) }}</dd>
                        <dt class="col-5 col-sm-4 fw-normal text-muted">Brand code</dt>
                        <dd class="col-7 col-sm-8 text-break mb-1">{{ macros.shown(puzzle.identificationNumber) }}</dd>
                        <dt class="col-5 col-sm-4 fw-normal text-muted">Solving times</dt>
                        <dd class="col-7 col-sm-8 mb-1">{{ puzzle.solvedTimes }}</dd>
                        <dt class="col-5 col-sm-4 fw-normal text-muted">Added</dt>
                        <dd class="col-7 col-sm-8 text-break mb-0">
                            {% if puzzle.addedById %}
                                {{ macros.player(puzzle.addedById, puzzle.addedByName, puzzle.addedByCode) }}
                            {% endif %}
                            {% if puzzle.addedAt %}<span class="text-muted">&bull; {{ puzzle.addedAt|ago }}</span>{% endif %}
                        </dd>
                    </dl>
                </div>
            </div>

            {% if puzzle.approved %}
                <div class="alert alert-success">
                    This puzzle is already approved. <a href="{{ path('admin_puzzle_approvals') }}">Back to the queue</a>
                </div>
            {% else %}

            {% if puzzle.inPendingMergeRequest %}
                <div class="alert alert-info small">
                    This puzzle is already part of a pending
                    <a href="{{ path('admin_puzzle_merge_requests') }}">merge request</a>.
                </div>
            {% endif %}

            {# 1. Similar puzzles - what the search found, not what is a duplicate #}
            {% set close_matches = similar_puzzles|filter(c => c.likelihood != 'unlikely') %}
            {% set other_brands = similar_puzzles|filter(c => c.likelihood == 'unlikely') %}

            <h2 class="h5 mb-1">1. Is it already in the catalogue?</h2>
            <p class="small text-muted mb-3">
                We searched for puzzles with the same EAN, or a similar name and {{ puzzle.piecesCount }} pieces.
                Those are <strong>not necessarily duplicates</strong> - one title is often made by several brands.
                Merge only when it is the same product: same brand, same box. Merging opens the merge review, every
                solving time is kept.
            </p>

            {% if similar_puzzles is empty %}
                <p class="small mb-3"><i class="bi bi-check-circle text-success me-1"></i> Nothing similar found.</p>
            {% endif %}

            {% if close_matches is not empty %}
                <div class="row g-3 mb-3 gallery">
                    {% for candidate in close_matches %}
                        {{ _self.similar_puzzle(candidate, puzzle) }}
                    {% endfor %}
                </div>
            {% endif %}

            {% if other_brands is not empty %}
                {# Folded: a name match from another brand is what looked like a duplicate and was not #}
                <details class="mb-3">
                    <summary class="small mb-2">
                        {{ other_brands|length }} {{ other_brands|length == 1 ? 'puzzle' : 'puzzles' }} with a similar name from
                        {{ other_brands|length == 1 ? 'another brand' : 'other brands' }} - most likely different puzzles
                    </summary>
                    <div class="row g-3 gallery">
                        {% for candidate in other_brands %}
                            {{ _self.similar_puzzle(candidate, puzzle) }}
                        {% endfor %}
                    </div>
                </details>
            {% endif %}

            <form action="{{ path('admin_merge_unapproved_puzzle', {puzzleId: puzzle.puzzleId}) }}" method="post" class="mb-4">
                <input type="hidden" name="_token" value="{{ csrf_token('merge-puzzle-' ~ puzzle.puzzleId) }}">
                <label for="target_puzzle" class="form-label small">The same as a puzzle not listed here? Paste its address or ID</label>
                <div class="d-flex flex-column flex-sm-row gap-2">
                    <input type="text"
                           id="target_puzzle"
                           name="target_puzzle"
                           class="form-control"
                           required
                           autocomplete="off"
                           placeholder="https://myspeedpuzzling.com/en/puzzle/…">
                    <button type="submit" class="btn btn-outline-primary flex-shrink-0">Merge</button>
                </div>
            </form>

            {# 2. Approve #}
            {% set approve_fields = [
                {label: 'Name', widget: form.name, help: null, current: puzzle.puzzleName, currentValue: puzzle.puzzleName},
                {label: 'Alternative name', widget: form.alternativeName, help: 'Another title the puzzle is sold under, if any', current: puzzle.alternativeNames.legacyAlternativeName(), currentValue: puzzle.alternativeNames.legacyAlternativeName()},
                {label: 'Pieces', widget: form.piecesCount, help: null, current: puzzle.piecesCount, currentValue: puzzle.piecesCount},
                {label: 'EAN', widget: form.ean, help: 'Comma-separated - one code per edition or region.', current: puzzle.ean, currentValue: puzzle.ean},
                {label: 'Brand code', widget: form.identificationNumber, help: 'Comma-separated', current: puzzle.identificationNumber, currentValue: puzzle.identificationNumber},
            ]|map(field => field|merge({proposed: false, proposedShown: null, proposedValue: null, original: null, originalDiffers: false})) %}

            <h2 class="h5 mb-1">2. Check and approve</h2>
            <p class="small text-muted mb-3">
                Correct anything that is wrong - every field you change is marked <span class="badge bg-accent">Your edit</span>
                and kept in the puzzle's history.
            </p>

            {{ form_start(form, {attr: {
                'data-controller': 'puzzle-record',
                'data-action': 'change->puzzle-record#update input->puzzle-record#update kept-photo:removed->puzzle-record#update',
                'data-puzzle-record-proposed-label-value': 'Proposed',
                'data-puzzle-record-edit-label-value': 'Your edit',
                'data-puzzle-record-kept-label-value': 'Keeping current',
                'data-puzzle-record-changes-heading-value': 'Approving saves your corrections:',
                'data-puzzle-record-kept-heading-value': '',
                'data-puzzle-record-no-changes-value': 'Approved as the player added it.',
            }}) }}

                {{ form_errors(form) }}

                {{ include('admin/_puzzle_record_fields.html.twig', {fields: approve_fields}) }}

                {# Brand: an approved brand is kept or swapped; a new one needs a decision #}
                {% if new_brand %}
                    <div class="approval-brand border border-2 border-warning rounded-3 p-3 mb-3 shadow-sm">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <span class="form-label fw-semibold mb-0">Brand</span>
                            <span class="badge bg-warning text-dark">New brand</span>
                        </div>
                        <p class="small mb-2">
                            <strong>{{ puzzle.manufacturerName }}</strong> is not an approved brand yet
                            ({{ puzzle.manufacturerPuzzlesCount }} {{ puzzle.manufacturerPuzzlesCount == 1 ? 'puzzle' : 'puzzles' }}).
                            Players often type an existing brand differently - check before approving it.
                        </p>
                        {% if brand_suggestions is not empty %}
                            <p class="small mb-3">
                                Looks like:
                                {% for suggestion in brand_suggestions %}
                                    <strong>{{ suggestion.manufacturerName }}</strong>
                                    <span class="text-muted">({{ suggestion.puzzlesCount }} {{ suggestion.puzzlesCount == 1 ? 'puzzle' : 'puzzles' }}{% if suggestion.eanPrefixMatches %}, EAN prefix matches{% endif %})</span>{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            </p>
                        {% endif %}

                        {% set choice_labels = {
                            merge_into: 'It is an existing brand - merge <strong>' ~ puzzle.manufacturerName|e ~ '</strong> into the brand below'
                                ~ '<span class="d-block small text-muted">'
                                ~ (puzzle.manufacturerPuzzlesCount > 1 ? 'Moves all ' ~ puzzle.manufacturerPuzzlesCount ~ ' of its puzzles' : 'Moves this puzzle')
                                ~ ' and deletes the duplicate brand.</span>',
                            use_existing: 'Only this puzzle belongs to another brand - move it to the brand below',
                            approve: 'It is a real new brand - approve <strong>' ~ puzzle.manufacturerName|e ~ '</strong>',
                        } %}
                        <div class="mb-3">
                            {% for choice in form.brandChoice %}
                                {{ form_widget(choice, {label: choice_labels[choice.vars.value], label_html: true}) }}
                            {% endfor %}
                            {{ form_errors(form.brandChoice) }}
                        </div>

                        <div class="approval-brand-target">
                            {{ form_label(form.targetManufacturerId, 'Existing brand (to merge into or move to)', {label_attr: {class: 'form-label small'}}) }}
                            {{ form_widget(form.targetManufacturerId) }}
                            {{ form_errors(form.targetManufacturerId) }}
                        </div>
                    </div>
                {% else %}
                    <div class="border rounded-3 p-3 mb-3 shadow-sm"
                         data-puzzle-record-target="field"
                         data-label="Brand"
                         data-current="{{ puzzle.manufacturerId }}">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            {{ form_label(form.targetManufacturerId, 'Brand', {label_attr: {class: 'form-label fw-semibold mb-0'}}) }}
                            <span class="badge d-none" data-role="badge"></span>
                        </div>
                        <div class="small text-muted mb-2 text-break d-none" data-role="current-hint">
                            Current: {{ macros.shown(puzzle.manufacturerName) }}
                        </div>
                        {{ form_widget(form.targetManufacturerId) }}
                        <div class="form-text">Pick another brand to move the puzzle there.</div>
                        {{ form_errors(form.targetManufacturerId) }}
                        <div class="d-flex flex-wrap gap-3 mt-1">
                            <button type="button" class="btn btn-link btn-sm p-0 d-none" data-role="use-current" data-action="puzzle-record#useCurrent">Undo my edit</button>
                        </div>
                    </div>
                {% endif %}

                {{ include('admin/_puzzle_record_image.html.twig', {
                    current_image: puzzle.image,
                    proposed_image: null,
                    kept_photo: kept_photos.puzzlePhoto ?? null,
                }) }}
                {{ include('admin/_puzzle_record_note.html.twig') }}

                <div class="pt-3 mt-2 border-top">
                    <div class="small mb-3" data-puzzle-record-target="summary" aria-live="polite"></div>

                    <div class="d-grid d-sm-flex">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg me-1"></i> Approve puzzle
                        </button>
                    </div>
                </div>

            {{ form_end(form) }}
            {% endif %}
        </div>
    </div>
{% endblock %}
