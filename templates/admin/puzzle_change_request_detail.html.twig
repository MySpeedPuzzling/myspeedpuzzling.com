{% extends 'base.html.twig' %}

{% import 'admin/_puzzle_macros.html.twig' as macros %}

{% block title %}Change Request - {{ request.puzzleName }}{% endblock %}

{% block content %}
    {% include '_return_back_button.html.twig' with {fallbackUrl: path('admin_puzzle_change_requests'), fallbackTitle: 'Change requests'} %}

    {% set pending = form is not null %}

    <div class="row">
        {# No card around the form - on a phone the field cards are enough #}
        <div class="col-lg-8 mb-4">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <h1 class="h4 mb-0">Change Request</h1>
                {% if pending %}
                    <span class="badge bg-warning text-dark">Pending</span>
                {% elseif request.status.value == 'approved' %}
                    {# Approved can still mean only part of the proposal, or none of it, was taken #}
                    {% set proposed_count = outcome.proposedCount() %}
                    {% if not outcome.recorded or proposed_count == 0 or outcome.appliedCount() == proposed_count %}
                        <span class="badge bg-success">Approved</span>
                    {% elseif outcome.appliedCount() + outcome.alteredCount() > 0 %}
                        <span class="badge bg-info text-dark">Approved in part</span>
                    {% else %}
                        <span class="badge bg-secondary">Approved - proposal not applied</span>
                    {% endif %}
                {% elseif request.status.value == 'outdated' %}
                    <span class="badge bg-secondary">Already done</span>
                {% else %}
                    <span class="badge bg-danger">Rejected</span>
                {% endif %}
            </div>

            {# Puzzle info header #}
            <div class="d-flex align-items-center gap-3 mb-3 p-2 p-md-3 bg-light rounded">
                {% if request.puzzleImage %}
                    <img src="{{ request.puzzleImage|puzzle_image('puzzle_small') }}"
                         alt="{{ request.puzzleName }}"
                         class="rounded flex-shrink-0"
                         style="max-height: 64px; max-width: 90px;">
                {% endif %}
                <div class="min-w-0">
                    <h2 class="h6 mb-1 text-break">
                        <a href="{{ path('puzzle_detail', {puzzleId: request.puzzleId}) }}" target="_blank">
                            {{ request.puzzleName }}
                        </a>
                    </h2>
                    <p class="mb-0 text-muted small">
                        {{ request.puzzleManufacturerName }} &bull; {{ request.puzzlePiecesCount }} pieces
                        &bull; <a href="{{ path('admin_puzzle_history', {puzzleId: request.puzzleId}) }}">History</a>
                    </p>
                    {% if request.puzzleAddedById is not null or request.puzzleAddedAt is not null %}
                        <p class="mb-0 text-muted small text-break" data-role="puzzle-added-by">
                            Added
                            {%- if request.puzzleAddedById is not null %} by {{ macros.player(request.puzzleAddedById, request.puzzleAddedByName, request.puzzleAddedByCode) }}{% endif %}
                            {%- if request.puzzleAddedAt is not null %} <time datetime="{{ request.puzzleAddedAt|date('c') }}" title="{{ request.puzzleAddedAt|date('Y-m-d H:i:s') }} UTC">{{ request.puzzleAddedAt|ago }}</time>{% endif %}
                        </p>
                    {% endif %}
                </div>
            </div>

            {# A merge moved it here from the puzzle it was filed on (PuzzleChangeRequest::puzzleMergedInto()) #}
            {% if request.mergedFromPuzzleId %}
                <div class="alert alert-info small text-break" data-role="merged-from">
                    Filed on <a href="{{ path('admin_puzzle_history', {puzzleId: request.mergedFromPuzzleId}) }}">{{ request.originalName ?? 'another puzzle' }}</a>,
                    which was merged into this puzzle since - the values it started from are that puzzle's.
                </div>
            {% endif %}

            {% if request.status.value == 'outdated' %}
                <div class="alert alert-secondary small text-break" data-role="outdated">
                    Closed without a review: the puzzle already had every value it proposes - another proposal, an edit or a merge did it.
                </div>
            {% endif %}

            {% if pending %}
                {{ include('admin/_puzzle_change_request_review.html.twig') }}
            {% else %}
                {{ include('admin/_puzzle_change_request_outcome.html.twig') }}
            {% endif %}

            {# Rejection reason if rejected #}
            {% if request.status.value == 'rejected' and request.rejectionReason %}
                <div class="alert alert-danger mt-4 text-break">
                    <strong>Rejection Reason:</strong><br>
                    {{ request.rejectionReason }}
                </div>
            {% endif %}
        </div>

        <div class="col-lg-4">
            {# Reporter info #}
            <div class="card shadow mb-4">
                <div class="card-header px-3 px-md-4">
                    <h2 class="h5 mb-0">Reporter</h2>
                </div>
                <div class="card-body px-3 px-md-4">
                    <a href="{{ path('player_profile', {playerId: request.reporterId}) }}" target="_blank">
                        {{ request.reporterName ?? ('#' ~ request.reporterCode) }}
                    </a>
                    {% if request.reporterName and request.reporterCode %}
                        <span class="text-muted">#{{ request.reporterCode }}</span>
                    {% endif %}
                    <br>
                    <small class="text-muted">Submitted: {{ request.submittedAt|ago }}</small>
                </div>
            </div>

            {# Review info if reviewed #}
            {% if request.reviewedAt %}
                <div class="card shadow">
                    <div class="card-header px-3 px-md-4">
                        <h2 class="h5 mb-0">Review</h2>
                    </div>
                    <div class="card-body px-3 px-md-4">
                        {% if request.status.value == 'outdated' %}
                            Closed automatically
                        {% elseif request.reviewerName %}
                            Reviewed by: {{ request.reviewerName }}
                        {% endif %}
                        <br>
                        <small class="text-muted">{{ request.reviewedAt|ago }}</small>
                        {% if decision_note is defined and decision_note is not null %}
                            <div class="mt-2 small text-break" data-role="decision-note">
                                <span class="text-muted">Note:</span> {{ decision_note }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

{# Reject Modal #}
{% if pending %}
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="{{ path('admin_reject_puzzle_change_request', {id: request.id}) }}" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Reject Change Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="rejectionReason" class="form-label">Rejection Reason</label>
                        <textarea class="form-control"
                                  id="rejectionReason"
                                  name="rejection_reason"
                                  rows="3"
                                  required
                                  placeholder="Explain why this change request is being rejected..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
