{% extends 'base.html.twig' %}

{% block title %}Change Request - {{ request.puzzleName }}{% endblock %}

{% block content %}
    {% include '_return_back_button.html.twig' with {fallbackUrl: path('admin_puzzle_change_requests'), fallbackTitle: 'Change requests'} %}

    {% set pending = request.status.value == 'pending' %}

    {% set fields = [] %}
    {% if request.hasNameChange() %}
        {% set fields = fields|merge([{key: 'name', label: 'Name', original: request.originalName, proposed: request.proposedName, input: 'text'}]) %}
    {% endif %}
    {% if request.hasManufacturerChange() %}
        {% set fields = fields|merge([{key: 'manufacturer', label: 'Manufacturer', original: request.originalManufacturerName, proposed: request.proposedManufacturerName, input: null}]) %}
    {% endif %}
    {% if request.hasPiecesCountChange() %}
        {% set fields = fields|merge([{key: 'piecesCount', label: 'Pieces', original: request.originalPiecesCount, proposed: request.proposedPiecesCount, input: 'number'}]) %}
    {% endif %}
    {% if request.hasEanChange() %}
        {% set fields = fields|merge([{key: 'ean', label: 'EAN', original: request.originalEan, proposed: request.proposedEan, input: 'text'}]) %}
    {% endif %}
    {% if request.hasIdentificationNumberChange() %}
        {% set fields = fields|merge([{key: 'identificationNumber', label: 'Brand Code', original: request.originalIdentificationNumber, proposed: request.proposedIdentificationNumber, input: 'text'}]) %}
    {% endif %}
    {% set fieldsCount = fields|length + (request.hasImageChange() ? 1 : 0) %}

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header d-flex justify-content-between align-items-center gap-2 px-3 px-md-4">
                    <h1 class="h4 mb-0">Change Request</h1>
                    {% if pending %}
                        <span class="badge bg-warning text-dark">Pending</span>
                    {% elseif request.status.value == 'approved' %}
                        <span class="badge bg-success">Approved</span>
                    {% else %}
                        <span class="badge bg-danger">Rejected</span>
                    {% endif %}
                </div>

                <div class="card-body px-3 px-md-4">
                    {# Puzzle info header #}
                    <div class="d-flex align-items-center gap-3 mb-4 p-2 p-md-3 bg-light rounded">
                        {% if request.puzzleImage %}
                            <img src="{{ request.puzzleImage|puzzle_image('puzzle_small') }}"
                                 alt="{{ request.puzzleName }}"
                                 class="rounded flex-shrink-0"
                                 style="max-height: 64px; max-width: 90px;">
                        {% endif %}
                        <div class="min-w-0">
                            <h2 class="h6 mb-1 text-break">
                                <a href="{{ path('puzzle_detail', {puzzleId: request.puzzleId}) }}" target="_blank">
                                    {{ request.puzzleName }}
                                </a>
                            </h2>
                            <p class="mb-0 text-muted small">
                                {{ request.puzzleManufacturerName }} &bull; {{ request.puzzlePiecesCount }} pieces
                            </p>
                        </div>
                    </div>

                    {% if pending %}
                    <form action="{{ path('admin_approve_puzzle_change_request', {id: request.id}) }}"
                          method="post"
                          data-controller="change-request-fields"
                          data-action="change->change-request-fields#update">
                    {% endif %}

                    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                        <h2 class="h5 mb-0">Proposed Changes</h2>
                        {% if pending and fieldsCount > 1 %}
                            <div class="form-check mb-0">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="selectAll"
                                       checked
                                       data-change-request-fields-target="selectAll"
                                       data-action="change->change-request-fields#toggleAll">
                                <label class="form-check-label small" for="selectAll">
                                    All <span class="text-muted" data-change-request-fields-target="selectedCount">{{ fieldsCount }}/{{ fieldsCount }}</span>
                                </label>
                            </div>
                        {% endif %}
                    </div>

                    {% if pending and fieldsCount > 0 %}
                        <p class="small text-muted mb-3">
                            Untick a field to leave it unchanged. Proposed values can be corrected before approving.
                        </p>
                    {% endif %}

                    {% for field in fields %}
                        <div class="border rounded-3 p-3 mb-3" data-change-request-fields-target="field">
                            {% if pending %}
                                <div class="form-check mb-2">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="field_{{ field.key }}"
                                           name="field_{{ field.key }}"
                                           value="1"
                                           checked
                                           data-change-request-fields-target="checkbox">
                                    <label class="form-check-label fw-semibold" for="field_{{ field.key }}">{{ field.label }}</label>
                                </div>
                            {% else %}
                                <div class="fw-semibold mb-2">{{ field.label }}</div>
                            {% endif %}

                            <div class="row g-2">
                                <div class="col-12 col-md-6">
                                    <div class="small text-muted mb-1">Current</div>
                                    <div class="text-break">
                                        {% if field.original is null or field.original == '' %}
                                            <span class="text-muted fst-italic">Not set</span>
                                        {% else %}
                                            {{ field.original }}
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    {% if pending and field.input %}
                                        <label class="d-block small text-muted mb-1" for="override_{{ field.key }}">Proposed</label>
                                        <input type="{{ field.input }}"
                                               {% if field.input == 'number' %}inputmode="numeric"{% endif %}
                                               id="override_{{ field.key }}"
                                               name="override_{{ field.key }}"
                                               value="{{ field.proposed }}"
                                               class="form-control border-warning">
                                    {% else %}
                                        <div class="small text-muted mb-1">Proposed</div>
                                        <div class="text-break bg-warning bg-opacity-10 rounded px-2 py-1 fw-semibold">{{ field.proposed }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                    {% if request.hasImageChange() %}
                        <div class="border rounded-3 p-3 mb-3" data-change-request-fields-target="field">
                            {% if pending %}
                                <div class="form-check mb-2">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="field_image"
                                           name="field_image"
                                           value="1"
                                           checked
                                           data-change-request-fields-target="checkbox">
                                    <label class="form-check-label fw-semibold" for="field_image">Image</label>
                                </div>
                            {% else %}
                                <div class="fw-semibold mb-2">Image</div>
                            {% endif %}

                            {# Side by side even on phones - the point is to compare the two #}
                            <div class="row g-2 gallery">
                                <div class="col-6">
                                    <div class="small text-muted mb-1">Current</div>
                                    {% if request.originalImage %}
                                        <a class="gallery-item d-block" href="{{ uploaded_asset(request.originalImage) }}">
                                            <img src="{{ request.originalImage|puzzle_image('puzzle_small') }}"
                                                 alt="Current image"
                                                 class="img-thumbnail w-100"
                                                 style="max-height: 180px; object-fit: contain;">
                                        </a>
                                    {% else %}
                                        <span class="text-muted fst-italic">No image</span>
                                    {% endif %}
                                </div>
                                <div class="col-6">
                                    <div class="small text-muted mb-1">Proposed</div>
                                    <a class="gallery-item d-block" href="{{ uploaded_asset(request.proposedImage) }}">
                                        <img src="{{ request.proposedImage|puzzle_image('puzzle_small') }}"
                                             alt="Proposed image"
                                             class="img-thumbnail w-100 border-warning"
                                             style="max-height: 180px; object-fit: contain;">
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    {% if not request.hasAnyChange() %}
                        <div class="alert alert-info">
                            No changes were proposed. The user may have submitted the form without modifications.
                        </div>
                    {% endif %}

                    {# Rejection reason if rejected #}
                    {% if request.status.value == 'rejected' and request.rejectionReason %}
                        <div class="alert alert-danger mt-4 text-break">
                            <strong>Rejection Reason:</strong><br>
                            {{ request.rejectionReason }}
                        </div>
                    {% endif %}

                    {# Action buttons for pending requests #}
                    {% if pending %}
                        <div class="d-grid d-sm-flex gap-2 pt-3 mt-2 border-top">
                            <button type="submit" class="btn btn-success" data-change-request-fields-target="approveButton">
                                <i class="bi bi-check-lg me-1"></i> Approve selected
                            </button>

                            <button type="button"
                                    class="btn btn-outline-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#rejectModal">
                                <i class="bi bi-x-lg me-1"></i> Reject
                            </button>
                        </div>
                    </form>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            {# Reporter info #}
            <div class="card shadow mb-4">
                <div class="card-header px-3 px-md-4">
                    <h2 class="h5 mb-0">Reporter</h2>
                </div>
                <div class="card-body px-3 px-md-4">
                    <a href="{{ path('player_profile', {playerId: request.reporterId}) }}" target="_blank">
                        {{ request.reporterName ?? '#' ~ request.reporterCode }}
                    </a>
                    {% if request.reporterName and request.reporterCode %}
                        <span class="text-muted">#{{ request.reporterCode }}</span>
                    {% endif %}
                    <br>
                    <small class="text-muted">Submitted: {{ request.submittedAt|ago }}</small>
                </div>
            </div>

            {# Review info if reviewed #}
            {% if request.reviewedAt %}
                <div class="card shadow">
                    <div class="card-header px-3 px-md-4">
                        <h2 class="h5 mb-0">Review</h2>
                    </div>
                    <div class="card-body px-3 px-md-4">
                        {% if request.reviewerName %}
                            Reviewed by: {{ request.reviewerName }}
                        {% endif %}
                        <br>
                        <small class="text-muted">{{ request.reviewedAt|ago }}</small>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

{# Reject Modal #}
{% if pending %}
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="{{ path('admin_reject_puzzle_change_request', {id: request.id}) }}" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Reject Change Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="rejectionReason" class="form-label">Rejection Reason</label>
                        <textarea class="form-control"
                                  id="rejectionReason"
                                  name="rejection_reason"
                                  rows="3"
                                  required
                                  placeholder="Explain why this change request is being rejected..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
