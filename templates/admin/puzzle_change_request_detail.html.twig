{% extends 'base.html.twig' %}

{% block title %}Change Request - {{ request.puzzleName }}{% endblock %}

{% block content %}
    {% include '_return_back_button.html.twig' with {fallbackUrl: path('admin_puzzle_change_requests'), fallbackTitle: 'Change requests'} %}

    {% set pending = form is not null %}

    {% set fields = [] %}
    {% if request.hasNameChange() %}
        {% set fields = fields|merge([{key: 'name', label: 'Name', original: request.originalName, proposed: request.proposedName}]) %}
    {% endif %}
    {% if request.hasManufacturerChange() %}
        {% set fields = fields|merge([{key: 'manufacturer', label: 'Manufacturer', original: request.originalManufacturerName, proposed: request.proposedManufacturerName}]) %}
    {% endif %}
    {% if request.hasPiecesCountChange() %}
        {% set fields = fields|merge([{key: 'piecesCount', label: 'Pieces', original: request.originalPiecesCount, proposed: request.proposedPiecesCount}]) %}
    {% endif %}
    {% if request.hasEanChange() %}
        {% set fields = fields|merge([{key: 'ean', label: 'EAN', original: request.originalEan, proposed: request.proposedEan}]) %}
    {% endif %}
    {% if request.hasIdentificationNumberChange() %}
        {% set fields = fields|merge([{key: 'identificationNumber', label: 'Brand Code', original: request.originalIdentificationNumber, proposed: request.proposedIdentificationNumber}]) %}
    {% endif %}

    <div class="row">
        {# No card around the form - on a phone the field cards are enough #}
        <div class="col-lg-8 mb-4">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <h1 class="h4 mb-0">Change Request</h1>
                {% if pending %}
                    <span class="badge bg-warning text-dark">Pending</span>
                {% elseif request.status.value == 'approved' %}
                    <span class="badge bg-success">Approved</span>
                {% else %}
                    <span class="badge bg-danger">Rejected</span>
                {% endif %}
            </div>

            {# Puzzle info header #}
            <div class="d-flex align-items-center gap-3 mb-3 p-2 p-md-3 bg-light rounded">
                {% if request.puzzleImage %}
                    <img src="{{ request.puzzleImage|puzzle_image('puzzle_small') }}"
                         alt="{{ request.puzzleName }}"
                         class="rounded flex-shrink-0"
                         style="max-height: 64px; max-width: 90px;">
                {% endif %}
                <div class="min-w-0">
                    <h2 class="h6 mb-1 text-break">
                        <a href="{{ path('puzzle_detail', {puzzleId: request.puzzleId}) }}" target="_blank">
                            {{ request.puzzleName }}
                        </a>
                    </h2>
                    <p class="mb-0 text-muted small">
                        {{ request.puzzleManufacturerName }} &bull; {{ request.puzzlePiecesCount }} pieces
                        &bull; <a href="{{ path('admin_puzzle_history', {puzzleId: request.puzzleId}) }}">History</a>
                    </p>
                </div>
            </div>

            {% if pending %}
                {{ include('admin/_puzzle_change_request_review.html.twig') }}
            {% else %}
                <h2 class="h5 mb-3">Proposed Changes</h2>

                {% for field in fields %}
                    <div class="border rounded-3 p-3 mb-3 shadow-sm">
                        <div class="fw-semibold mb-2">{{ field.label }}</div>
                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <div class="small text-muted mb-1">When proposed</div>
                                <div class="text-break">
                                    {% if field.original is null or field.original == '' %}
                                        <span class="text-muted fst-italic">Not set</span>
                                    {% else %}
                                        {{ field.original }}
                                    {% endif %}
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="small text-muted mb-1">Proposed</div>
                                <div class="text-break bg-warning bg-opacity-10 rounded px-2 py-1 fw-semibold">{{ field.proposed }}</div>
                            </div>
                        </div>
                    </div>
                {% endfor %}

                {% if request.hasImageChange() %}
                    <div class="border rounded-3 p-3 mb-3 shadow-sm">
                        <div class="fw-semibold mb-2">Image</div>

                        {# Side by side even on phones - the point is to compare the two #}
                        <div class="row g-2 gallery">
                            <div class="col-6">
                                <div class="small text-muted mb-1">When proposed</div>
                                {% if request.originalImage %}
                                    <a class="gallery-item d-block" href="{{ uploaded_asset(request.originalImage) }}">
                                        <img src="{{ request.originalImage|puzzle_image('puzzle_small') }}"
                                             alt="Image when proposed"
                                             class="img-thumbnail w-100"
                                             style="max-height: 180px; object-fit: contain;">
                                    </a>
                                {% else %}
                                    <span class="text-muted fst-italic">No image</span>
                                {% endif %}
                            </div>
                            <div class="col-6">
                                <div class="small text-muted mb-1">Proposed</div>
                                <a class="gallery-item d-block" href="{{ uploaded_asset(request.proposedImage) }}">
                                    <img src="{{ request.proposedImage|puzzle_image('puzzle_small') }}"
                                         alt="Proposed image"
                                         class="img-thumbnail w-100 border-warning"
                                         style="max-height: 180px; object-fit: contain;">
                                </a>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {% if not request.hasAnyChange() %}
                    <div class="alert alert-info">
                        No changes were proposed. The user may have submitted the form without modifications.
                    </div>
                {% endif %}
            {% endif %}

            {# Rejection reason if rejected #}
            {% if request.status.value == 'rejected' and request.rejectionReason %}
                <div class="alert alert-danger mt-4 text-break">
                    <strong>Rejection Reason:</strong><br>
                    {{ request.rejectionReason }}
                </div>
            {% endif %}
        </div>

        <div class="col-lg-4">
            {# Reporter info #}
            <div class="card shadow mb-4">
                <div class="card-header px-3 px-md-4">
                    <h2 class="h5 mb-0">Reporter</h2>
                </div>
                <div class="card-body px-3 px-md-4">
                    <a href="{{ path('player_profile', {playerId: request.reporterId}) }}" target="_blank">
                        {{ request.reporterName ?? ('#' ~ request.reporterCode) }}
                    </a>
                    {% if request.reporterName and request.reporterCode %}
                        <span class="text-muted">#{{ request.reporterCode }}</span>
                    {% endif %}
                    <br>
                    <small class="text-muted">Submitted: {{ request.submittedAt|ago }}</small>
                </div>
            </div>

            {# Review info if reviewed #}
            {% if request.reviewedAt %}
                <div class="card shadow">
                    <div class="card-header px-3 px-md-4">
                        <h2 class="h5 mb-0">Review</h2>
                    </div>
                    <div class="card-body px-3 px-md-4">
                        {% if request.reviewerName %}
                            Reviewed by: {{ request.reviewerName }}
                        {% endif %}
                        <br>
                        <small class="text-muted">{{ request.reviewedAt|ago }}</small>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

{# Reject Modal #}
{% if pending %}
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="{{ path('admin_reject_puzzle_change_request', {id: request.id}) }}" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Reject Change Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="rejectionReason" class="form-label">Rejection Reason</label>
                        <textarea class="form-control"
                                  id="rejectionReason"
                                  name="rejection_reason"
                                  rows="3"
                                  required
                                  placeholder="Explain why this change request is being rejected..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
