{% extends 'base.html.twig' %}

{% block title %}Picture proposals{% endblock %}

{#
    The picture review (PuzzleChangeRequestPicturesController, docs/features/puzzle-approvals.md "Picture proposals"):
    pending proposals of a new picture, surest first, one card each (admin/_picture_proposal_card.html.twig). A decision
    replaces its card only (Turbo Stream); picture_review_controller.js adds the keys. English, like the other review pages.
#}
{% set grid = {tag: tag_parameter, source: filter.source.value ?? null, page: page} %}

{% block content %}
    {% include '_return_back_button.html.twig' with {
        fallbackUrl: path('admin_puzzle_change_requests'),
        fallbackTitle: 'Change requests',
    } %}

    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
        <h1 class="h3 mb-0">Picture proposals</h1>
        <span class="text-muted small" data-role="picture-total">{{ total }} pending</span>
    </div>

    <p class="small text-muted mb-3">
        The puzzle's picture now and the proposed one side by side, the surest proposals first. Approving uses the proposed
        picture and changes nothing else; the old picture is kept and can be restored from the puzzle's history.
    </p>

    <form method="get" action="{{ path('admin_puzzle_change_request_pictures') }}" class="row g-2 align-items-end mb-3" data-role="picture-filters">
        <div class="col-6 col-md-auto">
            <label class="form-label small text-muted mb-1" for="picture-filter-tag">Tag</label>
            <select class="form-select form-select-sm" id="picture-filter-tag" name="tag">
                <option value="all" {{ filter.tag is null ? 'selected' }}>Every proposed picture</option>
                {% for tag in known_tags|merge(filter.tag is not null and filter.tag not in known_tags ? [filter.tag] : []) %}
                    <option value="{{ tag }}" {{ filter.tag == tag ? 'selected' }}>{{ tag }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-6 col-md-auto">
            <label class="form-label small text-muted mb-1" for="picture-filter-source">Filed by</label>
            <select class="form-select form-select-sm" id="picture-filter-source" name="source">
                <option value="">Anyone</option>
                {% for value, label in {image_pipeline: 'Image pipeline', internal_api: 'Internal API', player: 'A player'} %}
                    <option value="{{ value }}" {{ filter.source is not null and filter.source.value == value ? 'selected' }}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-12 col-md-auto">
            <button type="submit" class="btn btn-primary btn-sm">Filter</button>
        </div>
    </form>

    {% if proposals is empty %}
        <div class="alert alert-info" data-role="no-pictures">Nothing to review - no pending picture proposal matches.</div>
    {% else %}
        <p class="small text-muted d-none d-md-block picture-proposal-keys" data-role="key-hints">
            Keys: <kbd>J</kbd> / <kbd>&rarr;</kbd> next &middot; <kbd>K</kbd> / <kbd>&larr;</kbd> previous &middot;
            <kbd>A</kbd> approve &middot; <kbd>R</kbd> reject with the default reason &middot; <kbd>O</kbd> open the request
        </p>

        <div class="row row-cols-1 row-cols-xl-2 g-3 gallery"
             data-controller="picture-review"
             data-action="keydown@document->picture-review#key turbo:submit-start->picture-review#submitted">
            {% for request in proposals %}
                <div class="col">
                    {{ include('admin/_picture_proposal_card.html.twig', {request: request, grid: grid}) }}
                </div>
            {% endfor %}
        </div>

        <p class="small text-muted mt-3 mb-2">Decided cards stay until the page is loaded again - the next page then starts with what is still pending.</p>

        {% if pages > 1 %}
            <nav aria-label="Picture proposals pages">
                <ul class="pagination flex-wrap">
                    {% for number in 1..pages %}
                        <li class="page-item {{ number == page ? 'active' }}">
                            <a class="page-link" href="{{ path('admin_puzzle_change_request_pictures', filter.toQuery()|merge({tag: tag_parameter, page: number})) }}" {{ number == page ? 'aria-current="page"' }}>{{ number }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}
