{% extends 'base.html.twig' %}

{% block title %}Puzzle Change Requests{% endblock %}

{% block content %}
    <h1 class="h3 mb-4">Puzzle Change Requests</h1>

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link py-2 px-2 px-md-3 fs-sm {{ active_tab == 'pending' ? 'active' : '' }}"
               href="{{ path('admin_puzzle_change_requests', {tab: 'pending'}) }}">
                Pending
                {% if counts.pending > 0 %}
                    <span class="badge bg-warning text-dark">{{ counts.pending }}</span>
                {% endif %}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link py-2 px-2 px-md-3 fs-sm {{ active_tab == 'approved' ? 'active' : '' }}"
               href="{{ path('admin_puzzle_change_requests', {tab: 'approved'}) }}">
                Approved
                {% if counts.approved > 0 %}
                    <span class="badge bg-success">{{ counts.approved }}</span>
                {% endif %}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link py-2 px-2 px-md-3 fs-sm {{ active_tab == 'rejected' ? 'active' : '' }}"
               href="{{ path('admin_puzzle_change_requests', {tab: 'rejected'}) }}">
                Rejected
                {% if counts.rejected > 0 %}
                    <span class="badge bg-danger">{{ counts.rejected }}</span>
                {% endif %}
            </a>
        </li>
        {# Closed without a review - the catalogue already did what they asked (OutdatedPuzzleRequests) #}
        <li class="nav-item">
            <a class="nav-link py-2 px-2 px-md-3 fs-sm {{ active_tab == 'outdated' ? 'active' : '' }}"
               href="{{ path('admin_puzzle_change_requests', {tab: 'outdated'}) }}">
                Already done
                {% if counts.outdated > 0 %}
                    <span class="badge bg-secondary">{{ counts.outdated }}</span>
                {% endif %}
            </a>
        </li>
    </ul>

    {% if requests is empty %}
        <div class="alert alert-info">
            {% if active_tab == 'outdated' %}No change requests closed as already done.{% else %}No {{ active_tab }} change requests.{% endif %}
        </div>
    {% else %}
        <div class="card shadow">
            <div class="list-group list-group-flush">
                {% for request in requests %}
                    <a href="{{ path('admin_puzzle_change_request_detail', {id: request.id}) }}"
                       class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                        <div class="flex-shrink-0 text-center" style="width: 56px;">
                            {% if request.puzzleImage %}
                                <img src="{{ request.puzzleImage|puzzle_image('puzzle_small') }}"
                                     alt=""
                                     class="rounded"
                                     style="max-height: 56px; max-width: 56px;">
                            {% else %}
                                <i class="bi bi-puzzle text-muted fs-3"></i>
                            {% endif %}
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-semibold text-body text-break">{{ request.puzzleName }}</div>
                            <div class="small text-muted">
                                {{ request.puzzleManufacturerName }} &bull; {{ request.puzzlePiecesCount }} pcs
                            </div>
                            <div class="d-flex flex-wrap gap-1 my-1">
                                {% if request.hasNameChange() %}<span class="badge bg-secondary">Name</span>{% endif %}
                                {% if request.hasNameLanguageChange() or request.hasAlternativeNamesChange() %}<span class="badge bg-secondary">Other names</span>{% endif %}
                                {% if request.hasManufacturerChange() %}<span class="badge bg-secondary">Manufacturer</span>{% endif %}
                                {% if request.hasPiecesCountChange() %}<span class="badge bg-secondary">Pieces</span>{% endif %}
                                {% if request.hasEanChange() %}<span class="badge bg-secondary">EAN</span>{% endif %}
                                {% if request.hasIdentificationNumberChange() %}<span class="badge bg-secondary">Brand Code</span>{% endif %}
                                {% if request.hasImageChange() %}<span class="badge bg-secondary">Image</span>{% endif %}
                            </div>
                            <div class="small text-muted text-break">
                                {{ request.reporterName ? request.reporterName ~ ' #' ~ request.reporterCode : '#' ~ request.reporterCode }}
                                &bull; {{ request.submittedAt|ago }}
                            </div>
                            {% if request.status.value == 'outdated' %}
                                <div class="small text-muted">
                                    {{ request.outdatedReason ? request.outdatedReason.label() : 'Already done' }} &bull; closed {{ request.reviewedAt|ago }}
                                </div>
                            {% elseif active_tab != 'pending' and request.reviewedAt %}
                                <div class="small text-muted">
                                    Reviewed {{ request.reviewedAt|ago }}{% if request.reviewerName %} by {{ request.reviewerName }}{% endif %}
                                </div>
                            {% endif %}
                        </div>
                        <i class="bi bi-chevron-right text-muted flex-shrink-0"></i>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
