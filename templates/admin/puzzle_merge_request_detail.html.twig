{% extends 'base.html.twig' %}

{% import 'admin/_puzzle_macros.html.twig' as macros %}

{% block title %}Merge Request - {{ request.sourcePuzzleName }}{% endblock %}

{#
    The review of a merge request: the reported puzzles side by side (what differs is marked, the language the reporter
    gave each name), which one keeps its address (merge_review_controller.js), and the merged puzzle's fields - every
    name of all of them in the names editor, the rest with one-click choices from the reported ones. No card around it
    all - on a phone the puzzle and field cards are enough.
#}
{% block content %}
    {% include '_return_back_button.html.twig' with {fallbackUrl: path('admin_puzzle_merge_requests'), fallbackTitle: 'Merge requests'} %}

    {% set pending = request.status.value == 'pending' %}
    {% set differs = merged_data.differs %}
    {% set total_times = merged_data.total_solved_times %}

    <div class="row">
        <div class="col-xl-10 mb-4">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                <h1 class="h4 mb-0">Merge Request</h1>
                {% if pending %}
                    <span class="badge bg-warning text-dark">Pending</span>
                {% elseif request.status.value == 'approved' %}
                    <span class="badge bg-success">Approved</span>
                {% else %}
                    <span class="badge bg-danger">Rejected</span>
                {% endif %}
            </div>

            <p class="small text-muted mb-3 text-break">
                Reported by
                {% if request.reporterId %}
                    {{ macros.player(request.reporterId, request.reporterName, request.reporterCode) }}
                {% else %}
                    <span class="fst-italic">a deleted account</span>
                {% endif %}
                &bull; {{ request.submittedAt|ago }}
            </p>

            {% if request.status.value == 'rejected' and request.rejectionReason %}
                <div class="alert alert-danger text-break">
                    <strong>Rejection reason:</strong><br>
                    {{ request.rejectionReason }}
                </div>
            {% endif %}

            {% if request.reviewedAt %}
                <div class="p-2 p-md-3 mb-3 bg-light rounded small text-break">
                    Reviewed {{ request.reviewedAt|ago }}{% if request.reviewerName %} by {{ request.reviewerName }}{% endif %}.
                    {% if request.finalMergedPuzzleId %}
                        The merged puzzle:
                        <a href="{{ path('puzzle_detail', {puzzleId: request.finalMergedPuzzleId}) }}" target="_blank">{{ request.survivorPuzzleName ?? 'view' }}</a>
                        &bull; <a href="{{ path('admin_puzzle_history', {puzzleId: request.finalMergedPuzzleId}) }}">History</a>
                    {% endif %}
                </div>
            {% endif %}

            {% if puzzles is empty %}
                <div class="alert alert-warning">
                    All reported puzzles have been deleted.
                </div>
            {% else %}
                {% if form %}
                    {# Posts back here with the query string - a merge started from the approval queue returns there #}
                    {{ form_start(form, {
                        action: app.request.requestUri,
                        attr: {
                            'data-controller': 'merge-review',
                            'data-action': 'input->merge-review#refreshChoices change->merge-review#refreshChoices',
                        },
                    }) }}

                    {{ form_errors(form) }}

                    {% set survivor_radios = {} %}
                    {% for radio in form.survivorPuzzleId %}
                        {% set survivor_radios = survivor_radios|merge({(radio.vars.value): radio}) %}
                    {% endfor %}

                    <p class="small text-muted mb-3">
                        These puzzles were reported as one and the same. Approving keeps one of them - its address and
                        everything recorded on it - with the details you set below, deletes the others and moves their
                        solving times, collections, wish lists, offers and lendings onto it. Nothing is lost.
                    </p>
                {% endif %}

                <h2 class="h5 mb-3">Reported puzzles ({{ puzzles|length }})</h2>

                {# What differs between the puzzles is highlighted #}
                {% set differs_class = 'bg-warning bg-opacity-25 rounded px-1' %}
                <div class="row g-3 mb-4 gallery">
                    {% for puzzle in puzzles %}
                        {% set survivor_radio = form ? (survivor_radios[puzzle.puzzleId] ?? null) : null %}
                        {% set is_survivor = survivor_radio is not null and survivor_radio.vars.checked %}
                        <div class="col-12 col-md-6 {{ puzzles|length > 2 ? 'col-xl-4' }}">
                            <div class="border rounded-3 p-3 h-100 shadow-sm {{ is_survivor ? 'border-2 border-success' }}"
                                 {% if survivor_radio %}data-merge-review-target="card" data-puzzle-id="{{ puzzle.puzzleId }}"{% endif %}>
                                {% if survivor_radio %}
                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                        {{ form_widget(survivor_radio, {
                                            label_attr: {class: 'fw-semibold'},
                                            attr: {
                                                'data-merge-review-target': 'survivor',
                                                'data-action': 'change->merge-review#survivorChanged',
                                            },
                                        }) }}
                                        <span class="badge bg-success {{ is_survivor ? '' : 'd-none' }}" data-role="survivor-badge">Keeps its address</span>
                                    </div>
                                {% endif %}

                                {{ macros.thumbnail(puzzle.puzzleImage, puzzle.puzzleName, 160) }}

                                <h3 class="h6 mt-2 mb-1 text-break">
                                    <a class="{{ differs.name ? differs_class }}" href="{{ path('puzzle_detail', {puzzleId: puzzle.puzzleId}) }}" target="_blank">{{ puzzle.puzzleName }}</a>
                                </h3>
                                {% set record = records[puzzle.puzzleId] %}
                                {% for other_name in record.alternativeNames.all() %}
                                    <div class="small text-muted text-break mb-1">
                                        {{ other_name.name }}{% if other_name.language %} <span class="badge bg-light text-dark border">{{ other_name.language }}</span>{% endif %}
                                    </div>
                                {% endfor %}

                                <dl class="row small mb-2">
                                    {% if reported_languages[puzzle.puzzleId] is defined %}
                                        <dt class="col-5 fw-normal text-muted">Reporter says</dt>
                                        <dd class="col-7 text-break mb-1">The name is in {{ reported_languages[puzzle.puzzleId] }}</dd>
                                    {% elseif record.nameLanguage %}
                                        <dt class="col-5 fw-normal text-muted">Main title in</dt>
                                        <dd class="col-7 text-break mb-1">{{ record.nameLanguage }}</dd>
                                    {% endif %}
                                    <dt class="col-5 fw-normal text-muted">Brand</dt>
                                    <dd class="col-7 text-break mb-1"><span class="{{ differs.brand ? differs_class }}">{{ puzzle.manufacturerName }}</span></dd>
                                    <dt class="col-5 fw-normal text-muted">Pieces</dt>
                                    <dd class="col-7 mb-1"><span class="{{ differs.pieces ? differs_class }}">{{ puzzle.piecesCount }}</span></dd>
                                    <dt class="col-5 fw-normal text-muted">EAN</dt>
                                    <dd class="col-7 text-break mb-1"><span class="d-block {{ differs.ean ? differs_class }}">{{ macros.shown_list(puzzle_eans(puzzle.puzzleEan)) }}</span></dd>
                                    <dt class="col-5 fw-normal text-muted">Brand code</dt>
                                    <dd class="col-7 text-break mb-1"><span class="d-block {{ differs.code ? differs_class }}">{{ macros.shown_list(puzzle_brand_codes(puzzle.puzzleIdentificationNumber)) }}</span></dd>
                                    <dt class="col-5 fw-normal text-muted">Solving times</dt>
                                    <dd class="col-7 mb-0">{{ puzzle.solvedTimes }}</dd>
                                </dl>

                                <a class="small" href="{{ path('admin_puzzle_history', {puzzleId: puzzle.puzzleId}) }}">
                                    <i class="bi bi-clock-history me-1"></i>History
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {% if form %}
                    <h2 class="h5 mb-2">The merged puzzle</h2>
                    <p class="small text-muted mb-3">
                        Prefilled from the puzzle with the most solving times: every name of all the puzzles, EAN and
                        brand code from all of them.
                        {% if differs.brand or differs.pieces %}Where the puzzles differ, pick a value in one click.{% endif %}
                    </p>

                    {# Names: the survivor's main title, every other name of all the puzzles - the reporter's languages applied #}
                    <div class="border rounded-3 p-3 mb-3 shadow-sm {{ differs.name ? 'border-warning border-2' }}">
                        <div class="form-label fw-semibold">Names</div>
                        {% if differs.name %}
                            <p class="small text-muted mb-2">
                                The main title is the English title of the box when it has one - pick it with "Make main
                                title", and set the language of every other name.
                            </p>
                        {% endif %}
                        {{ include('puzzle/_names_editor.html.twig', {names: form.names}) }}
                    </div>

                    {# Brand #}
                    <div class="border rounded-3 p-3 mb-3 shadow-sm {{ differs.brand ? 'border-warning border-2' }}">
                        {{ form_label(form.manufacturerId, 'Brand', {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.manufacturerId) }}
                        {{ form_errors(form.manufacturerId) }}
                        {% if differs.brand %}
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                {% for manufacturerId, manufacturerName in merged_data.manufacturers %}
                                    <button type="button" class="btn btn-outline-secondary btn-sm text-start text-wrap text-break"
                                            data-merge-review-target="choice" data-action="merge-review#use"
                                            data-input="{{ form.manufacturerId.vars.full_name }}" data-value="{{ manufacturerId }}">{{ manufacturerName }}</button>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    {# Pieces #}
                    <div class="border rounded-3 p-3 mb-3 shadow-sm {{ differs.pieces ? 'border-warning border-2' }}">
                        {{ form_label(form.piecesCount, 'Pieces', {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.piecesCount) }}
                        {{ form_errors(form.piecesCount) }}
                        {% if differs.pieces %}
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                {% for count in merged_data.pieces_counts %}
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            data-merge-review-target="choice" data-action="merge-review#use"
                                            data-input="{{ form.piecesCount.vars.full_name }}" data-value="{{ count }}">{{ count }} pieces</button>
                                {% endfor %}
                            </div>
                            <div class="form-text text-warning">The puzzles have different piece counts - check the box photos.</div>
                        {% endif %}
                    </div>

                    {# EAN and brand code: the union of all - a puzzle may have one per edition or region; the merge adds every
                       code of the merged puzzles either way #}
                    {{ include('puzzle/_code_inputs.html.twig', {
                        field: form.eans,
                        label: 'EAN',
                        add_label: '+ another',
                        remove_label: 'Remove this code',
                        help: 'All codes of the puzzles - one per edition or region. Never reduce the list.',
                        max: 0,
                        label_class: 'form-label fw-semibold',
                        wrapper_class: 'border rounded-3 p-3 mb-3 shadow-sm',
                    }, with_context = false) }}

                    {{ include('puzzle/_code_inputs.html.twig', {
                        field: form.brandCodes,
                        label: 'Brand code',
                        add_label: '+ another',
                        remove_label: 'Remove this code',
                        max: 0,
                        label_class: 'form-label fw-semibold',
                        wrapper_class: 'border rounded-3 p-3 mb-3 shadow-sm',
                    }, with_context = false) }}

                    {# Image: one of the reported puzzles' images #}
                    {% if form.selectedImagePuzzleId is defined %}
                        <div class="border rounded-3 p-3 mb-3 shadow-sm">
                            <div class="form-label fw-semibold">Image</div>
                            <div class="row g-2 gallery">
                                {% for image_radio in form.selectedImagePuzzleId %}
                                    {% set image_puzzle = puzzles|filter(p => p.puzzleId == image_radio.vars.value)|first %}
                                    <div class="col-6 col-md-4">
                                        <div class="border rounded-3 p-2 h-100">
                                            <div class="mb-2">
                                                {{ form_widget(image_radio, {
                                                    label: image_puzzle ? image_puzzle.puzzleName : 'This image',
                                                    label_attr: {class: 'small text-break'},
                                                }) }}
                                            </div>
                                            {{ macros.thumbnail(merged_data.images[image_radio.vars.value], 'Puzzle image', 140) }}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            {{ form_errors(form.selectedImagePuzzleId) }}
                        </div>
                    {% endif %}

                    {# Kept in the puzzle's history next to the merge #}
                    <div class="mb-3">
                        {{ form_label(form.decisionNote, 'Note for the history (optional)', {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.decisionNote) }}
                        {{ form_errors(form.decisionNote) }}
                    </div>

                    <div class="pt-3 mt-2 border-top">
                        {% for puzzle in puzzles %}
                            {% set others = puzzles|length - 1 %}
                            {% set moved_times = total_times - puzzle.solvedTimes %}
                            <p class="small mb-3 {{ puzzle.puzzleId == form.survivorPuzzleId.vars.value ? '' : 'd-none' }}"
                               data-merge-review-target="summary" data-puzzle-id="{{ puzzle.puzzleId }}" aria-live="polite">
                                Approving keeps <strong>{{ puzzle.puzzleName }}</strong> (its address and its {{ puzzle.solvedTimes }} solving {{ puzzle.solvedTimes == 1 ? 'time' : 'times' }}),
                                deletes the other {{ others == 1 ? 'puzzle' : others ~ ' puzzles' }}
                                and moves {{ moved_times }} solving {{ moved_times == 1 ? 'time' : 'times' }} onto it.
                            </p>
                        {% endfor %}

                        <div class="d-grid d-sm-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg me-1"></i> Approve and merge
                            </button>

                            <button type="button"
                                    class="btn btn-outline-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#rejectModal">
                                <i class="bi bi-x-lg me-1"></i> Reject
                            </button>
                        </div>
                    </div>
                    {{ form_end(form) }}
                {% endif %}
            {% endif %}
        </div>
    </div>

{# Reject Modal #}
{% if pending %}
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="{{ path('admin_reject_puzzle_merge_request', {id: request.id}) }}" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Reject Merge Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="rejectionReason" class="form-label">Rejection Reason</label>
                        <textarea class="form-control"
                                  id="rejectionReason"
                                  name="rejection_reason"
                                  rows="3"
                                  required
                                  placeholder="Explain why this merge request is being rejected..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
