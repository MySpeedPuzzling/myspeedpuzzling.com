{% extends 'base.html.twig' %}

{% block title %}Puzzle Merge Requests{% endblock %}

{% block content %}
    <h1 class="h3 mb-4">Puzzle Merge Requests</h1>

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link py-2 px-2 px-md-3 fs-sm {{ active_tab == 'pending' ? 'active' : '' }}"
               href="{{ path('admin_puzzle_merge_requests', {tab: 'pending'}) }}">
                Pending
                {% if counts.pending > 0 %}
                    <span class="badge bg-warning text-dark">{{ counts.pending }}</span>
                {% endif %}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link py-2 px-2 px-md-3 fs-sm {{ active_tab == 'approved' ? 'active' : '' }}"
               href="{{ path('admin_puzzle_merge_requests', {tab: 'approved'}) }}">
                Approved
                {% if counts.approved > 0 %}
                    <span class="badge bg-success">{{ counts.approved }}</span>
                {% endif %}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link py-2 px-2 px-md-3 fs-sm {{ active_tab == 'rejected' ? 'active' : '' }}"
               href="{{ path('admin_puzzle_merge_requests', {tab: 'rejected'}) }}">
                Rejected
                {% if counts.rejected > 0 %}
                    <span class="badge bg-danger">{{ counts.rejected }}</span>
                {% endif %}
            </a>
        </li>
    </ul>

    {% if requests is empty %}
        <div class="alert alert-info">
            No {{ active_tab }} merge requests.
        </div>
    {% else %}
        <div class="card shadow">
            <div class="list-group list-group-flush">
                {% for request in requests %}
                    {% set puzzleImage = request.survivorPuzzleImage ?? request.sourcePuzzleImage %}
                    {% set puzzleName = request.survivorPuzzleName ?? request.sourcePuzzleName %}
                    {% set puzzlePiecesCount = request.survivorPuzzlePiecesCount ?? request.sourcePuzzlePiecesCount %}
                    {% set puzzleManufacturerName = request.survivorPuzzleManufacturerName ?? request.sourcePuzzleManufacturerName %}
                    <a href="{{ path('admin_puzzle_merge_request_detail', {id: request.id}) }}"
                       class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                        <div class="flex-shrink-0 text-center" style="width: 56px;">
                            {% if puzzleImage %}
                                <img src="{{ puzzleImage|puzzle_image('puzzle_small') }}"
                                     alt=""
                                     class="rounded"
                                     style="max-height: 56px; max-width: 56px;">
                            {% else %}
                                <i class="bi bi-puzzle text-muted fs-3"></i>
                            {% endif %}
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-semibold text-body text-break">{{ puzzleName }}</div>
                            <div class="small text-muted">
                                {{ puzzleManufacturerName }} &bull; {{ puzzlePiecesCount }} pcs
                            </div>
                            <div class="my-1">
                                <span class="badge bg-secondary">{{ request.duplicateCount }} puzzles</span>
                            </div>
                            <div class="small text-muted text-break">
                                {{ request.reporterName ? request.reporterName ~ ' #' ~ request.reporterCode : '#' ~ request.reporterCode }}
                                &bull; {{ request.submittedAt|ago }}
                            </div>
                            {% if active_tab != 'pending' and request.reviewedAt %}
                                <div class="small text-muted">
                                    Reviewed {{ request.reviewedAt|ago }}{% if request.reviewerName %} by {{ request.reviewerName }}{% endif %}
                                </div>
                            {% endif %}
                        </div>
                        <i class="bi bi-chevron-right text-muted flex-shrink-0"></i>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
