{# One case of the time verification queue. Expects: case (SuspiciousTimeCaseCard), tab, page, note_max_length;
   in_puzzle_card (optional) leaves out what the puzzle card above already shows.
   Reading order: whose time on what - how far off - why it is here (the ticked reasons are what the player reads) -
   the player's numbers - the decision. #}
{% set in_puzzle_card = in_puzzle_card ?? false %}
{% set heading_level = in_puzzle_card ? 5 : 3 %}
{% set ratio = case.ratio %}
{% set status = case.status.value %}
{% set group_label = case.puzzlersCount == 2 ? 'Pair' : 'Team of ' ~ case.puzzlersCount %}
{% set player_label = case.playerName ?? ('#' ~ case.playerCode) %}
{# A pending case is decided here - unless its time changed since the scan (the next scan judges the new entry) #}
{% set deciding = status == 'pending' and not case.isEditedSinceScan %}
{% set shown_reasons = case.reasons|filter(reason => reason.code.isShownToPlayer) %}
{% set hidden_reasons = case.reasons|filter(reason => not reason.code.isShownToPlayer) %}
{% set source_texts = {
    prediction: 'prediction for this puzzle',
    baseline: 'usual for ' ~ case.piecesCount ~ ' pcs (baseline)',
    pace: 'pace on other puzzles',
} %}
{# The fields every decision form of the case posts #}
{% set case_form_fields %}
    <input type="hidden" name="_token" value="{{ csrf_token('time-verification-' ~ case.caseId) }}">
    <input type="hidden" name="tab" value="{{ tab.value }}">
    <input type="hidden" name="page" value="{{ page }}">
    <input type="hidden" name="fingerprint" value="{{ case.currentFingerprint }}">
{% endset %}
<article class="card tv-case {{ in_puzzle_card ? 'tv-case-nested' : 'shadow-sm' }} mb-3" id="case-{{ case.caseId }}" data-testid="time-verification-case" aria-labelledby="case-{{ case.caseId }}-title">
    <div class="card-body p-3 p-md-4">

        {# Whose time on what #}
        <div class="d-flex gap-3 align-items-start mb-3">
            {% if not in_puzzle_card %}
                <a class="tv-thumb" href="{{ path('puzzle_detail', {puzzleId: case.puzzleId}) }}" tabindex="-1" aria-hidden="true">
                    {% if case.puzzleImage %}
                        <img src="{{ case.puzzleImage|puzzle_image('puzzle_small') }}" alt="" loading="lazy">
                    {% else %}
                        <i class="bi bi-puzzle"></i>
                    {% endif %}
                </a>
            {% endif %}
            <div class="flex-grow-1 min-w-0">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <h{{ heading_level }} class="h6 mb-0 text-break" id="case-{{ case.caseId }}-title">
                        {% if in_puzzle_card %}
                            <a href="{{ path('player_profile', {playerId: case.playerId}) }}">{{ player_label }}</a>
                            {% if case.playerName %}<span class="fw-normal text-muted">#{{ case.playerCode }}</span>{% endif %}
                        {% else %}
                            <a href="{{ path('puzzle_detail', {puzzleId: case.puzzleId}) }}">{{ case.puzzleName }}</a>
                        {% endif %}
                    </h{{ heading_level }}>
                    {% if case.tier %}
                        <span class="badge {{ case.tier.value == 'strong' ? 'bg-danger' : 'bg-secondary' }}" title="How sure the scan is">{{ case.tier.value == 'strong' ? 'Strong' : 'Possible' }}</span>
                    {% endif %}
                    {% if case.puzzlersCount > 1 %}<span class="badge bg-info text-dark">{{ group_label }}</span>{% endif %}
                    {% if case.firstAttempt %}<span class="badge bg-light text-dark border">First try</span>{% endif %}
                    {% if case.unboxed %}<span class="badge bg-light text-dark border">Unboxed</span>{% endif %}
                    {% if case.playerPrivate %}<span class="badge bg-light text-dark border"><i class="bi bi-lock-fill" aria-hidden="true"></i> Private profile</span>{% endif %}
                    {% if case.origin.value == 'manual' %}<span class="badge bg-light text-dark border">Flagged outside the app</span>{% endif %}
                    {% if case.origin.value == 'moderator' %}<span class="badge bg-light text-dark border">Flagged by hand</span>{% endif %}
                    {% if status != 'pending' and case.flagged %}<span class="badge bg-warning text-dark">Not counted now</span>{% endif %}
                </div>
                {% if not in_puzzle_card %}
                    <div class="small text-break mt-1">
                        {{ case.manufacturerName ?? 'No brand' }} &middot; {{ case.piecesCount }} pcs
                        &middot; by <a href="{{ path('player_profile', {playerId: case.playerId}) }}">{{ player_label }}</a>{% if case.playerName %} <span class="text-muted">#{{ case.playerCode }}</span>{% endif %}
                    </div>
                {% endif %}
            </div>
        </div>

        {# How far off #}
        <dl class="tv-figures">
            <div>
                <dt>Entered</dt>
                <dd class="tv-figure">{{ case.seconds is not null ? case.seconds|puzzlingTime : 'no time' }}</dd>
                {% if case.seconds %}
                    {% set case_ppm = ppm(case.seconds, case.piecesCount, case.puzzlersCount) %}
                    <dd>{{ case_ppm|number_format(case_ppm < 1 ? 2 : 1) }} PPM{% if case.puzzlersCount > 1 %} &middot; {{ group_label|lower }}{% endif %}</dd>
                {% endif %}
            </div>
            {% if case.expectedSeconds is not null %}
                <div>
                    <dt>Expected about</dt>
                    <dd class="tv-figure">{{ case.expectedSeconds|puzzlingTime }}</dd>
                    <dd>
                        {% if case.expectedSource %}
                            {{ source_texts[case.expectedSource.value] }}
                        {% else %}
                            <span class="text-muted">no source</span>
                        {% endif %}
                    </dd>
                </div>
                {% if ratio is not null %}
                    <div>
                        <dt>How far off</dt>
                        <dd class="tv-figure">{{ ratio|number_format(1) }}× {{ case.isFasterThanExpected ? 'faster' : 'slower' }}</dd>
                        <dd>than expected</dd>
                    </div>
                {% endif %}
            {% elseif case.communityMedianSeconds is not null %}
                {# A pair/team or a new player - against what most puzzlers take #}
                <div>
                    <dt>Most take about</dt>
                    <dd class="tv-figure">{{ case.communityMedianSeconds|puzzlingTime }}</dd>
                    <dd>{{ case.puzzlersCount > 1 ? 'most ' ~ (case.puzzlersCount == 2 ? 'pairs' : 'teams') : 'most puzzlers' }}, {{ case.piecesCount }} pcs</dd>
                </div>
                <div>
                    <dt>How far off</dt>
                    <dd class="tv-figure">{{ case.communityRatio|number_format(1) }}× slower</dd>
                    <dd>than most</dd>
                </div>
            {% else %}
                <div class="tv-figures-span">
                    <dt>Expected</dt>
                    <dd>
                        {% if case.reasons is empty %}
                            The scan never raised this time - no expectation.
                        {% else %}
                            No times of the player's own - judged by the community's pace.
                        {% endif %}
                    </dd>
                </div>
            {% endif %}
            {% if case.leaderboardPlace is not null %}
                <div>
                    <dt>On the puzzle</dt>
                    <dd><span class="tv-figure">#{{ case.leaderboardPlace }}</span> of {{ case.puzzleResults }} {{ case.puzzlingType.value }} {{ case.puzzleResults == 1 ? 'result' : 'results' }}</dd>
                    {% if case.flagged %}<dd class="text-muted">would be - not counted now</dd>{% endif %}
                </div>
            {% endif %}
        </dl>

        <p class="small text-muted mt-2 mb-0">
            Solved {{ case.solvedAt|date('j M Y') }} &middot; saved {{ case.trackedAt|date('j M Y H:i') }}
            &middot; raised {{ case.detectedAt|date('j M Y') }}{% if case.detectorVersion %} (detector v{{ case.detectorVersion }}){% endif %}
            {# The result detail stays closed on a private profile - the card is all a moderator gets (open point) #}
            {% if not case.playerPrivate %}&middot; <a href="{{ path('puzzle_result_detail', {timeId: case.timeId}) }}">Result detail</a>{% endif %}
        </p>
        {% if case.competitionName %}
            <p class="small mt-1 mb-0">
                <i class="bi bi-trophy me-1" aria-hidden="true"></i>Event: {{ case.competitionName }}{% if case.roundName %} - {{ case.roundName }}{% endif %}
            </p>
        {% endif %}

        {% if case.isEditedSinceScan %}
            <div class="alert alert-info small d-flex gap-2 mt-3 mb-0">
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                <span>
                    The player changed this time after the scan raised it - the reasons below are about the old entry.
                    The next scan judges the new one; nothing to decide now.
                </span>
            </div>
        {% endif %}

        {% if deciding %}
            <form method="post" action="{{ path('admin_time_verification_mark', {caseId: case.caseId}) }}" data-turbo="false">
                {{ case_form_fields }}
        {% endif %}

        <div class="row g-3 mt-1">
            {# Why it is here #}
            <div class="col-lg-7">
                <h{{ heading_level + 1 }} class="tv-subtitle">Why it is here</h{{ heading_level + 1 }}>
                {% if case.reasons is empty %}
                    <p class="small mb-2">No reasons - {{ case.origin.value == 'moderator' ? 'the time was flagged by hand, without a scan.' : 'the time was flagged outside the app.' }}</p>
                {% else %}
                    {% if shown_reasons is not empty %}
                        {% if deciding %}
                            <p class="small text-muted mb-1">The player reads the ticked reasons.</p>
                            <ul class="tv-reasons fs-md mb-2">
                                {% for reason in shown_reasons %}
                                    <li class="form-check mb-0">
                                        <input class="form-check-input" type="checkbox" name="reasons[]" value="{{ reason.code.value }}" id="reason-{{ case.caseId }}-{{ reason.code.value }}" checked>
                                        <label class="form-check-label" for="reason-{{ case.caseId }}-{{ reason.code.value }}">
                                            {{ include('suspicious_time/_reason.html.twig', {reason: reason}, with_context = false) }}
                                        </label>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <ul class="tv-list fs-md mb-2">
                                {% for reason in shown_reasons %}
                                    <li>{{ include('suspicious_time/_reason.html.twig', {reason: reason}, with_context = false) }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {% endif %}
                    {% if hidden_reasons is not empty %}
                        <ul class="tv-reasons small mb-2" aria-label="Only moderators see these">
                            {% for reason in hidden_reasons %}
                                <li class="tv-hint">
                                    <i class="bi bi-eye-slash" title="Only moderators see this" aria-hidden="true"></i>
                                    <span>{{ include('suspicious_time/_reason.html.twig', {reason: reason}, with_context = false) }} <span class="visually-hidden">(only moderators see this)</span></span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endif %}

                {% if case.suggestedSeconds is not null %}
                    <p class="small mb-2">
                        <i class="bi bi-lightbulb me-1" aria-hidden="true"></i>Suggested time: <strong>{{ case.suggestedSeconds|puzzlingTime }}</strong>
                        <span class="text-muted">- the player's fix comes prefilled with it</span>
                    </p>
                {% endif %}

                {% if case.comment or case.finishedPuzzlePhoto %}
                    <div class="d-flex gap-3 align-items-start mt-2">
                        {% if case.comment %}
                            <figure class="mb-0 flex-grow-1 min-w-0 small">
                                <figcaption class="text-muted mb-1">The player's comment</figcaption>
                                <blockquote class="tv-quote text-break">{{ case.comment }}</blockquote>
                            </figure>
                        {% endif %}
                        {% if case.finishedPuzzlePhoto %}
                            <a class="flex-shrink-0" href="{{ case.finishedPuzzlePhoto|thumbnail('puzzle_large') }}" target="_blank" rel="noopener" data-turbo="false">
                                <img class="rounded-2" style="max-width: 72px; max-height: 96px;" loading="lazy" alt="Finished puzzle photo (opens large)" src="{{ case.finishedPuzzlePhoto|thumbnail('puzzle_small') }}">
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            {# The player's numbers, and the puzzle's #}
            <div class="col-lg-5">
                <div class="tv-context">
                    <h{{ heading_level + 1 }} class="tv-subtitle">Player</h{{ heading_level + 1 }}>
                    {% if not in_puzzle_card %}
                        <div class="text-break mb-1">
                            <a href="{{ path('player_profile', {playerId: case.playerId}) }}">{{ player_label }}</a>
                            {% if case.playerName %}<span class="text-muted">#{{ case.playerCode }}</span>{% endif %}
                        </div>
                    {% endif %}
                    <div>
                        {{ case.soloResults }} solo {{ case.soloResults == 1 ? 'result' : 'results' }},
                        {{ case.groupResults }} pair/team {{ case.groupResults == 1 ? 'result' : 'results' }}{% if case.groupShare %} ({{ case.groupShare }} % in a group){% endif %}
                    </div>
                    {% if case.groupMembers is not empty %}
                        <div class="text-break">{{ group_label }}: {{ case.groupMembers|join(', ') }}</div>
                    {% endif %}
                    <div>
                        Usual time:
                        {% for baseline in case.baselines %}
                            <span class="text-nowrap{% if baseline.pieces == case.piecesCount %} fw-semibold{% endif %}">{{ baseline.pieces }} pcs {{ baseline.seconds|puzzlingTime }}{% if baseline.type != 'direct' %} <span class="text-muted">({{ baseline.type }})</span>{% endif %}</span>{% if not loop.last %} &middot; {% endif %}
                        {% else %}
                            <span class="text-muted">none yet</span>
                        {% endfor %}
                    </div>
                    {% if case.sameDay is not empty %}
                        <div class="mt-1">Also saved that day:</div>
                        <ul class="tv-list">
                            {% for other in case.sameDay %}
                                <li class="text-break">
                                    {% if case.playerPrivate %}{{ other.puzzleName }}{% else %}<a href="{{ path('puzzle_result_detail', {timeId: other.timeId}) }}">{{ other.puzzleName }}</a>{% endif %}
                                    ({{ other.piecesCount }} pcs{% if other.puzzlingType.value != 'solo' %}, {{ other.puzzlingType.value == 'duo' ? 'pair' : 'team' }}{% endif %})
                                    {{ other.seconds is not null ? other.seconds|puzzlingTime : 'no time' }}
                                    {% if other.flagged %}<span class="badge bg-warning text-dark">Not counted</span>{% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {% if not in_puzzle_card %}
                        <h{{ heading_level + 1 }} class="tv-subtitle mt-3">Puzzle</h{{ heading_level + 1 }}>
                        <div>
                            {% if case.puzzleMedian %}median {{ case.puzzleMedian|puzzlingTime }}{% endif %}
                            {% if case.puzzleFastest %}{% if case.puzzleMedian %} &middot; {% endif %}fastest {{ case.puzzleFastest|puzzlingTime }}{% endif %}
                            {% if case.difficultyScore is not null %}{% if case.puzzleMedian or case.puzzleFastest %} &middot; {% endif %}difficulty {{ case.difficultyScore|number_format(2) }}{% endif %}
                            {% if not case.puzzleMedian and not case.puzzleFastest and case.difficultyScore is null %}<span class="text-muted">no solo results to compare yet</span>{% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {% if deciding %}
                <div class="tv-decide">
                    <details class="tv-note">
                        <summary><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add a note for the player</summary>
                        <label class="form-label small mb-1" for="note-{{ case.caseId }}">Note for the player (optional) - shown with Needs verification, exactly as you type it</label>
                        <textarea class="form-control form-control-sm mb-2" name="note" id="note-{{ case.caseId }}" rows="2" maxlength="{{ note_max_length }}"></textarea>
                    </details>
                    <div class="tv-actions">
                        <div class="tv-action">
                            <button type="submit" class="btn btn-warning tv-decision" aria-describedby="mark-help-{{ case.caseId }}">
                                <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>Needs verification
                            </button>
                            <div class="form-text" id="mark-help-{{ case.caseId }}">Stops counting; the player is told with the next run.</div>
                        </div>
                        <div class="tv-action">
                            <button type="submit" form="trust-{{ case.caseId }}" class="btn btn-success tv-decision" aria-describedby="trust-help-{{ case.caseId }}">
                                <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Looks fine
                            </button>
                            <div class="form-text" id="trust-help-{{ case.caseId }}">Counts as before, never raised again.</div>
                        </div>
                    </div>
                </div>
            </form>
            <form method="post" action="{{ path('admin_time_verification_trust', {caseId: case.caseId}) }}" id="trust-{{ case.caseId }}" data-turbo="false">
                {{ case_form_fields }}
                <input type="hidden" name="status" value="pending">
            </form>
        {% endif %}

        {% if status != 'pending' %}
            {{ include('admin/suspicious_times/_case_status.html.twig') }}
        {% endif %}

        {% if status == 'marked' %}
            {% set has_open_reply = case.openReplies is not empty %}
            {% set offer_keep = tab.value == 'replied' and (has_open_reply or case.playerEditedAt is not null) %}
            <div class="tv-decide">
                <div class="row g-3">
                    <div class="{{ offer_keep ? 'col-md-6' : 'col-12' }}">
                        <form method="post" action="{{ path('admin_time_verification_trust', {caseId: case.caseId}) }}" class="{{ offer_keep ? 'tv-option' : '' }}" data-turbo="false">
                            {{ case_form_fields }}
                            <input type="hidden" name="status" value="marked">
                            {% if offer_keep %}<div class="tv-option-title"><i class="bi bi-check-lg" aria-hidden="true"></i>The time is fine</div>{% endif %}
                            {% set trust_note_label = has_open_reply ? 'Note for the player with "Your time counts again" (optional)' : 'Note for the decision log (optional)' %}
                            {% if offer_keep %}
                                <label class="form-label small mb-1" for="trust-note-{{ case.caseId }}">{{ trust_note_label }}</label>
                                <textarea class="form-control form-control-sm mb-2" name="note" id="trust-note-{{ case.caseId }}" rows="2" maxlength="{{ note_max_length }}"></textarea>
                            {% else %}
                                <details class="tv-note">
                                    <summary><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add a note</summary>
                                    <label class="form-label small mb-1" for="trust-note-{{ case.caseId }}">{{ trust_note_label }}</label>
                                    <textarea class="form-control form-control-sm mb-2" name="note" id="trust-note-{{ case.caseId }}" rows="2" maxlength="{{ note_max_length }}"></textarea>
                                </details>
                            {% endif %}
                            <div class="tv-action{{ offer_keep ? ' tv-option-action' : '' }}">
                                <button type="submit" class="btn btn-success tv-decision" aria-describedby="unmark-help-{{ case.caseId }}">
                                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Looks fine - unmark
                                </button>
                                <div class="form-text" id="unmark-help-{{ case.caseId }}">
                                    Counts again and is never raised again.{% if has_open_reply %} The player reads "Your time counts again" and your note.{% endif %}
                                </div>
                            </div>
                        </form>
                    </div>

                    {% if offer_keep %}
                        <div class="col-md-6">
                            <form method="post" action="{{ path('admin_time_verification_keep', {caseId: case.caseId}) }}" class="tv-option" data-turbo="false">
                                {{ case_form_fields }}
                                <div class="tv-option-title"><i class="bi bi-hourglass-split" aria-hidden="true"></i>It still needs verification</div>
                                <label class="form-label small mb-1" for="keep-note-{{ case.caseId }}">Why it stays marked - the player reads this (required)</label>
                                <textarea class="form-control form-control-sm mb-2" name="note" id="keep-note-{{ case.caseId }}" rows="2" maxlength="{{ note_max_length }}" required></textarea>
                                <div class="tv-action tv-option-action">
                                    <button type="submit" class="btn btn-warning tv-decision" aria-describedby="keep-help-{{ case.caseId }}">
                                        <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>Keep it marked
                                    </button>
                                    <div class="form-text" id="keep-help-{{ case.caseId }}">Still not counted. The player reads your note as the answer.</div>
                                </div>
                            </form>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
</article>
