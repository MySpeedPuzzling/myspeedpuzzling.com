{# A puzzle whose pending cases of one direction are shown together - wrong piece count, a hard puzzle, or decide each
   time. Expects: card (SuspiciousTimePuzzleCard), puzzle_card_cases (case id => SuspiciousTimeCaseCard), tab, page,
   note_max_length. First the question about the puzzle with its options side by side, then the overview of the
   times, then every time as a case card of its own. #}
{% set faster = card.direction.value == 'fast' %}
{% set ratio_range = card.ratioRange %}
{% set threshold_text = card.slowThreshold is not null ? card.slowThreshold|number_format(1)|replace({'.0': ''}) : null %}
{% set option_column = faster ? 'col-md-6' : 'col-md-6 col-xl-4' %}
<article class="card tv-puzzle shadow-sm mb-4" id="puzzle-{{ card.puzzleId }}" data-testid="time-verification-puzzle-card" aria-labelledby="puzzle-{{ card.puzzleId }}-title">
    <div class="card-header d-flex gap-3 align-items-start p-3">
        <a class="tv-thumb bg-white" href="{{ path('puzzle_detail', {puzzleId: card.puzzleId}) }}" tabindex="-1" aria-hidden="true">
            {% if card.image %}
                <img src="{{ card.image|puzzle_image('puzzle_small') }}" alt="" loading="lazy">
            {% else %}
                <i class="bi bi-puzzle"></i>
            {% endif %}
        </a>
        <div class="flex-grow-1 min-w-0">
            <h3 class="h5 mb-1 text-break" id="puzzle-{{ card.puzzleId }}-title">
                <a href="{{ path('puzzle_detail', {puzzleId: card.puzzleId}) }}">{{ card.puzzleName }}</a>
            </h3>
            <div class="small text-break">
                {{ card.manufacturerName ?? 'No brand' }} &middot; <strong>{{ card.piecesCount }} pcs</strong>
                &middot; {{ card.soloResults }} solo {{ card.soloResults == 1 ? 'result' : 'results' }}
                {% if card.medianSolo %}&middot; median {{ card.medianSolo|puzzlingTime }}{% endif %}
                {% if card.fastestSolo %}&middot; fastest {{ card.fastestSolo|puzzlingTime }}{% endif %}
                {% if card.difficultyScore is not null %}&middot; difficulty {{ card.difficultyScore|number_format(2) }}{% endif %}
            </div>
            {% if threshold_text %}
                <div class="small mt-1">
                    <span class="badge bg-info text-dark">Hard puzzle</span>
                    too slow only from <strong>{{ threshold_text }}×</strong> the expected time
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card-body px-2 py-3 p-sm-3 p-md-4">
        <p class="fs-lg mb-1">
            <strong>
                {% if card.isSeveralPlayers %}
                    {{ card.playersCount }} players are much {{ faster ? 'faster' : 'slower' }} here than usual{% if ratio_range %} ({{ ratio_range[0]|number_format(1) }}{% if ratio_range[1] != ratio_range[0] %}-{{ ratio_range[1]|number_format(1) }}{% endif %}× {{ faster ? 'faster' : 'slower' }}){% endif %}.
                {% else %}
                    Players are usually much {{ faster ? 'faster' : 'slower' }} on this puzzle than on others (difficulty {{ card.difficultyScore is not null ? card.difficultyScore|number_format(2) : '-' }}).
                {% endif %}
            </strong>
        </p>
        <p class="mb-3">Is it the puzzle? Pick what fits:</p>

        <div class="row g-2 mb-4">
            <div class="{{ option_column }}">
                <div class="tv-option">
                    <div class="tv-option-title"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>The piece count is wrong</div>
                    <p class="mb-0">
                        {{ faster ? 'A count too high makes everybody fast.' : 'A count too low makes everybody slow.' }}
                        Fix it in the puzzle - the next scan judges these times again and the ones that fit close by themselves.
                    </p>
                    <div class="tv-option-action">
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_edit_puzzle', {puzzleId: card.puzzleId, return: path('admin_time_verification', {tab: tab.value})}) }}">
                            <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit the puzzle
                        </a>
                    </div>
                </div>
            </div>

            {% if not faster %}
                <div class="{{ option_column }}">
                    <div class="tv-option" data-testid="time-verification-slow-threshold">
                        <div class="tv-option-title"><i class="bi bi-hourglass-bottom" aria-hidden="true"></i>It is a hard puzzle</div>
                        <p class="mb-2">
                            All of one colour, a gradient, an "impossible" puzzle - everybody takes far longer than the
                            piece count suggests. Saving judges these times again right away; the ones within the new bar close.
                        </p>
                        <form method="post" action="{{ path('admin_time_verification_slow_threshold', {puzzleId: card.puzzleId}) }}" class="tv-option-action" data-turbo="false">
                            <input type="hidden" name="_token" value="{{ csrf_token('time-verification-puzzle-' ~ card.puzzleId) }}">
                            <input type="hidden" name="tab" value="{{ tab.value }}">
                            <input type="hidden" name="page" value="{{ page }}">
                            <input type="hidden" name="pieces" value="{{ card.piecesCount }}">
                            <label class="form-label mb-1" for="slow-threshold-{{ card.puzzleId }}">Too slow here only from</label>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <div class="input-group input-group-sm tv-threshold-input">
                                    <input class="form-control" type="number" name="slow_threshold" id="slow-threshold-{{ card.puzzleId }}" min="3" max="100" step="0.5" value="{{ card.suggestedSlowThreshold }}" required aria-describedby="slow-threshold-help-{{ card.puzzleId }}">
                                    <span class="input-group-text">×</span>
                                </div>
                                <span>the expected time</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <button type="submit" class="btn btn-sm btn-primary">{{ threshold_text ? 'Change the threshold' : 'Save the threshold' }}</button>
                                {% if threshold_text %}
                                    <button type="submit" name="remove" value="1" class="btn btn-sm btn-outline-secondary" formnovalidate>Remove it</button>
                                {% endif %}
                            </div>
                            <details class="mt-2" id="slow-threshold-help-{{ card.puzzleId }}">
                                <summary>How the threshold works</summary>
                                <p class="mt-1 mb-0">
                                    Normally a time is too slow from 5× the player's usual time (3× their prediction, 10×
                                    what most puzzlers take for pairs, teams and new players). The threshold raises all
                                    three for this puzzle, until its piece count changes. Fast times are judged as before.
                                    Prefilled a quarter above the slowest time here.
                                </p>
                            </details>
                        </form>
                    </div>
                </div>
            {% endif %}

            <div class="{{ option_column }}">
                <div class="tv-option">
                    <div class="tv-option-title"><i class="bi bi-list-check" aria-hidden="true"></i>Neither</div>
                    <p class="mb-0">The puzzle is fine - decide each time below, like any other.</p>
                    <div class="tv-option-action">
                        <a class="btn btn-sm btn-outline-secondary" href="#puzzle-{{ card.puzzleId }}-times">
                            <i class="bi bi-arrow-down me-1" aria-hidden="true"></i>To the {{ card.cases|length }} {{ card.cases|length == 1 ? 'time' : 'times' }}
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <h4 class="tv-section-title" id="puzzle-{{ card.puzzleId }}-times">
            <span>The times</span>
            <span class="badge bg-secondary">{{ card.cases|length }}</span>
        </h4>
        <div class="table-responsive mb-3">
            <table class="table table-sm align-middle fs-sm mb-0">
                <thead>
                    <tr>
                        <th scope="col">Player</th>
                        <th scope="col" class="text-end">Time</th>
                        <th scope="col" class="text-end">Expected</th>
                        <th scope="col" class="text-end text-nowrap">Off by</th>
                        <th scope="col" class="d-none d-md-table-cell">Why</th>
                    </tr>
                </thead>
                <tbody>
                    {% for line in card.cases %}
                        {% set line_ratio = line.ratio %}
                        <tr>
                            <td class="tv-times-player">
                                <a href="#case-{{ line.caseId }}">{{ line.playerName ?? ('#' ~ line.playerCode) }}</a>
                                {% if line.playerPrivate %}<i class="bi bi-lock-fill text-muted ms-1" title="Private profile"></i><span class="visually-hidden">(private profile)</span>{% endif %}
                                {% if line.puzzlersCount > 1 %}<span class="badge bg-info text-dark ms-1">{{ line.puzzlersCount == 2 ? 'Pair' : 'Team of ' ~ line.puzzlersCount }}</span>{% endif %}
                                <div class="d-md-none fs-xs mt-1">
                                    {% if line.tier %}{{ line.tier.value == 'strong' ? 'Strong' : 'Possible' }} &middot; {% endif %}{{ line.reasons|map(reason => reason.code.moderatorLabel)|join(' · ') }}
                                </div>
                            </td>
                            <td class="text-end text-nowrap">{{ line.seconds is not null ? line.seconds|puzzlingTime : '-' }}</td>
                            <td class="text-end text-nowrap">
                                {% set compared_with = line.comparedWithSeconds %}
                                {{ compared_with is not null ? compared_with|puzzlingTime : '-' }}
                                {% if line.isComparedWithCommunity %}
                                    <div class="text-muted fs-xs">most puzzlers</div>
                                {% elseif line.expectedSource %}
                                    <div class="text-muted fs-xs">{{ line.expectedSource.value }}</div>
                                {% endif %}
                            </td>
                            <td class="text-end text-nowrap fw-semibold">{{ line_ratio is not null ? line_ratio|number_format(1) ~ '×' : '-' }}</td>
                            <td class="d-none d-md-table-cell">
                                <span class="d-inline-flex flex-wrap gap-1 align-items-center">
                                    {% if line.tier %}<span class="badge {{ line.tier.value == 'strong' ? 'bg-danger' : 'bg-secondary' }}">{{ line.tier.value == 'strong' ? 'Strong' : 'Possible' }}</span>{% endif %}
                                    <span>{% for reason in line.reasons %}<span class="text-nowrap">{{ reason.code.moderatorLabel }}</span>{% if not loop.last %} &middot; {% endif %}{% endfor %}</span>
                                </span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% for line in card.cases %}
            {% set case = puzzle_card_cases[line.caseId] ?? null %}
            {% if case %}
                {{ include('admin/suspicious_times/_case_card.html.twig', {case: case, in_puzzle_card: true}) }}
            {% endif %}
        {% endfor %}
    </div>
</article>
