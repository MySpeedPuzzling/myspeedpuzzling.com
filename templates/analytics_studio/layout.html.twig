<!DOCTYPE html>
{# The analytics studio's own layout (docs/features/competitions-management/analytics-studio.md §1.1, §7) - deliberately
   not base.html.twig: a commentator's second screen, every pixel for the data. No site header, footer, flashes, modals,
   Turbo or site bundle - its own Encore entry `analytics_studio` (script + stylesheet, never precached for every visitor:
   service worker PRECACHE_SKIP_ENTRIES). Renders nothing of the person reading it. #}
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <title>{%- block title -%}{%- endblock %} – MySpeedPuzzling</title>
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="format-detection" content="telephone=no">
        <meta name="robots" content="noindex, nofollow">
        <meta name="referrer" content="same-origin">
        <meta name="color-scheme" content="dark light">
        <meta name="theme-color" content="#0e1116">

        <link rel="preload" href="{{ asset('fonts/rubik/rubik-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}?v=2">
        <link rel="shortcut icon" href="{{ asset('favicon.ico') }}?v=2">
        <style>@font-face{font-family:Rubik;font-style:normal;font-weight:300 700;font-display:optional;src:url({{ asset('fonts/rubik/rubik-latin-ext.woff2') }}) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}@font-face{font-family:Rubik;font-style:normal;font-weight:300 700;font-display:optional;src:url({{ asset('fonts/rubik/rubik-latin.woff2') }}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}</style>
        {{ encore_entry_link_tags('analytics_studio') }}
        {{ encore_entry_script_tags('analytics_studio') }}
    </head>
    <body class="as-body lang-{{ app.request.locale }}">
        {% block body %}{% endblock %}
    </body>
</html>
