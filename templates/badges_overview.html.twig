{% extends 'base.html.twig' %}

{% block title %}{{ 'badges.overview_title'|trans }}{% endblock %}

{% block meta_description %}{{ 'badges.overview_subtitle'|trans }}{% endblock %}

{#
    The achievements catalogue (docs/features/xp-levels/ux-polish/design-spec.md §1): summary line, "Closest next
    steps", filter chips and the shelf - the same layout as a player's achievements page (_achievements_layout).
    Personal parts (tiers held, progress, AP) for members only - everybody else browses the shop window: every seal at
    Bronze in colour with how many puzzlers hold it, the membership tease on top, and nothing personal is even read.
#}
{% block content %}
    {{ include('_page_crumbs.html.twig', {
        levels: [{name: 'progression_hub.title'|trans, url: path('progression_hub')}],
        current: 'badges.overview_title'|trans,
        json_ld: true,
    }) }}

    <header class="mb-3">
        <h1 class="h3 mb-1">{{ 'badges.overview_title'|trans }}</h1>

        {% if is_member %}
            <p class="achievements-summary mb-0">
                <span>{{ 'badges.shelf.summary'|trans({
                    '%earned%': lists.earnedTypes|format_number,
                    '%total%': lists.totalTypes|format_number,
                    '%tiers_earned%': lists.earnedTiers|format_number,
                    '%tiers_total%': lists.totalTiers|format_number,
                })|raw }}</span>
                {% if ap_total is not null %}
                    <a href="{{ path('xp_leaderboard', {tab: 'achievement-points'}) }}" class="ap-chip text-decoration-none">{{ 'badges.ap_total'|trans({'%points%': ap_total|format_number}) }}</a>
                {% endif %}
                <a href="{{ path('player_achievements', {playerId: logged_user.profile.playerId}) }}" class="achievements-summary-link">{{ 'badges.my_title'|trans }}</a>
            </p>
        {% else %}
            <p class="text-body-secondary mb-0">{{ 'badges.overview_subtitle'|trans }}</p>
        {% endif %}
    </header>

    {% if not is_member %}
        <div class="achievements-tease mb-3">
            <p class="mb-0">{{ (logged_in ? 'badges.catalogue.tease_free' : 'badges.catalogue.tease_guest')|trans }}</p>
            <a href="{{ path('membership') }}" class="btn btn-primary btn-sm">{{ 'badges.catalogue.become_member'|trans }}</a>
        </div>
    {% endif %}

    {{ include('_achievements_layout.html.twig', {
        lists: is_member ? lists : null,
        rows: rows,
        filter: filter,
        filters: filters,
        filter_counts: filter_counts,
        filter_route: 'badges_overview',
        filter_params: {},
        personal: is_member,
        player_id: null,
        own: is_member,
    }) }}

    <div class="achievements-about mt-4" id="how-achievements-work">
        {{ 'badges.catalogue.about'|trans }}
        <a href="{{ path('progression_hub') }}" class="text-nowrap">{{ 'progression_hub.title'|trans }}</a>
    </div>

    {# What the numbers mean (design-spec §8.5) #}
    <div class="achievements-footnote mt-3 fs-sm text-body-secondary">
        <p class="mb-1">{{ 'badges.shelf.explainer.share'|trans }}</p>
        <p class="mb-1">{{ 'badges.shelf.explainer.step_back'|trans }}</p>
        {% if logged_in and not is_member %}
            <p class="mb-1">{{ 'badges.shelf.explainer.lapsed'|trans }}</p>
        {% endif %}
        <p class="mb-0"><a href="{{ path('xp_leaderboard', {tab: 'achievement-points'}) }}">{{ 'badges.catalogue.ap_leaderboard_link'|trans }}</a></p>
    </div>
{% endblock %}
