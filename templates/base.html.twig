                        <a class="navbar-tool ms-1 ms-lg-0 me-n1 me-lg-2 {% if app.request.pathInfo == path('puzzle_add') %}active{% endif %}" rel="nofollow" href="{{ path('puzzle_add') }}" data-nav="toolbar/tools/add_time" aria-label="{{ 'menu.puzzle_add'|trans }}">
