<!DOCTYPE html>
<html lang="{{ app.request.locale }}"{{ native_app_attribute() }}>
    <head>
        <meta charset="UTF-8">
        {# A page whose title says it all drops the site name (puzzle pages - Google shows the site name on its own) #}
        <title>{%- block title -%}{%- endblock -%}{%- block title_suffix %} – MySpeedPuzzling{% endblock -%}</title>

        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        {{ include('_head_flags.html.twig') }}

        {% set currentRoute = app.request.attributes.get('_route') %}
        {% set currentRouteParams = app.request.attributes.get('_route_params')|default({}) %}
        {% set cleanQuery = app.request.query.all|filter((v, k) => k not in ['return', 'return_url', 'return_title']) %}
        {% set canonicalUrl = currentRoute ? url(currentRoute, currentRouteParams) : app.request.uri %}
        {# The language switch's links (filters kept, ?return= dropped except on the locale-less auth pages) are
           language_switch_urls() (decision 36); hreflang alternates below intentionally drop the query string
           (they must match the canonical URL). #}
        {% set routeParams = currentRouteParams|merge(app.request.attributes.get('_auth_page') is same as(true) ? app.request.query.all : cleanQuery) %}
        {% set ogLocales = {'cs': 'cs_CZ', 'en': 'en_US', 'es': 'es_ES', 'ja': 'ja_JP', 'fr': 'fr_FR', 'de': 'de_DE'} %}

        <meta name="description" content="{%- block meta_description -%}{%- endblock -%}{% if block('meta_description') is empty %}{{ 'homepage.meta.description'|trans }}{% endif %}">
        <meta name="format-detection" content="telephone=no">{#
            Instant Back (README §4.13 G9, GEST-15): Turbo keeps no copy of a page - browse pages override the block with
            no-preview (cached for restores only, assets/instant_back.js); who the page was rendered for (GEST-14) - for
            signed-in viewers only: a guest's page is byte for byte what it was (assets/instant_back.js knows a guest's
            page by <body data-viewer-audience>). The empty lines and the whitespace control keep those bytes: Twig eats
            the line break after a tag or a comment, ChromeWhitespace turns the rest into one line break.
            msp-clears-snapshots: this page's GET wrote (notifications marked read, a conversation read, a stopwatch
            started or stopped - `clears_snapshots` or the block): the copies of the pages before it are stale
            (assets/instant_back.js) - signed-in pages only. Inside the Hotwire Native app every page says no-cache (NAV-14,
            Instant Back review Q4: no snapshot restores there until the app decides its own Back).
        #}

        <meta name="turbo-cache-control" content="{% if is_native_app() %}no-cache{% else %}{% block turbo_cache_control %}no-cache{% endblock %}{% endif %}">
        {%- set msp_viewer = viewer_marker() %}
        {%- if msp_viewer != '' %}

        <meta name="msp-viewer" content="{{ msp_viewer }}">
        {%- block clears_snapshots %}{% if clears_snapshots ?? false %}<meta name="msp-clears-snapshots">{% endif %}{% endblock %}
        {%- endif %}

        <meta name="turbo-prefetch" content="false">
        {# Turbo runs a visit as a view transition only while this says same-origin: assets/view_transition_gate.js sets it
           per visit (Android's place fade, the thumbnail morph - GEST-12/17) and to none everywhere else #}
        <meta name="view-transition" content="same-origin">

        {% block robots %}<meta name="robots" content="index, follow">{% endblock %}

        {# Asset-failure beacon + self-heal: assets/inline/asset_failure.js (why and how there), inlined as its build
           (templates/_inline_scripts, npm run inline-scripts). Inline, dependency-free and ES5: it runs exactly when
           the bundles do not. #}
        <script>{{ source('_inline_scripts/asset_failure.js')|replace({'__ASSET_LOAD_FAILURE_URL__': path('asset_load_failure')})|raw }}</script>

        {# Stale-document beacon + self-heal: assets/inline/stale_document.js (why and how there), inlined as its build.
           The timestamp lives in the <meta>, never inside the script: Turbo re-evaluates a head script whose text
           changed, and this one must run once per real page load - the script directly follows its <meta>. #}
        <meta name="msp-rendered-at" content="{{ 'now'|date('U') }}">
        <script>{{ source('_inline_scripts/stale_document.js')|replace({'__STALE_DOCUMENT_URL__': path('stale_document')})|raw }}</script>

        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{{ block('title_suffix') }}{% endblock %}">
        <meta property="og:description" content="{{ block('meta_description') is not empty ? block('meta_description') : 'homepage.meta.description'|trans }}">
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('img/speedpuzzling-logo.png')) }}{% endblock %}">
        <meta property="og:url" content="{{ canonicalUrl }}">
        {% if facebook_app_id is not empty %}<meta property="fb:app_id" content="{{ facebook_app_id }}">{% endif %}
        <meta property="og:site_name" content="MySpeedPuzzling">
        <meta property="og:locale" content="{{ ogLocales[app.request.locale]|default('en_US') }}">
        {% for ogLocaleKey, ogLocaleValue in ogLocales %}
            {% if ogLocaleKey != app.request.locale %}
                <meta property="og:locale:alternate" content="{{ ogLocaleValue }}">
            {% endif %}
        {% endfor %}
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content="{{ block('og_title') }}">
        <meta name="twitter:description" content="{{ block('meta_description') is not empty ? block('meta_description') : 'homepage.meta.description'|trans }}">
        <meta name="twitter:image" content="{{ block('og_image') }}">

        {# Early connection to the image CDN: puzzle photos (often the LCP element) are cross-origin #}
        <link rel="preconnect" href="{{ images_base_url }}" crossorigin>
        <link rel="dns-prefetch" href="{{ images_base_url }}">

        {# Self-hosted Rubik variable font (latin + latin-ext for Czech diacritics) #}
        {# Preloaded + inline @font-face with display:optional = no FOUT, fast first visit #}
        <link rel="preload" href="{{ asset('fonts/rubik/rubik-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/rubik/rubik-latin-ext.woff2') }}" as="font" type="font/woff2" crossorigin>

        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}?v=2">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}?v=2">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}?v=2">
        <link rel="manifest" href="{{ asset('site.webmanifest') }}?v=3">
        <link rel="mask-icon" href="{{ asset('safari-pinned-tab.svg') }}?v=2" color="#2d89ef">
        <link rel="shortcut icon" href="{{ asset('favicon.ico') }}?v=2">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="default">
        <meta name="msapplication-TileColor" content="#2d89ef">
        <meta name="theme-color" content="#ffffff">

        <link type="text/plain" rel="author" href="{{ asset('humans.txt') }}">

        {% block canonical %}
            {% if currentRoute %}
                <link rel="canonical" href="{{ canonicalUrl }}">
            {% endif %}
        {% endblock %}

        {# Critical CSS for the first paint: fonts, base page styles and - from templates/navigation/_critical_css.html.twig -
           the navigation bars' boxes and reserved sizes (the old header's rules left with the old header, NAV-06) #}
        {# Icon fonts are NOT preloaded on purpose: both are font-display:swap and the
           full files (195KB) at High priority were stealing bandwidth from CSS/LCP. #}
        <style>@font-face{font-family:Rubik;font-style:normal;font-weight:300 700;font-display:optional;src:url({{ asset('fonts/rubik/rubik-latin-ext.woff2') }}) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}@font-face{font-family:Rubik;font-style:normal;font-weight:300 700;font-display:optional;src:url({{ asset('fonts/rubik/rubik-latin.woff2') }}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-display:swap;font-family:cartzilla-icons;font-style:normal;font-weight:400;src:url({{ asset('build/fonts/cartzilla-icons.woff?ufvuz0') }}) format("woff")}@font-face{font-display:swap;font-family:bootstrap-icons;src:url({{ asset('build/fonts/bootstrap-icons.woff2?') }}) format("woff2"),url({{ asset('build/fonts/bootstrap-icons.woff?') }}) format("woff")}[class^=ci-],[class*=" ci-"]{font-family:cartzilla-icons!important;speak:never;font-style:normal;font-weight:400;font-variant:normal;text-transform:none;line-height:1;-webkit-font-smoothing:antialiased}.bi{font-family:bootstrap-icons!important;speak:never;font-style:normal;font-weight:400;font-variant:normal;text-transform:none;line-height:1;-webkit-font-smoothing:antialiased}*,::after,::before{box-sizing:border-box}html{font-size:100%}@media(min-width:768px){html{font-size:106.25%}}body{margin:0;font-family:Rubik,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;font-size:.9375rem;line-height:1.5;color:#4b566b;background:#fff;display:flex;flex-direction:column;min-height:100vh}a{color:#fe696a;text-decoration:none}img{max-width:100%;height:auto}small{font-size:.875rem}main{flex-grow:1}.row{display:flex;flex-wrap:wrap}.col-lg-6{width:100%}@media(min-width:992px){.col-lg-6{flex:0 0 auto;width:50%}}.mt-4{margin-top:1.5rem!important}.mt-5{margin-top:3rem!important}.pt-2{padding-top:.5rem!important}.mb-0{margin-bottom:0!important}.h3{font-size:1.375rem;font-weight:500}.h4{font-size:1.1875rem;font-weight:500}.table{width:100%;margin-bottom:1rem;vertical-align:top;border-color:#dee2e6}.table>:not(caption)>*>*{padding:.5rem}.table-striped>tbody>tr:nth-of-type(odd)>*{background-color:#fdfdfd}.nav-tabs{border-bottom:1px solid #dee2e6;display:flex}.nav-fill>.nav-item{flex:1 1 auto;text-align:center}.nav-tabs .nav-link.active{color:#495057;background-color:#fff;border-color:#dee2e6 #dee2e6 #fff}.placeholder-glow .placeholder{animation:placeholder-glow 2s ease-in-out infinite}.placeholder{display:inline-block;min-height:1em;vertical-align:middle;cursor:wait;background-color:currentcolor;opacity:.5;border-radius:.25rem}@keyframes placeholder-glow{50%{opacity:.2}}.tab-content>.tab-pane{display:none}.tab-content>.active{display:block}.fade:not(.show){opacity:0}.custom-table-wrapper{border-radius:8px 8px 0 0;box-shadow:rgba(0,0,0,.25) 0 0 10px 0}.text-center{text-align:center!important}.text-end{text-align:right!important}.d-sm-none{display:none!important}@media(max-width:575.98px){.d-sm-none{display:block!important}.d-none.d-sm-table-cell{display:none!important}}.table-responsive{overflow-x:auto}.shadow-sm{box-shadow:0 .125rem .25rem rgba(0,0,0,.075)}.container{width:100%;padding-right:.9375rem;padding-left:.9375rem;margin-right:auto;margin-left:auto}@media(min-width:1280px){.container{max-width:1260px}}.d-flex{display:flex!important}.d-none{display:none!important}.align-items-center{align-items:center!important}.text-nowrap{white-space:nowrap!important}.ms-1{margin-left:.25rem!important}.ms-2{margin-left:.5rem!important}.me-1{margin-right:.25rem!important}.me-2{margin-right:.5rem!important}.me-auto{margin-right:auto!important}.position-relative{position:relative!important}@media(min-width:576px){.me-sm-3{margin-right:1rem!important}}@media(min-width:992px){.d-lg-block{display:block!important}.order-lg-1{order:1!important}.order-lg-2{order:2!important}}.visually-hidden-focusable:not(:focus):not(:focus-within){position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}ul,ol{margin:0;padding:0;list-style:none}.text-dark{color:#373f50!important}.dropdown{position:relative}.dropdown-toggle::after{display:inline-block;margin-left:.255em;vertical-align:.255em;content:"";border-top:.3em solid;border-right:.3em solid transparent;border-left:.3em solid transparent}.nav-link{display:block;padding:.5rem 1rem;color:#4b566b;font-weight:500;text-decoration:none}.bg-secondary{background-color:#f3f5f9!important}.fi{display:inline-block;width:1.333em;height:1em;line-height:1em}.modal{display:none}.dropdown-menu{display:none;position:absolute}.badge{display:inline-block;padding:.35em .65em;font-size:.75em;font-weight:500;line-height:1;text-align:center;white-space:nowrap;vertical-align:baseline;border-radius:.25rem}.bg-primary{background-color:#fe696a!important;color:#fff}
{{ include('navigation/_critical_css.html.twig') }}</style>
        {{ encore_entry_link_tags('app') }}
        {# A page's own Encore style entry (e.g. 'compete'), after the site-wide one #}
        {% block page_stylesheets %}{% endblock %}

        {# hreflang only on clean (canonical) URLs: alternates pointing at parameterized,
           non-canonical URLs are ignored by Google and can degrade the whole cluster.
           Non-localized pages (guides, crossroads) override this block. #}
        {% block hreflang %}
            {% if currentRoute and cleanQuery is empty %}
                <link rel="alternate" hreflang="cs" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'cs'})) }}">
                <link rel="alternate" hreflang="en" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'en'})) }}">
                <link rel="alternate" hreflang="es" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'es'})) }}">
                <link rel="alternate" hreflang="ja" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'ja'})) }}">
                <link rel="alternate" hreflang="fr" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'fr'})) }}">
                <link rel="alternate" hreflang="de" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'de'})) }}">
                {% if currentRoute == 'homepage' %}
                    {# The domain root (EN homepage) is the x-default for the homepage cluster #}
                    <link rel="alternate" hreflang="x-default" href="{{ url('homepage', {'_locale': 'en'}) }}">
                {% else %}
                    <link rel="alternate" hreflang="x-default" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'en'})) }}">
                {% endif %}
            {% endif %}
        {% endblock %}

        {{ encore_entry_script_tags('app') }}

        {# JSON-LD Structured Data #}
        {% block json_ld %}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Organization",
                    "@id": "https://myspeedpuzzling.com/#organization",
                    "name": "MySpeedPuzzling",
                    "url": {{ url('homepage', {'_locale': 'en'})|json_ld }},
                    "logo": {{ absolute_url(asset('img/speedpuzzling-logo.png'))|json_ld }},
                    "description": {{ 'homepage.meta.description'|trans({}, 'messages', 'en')|json_ld }},
                    "sameAs": [
                        "https://www.instagram.com/myspeedpuzzling/",
                        "https://github.com/MySpeedPuzzling/myspeedpuzzling.com"
                    ],
                    "contactPoint": {
                        "@type": "ContactPoint",
                        "email": "simona@speedpuzzling.cz",
                        "contactType": "customer service"
                    },
                    "founder": [
                        {
                            "@type": "Person",
                            "name": "Simona Mikešová"
                        },
                        {
                            "@type": "Person",
                            "name": "Jan Mikeš",
                            "url": "https://janmikes.cz"
                        }
                    ]
                },
                {
                    "@type": "WebSite",
                    "@id": "https://myspeedpuzzling.com/#website",
                    "url": {{ url('homepage', {'_locale': 'en'})|json_ld }},
                    "name": "MySpeedPuzzling",
                    "alternateName": ["My Speed Puzzling", "Speed Puzzling"],
                    "publisher": {"@id": "https://myspeedpuzzling.com/#organization"},
                    "inLanguage": {{ app.request.locale|json_ld }}
                }
            ]
        }
        </script>
        {% endblock %}
    </head>
    {# The comparison launcher (docs/features/player-comparison.md, D2) - from the viewer's own profile row, no query.
       A page opts out with `{% set hide_comparison_launcher = true %}` at its top (outside blocks): the comparison
       itself, and every page whose main content is a form, a chat, a bar at the bottom or a running clock - the pill
       would sit over their controls #}
    {% set comparison_launcher = logged_user.profile is not null
        and not hide_comparison_launcher|default(false)
        and logged_user.profile.comparisonLineUp.hasOthers() %}
    {# The viewer's audiences for the page search (MENU-01/MENU-03): "everyone guest" for every guest (shared-cacheable).
       no-nav-chrome: a page without the bars (it sets nav_chrome_off outside its blocks and empties nav_chrome - NAV-08)
       and the app; no-nav-column: the `menu` page, whose content is the Menu (nav_menu_slot_off) - critical CSS keeps the
       desktop column's width (--nav-left) at 0 / the rail's there (NAV-13); no-tab-bar: a page that sets hide_bottom_bar
       (NAV-08) - like no-nav-chrome it keeps no room for the phone tab bar (--bottom-nav-height 0 on <body>, also without
       :has() - NAV review F4). All depend on the page only. data-player-card-url / data-player-card-direct: the player
       card's URL template (CARD-01a) and the revert rule's reverted cells (CARD-07, left out while none is) - the same
       for every viewer. #}
    <body class="lang-{{ app.request.locale }}{{ comparison_launcher ? ' has-comparison-launcher' }}{{ (nav_chrome_off ?? false) or not is_web() ? ' no-nav-chrome' }}{{ (nav_menu_slot_off ?? false) ? ' no-nav-column' }}{{ (hide_bottom_bar ?? false) ? ' no-tab-bar' }}"
          data-viewer-audience="{{ nav_viewer_audience() }}"
          data-player-card-url="{{ path('player_card', {playerId: '00000000-0000-0000-0000-000000000000'}) }}"{% if player_card_direct() != '' %} data-player-card-direct="{{ player_card_direct() }}"{% endif %}
          data-controller="pwa-lifecycle gallery file-drop-area datepicker toast{% if ga_tracking is not empty %} analytics{% endif %}"
          {% if ga_tracking is not empty %}data-analytics-tracking-id-value="{{ ga_tracking }}"{% endif %}>
        <a href="#main-content" class="visually-hidden-focusable">{{ 'forms.skip_to_content'|trans }}</a>
        {% block header %}
        {# The top bar (NAV-03, templates/navigation/_topbar.html.twig): sticky, its height reserved in critical CSS #}
        {% if is_web() %}{{ include('navigation/_topbar.html.twig') }}{% endif %}
        {% endblock %}

        {# The navigation chrome (docs/features/navigation, decision 19): bars, rail and column land here, web only -
           the icon sprite, the phone bottom bar (NAV-01) and the Menu's slot. Bar-free pages empty it together with
           header and footer. Chrome markup rules: implementation plan §3.2. #}
        {% block nav_chrome %}{% if is_web() %}{{ include('navigation/_icons.html.twig') }}{{ include('navigation/_bottom_nav.html.twig') }}{{ include('navigation/_menu_slot.html.twig') }}{% endif %}{% endblock %}

        {# data-puzzles-section (PUZ-01): the Puzzles section this page records for the Puzzles place - its four start
           pages and your own library's lists; assets/puzzles_section.js keeps it, the place's links open it next time #}
        {% set puzzles_section = nav_puzzles_section() %}
        <main id="main-content"{% if puzzles_section is not null %} data-puzzles-section="{{ puzzles_section }}"{% endif %}>
            {# The place's section chips (COM-02, PUZ-01, decision 75): rendered here for every page of a section, so a page
               overriding full_content gets them too; never on the bar-free pages (nav_chrome_off) #}
            {% block section_chips %}{% if not (nav_chrome_off ?? false) %}{{ include('navigation/_section_chips.html.twig') }}{% endif %}{% endblock %}
            {# hasPreviousSession guard: reading app.flashes starts a session, which stamps
               Set-Cookie + Cache-Control: private on every anonymous/crawler response #}
            {% set comparison_added_flash = constant('SpeedPuzzling\\Web\\Controller\\AddComparisonSubjectController::ADDED_FLASH') %}
            {# The launcher pops in only right after something was added - not on every page view #}
            {% set comparison_just_added = comparison_launcher and app.request.hasPreviousSession and app.session.flashBag.peek(comparison_added_flash) is not empty %}
            {% for label in app.request.hasPreviousSession ? ['success', 'danger', 'warning', 'info'] : [] %}
                {% for message in app.flashes(label) %}
                    {# data-turbo-temporary: a page restored by Back never shows an old message again (GEST-15) #}
                    <div class="container mt-3" data-turbo-temporary>
                        <div class="alert-dismissible mb-0 fade show alert alert-{{ label }}" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'forms.close'|trans }}"></button>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}
            {# The player's address hard-bounced (docs/features/mass-mailing/README.md) - rides on their profile row #}
            {% if logged_user.profile is not null and logged_user.profile.emailUndeliverable is not null %}
                {{ include('_email_undeliverable_banner.html.twig', {problem: logged_user.profile.emailUndeliverable, email: logged_user.profile.email}) }}
            {% endif %}
            {# "Kateřina added to your comparison" + the way there (AddComparisonSubjectController) #}
            {% for added in app.request.hasPreviousSession ? app.flashes(comparison_added_flash) : [] %}
                {{ include('comparison_entry/_added_flash.html.twig', {added: added}) }}
            {% endfor %}

            {% block full_content %}
                <section class="container px-3 pt-2 pt-md-3 pt-lg-4 mb-4">
                    {% block content %}{% endblock %}
                </section>
            {% endblock %}

            {# The end-of-page line (HELP-04, README §4.5): "Something wrong on this page? Tell us" opens the Help sheet with
               this page attached - for guests too (the link depends on the URL only). Emptied by the auth layout, the
               bar-free pages (those that empty nav_chrome) and the help page itself. #}
            {% block page_help_line %}
                <p class="page-help-line container px-3 mt-2 mb-4 text-center text-muted small">
                    {{- 'help.page_line.question'|trans }} <a class="fw-semibold text-nowrap" href="{{ help_path() }}" {{ help_opener_attrs() }} data-nav="page/{{ nav_location().place.value }}/help_line">{{ 'help.page_line.link'|trans }}</a>
                </p>
            {% endblock %}
        </main>

        {% block footer %}
        {% if is_web() %}
        <footer class="site-footer">
            {% if logged_user.profile is null %}
                {# Auth pages empty it: its e-mail field would be the only other text input
                   there, and iOS Password AutoFill reads the page as a login form #}
                {% block footer_newsletter %}{{ include('_footer_newsletter.html.twig') }}{% endblock %}
            {% endif %}

            {{ include('_footer.html.twig') }}
        </footer>
        {% endif %}
        {% endblock %}

        {% if comparison_launcher %}
            {{ include('comparison_entry/_launcher.html.twig', {line_up: logged_user.profile.comparisonLineUp, just_added: comparison_just_added}) }}
        {% endif %}

        {# Announcement modals (docs/features/announcement-modals.md): at most one, once per player ever.
           Calling announcement_modal() claims it for this page view - keep this the only call. #}
        {% set announcement = announcement_modal() %}
        {% if announcement %}
            {{ include(announcement.template()) }}
        {% endif %}

        {#- The members modal: every members-only lock opens it. members-modal (lazy) passes the teaser's placement on to the
           trial form and the membership links, and counts the open (TEASE-01, README §6 rule 5) - for whoever gets locks:
           a member sees none, so their pages carry neither the controller nor its targets #}
        {%- set members_modal_measured = logged_user.profile is null or not logged_user.profile.activeMembership %}
        <div class="modal fade" tabindex="-1" role="dialog" id="membersExclusiveModal"{% if members_modal_measured %} data-controller="members-modal"{% endif %}>
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'membership.modal.title'|trans }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'forms.close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        {{ 'membership.modal.text'|trans|raw }}

                        {% if logged_user.profile and is_web() and logged_user.profile.canStartFreeTrial %}
                            {# Never had a membership: the locked feature they just clicked is one click away (docs/features/free-trial/README.md) #}
                            <p class="fw-medium">{{ 'free_trial.modal.text'|trans({'%days%': constant('SpeedPuzzling\\Web\\Value\\FreeTrial::DAYS')}) }}</p>

                            {{ include('membership/_free_trial_start_form.html.twig', {
                                source: 'members_modal',
                                label: 'free_trial.modal.button'|trans({'%days%': constant('SpeedPuzzling\\Web\\Value\\FreeTrial::DAYS')}),
                                return: app.request.requestUri,
                                form_class: 'me-2 mb-2',
                                placement_field: true,
                            }) }}

                            <a href="{{ path('membership') }}" class="btn btn-outline-primary btn-sm me-2 mb-2" data-members-modal-target="link">{{ 'free_trial.modal.secondary'|trans }}</a>
                        {% elseif logged_user.profile %}
                            {% if is_web() and logged_user.profile.freeTrialAvailable %}
                                <p class="small text-muted">{{ include('membership/_free_trial_unlock_sentence.html.twig', {profile: logged_user.profile}) }}</p>
                            {% endif %}

                            <a href="{{ path('membership') }}" class="btn btn-primary d-inline-block me-2 btn-shadow" type="submit"{% if members_modal_measured %} data-members-modal-target="link"{% endif %}><i class="bi-person-circle"></i> {{ 'membership.modal.cta'|trans }}</a>
                        {% else %}
                            <a href="{{ path('login') }}" class="btn btn-primary d-inline-block me-2 btn-shadow" type="submit"><i class="bi-person"></i> {{ 'menu.sign_in'|trans }}</a>
                        {% endif %}

                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">{{ 'membership.modal.no_thanks'|trans }}</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="global-search-overlay"></div>

        {# Toast Container #}
        <div id="toast-container" class="toast-container position-fixed p-3" data-toast-target="container" style="z-index: 1060;"></div>

        {# Dynamic Modal (Turbo-powered) #}
        <div id="dynamic-modal-container"
             class="modal fade"
             tabindex="-1"
             role="dialog"
             aria-hidden="true"
             data-controller="dynamic-modal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    {# Shown by dynamic_modal_controller.js when a response takes longer than 150 ms #}
                    <div class="dynamic-modal-loading" data-dynamic-modal-target="loading" hidden>
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">{{ 'loading'|trans }}</span>
                        </div>
                    </div>
                    {# Shown by dynamic_modal_controller.js when the content could not be loaded (network error) #}
                    <div class="dynamic-modal-error" data-dynamic-modal-target="error" role="alert" hidden>
                        <p class="mb-3">{{ 'modal.load_failed'|trans }}</p>
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            <button type="button" class="btn btn-primary" data-action="dynamic-modal#retry">{{ 'modal.try_again'|trans }}</button>
                            <button type="button" class="btn btn-outline-secondary" data-action="dynamic-modal#dismiss">{{ 'forms.close'|trans }}</button>
                        </div>
                    </div>
                    <turbo-frame id="modal-frame" data-dynamic-modal-target="frame">
                    </turbo-frame>
                </div>
            </div>
        </div>

        {# In-page confirmations (GEST-13): assets/confirm_dialog.js clones this <dialog> for every question -
           data-turbo-confirm forms and the controllers' confirmDialog() - and opens it with showModal(). Web and app. #}
        <template id="msp-confirm-template">
            <dialog class="msp-confirm" role="alertdialog">
                <div class="msp-confirm-box">
                    <p class="msp-confirm-message" data-msp-confirm-message></p>
                    <div class="msp-confirm-actions">
                        <button type="button" class="btn btn-outline-secondary" data-msp-confirm-cancel>{{ 'confirm_dialog.cancel'|trans }}</button>
                        <button type="button" class="btn btn-primary" data-msp-confirm-action>{{ 'confirm_dialog.confirm'|trans }}</button>
                    </div>
                </div>
            </dialog>
        </template>

        {% if logged_user.profile is not null %}
            <div data-controller="mercure-hub"
                 data-mercure-hub-mercure-url-value="{{ mercure_public_url }}"
                 data-mercure-hub-topics-value={{ mercure_subscribe_topics(logged_user.profile.playerId)|json_attribute }}
                 style="display: none;"></div>
        {% endif %}

        {# Navigation layers at the end of <body> (the Menu shell #menu-layer, decision 87): after every page
           GlobalSearch, web only. Bar-free pages empty it together with nav_chrome. #}
        {% block nav_layers %}{% if is_web() %}{{ include('navigation/_menu_layer.html.twig') }}{% endif %}{% endblock %}
    </body>
</html>
