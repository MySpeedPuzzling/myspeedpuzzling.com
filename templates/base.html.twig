                        {# The Inbox badge (INB-02): one statement for both counts (inbox_badge()). Until NAV-06 removes this
                           header, the Messages tool shows the Messages part and the bell - the Inbox link (D3) - the
                           For you part; a realtime push updates both and the bell's target tab and accessible name #}
                        {% if logged_user.profile is not null %}
                            <div class="navbar-tool ms-1 ms-lg-0 me-1 me-lg-3">
                                {{ include('messaging/_unread_badge.html.twig', {}, with_context = false) }}
                            </div>

                            {% embed 'inbox/_link.html.twig' with {nav: 'toolbar/tools/notifications', class: 'navbar-tool ms-1 ms-lg-0 me-1 me-lg-2' ~ (app.request.pathInfo == path('notifications') ? ' active'), surface: 'toolbar'} only %}
