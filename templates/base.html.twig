        {{ encore_entry_link_tags('app') }}

        {# hreflang only on clean (canonical) URLs: alternates pointing at parameterized,
           non-canonical URLs are ignored by Google and can degrade the whole cluster.
           Non-localized pages (guides, crossroads) override this block. #}
        {% block hreflang %}
            {% if currentRoute and cleanQuery is empty %}
                <link rel="alternate" hreflang="cs" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'cs'})) }}">
                <link rel="alternate" hreflang="en" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'en'})) }}">
                <link rel="alternate" hreflang="es" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'es'})) }}">
                <link rel="alternate" hreflang="ja" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'ja'})) }}">
                <link rel="alternate" hreflang="fr" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'fr'})) }}">
                <link rel="alternate" hreflang="de" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'de'})) }}">
                {% if currentRoute == 'homepage' %}
                    {# The domain root (EN homepage) is the x-default for the homepage cluster #}
                    <link rel="alternate" hreflang="x-default" href="{{ url('homepage', {'_locale': 'en'}) }}">
                {% else %}
                    <link rel="alternate" hreflang="x-default" href="{{ url(currentRoute, currentRouteParams|merge({'_locale': 'en'})) }}">
                {% endif %}
            {% endif %}
        {% endblock %}

