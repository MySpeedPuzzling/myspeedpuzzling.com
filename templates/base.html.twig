                    </div>
                </div>
            </div>
        </div>
        {% endif %}
        {% endblock %}

        {# The navigation chrome (docs/features/navigation, decision 19): bars, rail and column land here, web only -
           the icon sprite, the phone bottom bar (NAV-01) and the Menu's slot. Bar-free pages empty it together with
           header and footer. Chrome markup rules: implementation plan §3.2. #}
        {% block nav_chrome %}{% if is_web() %}{{ include('navigation/_icons.html.twig') }}{{ include('navigation/_bottom_nav.html.twig') }}{{ include('navigation/_menu_slot.html.twig') }}{% endif %}{% endblock %}

        <main id="main-content">
            {# hasPreviousSession guard: reading app.flashes starts a session, which stamps
               Set-Cookie + Cache-Control: private on every anonymous/crawler response #}
            {% set comparison_added_flash = constant('SpeedPuzzling\\Web\\Controller\\AddComparisonSubjectController::ADDED_FLASH') %}
            {# The launcher pops in only right after something was added - not on every page view #}
            {% set comparison_just_added = comparison_launcher and app.request.hasPreviousSession and app.session.flashBag.peek(comparison_added_flash) is not empty %}
            {% for label in app.request.hasPreviousSession ? ['success', 'danger', 'warning', 'info'] : [] %}
                {% for message in app.flashes(label) %}
                    <div class="container mt-3">
                        <div class="alert-dismissible mb-0 fade show alert alert-{{ label }}" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'forms.close'|trans }}"></button>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}
            {# "Kateřina added to your comparison" + the way there (AddComparisonSubjectController) #}
            {% for added in app.request.hasPreviousSession ? app.flashes(comparison_added_flash) : [] %}
                {{ include('comparison_entry/_added_flash.html.twig', {added: added}) }}
            {% endfor %}

            {% block full_content %}
                <section class="container px-3 pt-2 pt-md-3 pt-lg-4 mb-4">
                    {% block content %}{% endblock %}
                </section>
            {% endblock %}

            {# The end-of-page line (HELP-04, README §4.5): "Something wrong on this page? Tell us" opens the Help sheet with
               this page attached - for guests too (the link depends on the URL only). Emptied by the auth layout, the
               bar-free pages (those that empty nav_chrome) and the help page itself. #}
            {% block page_help_line %}
                <p class="page-help-line container px-3 mt-2 mb-4 text-center text-muted small">
                    {{- 'help.page_line.question'|trans }} <a class="fw-semibold text-nowrap" href="{{ help_path() }}" {{ help_opener_attrs() }} data-nav="page/{{ nav_location().place.value }}/help_line">{{ 'help.page_line.link'|trans }}</a>
                </p>
            {% endblock %}
        </main>

        {% block footer %}
        {% if is_web() %}
        <footer class="site-footer">
            {% if logged_user.profile is null %}
                {# Auth pages empty it: its e-mail field would be the only other text input
                   there, and iOS Password AutoFill reads the page as a login form #}
                {% block footer_newsletter %}{{ include('_footer_newsletter.html.twig') }}{% endblock %}
            {% endif %}

            {{ include('_footer.html.twig') }}
        </footer>
        {% endif %}
        {% endblock %}

        {% if comparison_launcher %}
            {{ include('comparison_entry/_launcher.html.twig', {line_up: logged_user.profile.comparisonLineUp, just_added: comparison_just_added}) }}
        {% endif %}

        {# Announcement modals (docs/features/announcement-modals.md): at most one, once per player ever.
           Calling announcement_modal() claims it for this page view - keep this the only call. #}
        {% set announcement = announcement_modal() %}
        {% if announcement %}
            {{ include(announcement.template()) }}
        {% endif %}

        <div class="modal fade" tabindex="-1" role="dialog" id="membersExclusiveModal">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'membership.modal.title'|trans }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'forms.close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        {{ 'membership.modal.text'|trans|raw }}

                        {% if logged_user.profile and is_web() and logged_user.profile.canStartFreeTrial %}
                            {# Never had a membership: the locked feature they just clicked is one click away (docs/features/free-trial/README.md) #}
                            <p class="fw-medium">{{ 'free_trial.modal.text'|trans({'%days%': constant('SpeedPuzzling\\Web\\Value\\FreeTrial::DAYS')}) }}</p>

                            {{ include('membership/_free_trial_start_form.html.twig', {
                                source: 'members_modal',
                                label: 'free_trial.modal.button'|trans({'%days%': constant('SpeedPuzzling\\Web\\Value\\FreeTrial::DAYS')}),
                                return: app.request.requestUri,
                                form_class: 'me-2 mb-2',
                            }) }}

                            <a href="{{ path('membership') }}" class="btn btn-outline-primary btn-sm me-2 mb-2">{{ 'free_trial.modal.secondary'|trans }}</a>
                        {% elseif logged_user.profile %}
                            {% if is_web() and logged_user.profile.freeTrialAvailable %}
                                <p class="small text-muted">{{ include('membership/_free_trial_unlock_sentence.html.twig', {profile: logged_user.profile}) }}</p>
                            {% endif %}

                            <a href="{{ path('membership') }}" class="btn btn-primary d-inline-block me-2 btn-shadow" type="submit"><i class="bi-person-circle"></i> {{ 'membership.modal.cta'|trans }}</a>
                        {% else %}
                            <a href="{{ path('login') }}" class="btn btn-primary d-inline-block me-2 btn-shadow" type="submit"><i class="bi-person"></i> {{ 'menu.sign_in'|trans }}</a>
                        {% endif %}

                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">{{ 'membership.modal.no_thanks'|trans }}</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="global-search-overlay"></div>

        <!-- Toast Container -->
        <div id="toast-container" class="toast-container position-fixed p-3" data-toast-target="container" style="z-index: 1060;"></div>

        <!-- Dynamic Modal (Turbo-powered) -->
        <div id="dynamic-modal-container"
             class="modal fade"
             tabindex="-1"
             role="dialog"
             aria-hidden="true"
             data-controller="dynamic-modal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    {# Shown by dynamic_modal_controller.js when a response takes longer than 150 ms #}
                    <div class="dynamic-modal-loading" data-dynamic-modal-target="loading" hidden>
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">{{ 'loading'|trans }}</span>
                        </div>
                    </div>
                    {# Shown by dynamic_modal_controller.js when the content could not be loaded (network error) #}
                    <div class="dynamic-modal-error" data-dynamic-modal-target="error" role="alert" hidden>
                        <p class="mb-3">{{ 'modal.load_failed'|trans }}</p>
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            <button type="button" class="btn btn-primary" data-action="dynamic-modal#retry">{{ 'modal.try_again'|trans }}</button>
                            <button type="button" class="btn btn-outline-secondary" data-action="dynamic-modal#dismiss">{{ 'forms.close'|trans }}</button>
                        </div>
                    </div>
                    <turbo-frame id="modal-frame" data-dynamic-modal-target="frame">
                    </turbo-frame>
                </div>
            </div>
        </div>

        {# In-page confirmations (GEST-13): assets/confirm_dialog.js clones this <dialog> for every question -
           data-turbo-confirm forms and the controllers' confirmDialog() - and opens it with showModal(). Web and app. #}
        <template id="msp-confirm-template">
            <dialog class="msp-confirm" role="alertdialog">
                <div class="msp-confirm-box">
                    <p class="msp-confirm-message" data-msp-confirm-message></p>
                    <div class="msp-confirm-actions">
                        <button type="button" class="btn btn-outline-secondary" data-msp-confirm-cancel>{{ 'confirm_dialog.cancel'|trans }}</button>
                        <button type="button" class="btn btn-primary" data-msp-confirm-action>{{ 'confirm_dialog.confirm'|trans }}</button>
                    </div>
                </div>
            </dialog>
        </template>

        {% if logged_user.profile is not null %}
            <div data-controller="mercure-hub"
                 data-mercure-hub-mercure-url-value="{{ mercure_public_url }}"
                 data-mercure-hub-topics-value="{{ mercure_subscribe_topics(logged_user.profile.playerId)|json_encode|e('html_attr') }}"
                 style="display: none;"></div>
        {% endif %}

        {# Navigation layers at the end of <body> (the Menu shell #menu-layer, decision 87): after every page
           GlobalSearch, web only. Bar-free pages empty it together with nav_chrome. #}
        {% block nav_layers %}{% if is_web() %}{{ include('navigation/_menu_layer.html.twig') }}{% endif %}{% endblock %}
    </body>
</html>
