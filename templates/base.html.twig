    </head>
    {# The comparison launcher (docs/features/player-comparison.md, D2) - from the viewer's own profile row, no query.
       A page opts out with `{% set hide_comparison_launcher = true %}` at its top (outside blocks): the comparison
       itself, and every page whose main content is a form, a chat, a bar at the bottom or a running clock - the pill
       would sit over their controls #}
    {% set comparison_launcher = logged_user.profile is not null
        and not hide_comparison_launcher|default(false)
        and logged_user.profile.comparisonLineUp.hasOthers() %}
    {# The viewer's audiences for the page search (MENU-01/MENU-03): "everyone guest" for every guest (shared-cacheable).
       no-nav-chrome: a page without the bars (it sets nav_chrome_off outside its blocks and empties nav_chrome - NAV-08)
       and the app; no-nav-column: the `menu` page, whose content is the Menu (nav_menu_slot_off) - critical CSS keeps the
       desktop column's width (--nav-left) at 0 / the rail's there (NAV-13). Both depend on the page only. #}
    <body class="lang-{{ app.request.locale }}{{ comparison_launcher ? ' has-comparison-launcher' }}{{ (nav_chrome_off ?? false) or not is_web() ? ' no-nav-chrome' }}{{ (nav_menu_slot_off ?? false) ? ' no-nav-column' }}"
          data-viewer-audience="{{ nav_viewer_audience() }}"
          data-controller="pwa-lifecycle gallery file-drop-area datepicker toast{% if ga_tracking is not empty %} analytics{% endif %}"
          {% if ga_tracking is not empty %}data-analytics-tracking-id-value="{{ ga_tracking }}"{% endif %}>
        <a href="#main-content" class="visually-hidden-focusable">{{ 'forms.skip_to_content'|trans }}</a>
        {% block header %}
        {# The top bar (NAV-03, templates/navigation/_topbar.html.twig): sticky, its height reserved in critical CSS #}
        {% if is_web() %}{{ include('navigation/_topbar.html.twig') }}{% endif %}
        {# The old header's rows until NAV-06 removes them (R10): static under the new top bar - no longer sticky, nothing
           measures it (--header-height is the new bar's static height). nav_omit_legacy_chrome: the MENU-01 weight
           probe's test-only switch (LegacyChromeSwitch), off everywhere #}
        {% if is_web() and not nav_omit_legacy_chrome %}
        <div class="legacy-chrome shadow-sm">
            {# Live-event strip: gone once the event's last day is over - the offset is explicit because Twig parses date
               strings in UTC. Never shown on the event page it links to. #}
            {% set live_event_slug = 'world-jigsaw-puzzle-championship-2026' %}
            {% if date() < date('2026-09-21T00:00:00+02:00') and not (currentRoute == 'event_detail' and currentRouteParams.slug is defined and currentRouteParams.slug == live_event_slug) %}
                <a class="competition-panel-info" href="{{ path('event_detail', {slug: live_event_slug}) }}" data-nav="topbar/strip/live_event">
                    <span class="live-dot live-dot-light" aria-hidden="true"></span>{{ 'live_event_strip'|trans({'%event%': 'WJPC 2026'}) }}
                </a>
            {% endif %}
            <div class="topbar topbar-light">
                <div class="container">
                    <div class="topbar-text text-nowrap">
                        {# Admins see everything; community moderators only the puzzle review queues #}
                        {% if is_granted('PUZZLE_MODERATION_ACCESS') %}
                            <div class="topbar-text dropdown disable-autohide me-2 me-sm-3">
                                <a class="topbar-link dropdown-toggle" href="#" data-bs-toggle="dropdown" data-nav="admin_key/toggle/open">
                                    <i class="ci-key"></i>
                                </a>

                                {# The queues' backlog moved to the Menu's Your roles (MENU-01, R10): links only here until NAV-06 #}
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item pb-1 {% if currentRoute == 'admin_puzzle_change_requests' %}active{% endif %}" href="{{ path('admin_puzzle_change_requests') }}" data-nav="admin_key/queues/change_requests">
                                            Puzzle Change Requests
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item pb-1 {% if currentRoute == 'admin_puzzle_merge_requests' %}active{% endif %}" href="{{ path('admin_puzzle_merge_requests') }}" data-nav="admin_key/queues/merge_requests">
                                            Puzzle Merge Requests
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item pb-1 {% if currentRoute == 'admin_puzzle_approvals' %}active{% endif %}" href="{{ path('admin_puzzle_approvals') }}" data-nav="admin_key/queues/puzzle_approvals">
                                            Puzzle Approvals
                                        </a>
                                    </li>
                                    {% if is_granted('REVIEW_SUSPICIOUS_TIMES') %}
