                        <button class="navbar-toggler" type="button" data-nav="hamburger/toggle/open" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-expanded="false" aria-controls="navbarCollapse" aria-label="{{ 'accessibility.toggle_navigation'|trans }}">
                            <span class="toggler-bar"></span>
                            <span class="toggler-bar"></span>
                            <span class="toggler-bar"></span>
                        </button>
                    </div>

                    <div class="collapse navbar-collapse me-auto order-lg-2" id="navbarCollapse">
                        <hr class="d-lg-none my-2">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-lg-center d-lg-flex flex-lg-column align-items-lg-center {% if app.request.pathInfo == path('hub') %}active{% endif %}" href="{{ path('hub') }}" data-nav="hamburger/places/hub">
                                    <i class="me-1 me-lg-0 bi bi-house-door"></i>
                                    <small class="d-none d-lg-block">{{ 'menu.hub'|trans }}</small>
                                    <span class="d-lg-none">{{ 'menu.hub'|trans }}</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-lg-center d-lg-flex flex-lg-column align-items-lg-center {% if app.request.pathInfo == path('puzzles') %}active{% endif %}" href="{{ path('puzzles') }}" data-nav="hamburger/places/puzzles">
                                    <i class="me-1 me-lg-0 bi bi-puzzle"></i>
                                    <small class="d-none d-lg-block">{{ 'menu.puzzles_overview'|trans }}</small>
                                    <span class="d-lg-none">{{ 'menu.puzzles_overview'|trans }}</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-lg-center d-lg-flex flex-lg-column align-items-lg-center {% if currentRoute == 'marketplace' %}active{% endif %}" href="{{ path('marketplace') }}" data-nav="hamburger/places/marketplace">
                                    <i class="me-1 me-lg-0 bi bi-shop"></i>
                                    <small class="d-none d-lg-block">{{ 'marketplace.title'|trans }}</small>
                                    <span class="d-lg-none">{{ 'marketplace.title'|trans }}</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-lg-center d-lg-flex flex-lg-column align-items-lg-center {% if app.request.pathInfo == path('ladder') %}active{% endif %}" href="{{ path('ladder') }}" data-nav="hamburger/places/ladder">
                                    <i class="me-1 me-lg-0 bi bi-trophy"></i>
                                    <small class="d-none d-lg-block">{{ 'menu.ladder'|trans }}</small>
                                    <span class="d-lg-none">{{ 'menu.ladder'|trans }}</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-lg-center d-lg-flex flex-lg-column align-items-lg-center {% if app.request.pathInfo == path('players') %}active{% endif %}" href="{{ path('players') }}" data-nav="hamburger/places/players">
                                    <i class="me-1 me-lg-0 bi bi-people position-relative">
                                        <span class="d-none d-lg-inline badge bg-primary position-absolute translate-middle-y fst-normal" style="font-size: .55em; top: 6px; left: 100%;">{{ 'new_badge'|trans }}</span>
                                    </i>
                                    <small class="d-none d-lg-block">{{ 'menu.players'|trans }}</small>
                                    <span class="d-lg-none">{{ 'menu.players'|trans }} <span class="badge bg-primary ms-1">{{ 'new_badge'|trans }}</span></span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-lg-center d-lg-flex flex-lg-column align-items-lg-center {% if app.request.pathInfo == path('events') %}active{% endif %}" href="{{ path('events') }}" data-nav="hamburger/places/events">
                                    <i class="me-1 me-lg-0 ci-calendar position-relative">
                                        <span class="d-none d-lg-inline badge bg-primary position-absolute translate-middle-y fst-normal" style="font-size: .55em; top: 6px; left: 100%;">{{ 'new_badge'|trans }}</span>
                                    </i>
                                    <small class="d-none d-lg-block">{{ 'menu.events'|trans }}</small>
                                    <span class="d-lg-none">{{ 'menu.events'|trans }} <span class="badge bg-primary ms-1">{{ 'new_badge'|trans }}</span></span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a rel="nofollow" class="nav-link text-lg-center d-lg-flex flex-lg-column align-items-lg-center {% if app.request.pathInfo == path('stopwatch') %}active{% endif %}" href="{{ path('stopwatch') }}" data-nav="hamburger/places/stopwatch">
                                    <i class="me-1 me-lg-0 ci-time"></i>
                                    <small class="d-none d-lg-block">{{ 'menu.stopwatch'|trans }}</small>
                                    <span class="d-lg-none">{{ 'menu.stopwatch'|trans }}</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-lg-center d-lg-flex flex-lg-column align-items-lg-center {% if app.request.pathInfo == path('faq') %}active{% endif %}" href="{{ path('faq') }}" data-nav="hamburger/places/faq">
                                    <i class="me-1 me-lg-0 bi bi-patch-question"></i>
                                    <small class="d-none d-lg-block">{{ 'menu.faq'|trans }}</small>
                                    <span class="d-lg-none">{{ 'menu.faq'|trans }}</span>
