{% extends 'base.html.twig' %}

{# "Borrow requests" (BorrowRequestsController, docs/features/wishlist-availability.md) - Asked by me / Asked of me #}

{% block title %}{{ 'borrow_request.list.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <div class="pb-4">
        <h1 class="h3 mb-2">{{ 'borrow_request.list.title'|trans }}</h1>
        <p class="text-muted fs-sm">{{ 'borrow_request.list.intro'|trans }}</p>

        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item">
                <a class="nav-link {{ tab == 'asked' ? 'active' }}" href="{{ path('borrow_requests') }}" {{ tab == 'asked' ? 'aria-current="page"' }}>{{ 'borrow_request.list.tab_asked'|trans }}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link {{ tab == 'received' ? 'active' }}" href="{{ path('borrow_requests', {tab: 'received'}) }}" {{ tab == 'received' ? 'aria-current="page"' }}>{{ 'borrow_request.list.tab_received'|trans }}</a>
            </li>
        </ul>

        {% if requests is empty %}
            <div class="text-center text-muted py-5">
                <i class="bi bi-box-arrow-in-down fs-1"></i>
                <p class="mt-2 mb-3">{{ (tab == 'received' ? 'borrow_request.list.empty_received' : 'borrow_request.list.empty_asked')|trans }}</p>
                {% if tab == 'asked' %}
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('wish_list_detail', {playerId: logged_user.profile.playerId}) }}">{{ 'borrow_request.list.go_to_wishlist'|trans }}</a>
                {% endif %}
            </div>
        {% else %}
            <div class="d-flex flex-column gap-2">
                {% for request_overview in requests %}
                    <a href="{{ path('borrow_request_detail', {requestId: request_overview.requestId}) }}"
                       class="card card-body shadow-sm p-3 text-decoration-none text-body">
                        <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
                            <strong>
                                {{ (tab == 'received' ? 'borrow_request.list.from' : 'borrow_request.list.to')|trans({'%name%': request_overview.counterpartDisplayName}) }}
                            </strong>
                            <span class="fs-sm text-muted">{{ request_overview.createdAt|ago }}</span>
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            {% for item in request_overview.items %}
                                <span class="d-inline-flex align-items-center gap-1 fs-sm me-2">
                                    {{ item.puzzleName }}
                                    {{ include('borrow_requests/_status_badge.html.twig', {status: item.status}) }}
                                </span>
                            {% endfor %}
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
