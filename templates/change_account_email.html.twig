{% extends 'base.html.twig' %}

{% block title %}{{ 'edit_profile.change_email'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <div class="row gy-3 pb-4">
        <div class="col-lg-6 col-md-8">
            <h1 class="h2">{{ 'edit_profile.change_email'|trans }}</h1>

            <p class="text-muted">{{ 'edit_profile.change_email_description'|trans({'%email%': current_email}) }}</p>

            <div class="card shadow my-3">
                <div class="card-body">
                    {{ form_start(form, {'action': path('change_account_email')}) }}
                        {{ form_row(form.newEmail) }}
                        {{ form_row(form.currentPassword) }}

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-envelope me-1"></i>{{ 'edit_profile.change_email_button'|trans }}
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>

            <p class="fs-sm">
                <a href="{{ path('edit_profile') }}">{{ 'edit_profile.back'|trans }}</a>
            </p>
        </div>
    </div>
{% endblock %}
