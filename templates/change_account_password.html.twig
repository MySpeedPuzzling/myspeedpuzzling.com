{% extends 'base.html.twig' %}

{% block title %}{{ 'edit_profile.change_password'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <div class="row gy-3 pb-4">
        <div class="col-lg-6 col-md-8">
            <h1 class="h2">{{ 'edit_profile.change_password'|trans }}</h1>

            <div class="card shadow my-3" data-controller="password-suggestion">
                <div class="card-body">
                    {{ form_start(form, {'action': path('change_account_password')}) }}
                        {{ form_row(form.currentPassword) }}

                        <div class="mb-3">
                            {{ form_label(form.newPassword) }}
                            {{ form_widget(form.newPassword) }}
                            {{ form_help(form.newPassword) }}
                            {{ form_errors(form.newPassword) }}
                        </div>

                        <p class="mb-3">
                            <button
                                type="button"
                                class="btn btn-sm btn-outline-secondary"
                                data-action="password-suggestion#suggest"
                            >
                                <i class="bi bi-shuffle me-1"></i>{{ 'auth.set_password.suggest'|trans }}
                            </button>
                        </p>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-key me-1"></i>{{ 'edit_profile.change_password_native_button'|trans }}
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>

            <p class="fs-sm">
                <a href="{{ path('request_password_reset') }}">{{ 'edit_profile.change_password_forgot'|trans }}</a>
            </p>

            <p class="fs-sm">
                <a href="{{ path('edit_profile') }}">{{ 'edit_profile.back'|trans }}</a>
            </p>
        </div>
    </div>
{% endblock %}
