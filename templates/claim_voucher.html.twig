{% extends 'base.html.twig' %}

{% block title %}Claim Voucher{% endblock %}

{% block content %}
    <div class="pb-4">
        <div class="row gy-3 pb-3">
            <div class="col-lg-6 col-md-8">
                <h1 class="h2">Claim Voucher</h1>

                <p>Enter your voucher code to claim membership benefits.</p>

                <div class="card shadow my-4">
                    <div class="card-body">
                        {{ form_start(form) }}
                            <div class="mb-3">
                                {{ form_label(form.code) }}
                                {{ form_widget(form.code, {'attr': {'class': 'form-control text-uppercase'}}) }}
                                {{ form_errors(form.code) }}
                            </div>

                            <button type="submit" class="btn btn-primary">
                                Claim Voucher
                            </button>
                        {{ form_end(form) }}
                    </div>
                </div>

                <p class="text-muted small">
                    <a href="{{ path('membership') }}">Back to Membership</a>
                </p>
            </div>

            <div class="col-lg-5 offset-lg-1 col-md-4 text-center">
                <img class="img-fluid" src="{{ asset('img/puzzlie-1.png') }}" alt="Mascot" width="1000" height="949">
            </div>
        </div>
    </div>
{% endblock %}
