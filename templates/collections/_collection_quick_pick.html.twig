{#
    The collection row of a form that adds puzzles (docs/features/collections/default-collection.md): one picker,
    preselected with the default (CollectionPreselection::pick()). For members with 2+ choices the default is listed
    first and marked "Default" inside the picker (assets/tom_select_default_option.js reads `data-default-collection`),
    and "Change default" next to the label leads to the library. Everybody else gets a plain form_row.

    Parameters:
    - field: the collection field (FormView)
    - choices: label => collection id (or the system collection's marker), as the form type gets them
    - system_id: Collection::SYSTEM_ID
    - widget_attr: attributes for the picker input (optional)
#}
{% set widget_attr = widget_attr|default({}) %}
{% if logged_user.profile is not null and logged_user.profile.activeMembership and choices|length > 1 %}
    {% set default_id = logged_user.profile.defaultCollectionId ?? system_id %}
    {% set default_id = default_id in choices ? default_id : (system_id in choices ? system_id : null) %}
    {% if default_id is not null %}
        {% set widget_attr = widget_attr|merge({
            'data-default-collection': default_id,
            'data-default-label': 'collections.default.badge'|trans,
        }) %}
    {% endif %}

    <div class="mb-3" data-testid="collection-picker-row">
        <div class="d-flex justify-content-between align-items-baseline gap-2">
            {{ form_label(field) }}
            <a href="{{ path('puzzle_library', {playerId: logged_user.profile.playerId}) }}" data-turbo-frame="_top" class="fs-xs text-muted text-nowrap">{{ 'collections.quick_pick.change_default'|trans }}</a>
        </div>
        {# form_row would link the help text - so does this row #}
        {{ form_widget(field, {attr: field.vars.attr|merge(widget_attr)|merge(field.vars.help is not empty ? {'aria-describedby': field.vars.id ~ '_help'} : {})}) }}
        {{ form_help(field) }}
        {{ form_errors(field) }}
    </div>
{% elseif widget_attr is empty %}
    {{ form_row(field) }}
{% else %}
    {{ form_row(field, {attr: widget_attr}) }}
{% endif %}
