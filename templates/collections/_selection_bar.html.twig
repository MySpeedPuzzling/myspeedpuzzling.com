{#
    The floating bar of a collection page while puzzles are selected (docs/features/collections/bulk-actions.md).
    Expects `collection` (the page's collection).
#}
{% set route_collection_id = collection.collectionId ?? '__system_collection__' %}
{{ include('_puzzle_selection_bar.html.twig', {actions: [
    {label: 'collection_selection.move'|trans, icon: 'bi bi-folder-symlink', url: path('collection_selected_move', {collectionId: route_collection_id, mode: 'move'})},
    {label: 'collection_selection.copy'|trans, icon: 'bi bi-copy', url: path('collection_selected_move', {collectionId: route_collection_id, mode: 'copy'})},
    {label: 'collection_selection.lend'|trans, icon: 'bi bi-box-arrow-right', url: path('collection_selected_lend', {collectionId: route_collection_id})},
    {label: 'collection_selection.remove'|trans, icon: 'ci-trash', url: path('collection_selected_remove', {collectionId: route_collection_id}), danger: true},
]}) }}
