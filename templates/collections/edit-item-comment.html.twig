{% extends 'base.html.twig' %}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'collections.edit_comment.meta.title'|trans({'%name%': collectionItem.puzzle.name}) }}{% endblock %}
{# The owner's edit form: nothing to index or follow (robots.txt disallows the path too) #}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <twig:PlayerHeader player="{{ player }}" tab="library" :compact="true" />

    {% include '_return_back_button.html.twig' with {fallbackUrl: cancelUrl, fallbackTitle: collectionItem.collection ? collectionItem.collection.name : 'collections.title'|trans} %}

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg">
                <div class="card-header">
                    <h3 class="mb-0">{{ 'collections.edit_comment.title'|trans }}</h3>
                    <small class="text-muted">{{ collectionItem.puzzle.name }}</small>
                </div>
                <div class="card-body">
                    {# The action is explicit: the form posts to its own route wherever it is rendered #}
                    {{ form_start(form, {action: path('edit_collection_item_comment', {collectionItemId: collectionItem.id})}) }}

                    <div class="mb-4">
                        {{ form_row(form.comment) }}
                    </div>

                    {#
                        The owner's own fields for collection puzzles (docs/features/custom-fields.md "Collection
                        items") - plain inputs beside the Symfony form. This form is the only page that shows them:
                        collection pages are often public, so nothing of them is ever rendered there.
                    #}
                    {% if my_fields.fields is not empty %}
                        <div class="border-top pt-3 mb-4" data-testid="collection-item-my-fields">
                            <p class="fw-semibold mb-1"><i class="bi bi-lock me-1"></i>{{ 'my_fields.title'|trans }}</p>
                            <p class="form-text mt-0 mb-3">{{ 'my_fields.collection_item.private_note'|trans }}</p>

                            {% if my_fields.problems is not empty %}
                                <div class="alert alert-danger fs-sm" role="alert">{{ 'my_fields.values.not_saved'|trans }}</div>
                            {% endif %}

                            {{ include('my_fields/_inputs.html.twig', {my_fields: my_fields, id_prefix: 'item-my-field'}) }}

                            <p class="form-text mb-0">
                                <a href="{{ path('my_fields') }}">{{ 'my_fields.manage_link'|trans }}</a>
                            </p>
                        </div>
                    {% else %}
                        <p class="form-text mb-4" data-testid="collection-item-no-my-fields">
                            <i class="bi bi-lock me-1"></i>{{ 'my_fields.collection_item.none'|trans }}
                            <a href="{{ path('my_fields') }}">{{ 'my_fields.manage_link'|trans }}</a>
                        </p>
                    {% endif %}

                    <div class="d-flex justify-content-between gap-2">
                        <a href="{{ cancelUrl }}" class="btn btn-secondary">
                            {{ 'forms.cancel'|trans }}
                        </a>
                        <button type="submit" class="btn btn-primary text-wrap">
                            <i class="bi bi-check-lg me-1"></i>{{ 'collections.edit_comment.submit'|trans }}
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
