{# "Lend to…" for the puzzles selected on a collection page (LendSelectedPuzzlesController) #}
<turbo-frame id="modal-frame">
    <div class="modal-header">
        <h5 class="modal-title">{{ 'collection_selection.lend_title'|trans({'%count%': lendable_count}) }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'forms.close'|trans }}"></button>
    </div>

    <div class="modal-body">
        {% if already_lent_count > 0 %}
            <p class="text-muted small">{{ 'collection_selection.lend_already_lent'|trans({'%count%': already_lent_count}) }}</p>
        {% endif %}

        {% if lendable_count == 0 %}
            <div class="alert alert-info mb-0">{{ 'collection_selection.nothing_to_lend'|trans }}</div>
        {% else %}
            {{ form_start(form, {
                action: path('collection_selected_lend', {collectionId: selection.routeCollectionId}),
                attr: {'data-turbo-frame': 'modal-frame', 'data-collection-selection-form': ''},
            }) }}
                {{ include('collections/_selected_hidden_inputs.html.twig') }}

                <div class="mb-3" data-controller="favorite-player-select">
                    {{ form_label(form.borrowerCode) }}
                    <div class="input-group">
                        {{ form_widget(form.borrowerCode, {attr: {'data-favorite-player-select-target': 'input'}}) }}
                        {% if favorite_players is not empty %}
                            <select class="form-select"
                                    data-favorite-player-select-target="select"
                                    data-action="change->favorite-player-select#selectChanged">
                                <option value="">{{ 'forms.choose_from_favorites'|trans }}</option>
                                {% for favorite in favorite_players %}
                                    <option value="{{ favorite.playerCode }}">
                                        {{ favorite.playerName ?? favorite.playerCode }} ({{ favorite.playerCode|upper }})
                                    </option>
                                {% endfor %}
                            </select>
                        {% endif %}
                    </div>
                    <small class="form-text text-muted">{{ 'lend_borrow.form.borrower_code_help'|trans }}</small>
                    {{ form_errors(form.borrowerCode) }}
                </div>

                <div class="mb-4">
                    {{ form_row(form.notes) }}
                </div>

                <div class="d-grid gap-2 d-sm-flex">
                    <button type="submit" class="btn btn-primary flex-grow-1" data-loading-text="{{ 'forms.saving'|trans }}">
                        <i class="bi bi-box-arrow-right me-1"></i> {{ 'collection_selection.lend_submit'|trans({'%count%': lendable_count}) }}
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'forms.cancel'|trans }}</button>
                </div>
            {{ form_end(form) }}
        {% endif %}
    </div>
</turbo-frame>
