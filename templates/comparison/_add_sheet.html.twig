{# The add sheet of the active line-up (docs/features/player-comparison.md "Add sheet"). Costs nothing until it is
   opened: the search (TomSelect) and the lists are fetched by comparison_add_controller.js on first use - Solo:
   comparison_people (ALL favorites + a few people the viewer puzzles with) and comparison_player_search; Pairs/Teams:
   comparison_team_search. What JavaScript draws is kept away from re-renders (data-live-ignore); the values on the sheet
   follow the line-up, and the sheet closes when it changes.
   The skill tier icons are rendered here once, by the leaderboards' own macro, and cloned by the controller: members get
   every tier, everybody else the lock the leaderboards show them. #}
{% from 'puzzle_intelligence/_macros.html.twig' import skill_icon %}
{% set kind = this.activeKind.value %}
<div class="modal fade cmp-sheet" id="comparison-add-sheet" tabindex="-1" aria-labelledby="comparison-add-title" aria-hidden="true"
    data-testid="comparison-add-sheet"
    data-controller="comparison-sheet comparison-add"
    data-comparison-sheet-revision-value="{{ this.lineUpRevision }}"
    data-comparison-add-kind-value="{{ kind }}"
    data-comparison-add-search-url-value="{{ kind == 'solo' ? path('comparison_player_search') : path('comparison_team_search', {kind: kind}) }}"
    data-comparison-add-suggestions-url-value="{{ kind == 'solo' ? path('comparison_people') : path('comparison_team_search', {kind: kind}) }}"
    data-comparison-add-excluded-value="{{ this.lineUpRefs|json_encode }}"
    data-comparison-add-texts-value="{{ {
        searchPlaceholder: ('comparison.add.search_placeholder_' ~ kind)|trans,
        noResults: 'comparison.add.no_results'|trans,
        noSuggestions: ('comparison.add.no_suggestions_' ~ kind)|trans,
        loading: 'comparison.loading'|trans,
        youreInIt: 'comparison.youre_in_it'|trans,
        favorite: 'comparison.add.favorite'|trans,
        together: browser_translation('comparison.add.together'),
        add: 'comparison.add.add_label'|trans,
        added: 'comparison.add.added'|trans,
        teamsHeading: kind == 'solo' ? null : ('comparison.add.suggestions_' ~ kind)|trans,
        favoritesHeading: browser_translation('comparison.add.favorites_heading'),
        favoritesFilter: 'comparison.add.favorites_filter'|trans,
        favoritesShowAll: browser_translation('comparison.add.favorites_show_all'),
        favoritesNoMatch: 'comparison.add.favorites_no_match'|trans,
        coPuzzlersHeading: 'comparison.add.co_puzzlers_heading'|trans,
    }|json_encode }}"
>
    {% if kind == 'solo' %}
        {% for tier in this.isMember ? ['legend', 'master', 'expert', 'advanced', 'proficient', 'apprentice', 'enthusiast', 'unknown', 'locked'] : ['locked'] %}
            <template data-comparison-add-target="tierIcon" data-tier="{{ tier }}">{{ skill_icon(tier, 16) }}</template>
        {% endfor %}
    {% endif %}

    <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="comparison-add-title">{{ ('comparison.add.title_' ~ kind)|trans }}</h2>
                <span class="cmp-sheet__count">{{ 'comparison.line_up.count'|trans({'%count%': this.lineUpCount, '%cap%': this.cap}) }}</span>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'forms.close'|trans }}"></button>
            </div>

            <div class="modal-body">
                <div class="cmp-add-search" data-live-ignore>
                    <label class="visually-hidden" for="comparison-add-search">{{ ('comparison.add.search_label_' ~ kind)|trans }}</label>
                    <input type="text" id="comparison-add-search" class="form-control" autocomplete="off" data-comparison-add-target="search"
                        placeholder="{{ ('comparison.add.search_placeholder_' ~ kind)|trans }}">
                </div>

                {% if kind == 'solo' %}
                    {% if this.isMember %}
                        <div class="cmp-sheet__section">
                            <twig:ComparisonSimilarSpeed loading="lazy" :excludedPlayerIds="this.excludedPlayerIds" />
                        </div>
                    {% else %}
                        <button type="button" class="cmp-locked-line" data-bs-toggle="modal" data-bs-target="#membersExclusiveModal" data-testid="comparison-similar-locked">
                            <i class="bi bi-dice-5" aria-hidden="true"></i>
                            <span>{{ 'comparison.add.similar_locked'|trans }}</span>
                            <span class="cmp-members-tag"><i class="ci-locked" aria-hidden="true"></i>{{ 'membership.members_exclusive_short'|trans }}</span>
                        </button>
                    {% endif %}
                {% endif %}

                {# Solo: "Your favorites (N)" (8 rows, "Show all", a filter from 9 favorites on) + "People you puzzle with";
                   Pairs/Teams: the viewer's own. Three placeholder rows hold the space until the lists arrive. #}
                <div data-live-ignore>
                    <div class="cmp-add-lists" data-comparison-add-target="suggestions" data-testid="comparison-add-lists" aria-busy="true">
                        {% for i in 1..3 %}<div class="cmp-option cmp-option--skeleton" aria-hidden="true"><span></span><span></span></div>{% endfor %}
                    </div>
                </div>

                <p class="cmp-sheet__foot">{{ ('comparison.add.hint_' ~ kind)|trans }}</p>
            </div>
        </div>
    </div>
</div>
