    <div class="puzzle-detail-chart-placeholder text-center">
        <button type="button" class="btn btn-outline-secondary bg-white btn-sm px-3 fs-sm mt-4 shadow-custom" data-bs-toggle="modal" data-bs-target="#membersExclusiveModal">
