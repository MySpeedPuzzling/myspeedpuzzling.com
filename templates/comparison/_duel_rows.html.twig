{# Exactly two subjects: side-by-side rows (A left, B right) - the gap pill points at whoever was faster, so it shows the
   gap without the leaderboard's "+" ("00:07", "12:05", "01:02:05"). Lists what "puzzles to show" says. #}
{% set result = this.result %}
{% set a = result.highlightA %}
{% set b = result.highlightB %}
<div class="cmp-duel-head" aria-hidden="true">
    <span class="cmp-duel-head__a">{{ this.labelOf(a) }}</span>
    <span class="cmp-duel-head__b">{{ this.labelOf(b) }}</span>
</div>
<ol class="cmp-duel-list" data-testid="comparison-duel-rows">
    {% for row in result.page %}
        {% set puzzle = this.puzzles[row.puzzleId] ?? null %}
        {% if puzzle is not null %}
            {% set cell_a = row.cell(a) %}
            {% set cell_b = row.cell(b) %}
            <li class="cmp-duel" data-testid="comparison-row">
                {{ include('comparison/_puzzle_head.html.twig', {puzzle: puzzle, position: loop.index}) }}

                <div class="cmp-duel__times">
                    {% for side, cell in {a: cell_a, b: cell_b} %}
                        {% if side == 'b' %}
                            {% if cell_a is not null and cell_b is not null and cell_a.seconds != cell_b.seconds %}
                                {% set a_wins = cell_a.seconds < cell_b.seconds %}
                                {% set gap = (cell_a.seconds - cell_b.seconds)|gapTime|slice(1) %}
                                {% set faster_by = 'comparison.cell.faster_by'|trans({'%name%': this.labelOf(a_wins ? a : b)}) %}
                                <span class="cmp-gap cmp-gap--{{ a_wins ? 'a' : 'b' }}" title="{{ faster_by }} {{ gap }}">
                                    {%- if a_wins %}<i class="bi bi-chevron-left" aria-hidden="true"></i>{% endif -%}
                                    <span class="visually-hidden">{{ faster_by }} </span>{{ gap }}
                                    {%- if not a_wins %}<i class="bi bi-chevron-right" aria-hidden="true"></i>{% endif -%}
                                </span>
                            {% elseif cell_a is not null and cell_b is not null %}
                                <span class="cmp-gap cmp-gap--tie">{{ 'comparison.cell.tie'|trans }}</span>
                            {% else %}
                                <span></span>
                            {% endif %}
                        {% endif %}
                        {% set other = side == 'a' ? cell_b : cell_a %}
                        <div class="cmp-duel__side cmp-duel__side--{{ side }}">
                            {% if cell is not null %}
                                <span class="visually-hidden">{{ this.labelOf(side == 'a' ? a : b) }}:</span>
                                {{ include('comparison/_time_link.html.twig', {cell: cell, win: other is null or cell.seconds < other.seconds}) }}
                                {{ include('comparison/_cell_meta.html.twig', {cell: cell}) }}
                            {% else %}
                                <span class="cmp-time cmp-time--none">—</span>
                                <span class="cmp-meta">{{ 'comparison.cell.not_solved'|trans }}</span>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </li>
        {% endif %}
    {% endfor %}
</ol>
