{# 3+ subjects: the highlighted pair - the Duel view, the lead/lag sort and the charts follow it #}
<div class="cmp-highlight" data-testid="comparison-highlight">
    {% for side, value in {a: this.highlightA, b: this.highlightB} %}
        {% if side == 'b' %}<span class="cmp-highlight__vs" aria-hidden="true">{{ 'comparison.highlight.vs'|trans }}</span>{% endif %}
        <span class="cmp-highlight__side">
            <span class="cmp-dot cmp-dot--{{ side }}" aria-hidden="true"></span>
            <label class="visually-hidden" for="comparison-highlight-{{ side }}">{{ ('comparison.highlight.' ~ side)|trans }}</label>
            <select id="comparison-highlight-{{ side }}" class="form-select form-select-sm" data-model="highlight{{ side|upper }}">
                {% for subject in this.compared %}
                    <option value="{{ subject.ref.toString }}" {{ value == subject.ref.toString ? 'selected' }}>{{ this.labelOf(subject.ref) }}</option>
                {% endfor %}
            </select>
        </span>
    {% endfor %}
</div>
<p class="cmp-highlight__hint">{{ 'comparison.highlight.hint'|trans }}</p>
