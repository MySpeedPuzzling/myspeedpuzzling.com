{#
    The player card's "Add to comparison" (the inputs of comparison_entry/_subject_form.html.twig): the POST form
    itself - the card's frame posts it and shows the answer inside the card. The card is a layer, never part of a page
    Turbo caches (assets/instant_back.js removes it first; GEST-15) - every page template uses the one-tap link instead.
    Inputs: those of _subject_form.html.twig
#}
{%- set icon_only = icon_only|default(false) -%}
{%- set token_id = action == 'add'
    ? constant('SpeedPuzzling\\Web\\Controller\\AddComparisonSubjectController::CSRF_TOKEN_ID')
    : constant('SpeedPuzzling\\Web\\Controller\\RemoveComparisonSubjectController::CSRF_TOKEN_ID') -%}
<form method="post" action="{{ path(action == 'add' ? 'comparison_add' : 'comparison_remove') }}"{% if form_class|default(null) %} class="{{ form_class }}"{% endif %}>
    <input type="hidden" name="_token" value="{{ csrf_token(token_id) }}">
    <input type="hidden" name="subject" value="{{ subject }}">
    <input type="hidden" name="return" value="{{ app.request.requestUri }}">
    <button type="submit" class="{{ button_class }}"{% if icon_only %} aria-label="{{ label }}" title="{{ label }}"{% endif %}{% if nav|default(null) %} data-nav="{{ nav }}"{% endif %}>
        <i class="bi {{ icon }}{{ icon_only ? '' : ' me-1' }}" aria-hidden="true"></i>{% if not icon_only %} {{ label }}{% endif %}
        {%- if new_badge|default(false) %}{{ include('comparison_entry/_new_badge.html.twig', {on_icon: icon_only}) }}{% endif %}
    </button>
</form>
