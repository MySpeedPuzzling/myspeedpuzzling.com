{#
    Inside a social app's built-in browser (Instagram, Facebook, Messenger, Threads, TikTok, LINE - InAppBrowser): the
    camera and the screen staying on need the phone's real browser (README §5.5). The way out as on the auth pages
    (_in_app_browser_notice.html.twig): Chrome on Android by an intent, copying the link everywhere else. The page is
    no-store, so reading the User-Agent here is fine.
#}
{% if in_app is not null %}
    <div class="alert alert-warning compete-in-app" role="note" data-controller="copy-link" data-copy-link-url-value="{{ page_url }}" data-copy-link-copied-value="{{ 'compete.page.in_app_copied'|trans }}">
        <p class="fw-medium mb-1">
            <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>{{ 'compete.page.in_app_title'|trans }}
        </p>
        <p class="mb-2">{{ 'compete.page.in_app_text'|trans({'%app%': in_app.app}) }}</p>

        {% if in_app.ios %}
            <p class="mb-2">{{ 'compete.page.in_app_ios'|trans }}</p>
        {% endif %}

        <div class="d-flex flex-wrap gap-2">
            {% if in_app.android %}
                <a class="btn btn-primary" href="{{ chrome_intent_url(in_app) }}" data-turbo="false">
                    <i class="bi bi-browser-chrome me-1" aria-hidden="true"></i>{{ 'compete.page.in_app_open_android'|trans }}
                </a>
            {% endif %}

            <button type="button" class="btn btn-outline-primary" data-copy-link-target="button" data-action="copy-link#copy">
                <i class="bi bi-link-45deg me-1" aria-hidden="true"></i><span>{{ 'compete.page.in_app_copy'|trans }}</span>
            </button>
        </div>

        <label class="visually-hidden" for="compete-in-app-url">{{ 'compete.page.in_app_copy'|trans }}</label>
        <input class="form-control form-control-sm mt-2" id="compete-in-app-url" type="url" value="{{ page_url }}" readonly hidden data-copy-link-target="field">
    </div>
{% endif %}
