{# "Use as a second screen" (compete_video.js secondScreenOffered()) - on the checklist while another device holds the link, and after a takeover #}
<div class="compete-second-offer" data-compete-show="videoSecondOffer" hidden>
    <button type="button" class="btn btn-outline-primary" data-action="compete#useAsSecondScreen"><i class="bi bi-display me-1" aria-hidden="true"></i>{{ 'compete.video.second_offer'|trans }}</button>
    <p class="small mb-0">{{ 'compete.video.second_offer_hint'|trans }}</p>
</div>
