{% extends 'base.html.twig' %}

{#
    A participant's page of an online round (docs/features/online-competitions/README.md §5.5) - CompetePageController,
    assets/controllers/compete_controller.js. One document for the whole session, from the first tap to the last photo:
    iOS mutes the camera on history changes, so nothing here navigates with Turbo - every link and form carries
    data-turbo="false" (the root too), the controller turns Turbo Drive off, and turbo-visit-control makes Turbo load
    this page in full when a link elsewhere leads here.
    The screens are all rendered; the controller shows one (welcome → checklist → waiting → countdown → running →
    finished → timeup → after, plus no_round / not_entered / taken_over / dead_link and the practice).
    Live video (contract phase-1b.md stream VP): only with a media server configured (`video` not null) does the page
    carry its video parts - without one it is the Phase 1 page, byte for byte (each part sits in an `if` whose tags
    leave no trace).
    Finish detection (Phase 2, stream P2I): only when the round's detection is not off (`detection` not null - the
    detector's pinned assets, OnlineDetectorAssets) does the page carry its detection parts: the checklist's row, the
    running screen's "Finish recorded", time's up after a detected finish, the green flash - the same way without
    trace otherwise, but for the two texts of the "reload the page to use it" banner the script builds when the organiser
    turns detection on while this page is open (stream SP, _texts.html.twig).
#}

{% set hide_comparison_launcher = true %}
{# No bars (docs/features/navigation README §4.10, like the round stopwatch): the round runs on this one document - a tab
   or a Menu row would lead off it mid-round (and Turbo visits are off here). It empties header, nav_chrome and
   nav_layers; body.no-nav-chrome keeps the desktop column's width at 0 #}
{% set nav_chrome_off = true %}
{% set connect_data = connect|merge({
    csrfToken: connect.status != 'anonymous' ? csrf_token(constant('SpeedPuzzling\\Web\\Controller\\Compete\\CompetePageController::CONNECT_CSRF_TOKEN_ID')) : null,
}) %}
{% set minutes_limit = round is not null ? round.minutesLimit : null %}

{% block title %}{{ participant.name }} - {{ competition.name }}{% endblock %}
{% block meta_description %}{{ 'compete.page.meta_description'|trans }}{% endblock %}
{% block robots %}
    <meta name="robots" content="noindex, nofollow">
    <meta name="turbo-visit-control" content="reload">
{% endblock %}
{% block og_title %}{{ competition.name }}{% endblock %}
{% block canonical %}{% endblock %}
{% block hreflang %}{% endblock %}
{% block json_ld %}{% endblock %}
{% block page_stylesheets %}{{ encore_entry_link_tags('compete') }}{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}
{% block nav_chrome %}{% endblock %}
{% block nav_layers %}{% endblock %}
{% block page_help_line %}{% endblock %}

{% block full_content %}
    <div class="compete"
         data-bfcache-reload
         data-controller="compete"
         data-turbo="false"
         data-ptr-ignore
         data-screen="{{ initial_screen }}"
         data-camera="idle"
         data-connection="online"
         data-compete-participant-id-value="{{ participant.id }}"
         data-compete-urls-value="{{ urls|json_encode|e('html_attr') }}"
         data-compete-connect-value="{{ connect_data|json_encode|e('html_attr') }}"
         data-compete-texts-value="{{ include('compete/_texts.html.twig')|e('html_attr') }}"
         data-compete-in-app-value="{{ in_app is not null ? 'true' : 'false' }}"{% if video is not null %} data-compete-video-value="{{ video|json_encode|e('html_attr') }}"{% endif %}{% if detection is not null %} data-compete-detection-value="{{ detection|json_encode|e('html_attr') }}"{% endif %}>
        <script type="application/json" data-compete-target="initialState">{{ state|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>

        <noscript><p class="compete-noscript">{{ 'compete.page.no_script'|trans }}</p></noscript>

        <header class="compete-bar">
            <div class="compete-bar-names">
                <span class="compete-bar-competition">{{ competition.name }}</span>
                {% if round is not null %}<span class="compete-bar-round">{{ round.name }}</span>{% endif %}
            </div>
            <div class="compete-bar-side">
                <span class="compete-bar-person">{{ participant.name }}</span>
                <span class="compete-status" aria-live="off">
                    <span class="compete-status-item compete-status-camera" data-compete-field="statusCamera"></span>
                    <span class="compete-status-item compete-status-connection" data-compete-field="statusConnection"></span>
                    <span class="compete-status-item compete-status-pending" data-compete-field="statusPending"></span>
                </span>
                {%~ if video is not null %}
                <span class="compete-video-status" data-compete-field="videoStatus" aria-live="off"></span>
                {%~ endif %}
            </div>
        </header>

        <div class="compete-banners">
            <div class="compete-banner compete-banner--preview" data-compete-show="preview" hidden>
                <span>{{ 'compete.connect.organiser_preview'|trans }}</span>
                <button type="button" class="btn btn-sm btn-light" data-compete-show="thisIsMe" data-action="compete#confirmConnect" hidden>{{ 'compete.connect.this_is_me'|trans }}</button>
            </div>
            <div class="compete-banner compete-banner--offline" data-compete-show="offline" role="status" hidden>{{ 'compete.page.offline_banner'|trans }}</div>
            {# After a reload: no sound and (Safari) no screen lock until a tap - compete_flow.js wakeTapNeeded(); its text
               follows the round (wakeTapText()): the start before GO, time's up while it runs, never after the end #}
            <button type="button" class="compete-banner compete-banner--wake" data-compete-show="wakeTap" data-action="compete#wakeUp" hidden>
                <i class="bi bi-volume-up me-2" aria-hidden="true"></i><span data-compete-show="wakeTapStart">{{ 'compete.screen.wake_tap'|trans }}</span><span data-compete-show="wakeTapTimeUp" hidden>{{ 'compete.screen.wake_tap_running'|trans }}</span>
            </button>
            <button type="button" class="compete-banner compete-banner--camera" data-compete-show="cameraAlert" data-action="compete#restartCamera" hidden>
                <i class="bi bi-camera-video-off me-2" aria-hidden="true"></i>{{ 'compete.screen.camera_alert'|trans }}
            </button>
            <div class="compete-banner compete-banner--notice" data-compete-target="notice" role="status" aria-live="polite" hidden></div>
            {%~ if video is not null %}
            {{ include('compete/_video_banners.html.twig') }}
            {%~ endif %}
        </div>

        {%~ if detection is not null %}
        <div class="compete-detection-flash" aria-hidden="true"></div>
        {%~ endif %}
        <div class="compete-stage">
            <div class="compete-camera" data-compete-target="cameraBox" hidden>
                <video class="compete-video" data-compete-target="video" playsinline muted autoplay disablepictureinpicture></video>
                <div class="compete-frame-guide" aria-hidden="true"><span>{{ 'compete.checklist.frame_guide'|trans }}</span></div>
                {%~ if video is not null %}
                <p class="compete-voice" data-compete-show="videoSpeaking" role="status" hidden><i class="bi bi-mic-fill me-1" aria-hidden="true"></i><span data-compete-field="videoSpeaking"></span></p>
                {%~ endif %}
            </div>

            <div class="compete-screens">
                {{ include('compete/_screen_welcome.html.twig') }}
                {{ include('compete/_screen_checklist.html.twig') }}
                {{ include('compete/_screens_round.html.twig') }}
                {{ include('compete/_screens_other.html.twig') }}
                {{ include('compete/_screen_practice.html.twig') }}
                {%~ if video is not null %}
                {{ include('compete/_screen_second.html.twig') }}
                {%~ endif %}
            </div>
            {%~ if video is not null %}
            {{ include('compete/_video_studio.html.twig') }}
            {%~ endif %}
        </div>
        {%~ if video is not null %}
        {{ include('compete/_video_strip.html.twig') }}
        {%~ endif %}
    </div>
{% endblock %}
