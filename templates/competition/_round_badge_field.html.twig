{#
    The round's badge colour next to a live preview of its badge: the name on the colour the event pages show it in,
    text colour picked for contrast (RoundBadgeColor). Needs `round_badge_preview` = round_badge(...) - the form
    carries round_badge_preview_controller.js (see the add/edit round templates).
#}
<div class="col-sm-6">
    {{ form_row(form.badgeBackgroundColor, {attr: form.badgeBackgroundColor.vars.attr|merge({
        'data-colorpicker-clear-label-value': 'competition.round.form.badge_color_clear'|trans,
    })}) }}
</div>
<div class="col-sm-6 mb-3" data-round-badge-preview>
    <div class="form-label">{{ 'competition.round.form.badge_preview'|trans }}</div>
    <span class="badge fs-6 text-wrap text-start mw-100" data-round-badge-preview-target="badge" style="background-color: {{ round_badge_preview.background }}; color: {{ round_badge_preview.text }};">
        {{- form.name.vars.value is not empty ? form.name.vars.value : 'competition.round.form.name'|trans -}}
    </span>
    <div class="form-text" data-round-badge-preview-target="automaticNote"{% if not round_badge_preview.automatic %} hidden{% endif %}>
        {{ 'competition.round.form.badge_color_automatic'|trans }}
    </div>
</div>
