{#
    A competition display (CompetitionDisplayController, D-displays-overlays.md §7.1, competition toolkit D4) - standalone
    on purpose: no base.html.twig, so no site chrome, no service worker registration, no self-heal scripts, no Turbo,
    no Bootstrap. assets/display.js (Encore entry `display`, never precached for everybody - PRECACHE_SKIP_ENTRIES)
    draws the inline design + first state into #msp-display and keeps it live.
    Variables: page (CompetitionDisplayPayload::pageForToken()), token.
#}
<!doctype html>
<html lang="{{ page.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    {# The token is in the path - never sent to the picture hosts #}
    <meta name="referrer" content="no-referrer">
    <title>{{ page.state.competition.name }} · {{ 'competition_display.page.title'|trans({}, 'messages', page.locale) }}</title>
    {# Set here, not in the stylesheet (watch.html.twig does the same): an OBS browser source may run an old Chromium #}
    {% if page.kind == 'overlay' %}
        <style>html,body{background:transparent!important;margin:0;padding:0;overflow:hidden}</style>
    {% else %}
        <style>html,body{background:#000;margin:0;padding:0;overflow:hidden}</style>
    {% endif %}
    {# The 4 fonts of the design schema, self-hosted (OFL); a browser downloads only the families an element uses.
       font-display: block - a fallback flashing on a projector is worse than 100 ms of nothing. Inline, because the
       build's PostCSS turns `block` into `swap`. #}
    <style>
        @font-face{font-family:"MSP Display Rubik";font-style:normal;font-weight:300 900;font-display:block;src:url({{ asset('fonts/rubik/rubik-latin-ext.woff2') }}) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
        @font-face{font-family:"MSP Display Rubik";font-style:normal;font-weight:300 900;font-display:block;src:url({{ asset('fonts/rubik/rubik-latin.woff2') }}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
        @font-face{font-family:"MSP Display Bebas Neue";font-style:normal;font-weight:400;font-display:block;src:url({{ asset('fonts/display/bebas-neue-latin-ext.woff2') }}) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C4,U+2113,U+2C60-2C7F,U+A720-A7FF}
        @font-face{font-family:"MSP Display Bebas Neue";font-style:normal;font-weight:400;font-display:block;src:url({{ asset('fonts/display/bebas-neue-latin.woff2') }}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
        @font-face{font-family:"MSP Display Roboto Mono";font-style:normal;font-weight:300 700;font-display:block;src:url({{ asset('fonts/display/roboto-mono-latin-ext.woff2') }}) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C4,U+2113,U+2C60-2C7F,U+A720-A7FF}
        @font-face{font-family:"MSP Display Roboto Mono";font-style:normal;font-weight:300 700;font-display:block;src:url({{ asset('fonts/display/roboto-mono-latin.woff2') }}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
        @font-face{font-family:"MSP Display Courier Prime";font-style:normal;font-weight:400;font-display:block;src:url({{ asset('fonts/display/courier-prime-400-latin-ext.woff2') }}) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C4,U+2113,U+2C60-2C7F,U+A720-A7FF}
        @font-face{font-family:"MSP Display Courier Prime";font-style:normal;font-weight:400;font-display:block;src:url({{ asset('fonts/display/courier-prime-400-latin.woff2') }}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
        @font-face{font-family:"MSP Display Courier Prime";font-style:normal;font-weight:700;font-display:block;src:url({{ asset('fonts/display/courier-prime-700-latin-ext.woff2') }}) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C4,U+2113,U+2C60-2C7F,U+A720-A7FF}
        @font-face{font-family:"MSP Display Courier Prime";font-style:normal;font-weight:700;font-display:block;src:url({{ asset('fonts/display/courier-prime-700-latin.woff2') }}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
    </style>
    {{ encore_entry_link_tags('display') }}
    {{ encore_entry_script_tags('display') }}
</head>
<body class="msp-display-body msp-display-body--{{ page.kind }}">
    <div id="msp-display"
         class="msp-display msp-display--{{ page.kind }}"
         data-kind="{{ page.kind }}"
         data-competition-id="{{ page.competitionId }}"
         data-state-url="{{ path('competition_display_state', {token: token}) }}"
         data-design-url="{{ path('competition_display_design', {token: token}) }}"
         data-fullscreen-label="{{ 'competition_display.page.fullscreen'|trans({}, 'messages', page.locale) }}"
         data-design="{{ page.design|json_encode|e('html_attr') }}"
         data-state="{{ page.state|json_encode|e('html_attr') }}"></div>
</body>
</html>
