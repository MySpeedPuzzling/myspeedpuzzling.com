{#
    An unknown or regenerated display link (CompetitionDisplayController) - standalone like the display itself. The
    display's kind is unknown here, so the page is transparent (an OBS browser source shows only the line) with one
    short line for whoever pasted the link.
#}
<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <meta name="referrer" content="no-referrer">
    <title>{{ 'competition_display.page.title'|trans }}</title>
    <style>html,body{background:transparent;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}p{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);margin:0;padding:.75em 1.25em;border-radius:.5em;background:rgba(13,16,23,.85);color:#fff;font-size:20px;text-align:center;max-width:80%}</style>
</head>
<body>
    <p data-display-not-found>{{ 'competition_display.page.not_found'|trans }}</p>
</body>
</html>
