{% extends 'base.html.twig' %}

{% block title %}{{ 'series.meta.title'|trans({'%name%': series.name}) }}{% endblock %}

{% block robots %}
    {# Unapproved/rejected series are publicly reachable at their slug URL - keep them out of the index #}
    {% if series.approvedAt is null or series.rejectedAt is not null %}
        <meta name="robots" content="noindex, nofollow">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block meta_description %}
    {{- 'series.meta.description'|trans({'%name%': series.name}) -}}
{% endblock %}

{% block json_ld %}
{{ parent() }}
{% if series.approvedAt is not null and series.rejectedAt is null and series.slug is not null %}
{# A schema.org Event needs a startDate - an edition without a round and without its own date is left out #}
{% set jsonld_editions = upcoming_editions|merge(past_editions)|filter(edition => edition.editionSlug is not null and not edition.isUndated) %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "EventSeries",
    "name": {{ series.name|json_ld }},
    "url": {{ url('competition_series_detail', {'slug': series.slug})|json_ld }}
    {%- if series.description %},
    "description": {{ series.description|json_ld }}
    {%- endif %}
    {%- if series.logo %},
    {# The large metadata-stripped preset (1200 px JPEG; Google wants event images >= 720 px wide) - never
       the uploaded original, older uploads may still carry EXIF/GPS #}
    "image": {{ series.logo|thumbnail('puzzle_large')|json_ld }}
    {%- endif %}
    {%- if not series.isOnline and series.location %},
    "location": {
        "@type": "Place",
        "name": {{ series.location|json_ld }},
        "address": {
            "@type": "PostalAddress",
            "addressLocality": {{ series.location|json_ld }}
            {%- if series.locationCountryCode %},
            "addressCountry": {{ series.locationCountryCode.name|upper|json_ld }}
            {%- endif %}
        }
    }
    {%- endif %}
    {%- if series.addedByPlayerName %},
    "organizer": {
        "@type": "Person",
        "name": {{ series.addedByPlayerName|json_ld }}
    }
    {%- endif %}
    {%- if jsonld_editions|length > 0 %},
    "subEvent": [
        {%- for edition in jsonld_editions %}
        {
            "@type": "Event",
            "name": {{ edition.name|json_ld }},
            "url": {{ url('edition_detail', {'seriesSlug': series.slug, 'editionSlug': edition.editionSlug})|json_ld }},
            {%- if edition.startsAt %}
            "startDate": {{ edition.startsAt|date('Y-m-d', edition.timezone)|json_ld }}
            {%- else %}
            "startDate": {{ edition.dateFrom|date('Y-m-d')|json_ld }}
            {%- endif %}
            {%- if edition.logo %},
            "image": {{ edition.logo|thumbnail('puzzle_large')|json_ld }}
            {%- endif %}
        }{{ loop.last ? '' : ',' }}
        {%- endfor %}
    ]
    {%- endif %}
}
</script>
{% endif %}
{% endblock %}

{% block content %}
    {{ include('_return_back_button.html.twig', {fallbackUrl: path('events'), fallbackTitle: 'events.title'|trans}) }}

    <div class="d-flex">
        <div class="flex-fill">
            <h1 class="h4 mb-2">
                {{ series.name }}
            </h1>

            <div class="row">
                <div class="col-sm-6">
                    {% if series.isOnline %}
                        <span class="badge bg-info text-dark">{{ 'competition.online'|trans }}</span>
                    {% else %}
                        {% if series.locationCountryCode %}
                            <span class="shadow-custom fi fi-{{ series.locationCountryCode.name }} me-2"></span>
                        {% endif %}
                        {{ series.location }}
                    {% endif %}
                    <span class="badge bg-secondary ms-1">{{ 'competition.recurring'|trans }}</span>
                </div>

                {% if series.link %}
                    <div class="col-sm-6 mt-2 mt-sm-0">
                        <a target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" href="{{ series.link }}">
                            <i class="bi bi-info-circle me-1"></i>{{ 'events.website_link'|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i>
                        </a>
                    </div>
                {% endif %}
            </div>

            {% if series.description %}
                {# Plain text: nl2br escapes first, then keeps the organiser's line breaks #}
                <p class="mt-3">{{ series.description|nl2br }}</p>
            {% endif %}
        </div>

        <div class="ms-3 flex-shrink-0 event-image">
            {% if series.logo %}
                <img style="max-height: 84px;" src="{{ series.logo|thumbnail('puzzle_small') }}" alt="{{ series.name }} logo" class="img-fluid">
            {% endif %}
        </div>
    </div>

    {# Undated editions (no round, no date) are listed here too, last - see GetCompetitionSeries::fetchEditions() #}
    {% if upcoming_editions|length > 0 %}
        <h2 class="h5 mt-4 mb-3">{{ 'series.upcoming_editions'|trans }}</h2>
        <div class="row">
            {% for edition in upcoming_editions %}
                {{ include('_series_edition_card.html.twig', {edition: edition, series: series, past: false}) }}
            {% endfor %}
        </div>
    {% endif %}

    {% if past_editions|length > 0 %}
        <h2 class="h5 mt-4 mb-3">{{ 'series.past_editions'|trans }}</h2>
        <div class="row">
            {% for edition in past_editions %}
                {{ include('_series_edition_card.html.twig', {edition: edition, series: series, past: true}) }}
            {% endfor %}
        </div>
    {% endif %}

    {% if upcoming_editions|length == 0 and past_editions|length == 0 %}
        <p class="text-muted mt-4">{{ 'series.no_editions'|trans }}</p>
    {% endif %}
{% endblock %}
