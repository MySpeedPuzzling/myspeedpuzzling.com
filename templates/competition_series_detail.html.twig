{% extends 'base.html.twig' %}

{% block title %}{{ 'series.meta.title'|trans({'%name%': series.name}) }}{% endblock %}

{% block robots %}
    {# Unapproved/rejected series are publicly reachable at their slug URL - keep them out of the index; a draft is seen only
       by its team (IsSeriesPubliclyVisible) #}
    {% if not series_publicly_visible %}
        <meta name="robots" content="noindex, nofollow">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block meta_description %}
    {{- 'series.meta.description'|trans({'%name%': series.name}) -}}
{% endblock %}

{% block json_ld %}
{{ parent() }}
{{ include('event_parts/_series_json_ld.html.twig') }}
{% endblock %}

{% block content %}
    {#- The series page (docs/features/events-page/detail-pages.md "Series page", owner: workstream A): the shared header
        (Follow series, Website, ⋯), then on phones the facts strip, the Next card, Upcoming by month (+ Ongoing, Date not
        set), the organiser's sections, the Past by year; from 992 px the facts move to the side column. -#}
    <div class="ev-detail ev-detail-series"
        {%- if series.isOnline %} data-controller="event-local-time" data-event-local-time-messages-value="{{ {
            yours: 'event_detail.time.yours'|trans,
            yours_next_day: 'event_detail.time.yours_next_day'|trans,
            yours_previous_day: 'event_detail.time.yours_previous_day'|trans,
        }|json_encode }}"{% endif %}>
        {{ include('event_parts/_draft_banner.html.twig', {draft_state: draft_state}) }}
        {#- The organization in the crumbs (P20): while it is publicly visible, or for its team -#}
        {%- set show_organization = organization is not null and (organization.isPublic or is_granted('ORGANIZATION_EDIT', organization.id)) -%}
        {% embed 'event_parts/_detail_header.html.twig' with {
            crumbs: [{label: 'events.title'|trans, url: path('events')}]|merge(show_organization ? [{label: organization.name, url: path('organization_detail', {slug: organization.slug})}] : []),
            logo: series.logo,
            name: series.name,
            description: series.description,
            return_fallback_url: path('events'),
            return_fallback_title: 'events.title'|trans,
        } %}
            {% block byline %}
                {{- include('event_parts/_organized_by.html.twig', {organization: organization}) -}}
                {{- include('event_parts/_eligibility.html.twig', {eligibility: eligibility}) -}}
                {{- include('event_parts/_schedule.html.twig', {schedule: schedule}) -}}
            {% endblock %}
            {% block facts %}
                {{- include('event_parts/_place.html.twig', {place: page.facts.place}) -}}
                <span class="ev-detail-fact">{{ 'event_detail.facts.recurring'|trans }}</span>
                {%- if page.facts.nextIsLive %}<span class="ev-detail-fact ev-when-live">{{ include('event_parts/_live.html.twig') }}</span>{% endif -%}
            {% endblock %}
            {% block actions %}
                {#- "Add my time" (docs/features/events-page/high-frequency-series.md P27): a series pick - MySpeedPuzzling finds
                    the edition. Signed in, a publicly visible series, unless every dated edition is still to come (a series
                    without editions, or with undated ones only, offers it too - H13) -#}
                {% if series_publicly_visible and page.offersAddMyTime and is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                    <a class="ev-action-button" href="{{ path('puzzle_add', {series: series.id}) }}" data-series-add-time>{{ 'event_rounds.add_my_time'|trans }}</a>
                {% endif %}
                {{ include('event_parts/_follow_action.html.twig', {follow_target: page.followTarget, following: page.following, kind: 'series', follow_name: series.name}) }}
                {% if series.link %}
                    <a class="ev-action-button" target="_blank" rel="noopener noreferrer" href="{{ series.link }}">{{ 'events.website_link'|trans }}<span aria-hidden="true"> ↗</span></a>
                {% endif %}
                {% if is_granted('IS_AUTHENTICATED_REMEMBERED') and is_granted('COMPETITION_SERIES_EDIT', series.id) %}
                    {{ include('event_parts/_manage_button.html.twig', {manage: manage, return_title: series.name, delete_return: path('events')}) }}
                {% endif %}
            {% endblock %}
        {% endembed %}

        <div class="ev-detail-body">
            {#- A series with many sessions: the filter bar (client-side, series_filter_controller.js) over the upcoming rows and
                the past lines - the Next card stays -#}
            <div class="ev-detail-main"{% if page.filter %} data-controller="series-filter"{% endif %}>
                {{ include('series/_facts_strip.html.twig') }}
                {{ include('series/_next.html.twig') }}
                {{ include('series/_filters.html.twig') }}
                {{ include('series/_upcoming.html.twig') }}
                {#- Organiser-written sections (docs/features/competitions-management/public-page.md): between Upcoming and
                    Past - nothing at all without them -#}
                {% if page_sections is not empty %}{{ include('_page_sections.html.twig', {sections: page_sections}) }}{% endif %}
                {{ include('series/_past.html.twig') }}
            </div>
            {{ include('series/_side.html.twig') }}
        </div>

        {{ include('event_parts/_manage_menu_host.html.twig', {show_menu: show_menu}) }}
    </div>
{% endblock %}
