{#
    Participants & profiles (docs/features/competitions-management/participant-linking.md §7.5) - the first card: it
    matters before the event. Counters linking to the participants sheet's People filters, the personal claim links'
    slips and CSV (L4a - an event with online timing: its personal links), the claim invitations by e-mail (L4b) and the
    claim policy radios (D3). Variables: competition, link_summary (GetParticipantLinkSummary), claim_policy (GetParticipantClaimPolicy),
    claim_policy_form.
#}
{% set sheet_url = path('participants_sheet', {competitionId: competition.id}) %}
<div class="col-lg-6">
    <div class="card shadow-sm h-100" id="participant-links" data-toolkit-card="participant-links">
        <div class="card-body">
            <h3 class="h5"><i class="bi bi-person-check me-2"></i>{{ 'participant_linking.hub.title'|trans }}</h3>
            <p class="small text-muted">{{ 'participant_linking.hub.help'|trans }}</p>

            <ul class="list-unstyled small mb-3" data-participant-link-counters>
                <li class="mb-1">
                    <a href="{{ sheet_url }}?tab=people&amp;filter=not_linked" data-counter="linked">
                        {{ 'participant_linking.hub.linked_of'|trans({'%linked%': link_summary.linked, '%people%': link_summary.people}) }}
                    </a>
                </li>
                {% if link_summary.requests > 0 %}
                    <li class="mb-1">
                        <a href="{{ sheet_url }}?tab=people&amp;filter=asks" class="fw-semibold link-warning" data-counter="requests">
                            <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>{{ 'participant_linking.hub.waiting'|trans({'%count%': link_summary.requests}) }}
                        </a>
                    </li>
                {% endif %}
                {# Link suggestions (§7.5, package L5): the people GetParticipantLinkSuggestions has a candidate for #}
                {% if link_summary.suggestions > 0 %}
                    <li class="mb-1">
                        <a href="{{ sheet_url }}?tab=people&amp;filter=suggestions" data-counter="suggestions">
                            <i class="bi bi-lightbulb me-1" aria-hidden="true"></i>{{ 'participant_link_suggestions.hub.count'|trans({'%count%': link_summary.suggestions}) }}
                        </a>
                    </li>
                {% endif %}
                {% if link_summary.linkedByThemselves > 0 %}
                    <li class="mb-1">
                        <a href="{{ sheet_url }}?tab=people&amp;filter=linked_themselves" data-counter="by-themselves">
                            {{ 'participant_linking.hub.by_themselves'|trans({'%count%': link_summary.linkedByThemselves}) }}
                        </a>
                    </li>
                {% endif %}
            </ul>

            {# Personal claim links (§7.4, package L4a): the CSV and the claim slips - on an event with online timing its
               personal links do the same (§5.6) #}
            {% if link_summary.usesOnlineTiming %}
                <p class="small text-muted mb-2">{{ 'participant_claim_link.hub.online_help'|trans }}</p>
                <div class="d-flex flex-wrap gap-2 mb-3" data-claim-link-actions>
                    <a href="{{ path('online_links', {competitionId: competition.id}) }}" class="btn btn-sm btn-outline-primary" data-claim-action="personal-links">
                        <i class="bi bi-link-45deg me-1" aria-hidden="true"></i>{{ 'participant_claim_link.hub.personal_links'|trans }}
                    </a>
                </div>
            {% elseif link_summary.notLinked > 0 %}
                <p class="small text-muted mb-2">{{ 'participant_claim_link.hub.help'|trans }}</p>
                <div class="d-flex flex-wrap gap-2 mb-3" data-claim-link-actions>
                    <a href="{{ path('competition_name_tags', {competitionId: competition.id, kind: 'claims'}) }}" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" data-claim-action="slips">
                        <i class="bi bi-printer me-1" aria-hidden="true"></i>{{ 'participant_claim_link.hub.print_slips'|trans }}
                    </a>
                    <a href="{{ path('participants_claim_links_csv', {competitionId: competition.id}) }}" class="btn btn-sm btn-outline-secondary" data-turbo="false" data-claim-action="csv">
                        <i class="bi bi-download me-1" aria-hidden="true"></i>{{ 'participant_claim_link.hub.download_csv'|trans }}
                    </a>
                </div>

                {# Claim invitations by e-mail (§7.5, package L4b): to the addresses of the E-mail column - confirmed with
                   who is skipped and why #}
                <div class="mb-3" data-claim-invitations>
                    {% if link_summary.invitable > 0 %}
                        <details class="small">
                            <summary class="btn btn-sm btn-outline-primary" data-claim-action="invite">
                                <i class="bi bi-envelope me-1" aria-hidden="true"></i>{{ 'participant_claim_invitation.hub.send'|trans({'%count%': link_summary.invitable}) }}
                            </summary>
                            <div class="border rounded p-2 mt-2">
                                <p class="mb-1">{{ 'participant_claim_invitation.sheet.emails'|trans({'%count%': link_summary.invitable}) }}</p>
                                <p class="mb-1 text-muted">{{ 'participant_claim_invitation.sheet.same_for_everybody'|trans }}</p>
                                {% set skipped = [] %}
                                {% for reason, count in {no_email: link_summary.withoutEmail, invited_recently: link_summary.invitedRecently, said_no: link_summary.saidNo} %}
                                    {% if count > 0 %}
                                        {% set skipped = skipped|merge([('participant_claim_invitation.sheet.skipped_count.' ~ reason)|trans({'%count%': count})]) %}
                                    {% endif %}
                                {% endfor %}
                                {% if skipped is not empty %}
                                    <p class="mb-1 text-muted" data-claim-invitations-skipped>{{ 'participant_claim_invitation.sheet.skipped'|trans({'%list%': skipped|join(' · ')}) }}</p>
                                {% endif %}
                                <form method="post" action="{{ path('send_claim_invitations_to_everybody', {competitionId: competition.id}) }}" class="mt-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('claim-invitations-' ~ competition.id) }}">
                                    <button type="submit" class="btn btn-sm btn-primary" data-claim-invitations-confirm>
                                        {{ 'participant_claim_invitation.sheet.confirm'|trans({'%count%': link_summary.invitable}) }}
                                    </button>
                                </form>
                            </div>
                        </details>
                    {% else %}
                        <p class="small text-muted mb-0" data-claim-invitations-none>{{ 'participant_claim_invitation.hub.none'|trans }}</p>
                    {% endif %}
                </div>
            {% endif %}

            {% set form = claim_policy_form %}
            {{ form_start(form, {attr: {'data-claim-policy-settings': ''}}) }}
                {{ form_errors(form) }}
                <fieldset class="mb-3">
                    <legend class="form-label fw-semibold fs-6 mb-1">{{ 'participant_linking.hub.policy_label'|trans }}</legend>
                    {{ form_errors(form.policy) }}
                    {% for choice in form.policy %}
                        <div class="form-check mb-1">
                            {{ form_widget(choice, {attr: {'aria-describedby': choice.vars.id ~ '_help'}}) }}
                            {{ form_label(choice) }}
                            <div class="form-text mt-0" id="{{ choice.vars.id }}_help">
                                {% if choice.vars.value == 'automatic' %}
                                    {{ (claim_policy.proposalsEffective ? 'participant_linking.hub.policy.automatic_now_approval' : 'participant_linking.hub.policy.automatic_now_open')|trans }}
                                {% else %}
                                    {{ ('participant_linking.hub.policy.' ~ choice.vars.value ~ '_help')|trans }}
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </fieldset>

                <button type="submit" class="btn btn-sm btn-primary" data-claim-policy-save>
                    {{ 'participant_linking.hub.save'|trans }}
                </button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
