{% extends 'base.html.twig' %}

{#
    A new advancement step or a step's settings (competition toolkit A8). Variables: competition, form, step (edit only).
#}

{% set hide_comparison_launcher = true %}
{% set page_title = step is defined ? (step.name ?? 'advancement_step.list.edit_title'|trans) : 'advancement_step.list.add'|trans %}

{% block title %}{{ page_title }} - {{ competition.name }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events.title'|trans, url: path('events')},
        {label: competition.name, url: path('edit_competition', {competitionId: competition.id})},
        {label: 'competition_toolkit.title'|trans, url: path('competition_toolkit', {competitionId: competition.id})},
        {label: 'advancement_step.list.title'|trans, url: path('competition_advancement_steps_manage', {competitionId: competition.id})},
        {label: page_title},
    ]}) }}
    {{ include('_return_back_button.html.twig', {fallbackUrl: path('competition_advancement_steps_manage', {competitionId: competition.id}), fallbackTitle: 'advancement_step.list.title'|trans}) }}

    <div class="pb-4" data-advancement-step-form>
        <h1 class="h2">{{ page_title }}</h1>
        <p class="text-muted" style="max-width: 40rem;">{{ 'advancement_step.form.intro'|trans }}</p>

        <div style="max-width: 40rem;">
            {{ form_start(form) }}
                {{ form_errors(form) }}

                <div class="row g-3 mb-3">
                    {% for field in [form.sourceRoundIds, form.targetRoundIds] %}
                        <fieldset class="col-sm-6">
                            <legend class="form-label fw-semibold fs-6 mb-1">{{ form_label(field)|striptags }}</legend>
                            {{ form_errors(field) }}
                            {% for choice in field %}
                                <div class="form-check">{{ form_widget(choice) }}{{ form_label(choice) }}</div>
                            {% endfor %}
                        </fieldset>
                    {% endfor %}
                </div>
                <div class="form-text mt-n2 mb-3">{{ 'advancement_step.form.rounds_help'|trans }}</div>

                {{ form_row(form.qualifyCount, {row_attr: {class: 'mb-2'}, attr: {style: 'max-width: 8rem;'}}) }}

                <fieldset class="mb-3">
                    <legend class="visually-hidden">{{ form_label(form.qualifyScope)|striptags }}</legend>
                    {{ form_errors(form.qualifyScope) }}
                    {% for choice in form.qualifyScope %}
                        <div class="form-check">
                            {{ form_widget(choice) }}{{ form_label(choice) }}
                            <div class="form-text mt-0">{{ ('advancement_step.scope.' ~ choice.vars.value ~ '_help')|trans }}</div>
                        </div>
                    {% endfor %}
                </fieldset>

                {{ form_row(form.bestOfEachCountry, {row_attr: {class: 'mb-3'}, attr: {style: 'max-width: 8rem;'}}) }}

                <fieldset class="mb-3">
                    <legend class="form-label fw-semibold fs-6 mb-1">{{ form_label(form.distribution)|striptags }}</legend>
                    {{ form_errors(form.distribution) }}
                    {% for choice in form.distribution %}
                        <div class="form-check mb-1">
                            {{ form_widget(choice) }}{{ form_label(choice) }}
                            <div class="form-text mt-0">{{ ('results_desk.advance.distribution.' ~ choice.vars.value ~ '_help')|trans }}</div>
                        </div>
                    {% endfor %}
                </fieldset>

                <details class="mb-3" {{ form.distribution.vars.value == 'by_source' or form.targetBySource.vars.errors|length > 0 ? 'open' }} data-advancement-step-map>
                    <summary class="fw-semibold">{{ form_label(form.targetBySource)|striptags }}</summary>
                    <div class="form-text mt-0 mb-2">{{ 'advancement_step.form.map_help'|trans }}</div>
                    {% for row in form.targetBySource %}
                        <div class="row g-2 align-items-center mb-1">
                            <label class="col-sm-5 col-form-label col-form-label-sm" for="{{ row.vars.id }}">{{ row.vars.label }}</label>
                            <div class="col-sm-7">{{ form_widget(row, {attr: {class: 'form-select-sm'}}) }}</div>
                        </div>
                    {% endfor %}
                </details>

                {{ form_row(form.name, {row_attr: {class: 'mb-3'}}) }}

                <button type="submit" class="btn btn-primary" data-advancement-step-save>{{ 'advancement_step.form.save'|trans }}</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
