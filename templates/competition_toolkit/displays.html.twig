{% extends 'base.html.twig' %}

{#
    Every display and overlay of an event (D-displays-overlays.md §8.1) - only for whom COMPETITION_TOOLKIT_MANAGE
    grants. Variables: competition, rounds, displays, add_display_form, displays_return.
#}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'competition_display.list.title'|trans }} - {{ competition.name }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events.title'|trans, url: path('events')},
        {label: competition.name, url: path('edit_competition', {competitionId: competition.id})},
        {label: 'competition_toolkit.title'|trans, url: path('competition_toolkit', {competitionId: competition.id})},
        {label: 'competition_display.list.title'|trans},
    ]}) }}
    {#- Back to where the organiser came from (the stopwatch page, the control room - D8), else the toolkit hub -#}
    {{ include('_return_back_button.html.twig', {fallbackUrl: path('competition_toolkit', {competitionId: competition.id}), fallbackTitle: 'competition_toolkit.title'|trans}) }}

    <div class="pb-4" style="max-width: 48rem;" data-competition-displays>
        <h1 class="h2">{{ competition.name }}</h1>
        <h2 class="h4 mt-4">{{ 'competition_display.list.title'|trans }}</h2>
        <p class="text-muted">{{ 'competition_toolkit.cards.displays.help'|trans }}</p>

        {{ include('competition_toolkit/_displays_table.html.twig') }}

        <div class="card shadow-sm">
            <div class="card-body">
                {{ include('competition_toolkit/_display_add_form.html.twig') }}
            </div>
        </div>

        {#- The commentators' analytics studio of each round (analytics-studio.md §8) - by the round's id, 0 statements -#}
        {% set studio_rounds = rounds|filter(round => round.slug is not null) %}
        {% if studio_rounds is not empty %}
            <section class="mt-4" data-analytics-studio-rounds>
                <h2 class="h4">{{ 'analytics_studio.organiser.title'|trans }}</h2>
                <p class="text-muted">{{ 'analytics_studio.organiser.help'|trans }}</p>
                <div class="d-flex flex-wrap gap-2">
                    {% for round in studio_rounds %}
                        <a href="{{ path('analytics_studio_round', {roundId: round.id}) }}" class="btn btn-sm btn-outline-primary" target="_blank" rel="nofollow noopener" data-turbo="false" data-analytics-studio-link="{{ round.id }}">
                            <i class="bi bi-graph-up me-1" aria-hidden="true"></i>{{ round.name }}
                        </a>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </div>
{% endblock %}
