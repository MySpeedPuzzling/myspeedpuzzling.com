{% extends 'base.html.twig' %}

{#
    The competition toolkit's settings hub of one event (docs/features/competitions-management/toolkit/
    R-review-and-plan.md §1.4) - only for whom COMPETITION_TOOLKIT_MANAGE grants. One card per area, each in its own
    partial that its package fills; data-toolkit-card names the card for the tests.
#}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'competition_toolkit.title'|trans }} - {{ competition.name }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events.title'|trans, url: path('events')},
        {label: competition.name, url: path('edit_competition', {competitionId: competition.id})},
        {label: 'competition_toolkit.title'|trans},
    ]}) }}
    {{ include('_return_back_button.html.twig', {fallbackUrl: path('edit_competition', {competitionId: competition.id}), fallbackTitle: 'competition.edit_event'|trans}) }}

    <div class="pb-4" data-competition-toolkit>
        <h1 class="h2">{{ competition.name }}</h1>
        <h2 class="h4 mt-4">{{ 'competition_toolkit.title'|trans }}</h2>
        <p class="text-muted" style="max-width: 48rem;">{{ 'competition_toolkit.intro'|trans }}</p>

        {% set toolkit_return = {return: path('competition_toolkit', {competitionId: competition.id}), return_title: 'competition_toolkit.title'|trans} %}

        <div class="row g-4">
            {{ include('competition_toolkit/_card_participant_links.html.twig') }}
            {{ include('competition_toolkit/_card_competitor_pages.html.twig') }}
            {{ include('competition_toolkit/_card_displays.html.twig') }}
            {{ include('competition_toolkit/_card_standings.html.twig') }}
            {{ include('competition_toolkit/_card_round_formats.html.twig') }}
            {{ include('competition_toolkit/_card_judges.html.twig') }}
        </div>
    </div>
{% endblock %}
