{% extends 'base.html.twig' %}

{#
    The standings of an event (competition toolkit A6, competition_standings_manage): each with its live preview over
    every round, published or not. Variables: competition, rounds, tables (list<StandingTable>), missing_categories,
    public_urls (standing id => its public page, published ones only - A7), embed_urls (standing id => its embeddable
    page for the organiser's website, published ones only - real events L3).
#}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'competition_standing.list.title'|trans }} - {{ competition.name }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events.title'|trans, url: path('events')},
        {label: competition.name, url: path('edit_competition', {competitionId: competition.id})},
        {label: 'competition_toolkit.title'|trans, url: path('competition_toolkit', {competitionId: competition.id})},
        {label: 'competition_standing.list.title'|trans},
    ]}) }}
    {{ include('_return_back_button.html.twig', {fallbackUrl: path('competition_toolkit', {competitionId: competition.id}), fallbackTitle: 'competition_toolkit.title'|trans}) }}

    <div class="pb-4" data-competition-standings>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <h1 class="h2 mb-0">{{ 'competition_standing.list.title'|trans }}</h1>
            <a href="{{ path('add_competition_standing', {competitionId: competition.id}) }}" class="btn btn-sm btn-primary ms-auto" data-standing-add-link>
                <i class="bi bi-plus-lg me-1"></i>{{ 'competition_standing.list.add'|trans }}
            </a>
        </div>
        <p class="text-muted" style="max-width: 48rem;">{{ 'competition_standing.list.intro'|trans }}</p>
        <p class="small text-muted" style="max-width: 48rem;">{{ 'public_standing.organiser.publish_help'|trans }}</p>

        {% if missing_categories is not empty %}
            <form method="post" action="{{ path('create_competition_standings_per_category', {competitionId: competition.id}) }}" class="card card-body bg-body-tertiary mb-4" style="max-width: 48rem;" data-standings-per-category>
                <input type="hidden" name="_token" value="{{ csrf_token('standings-per-category-' ~ competition.id) }}">
                <p class="small mb-2">{{ 'competition_standing.list.per_category_help'|trans({'%categories%': missing_categories|map(c => ('competition.round.category.' ~ c.value)|trans)|join(', ')}) }}</p>
                <div><button type="submit" class="btn btn-sm btn-outline-primary">{{ 'competition_standing.list.per_category'|trans }}</button></div>
            </form>
        {% endif %}
        {#- Real events L2a: one standing per category and division - only for an event with divisions -#}
        {% if missing_division_standings|default([]) is not empty %}
            <form method="post" action="{{ path('create_competition_standings_per_category', {competitionId: competition.id}) }}" class="card card-body bg-body-tertiary mb-4" style="max-width: 48rem;" data-standings-per-division>
                <input type="hidden" name="_token" value="{{ csrf_token('standings-per-category-' ~ competition.id) }}">
                <input type="hidden" name="per_division" value="1">
                <p class="small mb-2">{{ 'standing_division.per_division_help'|trans({'%standings%': missing_division_standings|join(', ')}) }}</p>
                <div><button type="submit" class="btn btn-sm btn-outline-primary">{{ 'standing_division.per_division'|trans }}</button></div>
            </form>
        {% endif %}

        {% if rounds is empty %}
            <p class="text-muted">{{ 'competition_standing.list.no_rounds'|trans }}</p>
        {% endif %}

        {% for table in tables %}
            <section class="card shadow-sm mb-4" data-standing="{{ table.standing.id }}">
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <h2 class="h5 mb-0">{{ table.standing.name }}</h2>
                        <span class="badge bg-secondary">{{ ('competition.round.category.' ~ table.standing.category.value)|trans }}</span>{% if table.standing.division is not null %}<span class="badge text-bg-light border ms-2" data-standing-division>{{ table.standing.division.name }}</span>{% endif %}
                        <span class="small text-muted">{% if table.stages is not null %}{{ 'competition_toolkit.standings.mode.stages'|trans }}{% if table.standing.numberedAcrossStages %} · {{ 'competition_toolkit.standings.rule_numbered'|trans }}{% endif %}{% else %}{{ include('standing/_rules.html.twig', {rules: table.standing.rules}) }}{% endif %}</span>
                        {% if table.standing.publishedAt is not null %}
                            <span class="badge bg-success" data-standing-published>{{ 'public_standing.organiser.published'|trans }}</span>
                        {% else %}
                            <span class="badge text-bg-light border" data-standing-unpublished>{{ 'public_standing.organiser.not_published'|trans }}</span>
                        {% endif %}
                        <div class="ms-auto d-flex flex-wrap gap-2">
                            {% if public_urls[table.standing.id] is defined %}
                                <a href="{{ public_urls[table.standing.id] }}" class="btn btn-sm btn-outline-primary" data-standing-public-link>
                                    <i class="bi bi-box-arrow-up-right me-1"></i>{{ 'public_standing.organiser.view_public'|trans }}
                                </a>
                            {% endif %}
                            <form method="post" action="{{ path('publish_competition_standing', {competitionId: competition.id, standingId: table.standing.id}) }}"
                                {%- if table.standing.publishedAt is not null %} onsubmit="return confirm({{ 'public_standing.organiser.unpublish_confirm'|trans({'%name%': table.standing.name})|json_encode }});"{% endif %}>
                                <input type="hidden" name="_publish_token" value="{{ csrf_token('publish-standing-' ~ table.standing.id) }}">
                                <input type="hidden" name="publish" value="{{ table.standing.publishedAt is null ? '1' : '0' }}">
                                {% if table.standing.publishedAt is null %}
                                    <button type="submit" class="btn btn-sm btn-success" data-standing-publish><i class="bi bi-globe me-1"></i>{{ 'public_standing.organiser.publish'|trans }}</button>
                                {% else %}
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" data-standing-unpublish><i class="bi bi-eye-slash me-1"></i>{{ 'public_standing.organiser.unpublish'|trans }}</button>
                                {% endif %}
                            </form>
                            <a href="{{ path('edit_competition_standing', {competitionId: competition.id, standingId: table.standing.id}) }}" class="btn btn-sm btn-outline-secondary" data-standing-edit-link>
                                <i class="bi bi-pencil me-1"></i>{{ 'competition_standing.list.edit'|trans }}
                            </a>
                            <form method="post" action="{{ path('delete_competition_standing', {competitionId: competition.id, standingId: table.standing.id}) }}" onsubmit="return confirm({{ 'competition_standing.list.delete_confirm'|trans({'%name%': table.standing.name})|json_encode }});">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-standing-' ~ table.standing.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger" data-standing-delete>
                                    <i class="bi bi-trash"></i><span class="visually-hidden">{{ 'competition_standing.list.delete'|trans }}</span>
                                </button>
                            </form>
                        </div>
                    </div>

                    {# Real events L3: the published standing on the organiser's own website, as an <iframe> #}
                    {% if embed_urls[table.standing.id] is defined %}
                        {% set embed_snippet = '<iframe src="' ~ embed_urls[table.standing.id] ~ '" title="' ~ table.standing.name|e('html') ~ '" width="100%" height="600" style="border:0;width:100%;max-width:100%" loading="lazy"></iframe>' %}
                        <details class="mb-3" data-standing-embed-box>
                            <summary class="small fw-semibold">{{ 'standing_embed.organiser.title'|trans }}</summary>
                            <div class="mt-2" style="max-width: 48rem;" data-controller="clipboard">
                                <p class="small text-muted mb-2">{{ 'standing_embed.organiser.help'|trans }}</p>
                                <textarea class="form-control form-control-sm font-monospace mb-2" rows="3" readonly
                                          {{ stimulus_target('clipboard', 'input') }}
                                          data-action="click->clipboard#selectInputContent focus->clipboard#selectInputContent"
                                          data-standing-embed-snippet>{{ embed_snippet }}</textarea>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" {{ stimulus_action('clipboard', 'copyToClipboard', 'click') }}>
                                        <i class="ci-share me-1" {{ stimulus_target('clipboard', 'buttonIcon') }}></i>{{ 'standing_embed.organiser.copy'|trans }}
                                    </button>
                                    <a href="{{ embed_urls[table.standing.id] }}" target="_blank" rel="noopener" class="small" data-standing-embed-preview>{{ 'standing_embed.organiser.preview'|trans }}</a>
                                </div>
                                <p class="small text-muted mt-2 mb-0">{{ 'standing_embed.organiser.options'|trans }}</p>
                            </div>
                        </details>
                    {% endif %}

                    {{ include(table.stages is not null ? 'competition_toolkit/_stages_preview.html.twig' : 'competition_toolkit/_standing_table.html.twig') }}
                </div>
            </section>
        {% else %}
            <p class="text-muted" data-standings-empty>{{ 'competition_standing.list.empty'|trans }}</p>
        {% endfor %}
    </div>
{% endblock %}
