{#
    The achievements showcase near the top of a profile (src/Component/AchievementsShowcase.php): one row of medallions
    scrolling sideways, best first, and "11 of 16 · 640 AP ›" to the catalogue. Members only - a non-member owner gets
    one quiet line instead (never a lock). A seal opens the detail sheet with this player's medal (`player`,
    docs/features/xp-levels/ux-polish/design-spec.md §2). The owner's unrevealed achievements are one call-out on top
    (count, what they are, "Reveal them") - the row shows only what is revealed.
#}
{% if this.mode == 'showcase' %}
    <section {{ attributes.defaults({class: 'achievements-showcase'}) }} aria-labelledby="achievements-showcase-title">
        <div class="achievements-showcase-head">
            <h2 class="achievements-showcase-title" id="achievements-showcase-title">{{ 'badges.title'|trans }}</h2>
            {# Back from the achievements page, the sheet and the holders page comes here (docs/features/return-url.md) #}
            {% set showcase_return = {return: path('player_profile', {playerId: player.playerId}), return_title: player.playerName ?? ('#' ~ player.code|upper)} %}
            <a class="achievements-showcase-summary" href="{{ path('player_achievements', {playerId: player.playerId}|merge(showcase_return)) }}" rel="nofollow">
                {{ 'player_progress.showcase.earned'|trans({'%earned%': this.earnedTypes, '%total%': this.totalTypes}) }}
                <span class="achievements-showcase-ap">{{ 'badges.ap_total'|trans({'%points%': player.achievementPoints|plain_number}) }}</span>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
        </div>

        {% set unrevealed = this.unrevealedCount %}
        {% set shown = this.shownBadges %}

        {% if unrevealed > 0 %}
            {# The owner's new achievements: how many, what they are and the one thing to do - never a row of "?" #}
            <a class="achievements-showcase-reveal" href="{{ path('badge_reveals') }}">
                <span class="achievements-showcase-reveal-trays" aria-hidden="true">
                    {%- for i in 1..min(unrevealed, 3) %}<span></span>{% endfor -%}
                </span>
                <span class="achievements-showcase-reveal-text">
                    <strong>{{ 'player_progress.showcase.reveal_title'|trans({'%count%': unrevealed}) }}</strong>
                    <span>{{ 'player_progress.showcase.reveal_text'|trans({'%count%': unrevealed}) }}</span>
                </span>
                <span class="btn btn-primary btn-sm achievements-showcase-reveal-button">{{ 'badges.reveals.invite_button'|trans({'%count%': unrevealed}) }}</span>
            </a>
        {% endif %}

        {% if this.badges is empty %}
            <p class="achievements-showcase-empty">{{ 'badges.waiting_teaser_zero'|trans }}</p>
        {% elseif shown is not empty %}
            <ul class="achievements-showcase-row">
                {% for badge in shown %}
                    {% set label = (badge.type.translationKey())|trans %}
                    <li>
                        <a class="achievements-showcase-item" href="{{ path('achievement_info', {type: badge.type.value, tier: badge.tier ? badge.tier.value : null, player: player.playerId}|merge(showcase_return)) }}" data-turbo-frame="modal-frame" title="{{ 'badges.info.open'|trans({'%achievement%': label}) }}">
                            {{ badge_art(badge.type, badge.tier, 56) }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
{% elseif this.mode == 'teaser' %}
    <p {{ attributes.defaults({class: 'achievements-teaser'}) }}>
        <i class="bi bi-award" aria-hidden="true"></i>
        {% if this.hasEarned %}
            <span>{{ 'player_progress.showcase.teaser'|trans }} <a href="{{ path('membership') }}">{{ 'player_progress.showcase.teaser_link'|trans }}</a></span>
        {% else %}
            <span>{{ 'player_progress.showcase.teaser_none'|trans }} <a href="{{ path('badges_overview') }}">{{ 'player_progress.showcase.teaser_none_link'|trans }}</a></span>
        {% endif %}
    </p>
{% endif %}
