<div{{ attributes }}>
    {% set percentage = this.totalCount > 0 ? ((this.checkedInCount / this.totalCount) * 100)|round : 0 %}
    <p class="h6 mb-2" data-check-in-progress>{{ 'competition_registration.check_in.progress'|trans({'%checkedIn%': this.checkedInCount, '%total%': this.totalCount}) }}</p>
    <div class="progress mb-3" style="height: 8px;" role="progressbar" aria-label="{{ 'competition_registration.check_in.progress'|trans({'%checkedIn%': this.checkedInCount, '%total%': this.totalCount}) }}" aria-valuenow="{{ this.checkedInCount }}" aria-valuemin="0" aria-valuemax="{{ this.totalCount }}">
        <div class="progress-bar bg-success" style="width: {{ percentage }}%"></div>
    </div>

    <label for="check-in-search" class="visually-hidden">{{ 'competition_registration.check_in.search'|trans }}</label>
    <input
        id="check-in-search"
        type="search"
        class="form-control form-control-lg mb-3"
        placeholder="{{ 'competition_registration.check_in.search'|trans }}"
        data-model="debounce(200)|searchQuery"
        autocomplete="off"
    >

    <div class="list-group">
        {% for participant in this.visibleParticipants %}
            {% set status = participant.registrationStatus ? participant.registrationStatus.value : 'reserved' %}
            <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 py-3 {{ participant.checkedInAt ? 'list-group-item-success' }}" id="check-in-{{ participant.participantId }}">
                <div>
                    <strong>{{ participant.participantName }}</strong>
                    {% if participant.participantCountry %}
                        <small class="fi fi-{{ participant.participantCountry.name }} ms-1"></small>
                    {% endif %}
                    {% if participant.playerName and participant.playerName != participant.participantName %}
                        <small class="text-muted d-block">{{ participant.playerName }}</small>
                    {% endif %}
                    <div class="mt-1">
                        {% if status == 'paid' %}
                            <span class="badge bg-success">{{ 'competition_registration.status.paid'|trans }}</span>
                        {% else %}
                            <span class="badge bg-danger">{{ 'competition_registration.check_in.not_paid'|trans }}</span>
                            <button
                                class="btn btn-sm btn-outline-success py-0 px-2 ms-1"
                                data-action="live#action"
                                data-live-action-param="markPaid"
                                data-live-participant-id-param="{{ participant.participantId }}"
                            >
                                {{ 'competition_registration.manage.mark_paid'|trans }}
                            </button>
                        {% endif %}
                    </div>
                </div>
                <div>
                    {% if participant.checkedInAt %}
                        <button
                            class="btn btn-outline-secondary btn-sm"
                            data-action="live#action"
                            data-live-action-param="undoCheckIn"
                            data-live-participant-id-param="{{ participant.participantId }}"
                        >
                            <i class="bi bi-arrow-counterclockwise me-1"></i>{{ 'competition_registration.check_in.undo'|trans }}
                        </button>
                    {% else %}
                        <button
                            class="btn btn-success"
                            data-action="live#action"
                            data-live-action-param="checkIn"
                            data-live-participant-id-param="{{ participant.participantId }}"
                        >
                            <i class="bi bi-person-check me-1"></i>{{ 'competition_registration.check_in.check_in'|trans }}
                        </button>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="text-center py-5 text-muted">
                {{ 'competition.participants.no_participants'|trans }}
            </div>
        {% endfor %}
    </div>
</div>
