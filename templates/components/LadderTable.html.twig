<div {{ attributes }}>
    {# Same row as the player profile results and the puzzle leaderboards (_leaderboard_player, _leaderboard_time_badges,
       _leaderboard.scss): rank · image · whoever solved it with the puzzle · time - never scrolls sideways. A tap on the row
       opens the result detail (docs/features/puzzle-result-detail.md) #}
    <div class="custom-table-wrapper ps-wrapper mt-3 mb-3">
        <table class="table table-hover ps-table mb-0">
            <tbody>
            {# Members see each puzzle's difficulty on the image's corner (null for everyone else) #}
            {% set difficulty_tiers = this.difficultyTiers %}
            {% for solving_time in this.items %}
                {# The viewer's own row - solo, or a pair/team they are a member of (not only the one who tracked it) #}
                {% set is_own_row = logged_user.profile is not null and (
                    solving_time.players is null
                        ? solving_time.playerId is same as logged_user.profile.playerId
                        : logged_user.profile.playerId in solving_time.players|map(member => member.playerId)
                ) %}
                <tr class="{{ is_own_row ? 'table-active-player' }}" data-controller="row-link" data-action="click->row-link#open">
                    <td class="rank"><span class="lb-rank">{{ loop.index }}</span></td>

                    <td class="ps-image">
                        <div class="diff-corner-host">
                            <a href="{{ path('puzzle_detail', {puzzleId: solving_time.puzzleId}) }}">
                                {{ include('_puzzle_row_image.html.twig', {image: solving_time.puzzleImage, alt: 'puzzle_img_alt'|trans({'%puzzle%': solving_time.manufacturerName ~ ' ' ~ solving_time.puzzleName}), position: loop.index, ratio: solving_time.puzzleImageRatio}) }}
                            </a>

                            {% if difficulty_tiers is not null %}
                                {{ include('_difficulty_corner.html.twig', {tier: difficulty_tiers[solving_time.puzzleId] ?? null}) }}
                            {% endif %}
                        </div>
                    </td>

                    {# On a ladder the player leads, the puzzle is the context under it #}
                    <td class="ps-info">
                        <div class="ps-members ps-members-lead">
                            {% if solving_time.players is null %}
                                {{ include('_leaderboard_player.html.twig', {player: solving_time}) }}
                            {% else %}
                                {% for puzzle_solver in solving_time.players %}
                                    {{ include('_leaderboard_player.html.twig', {player: puzzle_solver, small: true}) }}
                                {% endfor %}
                            {% endif %}
                        </div>

                        {# Every row of a ladder has the same piece count - the brand is enough #}
                        <div class="ps-puzzle-line">
                            <a href="{{ path('puzzle_detail', {puzzleId: solving_time.puzzleId}) }}">{{ solving_time.puzzleName }}</a>
                        </div>
                        <div class="ps-puzzle-sub">{{ solving_time.manufacturerName }}</div>

                        <div class="ps-tags">
                            {{ include('_leaderboard_time_badges.html.twig', {time: solving_time, attempts: solving_time.solvedTimes, skip_first_try: true}) }}
                        </div>
                    </td>

                    <td class="ps-time">
                        {# The row's real link to the result detail - a tap anywhere else on the row clicks it #}
                        <a
                            class="ps-time-value"
                            href="{{ path('puzzle_result_detail', {timeId: solving_time.timeId}) }}"
                            data-row-link-target="link"
                            data-turbo-frame="modal-frame"
                            rel="nofollow"
                        >{{ solving_time.time|puzzlingTime }}</a>

                        {# Like the puzzle leaderboard: the date (with 1st try on the same line), then both gaps in two slots #}
                        {{ include('_time_date_line.html.twig', {time: solving_time}) }}
                        {% set gaps = this.gaps[loop.index0] %}
                        {% if gaps.leader is not null %}
                            {{ include('_time_gaps.html.twig', {
                                to_leader: gaps.faster is not null ? gaps.leader : null,
                                to_faster: gaps.faster ?? gaps.leader,
                            }) }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
