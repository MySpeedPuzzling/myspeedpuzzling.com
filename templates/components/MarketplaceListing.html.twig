<div {{ attributes }}>
    {# Marketplace at events (docs/features/marketplace/11-events.md): an event picked = the going sellers' listings,
       bringing first, shipping filters off #}
    {% set chosen_event = this.chosenEvent %}

    {# Filters #}
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="d-md-none">
                <button class="btn btn-outline-primary btn-sm w-100" type="button" data-bs-toggle="collapse" data-bs-target="#marketplaceFilters" aria-expanded="false">
                    <i class="bi-filter me-1"></i> {{ 'marketplace.filter.filters'|trans }}
                </button>
            </div>

            <div class="collapse mt-2 mt-md-0 d-md-block" id="marketplaceFilters">
                <div class="row g-2 align-items-end">
                    {# Search #}
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label form-label-sm mb-0"><small>{{ 'marketplace.filter.search_placeholder'|trans }}</small></label>
                        <input
                            type="text"
                            data-model="debounce(300)|search"
                            class="form-control form-control-sm"
                            value="{{ this.search }}"
                            placeholder="{{ 'marketplace.search_placeholder'|trans }}"
                        >
                    </div>

                    {# Manufacturer #}
                    <div class="col-6 col-md-3 col-lg-2 brand-filter-wrapper" data-live-ignore>
                        <label class="form-label form-label-sm mb-0"><small>{{ 'marketplace.filter.brand'|trans }}</small></label>
                        <select data-model="on(change)|manufacturer"
                                data-controller="marketplace-brand-filter"
                                class="form-select form-select-sm">
                            <option value="">{{ 'marketplace.all_brands'|trans }}</option>
                            {% for mfr in this.manufacturers %}
                                <option value="{{ mfr.manufacturer_id }}" {{ this.manufacturer == mfr.manufacturer_id ? 'selected' }}>
                                    {{ mfr.manufacturer_name }} ({{ mfr.listing_count }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Listing type #}
                    <div class="col-6 col-md-3 col-lg-1">
                        <label class="form-label form-label-sm mb-0"><small>{{ 'marketplace.filter.type'|trans }}</small></label>
                        <select data-model="listingType" class="form-select form-select-sm">
                            <option value="">{{ 'marketplace.all'|trans }}</option>
                            <option value="sell" {{ this.listingType == 'sell' ? 'selected' }}>{{ 'marketplace.listing_type.sell'|trans }}</option>
                            <option value="swap" {{ this.listingType == 'swap' ? 'selected' }}>{{ 'marketplace.listing_type.swap'|trans }}</option>
                            <option value="both" {{ this.listingType == 'both' ? 'selected' }}>{{ 'marketplace.listing_type.both'|trans }}</option>
                            <option value="free" {{ this.listingType == 'free' ? 'selected' }}>{{ 'marketplace.listing_type.free'|trans }}</option>
                        </select>
                    </div>

                    {# Price range #}
                    <div class="col-6 col-md-3 col-lg-2">
                        <label class="form-label form-label-sm mb-0"><small>{{ 'marketplace.filter.price'|trans }}</small></label>
                        <div class="d-flex gap-1">
                            <input
                                type="number"
                                data-model="debounce(300)|priceMin"
                                class="form-control form-control-sm"
                                value="{{ this.priceMin }}"
                                placeholder="{{ 'marketplace.min'|trans }}"
                                min="0"
                                step="0.01"
                            >
                            <input
                                type="number"
                                data-model="debounce(300)|priceMax"
                                class="form-control form-control-sm"
                                value="{{ this.priceMax }}"
                                placeholder="{{ 'marketplace.max'|trans }}"
                                min="0"
                                step="0.01"
                            >
                        </div>
                    </div>

                    {# Condition #}
                    <div class="col-6 col-md-3 col-lg-1">
                        <label class="form-label form-label-sm mb-0"><small>{{ 'marketplace.filter.condition'|trans }}</small></label>
                        <select data-model="condition" class="form-select form-select-sm">
                            <option value="">{{ 'marketplace.all'|trans }}</option>
                            <option value="new" {{ this.condition == 'new' ? 'selected' }}>{{ 'marketplace.condition.new'|trans }}</option>
                            <option value="like_new" {{ this.condition == 'like_new' ? 'selected' }}>{{ 'marketplace.condition.like_new'|trans }}</option>
                            <option value="normal" {{ this.condition == 'normal' ? 'selected' }}>{{ 'marketplace.condition.normal'|trans }}</option>
                            <option value="not_so_good" {{ this.condition == 'not_so_good' ? 'selected' }}>{{ 'marketplace.condition.not_so_good'|trans }}</option>
                            <option value="missing_pieces" {{ this.condition == 'missing_pieces' ? 'selected' }}>{{ 'marketplace.condition.missing_pieces'|trans }}</option>
                        </select>
                    </div>

                    {# Seller country - off while an event is chosen (the wrapper inside is live-ignored, so hide this one) #}
                    <div class="col-6 col-md-3 col-lg-3{{ chosen_event is not null ? ' d-none' }}" data-testid="marketplace-seller-country">
                    <div class="country-select-wrapper" data-live-ignore>
                        <label class="form-label form-label-sm mb-0"><small>{{ 'marketplace.filter.country'|trans }}</small></label>
                        <select
                            data-model="on(change)|sellerCountry"
                            data-controller="country-select"
                            class="form-select form-select-sm"
                        >
                            <option value="">{{ 'marketplace.all_countries'|trans }}</option>
                            {% for regionName, countries in this.countryChoicesGroupedByRegion %}
                                <optgroup label="{{ regionName }}">
                                    {% for code, name in countries %}
                                        <option value="{{ code }}" data-icon="fi fi-{{ code }}" {{ this.sellerCountry == code ? 'selected' }}>{{ name }}</option>
                                    {% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                    </div>
                    </div>

                    {# Sort - by difficulty for members, like the difficulty filter below #}
                    {% set is_member = logged_user.profile is not null and logged_user.profile.activeMembership %}
                    <div class="col-6 col-md-3 col-lg-2">
                        <label class="form-label form-label-sm mb-0"><small>{{ 'marketplace.filter.sort'|trans }}</small></label>
                        <select data-model="sort" class="form-select form-select-sm">
                            <option value="newest" {{ this.sort == 'newest' ? 'selected' }}>{{ 'marketplace.sort.newest'|trans }}</option>
                            <option value="price_asc" {{ this.sort == 'price_asc' ? 'selected' }}>{{ 'marketplace.sort.price_asc'|trans }}</option>
                            <option value="price_desc" {{ this.sort == 'price_desc' ? 'selected' }}>{{ 'marketplace.sort.price_desc'|trans }}</option>
                            <option value="name_asc" {{ this.sort == 'name_asc' ? 'selected' }}>{{ 'marketplace.sort.name_asc'|trans }}</option>
                            <option value="name_desc" {{ this.sort == 'name_desc' ? 'selected' }}>{{ 'marketplace.sort.name_desc'|trans }}</option>
                            {% if is_member %}
                                <option value="easiest" {{ this.sort == 'easiest' ? 'selected' }}>{{ 'sorting.easiest'|trans }}</option>
                                <option value="hardest" {{ this.sort == 'hardest' ? 'selected' }}>{{ 'sorting.hardest'|trans }}</option>
                            {% endif %}
                            {% if this.search is not empty %}
                                <option value="relevance" {{ this.sort == 'relevance' ? 'selected' }}>{{ 'marketplace.sort.relevance'|trans }}</option>
                            {% endif %}
                        </select>
                    </div>
                </div>

                {# Pick up at an event - only when some seller with published listings is going somewhere #}
                {% set event_choices = this.eventChoices %}
                {% if event_choices is not empty or chosen_event is not null %}
                    <div class="mt-2 mpe-filter">
                        <label class="form-label form-label-sm mb-0" for="marketplaceEventFilter">
                            <small><i class="bi bi-geo-alt me-1"></i>{{ 'marketplace_events.marketplace.filter_label'|trans }}</small>
                        </label>
                        <select id="marketplaceEventFilter" data-model="event" class="form-select form-select-sm">
                            <option value="">{{ 'marketplace_events.marketplace.any_event'|trans }}</option>
                            {% for choice in event_choices %}
                                {% set choice_event = choice.event %}
                                {% set is_chosen = chosen_event is not null and chosen_event.competitionId == choice_event.competitionId %}
                                <option value="{{ choice_event.competitionId }}" {{ is_chosen ? 'selected' }}>
                                    {{- choice_event.shortName }} — {{ event_dates(choice_event.dateFrom, choice_event.dateTo) }}
                                    {%- if choice_event.location %} · {{ choice_event.location }}{% endif %}
                                    {%- if choice.bringingCount > 0 %} — {{ 'marketplace_events.marketplace.coming'|trans({'%count%': choice.bringingCount}) }}{% endif %}
                                    {%- if choice.askCount > 0 %}{{ choice.bringingCount > 0 ? ' · ' : ' — ' }}{{ 'marketplace_events.marketplace.to_ask'|trans({'%count%': choice.askCount}) }}{% endif -%}
                                </option>
                            {% endfor %}
                            {# A marketplace event not among the (cached) options yet, from a link #}
                            {% if chosen_event is not null and event_choices|filter(c => c.event.competitionId == chosen_event.competitionId) is empty %}
                                <option value="{{ chosen_event.competitionId }}" selected>
                                    {{- chosen_event.shortName }} — {{ event_dates(chosen_event.dateFrom, chosen_event.dateTo) -}}
                                </option>
                            {% endif %}
                        </select>
                    </div>
                {% endif %}

                {# Pieces #}
                <div class="mt-2">
                    <label class="form-label form-label-sm mb-0"><small>{{ 'marketplace.filter.pieces'|trans }}</small></label>
                    {{ include('_pieces_filter_live.html.twig', {
                        id_prefix: 'marketplace-pieces',
                        pieces_model: 'pieces',
                        min_model: 'piecesMin',
                        max_model: 'piecesMax',
                        current: this.pieces,
                        min_value: this.piecesMin,
                        max_value: this.piecesMax,
                    }) }}
                </div>

                {# Difficulty (members) - the tiers of the puzzle search, "Unknown" = not rated yet #}
                <div class="mt-2">
                    <label class="form-label form-label-sm mb-0">
                        <small>{{ 'puzzle_intelligence.difficulty.filter_label'|trans }}</small>
                        {% if not is_member %}
                            <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" data-bs-toggle="modal" data-bs-target="#membersExclusiveModal">
                                <small><i class="ci-locked me-1"></i>{{ 'membership.members_exclusive_button'|trans }}</small>
                            </button>
                        {% endif %}
                    </label>
                    {{ include('_difficulty_filter_live.html.twig', {
                        id_prefix: 'marketplace-difficulty',
                        model: 'difficulty',
                        options: this.difficultyOptions,
                        selected: this.difficulty,
                        locked: not is_member,
                    }) }}
                </div>

                <div class="mt-2 d-flex flex-wrap gap-3">
                    {# Ship to my country - off while an event is chosen #}
                    {% set userCountry = this.userCountry %}
                    <div class="form-check{{ chosen_event is not null ? ' d-none' }}" data-testid="marketplace-ship-to-my-country">
                        <input
                            type="checkbox"
                            data-model="shipToMyCountry"
                            class="form-check-input"
                            id="shipToMyCountryFilter"
                            {{ this.shipToMyCountry ? 'checked' }}
                            {{ userCountry is null ? 'disabled' }}
                        >
                        <label class="form-check-label" for="shipToMyCountryFilter">
                            <small>
                                {% if userCountry is not null %}
                                    {{ 'marketplace.filter.ship_to_my_country'|trans }}
                                {% else %}
                                    {{ 'marketplace.filter.ship_to_my_country_disabled'|trans }}
                                    <a href="{{ path('edit_profile') }}">{{ 'marketplace.filter.set_country_link'|trans }}</a>
                                {% endif %}
                            </small>
                        </label>
                    </div>

                    {# My offers #}
                    {% if logged_user.profile is not null %}
                        <div class="form-check">
                            <input type="checkbox" data-model="myOffers" class="form-check-input" id="myOffersFilter" {{ this.myOffers ? 'checked' }}>
                            <label class="form-check-label" for="myOffersFilter"><small>{{ 'marketplace.my_offers'|trans }}</small></label>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Puzzle filter indicator #}
    {% if this.puzzleId is not empty %}
        {% set puzzleName = this.puzzleName %}
        {% if puzzleName is not null %}
            <div class="card mb-3 border-primary bg-primary bg-opacity-10 shadow-custom">
                <div class="card-body py-2 px-2">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-2">
                            {% set puzzleImage = this.puzzleImage %}
                            {% if puzzleImage is not null %}
                                <img src="{{ puzzleImage|puzzle_image('puzzle_small') }}" alt="" class="flex-shrink-0" {{ puzzle_image_dimensions(this.puzzleImageRatio, 55) }} style="max-width: 55px; max-height: 55px; object-fit: contain;">
                            {% endif %}
                            <small>{{ 'marketplace.showing_offers_for'|trans }} <strong>{{ puzzleName }}</strong></small>
                        </div>
                        <a href="{{ path('marketplace') }}" class="btn btn-sm btn-primary flex-shrink-0">{{ 'marketplace.show_all'|trans }}</a>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endif %}

    {# The chosen event #}
    {% if chosen_event is not null %}
        {% set counts = this.counts %}
        {% set event_route = chosen_event.reference.routeName() %}
        <div class="mpe-context mb-3" data-testid="marketplace-event-context">
            <div class="d-flex align-items-start justify-content-between gap-2">
                <div class="min-width-0">
                    <div class="mpe-context-title">
                        <i class="bi bi-geo-alt-fill me-1"></i>
                        {%- if event_route is not null -%}
                            <a href="{{ path(event_route, chosen_event.reference.routeParameters()) }}">{{ chosen_event.reference.displayName() }}</a>
                        {%- else -%}
                            {{ chosen_event.reference.displayName() }}
                        {%- endif -%}
                    </div>
                    <div class="mpe-context-meta">
                        {%- if chosen_event.countryCode is not null %}<span class="fi fi-{{ chosen_event.countryCode.name }} me-1"></span>{% endif -%}
                        {%- if chosen_event.location %}{{ chosen_event.location }} · {% endif -%}
                        {{ event_dates(chosen_event.dateFrom, chosen_event.dateTo) }}
                        {%- if counts.bringing > 0 %} · {{ 'marketplace_events.marketplace.coming'|trans({'%count%': counts.bringing}) }}{% endif -%}
                        {%- if counts.toAsk > 0 %} · {{ 'marketplace_events.marketplace.to_ask'|trans({'%count%': counts.toAsk}) }}{% endif -%}
                    </div>
                    <div class="mpe-context-meta"><i class="bi bi-people me-1"></i>{{ 'marketplace_events.marketplace.context_hint'|trans }}</div>
                </div>
                <button type="button" class="btn-close btn-close-white flex-shrink-0" aria-label="{{ 'marketplace_events.marketplace.any_event'|trans }}" title="{{ 'marketplace_events.marketplace.any_event'|trans }}" data-action="live#action" data-live-action-param="clearEvent"></button>
            </div>
            <div class="form-check mt-2 mb-0">
                <input type="checkbox" data-model="onlyBringing" class="form-check-input" id="onlyBringingFilter" {{ this.onlyBringing ? 'checked' }}>
                <label class="form-check-label" for="onlyBringingFilter">{{ 'marketplace_events.marketplace.only_bringing'|trans }}</label>
            </div>
        </div>
    {% endif %}

    {# Settings checklist for logged users with active membership (dismissable in marketplace) #}
    {% if logged_user.profile is not null and logged_user.profile.activeMembership and not this.settingsChecklistDismissed %}
        {% set sellSwapSettings = logged_user.profile.sellSwapListSettings %}
        {% if sellSwapSettings is null or (not sellSwapSettings.currency and not sellSwapSettings.customCurrency) or sellSwapSettings.shippingCountries is empty %}
            {% include 'sell-swap/_settings_checklist.html.twig' with {
                settings: sellSwapSettings,
                editUrl: path('edit_sell_swap_list_settings', {playerId: logged_user.profile.playerId, 'return': path('marketplace'), 'return_title': 'marketplace.title'|trans}),
                dismissable: true,
                dismiss_url: path('dismiss_hint'),
                dismiss_type: 'marketplace_settings_checklist',
            } only %}
        {% endif %}
    {% endif %}

    {# Results count #}
    {% set resultCount = this.resultCount %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <small class="text-muted">
            {{ resultCount == 1 ? 'marketplace.result'|trans : 'marketplace.results'|trans({'%count%': resultCount}) }}
            <span class="spinner-border spinner-border-sm ms-2 text-primary invisible" role="status" data-loading="removeClass(invisible)"></span>
        </small>
        {% if logged_user.profile is not null %}
            {% if logged_user.profile.activeMembership %}
                {% set marketplaceChainUrl = path('marketplace', {return: app.request.query.get('return'), return_title: app.request.query.get('return_title')}) %}
                <a href="{{ path('sell_swap_list_detail', {playerId: logged_user.profile.playerId, return: marketplaceChainUrl, return_title: 'marketplace.title'|trans}) }}" class="btn btn-outline-primary btn-xs">
                    {{ 'marketplace.manage_my_offers'|trans }}
                </a>
            {% else %}
                <button type="button" class="btn btn-outline-primary btn-xs" data-bs-toggle="modal" data-bs-target="#membersExclusiveModal">
                    <i class="ci-locked me-1"></i>{{ 'marketplace.manage_my_offers'|trans }}
                </button>
            {% endif %}
        {% endif %}
    </div>

    {# Results grid #}
    {% set items = this.items %}
    {% if items is empty %}
        <div class="text-center py-5">
            <i class="bi bi-shop fs-1 text-muted"></i>
            <p class="text-muted mt-2">{{ 'marketplace.no_results'|trans }}</p>
        </div>
    {% else %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            {% set marketplaceReturnUrl = this.returnUrl %}
            {# Members see each puzzle's difficulty on the image's corner (null for everyone else) #}
            {% set difficulty_tiers = this.difficultyTiers %}
            {# One list under an event: what they are bringing, then a divider, then what to ask them to bring #}
            {% set bringing_on_page = chosen_event is not null ? items|filter(i => i.bringing)|length : 0 %}
            {% for item in items %}
                {% if bringing_on_page > 0 and loop.index0 == bringing_on_page %}
                    <div class="col-12 mpe-divider" role="separator" data-testid="marketplace-event-divider">
                        <span>{{ 'marketplace_events.marketplace.divider'|trans({'%count%': this.counts.toAsk}) }}</span>
                    </div>
                {% endif %}
                <div class="col" id="marketplace-listing-{{ item.itemId }}">
                    {% include 'marketplace/_listing_card.html.twig' with {item: item, marketplaceReturnUrl: marketplaceReturnUrl, difficulty_tiers: difficulty_tiers, event: chosen_event} only %}
                </div>
            {% endfor %}
        </div>

        {# Load more #}
        {% if this.hasMoreItems %}
            <div class="text-center mt-4">
                <button
                    class="btn btn-outline-primary"
                    data-action="live#action"
                    data-live-action-param="loadMore"
                >
                    {{ 'marketplace.load_more'|trans }}
                    <span class="spinner-border spinner-border-sm ms-1 d-none" role="status" data-loading="removeClass(d-none)"></span>
                </button>
            </div>
        {% endif %}
    {% endif %}
</div>
