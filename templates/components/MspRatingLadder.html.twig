<div {{ attributes }}>
    {# Filters #}
    {% set isMember = logged_user.profile is not null and logged_user.profile.activeMembership %}
    <div class="d-flex align-items-center gap-2 mb-3">
        <div style="max-width: 200px;">
            <input
                type="text"
                data-model="debounce(300)|search"
                class="form-control form-control-sm"
                value="{{ this.search }}"
                placeholder="{{ 'puzzle_intelligence.elo.search_placeholder'|trans }}"
            >
        </div>
        {% if isMember %}
            <div class="country-select-wrapper" style="min-width: 180px; max-width: 220px;" data-live-ignore>
                <select
                    data-model="on(change)|country"
                    data-controller="country-select"
                    class="form-select form-select-sm"
                >
                    <option value="">{{ 'puzzle_intelligence.elo.all_countries'|trans }}</option>
                    {% for c in this.countries %}
                        <option value="{{ c.code }}" data-icon="fi fi-{{ c.code }}" {{ this.country == c.code ? 'selected' }}>
                            {{ c.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-check mb-0 ms-1">
                <input
                    type="checkbox"
                    data-model="on(change)|onlyFavorites"
                    class="form-check-input"
                    id="rating-only-favorites"
                    {{ this.onlyFavorites ? 'checked' }}
                >
                <label class="form-check-label text-nowrap fs-sm" for="rating-only-favorites">{{ 'puzzle_intelligence.elo.only_favorites'|trans }}</label>
            </div>
        {% else %}
            <button
                class="btn btn-outline-primary btn-sm position-relative pe-4"
                data-bs-toggle="modal"
                data-bs-target="#membersExclusiveModal"
            >
                <i class="bi-filter"></i>
                {{ 'filters.button'|trans }}
                <i class="ci-locked position-absolute fs-sm" style="right: 4px;top: 7px;"></i>
            </button>
        {% endif %}
        <div class="text-primary" style="display: none;" data-loading="show">
            <span class="spinner-border spinner-border-sm" role="status"></span>
        </div>
    </div>

    {# Ladder table #}
    {% set entries = this.entries %}
    {% if entries|length > 0 %}
        {# Same row as the puzzle leaderboards (_leaderboard_player.html.twig, _leaderboard.scss): never scrolls sideways #}
        <div class="custom-table-wrapper lb-wrapper">
            <table class="table custom-table table-hover lb-table mb-0">
                <tbody>
                    {% for entry in entries %}
                        {% set is_current_player = logged_user.profile is not null and entry.playerId == logged_user.profile.playerId %}
                        <tr id="{{ is_current_player ? 'my-rating-row' }}" class="{{ is_current_player ? 'table-active-player' }}">
                            <td class="rank"><span class="lb-rank">{{ entry.rank }}</span></td>
                            <td class="lb-solver">
                                {{ include('_leaderboard_player.html.twig', {
                                    player: entry,
                                    profile_params: {return: app.request.uri, return_title: 'puzzle_intelligence.elo.title'|trans},
                                }) }}
                            </td>
                            <td class="lb-time">
                                <span class="lb-time-value">{{ (entry.eloRating * 1000)|round }}</span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Pagination #}
        {% set totalPages = this.totalPages %}
        {% if totalPages > 1 %}
            <nav>
                <ul class="pagination flex-wrap justify-content-center mt-3 mb-0">
                    <li class="page-item {{ this.page <= 1 ? 'disabled' : '' }}">
                        <button class="page-link"
                            data-action="live#action"
                            data-live-action-param="goToPage"
                            data-live-page-param="{{ this.page - 1 }}"
                            {{ this.page <= 1 ? 'disabled' }}
                        >
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>
                    {% for p in 1..totalPages %}
                        <li class="page-item {{ p == this.page ? 'active' : '' }}">
                            <button class="page-link"
                                data-action="live#action"
                                data-live-action-param="goToPage"
                                data-live-page-param="{{ p }}"
                            >{{ p }}</button>
                        </li>
                    {% endfor %}
                    <li class="page-item {{ this.page >= totalPages ? 'disabled' : '' }}">
                        <button class="page-link"
                            data-action="live#action"
                            data-live-action-param="goToPage"
                            data-live-page-param="{{ this.page + 1 }}"
                            {{ this.page >= totalPages ? 'disabled' }}
                        >
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        {% endif %}
    {% else %}
        <div class="text-muted text-center py-4">
            <i class="bi bi-trophy fs-1 d-block mb-2 opacity-25"></i>
            {% if this.hasActiveFilters %}
                {{ 'puzzle_intelligence.elo.no_results'|trans }}
            {% else %}
                {{ 'puzzle_intelligence.elo.no_entries'|trans }}
            {% endif %}
        </div>
    {% endif %}
</div>
