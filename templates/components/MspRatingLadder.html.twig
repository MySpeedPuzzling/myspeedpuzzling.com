<div {{ attributes }}>
    {# Filters #}
    {% set isMember = logged_user.profile is not null and logged_user.profile.activeMembership %}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3 lb-rating-filters">
        <div style="flex: 1 1 9rem; max-width: 200px;">
            <input
                type="text"
                data-model="debounce(300)|search"
                class="form-control"
                value="{{ this.search }}"
                placeholder="{{ 'puzzle_intelligence.elo.search_placeholder'|trans }}"
            >
        </div>
        {% if isMember %}
            <div class="country-select-wrapper" style="flex: 1 1 11rem; max-width: 220px;" data-live-ignore>
                <select
                    data-model="on(change)|country"
                    data-controller="country-select"
                    class="form-select"
                >
                    <option value="">{{ 'puzzle_intelligence.elo.all_countries'|trans }}</option>
                    {% for c in this.countries %}
                        <option value="{{ c.code }}" data-icon="fi fi-{{ c.code }}" {{ this.country == c.code ? 'selected' }}>
                            {{ c.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            {# The same switch as on the Level / AP / Karma boards (one control, one name on every board) #}
            <div class="form-check form-switch fs-sm mb-0 d-flex align-items-center gap-2" style="min-height: 44px;">
                <input
                    type="checkbox"
                    data-model="on(change)|onlyFavorites"
                    class="form-check-input mt-0"
                    id="rating-only-favorites"
                    {{ this.onlyFavorites ? 'checked' }}
                >
                <label class="form-check-label text-nowrap py-2" for="rating-only-favorites">{{ 'xp.leaderboard.favorites_only'|trans }}</label>
            </div>
        {% else %}
            <button
                class="btn btn-outline-primary position-relative pe-4"
                data-bs-toggle="modal"
                data-bs-target="#membersExclusiveModal"
            >
                <i class="bi-filter"></i>
                {{ 'filters.button'|trans }}
                <i class="ci-locked position-absolute fs-sm" style="right: 4px;top: 7px;"></i>
            </button>
        {% endif %}
        <div class="text-primary" style="display: none;" data-loading="show">
            <span class="spinner-border spinner-border-sm" role="status"></span>
        </div>
    </div>

    {# Where am I: the viewer's place in the list on screen (its filters), the next milestone and a jump to their row #}
    {% set viewer_position = this.viewerPosition %}
    {% if viewer_position is not null %}
        {% set active_country = this.activeCountry %}
        {{ include('leaderboards/_position_line.html.twig', {
            position: viewer_position,
            scope: this.onlyFavorites
                ? 'leaderboards.position.in_favorites'|trans
                : (active_country is not null ? 'leaderboards.position.in_country'|trans({'%country%': active_country.name|upper|country_name}) : null),
            gap_text: viewer_position.targetGap is not null ? 'leaderboards.rating.gap'|trans({'%value%': viewer_position.targetGap|plain_number}) : null,
            jump_href: this.ownRowBelowFirstScreen ? '#my-rating-row' : null,
            move_html: include('leaderboards/_rating_move_line.html.twig', {move: this.viewerMove}),
        }) }}
    {% endif %}

    {# The top 100, a "⋯ N more" row revealing exactly the rows it counts, the viewer's row with 2 above and 2 below,
       and "Show more" after the last row shown - no page numbers (design-spec §4). Ranks are the list's own: equal
       ratings share the place, a search keeps the ranks of the list it searches in. #}
    {% set entries = this.entries %}
    {% if entries|length > 0 %}
        {% set gaps_before = this.gapsBefore %}
        {% set is_member = logged_user.profile is not null and logged_user.profile.activeMembership %}
        {# Same row as the puzzle leaderboards (_leaderboard_player.html.twig, _leaderboard.scss): never scrolls sideways #}
        <div class="custom-table-wrapper lb-wrapper">
            <table class="table custom-table table-hover lb-table mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="lb-rank-head">#</th>
                        <th scope="col">{{ 'puzzle_intelligence.elo.player'|trans }}</th>
                        <th scope="col" class="text-end">{{ 'puzzle_intelligence.elo.rating'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in entries %}
                        {% if gaps_before[loop.index0] is defined %}
                            {{ include('leaderboards/_gap_row.html.twig', {count: gaps_before[loop.index0], reveal: this.gapReveal, total: this.totalCount, colspan: 3, live_action: 'revealGap'}) }}
                        {% endif %}
                        {% set is_current_player = logged_user.profile is not null and entry.playerId == logged_user.profile.playerId %}
                        {# A tap anywhere on the row opens the rating card (players_card_controller.js on the page) - Ctrl/Cmd-click
                           and no JavaScript follow the name to the profile #}
                        <tr id="{{ this.rowId(entry) }}" class="lb-row-card{{ is_current_player ? ' table-active-player' }}" tabindex="-1"
                            data-action="click->players-card#open" data-players-card-url-param="{{ path('msp_rating_card', {playerId: entry.playerId}) }}">
                            <td class="rank"><span class="lb-rank">{{ entry.rank|plain_number }}</span>{{ include('leaderboards/_rating_move.html.twig', {move: entry.move, part: 'places'}) }}</td>
                            <td class="lb-solver">
                                {# The Skill tier is the icon next to the name, like on the other boards (members; a lock for others) #}
                                {{ include('_leaderboard_player.html.twig', {
                                    player: entry,
                                    highlight_query: this.search|trim,
                                    profile_params: {return: app.request.uri, return_title: 'puzzle_intelligence.elo.title'|trans},
                                }) }}
                            </td>
                            <td class="lb-time">
                                {{ include('leaderboards/_value.html.twig', {
                                    value: entry.displayRating|plain_number,
                                    value_suffix: include('leaderboards/_rating_move.html.twig', {move: entry.move, part: 'points'}),
                                    family: 'competition',
                                }) }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if this.rowsBelowCount > 0 %}
            {{ include('leaderboards/_show_more.html.twig', {count: this.showMoreCount, live_action: 'showMore'}) }}
        {% endif %}

        {# Only in the response to a tap on the gap row or "Show more": focus the first new row, announce the rows #}
        {% set announcement = this.revealAnnouncement %}
        {% if announcement is not null %}
            {{ include('leaderboards/_window_announcer.html.twig', announcement) }}
        {% endif %}
    {% else %}
        <div class="text-muted text-center py-4">
            <i class="bi bi-trophy fs-1 d-block mb-2 opacity-25"></i>
            {% if this.search|trim != '' %}
                {{ 'puzzle_intelligence.elo.no_results'|trans }}
            {% elseif this.activeCountry is not null and not this.onlyFavorites %}
                {{ 'leaderboards.rating.empty_country'|trans({'%country%': this.activeCountry.name|upper|country_name}) }}
            {% elseif this.hasActiveFilters %}
                {{ 'puzzle_intelligence.elo.no_results'|trans }}
            {% else %}
                {{ 'puzzle_intelligence.elo.no_entries'|trans }}
            {% endif %}
        </div>
    {% endif %}
</div>
