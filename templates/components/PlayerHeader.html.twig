{#
    The header of every page of one player (docs/features/player-header.md): avatar · name · #CODE · chips, the primary
    actions as buttons and every action behind ⋯, the player's pages as tabs, and the compact bar that takes its place
    once the tabs scroll away (compact_bar_controller.js, shared with the puzzle page). The owner's own form and history
    pages get a one-line strip instead ($compact).
    What a private profile shows is decided by PrivateProfileAccess (player.isPrivate = hidden from this viewer).
#}
{% set display_name = this.isHidden ? 'secret_puzzler_name'|trans : (player.playerName ?? ('#' ~ player.code|upper)) %}
{% set avatar_args = {
    player_id: player.playerId,
    name: player.playerName ?? ('#' ~ player.code),
    avatar: player.avatar,
    country_code: player.countryCode ? player.countryCode.name : null,
    country_name: player.countryCode ? player.countryCode.value : null,
    hidden: this.isHidden,
} %}

{% if compact %}
    <nav {{ attributes.defaults({class: 'player-strip'}) }} aria-label="{{ 'player_header.pages'|trans }}">
        <a class="player-strip-player" href="{{ path('player_profile', {playerId: player.playerId}) }}">
            {{ include('_player_avatar.html.twig', avatar_args) }}
            <span>{{ display_name }}</span>
        </a>
        {% if this.currentTab is not null %}
            <i class="bi bi-chevron-right player-strip-sep" aria-hidden="true"></i>
            <a class="player-strip-section" href="{{ path(this.currentTab.routeName, {playerId: player.playerId}) }}"{% if this.currentTab.nofollow %} rel="nofollow"{% endif %}>{{ this.currentTab.translationKey|trans }}</a>
        {% endif %}
    </nav>
{% else %}
    {% set return_path = app.request.requestUri %}
    <div {{ attributes.defaults({class: 'player-header'}) }} {{ stimulus_controller('compact-bar') }}>
        {# Slides in once the tabs have scrolled away: whose pages these are, the tabs and ⋯ - the results, the library
           and the statistics below can be very long #}
        <div class="compact-bar player-bar" {{ stimulus_target('compact-bar', 'bar') }} inert>
            <div class="container player-bar-inner{{ this.tabs is empty ? ' player-bar-no-tabs' }}">
                <twig:XpRing :player="player" variant="bar">{{ include('_player_avatar.html.twig', avatar_args|merge({size: 'lg'})) }}</twig:XpRing>
                <div class="compact-bar-text">
                    <div class="compact-bar-name">{{ display_name }}</div>
                    <div class="compact-bar-meta">#{{ player.code|upper }}</div>
                </div>
                {% if this.tabs is not empty %}
                    {{ include('player/_header_tabs.html.twig', {header: this}) }}
                {% endif %}
                {{ include('player/_header_actions_menu.html.twig', {header: this}) }}
            </div>
        </div>

        <div class="player-head">
            {# The XP level ring goes around the avatar - a progress arc and a "Lv 12" tab (docs/features/xp-levels/launch-2026-10.md) #}
            <div class="player-head-avatar">
                <twig:XpRing :player="player" variant="header">{{ include('_player_avatar.html.twig', avatar_args|merge({size: 'xl'})) }}</twig:XpRing>
            </div>

            <div class="player-head-info">
                {% set name_tag = heading ? 'h1' : 'div' %}
                <{{ name_tag }} class="player-head-name">{{ display_name }}</{{ name_tag }}>
                {# The country is the flag on the avatar; membership and the own privacy setting are words on this line #}
                {% set show_member = player.activeMembership and not this.isHidden %}
                {% set show_private = this.isOwnProfile and player.isPrivateProfile %}
                <div class="player-head-meta">
                    #{{ player.code|upper }}
                    {%- if show_member %}
                        <span aria-hidden="true">·</span> <a class="player-head-member" href="{{ path('membership') }}"><i class="ci-heart-filled" aria-hidden="true"></i> {{ 'player_header.member'|trans }}</a>
                    {%- endif %}
                    {%- if show_private %}
                        <span aria-hidden="true">·</span> <a class="player-head-private" href="{{ path('private_profile_viewers') }}" title="{{ 'private_profile_viewers.title'|trans }}"><i class="bi bi-incognito" aria-hidden="true"></i> {{ 'player_header.private_profile'|trans }}</a>
                    {%- endif %}
                </div>

                {# One row of at most three chips, one per family: skill tier (rank colours), MSP Rating place
                   (competition, coral), karma (community, teal). The XP level is on the avatar ring. #}
                {% set tier_pieces = constant('SpeedPuzzling\\Web\\Component\\PlayerHeader::TIER_PIECES_COUNT') %}
                {# The chips lead into the progression pages, whose back button comes back here (design-spec §3) #}
                {% set chip_return = {return: return_path, return_title: display_name} %}
                {# Karma launches with XP: the one launch switch (docs/features/karma.md) #}
                {% set show_karma = player.karma > 0 and not player.karmaOptedOut and not this.isHidden and xp_system_visible() %}
                {% if this.tierChip is not null or this.mspRatingRank is not null or show_karma %}
                    <ul class="player-head-chips">
                        {% if this.tierChip == 'tier' %}
                            {% set tier = player.skillTier.name|lower %}
                            <li>
                                <a class="player-chip player-chip-tier" style="--chip-color: var(--rank-{{ tier }})" href="{{ path('methodology', chip_return) }}#skill-tier" rel="nofollow" title="{{ 'player_header.tier_title'|trans({'%pieces%': tier_pieces}) }}">
                                    <svg class="rank-icon" width="16" height="16" aria-hidden="true"><use href="/rank-icons-sprite.svg#rank-{{ tier }}"/></svg>
                                    {{ ('puzzle_intelligence.skill.tiers.' ~ tier)|trans }}
                                </a>
                            </li>
                        {% elseif this.tierChip == 'no_tier_yet' %}
                            <li>
                                <a class="player-chip" href="{{ path('methodology', chip_return) }}#skill-tier" rel="nofollow" title="{{ 'player_header.no_tier_yet_title'|trans({'%pieces%': tier_pieces}) }}">
                                    <svg class="rank-icon" width="16" height="16" style="color: var(--rank-unknown)" aria-hidden="true"><use href="/rank-icons-sprite.svg#rank-unknown"/></svg>
                                    {{ 'player_header.no_tier_yet'|trans }}
                                </a>
                            </li>
                        {% elseif this.tierChip == 'locked' %}
                            {# The only lock a free visitor sees on a profile #}
                            <li>
                                <button type="button" class="player-chip" data-bs-toggle="modal" data-bs-target="#membersExclusiveModal" title="{{ 'player_header.tier_locked_title'|trans }}">
                                    <svg class="rank-icon" width="16" height="16" style="color: var(--rank-locked)" aria-hidden="true"><use href="/rank-icons-sprite.svg#rank-locked"/></svg>
                                    {{ 'player_header.skill_tier'|trans }}
                                </button>
                            </li>
                        {% endif %}

                        {% if this.mspRatingRank is not null %}
                            <li>
                                <a class="player-chip player-chip-competition" href="{{ path('msp_rating_ladder', chip_return) }}" rel="nofollow" title="{{ 'player_progress.msp_chip_title'|trans({'%rank%': this.mspRatingRank, '%pieces%': tier_pieces}) }}">
                                    <i class="bi bi-trophy" aria-hidden="true"></i>
                                    {{ 'player_progress.msp_chip'|trans({'%rank%': this.mspRatingRank}) }}
                                </a>
                            </li>
                        {% endif %}
                        {% if show_karma %}
                            <li>{{ include('karma/_karma_chip.html.twig', {karma: player.karma, player_id: player.playerId, own: this.isOwnProfile, return_query: chip_return}) }}</li>
                        {% endif %}
                    </ul>
                {% endif %}
            </div>

            {# The two things people come to do, then ⋯ with every action on the player #}
            <div class="player-head-actions" data-nosnippet{% if this.tabs is empty %} {{ stimulus_target('compact-bar', 'head') }}{% endif %}>
                {% if this.isOwnProfile %}
                    {{ include('player/_share_profile_button.html.twig', {class: 'btn btn-primary', label: 'player_header.share'|trans}) }}
                    <a class="btn btn-outline-primary" href="{{ path('edit_profile') }}">
                        <i class="ci-edit me-1" aria-hidden="true"></i> {{ 'menu.edit_profile'|trans }}
                    </a>
                {% else %}
                    {# Filled while the player is in the viewer's favorites - a toggle that shows its state. Below 380 px,
                       next to Message, only its star: the label is in aria-label/title (_player-header.scss) #}
                    {% if this.isInViewersFavorites %}
                        <a class="btn btn-primary player-head-favorite" data-turbo-prefetch="false" rel="nofollow" href="{{ path('remove_player_from_favorite', {playerId: player.playerId, return: return_path}) }}" title="{{ 'profile.remove_from_favorites'|trans }}" aria-label="{{ 'profile.remove_from_favorites'|trans }}">
                            <i class="bi bi-star-fill me-1" aria-hidden="true"></i> <span class="player-head-favorite-label">{{ 'player_header.favorite_on'|trans }}</span>
                        </a>
                    {% else %}
                        <a class="btn btn-outline-primary player-head-favorite" data-turbo-prefetch="false" rel="nofollow" href="{{ path('add_player_to_favorite', {playerId: player.playerId, return: return_path}) }}" title="{{ 'profile.add_to_favorites'|trans }}" aria-label="{{ 'profile.add_to_favorites'|trans }}">
                            <i class="bi bi-star me-1" aria-hidden="true"></i> <span class="player-head-favorite-label">{{ 'player_header.favorite'|trans }}</span>
                        </a>
                    {% endif %}

                    {% if this.canMessage %}
                        <a class="btn btn-outline-primary player-head-message" href="{{ path('start_conversation', {recipientId: player.playerId}) }}" data-turbo="true" data-turbo-frame="modal-frame" rel="nofollow">
                            <i class="bi bi-envelope me-1" aria-hidden="true"></i> {{ 'player_header.message'|trans }}
                        </a>
                    {% endif %}

                    {# Compare: an icon in every locale - a label fits all six only from 424 px (docs/features/player-comparison.md, D11) #}
                    {% if this.compare == 'add' %}
                        {{ include('comparison_entry/_subject_form.html.twig', {
                            action: 'add',
                            subject: this.comparisonRef,
                            form_class: 'player-head-compare',
                            button_class: 'btn btn-outline-secondary more-btn',
                            icon: 'bi-arrow-left-right',
                            label: 'player_header.compare'|trans,
                            icon_only: true,
                            new_badge: true,
                        }) }}
                    {% elseif this.compare == 'open' %}
                        <div class="player-head-compare">
                            <a class="btn btn-outline-secondary more-btn is-active" href="{{ path('comparison', {kind: 'solo'}) }}" title="{{ 'player_header.compare_open'|trans }}" aria-label="{{ 'player_header.compare_open'|trans }}">
                                <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                                {{- include('comparison_entry/_new_badge.html.twig', {on_icon: true}) }}
                            </a>
                        </div>
                    {% elseif this.compare == 'sign_in' %}
                        <div class="player-head-compare">
                            <a class="btn btn-outline-secondary more-btn" rel="nofollow" href="{{ path('login', {return: return_path}) }}" title="{{ 'player_header.compare'|trans }}" aria-label="{{ 'player_header.compare'|trans }}">
                                <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                                {{- include('comparison_entry/_new_badge.html.twig', {on_icon: true}) }}
                            </a>
                        </div>
                    {% endif %}
                {% endif %}

                {{ include('player/_header_actions_menu.html.twig', {header: this}) }}
            </div>
        </div>

        {% if this.tabs is not empty %}
            <div class="player-head-tabs" {{ stimulus_target('compact-bar', 'head') }}>
                {{ include('player/_header_tabs.html.twig', {header: this}) }}
            </div>
        {% endif %}
    </div>

    {% if logged_user.profile is not null and not this.isOwnProfile %}
        <div class="modal fade" id="blockPlayerModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form action="{{ path('block_user', {playerId: player.playerId}) }}" method="post" data-turbo="false">
                        <input type="hidden" name="_token" value="{{ csrf_token(constant('SpeedPuzzling\\Web\\Controller\\Messaging\\BlockUserController::CSRF_TOKEN_ID')) }}">
                        <div class="modal-header">
                            <h5 class="modal-title">{{ 'blocklist.modal_title'|trans }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'forms.close'|trans }}"></button>
                        </div>
                        <div class="modal-body">
                            <p>{{ 'blocklist.modal_text'|trans }}</p>
                            <p class="mb-0 text-muted small">{{ 'blocklist.modal_undo'|trans }}</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'blocklist.cancel'|trans }}</button>
                            <button type="submit" class="btn btn-danger">{{ 'blocklist.block_player'|trans }}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endif %}
{% endif %}
