{#
    "Add your country" (docs/features/players-page/README.md, stream S7). The sentence names no country on the server;
    players_country_nudge_controller.js preselects the browser's guess and names whichever country is picked.
    The close button dismisses it for good (dismiss-hint, HintType::PlayersCountryNudge).
#}
{% if this.shown %}
    <section {{ attributes.defaults({class: 'players-nudge'}) }}
        aria-labelledby="players-nudge-title"
        {{ stimulus_controller('dismiss-hint', {
            url: path('dismiss_hint'),
            type: constant('SpeedPuzzling\\Web\\Value\\HintType::PlayersCountryNudge').value,
        })|stimulus_controller('players-country-nudge', {
            named: 'players.nudge.text_named'|trans,
            unnamed: 'players.nudge.text'|trans,
        }) }}
    >
        <p class="players-nudge-text">
            <i class="bi bi-geo-alt-fill players-nudge-icon" aria-hidden="true"></i>
            <span>
                <strong id="players-nudge-title">{{ 'players.nudge.title'|trans }}</strong>
                <span {{ stimulus_target('players-country-nudge', 'sentence') }}>{{ 'players.nudge.text'|trans }}</span>
            </span>
        </p>

        <form method="post" action="{{ path('set_my_country') }}" class="players-nudge-form">
            <input type="hidden" name="_token" value="{{ csrf_token(constant('SpeedPuzzling\\Web\\Controller\\SetMyCountryController::CSRF_TOKEN_ID')) }}">
            <label class="visually-hidden" for="players-nudge-country">{{ 'players.nudge.label'|trans }}</label>
            <select id="players-nudge-country"
                    name="country"
                    class="form-select form-select-sm"
                    required
                    {% if invalid %}aria-invalid="true" aria-describedby="players-nudge-error"{% endif %}
                    {{ stimulus_target('players-country-nudge', 'select') }}
                    {{ stimulus_action('players-country-nudge', 'update', 'change') }}
            >
                <option value="">{{ 'players.nudge.choose'|trans }}</option>
                {% for country in this.countries %}
                    <option value="{{ country.name }}">{{ country.value }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-sm btn-primary">{{ 'players.nudge.save'|trans }}</button>
        </form>

        {% if invalid %}
            <p class="players-nudge-error" id="players-nudge-error">{{ 'players.nudge.unknown_country'|trans }}</p>
        {% endif %}

        <button type="button"
                class="btn-close players-nudge-close"
                aria-label="{{ 'players.nudge.dismiss'|trans }}"
                title="{{ 'players.nudge.dismiss'|trans }}"
                {{ stimulus_action('dismiss-hint', 'dismiss') }}
        ></button>
    </section>
{% endif %}
