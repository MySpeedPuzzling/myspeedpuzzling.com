<div {{ attributes }} data-loading="addClass(opacity-50)">
    {# data-nosnippet keeps UI chrome out of search snippets - Google honours it only on div, span and section #}
    <div class="puzzle-category-types mt-3 my-2" data-nosnippet>
        <button
            class="btn {{ this.category == 'solo' ? 'active' }} {{ this.soloTimesCount == 0 ? 'disabled'}}"
            data-action="live#action"
            data-live-action-param="changeResultsCategory"
            data-live-category-param="solo"
        >
            <span class="users-icons"><i class="ci-user"></i></span>
            {{ 'ladder.solo'|trans }} ({{ this.soloTimesCount }})
        </button>

        <button
            class="btn {{ this.category == 'duo' ? 'active' }} {{ this.duoTimesCount == 0 ? 'disabled'}}"
            data-action="live#action"
            data-live-action-param="changeResultsCategory"
            data-live-category-param="duo"
        >
            <span class="users-icons duo"><i class="ci-user"></i><i class="ci-user"></i></span>
            {{ 'ladder.duo'|trans }} ({{ this.duoTimesCount }})
        </button>

        <button
            class="btn {{ this.category == 'group' ? 'active' }} {{ this.groupTimesCount == 0 ? 'disabled'}}"
            data-action="live#action"
            data-live-action-param="changeResultsCategory"
            data-live-category-param="group"
        >
            <span class="users-icons team"><i class="ci-user"></i><i class="ci-user"></i><i class="ci-user"></i><i class="ci-user"></i></span>
            {{ 'ladder.team'|trans }} ({{ this.groupTimesCount }})
        </button>
    </div>

    {# The tab's numbers at a glance (docs/features/puzzle-leaderboard-chart.md): the fastest time, the median and the
       viewer's own best of this tab (with any pair or team in Pair/Team) with their rank - a tap jumps to their row.
       Without a time of their own the third number is the average. Everything here follows the selected tab. #}
    {% if this.times|length > 0 %}
        {% set has_mine = logged_user.profile is not null and this.myFastestAttempt is not null and this.myFastestAttempt.time is not null %}
        <div class="lb-stats" data-nosnippet>
            {% if this.leaderTime is not null %}
                <div class="lb-stat">
                    <span class="lb-stat-label"><i class="bi bi-1-circle" aria-hidden="true"></i>{{ 'puzzle_times.stats.fastest'|trans }}</span>
                    <span class="lb-stat-value">{{ this.leaderTime|puzzlingTime }}</span>
                </div>
            {% endif %}
            {% if this.medianTime and this.times|length > 1 %}
                <div class="lb-stat">
                    <span class="lb-stat-label"><svg class="stat-icon" width="14" height="14" aria-hidden="true"><use href="/stat-icons-sprite.svg#stat-med"/></svg>{{ 'puzzle_times.stats.median'|trans }}</span>
                    <span class="lb-stat-value">{{ this.medianTime|puzzlingTime }}</span>
                </div>
            {% endif %}
            {% if has_mine %}
                {% set mine_inner %}
                    <span class="lb-stat-label"><i class="bi bi-star" aria-hidden="true"></i>{{ ('puzzle_times.stats.my_best.' ~ this.category)|trans }}</span>
                    <span class="lb-stat-value">{{ this.myFastestAttempt.time|puzzlingTime }}</span>
                    {% if this.myRank %}
                        <span class="lb-stat-note" data-testid="my-rank">{{ 'puzzle_times.stats.rank'|trans({'%rank%': this.myRank, '%total%': this.times|length}) }}</span>
                    {% endif %}
                {% endset %}
                {% if this.myRowKey is not null %}
                    <a class="lb-stat lb-stat-mine" href="#leaderboard-row-{{ this.myRowKey }}" data-turbo="false" title="{{ 'puzzle_times.my_attempts.jump_to_me'|trans }}">{{ mine_inner }}</a>
                {% else %}
                    <div class="lb-stat lb-stat-mine">{{ mine_inner }}</div>
                {% endif %}
            {% elseif this.averageTime and this.times|length > 1 %}
                <div class="lb-stat">
                    <span class="lb-stat-label"><svg class="stat-icon" width="14" height="14" aria-hidden="true"><use href="/stat-icons-sprite.svg#stat-avg"/></svg>{{ 'puzzle_times.stats.average'|trans }}</span>
                    <span class="lb-stat-value">{{ this.averageTime|puzzlingTime }}</span>
                </div>
            {% endif %}
        </div>
    {% endif %}

    {# The viewer's own attempts in one slim block under the numbers: how they stand, their latest time, and every
       attempt with its chart behind a toggle #}
    {% if logged_user.profile is not null and this.myAttempts|length > 0 %}
        {% set myLast = this.myLastAttempt %}
        {% set myBest = this.myFastestAttempt %}
        {% set attemptsCount = this.myAttempts|length %}
        {% set isNewPb = attemptsCount > 1 and myLast.time == myBest.time %}
        {% set collapseId = 'my-attempts-collapse-' ~ this.category %}

        <div class="lb-mine fs-sm" data-nosnippet>
            {# One line of parts: latest time, how they stand, the gap to the next milestone. A part that does not fit
               moves to the next line whole - the "·" shows only between parts sharing a line (.lb-parts) #}
            <div class="lb-mine-row">
                <div class="lb-parts">
                    <div class="lb-parts-inner" data-testid="my-position">
                        <span>
                            {%- if attemptsCount == 1 -%}
                                <span class="text-muted">{{ 'puzzle_times.my_attempts.my_time'|trans }}</span>
                                <span class="tabular-nums">{{ myLast.time|puzzlingTime }}</span>
                                {%- if myLast.finishedAt is not null %} <span class="text-muted">({{ myLast.finishedAt|date('d.m.Y') }})</span>{% endif -%}
                            {%- elseif isNewPb -%}
                                <i class="bi bi-star-fill text-warning me-1"></i>{{ 'puzzle_times.my_attempts.latest_is_fastest_note'|trans }}
                            {%- else -%}
                                <span class="text-muted">{{ 'puzzle_times.my_attempts.latest_time'|trans }}</span>
                                <span class="tabular-nums">{{ myLast.time|puzzlingTime }}</span>
                                {%- if myLast.finishedAt is not null %} <span class="text-muted">({{ myLast.finishedAt|date('d.m.Y') }})</span>{% endif -%}
                            {%- endif -%}
                            {%- if myLast.isEditableBy(logged_user.profile.playerId) %}
                                {{ include('_edit_time_button.html.twig', {timeId: myLast.timeId, context: 'puzzle-detail'}) }}
                            {%- endif -%}
                        </span>
                        {% if this.myPercentile is not null %}
                            <span>{{ ('puzzle_times.my_attempts.faster_than.' ~ this.category)|trans({'%percent%': this.myPercentile}) }}</span>
                        {% endif %}
                        {% if this.myTargetRank is not null %}
                            <span>
                                {%- if this.myTargetRank == 1 -%}
                                    {{ 'puzzle_times.my_attempts.behind_fastest'|trans({'%time%': this.myTargetGap|puzzlingTime}) }}
                                {%- else -%}
                                    {{ 'puzzle_times.my_attempts.behind_top'|trans({'%time%': this.myTargetGap|puzzlingTime, '%rank%': this.myTargetRank}) }}
                                {%- endif -%}
                            </span>
                        {% endif %}
                    </div>
                </div>

                {% if attemptsCount >= 2 %}
                    <button
                        class="btn btn-link btn-sm p-0 fs-sm text-decoration-none collapsed my-attempts-toggle text-nowrap"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#{{ collapseId }}"
                        aria-expanded="false"
                        aria-controls="{{ collapseId }}"
                    >
                        {{ 'puzzle_times.my_attempts.show_all'|trans({'%count%': attemptsCount}) }}
                        <i class="bi bi-chevron-down ms-1 collapse-chevron"></i>
                    </button>
                {% endif %}
            </div>

            {% if attemptsCount >= 2 %}
            <div class="collapse mt-2" id="{{ collapseId }}">
                <div class="attempts-history-list">
                    {% for row in this.myAttemptsWithContext %}
                        <div class="attempts-history-entry {% if not loop.first %}border-top pt-2 mt-2{% endif %}">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>
                                    <i class="bi bi-calendar3 text-muted me-1"></i>
                                    {% if row.attempt.finishedAt is not null %}
                                        <span class="tabular-nums">{{ row.attempt.finishedAt|date('d.m.Y') }}</span>
                                    {% else %}
                                        <span class="text-muted">&mdash;</span>
                                    {% endif %}
                                </span>
                                <span>
                                    {% if row.isBest %}
                                        <i class="bi bi-star-fill text-warning me-1" style="font-size: 0.75rem;"></i>
                                    {% endif %}
                                    <i class="bi bi-stopwatch text-muted me-1"></i>
                                    <span class="tabular-nums">{{ row.attempt.time|puzzlingTime }}</span>
                                    {% if row.attempt.isEditableBy(logged_user.profile.playerId) %}
                                        {{ include('_edit_time_button.html.twig', {timeId: row.attempt.timeId, context: 'puzzle-detail'}) }}
                                    {% endif %}
                                </span>
                            </div>

                            {% set showPrevDelta = row.prevTime is not null %}
                            {% set showBestDelta = not row.isBest and myBest.time is not null and row.attempt.time is not null %}

                            {% if showPrevDelta or showBestDelta %}
                                <div class="fs-xs text-end" style="padding-right: 30px;">
                                    {% if showPrevDelta %}
                                        {% set delta = row.attempt.time - row.prevTime %}
                                        <div>
                                            <i class="bi bi-arrow-return-left text-muted me-1"></i>
                                            {% if delta < 0 %}
                                                <span class="text-success tabular-nums">-{{ (delta|abs)|puzzlingTime }}</span>
                                            {% elseif delta > 0 %}
                                                <span class="text-danger tabular-nums">+{{ delta|puzzlingTime }}</span>
                                            {% else %}
                                                <span class="text-muted tabular-nums">+00:00:00</span>
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                    {% if showBestDelta %}
                                        {% set delta_best = row.attempt.time - myBest.time %}
                                        <div>
                                            <i class="bi bi-star text-muted me-1" style="font-size: 0.7rem;"></i>
                                            <span class="text-danger tabular-nums">+{{ delta_best|puzzlingTime }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>

                {% if logged_user.profile.activeMembership %}
                    <twig:Chart:PlayerPuzzleTimesChart :results="this.myAttempts" bare="true" />
                {% else %}
                    <div class="player-chart-placeholder text-center mt-3">
                        <button
                            class="btn btn-outline-secondary bg-white btn-sm px-3 fs-sm mt-5 shadow-custom"
                            data-bs-toggle="modal"
                            data-bs-target="#membersExclusiveModal"
                        >
                            <i class="ci-locked me-1"></i>
                            {{ 'membership.members_exclusive_button'|trans }}
                        </button>
                    </div>
                {% endif %}
            </div>
            {% endif %}
        </div>
    {% endif %}

    {# The relax count on the left, "My pairs/teams only" and Filters on the right - they wrap below it when both do
       not fit on one line #}
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2" data-nosnippet>
        <div class="fs-sm flex-shrink-0">
            {% set categoryRelaxCount = this.category == 'solo' ? this.soloRelaxCount : (this.category == 'duo' ? this.duoRelaxCount : this.groupRelaxCount) %}
            {% if categoryRelaxCount > 0 %}
                <small class="text-muted">
                    <i class="bi bi-cup-hot"></i> {{ 'puzzle.relax_solvings_count'|trans({'%count%': categoryRelaxCount}) }}
                </small>
            {% endif %}
        </div>

        <div class="d-flex align-items-center gap-3 ms-auto">
        {# Free for every signed-in player, unlike the members' filters next to it (pairs & teams, D7) #}
        {% if logged_user.profile is not null and this.category != 'solo' and (this.times|length > 1 or this.onlyMyTeams) %}
            <div class="form-check form-switch mb-0">
                <input
                    data-model="onlyMyTeams"
                    type="checkbox"
                    class="form-check-input"
                    role="switch"
                    id="only-my-teams"
                    {{ this.onlyMyTeams ? 'checked' }}>
                <label for="only-my-teams" class="form-check-label fs-sm">{{ (this.category == 'duo' ? 'only_my_pairs_filter' : 'only_my_teams_filter')|trans }}</label>
            </div>
        {% endif %}

        {% if this.activeFiltersCount > 0 or this.availableCountries|length > 1 or this.times|length > 1 %}
            <div class="dropdown position-relative">
                {% if logged_user.profile is not null and logged_user.profile.activeMembership %}
                    <button
                        class="btn btn-outline-primary btn-sm dropdown-toggle"
                        type="button"
                        id="filtersDropdown"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        <i class="bi-filter"></i>
                        {{ 'filters.button'|trans }}
                        {% if this.activeFiltersCount > 0 %}<sup>{{ this.activeFiltersCount }}</sup>{% endif%}
                    </button>

                    <div class="dropdown-menu dropdown-menu-end filters px-3 py-0" aria-labelledby="filtersDropdown">
                        {# First tries / unboxed on every tab - a pair's or team's first try is everybody's #}
                        {% if this.times|length > 1 or this.onlyFirstTries or this.onlyUnboxed %}
                            <div class="form-check form-switch my-3">
                                <input
                                    data-model="onlyFirstTries"
                                    type="checkbox"
                                    class="form-check-input"
                                    role="switch"
                                    id="only-first-attempt"
                                    {{ this.onlyFirstTries ? 'checked' }}>
                                <label for="only-first-attempt" class="form-check-label" onclick="arguments[0].stopPropagation()">{{ 'only_first_tries_filter'|trans }}</label>
                            </div>

                            <div class="form-check form-switch my-3">
                                <input
                                    data-model="onlyUnboxed"
                                    type="checkbox"
                                    class="form-check-input"
                                    role="switch"
                                    id="only-unboxed"
                                    {{ this.onlyUnboxed ? 'checked' }}>
                                <label for="only-unboxed" class="form-check-label" onclick="arguments[0].stopPropagation()">{{ 'only_unboxed_filter'|trans }}</label>
                            </div>
                        {% endif %}

                        {% if logged_user.profile.favoritePlayers|length > 0 %}
                            <div class="form-check form-switch my-3">
                                <input
                                    data-model="onlyFavoritePlayers"
                                    type="checkbox"
                                    class="form-check-input"
                                    role="switch"
                                    id="only-favorite-players"
                                    {{ this.onlyFavoritePlayers ? 'checked' }}>
                                <label for="only-favorite-players" class="form-check-label" onclick="arguments[0].stopPropagation()">{{ 'only_favorite_players_filter'|trans }}</label>
                            </div>
                        {% endif %}

                        {% if this.availableCountries|length > 1 %}
                            <div class="my-3">
                                <select
                                    data-model="country"
                                    class="form-select"
                                    data-controller="country-autocomplete symfony--ux-autocomplete--autocomplete">
                                    <option value="" data-icon="" {{ this.country == null ? 'selected' }}>{{ 'forms.country_all'|trans }}</option>
                                    {% for availableCountry in this.countries %}
                                        <option
                                            value="{{ availableCountry.countryCode.name }}"
                                            data-icon="fi fi-{{ availableCountry.countryCode.name|lower }}"
                                            {{ this.country == availableCountry.countryCode.name ? 'selected' }}>
                                            {{ availableCountry.countryCode.value }} ({{ availableCountry.playersCount }})
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    <button
                        class="btn btn-outline-primary btn-sm position-relative pe-4"
                        data-bs-toggle="modal"
                        data-bs-target="#membersExclusiveModal"
                    >
                        <i class="bi-filter"></i>
                        {{ 'filters.button'|trans }}
                        <i class="ci-locked position-absolute fs-sm" style="right: 4px;top: 7px;"></i>
                    </button>
                {% endif %}
            </div>
        {% endif %}
        </div>
    </div>

    <div>

        {% if this.times|length > 0 %}
            <twig:Chart:PuzzleTimesChart
                results="{{ this.times }}"
                playerId="{{ logged_user.profile ? logged_user.profile.playerId : null }}"
                category="{{ this.category }}"
                :view="this.chartView"
                title=""
            />
        {% endif %}

        {# Outside the top 10 the viewer's row is a long scroll away - inside it they see it right under the chart #}
        {% if logged_user.profile is not null and this.myRowKey is not null and this.myRank is not null and this.myRank > 10 %}
            <div class="text-center fs-sm mt-3 mb-2">
                <a
                    href="#leaderboard-row-{{ this.myRowKey }}"
                    class="text-primary"
                    data-turbo="false"
                >
                    {{ 'puzzle_times.my_attempts.jump_to_me'|trans }} <i class="bi bi-arrow-down-short"></i>
                </a>
            </div>
        {% endif %}

        {% set hiddenRowsCount = this.hiddenRowsCount %}

        {# The table never scrolls sideways: the name column takes what rank and time leave and names truncate.
           A row opens the result detail (date, PPM, every attempt, chart) in the modal, loaded on demand
           (docs/features/puzzle-leaderboard-chart.md, docs/features/puzzle-result-detail.md) #}
        <div class="custom-table-wrapper lb-wrapper mt-2 {{ hiddenRowsCount > 0 ? 'mb-3' : 'mb-5' }}">
            <table class="table custom-table table-hover lb-table mb-0">
                <thead>
                <tr>
                    <th class="lb-rank-head">#</th>
                    <th>{{ 'puzzler_name'|trans }}</th>
                    <th class="text-end">{{ 'time'|trans }}</th>
                </tr>
                </thead>

                <tbody>
                {# Only the top rows are rendered (PuzzleTimes::DEFAULT_LIMIT), the rest comes with the buttons below the table.
                   A viewer further down sees their own row with its neighbours, after a "⋯ N more" row that runs "Show more" -
                   a row counting hidden rows invites a tap, so it must do something. #}
                {%~ for timeId, aggregated_solver in this.visibleTimes %}
                    {%~ if this.gapsBefore[timeId] is defined %}
                        <tr class="leaderboard-gap">
                            <td colspan="3" class="p-0">
                                <button
                                    type="button"
                                    class="btn btn-link btn-sm w-100 py-2 text-decoration-none"
                                    data-action="live#action"
                                    data-live-action-param="showMore"
                                    data-loading="addAttribute(disabled)"
                                    title="{{ 'puzzle_times.leaderboard.show_more'|trans({'%count%': this.showMoreCount}) }}"
                                >
                                    ⋯ {{ 'puzzle_times.leaderboard.hidden_rows'|trans({'%count%': this.gapsBefore[timeId]}) }}
                                </button>
                            </td>
                        </tr>
                    {%~ endif %}

                    {%~ set best = aggregated_solver[0] %}
                    {%~ set row_id = 'leaderboard-row-' ~ timeId %}
                    {%~ set is_own_row = logged_user.profile is not null and ((best.players is not defined and best.playerId is same as logged_user.profile.playerId) or (best.players is defined and best.containsPlayer(logged_user.profile.playerId))) %}
                    <tr
                        id="{{ row_id }}"
                        class="lb-row {{ is_own_row ? 'table-active-player' }}"
                        data-controller="row-link"
                        data-action="click->row-link#open"
                    >
                        <td class="rank"><span class="lb-rank">{{ this.ranks[timeId] }}</span></td>

                        <td class="lb-solver">
                            {%~ if best.players is defined %}
                                {%~ for puzzle_solver in best.players %}
                                    {{~ include('_leaderboard_player.html.twig', {player: puzzle_solver, small: true}) }}
                                {%~ endfor %}
                            {%~ else %}
                                {{~ include('_leaderboard_player.html.twig', {player: best}) }}
                            {%~ endif %}
                            {{~ include('_leaderboard_time_badges.html.twig', {
                                time: best,
                                attempts: aggregated_solver|length,
                                skip_first_try: true,
                                team_page_label: (this.category == 'duo' ? 'puzzling_team.pair_page' : 'puzzling_team.team_page')|trans,
                            }) }}
                        </td>

                        <td class="lb-time">
                            {# The row's real link - keyboard and screen readers use it, a tap anywhere on the row clicks it #}
                            <a
                                class="lb-time-value lb-detail-link"
                                href="{{ path('puzzle_result_detail', {timeId: best.timeId}) }}"
                                data-row-link-target="link"
                                data-turbo-frame="modal-frame"
                                rel="nofollow"
                                aria-label="{{ 'puzzle_times.leaderboard.result_detail'|trans({'%time%': best.time|puzzlingTime}) }}"
                            >{{ best.time|puzzlingTime }}</a>
                            {{~ include('_time_date_line.html.twig', {time: best}) }}
                            {# Gaps on one line in two fixed slots, so they line up down the table: to #1 (left), to the time above
                               (right). When the time above is #1's (rank 2), that one gap is "the time above" - right slot #}
                            {%~ set gap_to_leader = this.leaderTime is not null and best.time > this.leaderTime ? best.time - this.leaderTime : null %}
                            {%~ if gap_to_leader is not null %}
                                {{~ include('_time_gaps.html.twig', {
                                    to_leader: this.gapsToFaster[timeId] is defined ? gap_to_leader : null,
                                    to_faster: this.gapsToFaster[timeId] ?? gap_to_leader,
                                }) }}
                            {%~ endif %}
                        </td>
                    </tr>
                {%~ endfor %}

                {% if this.times|length < 1 %}
                    <tr>
                        <td colspan="3" class="text-center">{{ 'be_first_to_solve'|trans }}</td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
        </div>

        {% if hiddenRowsCount > 0 %}
            {# Buttons, not links: pages 2..N of one puzzle would be near-duplicate URLs wasting crawl budget #}
            <div class="d-flex flex-wrap justify-content-center gap-2 mb-5" data-nosnippet>
                <button
                    type="button"
                    class="btn btn-outline-primary btn-sm"
                    data-action="live#action"
                    data-live-action-param="showMore"
                    data-loading="addAttribute(disabled)"
                >
                    {{ 'puzzle_times.leaderboard.show_more'|trans({'%count%': this.showMoreCount}) }}
                    <span class="spinner-border spinner-border-sm ms-1 d-none" role="status" data-loading="action(showMore)|removeClass(d-none)"></span>
                </button>

                <button
                    type="button"
                    class="btn btn-outline-primary btn-sm"
                    data-action="live#action"
                    data-live-action-param="showAll"
                    data-loading="addAttribute(disabled)"
                >
                    {{ 'puzzle_times.leaderboard.show_all'|trans({'%count%': this.times|length}) }}
                    <span class="spinner-border spinner-border-sm ms-1 d-none" role="status" data-loading="action(showAll)|removeClass(d-none)"></span>
                </button>
            </div>
        {% endif %}
    </div>
</div>
