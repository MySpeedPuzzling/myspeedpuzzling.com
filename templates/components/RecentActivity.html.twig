{# With autoRefresh (Hub, Recent activity) it refreshes itself while somebody looks and shows "Auto-update in …"
   (controllers/live_refresh_controller.js, docs/features/live-activity-feed.md); the "… ago" labels count up everywhere
   (controllers/relative_time_controller.js) #}
<div {{ attributes.defaults({
    'data-controller': 'show-more-recent-activity relative-time' ~ (this.autoRefresh ? ' live-refresh' : ''),
    'data-relative-time-messages-value': relative_time_messages()|json_encode,
    'data-relative-time-locale-value': app.request.locale,
    'data-relative-time-server-now-value': 'now'|date('U'),
}) }}>
    {# Same row as the ladders and the profile results (_leaderboard_player, _leaderboard_time_badges, _leaderboard.scss):
       image · who solved what · time - never scrolls sideways. A tap on the row opens the result detail (docs/features/puzzle-result-detail.md) #}
    {# "Show more" expands this element with a class: Live Component lays a class changed by JavaScript back over every
       re-render, so an automatic refresh keeps the list open #}
    <div class="ra-list" data-show-more-recent-activity-target="list">
        <div class="live-refresh-anchor">
            {# An unlimited list (Recent activity, 100 rows) has no "Show more" row - its status line sits in the gap above #}
            {% if this.autoRefresh and this.showLimit == 0 %}
                {{ include('_live_refresh_status.html.twig', {placement: 'above'}) }}
            {% endif %}

            <div class="custom-table-wrapper ps-wrapper mt-4">
                <table class="table table-hover ps-table mb-0">
                    <tbody>
                        {% set row_id_prefix = this.favoritesOnly ? 'favorites' : (this.playerId is not null ? 'player' : 'all') %}
                        {% for item in this.items %}
                            {% set is_own_row = this.isOnProfile is same as false and logged_user.profile is not null and (
                                item.players is null
                                    ? item.playerId is same as logged_user.profile.playerId
                                    : logged_user.profile.playerId in item.players|map(member => member.playerId)
                            ) %}
                            {# The id lets the morph insert a new row at the top instead of rewriting every row below it #}
                            <tr id="activity-{{ row_id_prefix }}-{{ item.id }}" class="{{ is_own_row ? 'table-active-player' }} {{ this.showLimit > 0 and loop.index > this.showLimit ? 'ra-extra' }}" data-controller="row-link" data-action="click->row-link#open">
                                <td class="ps-image">
                                    <div class="position-relative">
                                        <a href="{{ path('puzzle_detail', {puzzleId: item.puzzleId}) }}">
                                            {{ include('_puzzle_row_image.html.twig', {image: item.puzzleImage, alt: 'puzzle_img_alt'|trans({'%puzzle%': item.manufacturerName ~ ' ' ~ item.puzzleName}), position: loop.index, ratio: item.puzzleImageRatio}) }}
                                        </a>

                                        {% if logged_user.profile is not null and item.isEditableBy(logged_user.profile.playerId) %}
                                            {{ include('_time_actions_menu.html.twig', {
                                                time_id: item.id,
                                                puzzle_name: item.puzzleName,
                                                can_delete: item.playerId is same as logged_user.profile.playerId,
                                            }) }}
                                        {% endif %}
                                    </div>
                                </td>

                                <td class="ps-info">
                                    {# The player leads, like on the ladders; on the player's own profile a solo time needs no
                                       name (it is theirs), so the puzzle leads there #}
                                    {% if this.isOnProfile and item.players is null %}
                                        <a class="ps-puzzle-name" href="{{ path('puzzle_detail', {puzzleId: item.puzzleId}) }}">{{ item.puzzleName }}</a>
                                        <div class="ps-puzzle-meta">
                                            {{ include('_pieces_brand.html.twig', {pieces: item.piecesCount, brand: item.manufacturerName}) }}
                                        </div>
                                    {% else %}
                                        <div class="ps-members ps-members-lead">
                                            {% if item.players is null %}
                                                {{ include('_leaderboard_player.html.twig', {player: item}) }}
                                            {% else %}
                                                {% for puzzle_solver in item.players %}
                                                    {{ include('_leaderboard_player.html.twig', {player: puzzle_solver, small: true}) }}
                                                {% endfor %}
                                            {% endif %}
                                        </div>

                                        <div class="ps-puzzle-line">
                                            <a href="{{ path('puzzle_detail', {puzzleId: item.puzzleId}) }}">{{ item.puzzleName }}</a>
                                        </div>
                                        <div class="ps-puzzle-sub">
                                            {{ include('_pieces_brand.html.twig', {pieces: item.piecesCount, brand: item.manufacturerName}) }}
                                        </div>
                                    {% endif %}

                                    <div class="ps-tags">
                                        {{ include('_leaderboard_time_badges.html.twig', {time: item, skip_first_try: true}) }}
                                    </div>
                                </td>

                                <td class="ps-time">
                                    {# The row's real link to the result detail - a tap anywhere else on the row clicks it #}
                                    <a
                                        class="ps-time-value"
                                        href="{{ path('puzzle_result_detail', {timeId: item.id}) }}"
                                        data-row-link-target="link"
                                        data-turbo-frame="modal-frame"
                                        rel="nofollow"
                                    >
                                        {%- if item.isSpeedMode -%}
                                            {{ item.time|puzzlingTime }}
                                        {%- else -%}
                                            <span class="badge rounded-pill bg-secondary"><i class="bi bi-cup-hot"></i> {{ 'badge.relax'|trans }}</span>
                                        {%- endif -%}
                                    </a>

                                    {# On a feed "1st try" says more at a glance than the PPM (that one is in the result detail) #}
                                    <time class="lb-time-date" datetime="{{ item.trackedAt|date('c') }}" data-relative-time>{{ item.trackedAt|ago }}</time>
                                    {% if item.firstAttempt %}
                                        <span class="lb-first-try-line"><span class="badge rounded-pill bg-info lb-first-try">{{ 'first_attempt'|trans }}</span></span>
                                    {% endif %}

                                    {% if item.isSpeedMode and logged_user.profile is not null and item.playerId is not same as logged_user.profile.playerId %}
                                        {% set my_best_times = this.myBestTimes %}
                                        {% if item.players is null and my_best_times[item.puzzleId] is defined %}
                                            <span class="ps-ppm">{{ 'my_time'|trans }} <span class="tabular-nums">{{ my_best_times[item.puzzleId]|puzzlingTime }}</span></span>
                                        {% endif %}
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% set has_show_more = this.showLimit > 0 and this.items|length > this.showLimit %}
        {% if has_show_more or (this.autoRefresh and this.showLimit > 0) %}
            {# "Show more" on the left, the status line on the right of the same row #}
            <div class="ra-footer mt-3">
                {% if has_show_more %}
                    <button class="btn btn-outline-primary btn-sm ra-show-more" data-action="click->show-more-recent-activity#revealRows">{{ 'show_more'|trans }}</button>
                {% endif %}

                {% if this.autoRefresh %}
                    {{ include('_live_refresh_status.html.twig', {placement: 'footer'}) }}
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>

{% macro placeholder(props) %}
    {# Same structure and row height as the rows above, so the swap does not shift the page #}
    <div class="custom-table-wrapper ps-wrapper mt-4">
        <table class="table ps-table mb-0 placeholder-glow">
            <tbody>
                {% set rowCount = props.showLimit > 0 ? props.showLimit : props.limit|default(5) %}
                {% for i in 1..rowCount %}
                    <tr>
                        <td class="ps-image">
                            <span class="rounded-2 d-inline-block" style="width: 60px; height: 60px; background: #e9ecef;"></span>
                        </td>
                        <td class="ps-info">
                            <div class="ps-members ps-members-lead"><span class="placeholder" style="width: 110px;"></span></div>
                            <div class="ps-puzzle-line"><span class="placeholder placeholder-sm" style="width: 150px;"></span></div>
                        </td>
                        <td class="ps-time">
                            <span class="placeholder" style="width: 64px;"></span>
                            <span class="ps-date"><span class="placeholder placeholder-sm" style="width: 50px;"></span></span>
                            <span class="ps-ppm"><span class="placeholder placeholder-sm" style="width: 44px;"></span></span>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if props.showLimit > 0 %}
        <button class="mt-3 btn btn-outline-primary btn-sm disabled" style="width: 100px;">
            <span class="spinner-border spinner-border-sm"></span>
        </button>
    {% endif %}
{% endmacro %}
