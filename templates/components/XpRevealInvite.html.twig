{% if unrevealedCount > 0 %}
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2 mb-3" id="xp-reveal-invite">
        <i class="bi bi-award fs-4" aria-hidden="true"></i>
        <div class="fs-sm" style="flex: 1 1 8rem;">
            {{ 'badges.reveals.invite'|trans({'%count%': unrevealedCount}) }}
        </div>
        <a href="{{ path('badge_reveals') }}" class="btn btn-sm btn-primary text-nowrap">
            {{ 'badges.reveals.invite_button'|trans({'%count%': unrevealedCount}) }}
        </a>
    </div>
{% endif %}
