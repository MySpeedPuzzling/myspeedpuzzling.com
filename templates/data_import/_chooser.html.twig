{#
    The chooser of one puzzle of an import, as ONE element (puzzle_choose.html.twig says what is on it): the page
    shows it, and an answer given on it gets the element back - the same puzzle as it stands now, or the next puzzle
    of the round (puzzles_answer.stream.html.twig) - so nothing scrolls and nothing is loaded twice. The element says
    the address of the screen it shows (`data-import-answers-url`): the script puts it in the address bar.

    Variables: what ImportPuzzleChooserController::parameters() gives; `fresh` (optional) - another puzzle than the
    answer was given on: its beginning is shown.
#}
{% set csrf = csrf_token(constant('SpeedPuzzling\\Web\\Controller\\DataImport\\ImportsHomeController::CSRF_TOKEN_ID')) %}
{% set list_group = flow ?? card.group %}
{% set decide = path('data_import_puzzles_decide', {importId: import.importId}) %}

{% macro hidden(card, csrf, flow, done) %}
    <input type="hidden" name="_token" value="{{ csrf }}">
    <input type="hidden" name="puzzle" value="{{ card.importPuzzleId }}">
    <input type="hidden" name="version" value="{{ card.decisionVersion }}">
    <input type="hidden" name="from" value="chooser">
    <input type="hidden" name="group" value="{{ card.group }}">
    {% if flow is not null %}
        <input type="hidden" name="flow" value="{{ flow }}">
        <input type="hidden" name="done" value="{{ done }}">
    {% endif %}
{% endmacro %}

<div id="import-chooser" class="mx-auto" style="max-width: 560px;" data-testid="import-puzzle-chooser" data-import-answers-url="{{ path('data_import_puzzle_choose', {importId: import.importId, importPuzzleId: card.importPuzzleId}|merge(flow is not null ? {flow: flow, done: done} : {})|merge(last is not null ? {last: last} : {})) }}"{% if fresh|default(false) %} data-import-answers-show{% endif %} data-import-flow-screen="puzzle_choose" data-choice="{{ card.choice }}" data-version="{{ card.decisionVersion }}">
    <div class="d-flex justify-content-between align-items-baseline gap-2 mb-2">
        <h1 class="h5 mb-0">{{ 'data_import.puzzles.chooser.title'|trans }}</h1>
        {% if flow is not null %}
            <span class="fs-sm text-muted text-nowrap" data-testid="import-chooser-portion">{{ 'data_import.puzzles.chooser.portion'|trans({'%done%': done|format_number, '%portion%': portion|format_number}) }}</span>
        {% endif %}
    </div>
    {% if flow is not null %}
        <div class="progress mb-2" style="height: 6px;" aria-hidden="true">
            <div class="progress-bar" style="width: {{ (min(done, portion) * 100 / portion)|round(0, 'floor') }}%;"></div>
        </div>
    {% endif %}

    {% if ask_other_pieces is not null %}
        {# A puzzle of another piece count was tapped: asked once more, by the server - only "Yes" takes it #}
        <div class="alert alert-warning" role="alert" data-testid="import-chooser-ask-pieces">
            <p class="fw-semibold mb-2">{{ 'data_import.puzzles.pieces_differ_confirm'|trans({'%file%': card.piecesCount|format_number, '%puzzle%': ask_other_pieces.piecesCount|format_number}) }}</p>
            {{ include('data_import/_catalogue_puzzle.html.twig', {puzzle: ask_other_pieces, file_pieces: card.piecesCount}, with_context = false) }}
            <form action="{{ decide }}" method="post" data-import-answer class="d-flex flex-wrap gap-2 mt-3">
                {{ _self.hidden(card, csrf, flow, done) }}
                <input type="hidden" name="catalogue" value="{{ ask_other_pieces.puzzleId }}">
                <input type="hidden" name="confirmed_other_pieces" value="1">
                <button type="submit" name="action" value="catalogue" class="btn btn-primary text-wrap" style="min-height: 44px;" data-testid="import-chooser-ask-pieces-yes">
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.chooser.confirm_yes'|trans }}
                </button>
                <a href="{{ path('data_import_puzzle_choose', {importId: import.importId, importPuzzleId: card.importPuzzleId}|merge(flow is not null ? {flow: flow, done: done} : {})) }}" class="btn btn-outline-secondary d-inline-flex align-items-center text-wrap" style="min-height: 44px;" data-testid="import-chooser-ask-pieces-no">{{ 'data_import.puzzles.chooser.confirm_no'|trans }}</a>
            </form>
        </div>
    {% endif %}

    {# The file's puzzle, as the file wrote it #}
    <div class="card card-body shadow-sm mb-3">
        {{ include('data_import/_import_puzzle_said.html.twig', {card: card, heading: 'h2'}, with_context = false) }}

        {% if rows is not empty %}
            <details class="mt-2" data-testid="import-chooser-rows" open>
                <summary class="fs-sm text-muted" style="min-height: 32px; cursor: pointer;">{{ 'data_import.puzzles.chooser.rows_title'|trans }}</summary>
                {% for row in rows %}
                    <a href="{{ path('data_import_row', {importId: import.importId, rowId: row.rowId, return: app.request.isMethod('GET') ? app.request.requestUri : path('data_import_puzzle_choose', {importId: import.importId, importPuzzleId: card.importPuzzleId})}) }}" class="d-block text-decoration-none text-body" data-testid="import-chooser-row">
                        {{ include('data_import/_parsed_row.html.twig', {row: row}, with_context = false) }}
                    </a>
                {% endfor %}
            </details>
        {% endif %}
    </div>

    {% if card.isDecided %}
        <div class="alert alert-success d-flex flex-column gap-2" data-testid="import-chooser-decided">
            <div class="fw-medium"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.chooser.decided_as'|trans }} {{ ('data_import.puzzles.card.state.' ~ card.choice)|trans }}</div>
            {% if card.decided is not null %}
                {{ include('data_import/_catalogue_puzzle.html.twig', {puzzle: card.decided, file_pieces: card.piecesCount}, with_context = false) }}
            {% endif %}
            <form action="{{ decide }}" method="post" data-import-answer>
                {{ _self.hidden(card, csrf, flow, done) }}
                <button type="submit" name="action" value="undecided" class="btn btn-outline-secondary text-wrap" style="min-height: 44px;" data-testid="import-chooser-take-back">
                    <i class="bi bi-x-lg me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.chooser.take_back'|trans }}
                </button>
            </form>
        </div>
    {% endif %}

    {# What it could be: the whole card is the button - a tap is the answer, nothing is chosen beforehand #}
    <h2 class="h6 mt-3 mb-0">{{ 'data_import.puzzles.chooser.candidates_title'|trans }}</h2>
    {{ include('data_import/_explain.html.twig', {text: 'data_import.explain.pick_the_right_one'|trans, fold: true, summary: 'data_import.explain.pick_summary'|trans, testid: 'import-explain-pick'}, with_context = false) }}
    {% if card.candidates|filter(puzzle => puzzle.piecesDiffer or puzzle.brandDiffers)|length > 0 %}
        {{ include('data_import/_explain.html.twig', {text: 'data_import.explain.another_brand_or_pieces'|trans, fold: true, summary: 'data_import.explain.another_brand_summary'|trans, testid: 'import-explain-another-brand'}, with_context = false) }}
    {% endif %}
    {% if card.candidates is empty %}
        <p class="fs-sm text-muted" data-testid="import-chooser-no-candidates">{{ 'data_import.puzzles.chooser.no_candidates'|trans }}</p>
    {% endif %}
    <div data-testid="import-chooser-candidates">
        {% for puzzle in card.candidates %}
            {% set is_chosen = card.decided is not null and card.decided.puzzleId == puzzle.puzzleId %}
            <form action="{{ decide }}" method="post" data-import-answer class="mb-2">
                {{ _self.hidden(card, csrf, flow, done) }}
                <input type="hidden" name="catalogue" value="{{ puzzle.puzzleId }}">
                <button type="submit" name="action" value="catalogue"
                        class="btn {{ is_chosen ? 'btn-outline-success' : 'btn-outline-secondary' }} w-100 p-3 text-body bg-body shadow-sm" style="min-height: 44px; white-space: normal;"
                        data-testid="import-chooser-candidate" data-puzzle-id="{{ puzzle.puzzleId }}">
                    {{ include('data_import/_catalogue_puzzle.html.twig', {puzzle: puzzle, file_pieces: card.piecesCount, large: true}, with_context = false) }}
                    {% if is_chosen %}
                        <span class="d-block mt-2 fw-semibold text-success"><i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.chooser.chosen'|trans }}</span>
                    {% endif %}
                </button>
            </form>
        {% endfor %}
    </div>

    {# None of these: search our database, keep it just for me, don't import it - open by itself when nothing fits
       and when a search was made #}
    <details class="card card-body shadow-sm my-3" data-testid="import-chooser-none"{% if found is not null or card.candidates is empty %} open{% endif %}>
        <summary class="fw-semibold d-flex align-items-center" style="min-height: 44px; cursor: pointer;">
            <i class="bi bi-slash-circle me-2" aria-hidden="true"></i>{{ 'data_import.puzzles.chooser.none_title'|trans }}
        </summary>
        {# The search: a POST into its own frame - the typed text never stands in an address #}
        <div class="mb-3" data-testid="import-chooser-search">
            <h2 class="h6">{{ 'data_import.puzzles.chooser.search_title'|trans }}</h2>
            <form action="{{ path('data_import_puzzle_search', {importId: import.importId, importPuzzleId: card.importPuzzleId}) }}" method="post" data-turbo-frame="import-puzzle-search" role="search">
                <input type="hidden" name="_token" value="{{ csrf }}">
                {% if flow is not null %}
                    <input type="hidden" name="flow" value="{{ flow }}">
                    <input type="hidden" name="done" value="{{ done }}">
                {% endif %}
                <label for="import-puzzle-search-input" class="form-label fs-sm text-muted mb-1">{{ 'data_import.puzzles.chooser.search_label'|trans }}</label>
                <div class="d-flex gap-2">
                    <input type="search" id="import-puzzle-search-input" name="search" value="{{ searched ?? card.name }}" class="form-control" style="font-size: 16px; min-height: 44px;" maxlength="200" autocomplete="off" enterkeyhint="search" data-testid="import-chooser-search-input">
                    <button type="submit" class="btn btn-outline-primary flex-shrink-0" style="min-height: 44px;" data-testid="import-chooser-search-button">
                        <i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">{{ 'data_import.puzzles.chooser.search_button'|trans }}</span>
                    </button>
                </div>
            </form>

            <turbo-frame id="import-puzzle-search" target="_top">
                {% if found is not null %}
                    <div class="mt-3" data-testid="import-chooser-search-results">
                        {% if search_too_short %}
                            <p class="fs-sm text-muted mb-0" data-testid="import-chooser-search-short">{{ 'data_import.puzzles.chooser.search_short'|trans }}</p>
                        {% elseif found is empty %}
                            <p class="fs-sm text-muted mb-0" data-testid="import-chooser-search-empty">{{ 'data_import.puzzles.chooser.search_empty'|trans }}</p>
                        {% endif %}
                        {% for puzzle in found %}
                            <form action="{{ decide }}" method="post" data-import-answer class="mb-2">
                                {{ _self.hidden(card, csrf, flow, done) }}
                                <input type="hidden" name="catalogue" value="{{ puzzle.puzzleId }}">
                                <button type="submit" name="action" value="catalogue" class="btn btn-outline-primary w-100 p-2 text-body bg-body" style="min-height: 44px; white-space: normal;"
                                        data-testid="import-chooser-search-result" data-puzzle-id="{{ puzzle.puzzleId }}">
                                    {{ include('data_import/_catalogue_puzzle.html.twig', {puzzle: puzzle, file_pieces: card.piecesCount}, with_context = false) }}
                                </button>
                            </form>
                        {% endfor %}
                    </div>
                {% endif %}
            </turbo-frame>
        </div>
        <form action="{{ decide }}" method="post" data-import-answer class="mt-2">
            {{ _self.hidden(card, csrf, flow, done) }}
            <button type="submit" name="action" value="unlisted" class="btn btn-outline-primary w-100 text-wrap" style="min-height: 44px;" data-testid="import-chooser-unlisted">
                <i class="bi bi-bookmark me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.chooser.unlisted'|trans }}
            </button>
            <div class="mt-1 mb-2">
                {{ include('data_import/_explain.html.twig', {text: 'data_import.explain.unlisted'|trans, more: 'data_import.explain.unlisted_more'|trans, testid: 'import-explain-unlisted'}, with_context = false) }}
            </div>
            <button type="submit" name="action" value="left_out" class="btn btn-outline-secondary w-100 text-wrap" style="min-height: 44px;" data-testid="import-chooser-leave-out">
                <i class="bi bi-dash-circle me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.chooser.leave_out'|trans }}
            </button>
            <p class="fs-sm text-muted mt-1 mb-0">{{ 'data_import.puzzles.chooser.leave_out_hint'|trans }}</p>
        </form>
    </details>

    <div class="d-flex flex-wrap gap-2 mb-2">
        {% if flow is not null %}
            {# "Later": the next puzzle - nothing is saved, this one still waits #}
            <a href="{{ path('data_import_puzzle_next', {importId: import.importId, group: flow, after: card.importPuzzleId, done: done}|merge(last is not null ? {last: last} : {})) }}" class="btn btn-outline-primary flex-grow-1 d-flex align-items-center justify-content-center" style="min-height: 44px;" rel="nofollow" data-testid="import-chooser-skip">
                {{ 'data_import.puzzles.chooser.skip'|trans }}<i class="bi bi-chevron-right ms-1" aria-hidden="true"></i>
            </a>
        {% endif %}
    </div>
    <div class="d-flex flex-column align-items-start mb-4">
        {% if last is not null %}
            {# The puzzle decided just before: its own screen says what was decided and takes it back #}
            <a href="{{ path('data_import_puzzle_choose', {importId: import.importId, importPuzzleId: last, flow: flow, done: max(0, done - 1)}) }}" class="btn btn-link px-0 d-inline-flex align-items-center" style="min-height: 44px;" rel="nofollow" data-testid="import-chooser-undo-last">
                <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.bulk.chooser.undo_last'|trans }}
            </a>
        {% endif %}
        {% if flow is not null %}
            <a href="{{ path('data_import_puzzle_group', {importId: import.importId, group: flow}|merge(done > 0 ? {done: done} : {})) }}" class="btn btn-link px-0 d-inline-flex align-items-center" style="min-height: 44px;" data-testid="import-chooser-back">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.bulk.choose.stop'|trans }}
            </a>
        {% else %}
            <a href="{{ path('data_import_puzzle_group', {importId: import.importId, group: list_group}|merge(list_group in ['found', 'remembered'] ? {} : {page: 1})) }}" class="btn btn-link px-0 d-inline-flex align-items-center" style="min-height: 44px;" data-testid="import-chooser-back">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.chooser.back_to_list'|trans }}
            </a>
        {% endif %}
    </div>

    {# A tap on a puzzle's card is the answer here - the screen has no other primary button #}
    {{ include('data_import/_flow_footer.html.twig', {import: import}, with_context = false) }}
</div>
