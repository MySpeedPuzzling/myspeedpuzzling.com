{#
    "I'm done with this import" (docs/features/data-import/upload.md "Finished"): what it means, and the button - a
    plain form, the confirmation is the text above it. Offered for an import that took rows (it can not be discarded)
    while nothing of it is running. Variables: import_id, csrf.
#}
<div class="card card-body shadow-sm mb-3" data-testid="import-finish">
    <h2 class="h5">{{ 'data_import.finish.title'|trans }}</h2>
    <p class="fs-sm text-muted">{{ 'data_import.finish.means'|trans }}</p>
    <form action="{{ path('data_import_done', {importId: import_id}) }}" method="post">
        <input type="hidden" name="_token" value="{{ csrf }}">
        <button type="submit" class="btn btn-outline-primary text-wrap" style="min-height: 44px;" data-testid="import-finish-button">
            <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>{{ 'data_import.finish.button'|trans }}
        </button>
    </form>
</div>
