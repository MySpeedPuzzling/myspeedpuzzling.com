{#
    One import on Imports home (docs/features/data-import/guided-flow.md §5.1): its name, ONE status - a sentence a
    line, never chained - and ONE button. No badge, no size, no date line. Variables: card
    (Services\DataImport\ImportHomeCard), csrf, results_a_day.
#}
{% set import = card.import %}
{% set button_class = card.quiet ? 'btn-outline-primary' : 'btn-primary' %}
<div class="card card-body shadow-sm p-3" data-testid="data-import" data-import-id="{{ import.importId }}" data-route="{{ card.route }}">
    <a href="{{ path('data_import_detail', {importId: import.importId}) }}" class="fw-semibold text-break text-reset d-flex align-items-center" style="min-height: 44px;" data-testid="data-import-name">
        {{- import.fileName != '' ? import.fileName : 'data_import.google.unnamed'|trans -}}
    </a>
    <ul class="list-unstyled mb-3" data-testid="data-import-status">
        {% for line in card.lines %}
            <li data-testid="data-import-status-line" data-line="{{ line.key|split('.')|last }}">{{ include('data_import/_flow_text.html.twig', {text: line}, with_context = false) }}</li>
        {% endfor %}
        {% if card.keptUntil is not null %}
            <li class="fs-sm text-muted" data-testid="data-import-kept-until">{{ 'data_import.after.home.kept_until'|trans({'%date%': card.keptUntil|format_date('long')}) }}</li>
        {% endif %}
    </ul>
    {% if card.lines|filter(line => line.key == 'data_import.after.home.tomorrow') is not empty %}
        {# The daily limit, without its first sentence (guided-flow.md §12) #}
        {{ include('data_import/_explain.html.twig', {text: 'data_import.explain.daily_limit_rest'|trans, testid: 'import-explain-daily-limit'}, with_context = false) }}
    {% endif %}
    {% if card.route == constant('SpeedPuzzling\\Web\\Services\\DataImport\\ImportHomeCard::ROUTE_FINISH_UPLOAD') %}
        {# The file may be up although the confirmation never arrived - checked again here #}
        <form action="{{ path(card.route, card.parameters) }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf }}">
            <button type="submit" class="btn {{ button_class }} w-100 text-wrap" style="min-height: 48px;" data-testid="finish-upload">
                {{- include('data_import/_flow_text.html.twig', {text: card.button}, with_context = false) -}}
            </button>
        </form>
    {% else %}
        <a href="{{ path(card.route, card.parameters) }}" class="btn {{ button_class }} w-100 text-wrap d-flex align-items-center justify-content-center" style="min-height: 48px;" data-testid="data-import-button" rel="nofollow">
            {{- include('data_import/_flow_text.html.twig', {text: card.button}, with_context = false) -}}
        </a>
    {% endif %}
</div>
