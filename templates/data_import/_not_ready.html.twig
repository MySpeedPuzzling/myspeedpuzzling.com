{#
    "Not added this time" (docs/features/data-import/guided-flow.md §5.9): what is not ready to be added yet, in
    plain words, each line with a verb that leads to where the player settles it. Calm - no warning colour.
    Variables: add (ImportAddSummary), import_id, daily_limit (optional - shown with the rows that wait for tomorrow).
#}
{% if add.hasNotReady or add.overDailyLimit > 0 %}
    <ul class="list-unstyled fs-sm mb-0" data-testid="import-not-ready">
        {% if add.undecided > 0 %}
            <li class="d-flex justify-content-between align-items-center gap-2 py-1" data-testid="not-ready-undecided" data-rows="{{ add.undecided }}">
                <span><i class="bi bi-puzzle me-2" aria-hidden="true"></i>{{ 'data_import.add.not_ready.undecided'|trans({'%number%': add.undecided|format_number}) }}</span>
                <a href="{{ path('data_import_puzzles', {importId: import_id}) }}" class="d-inline-flex align-items-center flex-shrink-0 text-nowrap fw-medium" style="min-height: 44px;">
                    {{ 'data_import.add_review.verb.match'|trans }}<i class="bi bi-chevron-right ms-1" aria-hidden="true"></i>
                </a>
            </li>
        {% endif %}
        {% if add.needsExactDay > 0 %}
            <li class="py-2" data-testid="not-ready-exact-day" data-rows="{{ add.needsExactDay }}">
                <i class="bi bi-calendar-x me-2" aria-hidden="true"></i>{{ 'data_import.add.not_ready.needs_exact_day'|trans({'%number%': add.needsExactDay|format_number}) }}
                {{ include('data_import/_explain.html.twig', {text: 'data_import.explain.no_date'|trans, fold: true, testid: 'import-explain-no-date'}, with_context = false) }}
            </li>
        {% endif %}
        {% if add.needLook > 0 %}
            <li class="d-flex justify-content-between align-items-center gap-2 py-1" data-testid="not-ready-need-look" data-rows="{{ add.needLook }}">
                <span><i class="bi bi-eye me-2" aria-hidden="true"></i>{{ 'data_import.add.not_ready.need_look'|trans({'%number%': add.needLook|format_number}) }}</span>
                <a href="{{ path('data_import_to_fix', {importId: import_id}) }}" class="d-inline-flex align-items-center flex-shrink-0 text-nowrap fw-medium" style="min-height: 44px;">
                    {{ 'data_import.add_review.verb.look'|trans }}<i class="bi bi-chevron-right ms-1" aria-hidden="true"></i>
                </a>
            </li>
        {% endif %}
        {# A sheet whose columns were just saved is being read again - that is not "not set up" #}
        {% set sheets_not_set_up = add.sheetsNotSetUp - add.sheetsBeingRead %}
        {% if sheets_not_set_up > 0 %}
            <li class="d-flex justify-content-between align-items-center gap-2 py-1" data-testid="not-ready-sheets" data-sheets="{{ sheets_not_set_up }}">
                <span><i class="bi bi-columns-gap me-2" aria-hidden="true"></i>{{ 'data_import.add.not_ready.sheets'|trans({'%number%': sheets_not_set_up|format_number}) }}</span>
                <a href="{{ path('data_import_columns', {importId: import_id}) }}" class="d-inline-flex align-items-center flex-shrink-0 text-nowrap fw-medium" style="min-height: 44px;">
                    {{ 'data_import.add_review.verb.check'|trans }}<i class="bi bi-chevron-right ms-1" aria-hidden="true"></i>
                </a>
            </li>
        {% endif %}
        {% if add.notAdded > 0 %}
            <li class="d-flex justify-content-between align-items-center gap-2 py-1" data-testid="not-ready-not-added" data-rows="{{ add.notAdded }}">
                <span><i class="bi bi-chat-left-dots me-2" aria-hidden="true"></i>{{ 'data_import.add.not_ready.not_added'|trans({'%number%': add.notAdded|format_number}) }}</span>
                <a href="{{ path('data_import_not_added', {importId: import_id}) }}" class="d-inline-flex align-items-center flex-shrink-0 text-nowrap fw-medium" style="min-height: 44px;">
                    {{ 'data_import.add_review.verb.answer'|trans }}<i class="bi bi-chevron-right ms-1" aria-hidden="true"></i>
                </a>
            </li>
        {% endif %}
        {% if add.overDailyLimit > 0 %}
            <li class="py-2 text-muted" data-testid="not-ready-daily-limit" data-rows="{{ add.overDailyLimit }}">
                <i class="bi bi-calendar-day me-2" aria-hidden="true"></i>{{ 'data_import.add.not_ready.over_daily_limit'|trans({'%number%': add.overDailyLimit|format_number, '%limit%': (daily_limit|default(2000))|format_number}) }}
            </li>
        {% endif %}
    </ul>
{% endif %}
