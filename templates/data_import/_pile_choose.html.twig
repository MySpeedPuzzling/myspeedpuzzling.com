{#
    "Pick the right one" (docs/features/data-import/guided-flow.md §6.2) - where a round of one puzzle per screen
    starts and rests: how many the round just did, how many are left, how many rows the next round settles (the
    puzzles with the most rows come first), ONE primary ("Do the next 20"), what is ready to be added, and - folded,
    never beside the primary - the one bulk answer of this pile: "Keep the others just for me". It matches nothing:
    the puzzles are kept privately and each can still be picked later.

    Variables (the screen's own): import, overview, open, total, done, round, portion, add, live, cards, page, pages,
    csrf, group, group_title, is_running, continue, back_to_summary.
#}
{% set ready = add.canAdd and add.runningBatchId is null and not add.paused ? add.toAdd : 0 %}
<h1 class="h3 mb-2">{{ group_title }}</h1>
{{ include('data_import/_explain.html.twig', {text: 'data_import.explain.pick_the_right_one'|trans, testid: 'import-explain-pick'}, with_context = false) }}

<turbo-frame id="import-puzzle-list-live" data-import-live target="_top">
    {% if is_running %}
        {{ include('data_import/_pile_working.html.twig', {open: open}, with_context = false) }}
    {% elseif open > 0 %}
        <div class="mb-3" data-testid="import-pile-rest" data-done="{{ done }}" data-open="{{ open }}">
            {% if done > 0 %}
                <p class="alert alert-success fs-sm mb-2" data-testid="import-pile-done"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.bulk.choose.done'|trans({'%count%': done, '%number%': done|format_number}) }}</p>
            {% endif %}
            <p class="fw-medium mb-1" data-testid="import-pile-left">{{ 'data_import.puzzles.bulk.choose.left'|trans({'%count%': open, '%number%': open|format_number}) }}</p>
            {% if round.puzzles > 0 %}
                <p class="fs-sm text-muted mb-0" data-testid="import-pile-round" data-rows="{{ round.rows }}">{{ 'data_import.puzzles.bulk.choose.next_rows'|trans({'%count%': round.puzzles, '%number%': round.puzzles|format_number, '%rows%': round.rows|format_number}) }}</p>
            {% endif %}
        </div>
    {% else %}
        <p class="alert alert-success fs-sm" data-testid="import-pile-nothing-left"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.bulk.nothing_left'|trans }}</p>
    {% endif %}
</turbo-frame>

{% if open > 0 and not is_running %}
    {{ include('data_import/_flow_footer.html.twig', {
        import: import,
        ready: ready,
        hint: 'data_import.puzzles.list.one_by_one_hint'|trans,
        primary: {
            label: done > 0 ? 'data_import.puzzles.bulk.choose.more'|trans({'%number%': min(portion, open)|format_number}) : (open < portion ? 'data_import.puzzles.list.next_n'|trans({'%count%': open, '%number%': open|format_number}) : 'data_import.puzzles.list.next_20'|trans),
            url: path('data_import_puzzle_next', {importId: import.importId, group: group}),
            icon: 'bi-play-fill', nofollow: true, testid: 'import-puzzle-next-20',
        },
        back: {label: 'data_import.puzzles.bulk.choose.stop'|trans, url: summary_url},
    }, with_context = false) }}

    {# The one bulk answer of this pile - folded: it is never a button beside "Do the next 20" #}
    <details class="mt-3" data-testid="import-pile-keep-rest">
        <summary class="d-flex align-items-center" style="min-height: 44px; cursor: pointer;">
            <i class="bi bi-chevron-right me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.bulk.choose.keep_rest'|trans({'%count%': open, '%number%': open|format_number}) }}
        </summary>
        {{ include('data_import/_explain.html.twig', {text: 'data_import.explain.unlisted'|trans, more: 'data_import.explain.unlisted_more'|trans, testid: 'import-explain-unlisted'}, with_context = false) }}
        <form action="{{ path('data_import_puzzles_decide', {importId: import.importId}) }}" method="post" data-import-answer data-testid="import-pile-answer" data-pile="choose" data-open="{{ open }}">
            <input type="hidden" name="_token" value="{{ csrf }}">
            <input type="hidden" name="pile" value="choose">
            <input type="hidden" name="choice" value="unlisted">
            <input type="hidden" name="revision" value="{{ live.revision }}">
            <button type="submit" name="action" value="all_in_pile" class="btn btn-outline-primary w-100 text-wrap" style="min-height: 44px;" data-testid="import-pile-keep-rest-button"{% if overview.searching > 0 or live.working %} disabled{% endif %}>
                <i class="bi bi-bookmark me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.bulk.choose.keep_rest_button'|trans }}
            </button>
        </form>
    </details>
{% elseif is_running %}
    {{ include('data_import/_flow_footer.html.twig', {import: import, ready: ready, back: back_to_summary}, with_context = false) }}
{% else %}
    {{ include('data_import/_flow_footer.html.twig', {import: import, primary: continue, continue_after: continue_after}, with_context = false) }}
{% endif %}

{% if total > 0 %}
    <details class="mt-2" data-testid="import-pile-see"{% if list_open|default(false) %} open{% endif %}>
        <summary class="d-flex align-items-center" style="min-height: 44px; cursor: pointer;">
            <i class="bi bi-chevron-right me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.bulk.see_all'|trans({'%number%': total|format_number}) }}
        </summary>
        <div class="mt-2">{{ include('data_import/_pile_list.html.twig') }}</div>
    </details>
{% endif %}
