{#
    "Ready to add" on the import's page and on the Puzzles summary (docs/features/data-import/adding-screens.md
    "Ready to add"): how many results, puzzles the player owns and wish-list puzzles are ready, with "Review and
    add"; what is not ready yet with the places to settle it; what the import added so far. While adding is paused
    by the safety switch the card says so calmly and shows no button; while an "Add" runs it leads to its page.
    Variables: add (ImportAddSummary), import_id.
#}
{% set state = add.runningBatchId is not null ? 'adding' : (add.paused ? 'paused' : (add.rowsToTake > 0 ? 'ready' : 'nothing')) %}
{% if add.canAdd and (add.rowsReady > 0 or add.hasNotReady or add.hasAdded or add.runningBatchId is not null) %}
    <div class="card card-body shadow-sm mb-3" data-testid="import-ready" data-state="{{ state }}" data-rows="{{ add.rowsToTake }}">
        <h2 class="h6 mb-2"><i class="bi bi-plus-circle me-1" aria-hidden="true"></i>{{ 'data_import.add.ready.title'|trans }}</h2>

        {% if add.paused %}
            <p class="fs-sm mb-2" data-testid="import-ready-paused"><i class="bi bi-pause-circle me-1" aria-hidden="true"></i>{{ 'data_import.add.paused'|trans }}</p>
        {% endif %}

        {% if add.runningBatchId is not null %}
            <p class="fs-sm mb-2">{{ 'data_import.add.ready.adding'|trans }}</p>
            <a href="{{ path('data_import_batch', {importId: import_id, batchId: add.runningBatchId}) }}" class="btn btn-outline-primary w-100 text-wrap d-flex align-items-center justify-content-center" style="min-height: 44px;" data-testid="import-ready-follow">
                <i class="bi bi-activity me-1" aria-hidden="true"></i>{{ 'data_import.add.ready.follow'|trans }}
            </a>
        {% elseif add.rowsToTake > 0 %}
            <p class="fw-medium mb-2" data-testid="import-ready-counts">
                {{ 'data_import.add.counts'|trans({'%results%': add.results|format_number, '%owned%': add.owned|format_number, '%wish_list%': add.wishList|format_number}) }}
            </p>
            {% if not add.paused %}
                <a href="{{ path('data_import_add', {importId: import_id}) }}" class="btn btn-primary w-100 text-wrap d-flex align-items-center justify-content-center" style="min-height: 48px;" data-testid="import-review-and-add">
                    <i class="bi bi-check2-square me-1" aria-hidden="true"></i>{{ 'data_import.add.ready.review'|trans }}
                </a>
            {% endif %}
        {% else %}
            <p class="fs-sm text-muted mb-0" data-testid="import-ready-nothing">{{ 'data_import.add.ready.nothing'|trans }}</p>
        {% endif %}

        {% if add.hasNotReady or add.overDailyLimit > 0 %}
            <p class="fs-sm fw-medium mt-3 mb-0">{{ 'data_import.add.not_ready.title'|trans }}</p>
            {{ include('data_import/_not_ready.html.twig', {add: add, import_id: import_id}) }}
        {% endif %}

        {% if add.hasAdded %}
            <p class="fs-sm mt-3 mb-0" data-testid="import-ready-added">
                {{ 'data_import.add.added_so_far'|trans({'%results%': add.resultsAdded|format_number, '%owned%': add.collectionItemsAdded|format_number, '%wish_list%': add.wishListItemsAdded|format_number}) }}
                <a href="{{ path('data_import_added', {importId: import_id}) }}" class="d-inline-flex align-items-center" style="min-height: 44px;">{{ 'data_import.add.see_added'|trans }}</a>
            </p>
        {% endif %}
    </div>
{% endif %}
