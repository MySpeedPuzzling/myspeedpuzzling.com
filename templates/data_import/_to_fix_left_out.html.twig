{#
    The rows the player chose not to import, under "Rows we could not read" (to_fix.html.twig) - each can be put
    back. Always the element `#import-to-fix-left-out` (empty while there is none), so an answer given in place
    (_to_fix.stream.html.twig) can bring the list up to date; a row is `#left-out-row-<id>`.

    Variables: import_id, page, csrf, left_out ({rows: list<ImportSheetRow>, total: int}).
#}
{% set list_url = path('data_import_to_fix', page > 1 ? {importId: import_id, page: page} : {importId: import_id}) %}
<div id="import-to-fix-left-out">
    {% if left_out.total > 0 %}
        <details class="card card-body shadow-sm mt-3" data-testid="import-to-fix-left-out">
            <summary class="fw-semibold d-flex align-items-center" style="min-height: 44px; cursor: pointer;">{{ 'data_import.to_fix.left_out_title'|trans({'%number%': left_out.total|format_number}) }}</summary>
            {% for row in left_out.rows %}
                <div class="d-flex align-items-center justify-content-between gap-2 py-2 border-top" id="left-out-row-{{ row.rowId }}" data-testid="import-to-fix-left-out-row">
                    <a href="{{ path('data_import_row', {importId: import_id, rowId: row.rowId, return: list_url}) }}" class="text-break">{{ 'data_import.to_fix.row_of'|trans({'%row%': row.rowNumber|format_number, '%sheet%': row.sheetTitle}) }}</a>
                    <form action="{{ path('data_import_rows_answer', {importId: import_id}) }}" method="post" class="flex-shrink-0">
                        <input type="hidden" name="_token" value="{{ csrf }}">
                        <input type="hidden" name="row" value="{{ row.rowId }}">
                        <input type="hidden" name="page" value="{{ page }}">
                        <button type="submit" name="action" value="take_in" class="btn btn-outline-primary btn-sm" style="min-height: 44px;" data-testid="import-to-fix-take-in">{{ 'data_import.to_fix.take_in'|trans }}</button>
                    </form>
                </div>
            {% endfor %}
        </details>
    {% endif %}
</div>
