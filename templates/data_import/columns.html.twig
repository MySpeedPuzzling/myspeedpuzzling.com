{% extends 'base.html.twig' %}

{#
    "Sheets and columns" of one import (docs/features/data-import/columns-screen.md): every sheet of the file as a
    card - its name, what MySpeedPuzzling takes it for (one tap changes it), how its rows fared - the sheets that
    wait for an answer first. Phone first: one column of cards, every target 44 px.
#}

{% set hide_comparison_launcher = true %}
{% set import_name = import.fileName != '' ? import.fileName : 'data_import.google.unnamed'|trans %}
{% set csrf = csrf_token(constant('SpeedPuzzling\\Web\\Controller\\DataImport\\ImportsHomeController::CSRF_TOKEN_ID')) %}

{% block title %}{{ 'data_import.columns.title'|trans }} - {{ import_name }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
{{ include('data_import/_flow_header.html.twig', {import: import, step: 2}) }}

<div class="mx-auto" style="max-width: 720px;" data-testid="import-columns-page" data-import-flow-screen="columns">
    <h1 class="h3 mb-2">{{ 'data_import.columns.title'|trans }}</h1>
    <p class="text-muted fs-sm">{{ 'data_import.columns.intro'|trans }}</p>

    {{ include('data_import/_setup_live.html.twig', {import_id: import.importId, working: summary.working, revision: revision}) }}

    <turbo-frame id="import-sheets-live" data-import-live target="_top">
        {# One number a line, a zero is not printed (guided-flow.md §2 rule 5) #}
        <ul class="list-unstyled fs-sm fw-medium mb-3" data-testid="import-summary" data-ready="{{ summary.ready }}" data-look="{{ summary.look }}" data-waiting="{{ summary.waiting }}" data-left-out="{{ summary.left_out }}">
            {% if summary.ready > 0 %}<li>{{ 'data_import.columns.summary_line.ready'|trans({'%count%': summary.ready, '%number%': summary.ready|format_number}) }}</li>{% endif %}
            {% if summary.look > 0 %}
                <li><a href="{{ path('data_import_to_fix', {importId: import.importId}) }}" class="d-inline-flex align-items-center" style="min-height: 44px;">{{ 'data_import.columns.summary_line.look'|trans({'%count%': summary.look, '%number%': summary.look|format_number}) }}</a></li>
            {% endif %}
            {% if summary.waiting > 0 %}<li>{{ 'data_import.columns.summary_line.waiting'|trans({'%count%': summary.waiting, '%number%': summary.waiting|format_number}) }}</li>{% endif %}
            {% if summary.left_out > 0 %}<li class="fw-normal text-muted">{{ 'data_import.columns.summary_line.left_out'|trans({'%count%': summary.left_out, '%number%': summary.left_out|format_number}) }}</li>{% endif %}
        </ul>

        {# Right after the first layout: what the matching found (pairing-screens.md "We found N") - step 4 is the way to it #}
        {% if pairing.puzzles > 0 %}
            <div class="fs-sm text-muted mb-3" data-testid="import-found-puzzles">
                <p class="mb-0">{{ 'data_import.puzzles.we_found'|trans({'%found%': pairing.found|format_number, '%puzzles%': pairing.puzzles|format_number}) }}</p>
                <a href="{{ path('data_import_puzzles', {importId: import.importId}) }}" class="d-inline-flex align-items-center" style="min-height: 44px;" data-testid="import-found-puzzles-open">{{ 'data_import.puzzles.open'|trans }}</a>
            </div>
        {% endif %}

        {% for sheet in sheets %}
            {% set state = sheet.state %}
            <div class="card shadow-sm mb-3{{ sheet.asksThePlayer ? ' border-warning' : '' }}" data-testid="sheet-card" data-sheet-state="{{ state }}">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h2 class="h5 mb-1 text-break" data-testid="sheet-card-title">
                            {%- if sheet.title != '' %}{{ sheet.title }}{% else %}{{ 'data_import.sheets.untitled'|trans }}{% endif -%}
                        </h2>
                        <span class="fs-xs text-muted text-nowrap flex-shrink-0 pt-1">{{ 'data_import.columns.card.rows'|trans({'%number%': sheet.rows|format_number}) }}</span>
                    </div>
                    {% if sheet.hidden %}
                        <span class="badge bg-faded-warning text-warning mb-1"><i class="bi bi-eye-slash me-1"></i>{{ 'data_import.sheets.hidden'|trans }}</span>
                    {% endif %}

                    {{ include('data_import/_sheet_state.html.twig', {state: state, understood: sheet.rowsUnderstood, look: sheet.rowsNeedLook, left_out: sheet.rowsLeftOut, waiting: sheet.rowsWaiting}) }}

                    {% if sheet.rememberedLayout is not null %}
                        <p class="fs-sm text-muted mb-0 mt-2 text-break" data-testid="sheet-card-remembered">
                            <i class="bi bi-bookmark-check me-1"></i>{{ ('data_import.layouts.notice.' ~ sheet.rememberedLayout.how)|trans({'%name%': sheet.rememberedLayout.name != '' ? sheet.rememberedLayout.name : 'data_import.layouts.unnamed'|trans}) }}
                        </p>
                    {% endif %}

                    {% if sheet.mapped and sheet.kind is not null %}
                        {# One tap changes what the sheet is: the choices fold out, each a button of the same form #}
                        <details class="mt-3" data-testid="sheet-card-kind">
                            <summary class="d-flex align-items-center gap-2" style="min-height: 44px; cursor: pointer;">
                                <span class="text-muted fs-sm">{{ 'data_import.columns.card.this_is'|trans }}</span>
                                <span class="fw-medium" data-testid="sheet-card-kind-name" data-kind="{{ sheet.kind.value }}">{{ ('data_import.sheets.kind.' ~ sheet.kind.value)|trans }}</span>
                                <span class="ms-auto fs-sm text-primary text-nowrap"><i class="bi bi-pencil me-1"></i>{{ 'data_import.columns.change'|trans }}</span>
                            </summary>
                            <form action="{{ path('data_import_sheet_confirm', {importId: import.importId, sheetId: sheet.sheetId}) }}" method="post" class="d-grid gap-2 mt-2">
                                <input type="hidden" name="_token" value="{{ csrf }}">
                                <input type="hidden" name="version" value="{{ sheet.mappingVersion }}">
                                <input type="hidden" name="back" value="list">
                                {% for kind in ['results', 'owned', 'wish_list', 'puzzle_list', 'not_puzzles', 'somebody_else'] %}
                                    <button type="submit" name="kind" value="{{ kind }}"
                                            class="btn btn-outline-primary{{ kind == sheet.kind.value ? ' active' : '' }} text-wrap text-start"
                                            style="min-height: 44px;" data-testid="sheet-card-kind-{{ kind }}"
                                            {% if kind == sheet.kind.value %}aria-pressed="true"{% endif %}>
                                        {{ ('data_import.sheets.kind.' ~ kind)|trans }}
                                    </button>
                                {% endfor %}
                            </form>
                        </details>

                        <a href="{{ path('data_import_sheet', {importId: import.importId, sheetId: sheet.sheetId}) }}"
                           class="btn btn-outline-primary w-100 mt-2 text-wrap d-flex align-items-center justify-content-center"
                           style="min-height: 44px;" data-testid="sheet-card-open">
                            {% if state == 'waiting' %}
                                <i class="bi bi-question-circle me-1"></i>{{ 'data_import.columns.card.answer'|trans }}
                            {% elseif sheet.asksThePlayer and state == 'parsed' %}
                                {# A question that decides a few rows: the rest of the sheet is read already #}
                                <i class="bi bi-question-circle me-1"></i><span data-testid="sheet-card-answer-some">{{ 'data_import.columns.card.answer_some'|trans({'%questions%': sheet.questions|format_number, '%rows%': sheet.rowsWaiting|format_number}) }}</span>
                            {% else %}
                                <i class="bi bi-columns-gap me-1"></i>{{ 'data_import.columns.card.open'|trans }}
                            {% endif %}
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endfor %}

        {{ include('data_import/_sheets_table.html.twig', {sheets: sheets}, with_context = false) }}

        {# The ONE primary of the screen: a question first, else on to the next step #}
        {% set asking = sheets|filter(sheet => sheet.asksThePlayer)|first %}
        {% if asking %}
            {{ include('data_import/_flow_footer.html.twig', {import: import, offer_add: true, primary: {
                label: 'data_import.columns.card.answer'|trans,
                url: path('data_import_sheet', {importId: import.importId, sheetId: asking.sheetId}),
                icon: 'bi-question-circle',
                testid: 'import-flow-answer',
            }}, with_context = false) }}
            <a href="{{ path('data_import_detail', {importId: import.importId, after: 'check'}) }}" class="btn btn-link px-0 d-inline-flex align-items-center" style="min-height: 44px;" data-testid="import-flow-continue" rel="nofollow">{{ 'data_import.flow.continue_later'|trans }}</a>
        {% elseif not summary.working %}
            {{ include('data_import/_flow_footer.html.twig', {import: import, continue_after: 'check', continue_label: 'data_import.flow.looks_right'|trans, offer_add: true}, with_context = false) }}
        {% else %}
            {{ include('data_import/_flow_footer.html.twig', {import: import}, with_context = false) }}
        {% endif %}
    </turbo-frame>

    {% if saved_layouts > 0 %}
        <a href="{{ path('data_import_layouts', {return: path('data_import_columns', {importId: import.importId})}) }}"
           class="btn btn-link px-0 d-flex align-items-center" style="min-height: 44px;" data-testid="import-saved-layouts">
            <i class="bi bi-bookmarks me-1"></i>{{ 'data_import.layouts.link'|trans({'%number%': saved_layouts|format_number}) }}
        </a>
    {% endif %}

</div>
{% endblock %}
