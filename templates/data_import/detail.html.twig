{% extends 'base.html.twig' %}

{#
    "Where you are" - the page of one import (docs/features/data-import/guided-flow.md §5.3): the one place that
    always says what is done, what waits and what the next tap is. The flow's header, a headline, the five steps as
    lines - each a link with one status sentence - ONE primary button, the quiet "or add what is ready now" line,
    and, below a rule, what the player may do with the import itself (finish, discard, undo). Everything on it is
    worked out by Services\DataImport\ImportFlow from what the page loads anyway.

    While the file is not read (docs/features/data-import/upload.md, reading.md) it shows the reading's live
    progress, or why the file could not be read with "Try again".
#}

{% set hide_comparison_launcher = true %}

{% set import_name = import.fileName != '' ? import.fileName : 'data_import.google.unnamed'|trans %}

{% block title %}{{ import_name }} - {{ 'data_import.home.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
{{ include('data_import/_flow_header.html.twig', {import: import, import_flow: import_flow, live_header: import_flow.stage == 'steps'}) }}

<div class="mx-auto" style="max-width: 720px;" data-testid="data-import-page" data-import-flow-screen="detail" data-stage="{{ import_flow.stage }}" data-status="{{ import.status.value }}">
    {% set csrf = csrf_token(constant('SpeedPuzzling\\Web\\Controller\\DataImport\\ImportsHomeController::CSRF_TOKEN_ID')) %}
    {% set status = import.status.value %}

    {% if import_flow.stage == 'file' %}
        <h1 class="h4 mb-3" data-testid="import-flow-headline">{{ include('data_import/_flow_text.html.twig', {text: import_flow.headline}, with_context = false) }}</h1>
    {% if status == 'uploading' %}
        <div class="alert alert-warning fs-sm" data-testid="import-not-finished">
            <p class="mb-2">{{ 'data_import.detail.not_finished'|trans }}</p>
            <form action="{{ path('data_import_upload_finish', {importId: import.importId}) }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf }}">
                <button type="submit" class="btn btn-primary text-wrap" style="min-height: 44px;" data-testid="finish-upload">
                    <i class="bi bi-arrow-repeat me-1"></i>{{ 'data_import.detail.finish'|trans }}
                </button>
            </form>
        </div>
    {% elseif status == 'fetching' or status == 'uploaded' or status == 'reading' %}
        {#
            A Google sheet is being fetched (the state line only - no numbers yet), or the file waits for the worker or is being read: the line moves by the player's private Mercure topic and,
            when no event arrives, by asking every few seconds (data_import_progress_controller.js). When nothing
            moves any more the page is loaded again - with the sheets, or with why the file was not read.
        #}
        <div class="card card-body shadow-sm mb-3" data-testid="import-reading"
             data-controller="data-import-progress"
             data-data-import-progress-import-id-value="{{ import.importId }}"
             data-data-import-progress-url-value="{{ path('data_import_progress', {importId: import.importId}) }}"
             data-data-import-progress-fetching-text-value="{{ 'data_import.reading.fetching'|trans }}"
             data-data-import-progress-waiting-text-value="{{ 'data_import.reading.waiting'|trans }}"
             data-data-import-progress-reading-text-value="{{ 'data_import.reading.reading'|trans }}"
             data-data-import-progress-sheets-text-value="{{ 'data_import.reading.sheets'|trans }}"
             data-data-import-progress-rows-text-value="{{ 'data_import.reading.rows'|trans }}">
            <div class="d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm text-primary flex-shrink-0" aria-hidden="true" data-data-import-progress-target="spinner"></div>
                <strong data-data-import-progress-target="state" data-testid="import-reading-state" role="status">
                    {{- (status == 'reading' ? 'data_import.reading.reading' : (status == 'fetching' ? 'data_import.reading.fetching' : 'data_import.reading.waiting'))|trans -}}
                </strong>
            </div>
            <div class="fs-sm text-muted mt-2" data-data-import-progress-target="sheets" data-testid="import-reading-sheets"{% if import.sheetsTotal is null %} hidden{% endif %}>
                {%- if import.sheetsTotal is not null %}{{ 'data_import.reading.sheets'|trans({'%done%': import.sheetsRead, '%total%': import.sheetsTotal}) }}{% endif -%}
            </div>
            <div class="fs-sm text-muted" data-data-import-progress-target="rows" data-testid="import-reading-rows"{% if status != 'reading' %} hidden{% endif %}>
                {%- if status == 'reading' %}{{ 'data_import.reading.rows'|trans({'%count%': import.rowsRead|format_number}) }}{% endif -%}
            </div>
            <p class="fs-sm text-muted mb-0 mt-2">{{ 'data_import.reading.leave'|trans }}</p>
            {# Shown by the script when the progress could not be asked for ten minutes #}
            <div class="alert alert-warning fs-sm mt-3 mb-0" data-data-import-progress-target="stale" data-testid="import-reading-stale" role="status" hidden>
                <p class="mb-2">{{ 'data_import.reading.stale'|trans }}</p>
                <a href="{{ path('data_import_detail', {importId: import.importId}) }}" class="btn btn-outline-primary text-wrap d-inline-flex align-items-center" style="min-height: 44px;" data-turbo="false">
                    <i class="bi bi-arrow-clockwise me-1"></i>{{ 'data_import.reading.refresh'|trans }}
                </a>
            </div>
            <noscript>
                <a href="{{ path('data_import_detail', {importId: import.importId}) }}" class="btn btn-outline-primary mt-2" style="min-height: 44px;">{{ 'data_import.reading.refresh'|trans }}</a>
            </noscript>
        </div>
    {% elseif status == 'fetch_failed' %}
        <div class="alert alert-warning" data-testid="import-fetch-failed" data-reason="{{ import.fetchFailure }}">
            <h2 class="h6 alert-heading"><i class="bi bi-exclamation-triangle me-1"></i>{{ 'data_import.fetch_failed.title'|trans }}</h2>
            <p class="fs-sm mb-3">{{ ('data_import.fetch_failed.' ~ import.fetchFailure)|trans(limits) }}</p>
            {% if import.fetchFailure == 'not_shared' %}
                <p class="fs-sm mb-3">{{ 'data_import.google.share_hint'|trans }} <span class="fw-semibold">{{ 'data_import.google.share_steps'|trans }}</span></p>
            {% endif %}
            <div class="d-flex flex-wrap gap-2">
                <form action="{{ path('data_import_fetch_again', {importId: import.importId}) }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf }}">
                    <button type="submit" class="btn btn-primary text-wrap" style="min-height: 44px;" data-testid="fetch-again">
                        <i class="bi bi-arrow-repeat me-1"></i>{{ 'data_import.read_failed.try_again'|trans }}
                    </button>
                </form>
                <a href="{{ path('data_import_new') }}" class="btn btn-outline-primary text-wrap d-inline-flex align-items-center" style="min-height: 44px;">
                    <i class="bi bi-upload me-1"></i>{{ 'data_import.fetch_failed.upload_instead'|trans }}
                </a>
            </div>
        </div>
    {% elseif status == 'read_failed' %}
        <div class="alert alert-warning" data-testid="import-read-failed" data-reason="{{ import.readFailure }}">
            <h2 class="h6 alert-heading"><i class="bi bi-exclamation-triangle me-1"></i>{{ 'data_import.read_failed.title'|trans }}</h2>
            <p class="fs-sm mb-3">{{ ('data_import.read_failed.' ~ import.readFailure)|trans(limits) }}</p>
            <div class="d-flex flex-wrap gap-2">
                {% if import.fileKept %}
                    <form action="{{ path('data_import_read_again', {importId: import.importId}) }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf }}">
                        <button type="submit" class="btn btn-primary text-wrap" style="min-height: 44px;" data-testid="read-again">
                            <i class="bi bi-arrow-repeat me-1"></i>{{ 'data_import.read_failed.try_again'|trans }}
                        </button>
                    </form>
                {% endif %}
                <a href="{{ path('data_import_new') }}" class="btn {{ import.fileKept ? 'btn-outline-primary' : 'btn-primary' }} text-wrap d-inline-flex align-items-center" style="min-height: 44px;">
                    <i class="bi bi-upload me-1"></i>{{ 'data_import.read_failed.upload_again'|trans }}
                </a>
            </div>
        </div>
    {% endif %}
    {% endif %}

    {% if import_flow.stage != 'file' %}
        {#
            While rows are read or puzzles matched the page follows by itself: the live line, and this frame loaded
            again whenever a sheet's state or the matching's changes (docs/features/data-import/pairing-screens.md
            "The live line")
        #}
        {% if import_flow.stage == 'steps' %}
            {{ include('data_import/_setup_live.html.twig', {import_id: import.importId, working: live.working, revision: live.revision, pairing: live_pairing|default(true)}) }}
        {% endif %}
        <turbo-frame id="import-detail-live" data-import-live target="_top">
            <h1 class="h4 mb-3" data-testid="import-flow-headline">{{ include('data_import/_flow_text.html.twig', {text: import_flow.headline}, with_context = false) }}</h1>

            {% if import_flow.stage == 'finished' %}
                {# Finished: read-only - what it added can be undone below, and it can be gone on with #}
                <div data-testid="import-finished">
                    <p class="fs-sm text-muted">{{ 'data_import.finish.finished_help'|trans }}</p>
                </div>
            {% endif %}

            <ol class="list-unstyled mb-3" data-testid="import-flow-lines">
                {% for flow_step in import_flow.steps %}
                    {% set url = flow_step.number == 1 ? null : (flow_step.route is not null ? path(flow_step.route, flow_step.parameters) : null) %}
                    <li class="border-top{{ loop.last ? ' border-bottom' : '' }}" data-testid="import-flow-line" data-step="{{ flow_step.key }}" data-state="{{ flow_step.state }}" data-waiting="{{ flow_step.waiting }}">
                        {% set line %}
                            <span class="flex-shrink-0 pt-1" style="width: 24px;" aria-hidden="true">
                                {%- if flow_step.state == 'done' -%}<i class="bi bi-check-circle-fill text-success"></i>
                                {%- elseif flow_step.state == 'open' -%}<i class="bi bi-record-circle-fill text-primary"></i>
                                {%- elseif flow_step.state == 'working' -%}<span class="spinner-border spinner-border-sm text-primary"></span>
                                {%- else -%}<i class="bi bi-circle text-muted"></i>
                                {%- endif -%}
                            </span>
                            <span class="flex-grow-1" style="min-width: 0;">
                                <span class="d-block fw-semibold">{{ flow_step.number }} · {{ ('data_import.flow.step.' ~ flow_step.key)|trans }}</span>
                                {% for text in flow_step.lines %}
                                    <span class="d-block fs-sm {{ flow_step.state == 'open' ? 'text-body' : 'text-muted' }}" data-testid="import-flow-line-text">{{ include('data_import/_flow_text.html.twig', {text: text}, with_context = false) }}</span>
                                {% endfor %}
                            </span>
                        {% endset %}
                        {% if url is not null %}
                            <a href="{{ url }}" class="d-flex gap-2 py-2 text-body text-decoration-none" style="min-height: 44px;" data-testid="import-flow-line-link">
                                {{ line }}
                                <span class="flex-shrink-0 fs-sm text-primary text-nowrap align-self-center">{% if flow_step.state == 'done' %}{{ 'data_import.flow.see'|trans }} {% endif %}<i class="bi bi-chevron-right" aria-hidden="true"></i></span>
                            </a>
                        {% else %}
                            <div class="d-flex gap-2 py-2" style="min-height: 44px;">{{ line }}</div>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>

            {% if import_flow.primary is not null %}
                {% set primary = import_flow.primary %}
                <a href="{{ path(primary.route, primary.parameters) }}" class="btn btn-primary btn-lg w-100 text-wrap d-flex align-items-center justify-content-center" style="min-height: 52px;"
                   data-testid="import-flow-primary" data-route="{{ primary.route }}">
                    {{- include('data_import/_flow_text.html.twig', {text: primary.label}, with_context = false) -}}
                </a>
            {% endif %}
            {% if import_flow.secondary is not null %}
                <p class="fs-sm mt-3 mb-0" data-testid="import-flow-add-ready" data-ready="{{ import_flow.secondary.label.count }}">
                    <a href="{{ path(import_flow.secondary.route, import_flow.secondary.parameters) }}" class="d-inline-flex align-items-center" style="min-height: 44px;">
                        {{- include('data_import/_flow_text.html.twig', {text: import_flow.secondary.label}, with_context = false) -}}
                    </a>
                </p>
            {% endif %}
            {% if add.unlisted > 0 and import_flow.stage == 'steps' %}
                <p class="fs-sm text-muted mt-2 mb-0" data-testid="import-ready-unlisted" data-rows="{{ add.unlisted }}">
                    <i class="bi bi-bookmark me-1" aria-hidden="true"></i>{{ 'unlisted_puzzles.add.ready'|trans({'%number%': add.unlisted|format_number}) }}
                </p>
            {% endif %}
            {{ include('unlisted_puzzles/_import_link.html.twig', {show: add.keptNow > 0}, with_context = false) }}
            {% if add.hasAdded %}
                <p class="fs-sm text-muted mt-3 mb-0" data-testid="{{ import_flow.stage == 'finished' ? 'import-finished-added' : 'import-ready-added' }}">
                    {{ 'data_import.add.added_so_far'|trans({'%results%': add.resultsAdded|format_number, '%owned%': add.collectionItemsAdded|format_number, '%wish_list%': add.wishListItemsAdded|format_number}) }}
                    {% if import_flow.primary is null or import_flow.primary.route != 'data_import_added' %}
                        <a href="{{ path('data_import_added', {importId: import.importId}) }}" class="d-inline-flex align-items-center" style="min-height: 44px;">{{ 'data_import.add.see_added'|trans }}</a>
                    {% endif %}
                </p>
            {% endif %}

            {% if import_flow.stage == 'steps' %}
                <p class="fs-sm text-muted mt-3 mb-0" data-testid="import-flow-saved">{{ 'data_import.flow.saved'|trans }}</p>
            {% endif %}
        </turbo-frame>

        {% if import.fromGoogleSheet and status == 'setting_up' %}
            <p class="fs-sm text-muted mt-3" data-testid="import-sharing-off"><i class="bi bi-shield-check me-1"></i>{{ 'data_import.google.sharing_off'|trans }}</p>
        {% endif %}
    {% endif %}

    {# ---- Below a rule: the file, and what can be done with the import itself ---- #}
    <hr class="my-4">

    {% if import_flow.stage == 'finished' %}
        {% if can_go_on %}
            <form action="{{ path('data_import_go_on', {importId: import.importId}) }}" method="post" class="mb-3">
                <input type="hidden" name="_token" value="{{ csrf }}">
                <button type="submit" class="btn btn-outline-primary text-wrap" style="min-height: 44px;" data-testid="import-go-on">
                    <i class="bi bi-arrow-return-right me-1" aria-hidden="true"></i>{{ 'data_import.finish.go_on'|trans }}
                </button>
            </form>
        {% else %}
            <p class="fs-sm text-muted" data-testid="import-can-not-go-on">{{ 'data_import.finish.can_not_go_on_note'|trans }}</p>
        {% endif %}
        {% if sheets is not empty %}
            {{ include('data_import/_sheets_table.html.twig', {sheets: sheets}, with_context = false) }}
        {% endif %}
    {% endif %}

    {% if status != 'uploading' and status != 'fetching' and status != 'fetch_failed' and (import.fileKeptUntil is not null or import.fileRemovedAt is not null) %}
        <p class="fs-sm text-muted d-flex gap-2" data-testid="import-file-kept">
            <i class="bi bi-info-circle flex-shrink-0"></i>
            <span>
                {% if import.fileKeptUntil is not null %}
                    {{ 'data_import.detail.kept'|trans({'%date%': import.fileKeptUntil|format_date('long')}) }}
                {% else %}
                    {{ 'data_import.detail.file_removed'|trans({'%date%': import.fileRemovedAt|format_date('long'), '%days%': keep_days}) }}
                {% endif %}
            </span>
        </p>
    {% endif %}

    {% if import_flow.canFinish %}
        {{ include('data_import/_finish_card.html.twig', {import_id: import.importId, csrf: csrf, kept_only: add.onlyKept, nothing_added: not add.hasAdded}) }}
    {% endif %}

    {% if not import_flow.canDiscard %}
        {# An import that added something is kept: its rows are how nothing is added twice and how it is undone #}
        <div class="mb-4" data-testid="import-kept">
            {{ include('data_import/_explain.html.twig', {text: 'data_import.explain.kept'|trans, testid: 'import-kept-why'}, with_context = false) }}
            {% if add.hasAdded %}
                <a href="{{ path('data_import_undo', {importId: import.importId}) }}" class="btn btn-link px-0 text-danger text-start text-wrap d-inline-flex align-items-center" style="min-height: 44px;" data-testid="import-undo-import" rel="nofollow">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>{{ 'data_import.undo.import'|trans }}
                </a>
                {{ include('data_import/_explain.html.twig', {text: 'data_import.explain.undo'|trans, more: 'data_import.explain.undo_more'|trans, fold: true, testid: 'import-explain-undo'}, with_context = false) }}
            {% endif %}
        </div>
    {% else %}
        <form action="{{ path('data_import_discard', {importId: import.importId}) }}" method="post" class="mb-4">
            <input type="hidden" name="_token" value="{{ csrf }}">
            <button type="submit" class="btn btn-link px-0 text-danger text-start text-wrap" style="min-height: 44px;" data-testid="discard-import"
                    data-turbo-confirm="{{ 'data_import.detail.discard_confirm'|trans }}">
                <i class="bi bi-trash me-1"></i>{{ 'data_import.detail.discard'|trans }}
            </button>
            <p class="fs-sm text-muted mb-0">{{ 'data_import.explain.discard'|trans }}</p>
        </form>
    {% endif %}
</div>
{% endblock %}
