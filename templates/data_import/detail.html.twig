{% extends 'base.html.twig' %}

{#
    One import of the signed-in player (docs/features/data-import/upload.md, reading.md): its file, its state, the
    reading's live progress, then the sheets the file holds - or why it could not be read, with "Try again" - what
    is ready to be added to the profile (docs/features/data-import/adding-screens.md "Ready to add"), and Discard -
    which an import that added something does not offer: it says what it keeps and how to take it back.
#}

{% set hide_comparison_launcher = true %}

{% set import_name = import.fileName != '' ? import.fileName : 'data_import.google.unnamed'|trans %}

{% block title %}{{ import_name }} - {{ 'data_import.home.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
{{ include('_page_crumbs.html.twig', {levels: [{name: 'data_import.home.title'|trans, url: path('data_imports')}]}) }}

<div class="mx-auto" style="max-width: 720px;" data-testid="data-import-page">
    <h1 class="h3 mb-3 text-break"><i class="bi bi-file-earmark-spreadsheet me-2"></i>{{ import_name }}</h1>

    <div class="card card-body shadow-sm mb-3">
        <dl class="row mb-0">
            <dt class="col-5 col-sm-4 fw-normal text-muted">{{ 'data_import.detail.state'|trans }}</dt>
            <dd class="col-7 col-sm-8">{{ include('data_import/_status_badge.html.twig', {status: import.status}) }}</dd>

            {% if import.fromGoogleSheet %}
                <dt class="col-5 col-sm-4 fw-normal text-muted">{{ 'data_import.detail.source'|trans }}</dt>
                <dd class="col-7 col-sm-8" data-testid="import-source">{{ 'data_import.google.source'|trans }}</dd>
            {% endif %}

            {% if import.fileSize is not null %}
                <dt class="col-5 col-sm-4 fw-normal text-muted">{{ 'data_import.detail.size'|trans }}</dt>
                <dd class="col-7 col-sm-8" data-testid="import-size">{{ include('data_import/_file_size.html.twig', {bytes: import.fileSize}) }}</dd>
            {% endif %}

            <dt class="col-5 col-sm-4 fw-normal text-muted">{{ 'data_import.detail.started'|trans }}</dt>
            <dd class="col-7 col-sm-8 mb-0">{{ import.createdAt|format_date('long') }}</dd>
        </dl>
    </div>

    {% set csrf = csrf_token(constant('SpeedPuzzling\\Web\\Controller\\DataImport\\ImportsHomeController::CSRF_TOKEN_ID')) %}
    {% set status = import.status.value %}

    {% if status == 'uploading' %}
        <div class="alert alert-warning fs-sm" data-testid="import-not-finished">
            <p class="mb-2">{{ 'data_import.detail.not_finished'|trans }}</p>
            <form action="{{ path('data_import_upload_finish', {importId: import.importId}) }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf }}">
                <button type="submit" class="btn btn-primary text-wrap" style="min-height: 44px;" data-testid="finish-upload">
                    <i class="bi bi-arrow-repeat me-1"></i>{{ 'data_import.detail.finish'|trans }}
                </button>
            </form>
        </div>
    {% elseif status == 'fetching' or status == 'uploaded' or status == 'reading' %}
        {#
            A Google sheet is being fetched (the state line only - no numbers yet), or the file waits for the worker or is being read: the line moves by the player's private Mercure topic and,
            when no event arrives, by asking every few seconds (data_import_progress_controller.js). When nothing
            moves any more the page is loaded again - with the sheets, or with why the file was not read.
        #}
        <div class="card card-body shadow-sm mb-3" data-testid="import-reading"
             data-controller="data-import-progress"
             data-data-import-progress-import-id-value="{{ import.importId }}"
             data-data-import-progress-url-value="{{ path('data_import_progress', {importId: import.importId}) }}"
             data-data-import-progress-fetching-text-value="{{ 'data_import.reading.fetching'|trans }}"
             data-data-import-progress-waiting-text-value="{{ 'data_import.reading.waiting'|trans }}"
             data-data-import-progress-reading-text-value="{{ 'data_import.reading.reading'|trans }}"
             data-data-import-progress-sheets-text-value="{{ 'data_import.reading.sheets'|trans }}"
             data-data-import-progress-rows-text-value="{{ 'data_import.reading.rows'|trans }}">
            <div class="d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm text-primary flex-shrink-0" aria-hidden="true" data-data-import-progress-target="spinner"></div>
                <strong data-data-import-progress-target="state" data-testid="import-reading-state" role="status">
                    {{- (status == 'reading' ? 'data_import.reading.reading' : (status == 'fetching' ? 'data_import.reading.fetching' : 'data_import.reading.waiting'))|trans -}}
                </strong>
            </div>
            <div class="fs-sm text-muted mt-2" data-data-import-progress-target="sheets" data-testid="import-reading-sheets"{% if import.sheetsTotal is null %} hidden{% endif %}>
                {%- if import.sheetsTotal is not null %}{{ 'data_import.reading.sheets'|trans({'%done%': import.sheetsRead, '%total%': import.sheetsTotal}) }}{% endif -%}
            </div>
            <div class="fs-sm text-muted" data-data-import-progress-target="rows" data-testid="import-reading-rows"{% if status != 'reading' %} hidden{% endif %}>
                {%- if status == 'reading' %}{{ 'data_import.reading.rows'|trans({'%count%': import.rowsRead|format_number}) }}{% endif -%}
            </div>
            <p class="fs-sm text-muted mb-0 mt-2">{{ 'data_import.reading.leave'|trans }}</p>
            {# Shown by the script when the progress could not be asked for ten minutes #}
            <div class="alert alert-warning fs-sm mt-3 mb-0" data-data-import-progress-target="stale" data-testid="import-reading-stale" role="status" hidden>
                <p class="mb-2">{{ 'data_import.reading.stale'|trans }}</p>
                <a href="{{ path('data_import_detail', {importId: import.importId}) }}" class="btn btn-outline-primary text-wrap d-inline-flex align-items-center" style="min-height: 44px;" data-turbo="false">
                    <i class="bi bi-arrow-clockwise me-1"></i>{{ 'data_import.reading.refresh'|trans }}
                </a>
            </div>
            <noscript>
                <a href="{{ path('data_import_detail', {importId: import.importId}) }}" class="btn btn-outline-primary mt-2" style="min-height: 44px;">{{ 'data_import.reading.refresh'|trans }}</a>
            </noscript>
        </div>
    {% elseif status == 'fetch_failed' %}
        <div class="alert alert-danger" data-testid="import-fetch-failed" data-reason="{{ import.fetchFailure }}">
            <h2 class="h6 alert-heading"><i class="bi bi-exclamation-triangle me-1"></i>{{ 'data_import.fetch_failed.title'|trans }}</h2>
            <p class="fs-sm mb-3">{{ ('data_import.fetch_failed.' ~ import.fetchFailure)|trans(limits) }}</p>
            {% if import.fetchFailure == 'not_shared' %}
                <p class="fs-sm mb-3">{{ 'data_import.google.share_hint'|trans }} <span class="fw-semibold">{{ 'data_import.google.share_steps'|trans }}</span></p>
            {% endif %}
            <div class="d-flex flex-wrap gap-2">
                <form action="{{ path('data_import_fetch_again', {importId: import.importId}) }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf }}">
                    <button type="submit" class="btn btn-primary text-wrap" style="min-height: 44px;" data-testid="fetch-again">
                        <i class="bi bi-arrow-repeat me-1"></i>{{ 'data_import.read_failed.try_again'|trans }}
                    </button>
                </form>
                <a href="{{ path('data_import_new') }}" class="btn btn-outline-primary text-wrap d-inline-flex align-items-center" style="min-height: 44px;">
                    <i class="bi bi-upload me-1"></i>{{ 'data_import.fetch_failed.upload_instead'|trans }}
                </a>
            </div>
        </div>
    {% elseif status == 'read_failed' %}
        <div class="alert alert-danger" data-testid="import-read-failed" data-reason="{{ import.readFailure }}">
            <h2 class="h6 alert-heading"><i class="bi bi-exclamation-triangle me-1"></i>{{ 'data_import.read_failed.title'|trans }}</h2>
            <p class="fs-sm mb-3">{{ ('data_import.read_failed.' ~ import.readFailure)|trans(limits) }}</p>
            <div class="d-flex flex-wrap gap-2">
                {% if import.fileKept %}
                    <form action="{{ path('data_import_read_again', {importId: import.importId}) }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf }}">
                        <button type="submit" class="btn btn-primary text-wrap" style="min-height: 44px;" data-testid="read-again">
                            <i class="bi bi-arrow-repeat me-1"></i>{{ 'data_import.read_failed.try_again'|trans }}
                        </button>
                    </form>
                {% endif %}
                <a href="{{ path('data_import_new') }}" class="btn btn-outline-primary text-wrap d-inline-flex align-items-center" style="min-height: 44px;">
                    <i class="bi bi-upload me-1"></i>{{ 'data_import.read_failed.upload_again'|trans }}
                </a>
            </div>
        </div>
    {% elseif sheets is not empty %}
        {#
            While rows are read or puzzles paired the page follows by itself: the live line, and this frame loaded
            again whenever a sheet's state or the pairing's changes (docs/features/data-import/pairing-screens.md
            "The live line")
        #}
        {% if status == 'setting_up' %}
            {{ include('data_import/_setup_live.html.twig', {import_id: import.importId, working: live.working, revision: live.revision, pairing: true}) }}
        {% endif %}
        <turbo-frame id="import-detail-live" data-import-live target="_top">
        {% if status == 'setting_up' %}
            {# Where the import stands, and the way to its "Sheets and columns" screen (docs/features/data-import/columns-screen.md) #}
            <div class="card card-body shadow-sm mb-3" data-testid="import-columns-summary">
                <p class="fw-medium mb-1" data-testid="import-summary">
                    {{ 'data_import.columns.summary'|trans({'%ready%': summary.ready|format_number, '%look%': summary.look|format_number, '%waiting%': summary.waiting|format_number, '%left_out%': summary.left_out|format_number}) }}
                </p>
                <a href="{{ path('data_import_columns', {importId: import.importId}) }}" class="btn btn-primary w-100 mt-2 text-wrap d-flex align-items-center justify-content-center" style="min-height: 44px;" data-testid="import-open-columns">
                    <i class="bi bi-columns-gap me-1"></i>{{ 'data_import.columns.open'|trans }}
                </a>
            </div>
            {{ include('data_import/_pairing_summary.html.twig', {pairing: pairing, import_id: import.importId}) }}
            {{ include('data_import/_ready_card.html.twig', {add: add, import_id: import.importId}) }}
        {% endif %}
        <div class="card shadow-sm mb-3" data-testid="import-sheets">
            <div class="card-body pb-2">
                <h2 class="h5 mb-0">{{ 'data_import.sheets.title'|trans }}</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr class="fs-sm text-muted">
                            <th scope="col" class="ps-3 fw-normal">{{ 'data_import.sheets.sheet'|trans }}</th>
                            <th scope="col" class="text-end fw-normal">{{ 'data_import.sheets.rows'|trans }}</th>
                            <th scope="col" class="text-end pe-3 fw-normal">{{ 'data_import.sheets.columns'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for sheet in sheets %}
                            <tr data-testid="import-sheet">
                                <td class="ps-3 text-break">
                                    {% if sheet.title != '' %}{{ sheet.title }}{% else %}<span class="text-muted">{{ 'data_import.sheets.untitled'|trans }}</span>{% endif %}
                                    {% if sheet.hidden %}
                                        <span class="badge bg-faded-warning text-warning ms-1" data-testid="import-sheet-hidden"><i class="bi bi-eye-slash me-1"></i>{{ 'data_import.sheets.hidden'|trans }}</span>
                                    {% endif %}
                                    {# What the import takes the sheet for and how its rows fared (docs/features/data-import/columns.md) - read only #}
                                    <div class="fs-sm text-muted" data-testid="import-sheet-state">
                                        {% if sheet.failed %}
                                            <span class="badge bg-faded-danger text-danger" data-testid="import-sheet-failed"><i class="bi bi-exclamation-triangle me-1"></i>{{ 'data_import.sheets.failed'|trans }}</span>
                                        {% elseif not sheet.mapped %}
                                            <span data-testid="import-sheet-recognising">{{ 'data_import.sheets.recognising'|trans }}</span>
                                        {% else %}
                                            {% if sheet.kind is not null %}
                                                <span class="fw-medium" data-testid="import-sheet-kind" data-kind="{{ sheet.kind.value }}">{{ ('data_import.sheets.kind.' ~ sheet.kind.value)|trans }}</span>
                                            {% endif %}
                                            {% if sheet.state == 'waiting' %}
                                                <span class="badge bg-faded-warning text-warning ms-1" data-testid="import-sheet-waiting"><i class="bi bi-question-circle me-1"></i>{{ 'data_import.sheets.waiting_for_answer'|trans }}</span>
                                            {% elseif not sheet.parsed %}
                                                <div data-testid="import-sheet-parsing">{{ 'data_import.sheets.parsing'|trans }}</div>
                                            {% elseif sheet.kind is not null and sheet.kind.value not in ['not_puzzles', 'somebody_else'] %}
                                                {% if sheet.parsed %}
                                                    <div data-testid="import-sheet-parsed">
                                                        {{ 'data_import.sheets.understood'|trans({'%understood%': sheet.rowsUnderstood|format_number, '%look%': sheet.rowsNeedLook|format_number}) }}
                                                        {%- if sheet.rowsWaiting > 0 %} · {{ 'data_import.columns.state.waiting_rows'|trans({'%number%': sheet.rowsWaiting|format_number}) }}{% endif %}
                                                        {%- if sheet.rowsLeftOut > 0 %} · {{ 'data_import.columns.state.rows_left_out'|trans({'%number%': sheet.rowsLeftOut|format_number}) }}{% endif %}
                                                    </div>
                                                {% else %}
                                                    <div data-testid="import-sheet-parsing">{{ 'data_import.sheets.parsing'|trans }}</div>
                                                {% endif %}
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="text-end text-nowrap" data-testid="import-sheet-rows">{{ sheet.rows|format_number }}</td>
                                <td class="text-end text-nowrap pe-3" data-testid="import-sheet-columns">{{ sheet.columns|format_number }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        </turbo-frame>
    {% endif %}

    {% if import.fromGoogleSheet and status == 'setting_up' %}
        <p class="fs-sm text-muted" data-testid="import-sharing-off"><i class="bi bi-shield-check me-1"></i>{{ 'data_import.google.sharing_off'|trans }}</p>
    {% endif %}

    {% if status != 'uploading' and status != 'fetching' and status != 'fetch_failed' and (import.fileKeptUntil is not null or import.fileRemovedAt is not null) %}
        <p class="fs-sm text-muted d-flex gap-2" data-testid="import-file-kept">
            <i class="bi bi-info-circle flex-shrink-0"></i>
            <span>
                {% if import.fileKeptUntil is not null %}
                    {{ 'data_import.detail.kept'|trans({'%date%': import.fileKeptUntil|format_date('long')}) }}
                {% else %}
                    {{ 'data_import.detail.file_removed'|trans({'%date%': import.fileRemovedAt|format_date('long'), '%days%': keep_days}) }}
                {% endif %}
            </span>
        </p>
    {% endif %}

    {% if add.latestBatchId is not null %}
        {# An import that added something is kept: its rows are how nothing is added twice and how it is taken back #}
        <div class="card card-body shadow-sm mb-4" data-testid="import-kept">
            <h2 class="h5">{{ 'data_import.detail.kept_title'|trans }}</h2>
            <p class="fs-sm text-muted{{ add.hasAdded ? '' : ' mb-0' }}">{{ 'data_import.detail.kept_because_added'|trans }}</p>
            {% if add.hasAdded %}
                <a href="{{ path('data_import_undo', {importId: import.importId}) }}" class="btn btn-outline-danger text-wrap d-inline-flex align-items-center align-self-start" style="min-height: 44px;" data-testid="import-undo-import" rel="nofollow">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>{{ 'data_import.undo.import'|trans }}
                </a>
            {% endif %}
        </div>
    {% else %}
        <div class="card card-body shadow-sm mb-4">
            <h2 class="h5">{{ 'data_import.detail.discard'|trans }}</h2>
            <p class="fs-sm text-muted">{{ 'data_import.detail.discard_help'|trans }}</p>

            <form action="{{ path('data_import_discard', {importId: import.importId}) }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf }}">
                <button type="submit" class="btn btn-outline-danger text-wrap" style="min-height: 44px;" data-testid="discard-import"
                        data-turbo-confirm="{{ 'data_import.detail.discard_confirm'|trans }}">
                    <i class="bi bi-trash me-1"></i>{{ 'data_import.detail.discard'|trans }}
                </button>
            </form>
        </div>
    {% endif %}
</div>
{% endblock %}
