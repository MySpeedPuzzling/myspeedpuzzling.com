{% extends 'base.html.twig' %}

{#
    The public guide of the spreadsheet import (docs/features/data-import/entry-points.md). Like the platform guide:
    all 6 locales, no screenshots (they go stale and are in one language), short sections that make sense on their
    own. The anchors are linked from elsewhere - ImportGuideControllerTest pins them. It promises only what is built:
    "What it does not do yet" is the docs' "left for later" lists.
#}

{% block title %}{{ 'import_guide.meta.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'import_guide.meta.description'|trans }}{% endblock %}

{% block content %}
    <div class="guide-steps mx-auto pb-4" data-testid="import-guide">
        <header class="mb-4">
            <h1 class="h2 mb-1"><i class="bi bi-file-earmark-spreadsheet text-primary me-2" aria-hidden="true"></i>{{ 'import_guide.title'|trans }}</h1>
            <p class="fs-lg text-muted mb-3">{{ 'import_guide.lead'|trans }}</p>
            {{ block('start_buttons') }}
        </header>

        <section class="guide-step" id="what">
            <h2 class="h5">{{ 'import_guide.what.title'|trans }}</h2>
            <ul class="mb-0 ps-3">
                {% for item in ['results', 'owned', 'wish_list', 'formats', 'apps', 'fields'] %}
                    <li class="mb-1">{{ ('import_guide.what.' ~ item)|trans|raw }}</li>
                {% endfor %}
            </ul>
        </section>

        <section class="guide-step" id="how">
            <h2 class="h5 mb-3">{{ 'import_guide.how.title'|trans }}</h2>
            <ol class="list-unstyled mb-0">
                {% for number in 1..6 %}
                    <li class="d-flex gap-2 mb-3">
                        <span class="guide-step-marker" aria-hidden="true">{{ number }}</span>
                        <span>
                            <strong class="d-block">{{ ('import_guide.how.step' ~ number ~ '.title')|trans }}</strong>
                            {{ ('import_guide.how.step' ~ number ~ '.text')|trans }}
                        </span>
                    </li>
                {% endfor %}
            </ol>
        </section>

        <section class="guide-step" id="your-file">
            <h2 class="h5">{{ 'import_guide.file.title'|trans }}</h2>
            <ul class="mb-0 ps-3">
                <li class="mb-1">{{ 'import_guide.file.only_you'|trans }}</li>
                <li class="mb-1">{{ 'import_guide.file.kept'|trans({'%days%': keep_days}) }}</li>
                <li class="mb-1">{{ 'import_guide.file.google'|trans }}</li>
                <li class="mb-1">{{ 'import_guide.file.discard'|trans }}</li>
            </ul>
        </section>

        <section class="guide-step" id="never-twice">
            <h2 class="h5">{{ 'import_guide.never_twice.title'|trans }}</h2>
            <p class="mb-0">{{ 'import_guide.never_twice.text'|trans }}</p>
        </section>

        <section class="guide-step" id="take-back">
            <h2 class="h5">{{ 'import_guide.take_back.title'|trans }}</h2>
            <p class="mb-0">{{ 'import_guide.take_back.text'|trans }}</p>
        </section>

        <section class="guide-step" id="imported-result">
            <h2 class="h5">{{ 'import_guide.result.title'|trans }}</h2>
            <ul class="mb-0 ps-3">
                {% for item in ['counts', 'dated', 'photo', 'partners', 'unusual', 'limit'] %}
                    <li class="mb-1">{{ ('import_guide.result.' ~ item)|trans }}</li>
                {% endfor %}
            </ul>
        </section>

        <section class="guide-step" id="unlisted">
            <h2 class="h5">{{ 'import_guide.unlisted.title'|trans }}</h2>
            <p class="mb-0">{{ 'import_guide.unlisted.text'|trans }}</p>
        </section>

        <section class="guide-step" id="not-yet">
            <h2 class="h5">{{ 'import_guide.not_yet.title'|trans }}</h2>
            <ul class="mb-0 ps-3">
                {% for item in ['old_formats', 'photos', 'lists', 'events', 'own_columns', 'unlisted', 'sync'] %}
                    <li class="mb-1">{{ ('import_guide.not_yet.' ~ item)|trans }}</li>
                {% endfor %}
            </ul>
        </section>

        <section id="start" style="scroll-margin-top: calc(var(--header-height, 100px) + 1rem);">
            <h2 class="h5">{{ 'import_guide.start.title'|trans }}</h2>
            <p>{{ 'import_guide.start.text'|trans }}</p>
            {{ block('start_buttons') }}
        </section>
    </div>
{% endblock %}

{# The way in: a player goes to the import; a guest signs up (or in) and lands on it - `return` is the import's own
   path, checked again where it is used (docs/features/return-url.md) #}
{% block start_buttons %}
    <div class="d-grid d-sm-flex flex-wrap align-items-center gap-2" data-testid="import-guide-start">
        {% if logged_user.profile is not null %}
            <a class="btn btn-primary text-wrap" href="{{ path('data_imports') }}"><i class="bi bi-upload me-1" aria-hidden="true"></i>{{ 'data_import.home.import_button'|trans }}</a>
        {% else %}
            <a class="btn btn-primary text-wrap" rel="nofollow" href="{{ path('register', {return: path('data_imports')}) }}">{{ 'import_guide.start_guest'|trans }}</a>
            <a class="btn btn-link text-wrap" rel="nofollow" href="{{ path('login', {return: path('data_imports')}) }}">{{ 'import_guide.sign_in'|trans }}</a>
        {% endif %}
        <span class="fs-sm text-muted">{{ 'import_guide.free'|trans }}</span>
    </div>
{% endblock %}
