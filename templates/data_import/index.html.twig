{% extends 'base.html.twig' %}

{#
    Imports home - the signed-in player's spreadsheets (docs/features/data-import/upload.md). Phone first: one column
    of cards, every button at least 44 px tall, long file names break.
#}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'data_import.home.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
{% set csrf = csrf_token(constant('SpeedPuzzling\\Web\\Controller\\DataImport\\ImportsHomeController::CSRF_TOKEN_ID')) %}
<div class="mx-auto" style="max-width: 720px;" data-testid="data-imports-page">
    <h1 class="h3 mb-2"><i class="bi bi-file-earmark-spreadsheet me-2"></i>{{ 'data_import.home.title'|trans }}</h1>
    <p class="text-muted">{{ 'data_import.home.intro'|trans }} <a href="{{ path('import_guide') }}" class="text-nowrap" data-testid="import-guide-link">{{ 'import_guide.to_guide'|trans }}</a></p>

    <a href="{{ path('data_import_new') }}" class="btn btn-primary text-wrap d-inline-flex align-items-center mb-4" style="min-height: 44px;" data-testid="import-a-spreadsheet">
        <i class="bi bi-upload me-2"></i>{{ 'data_import.home.import_button'|trans }}
    </a>

    {% if imports is empty %}
        {# The first visit (docs/features/data-import/entry-points.md): the ways to start instead of a bare "No imports yet" #}
        <div class="card card-body shadow-sm p-3 mb-4" data-testid="no-imports">
            <h2 class="h5 mb-3">{{ 'import_guide.first.title'|trans }}</h2>
            <ul class="list-unstyled mb-3">
                {% for way in [
                    {key: 'file', icon: 'bi-file-earmark-arrow-up'},
                    {key: 'google', icon: 'bi-link-45deg'},
                    {key: 'tracker', icon: 'bi-box-arrow-in-right'},
                ] %}
                    <li class="d-flex gap-2 mb-2">
                        <i class="bi {{ way.icon }} text-primary flex-shrink-0" aria-hidden="true"></i>
                        <span><strong>{{ ('import_guide.first.' ~ way.key ~ '.title')|trans }}</strong> - {{ ('import_guide.first.' ~ way.key ~ '.text')|trans }}</span>
                    </li>
                {% endfor %}
            </ul>
            <p class="fs-sm text-muted mb-0" data-testid="import-privacy">
                <i class="bi bi-lock me-1" aria-hidden="true"></i>{{ 'import_guide.file.only_you'|trans }}
                {{ 'data_import.nothing_until_add'|trans }}
                {{ 'data_import.new.kept_note'|trans({'%days%': constant('SpeedPuzzling\\Web\\Value\\DataImportLimits::KEEP_FILE_DAYS')}) }}
            </p>
        </div>
    {% else %}
        {# Finished imports hold none of the player's places: folded below the ones in progress (upload.md "Finished") #}
        {% set in_progress = imports|filter(import => import.status.value != 'done') %}
        {% set finished = imports|filter(import => import.status.value == 'done') %}
        {% if in_progress is not empty %}
            <div class="d-flex flex-column gap-2 mb-4" data-testid="data-imports-in-progress">
                {% for import in in_progress %}
                    {{ include('data_import/_import_card.html.twig', {import: import, added: added, csrf: csrf}) }}
                {% endfor %}
            </div>
        {% endif %}
        {% if finished is not empty %}
            <details class="mb-4" data-testid="data-imports-finished">
                <summary class="fw-medium py-2" style="min-height: 44px; cursor: pointer;">{{ 'data_import.finish.group'|trans({'%number%': finished|length}) }}</summary>
                <div class="d-flex flex-column gap-2 mt-2">
                    {% for import in finished %}
                        {{ include('data_import/_import_card.html.twig', {import: import, added: added, csrf: csrf}) }}
                    {% endfor %}
                </div>
            </details>
        {% endif %}
    {% endif %}

    {# Puzzles of a spreadsheet that are not in the catalogue - the reader's own page (docs/features/data-import/unlisted-puzzles.md) #}
    <p class="fs-sm text-muted mb-0">
        <a href="{{ path('unlisted_puzzles') }}" class="d-inline-flex align-items-center py-2" data-testid="unlisted-puzzles-link"><i class="bi bi-bookmark me-1" aria-hidden="true"></i>{{ 'unlisted_puzzles.link'|trans }}</a>
    </p>
</div>
{% endblock %}
