{% extends 'base.html.twig' %}

{#
    The rows an "Add" took and could not add (docs/features/data-import/adding-screens.md "The lists"): fifty a page,
    each with the reason in a plain sentence and - where it helps - the way to settle it. A question the player may
    wave through ("It is right", "Add it anyway") is one button: the answer is written and the row added again.
    Each form has its own request id, so a double tap adds nothing twice.
#}

{% set hide_comparison_launcher = true %}
{% set import_name = import.fileName != '' ? import.fileName : 'data_import.google.unnamed'|trans %}
{% set csrf = csrf_token(constant('SpeedPuzzling\\Web\\Controller\\DataImport\\ImportsHomeController::CSRF_TOKEN_ID')) %}
{% set to_row = ['needs_exact_day', 'time_too_long', 'too_fast', 'comment_too_long', 'people_do_not_fit_type', 'empty_group', 'first_try_taken', 'unusual_time', 'not_ready'] %}
{% set to_puzzle = ['puzzle_not_available', 'puzzle_not_found', 'puzzle_not_revealed'] %}

{% block title %}{{ 'data_import.not_added.title'|trans }} - {{ import_name }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
{{ include('data_import/_flow_header.html.twig', {import: import, step: 5}) }}

<div class="mx-auto" style="max-width: 720px;" data-testid="import-not-added-page" data-import-flow-screen="not_added_rows" data-rows="{{ counts.notAdded }}">
    <h1 class="h3 mb-2">{{ 'data_import.not_added.title'|trans }}</h1>
    <p class="text-muted fs-sm mb-2">{{ 'data_import.not_added.intro'|trans({'%number%': counts.notAdded|format_number}) }}</p>
    {% if counts.notAdded > 0 %}
        {{ include('data_import/_explain.html.twig', {text: 'data_import.explain.wait_after_add'|trans, testid: 'import-explain-wait'}, with_context = false) }}
    {% endif %}

    {% if people_rows > 0 %}
        {# One answer for all rows that say pair or team and name nobody - never one tap per row. First: it is the
           question one answer settles for the most rows (guided-flow.md §5.10 "ordered by what the player can do") #}
        <div class="card card-body shadow-sm mb-3" id="import-not-added-people" data-testid="import-not-added-people" data-rows="{{ people_rows }}">
            <h2 class="h6 mb-1">{{ 'data_import.not_added.people.title'|trans }}</h2>
            <p class="fs-sm text-muted mb-2">{{ 'data_import.not_added.people.hint'|trans({'%number%': people_rows|format_number}) }}</p>
            <form action="{{ path('data_import_not_added_people', {importId: import.importId}) }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf }}">
                <input type="hidden" name="request_id" value="{{ people_request_id }}">
                {% if batch_id is not null %}<input type="hidden" name="batch" value="{{ batch_id }}">{% endif %}
                <label for="import-people-names" class="form-label fs-sm fw-medium">{{ 'data_import.not_added.people.names'|trans }}</label>
                <input type="text" id="import-people-names" name="names" class="form-control mb-2" style="font-size: 16px; min-height: 44px;" maxlength="300" autocomplete="off">
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" name="action" value="guests" class="btn btn-outline-primary text-wrap" style="min-height: 44px;" data-testid="import-not-added-people-guests">
                        <i class="bi bi-people me-1" aria-hidden="true"></i>{{ 'data_import.not_added.people.submit'|trans({'%number%': people_rows|format_number}) }}
                    </button>
                    <button type="submit" name="action" value="solo" class="btn btn-link text-wrap" style="min-height: 44px;" data-testid="import-not-added-people-solo">
                        {{ 'data_import.not_added.people.solo'|trans({'%number%': people_rows|format_number}) }}
                    </button>
                </div>
            </form>
        </div>
    {% endif %}


    {# One answer for a whole group of rows - all rows of a reason, not only the fifty of this page #}
    {{ include('data_import/_group_cards.html.twig', {import_id: import.importId, batch_id: batch_id, reasons: reasons, group_request_ids: group_request_ids, csrf: csrf}) }}

    {% if rows is empty %}
        <p class="text-muted" data-testid="import-not-added-none">{{ 'data_import.not_added.none'|trans }}</p>
    {% else %}
        <div class="d-flex flex-column gap-2">
            {% for row in rows %}
                {% set code = row.failure ?? 'error' %}
                {% set sentence = ('data_import.reason.' ~ code)|trans %}
                <div class="card card-body shadow-sm p-3" data-testid="import-not-added-row" data-row-id="{{ row.rowId }}" data-code="{{ code }}">
                    {{ include('data_import/_add_row.html.twig', {row: row}) }}
                    <p class="fs-sm mt-2 mb-2" data-testid="import-not-added-why">
                        <i class="bi bi-eye me-1 text-warning" aria-hidden="true"></i>{{ sentence == 'data_import.reason.' ~ code ? 'data_import.reason.error'|trans : sentence }}
                    </p>
                    {% for other in row.alsoWaitsWith %}
                        {# Asked once: the other question the same "Add" found on the row - one answer covers both #}
                        <p class="fs-sm mb-2" data-testid="import-not-added-also" data-code="{{ other }}">
                            <i class="bi bi-plus-circle me-1 text-warning" aria-hidden="true"></i>{{ 'data_import.once.row_also'|trans }} {{ ('data_import.reason.' ~ other)|trans }} {{ 'data_import.once.row_covers'|trans }}
                        </p>
                    {% endfor %}
                    {% if code in ['similar_result_exists', 'somebody_elses_result'] %}
                        {{ include('data_import/_explain.html.twig', {text: 'data_import.explain.possible_duplicate'|trans, fold: true, testid: 'import-explain-duplicate'}, with_context = false) }}
                    {% endif %}
                    {% if beside[row.rowId] is defined %}
                        {# What the question is about: the result that is there already - before "Add it anyway" #}
                        <div class="fs-sm border rounded-3 p-2 mb-2" data-testid="import-not-added-beside">
                            <div class="text-muted">{{ (code == 'similar_result_exists' ? 'data_import.not_added.beside_own' : 'data_import.not_added.beside_other')|trans }}</div>
                            {% for result in beside[row.rowId] %}
                                <div class="fw-medium" data-testid="import-not-added-beside-result">
                                    {%- if result.seconds is not null %}{{ '%d:%02d:%02d'|format(result.seconds // 3600, (result.seconds % 3600) // 60, result.seconds % 60) }} · {% endif -%}
                                    {{ result.precision.value == 'day' ? result.day|format_date('medium', timezone='UTC') : result_date(result.day, result.precision, 'medium') }} · {{ ('data_import.add.type.' ~ result.type)|trans }}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                    <div class="d-flex flex-wrap gap-2">
                        {% if code != 'unlisted_not_yet' %}
                            <form action="{{ path('data_import_add_start', {importId: import.importId}) }}" method="post" class="d-flex flex-wrap gap-2">
                                <input type="hidden" name="_token" value="{{ csrf }}">
                                <input type="hidden" name="request_id" value="{{ request_ids[row.rowId] }}">
                                <input type="hidden" name="rows[]" value="{{ row.rowId }}">
                                {% if batch_id is not null %}<input type="hidden" name="batch" value="{{ batch_id }}">{% endif %}
                                {% if code in wavable %}
                                    {% for other in row.alsoWaitsWith %}<input type="hidden" name="anyway_also[]" value="{{ other }}">{% endfor %}
                                    <button type="submit" name="anyway" value="{{ code }}" class="btn btn-outline-primary text-wrap" style="min-height: 44px;" data-testid="import-not-added-anyway">
                                        <i class="bi bi-check2 me-1" aria-hidden="true"></i>{{ (code == 'unusual_time' ? 'data_import.not_added.right' : 'data_import.not_added.anyway')|trans }}
                                    </button>
                                {% else %}
                                    <button type="submit" class="btn btn-outline-primary text-wrap" style="min-height: 44px;" data-testid="import-not-added-again">
                                        <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>{{ 'data_import.not_added.again'|trans }}
                                    </button>
                                {% endif %}
                            </form>
                        {% endif %}
                        {% if code in to_row and row.state == 'waiting' %}
                            <a href="{{ path('data_import_row', {importId: import.importId, rowId: row.rowId}) }}" class="btn btn-outline-primary text-wrap d-inline-flex align-items-center" style="min-height: 44px;" data-testid="import-not-added-open">
                                <i class="bi bi-pencil me-1" aria-hidden="true"></i>{{ 'data_import.row.open'|trans }}
                            </a>
                        {% endif %}
                        {% if code in to_puzzle and row.importPuzzleId is not null %}
                            <a href="{{ path('data_import_puzzle_choose', {importId: import.importId, importPuzzleId: row.importPuzzleId}) }}" class="btn btn-outline-primary text-wrap d-inline-flex align-items-center" style="min-height: 44px;" data-testid="import-not-added-choose">
                                <i class="bi bi-hand-index-thumb me-1" aria-hidden="true"></i>{{ 'data_import.not_added.choose_again'|trans }}
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        {{ include('data_import/_pages.html.twig', {page: page, pages: pages, route: 'data_import_not_added', parameters: batch_id is null ? {importId: import.importId} : {importId: import.importId, batch: batch_id}, label: 'data_import.not_added.title'|trans}) }}
    {% endif %}

    {{ include('data_import/_flow_footer.html.twig', {import: import, continue_after: 'add'}, with_context = false) }}
</div>
{% endblock %}
