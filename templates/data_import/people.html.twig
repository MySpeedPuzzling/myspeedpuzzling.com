{% extends 'base.html.twig' %}

{#
    "People in your file" (docs/features/data-import/people.md): every distinct person the import's results name -
    rows, two examples, who they are. A code of the file became the player by itself; a name is a guest unless the
    importing player says who it is - one of their own people that could be it, a typed player code, or "that is
    me". One plain form per person; with a script an answer is shown in place - the person's card as it stands
    after it, nothing scrolls (_person.html.twig, docs/features/data-import/people.md "Answers in place"). Phone
    first: one column, every target 44 px.
#}

{% set hide_comparison_launcher = true %}
{% set import_name = import.fileName != '' ? import.fileName : 'data_import.google.unnamed'|trans %}
{% set csrf = csrf_token(constant('SpeedPuzzling\\Web\\Controller\\DataImport\\ImportsHomeController::CSRF_TOKEN_ID')) %}

{% block title %}{{ 'data_import.people.title'|trans }} - {{ import_name }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
{{ include('data_import/_flow_header.html.twig', {import: import, step: 3}) }}

<div class="mx-auto" style="max-width: 720px;" data-testid="import-people-page" data-import-flow-screen="people"
     {{ include('data_import/_answers_controller.html.twig', with_context = false) }}>
    <h1 class="h3 mb-2">{{ 'data_import.people.title'|trans }}</h1>
    <p class="text-muted fs-sm">{{ 'data_import.people.intro'|trans }}</p>
    {{ include('data_import/_explain.html.twig', {text: 'data_import.explain.guest'|trans, testid: 'import-explain-guest'}, with_context = false) }}

    {% if rows_added > 0 %}
        <div class="alert alert-info fs-sm d-flex gap-2" data-testid="import-people-added-note">
            <i class="bi bi-info-circle flex-shrink-0" aria-hidden="true"></i>
            <span>{{ 'data_import.people.added_note'|trans }}</span>
        </div>
    {% endif %}

    {% if people is empty %}
        <div class="card card-body shadow-sm mb-3 text-muted" data-testid="import-people-none">{{ 'data_import.people.none'|trans }}</div>
    {% endif %}

    {# Names answered in an earlier file: offered, never applied by themselves - one tap takes them all #}
    {% set remembered_people = people|filter(person => person.rememberedChoice is not null) %}
    {% if remembered_people|length > 1 %}
        <div class="card card-body shadow-sm mb-3 border-primary" id="import-people-remembered" data-testid="import-people-remembered" data-import-answers-scope data-people="{{ remembered_people|length }}">
            <h2 class="h6 mb-1">{{ 'data_import.people.remembered.all_title'|trans }}</h2>
            <p class="fs-sm text-muted mb-2">{{ 'data_import.people.remembered.all_hint'|trans }}</p>
            <form action="{{ path('data_import_people_decide', {importId: import.importId}) }}" method="post" data-import-answer>
                <input type="hidden" name="_token" value="{{ csrf }}">
                <button type="submit" name="answer" value="remembered_all" class="btn btn-outline-primary text-wrap" style="min-height: 44px;" data-testid="import-people-remembered-all">{{ 'data_import.people.remembered.all'|trans }}</button>
            </form>
        </div>
    {% endif %}

    {# The cards are one element: "Yes, still right - for all of them" gets all of them back at once #}
    <div id="import-people-list" data-testid="import-people-list">
        {% for person in people %}
            {{ include('data_import/_person.html.twig') }}
        {% endfor %}
    </div>

    {{ include('data_import/_flow_footer.html.twig', {import: import, continue_after: 'people', offer_add: true}, with_context = false) }}
    {{ include('data_import/_answer_said.html.twig', {said: null}, with_context = false) }}
</div>
{% endblock %}
