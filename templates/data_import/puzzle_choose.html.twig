{% extends 'base.html.twig' %}

{#
    The chooser: one puzzle of the import per screen (docs/features/data-import/pairing-screens.md "The chooser",
    guided-flow.md §6.2). Top to bottom on a phone: how far the round is, what the file says and a few of its rows,
    the puzzles of our database it could be as large picture cards - **the whole card is the button, a tap is the
    answer**; none is highlighted or chosen beforehand, the best fit only stands first (another piece count is asked
    about once more, by the server) - then "None of these" (folded: search our database, keep it just for me, don't
    import it), "Later" (nothing is saved), "Undo the last one" and "Stop here". Inside a round a choice leads on to
    the next puzzle that waits - the puzzles with the most rows first.

    Every form posts to its own route with the version the page showed; nothing of the file is in an address (the
    search is a POST for that reason).

    The screen itself is `_chooser.html.twig` - one element (`#import-chooser`): an answer is shown in place
    (docs/features/data-import/pairing-screens.md "Answers in place") - the next puzzle of the round takes the
    element's place, the address follows, nothing is loaded twice.
#}

{% set hide_comparison_launcher = true %}
{% set import_name = import.fileName != '' ? import.fileName : 'data_import.google.unnamed'|trans %}


{% block title %}{{ 'data_import.puzzles.chooser.title'|trans }} - {{ import_name }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
{{ include('data_import/_flow_header.html.twig', {import: import, step: 4}) }}

<div data-testid="import-puzzle-chooser-page" data-import-flow-screen="puzzle_choose" {{ include('data_import/_answers_controller.html.twig', with_context = false) }}>
    {{ include('data_import/_chooser.html.twig') }}

    {# A tap on a puzzle's card is the answer here - the screen has no other primary button #}
    <div class="mx-auto" style="max-width: 560px;">
        {{ include('data_import/_flow_footer.html.twig', {import: import}, with_context = false) }}
    </div>
    {{ include('data_import/_answer_said.html.twig', {said: null}, with_context = false) }}
</div>
{% endblock %}
