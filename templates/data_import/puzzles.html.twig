{% extends 'base.html.twig' %}

{#
    The Puzzles summary of one import (docs/features/data-import/pairing-screens.md "The summary"): how many
    different puzzles the file holds, the groups the pairing put them in as big tappable rows with their counts,
    the rows already on the profile, the rows that need a look - and one clear next step. It follows a running
    pairing by itself (_setup_live.html.twig in its pairing mode). Phone first: one column, every target 44 px.
#}

{% set hide_comparison_launcher = true %}
{% set import_name = import.fileName != '' ? import.fileName : 'data_import.google.unnamed'|trans %}
{% set icons = {found: 'bi-check-circle', probably: 'bi-question-circle', choose: 'bi-hand-index-thumb', 'not-found': 'bi-search', remembered: 'bi-clock-history'} %}

{% block title %}{{ 'data_import.puzzles.title'|trans }} - {{ import_name }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
{{ include('_page_crumbs.html.twig', {levels: [
    {name: 'data_import.home.title'|trans, url: path('data_imports')},
    {name: import_name, url: path('data_import_detail', {importId: import.importId})},
]}) }}

<div class="mx-auto" style="max-width: 720px;" data-testid="import-puzzles-page">
    <h1 class="h3 mb-2">{{ 'data_import.puzzles.title'|trans }}</h1>
    <p class="text-muted fs-sm">{{ 'data_import.puzzles.intro'|trans }}</p>

    {{ include('data_import/_setup_live.html.twig', {import_id: import.importId, working: live.working, revision: live.revision, pairing: true}) }}

    <turbo-frame id="import-puzzles-live" data-import-live target="_top">
        <p class="fw-medium mb-1" data-testid="import-puzzles-count">{{ 'data_import.puzzles.count'|trans({'%number%': overview.puzzles|format_number}) }}</p>
        {% if overview.searching > 0 %}
            <p class="fs-sm text-muted mb-1" data-testid="import-puzzles-searching">{{ 'data_import.pairing.searching'|trans({'%number%': overview.searching|format_number}) }}</p>
        {% endif %}

        {# One clear next step: the first group that needs the player #}
        {% set next = overview.nextGroup %}
        <div class="my-3" data-testid="import-puzzles-next" data-next="{{ next ?? (overview.rowsNeedLook > 0 ? 'to-fix' : 'nothing') }}">
            {% if next in ['choose', 'not-found'] %}
                <a href="{{ path('data_import_puzzle_next', {importId: import.importId, group: next}) }}" class="btn btn-primary btn-lg w-100 text-wrap d-flex align-items-center justify-content-center" style="min-height: 52px;" rel="nofollow">
                    <i class="bi {{ icons[next] }} me-2" aria-hidden="true"></i>{{ ('data_import.puzzles.next.' ~ next|replace({'-': '_'}))|trans }}
                </a>
            {% elseif next is not null %}
                <a href="{{ path('data_import_puzzle_group', {importId: import.importId, group: next}) }}" class="btn btn-primary btn-lg w-100 text-wrap d-flex align-items-center justify-content-center" style="min-height: 52px;">
                    <i class="bi {{ icons[next] }} me-2" aria-hidden="true"></i>{{ ('data_import.puzzles.next.' ~ next|replace({'-': '_'}))|trans }}
                </a>
            {% elseif overview.rowsNeedLook > 0 %}
                <a href="{{ path('data_import_to_fix', {importId: import.importId}) }}" class="btn btn-primary btn-lg w-100 text-wrap d-flex align-items-center justify-content-center" style="min-height: 52px;">
                    <i class="bi bi-eye me-2" aria-hidden="true"></i>{{ 'data_import.puzzles.next.to_fix'|trans }}
                </a>
            {% elseif overview.puzzles > 0 and not live.working %}
                <p class="alert alert-success fs-sm mb-0"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.next.nothing'|trans }}</p>
            {% endif %}
        </div>

        <div class="list-group shadow-sm mb-3" data-testid="import-puzzle-groups">
            {% for group in ['found', 'probably', 'choose', 'not-found', 'remembered'] %}
                {% set counts = overview.groups[group] %}
                {% if group != 'remembered' or counts.total > 0 %}
                    <a href="{{ path('data_import_puzzle_group', {importId: import.importId, group: group}) }}"
                       class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" style="min-height: 64px;"
                       data-testid="import-puzzle-group" data-group="{{ group }}" data-total="{{ counts.total }}" data-open="{{ counts.open }}">
                        <i class="bi {{ icons[group] }} fs-4 {{ counts.open > 0 ? 'text-warning' : 'text-muted' }} flex-shrink-0" aria-hidden="true"></i>
                        <span class="flex-grow-1" style="min-width: 0;">
                            <span class="d-block fw-semibold">{{ ('data_import.puzzles.group.' ~ group|replace({'-': '_'}) ~ '.title')|trans }}</span>
                            <span class="d-block fs-sm text-muted">{{ ('data_import.puzzles.group.' ~ group|replace({'-': '_'}) ~ '.hint')|trans }}</span>
                            <span class="d-block fs-sm {{ counts.open > 0 ? 'fw-medium' : 'text-muted' }}" data-testid="import-puzzle-group-counts">
                                {{- (counts.open > 0 ? 'data_import.puzzles.group_counts' : 'data_import.puzzles.group_all_done')|trans({'%total%': counts.total|format_number, '%open%': counts.open|format_number}) -}}
                            </span>
                        </span>
                        <i class="bi bi-chevron-right text-muted flex-shrink-0" aria-hidden="true"></i>
                    </a>
                {% endif %}
            {% endfor %}
        </div>

        <div class="list-group shadow-sm mb-3">
            <a href="{{ path('data_import_to_fix', {importId: import.importId}) }}" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" style="min-height: 64px;"
               data-testid="import-puzzles-to-fix" data-rows="{{ overview.rowsNeedLook }}">
                <i class="bi bi-eye fs-4 {{ overview.rowsNeedLook > 0 ? 'text-warning' : 'text-muted' }} flex-shrink-0" aria-hidden="true"></i>
                <span class="flex-grow-1" style="min-width: 0;">
                    <span class="d-block fw-semibold">{{ 'data_import.puzzles.need_look'|trans({'%number%': overview.rowsNeedLook|format_number}) }}</span>
                    <span class="d-block fs-sm text-muted">{{ 'data_import.puzzles.need_look_hint'|trans }}</span>
                </span>
                <i class="bi bi-chevron-right text-muted flex-shrink-0" aria-hidden="true"></i>
            </a>
            {% if overview.rowsAlreadyYours > 0 %}
                {# Nothing to do: folded, with the count #}
                <details class="list-group-item py-0" data-testid="import-puzzles-already-yours" data-rows="{{ overview.rowsAlreadyYours }}">
                    <summary class="d-flex align-items-center gap-3 py-3" style="min-height: 64px; cursor: pointer;">
                        <i class="bi bi-person-check fs-4 text-muted flex-shrink-0" aria-hidden="true"></i>
                        <span class="fw-semibold">{{ 'data_import.puzzles.already_yours'|trans({'%number%': overview.rowsAlreadyYours|format_number}) }}</span>
                    </summary>
                    <p class="fs-sm text-muted pb-3 mb-0">{{ 'data_import.puzzles.already_yours_hint'|trans }}</p>
                </details>
            {% endif %}
        </div>

        {% if overview.unlisted > 0 or overview.leftOut > 0 %}
            <p class="fs-sm text-muted" data-testid="import-puzzles-decided-otherwise">
                {{ 'data_import.puzzles.decided_otherwise'|trans({'%unlisted%': overview.unlisted|format_number, '%left_out%': overview.leftOut|format_number}) }}
            </p>
        {% endif %}
    </turbo-frame>

    <div class="alert alert-info fs-sm d-flex gap-2" data-testid="import-soon">
        <i class="bi bi-info-circle flex-shrink-0" aria-hidden="true"></i>
        <span>{{ 'data_import.puzzles.soon'|trans }}</span>
    </div>

    <a href="{{ path('data_import_columns', {importId: import.importId}) }}" class="btn btn-link px-0" style="min-height: 44px;">
        <i class="bi bi-columns-gap me-1" aria-hidden="true"></i>{{ 'data_import.columns.open'|trans }}
    </a>
</div>
{% endblock %}
