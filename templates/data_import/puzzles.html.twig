{% extends 'base.html.twig' %}

{#
    Step 4, the overview (docs/features/data-import/guided-flow.md §5.7): how many of the file's puzzles are
    matched, and the rest in piles - "Looks like a match", "Pick the right one", "Not in our database" - each with
    its count, one sentence of what it costs and its explanation in place (§12). A pile nothing waits in is not
    shown. ONE primary: the first pile that waits. What is matched is a link ("Matched (353) - see them", where
    every card has "Wrong puzzle"). It follows a running look-up by itself (_setup_live.html.twig). Phone first:
    one column, every target 44 px.
#}

{% set hide_comparison_launcher = true %}
{% set import_name = import.fileName != '' ? import.fileName : 'data_import.google.unnamed'|trans %}
{% set icons = {found: 'bi-check-circle', probably: 'bi-question-circle', choose: 'bi-hand-index-thumb', 'not-found': 'bi-search', remembered: 'bi-clock-history'} %}

{% block title %}{{ 'data_import.puzzles.title'|trans }} - {{ import_name }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
{{ include('data_import/_flow_header.html.twig', {import: import, step: 4}) }}

<div class="mx-auto" style="max-width: 720px;" data-testid="import-puzzles-page" data-import-flow-screen="puzzles">
    <h1 class="h3 mb-2">{{ 'data_import.puzzles.title'|trans }}</h1>

    {{ include('data_import/_setup_live.html.twig', {import_id: import.importId, working: live.working, revision: live.revision, pairing: true}) }}

    <turbo-frame id="import-puzzles-live" data-import-live target="_top">
        {% set next = overview.nextGroup %}
        {% set waiting = overview.open %}
        {% set explains = {probably: 'looks_like_a_match', choose: 'pick_the_right_one', 'not-found': 'not_in_database', found: 'wrong_puzzle'} %}

        <p class="fw-medium mb-1" data-testid="import-puzzles-count" data-puzzles="{{ overview.puzzles }}" data-matched="{{ overview.matched }}">
            {%- if overview.puzzles > 0 and overview.matched == overview.puzzles -%}
                {{ 'data_import.flow.puzzles.all_matched'|trans({'%count%': overview.puzzles, '%number%': overview.puzzles|format_number}) }}
            {%- else -%}
                {{ 'data_import.puzzles.we_found'|trans({'%found%': overview.matched|format_number, '%puzzles%': overview.puzzles|format_number}) }}
            {%- endif -%}
        </p>
        {% if overview.puzzles > 0 %}
            <div class="progress mb-2" style="height: 8px;" role="img" aria-hidden="true">
                <div class="progress-bar bg-success" style="width: {{ (overview.matched * 100 / overview.puzzles)|round(0, 'floor') }}%;"></div>
            </div>
        {% endif %}
        {% if overview.searching > 0 %}
            <p class="fs-sm text-muted mb-1" data-testid="import-puzzles-searching">{{ 'data_import.flow.puzzles.searching'|trans({'%count%': overview.searching, '%number%': overview.searching|format_number}) }}</p>
        {% endif %}

        {# One clear next step - the first pile that needs the player: it is the screen's ONE primary, at its end #}
        <div class="my-3" data-testid="import-puzzles-next" data-next="{{ next ?? (overview.rowsNeedLook > 0 ? 'to-fix' : 'nothing') }}">
            {% if waiting > 0 %}
                <p class="mb-0" data-testid="import-puzzles-waiting">{{ 'data_import.puzzles.bulk.overview.wait'|trans({'%count%': waiting, '%number%': waiting|format_number}) }}</p>
            {% elseif overview.puzzles > 0 and overview.searching == 0 and not live.working %}
                <p class="alert alert-success fs-sm mb-0"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.next.nothing'|trans }}</p>
            {% endif %}
        </div>

        <div data-testid="import-puzzle-groups">
            {% for group in ['probably', 'choose', 'not-found', 'found'] %}
                {% set counts = overview.groups[group] %}
                {% if counts.open > 0 %}
                    <div class="card shadow-sm mb-2" data-testid="import-puzzle-group" data-group="{{ group }}" data-total="{{ counts.total }}" data-open="{{ counts.open }}">
                        <a href="{{ path('data_import_puzzle_group', {importId: import.importId, group: group}) }}" class="d-flex align-items-center gap-3 px-3 pt-3 pb-1 text-decoration-none text-body" style="min-height: 56px;">
                            <i class="bi {{ icons[group] }} fs-4 text-warning flex-shrink-0" aria-hidden="true"></i>
                            <span class="flex-grow-1" style="min-width: 0;">
                                <span class="d-flex justify-content-between align-items-baseline gap-2">
                                    <span class="fw-semibold">{{ (group == 'found' ? 'data_import.puzzles.bulk.pile.found.title' : 'data_import.puzzles.group.' ~ group|replace({'-': '_'}) ~ '.title')|trans }}</span>
                                    <span class="fw-semibold text-nowrap" data-testid="import-puzzle-group-open">{{ counts.open|format_number }}{% if group == 'not-found' and overview.searching > 0 %}…{% endif %}</span>
                                </span>
                                <span class="d-block fs-sm" data-testid="import-puzzle-group-cost">
                                    {{- ('data_import.puzzles.bulk.pile.' ~ group|replace({'-': '_'}) ~ '.cost')|trans -}}
                                    {%- if group == 'probably' %} {% set minutes = max(1, (counts.open / 40)|round(0, 'ceil')) %}{{ 'data_import.puzzles.bulk.pile.minutes'|trans({'%count%': minutes, '%number%': minutes|format_number}) }}{% endif -%}
                                </span>
                            </span>
                            <i class="bi bi-chevron-right text-muted flex-shrink-0" aria-hidden="true"></i>
                        </a>
                        <div class="px-3 pt-1">
                            {{ include('data_import/_explain.html.twig', {text: ('data_import.explain.' ~ explains[group])|trans, testid: 'import-explain-' ~ group}, with_context = false) }}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        {% if overview.rowsNeedLook > 0 %}
            <p class="fs-sm mb-2">
                <a href="{{ path('data_import_to_fix', {importId: import.importId}) }}" class="d-inline-flex align-items-center" style="min-height: 44px;" data-testid="import-puzzles-to-fix" data-rows="{{ overview.rowsNeedLook }}">
                    <i class="bi bi-eye me-2" aria-hidden="true"></i>{{ 'data_import.puzzles.need_look'|trans({'%number%': overview.rowsNeedLook|format_number}) }}
                </a>
            </p>
        {% endif %}

        {# The ONE primary: the first pile with something waiting - else on to the next step. Under it, what is
           ready to be added now (docs/features/data-import/guided-flow.md §2 rule 4) #}
        {% set ready = add.canAdd and add.runningBatchId is null and not add.paused ? add.toAdd : 0 %}
        {% if add.paused %}
            <p class="fs-sm text-muted" data-testid="import-ready-paused"><i class="bi bi-pause-circle me-1" aria-hidden="true"></i>{{ 'data_import.add.paused'|trans }}</p>
        {% endif %}
        {% if next is not null %}
            {{ include('data_import/_flow_footer.html.twig', {import: import, ready: ready, primary: {
                label: ('data_import.puzzles.next.' ~ next|replace({'-': '_'}))|trans,
                url: path('data_import_puzzle_group', {importId: import.importId, group: next}),
                icon: icons[next], testid: 'import-puzzles-next-button',
            }}, with_context = false) }}
        {% elseif live.working or overview.searching > 0 %}
            {{ include('data_import/_flow_footer.html.twig', {import: import, ready: ready}, with_context = false) }}
        {% else %}
            {{ include('data_import/_flow_footer.html.twig', {import: import, continue_after: 'puzzles'}, with_context = false) }}
        {% endif %}

        {# What needs nobody: folded away as plain links, each with its count #}
        <div class="mt-3 fs-sm" data-testid="import-puzzles-settled">
            {% if overview.groups.found.total > 0 %}
                <a href="{{ path('data_import_puzzle_group', {importId: import.importId, group: 'found'}) }}" class="d-flex align-items-center" style="min-height: 44px;" data-testid="import-puzzles-matched-link" data-total="{{ overview.groups.found.total }}">
                    <i class="bi bi-chevron-right me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.bulk.overview.see_matched'|trans({'%number%': overview.groups.found.total|format_number}) }}
                </a>
            {% endif %}
            {% if overview.groups.remembered.total > 0 %}
                <a href="{{ path('data_import_puzzle_group', {importId: import.importId, group: 'remembered'}) }}" class="d-flex align-items-center" style="min-height: 44px;" data-testid="import-puzzles-remembered-link" data-total="{{ overview.groups.remembered.total }}">
                    <i class="bi bi-chevron-right me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.bulk.overview.see_remembered'|trans({'%number%': overview.groups.remembered.total|format_number}) }}
                </a>
            {% endif %}
            {% if overview.unlisted > 0 %}
                <a href="{{ path('data_import_puzzle_group', {importId: import.importId, group: 'not-found', page: 1}) }}" class="d-flex align-items-center" style="min-height: 44px;" data-testid="import-puzzles-kept-link" data-total="{{ overview.unlisted }}">
                    <i class="bi bi-chevron-right me-1" aria-hidden="true"></i>{{ 'data_import.puzzles.bulk.overview.kept'|trans({'%number%': overview.unlisted|format_number}) }}
                </a>
            {% endif %}
            {% if overview.leftOut > 0 %}
                <p class="text-muted d-flex align-items-center mb-0" style="min-height: 44px;" data-testid="import-puzzles-not-imported" data-total="{{ overview.leftOut }}">{{ 'data_import.puzzles.bulk.overview.not_imported'|trans({'%number%': overview.leftOut|format_number}) }}</p>
            {% endif %}
            {% if overview.rowsAlreadyYours > 0 %}
                {# Nothing to do: folded, with the count #}
                <details data-testid="import-puzzles-already-yours" data-rows="{{ overview.rowsAlreadyYours }}">
                    <summary class="d-flex align-items-center" style="min-height: 44px; cursor: pointer;">{{ 'data_import.puzzles.already_yours'|trans({'%number%': overview.rowsAlreadyYours|format_number}) }}</summary>
                    <p class="text-muted mb-0">{{ 'data_import.puzzles.already_yours_hint'|trans }}</p>
                </details>
            {% endif %}
        </div>
    </turbo-frame>
</div>
{% endblock %}
