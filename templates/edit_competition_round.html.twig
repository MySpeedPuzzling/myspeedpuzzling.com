{% extends 'base.html.twig' %}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'competition.edit_round'|trans }} - {{ competition.name }}{% endblock %}

{% block content %}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events.title'|trans, url: path('events')},
        {label: competition.name, url: path('edit_competition', {competitionId: competition.id})},
        {label: 'competition.manage_rounds'|trans, url: path('manage_competition_rounds', {competitionId: competition.id})},
        {label: round.name},
    ]}) }}
    {{ include('_return_back_button.html.twig', {fallbackUrl: path('manage_competition_rounds', {competitionId: competition.id}), fallbackTitle: 'competition.manage_rounds'|trans}) }}

    <div class="pb-4">
        <div class="row gy-3 pb-3">
            <div class="col-lg-8">
                <h1 class="h2">{{ 'competition.edit_round'|trans }}: {{ round.name }}</h1>
                <p class="text-muted">{{ competition.name }}</p>

                <div class="mb-3">
                    <a href="{{ path('manage_round_puzzles', {'roundId': round.id, return: path('edit_competition_round', {roundId: round.id}), return_title: 'competition.edit_round'|trans}) }}" class="btn btn-outline-primary">
                        <i class="bi bi-puzzle me-1"></i>{{ 'competition.manage_puzzles'|trans }}
                    </a>
                </div>

                {% for flash_message in app.flashes('success') %}
                    <div class="alert alert-success">
                        <i class="ci-check-circle me-2"></i>
                        {{ flash_message }}
                    </div>
                {% endfor %}

                <div class="card shadow my-4">
                    <div class="card-body">
                        {{ form_start(form) }}
                            {{ form_row(form.name) }}
                            {{ form_row(form.category) }}
                            {{ form_row(form.minutesLimit) }}

                            {% if single_day is not null %}
                                <div class="mb-3">
                                    <label class="form-label">{{ 'competition.round.form.date'|trans }}</label>
                                    <div class="form-control-plaintext fw-medium">
                                        <i class="ci-calendar me-1"></i>{{ single_day|date('d.m.Y', false) }}
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-6">
                                        {{ form_label(form.startsAtTime) }}
                                        <div class="input-group">
                                            {{ form_widget(form.startsAtTime, {'attr': {'class': 'form-control rounded date-picker pe-5', 'data-datepicker-options': '{"noCalendar": true, "enableTime": true, "time_24hr": true, "dateFormat": "H:i"}'}}) }}
                                            <i class="bi bi-clock position-absolute top-50 end-0 translate-middle-y me-3" style="pointer-events: none;"></i>
                                        </div>
                                        {{ form_errors(form.startsAtTime) }}
                                    </div>
                                    <div class="col-6">
                                        {{ form_row(form.timezone) }}
                                    </div>
                                </div>
                            {% else %}
                                <div class="mb-3">
                                    {{ form_label(form.startsAt) }}
                                    <div class="input-group">
                                        {{ form_widget(form.startsAt, {'attr': {'class': 'form-control rounded date-picker pe-5', 'data-datepicker-options': '{"altInput": true, "altFormat": "d.m.Y H:i", "dateFormat": "d.m.Y H:i", "enableTime": true, "time_24hr": true}'}}) }}
                                        <i class="ci-calendar position-absolute top-50 end-0 translate-middle-y me-3" style="pointer-events: none;"></i>
                                    </div>
                                    {{ form_errors(form.startsAt) }}
                                </div>
                                {{ form_row(form.timezone) }}
                            {% endif %}
                            <div class="row">
                                <div class="col-12">{{ form_row(form.resultsLink) }}</div>
                                <div class="col-6">{{ form_row(form.badgeBackgroundColor) }}</div>
                                <div class="col-6">{{ form_row(form.badgeTextColor) }}</div>
                            </div>

                            {# Only asked when the new start would reveal secret puzzles right away (EditCompetitionRoundController) #}
                            {% if form.confirmReveal is defined %}
                                {% if revealed_right_away is not empty %}
                                    <div class="alert alert-warning" data-confirm-reveal>
                                        <p class="mb-2">{{ 'competition.reveal.form.confirm_reveal_list'|trans }}</p>
                                        <ul class="mb-2">
                                            {% for item in revealed_right_away %}
                                                <li>
                                                    <strong>{{ item.name }}</strong>
                                                    {% if not item.everywhere %}
                                                        <span class="text-muted">– {{ 'competition.reveal.confirm.only_this_event'|trans({'%time%': zoned_datetime(item.hiddenElsewhereUntil, timezone)}) }}</span>
                                                    {% endif %}
                                                </li>
                                            {% endfor %}
                                        </ul>
                                        {# The yes counts only for exactly this list (SecretRevealPreview::hash()) #}
                                        <input type="hidden" name="confirm_reveal_hash" value="{{ reveal_confirmation_hash }}">
                                        {{ form_row(form.confirmReveal) }}
                                    </div>
                                {% else %}
                                    {% do form.confirmReveal.setRendered %}
                                {% endif %}
                            {% endif %}

                            <button type="submit" class="btn btn-primary mt-3">
                                {{ 'competition.save_changes'|trans }}
                            </button>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
