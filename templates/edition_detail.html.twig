{% extends 'base.html.twig' %}

{# The full name - the series in front unless the edition's name mentions it - plus the year when the name
   has none; "Results" once the edition is over and has results here (see EventTitle::saysResults()) - official ones too (official-results.md) #}
{% block title %}
    {%- if event_title.saysResults(results_count) -%}
        {{- 'events.meta.event_detail_title_results'|trans({'%event%': event_title.label}) -}}
    {%- else -%}
        {{- event_title.label -}}
    {%- endif -%}
{% endblock %}

{% block robots %}
    {# An edition of an unapproved or rejected series (or a rejected edition) is reachable at its URL - keep it out of the index #}
    {% if not is_publicly_visible %}
        <meta name="robots" content="noindex, nofollow">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block meta_description %}
    {%- if event_title.saysResults(results_count) -%}
        {{- (event.hasPublishedOfficialResults ? 'series.meta.edition_description_past_official' : 'series.meta.edition_description_past')|trans({
            '%count%': results_count,
            '%results%': results_count|format_number,
            '%name%': event.name,
            '%series%': series.name,
            '%date%': event_title.startsAt|format_date('long'),
        }) -}}
    {%- elseif event_title.startsAt -%}
        {{- 'series.meta.edition_description'|trans({'%name%': event.name, '%series%': series.name, '%date%': event_title.startsAt|format_date('long')}) -}}
    {%- else -%}
        {{- 'series.meta.edition_description_no_date'|trans({'%name%': event.name, '%series%': series.name}) -}}
    {%- endif -%}
{% endblock %}

{% block json_ld %}
{{ parent() }}
{{ include('event_parts/_event_json_ld.html.twig', {meta_description: block('meta_description')|trim}) }}
{% endblock %}

{% block content %}
    {#- The edition page (docs/features/events-page/detail-pages.md "Edition page and one-time event page"): B owns the
        sections below the header, C the JSON-LD -#}
    <div class="ev-detail ev-detail-edition"
        {%- if online %} data-controller="event-local-time" data-event-local-time-messages-value="{{ {
            yours: 'event_detail.time.yours'|trans,
            yours_next_day: 'event_detail.time.yours_next_day'|trans,
            yours_previous_day: 'event_detail.time.yours_previous_day'|trans,
        }|json_encode }}"{% endif %}>
        {{ include('event_parts/_draft_banner.html.twig', {draft_state: draft_state}) }}
        {#- The organization in the crumbs (P20): while it is publicly visible, or for its team -#}
        {%- set show_organization = organization is not null and (organization.isPublic or is_granted('ORGANIZATION_EDIT', organization.id)) -%}
        {% embed 'event_parts/_detail_header.html.twig' with {
            crumbs: [{label: 'events.title'|trans, url: path('events')}]
                |merge(show_organization ? [{label: organization.name, url: path('organization_detail', {slug: organization.slug})}] : [])
                |merge(series.slug ? [{label: series.name, url: path('competition_series_detail', {slug: series.slug})}] : []),
            logo: event.logo ?? series.logo,
            name: event.name,
            description: event.description,
            return_fallback_url: series.slug ? path('competition_series_detail', {slug: series.slug}) : path('events'),
            return_fallback_title: series.slug ? series.name : 'events.title'|trans,
        } %}
            {% block byline %}
                {{- include('event_parts/_organized_by.html.twig', {organization: organization}) -}}
                {{- include('event_parts/_eligibility.html.twig', {eligibility: eligibility}) -}}
            {% endblock %}
            {% block facts %}{{ include('event_parts/_event_header_facts.html.twig', {recurring: true}) }}{% endblock %}
            {% block actions %}{{ include('event_parts/_event_header_actions.html.twig', {follow_kind: 'series', follow_name: series.name}) }}{% endblock %}
        {% endembed %}

        <div class="ev-detail-body">
            <div class="ev-detail-main">
                {{ include('event_parts/_facts_strip_event.html.twig') }}
                {{ include('event_parts/_rounds_timeline.html.twig', {timeline: timeline, event: event, online: online}) }}
                {{ include('event_parts/_more_puzzles.html.twig') }}
                {{ include('event_parts/_taking_part.html.twig') }}

                {{ include('_event_offers.html.twig', {
                    offers: event_offers,
                    competition_id: event.id,
                    attendance: attendance,
                    just_joined: event_offers_just_joined,
                }) }}

                {#- Organiser-written sections (competitions-management/public-page.md): after the marketplace card, before the
                    participants - nothing at all without them -#}
                {% if page_sections is not empty %}{{ include('_page_sections.html.twig', {sections: page_sections}) }}{% endif %}

                <twig:CompetitionParticipants competitionId="{{ event.id }}" class="ev-participants" />
            </div>
            {{ include('event_parts/_detail_side.html.twig') }}
        </div>

        {{ include('event_parts/_manage_menu_host.html.twig', {show_menu: is_granted('IS_AUTHENTICATED_REMEMBERED') and (is_granted('COMPETITION_EDIT', event.id) or is_granted('ADMIN_ACCESS'))}) }}
    </div>
{% endblock %}
