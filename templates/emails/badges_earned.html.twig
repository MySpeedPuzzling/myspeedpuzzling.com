{% trans_default_domain 'emails' %}
{% apply inky_to_html|inline_css(source('@styles/foundation-emails.css'))|email_document %}
    <wrapper>
        <container>
            {{ include('emails/_header.html.twig', {preheader: 'badges_earned.preheader'|trans}) }}

            <row>
                <columns>
                    <spacer size-sm="24"></spacer>
                    <h3>{{ 'badges_earned.title'|trans({'%count%': badges|length}) }}</h3>
                    <spacer size-sm="8"></spacer>
                </columns>
            </row>

            <row>
                <columns>
                    <p>{{ 'badges_earned.intro'|trans }}</p>
                </columns>
            </row>

            <row>
                <columns>
                    <table style="border-collapse: collapse;">
                        {% for entry in badges %}
                            {{ include('emails/_badge_row.html.twig', {
                                type: entry.type,
                                tier: entry.tier,
                                label: (entry.type.translationKey())|trans({}, 'messages', locale),
                                detail: entry.tier ? (entry.tier.translationKey())|trans({}, 'messages', locale) : null,
                            }) }}
                        {% endfor %}
                    </table>
                </columns>
            </row>

            <row>
                <columns>
                    <spacer size-sm="16"></spacer>
                    {{ 'badges_earned.cta'|trans({'%badgesUrl%': url('badges_overview')})|raw }}
                    <spacer size-sm="16"></spacer>
                </columns>
            </row>

            <row>
                <columns>
                    <p>{{ 'badges_earned.outro'|trans }}</p>
                </columns>
            </row>

            {{ include('emails/_footer.html.twig') }}
        </container>
    </wrapper>
{% endapply %}
