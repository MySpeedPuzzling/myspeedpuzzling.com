{# What the sender wrote, quoted in a card (emails/_card_layout.html.twig) - plain text, escaped. Params: note #}
<table role="presentation" width="100%" style="width: 100%; border-collapse: separate; margin: 14px 0 0 0; Margin: 14px 0 0 0;">
    <tr>
        <td bgcolor="#f6f8fb" style="background: #f6f8fb; border-left: 3px solid #e3e7ee; border-radius: 8px; padding: 12px 14px;">
            <p style="-webkit-hyphens: none; hyphens: none; font-size: 15px; line-height: 1.5; font-style: italic; color: #373f50; margin: 0; Margin: 0;">“{{ note }}”</p>
        </td>
    </tr>
</table>
