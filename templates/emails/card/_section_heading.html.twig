{# A card's heading with a small colour square before it (the digest's legend squares) - which kind of section it is
   at a glance; the words say it too. Params: text, color #}
<table role="presentation" width="100%" style="width: 100%; margin: 0 0 8px 0; Margin: 0 0 8px 0;">
    <tr>
        <td width="20" style="width: 20px; vertical-align: middle; padding: 0;">
            <table role="presentation" style="border-collapse: separate;"><tr><td width="12" height="12" bgcolor="{{ color }}" style="width: 12px; height: 12px; font-size: 0; line-height: 12px; background: {{ color }}; border-radius: 3px;">&nbsp;</td></tr></table>
        </td>
        <td style="vertical-align: middle; padding: 0;">
            <h2 style="-webkit-hyphens: none; hyphens: none; font-size: 18px; line-height: 1.3; font-weight: bold; color: #373f50; margin: 0; Margin: 0;">{{ text }}</h2>
        </td>
    </tr>
</table>
