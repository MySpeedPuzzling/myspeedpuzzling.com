{% extends 'emails/content_digest/_layout.html.twig' %}
{% trans_default_domain 'emails' %}
{#
    The activity digest (docs/features/content-digest/README.md §"Content" + §"Design"), one card each:
    1. the period: title, dates, the numbers as label over value (puzzles, pieces - each with its change against the
       period before as a pill -, time, streak);
    2. "How you puzzled": solo / in pairs / in teams as one bar with its legend (only with a pair or team result - a
       group puzzle counts with all its pieces for every member) and the pieces per day (week / two weeks) - bars
       are table cells, never a server-rendered image;
    3. "Your progress": level with XP and a bar to the next level, up to 3 achievements (members see which with
       "+N AP", everybody else only that they earned one), an achievement drop, reveals, a member's next achievement,
       MSP Rating, skill tiers, karma;
    4. the best results with their leaderboard place;
    ONE button to the "Your week" page, the community, the footer. Every line links somewhere. The preheader names the
    best thing of the period. No favourites (Jan 2026-10-19: some players have 100+, it said nothing).
#}
{% set length = period.length.value %}
{% set range_label = length == 'month' ? period.start|events_date('yMMMM') : events_date_range(period.start, period.lastDay(), 'MMMMd') %}
{% set week_url = url('my_activity', {period: period.key, _locale: locale}) %}
{% set best_achievement = activity.achievementsByPoints()|first %}
{% set personal_bests = activity.personalBests() %}
{% set header_link = week_url %}
{% set header_link_label = ('activity_digest.button.' ~ length)|trans %}

{% if activity.isMember and best_achievement %}
    {% set preheader = 'activity_digest.preheader.achievement'|trans({'%achievement%': best_achievement.type.translationKey()|trans({}, 'messages')}) %}
{% elseif best_achievement %}
    {% set preheader = 'activity_digest.preheader.achievement_locked'|trans %}
{% elseif activity.levelledUp() %}
    {% set preheader = 'activity_digest.preheader.level'|trans({'%level%': activity.levelAfter}) %}
{% elseif personal_bests is not empty %}
    {% set preheader = 'activity_digest.preheader.personal_best'|trans({'%puzzle%': (personal_bests|first).puzzleName}) %}
{% elseif activity.rating is not null and activity.rating.placesGained > 0 %}
    {% set preheader = 'activity_digest.preheader.rating'|trans({'%count%': activity.rating.placesGained}) %}
{% else %}
    {% set preheader = 'activity_digest.preheader.numbers'|trans({'%count%': activity.puzzlesCount, '%pieces%': activity.piecesCount|plain_number}) %}
{% endif %}

{% block cards %}
    {# Solo / pairs / teams - bar segments and legend squares share them; the legend says every number in words #}
    {% set split_colors = {solo: '#d63c42', duo: '#f0a04b', team: '#3d5a98'} %}

    {# 1. The period in numbers #}
    {% set stats = [
        {label: 'activity_digest.grid.puzzles'|trans, value: activity.puzzlesCount|plain_number, change: activity.puzzlesChange()},
        {label: 'activity_digest.grid.pieces'|trans, value: activity.piecesCount|plain_number, change: activity.piecesChange()},
    ] %}
    {% if activity.minutesSpent > 0 %}
        {% set stats = stats|merge([{label: 'activity_digest.grid.time'|trans, value: (activity.minutesSpent * 60)|compactTime, change: null}]) %}
    {% endif %}
    {% if activity.streakDays > 1 %}
        {% set stats = stats|merge([{label: 'activity_digest.grid.streak'|trans, value: activity.streakDays, change: null}]) %}
    {% endif %}
    {% set stat_rows = stats|batch(2) %}
    {{ card_open }}
        <h1 style="font-size: 24px; line-height: 1.25; font-weight: bold; color: #373f50; margin: 0; Margin: 0;">
            {{ ('activity_digest.title.' ~ length)|trans({'%name%': playerName ?? 'activity_digest.puzzler'|trans}) }}
        </h1>
        <p style="font-size: 15px; color: #6b7488; margin: 4px 0 0 0; Margin: 4px 0 0 0;">{{ range_label }}</p>
        {# Two per row on every screen: half a phone is still ~150 px, wide enough for "9h 56min" at 28 px #}
        <table role="presentation" width="100%" style="width: 100%; margin-top: 8px;">
            {% for pair in stat_rows %}
                {% set row_border = loop.last ? '' : ' border-bottom: 1px solid #eef1f5;' %}
                <tr>
                    {% for stat in pair %}
                        <td width="50%" style="width: 50%; padding: 14px 8px 14px 0; vertical-align: top;{{ row_border }}">
                            <p style="font-size: 14px; color: #6b7488; margin: 0; Margin: 0;">{{ stat.label }}</p>
                            <p style="font-size: 28px; line-height: 1.15; font-weight: bold; color: #1f2430; margin: 2px 0 0 0; Margin: 2px 0 0 0;">{{ stat.value }}</p>
                            {% if stat.change is not null %}
                                {% set up = stat.change > 0 %}
                                <table role="presentation" style="border-collapse: separate; margin-top: 6px;"><tr>
                                    <td bgcolor="{{ up ? '#e6f4ec' : '#eef1f5' }}" style="background: {{ up ? '#e6f4ec' : '#eef1f5' }}; border-radius: 6px; padding: 2px 8px; font-size: 12px; line-height: 18px; color: {{ up ? '#1b6e46' : '#4b566b' }};">
                                        {{ up ? '↑' : '↓' }}&nbsp;{{ ('activity_digest.change.' ~ length)|trans({'%change%': (up ? '+' : '−') ~ (stat.change|abs)|plain_number}) }}
                                    </td>
                                </tr></table>
                            {% endif %}
                        </td>
                    {% endfor %}
                    {% if pair|length == 1 %}<td width="50%" style="width: 50%;{{ row_border }}">&nbsp;</td>{% endif %}
                </tr>
            {% endfor %}
        </table>
    {{ card_close }}

    {# 2. How you puzzled: solo / pairs / teams + the days #}
    {% set split = activity.splitByPuzzlingType() %}
    {% set days = activity.days() %}
    {% if split is not empty or days is not empty %}
        {{ card_open }}
            <h2 style="font-size: 18px; line-height: 1.3; font-weight: bold; color: #373f50; margin: 0 0 14px 0; Margin: 0 0 14px 0;">{{ 'activity_digest.how_title'|trans }}</h2>

            {% if split is not empty %}
                {% set total_pieces = max(1, split|reduce((sum, part) => sum + part.pieces, 0)) %}
                {% set used = 0 %}
                <table role="presentation" width="100%" style="width: 100%; border-collapse: separate;">
                    <tr>
                        {% for part in split %}
                            {# Whole per cents, never below 3 % so a small part still shows; the last takes the rest #}
                            {% set share = loop.last ? 100 - used : max(3, (part.pieces * 100 / total_pieces)|round) %}
                            {% set used = used + share %}
                            <td width="{{ share }}%" height="12" bgcolor="{{ split_colors[part.type] }}" style="width: {{ share }}%; height: 12px; line-height: 12px; font-size: 0; mso-line-height-rule: exactly; background: {{ split_colors[part.type] }};{% if loop.first %} border-top-left-radius: 6px; border-bottom-left-radius: 6px;{% endif %}{% if loop.last %} border-top-right-radius: 6px; border-bottom-right-radius: 6px;{% endif %}{% if not loop.first %} border-left: 2px solid #ffffff;{% endif %}">&nbsp;</td>
                        {% endfor %}
                    </tr>
                </table>
                <table role="presentation" width="100%" style="width: 100%; margin-top: 10px;">
                    {% for part in split %}
                        <tr>
                            <td width="18" style="width: 18px; padding: 5px 0; vertical-align: middle;">
                                <table role="presentation" style="border-collapse: separate;"><tr><td width="10" height="10" bgcolor="{{ split_colors[part.type] }}" style="width: 10px; height: 10px; font-size: 0; line-height: 10px; background: {{ split_colors[part.type] }}; border-radius: 3px;">&nbsp;</td></tr></table>
                            </td>
                            <td style="padding: 5px 0; vertical-align: middle; font-size: 15px; color: #4b566b;">
                                <strong style="font-weight: bold; color: #373f50;">{{ ('activity_digest.split.' ~ part.type)|trans }}</strong>&nbsp; {{ 'activity_digest.split.numbers'|trans({'%count%': part.puzzles, '%pieces%': part.pieces|plain_number}) }}
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            {% endif %}

            {% if days is not empty %}
                {% set busiest = days|reduce((best, day) => best is null or day.pieces > best.pieces ? day : best) %}
                {% set chart_height = 64 %}
                <table role="presentation" width="100%" style="width: 100%; border-collapse: separate;{% if split is not empty %} margin-top: 20px;{% endif %}">
                    <tr>
                        {% for day in days %}
                            {% set bar = day.pieces > 0 ? max(4, (day.share * chart_height)|round) : 2 %}
                            <td align="center" valign="bottom" height="{{ chart_height }}" style="height: {{ chart_height }}px; vertical-align: bottom; padding: 0 {{ days|length > 7 ? 2 : 5 }}px;">
                                <table role="presentation" width="100%" style="width: 100%; border-collapse: separate;"><tr>
                                    <td height="{{ bar }}" bgcolor="{{ day.pieces > 0 ? '#d63c42' : '#e3e7ee' }}" style="height: {{ bar }}px; font-size: 0; line-height: {{ bar }}px; mso-line-height-rule: exactly; background: {{ day.pieces > 0 ? '#d63c42' : '#e3e7ee' }}; border-radius: {{ day.pieces > 0 ? '4px 4px 0 0' : '1px' }};">&nbsp;</td>
                                </tr></table>
                            </td>
                        {% endfor %}
                    </tr>
                    <tr>
                        {% for day in days %}
                            <td align="center" style="text-align: center; padding-top: 6px; font-size: 12px; line-height: 14px; color: #6b7488;">{{ day.day|events_date('EEEEE') }}</td>
                        {% endfor %}
                    </tr>
                </table>
                <p style="font-size: 14px; color: #6b7488; margin: 10px 0 0 0; Margin: 10px 0 0 0;">
                    {{ 'activity_digest.busiest_day'|trans({'%day%': busiest.day|events_date(length == 'week' ? 'EEEE' : 'EEEEMMMMd'), '%count%': busiest.puzzles, '%pieces%': busiest.pieces|plain_number}) }}
                </p>
            {% endif %}
        {{ card_close }}
    {% endif %}

    {# 3. Progress - the card only when it has a line #}
    {% set progress %}
        {% if activity.xpVisible %}
            {# The level: before → after, the period's XP, a bar toward the next level (none at Level 50) #}
            <table role="presentation" width="100%" style="width: 100%; margin-bottom: 14px;">
                <tr>
                    <td style="padding: 0 0 8px 0; font-size: 16px;">
                        <a href="{{ url('xp_history', {_locale: locale}) }}" style="color: #373f50; font-weight: bold; text-decoration: none;">
                            {%- if activity.levelledUp() -%}
                                {{ 'activity_digest.level_up'|trans({'%from%': activity.levelBefore, '%to%': activity.levelAfter}) }}
                            {%- else -%}
                                {{ 'activity_digest.level'|trans({'%level%': activity.levelAfter}) }}
                            {%- endif -%}
                        </a>
                        {% if activity.xpGained > 0 %}&nbsp; <strong style="color: #1b6e46; font-weight: bold;">{{ ('activity_digest.xp_gained.' ~ length)|trans({'%xp%': activity.xpGained|plain_number}) }}</strong>{% endif %}
                    </td>
                </tr>
                {% if activity.levelProgress is not null and activity.xpToNextLevel is not null %}
                    {% set filled = max(2, min(98, (activity.levelProgress * 100)|round)) %}
                    <tr>
                        <td style="padding: 0;">
                            <table role="presentation" width="100%" style="width: 100%; border-collapse: separate;">
                                <tr>
                                    <td width="{{ filled }}%" height="8" bgcolor="#d63c42" style="width: {{ filled }}%; height: 8px; line-height: 8px; font-size: 0; mso-line-height-rule: exactly; background: #d63c42; border-radius: 4px 0 0 4px;">&nbsp;</td>
                                    <td width="{{ 100 - filled }}%" height="8" bgcolor="#e3e7ee" style="width: {{ 100 - filled }}%; height: 8px; line-height: 8px; font-size: 0; mso-line-height-rule: exactly; background: #e3e7ee; border-radius: 0 4px 4px 0;">&nbsp;</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 6px 0 0 0; font-size: 13px; color: #6b7488;">
                            {{ 'activity_digest.xp_to_next'|trans({'%xp%': activity.xpToNextLevel|plain_number, '%level%': activity.levelAfter + 1}) }}
                        </td>
                    </tr>
                {% endif %}
            </table>
        {% endif %}

        {% if activity.achievementsEarned is not empty %}
            {% if activity.isMember %}
                {% set shown_achievements = activity.achievementsByPoints()|slice(0, 3) %}
                <table role="presentation" style="border-collapse: collapse;">
                    {% for badge in shown_achievements %}
                        {% set badge_url = url('achievement_detail', {type: badge.type.value, _locale: locale}) %}
                        <tr>
                            <td width="48" style="width: 48px; padding: 6px 12px 6px 0; vertical-align: middle;">
                                <a href="{{ badge_url }}"><img src="{{ badge_art_url(badge.type, badge.tier, 'png', 96, absolute = true) }}" alt="" width="48" height="48" style="display: block; width: 48px; height: 48px; border: 0;"></a>
                            </td>
                            <td style="padding: 6px 0; vertical-align: middle;">
                                <a href="{{ badge_url }}" style="font-weight: bold;">{{ 'activity_digest.new_achievement'|trans({'%achievement%': badge.type.translationKey()|trans({}, 'messages')}) }}</a>
                                <br><span style="font-size: 14px; color: #6b7488;">{% if badge.tier is not null %}{{ badge.tier.translationKey()|trans({}, 'messages') }} · {% endif %}+{{ badge.tier ? badge.tier.points() : constant('SpeedPuzzling\\Web\\Value\\BadgeTier::SINGLE_TIER_POINTS') }} AP</span>
                            </td>
                        </tr>
                    {% endfor %}
                </table>
                {% set more_achievements = activity.achievementsEarned|length - shown_achievements|length %}
                {% if more_achievements > 0 %}
                    <p style="margin: 4px 0 12px 0; Margin: 4px 0 12px 0;"><a href="{{ week_url }}">{{ 'activity_digest.more_achievements'|trans({'%count%': more_achievements}) }}</a></p>
                {% endif %}
            {% else %}
                <p style="margin: 0 0 12px 0; Margin: 0 0 12px 0;">
                    {{ 'activity_digest.achievement_teaser'|trans({'%count%': activity.achievementsEarned|length}) }}
                    <a href="{{ url('membership', {_locale: locale}) }}">{{ 'activity_digest.become_member'|trans }}</a>
                </p>
            {% endif %}
        {% endif %}

        {# An achievement drop released in the period (AchievementDrops) - awarded from history with past dates, so
           it is news here and not in the list above; members also hear how many they already hold #}
        {% set drop = activity.achievementDrop %}
        {% if drop is not null %}
            <p style="margin: 12px 0 4px 0; Margin: 12px 0 4px 0;"><strong style="font-weight: bold; color: #373f50;">{{ 'badges.drop.title'|trans({'%count%': drop.types|length}, 'messages') }}</strong></p>
            <table role="presentation" style="border-collapse: collapse;">
                <tr>
                    {% for type in drop.types %}
                        <td width="48" style="width: 48px; padding: 4px 8px 4px 0;">
                            <a href="{{ url('badges_overview', {_locale: locale}) }}#{{ type.value }}"><img src="{{ badge_art_url(type, 1, 'png', 96, absolute = true) }}" alt="{{ type.translationKey()|trans({}, 'messages') }}" width="48" height="48" style="display: block; width: 48px; height: 48px; border: 0;"></a>
                        </td>
                    {% endfor %}
                </tr>
            </table>
            <p style="margin: 4px 0 12px 0; Margin: 4px 0 12px 0;">
                {% if activity.isMember %}
                    {{ 'badges.drop.held'|trans({'%count%': activity.achievementDropHeld}, 'messages') }}
                {% else %}
                    {{ 'badges.drop.members_only'|trans({}, 'messages') }}
                {% endif %}
                <a href="{{ url('badges_overview', {_locale: locale}) }}">{{ 'badges.drop.see_all'|trans({}, 'messages') }}</a>
            </p>
        {% endif %}

        {# Members: achievements waiting for their reveal - whenever they were earned #}
        {% if activity.unrevealedAchievements > 0 %}
            <p style="margin: 0 0 12px 0; Margin: 0 0 12px 0;">
                {{ 'badges.reveals.invite'|trans({'%count%': activity.unrevealedAchievements}, 'messages') }}
                <a href="{{ url('badge_reveals', {_locale: locale}) }}">{{ 'badges.reveals.invite_button'|trans({'%count%': activity.unrevealedAchievements}, 'messages') }}</a>
            </p>
        {% endif %}

        {# Members: the achievement closest to its next tier #}
        {% set next = activity.nextAchievement() %}
        {% if next is not null %}
            {% set next_url = url('achievement_detail', {type: next.type.value, _locale: locale}) %}
            <table role="presentation" style="border-collapse: collapse; margin-bottom: 12px;">
                <tr>
                    <td width="40" style="width: 40px; padding: 6px 12px 6px 0; vertical-align: middle;">
                        <a href="{{ next_url }}"><img src="{{ badge_art_url(next.type, next.progress.nextTier, 'png', 96, absolute = true) }}" alt="" width="40" height="40" style="display: block; width: 40px; height: 40px; border: 0; opacity: 0.6;"></a>
                    </td>
                    <td style="padding: 6px 0; vertical-align: middle;">
                        <a href="{{ next_url }}">{{ 'activity_digest.next_achievement'|trans({'%achievement%': next.type.translationKey()|trans({}, 'messages'), '%tier%': next.progress.nextTier.translationKey()|trans({}, 'messages')}) }}</a>
                        <br><span style="font-size: 13px; color: #6b7488;">
                            {%- if next.progress.unit.value == 'seconds' -%}
                                {{ 'activity_digest.next_achievement_time'|trans({'%current%': next.progress.currentValue|puzzlingTime, '%target%': next.progress.targetValue|puzzlingTime}) }}
                            {%- else -%}
                                {{ 'activity_digest.next_achievement_count'|trans({'%current%': next.progress.currentValue|plain_number, '%target%': next.progress.targetValue|plain_number}) }}
                            {%- endif %} · {{ next.progress.percent }} %
                        </span>
                    </td>
                </tr>
            </table>
        {% endif %}

        {% if activity.rating is not null and activity.rating.rank is not null and activity.rating.placesGained != 0 %}
            <p style="margin: 0 0 12px 0; Margin: 0 0 12px 0;">
                <a href="{{ url('msp_rating_ladder', {_locale: locale}) }}">{{ 'activity_digest.rating'|trans({'%rank%': activity.rating.rank, '%total%': activity.rating.rankTotal}) }}</a>
                {% if activity.rating.placesGained > 0 %}
                    · <span style="color: #1b6e46;">{{ 'activity_digest.rating_up'|trans({'%count%': activity.rating.placesGained}) }}</span>
                {% else %}
                    · {{ 'activity_digest.rating_down'|trans({'%count%': -activity.rating.placesGained}) }}
                {% endif %}
            </p>
        {% endif %}

        {% if activity.rating is not null %}
            {% for pieces, change in activity.rating.skillTierChanges %}
                <p style="margin: 0 0 12px 0; Margin: 0 0 12px 0;">
                    <a href="{{ url('msp_rating_ladder', {_locale: locale}) }}">{{ 'activity_digest.skill_tier'|trans({
                        '%pieces%': pieces,
                        '%tier%': ('puzzle_intelligence.skill.tiers.' ~ change.after.toApiValue())|trans({}, 'messages'),
                    }) }}</a>
                </p>
            {% endfor %}
        {% endif %}

        {% if activity.karmaGained is not null and activity.karmaGained > 0 %}
            <p style="margin: 0 0 12px 0; Margin: 0 0 12px 0;">{{ 'activity_digest.karma'|trans({'%count%': activity.karmaGained}) }}</p>
        {% endif %}
    {% endset %}
    {% if progress|trim is not empty %}
        {{ card_open }}
            <h2 style="font-size: 18px; line-height: 1.3; font-weight: bold; color: #373f50; margin: 0 0 14px 0; Margin: 0 0 14px 0;">{{ 'activity_digest.progress_title'|trans }}</h2>
            {{ progress }}
        {{ card_close }}
    {% endif %}

    {# 4. The best results: thumbnail, name + what kind of result, time + place on the right #}
    {% set highlighted = activity.highlights(3) %}
    {% if highlighted is not empty %}
        {{ card_open }}
            <h2 style="font-size: 18px; line-height: 1.3; font-weight: bold; color: #373f50; margin: 0 0 6px 0; Margin: 0 0 6px 0;">{{ 'activity_digest.results_title'|trans }}</h2>
            <table role="presentation" width="100%" style="width: 100%;">
                {% for highlight in highlighted %}
                    {% set result = highlight.result %}
                    {% set puzzle_url = url('puzzle_detail', {puzzleId: result.puzzleId, _locale: locale}) %}
                    {% set marks = ['activity_digest.pieces'|trans({'%count%': result.piecesCount, '%pieces%': result.piecesCount|plain_number})] %}
                    {% if result.puzzlingType == 'duo' %}{% set marks = marks|merge(['activity_digest.mark.pair'|trans]) %}{% elseif result.puzzlingType == 'team' %}{% set marks = marks|merge(['activity_digest.mark.team'|trans({'%count%': result.puzzlersCount})]) %}{% endif %}
                    {% if result.personalBest %}{% set marks = marks|merge(['activity_digest.mark.personal_best'|trans]) %}{% endif %}
                    {% if result.firstAttempt %}{% set marks = marks|merge(['activity_digest.mark.first_try'|trans]) %}{% endif %}
                    {% if highlight.attempts > 1 %}{% set marks = marks|merge(['activity_digest.mark.attempts'|trans({'%count%': highlight.attempts})]) %}{% endif %}
                    {% set row_border = loop.first ? '' : ' border-top: 1px solid #eef1f5;' %}
                    <tr>
                        <td width="52" style="width: 52px; padding: 12px 12px 12px 0; vertical-align: middle;{{ row_border }}">
                            {% if result.puzzleImage is not null %}
                                <a href="{{ puzzle_url }}"><img src="{{ result.puzzleImage|puzzle_image('puzzle_small') }}" alt="" width="52" height="52" style="display: block; width: 52px; height: 52px; border: 0; border-radius: 8px; object-fit: cover;"></a>
                            {% else %}
                                <table role="presentation" style="border-collapse: separate;"><tr><td width="52" height="52" bgcolor="#eef1f5" style="width: 52px; height: 52px; background: #eef1f5; border-radius: 8px; font-size: 0; line-height: 52px;">&nbsp;</td></tr></table>
                            {% endif %}
                        </td>
                        <td style="padding: 12px 8px 12px 0; vertical-align: middle;{{ row_border }}">
                            <a href="{{ puzzle_url }}" style="font-weight: bold;">{{ result.puzzleName }}</a>
                            <br><span style="font-size: 13px; line-height: 1.5; color: #6b7488;">{{ marks|join(' · ') }}</span>
                        </td>
                        <td align="right" style="padding: 12px 0; vertical-align: middle; text-align: right; white-space: nowrap;{{ row_border }}">
                            {% if result.secondsToSolve is not null %}<strong style="font-size: 16px; font-weight: bold; color: #1f2430;">{{ result.secondsToSolve|puzzlingTime }}</strong>{% endif %}
                            {% if result.rank is not null and result.rankTotal is not null %}<br><span style="font-size: 13px; color: #6b7488;">{{ 'activity_digest.place'|trans({'%rank%': result.rank|plain_number, '%total%': result.rankTotal|plain_number}) }}</span>{% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </table>
        {{ card_close }}
    {% endif %}

    <table role="presentation" width="100%" style="width: 100%;">
        <tr>
            <td align="center" style="padding: 6px 0 18px 0; text-align: center;">
                <center style="min-width: 0;">
                    <button href="{{ week_url }}">{{ ('activity_digest.button.' ~ length)|trans }}</button>
                </center>
            </td>
        </tr>
    </table>

    {{ include('emails/content_digest/_community.html.twig') }}
{% endblock %}

{% block footer_note %}{{ include('emails/content_digest/_settings.html.twig') }}{% endblock %}
