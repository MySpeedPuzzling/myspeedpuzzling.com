{% extends 'emails/content_digest/_layout.html.twig' %}
{% trans_default_domain 'emails' %}
{#
    "We miss you" (docs/features/content-digest/README.md §"We miss you"): once per inactive spell, when the last logged
    result is at least 28 days old. Friendly and light, never blaming, no streak threats: maybe they puzzled and did
    not log it (the date of a time can be picked - "Add a time"), or a puzzle idea brings them back. The digest's card
    layout (§"Design").
#}
{% set preheader = 'activity_digest.miss_you.preheader'|trans %}

{% block cards %}
    {{ card_open }}
        <h1 style="font-size: 24px; line-height: 1.25; font-weight: bold; color: #373f50; margin: 0 0 12px 0; Margin: 0 0 12px 0;">{{ 'activity_digest.miss_you.title'|trans({'%name%': playerName ?? 'activity_digest.puzzler'|trans}) }}</h1>
        <p style="margin: 0 0 12px 0; Margin: 0 0 12px 0; line-height: 1.5;">{{ 'activity_digest.miss_you.line_secret'|trans }}</p>
        <p style="margin: 0 0 18px 0; Margin: 0 0 18px 0; line-height: 1.5;">{{ 'activity_digest.miss_you.line_add'|trans }}</p>
        <center style="min-width: 0;">
            <button href="{{ url('puzzle_add', {_locale: locale}) }}">{{ 'activity_digest.miss_you.button'|trans }}</button>
        </center>
    {{ card_close }}

    {{ card_open }}
        <p style="margin: 0 0 6px 0; Margin: 0 0 6px 0; line-height: 1.5;">{{ 'activity_digest.miss_you.line_back'|trans }}</p>
        <table role="presentation" width="100%" style="width: 100%;">
            {% for link in [
                {url: url('puzzle_picker', {_locale: locale}), label: 'activity_digest.miss_you.link_picker'|trans},
                {url: url('hub', {_locale: locale}), label: 'activity_digest.miss_you.link_hub'|trans},
                {url: url('my_profile', {_locale: locale}), label: 'activity_digest.miss_you.link_profile'|trans},
            ] %}
                <tr>
                    <td style="padding: 10px 0;{% if not loop.first %} border-top: 1px solid #eef1f5;{% endif %}">
                        <a href="{{ link.url }}" style="font-weight: bold;">{{ link.label }}&nbsp;→</a>
                    </td>
                </tr>
            {% endfor %}
        </table>
    {{ card_close }}

    {{ include('emails/content_digest/_community.html.twig') }}
{% endblock %}

{% block footer_note %}{{ include('emails/content_digest/_settings.html.twig', {footer_key: 'activity_digest.miss_you.footer'}) }}{% endblock %}
