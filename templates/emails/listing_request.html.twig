{% extends 'emails/_card_layout.html.twig' %}
{% trans_default_domain 'emails' %}
{# "Could I have these?" to the seller (SendListingRequestEmailHandler, docs/features/marketplace/12-listing-requests.md).
   Names who asks, which listings at what price and what they offer in exchange, never anybody's e-mail address: the
   seller answers inside MySpeedPuzzling.
   The card layout (docs/features/transactional-emails.md "Card layout"): the ask with its listings, what they offer,
   then the answer. #}
{% set preheader = 'listing_request.preheader'|trans %}
{% set header_link = answerUrl %}
{% set header_link_label = 'listing_request.answer'|trans %}

{% block cards %}
    {{ card_open }}
        <h1 style="-webkit-hyphens: none; hyphens: none; font-size: 24px; line-height: 1.25; font-weight: bold; color: #373f50; margin: 0 0 12px 0; Margin: 0 0 12px 0;">{{ 'listing_request.title'|trans({'%buyer%': buyerName, '%count%': listings|length}) }}</h1>
        <p style="-webkit-hyphens: none; hyphens: none; margin: 0 0 12px 0; Margin: 0 0 12px 0; line-height: 1.5;">{{ 'listing_request.greeting'|trans({'%name%': sellerName}) }}</p>
        <p style="-webkit-hyphens: none; hyphens: none; margin: 0 0 6px 0; Margin: 0 0 6px 0; line-height: 1.5;">{{ 'listing_request.intro'|trans({'%buyer%': buyerName, '%count%': listings|length}) }}</p>

        <table role="presentation" width="100%" style="width: 100%;">
            {% for listing in listings %}
                {% set details = ['listing_request.pieces'|trans({'%count%': listing.pieces})] %}
                {% if listing.brand is not null %}{% set details = details|merge([listing.brand]) %}{% endif %}
                {% set details = details|merge([('listing_request.type.' ~ listing.type)|trans]) %}
                {% if listing.price is not null and listing.price > 0 and listing.type in ['sell', 'both'] %}{% set details = details|merge([listing.price ~ ' ' ~ listing.currency]) %}{% endif %}
                {{ include('emails/card/_puzzle_row.html.twig', {
                    image: listing.image ?? null,
                    name: listing.name,
                    details: details|join(' · '),
                    first: loop.first,
                }) }}
            {% endfor %}
        </table>

        {% if note is not null %}
            {{ include('emails/card/_note.html.twig', {note: note}) }}
        {% endif %}
    {{ card_close }}

    {% if offers is not empty %}
        {{ card_open }}
            <h2 style="-webkit-hyphens: none; hyphens: none; font-size: 18px; line-height: 1.3; font-weight: bold; color: #373f50; margin: 0 0 6px 0; Margin: 0 0 6px 0;">{{ 'listing_request.offers'|trans({'%buyer%': buyerName}) }}</h2>
            <table role="presentation" width="100%" style="width: 100%;">
                {% for offer in offers %}
                    {{ include('emails/card/_puzzle_row.html.twig', {
                        image: offer.image ?? null,
                        name: offer.name,
                        details: (['listing_request.pieces'|trans({'%count%': offer.pieces})]|merge(offer.brand is not null ? [offer.brand] : []))|join(' · '),
                        first: loop.first,
                    }) }}
                {% endfor %}
            </table>
        {{ card_close }}
    {% endif %}

    {{ card_open }}
        <p style="-webkit-hyphens: none; hyphens: none; margin: 0 0 18px 0; Margin: 0 0 18px 0; line-height: 1.5;">{{ 'listing_request.how_to_answer'|trans }}</p>
        <center style="min-width: 0;">
            <button href="{{ answerUrl }}">{{ 'listing_request.answer'|trans }}</button>
        </center>
        <p style="-webkit-hyphens: none; hyphens: none; font-size: 14px; line-height: 1.5; color: #6b7488; margin: 14px 0 0 0; Margin: 14px 0 0 0;">{{ 'listing_request.no_addresses'|trans }}</p>
    {{ card_close }}
{% endblock %}

{% block footer_note %}{{ 'listing_request.opt_out'|trans({'%settingsUrl%': settingsUrl, '%unsubscribeUrl%': unsubscribeUrl})|raw }}{% endblock %}
