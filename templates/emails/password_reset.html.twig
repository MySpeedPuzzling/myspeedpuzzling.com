{% trans_default_domain 'emails' %}
{% apply inky_to_html|inline_css(source('@styles/foundation-emails.css')) %}
    <wrapper>
        <container>
            {{ include('emails/_header.html.twig') }}

            <row>
                <columns>
                    <spacer size-sm="24"></spacer>
                    <h3>{{ 'password_reset.title'|trans }}</h3>
                    <spacer size-sm="8"></spacer>
                </columns>
            </row>

            <row>
                <columns>
                    {{ 'password_reset.content'|trans|raw }}
                </columns>
            </row>

            <row>
                <columns>
                    <center>
                        <a href="{{ resetUrl }}" class="button">{{ 'password_reset.button'|trans }}</a>
                    </center>
                    <spacer size-sm="8"></spacer>
                </columns>
            </row>

            <row>
                <columns>
                    <p class="text-center">{{ 'password_reset.expires'|trans({'%minutes%': expiresInMinutes}) }}</p>
                    <p class="text-center">{{ 'password_reset.not_requested'|trans }}</p>
                </columns>
            </row>

            {{ include('emails/_footer.html.twig') }}
        </container>
    </wrapper>
{% endapply %}
