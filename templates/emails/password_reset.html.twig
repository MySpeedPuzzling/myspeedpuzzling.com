{% trans_default_domain 'emails' %}
{% apply inky_to_html|inline_css(source('@styles/foundation-emails.css'))|email_document %}
    <wrapper>
        <container>
            {{ include('emails/_header.html.twig', {preheader: 'password_reset.preheader'|trans({'%minutes%': expiresInMinutes})}) }}

            <row>
                <columns>
                    <spacer size-sm="24"></spacer>
                    <h3>{{ 'password_reset.title'|trans }}</h3>
                    <spacer size-sm="8"></spacer>
                </columns>
            </row>

            <row>
                <columns>
                    {{ 'password_reset.content'|trans|raw }}
                </columns>
            </row>

            <row>
                <columns>
                    <center>
                        <button href="{{ resetUrl }}">{{ 'password_reset.button'|trans }}</button>
                    </center>
                    <spacer size-sm="8"></spacer>
                </columns>
            </row>

            <row>
                <columns>
                    <p>{{ 'password_reset.expires'|trans({'%minutes%': expiresInMinutes}) }}</p>
                    <p>{{ 'password_reset.not_requested'|trans }}</p>
                </columns>
            </row>

            {{ include('emails/_footer.html.twig') }}
        </container>
    </wrapper>
{% endapply %}
