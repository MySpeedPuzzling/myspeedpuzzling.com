{% trans_default_domain 'emails' %}
{#
    "Your results" (docs/features/duplicate-results.md, "Telling players"). No action links on purpose: mail scanners
    open links in advance, so "Review" only opens the page and every action is a POST there.
    One line per result (sets), however many copies. Only removals (no case left) = the "we removed" wording.
#}
{% set removed_only = sets is empty %}
{% apply inky_to_html|inline_css(source('@styles/foundation-emails.css')) %}
    <wrapper>
        <container>
            {{ include('emails/_header.html.twig') }}

            <row>
                <columns>
                    <spacer size-sm="24"></spacer>
                    <h3>{{ (removed_only ? 'result_review.title_removed' : (first ? 'result_review.title_first' : 'result_review.title_weekly'))|trans }}</h3>
                    <spacer size-sm="8"></spacer>
                </columns>
            </row>

            <row>
                <columns>
                    <p>{{ 'result_review.greeting'|trans({'%playerName%': playerName ?? 'Puzzler'}) }}</p>
                    <p>{{ (removed_only ? 'result_review.intro_removed' : (first ? 'result_review.intro_first' : 'result_review.intro_weekly'))|trans }}</p>

                    {# Two clearly separate boxes: what we were not sure about (the player decides) and what we were
                       sure about and already fixed (undo possible) - inline styles, e-mail clients drop <style> #}
                    {% if not removed_only %}
                        <table role="presentation" width="100%" style="width: 100%; margin: 16px 0; background: #fff8e6; border-left: 4px solid #f0a020; border-radius: 6px;">
                            <tr>
                                <td style="padding: 14px 16px;">
                                    <p style="margin: 0 0 6px; font-weight: bold;">{{ 'result_review.check_heading'|trans }}</p>
                                    <p style="margin: 0 0 10px; font-size: 14px;">{{ 'result_review.check_text'|trans }}</p>
                                    <ul style="margin: 0 0 10px; padding-left: 20px;">
                                        {% for set in sets %}
                                            <li style="margin-bottom: 6px;">
                                                {{ 'result_review.case_line'|trans({
                                                    '%puzzleName%': set.puzzleName,
                                                    '%time%': set.secondsToSolve is not null ? set.secondsToSolve|puzzlingTime : '-',
                                                    '%date%': set.solvedAt|format_date('medium', locale: locale),
                                                }) }}
                                                <br><span style="color: #6b6b6b; font-size: 13px;">{{ ('result_review.kind_' ~ set.lineKind)|trans }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                    {% if moreSets > 0 %}
                                        <p style="margin: 0 0 10px; font-size: 14px;">{{ 'result_review.more'|trans({'%count%': moreSets}) }}</p>
                                    {% endif %}
                                    <p style="margin: 0; font-size: 14px;">{{ 'result_review.check_action'|trans }}</p>
                                </td>
                            </tr>
                        </table>
                    {% endif %}

                    {% if removals is not empty %}
                        <table role="presentation" width="100%" style="width: 100%; margin: 16px 0; background: #ecf7ef; border-left: 4px solid #2e9e5b; border-radius: 6px;">
                            <tr>
                                <td style="padding: 14px 16px;">
                                    <p style="margin: 0 0 6px; font-weight: bold;">{{ 'result_review.removed_heading'|trans }}</p>
                                    <p style="margin: 0 0 10px; font-size: 14px;">{{ 'result_review.removed_text'|trans }}</p>
                                    <ul style="margin: 0; padding-left: 20px;">
                                        {% for removal in removals %}
                                            <li style="margin-bottom: 6px;">
                                                {{ 'result_review.case_line'|trans({
                                                    '%puzzleName%': removal.puzzleName,
                                                    '%time%': removal.secondsToSolve is not null ? removal.secondsToSolve|puzzlingTime : '-',
                                                    '%date%': removal.solvedAt|format_date('medium', locale: locale),
                                                }) }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                    {% if moreRemovals > 0 %}
                                        <p style="margin: 10px 0 0; font-size: 14px;">{{ 'result_review.more'|trans({'%count%': moreRemovals}) }}</p>
                                    {% endif %}
                                </td>
                            </tr>
                        </table>
                    {% endif %}

                    <center>
                        <button href="{{ url('review_results', {_locale: locale, from: 'rc-' ~ contactId}) }}">
                            {{ 'result_review.button'|trans }}
                        </button>
                    </center>

                    <p>{{ 'result_review.thanks'|trans }}<br>{{ 'result_review.signature'|trans }}</p>

                    <spacer size-sm="10"></spacer>

                    <p><small>{{ 'result_review.opt_out'|trans({'%settingsUrl%': settingsUrl, '%unsubscribeUrl%': unsubscribeUrl})|raw }}</small></p>
                </columns>
            </row>

            {{ include('emails/_footer.html.twig') }}
        </container>
    </wrapper>
{% endapply %}
