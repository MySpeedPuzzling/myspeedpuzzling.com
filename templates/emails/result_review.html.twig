{% extends 'emails/_card_layout.html.twig' %}
{% trans_default_domain 'emails' %}
{#
    "Your results" (docs/features/duplicate-results.md, "Telling players"). No action links on purpose: mail scanners
    open links in advance, so "Review" only opens the page and every action is a POST there.
    One line per result (sets), however many copies. The wording follows `variant` (ResultReviewEmailComposer):
    first / weekly (results to check), removed (only removals), verification / verification_answered (only times
    awaiting verification or moderators' answers - docs/features/suspicious-time-review.md, "Where they see it").
    Never "suspicious" in anything the player reads.
    The card layout (docs/features/transactional-emails.md "Card layout"): the greeting, one card per section - what we
    were not sure about (the player decides), what we were sure about and already fixed (undo possible), times awaiting
    verification, the moderators' answers -, the button.
#}
{% set review_parameters = {_locale: locale, from: 'rc-' ~ contactId}|merge(reviewFragment is not null ? {_fragment: reviewFragment} : {}) %}
{% set preheader = ('result_review.preheader_' ~ variant)|trans({'%count%': count}) %}
{% set header_link = url('review_results', review_parameters) %}
{% set header_link_label = 'result_review.button'|trans %}

{% block cards %}
    {% set row_style = 'margin: 0; Margin: 0; padding: 10px 0; font-size: 15px; line-height: 1.45; color: #373f50;' %}
    {% set more_style = 'font-size: 14px; line-height: 1.5; color: #6b7488; margin: 8px 0 0 0; Margin: 8px 0 0 0;' %}
    {% set text_style = 'font-size: 15px; line-height: 1.5; color: #4b566b; margin: 0 0 6px 0; Margin: 0 0 6px 0;' %}
    {% set action_style = 'font-size: 14px; line-height: 1.5; color: #6b7488; margin: 10px 0 0 0; Margin: 10px 0 0 0;' %}

    {{ card_open }}
        <h1 style="-webkit-hyphens: none; hyphens: none; font-size: 24px; line-height: 1.25; font-weight: bold; color: #373f50; margin: 0 0 12px 0; Margin: 0 0 12px 0;">{{ ('result_review.title_' ~ variant)|trans({'%count%': count}) }}</h1>
        <p style="-webkit-hyphens: none; hyphens: none; margin: 0 0 12px 0; Margin: 0 0 12px 0; line-height: 1.5;">{{ 'result_review.greeting'|trans({'%playerName%': playerName ?? 'Puzzler'}) }}</p>
        <p style="-webkit-hyphens: none; hyphens: none; margin: 0; Margin: 0; line-height: 1.5;">{{ ('result_review.intro_' ~ variant)|trans({'%count%': count}) }}</p>
    {{ card_close }}

    {% if sets is not empty %}
        {{ card_open }}
            {{ include('emails/card/_section_heading.html.twig', {text: 'result_review.check_heading'|trans, color: '#f0a04b'}) }}
            <p style="-webkit-hyphens: none; hyphens: none; {{ text_style }}">{{ 'result_review.check_text'|trans }}</p>
            <ul style="list-style: none; margin: 0; Margin: 0; padding: 0;">
                {% for set in sets %}
                    <li style="-webkit-hyphens: none; hyphens: none; {{ row_style }}{% if not loop.first %} border-top: 1px solid #eef1f5;{% endif %}">
                            {{ 'result_review.case_line'|trans({
                                '%puzzleName%': set.puzzleName,
                                '%time%': set.secondsToSolve is not null ? set.secondsToSolve|puzzlingTime : '-',
                                '%date%': set.solvedAt|format_date('medium', locale: locale),
                            }) }}
                            <br><span style="color: #6b7488; font-size: 14px;">{{ ('result_review.kind_' ~ set.lineKind)|trans }}</span>
                    </li>
                {% endfor %}
            </ul>
            {% if moreSets > 0 %}
                <p style="-webkit-hyphens: none; hyphens: none; {{ more_style }}">{{ 'result_review.more'|trans({'%count%': moreSets}) }}</p>
            {% endif %}
            <p style="-webkit-hyphens: none; hyphens: none; {{ action_style }}">{{ 'result_review.check_action'|trans }}</p>
        {{ card_close }}
    {% endif %}

    {% if removals is not empty %}
        {{ card_open }}
            {{ include('emails/card/_section_heading.html.twig', {text: 'result_review.removed_heading'|trans, color: '#2e9e5b'}) }}
            <p style="-webkit-hyphens: none; hyphens: none; {{ text_style }}">{{ 'result_review.removed_text'|trans }}</p>
            <ul style="list-style: none; margin: 0; Margin: 0; padding: 0;">
                {% for removal in removals %}
                    <li style="-webkit-hyphens: none; hyphens: none; {{ row_style }}{% if not loop.first %} border-top: 1px solid #eef1f5;{% endif %}">
                            {{ 'result_review.case_line'|trans({
                                '%puzzleName%': removal.puzzleName,
                                '%time%': removal.secondsToSolve is not null ? removal.secondsToSolve|puzzlingTime : '-',
                                '%date%': removal.solvedAt|format_date('medium', locale: locale),
                            }) }}
                    </li>
                {% endfor %}
            </ul>
            {% if moreRemovals > 0 %}
                <p style="-webkit-hyphens: none; hyphens: none; {{ more_style }}">{{ 'result_review.more'|trans({'%count%': moreRemovals}) }}</p>
            {% endif %}
        {{ card_close }}
    {% endif %}

    {# Times set aside until they are checked: told once per mark, like a removal #}
    {% if markedTimes is not empty %}
        {{ card_open }}
            {{ include('emails/card/_section_heading.html.twig', {text: 'result_review.verification_heading'|trans, color: '#3d5a98'}) }}
            <p style="-webkit-hyphens: none; hyphens: none; {{ text_style }}">{{ 'result_review.verification_text'|trans }}</p>
            <ul style="list-style: none; margin: 0; Margin: 0; padding: 0;">
                {% for markedTime in markedTimes %}
                    <li style="-webkit-hyphens: none; hyphens: none; {{ row_style }}{% if not loop.first %} border-top: 1px solid #eef1f5;{% endif %}">
                            {{ 'result_review.case_line'|trans({
                                '%puzzleName%': markedTime.puzzleName,
                                '%time%': markedTime.secondsToSolve is not null ? markedTime.secondsToSolve|puzzlingTime : '-',
                                '%date%': markedTime.solvedAt|format_date('medium', locale: locale),
                            }) }}
                    </li>
                {% endfor %}
            </ul>
            {% if moreMarkedTimes > 0 %}
                <p style="-webkit-hyphens: none; hyphens: none; {{ more_style }}">{{ 'result_review.more'|trans({'%count%': moreMarkedTimes}) }}</p>
            {% endif %}
            <p style="-webkit-hyphens: none; hyphens: none; {{ action_style }}">{{ 'result_review.verification_action'|trans }}</p>
        {{ card_close }}
    {% endif %}

    {# A moderator's answer to "The time is correct" - one line each #}
    {% if verificationAnswers is not empty %}
        {{ card_open }}
            {{ include('emails/card/_section_heading.html.twig', {text: 'result_review.verification_answers_heading'|trans, color: '#8a94a6'}) }}
            <ul style="list-style: none; margin: 0; Margin: 0; padding: 0;">
                {% for answer in verificationAnswers %}
                    {% set answer_key = answer.countsAgain ? 'result_review.verification_answer_trusted' : (answer.note is not null ? 'result_review.verification_answer_kept_note' : 'result_review.verification_answer_kept') %}
                    <li style="-webkit-hyphens: none; hyphens: none; {{ row_style }}{% if not loop.first %} border-top: 1px solid #eef1f5;{% endif %}">
                            {{ answer_key|trans({
                                '%puzzleName%': answer.puzzleName,
                                '%time%': answer.secondsToSolve is not null ? answer.secondsToSolve|puzzlingTime : '-',
                                '%note%': answer.note ?? '',
                            }) }}
                    </li>
                {% endfor %}
            </ul>
        {{ card_close }}
    {% endif %}

    {{ card_open }}
        <center style="min-width: 0;">
            <button href="{{ url('review_results', review_parameters) }}">{{ 'result_review.button'|trans }}</button>
        </center>
        <p style="-webkit-hyphens: none; hyphens: none; margin: 14px 0 0 0; Margin: 14px 0 0 0; line-height: 1.5;">{{ 'result_review.thanks'|trans }}<br>{{ 'result_review.signature'|trans }}</p>
    {{ card_close }}
{% endblock %}

{% block footer_note %}{{ 'result_review.opt_out'|trans({'%settingsUrl%': settingsUrl, '%unsubscribeUrl%': unsubscribeUrl})|raw }}{% endblock %}
