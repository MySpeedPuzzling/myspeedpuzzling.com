{% trans_default_domain 'emails' %}
{% apply inky_to_html|inline_css(source('@styles/foundation-emails.css')) %}
    <wrapper>
        <container>
            {{ include('emails/_header.html.twig') }}

            <row>
                <columns>
                    <spacer size-sm="24"></spacer>
                    <h3>{{ 'verify_email.title'|trans }}</h3>
                    <spacer size-sm="8"></spacer>
                </columns>
            </row>

            <row>
                <columns>
                    {{ 'verify_email.content'|trans|raw }}
                </columns>
            </row>

            <row>
                <columns>
                    <center>
                        <button href="{{ verificationUrl }}">{{ 'verify_email.button'|trans }}</button>
                    </center>
                    <spacer size-sm="8"></spacer>
                </columns>
            </row>

            <row>
                <columns>
                    <p class="text-center">{{ 'verify_email.expires'|trans({'%hours%': expiresInHours}) }}</p>
                </columns>
            </row>

            <row>
                <columns>
                    <p class="text-center">{{ 'verify_email.not_requested'|trans }}</p>
                </columns>
            </row>

            {{ include('emails/_footer.html.twig') }}
        </container>
    </wrapper>
{% endapply %}
