{% extends 'base.html.twig' %}

{# The full event name - never shortened, it is what people search - plus the year when the name has none;
   "Results" once the event is over and has results here (see EventTitle::saysResults()) #}
{% block title %}
    {%- if event_title.saysResults(results_count) -%}
        {{- 'events.meta.event_detail_title_results'|trans({'%event%': event_title.label}) -}}
    {%- else -%}
        {{- event_title.label -}}
    {%- endif -%}
{% endblock %}

{% block robots %}
    {# Unapproved/rejected events are publicly reachable at their slug URL - keep them out of the index #}
    {% if event.approvedAt is null or event.rejectedAt is not null %}
        <meta name="robots" content="noindex, nofollow">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block meta_description %}
    {%- if event_title.saysResults(results_count) -%}
        {%- set past_description_params = {
            '%count%': results_count,
            '%results%': results_count|format_number,
            '%name%': event.name,
            '%date%': event_title.startsAt|format_date('long'),
            '%location%': event.location ?? '',
        } -%}
        {%- if event.isOnline -%}
            {{- 'events.meta.event_detail_description_past_online'|trans(past_description_params) -}}
        {%- elseif event.location -%}
            {{- 'events.meta.event_detail_description_past'|trans(past_description_params) -}}
        {%- else -%}
            {{- 'events.meta.event_detail_description_past_no_location'|trans(past_description_params) -}}
        {%- endif -%}
    {%- elseif event.isOnline and event.dateFrom -%}
        {{- 'events.meta.event_detail_description_online'|trans({'%name%': event.name, '%date%': event.dateFrom|format_date('long')}) -}}
    {%- elseif event.isOnline -%}
        {{- 'events.meta.event_detail_description_online_no_date'|trans({'%name%': event.name}) -}}
    {%- elseif event.dateFrom and event.location -%}
        {{- 'events.meta.event_detail_description'|trans({'%name%': event.name, '%date%': event.dateFrom|format_date('long'), '%location%': event.location}) -}}
    {%- elseif event.location -%}
        {{- 'events.meta.event_detail_description_no_date'|trans({'%name%': event.name, '%location%': event.location}) -}}
    {%- elseif event.dateFrom -%}
        {{- 'events.meta.event_detail_description_no_location'|trans({'%name%': event.name, '%date%': event.dateFrom|format_date('long')}) -}}
    {%- else -%}
        {{- 'events.meta.event_detail_description_fallback'|trans({'%name%': event.name}) -}}
    {%- endif -%}
{% endblock %}

{% block json_ld %}
{{ parent() }}
{% if event.approvedAt is not null and event.rejectedAt is null and event.dateFrom is not null and event.slug is not null %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Event",
    "name": {{ event.name|json_ld }},
    "url": {{ url('event_detail', {'slug': event.slug})|json_ld }},
    "startDate": {{ event.dateFrom|date('Y-m-d')|json_ld }},
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": {{ (event.isOnline ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode')|json_ld }}
    {%- if event.dateTo %},
    "endDate": {{ event.dateTo|date('Y-m-d')|json_ld }}
    {%- endif %}
    {%- if event.isOnline %},
    "location": {
        "@type": "VirtualLocation",
        "url": {{ (event.registrationLink ?? event.resultsLink ?? url('event_detail', {'slug': event.slug}))|json_ld }}
    }
    {%- elseif event.location %},
    "location": {
        "@type": "Place",
        "name": {{ event.location|json_ld }},
        "address": {
            "@type": "PostalAddress",
            "addressLocality": {{ event.location|json_ld }}
            {%- if event.locationCountryCode %},
            "addressCountry": {{ event.locationCountryCode.name|upper|json_ld }}
            {%- endif %}
        }
    }
    {%- endif %}
    {%- if event.logo %},
    {# The large metadata-stripped preset (1200 px JPEG; Google wants event images >= 720 px wide) - never
       the uploaded original, older uploads may still carry EXIF/GPS #}
    "image": {{ event.logo|thumbnail('puzzle_large')|json_ld }}
    {%- endif %}
    {# description is a Google-recommended Event property - always emit,
       falling back to the same text as the meta description. organizer is
       deliberately NOT emitted: added_by_player is the submitter (often an
       admin), not the organizer - see docs/features/seo/TODO.md #14. #}
    ,"description": {{ (event.description ? event.description|striptags : block('meta_description')|trim)|json_ld }}
    {%- if event.registrationLink %},
    "offers": {
        "@type": "Offer",
        "url": {{ event.registrationLink|json_ld }}
    }
    {%- endif %}
}
</script>
{% endif %}
{% endblock %}

{% block content %}
    {{ include('_return_back_button.html.twig', {fallbackUrl: path('events'), fallbackTitle: 'events.title'|trans}) }}

    <div class="d-flex">
        <div class="flex-fill">
            <h1 class="h4 mb-2">
                {{ event.name }}
            </h1>

            <div class="row">
                <div class="col-sm-6">
                    {# Older online events still carry location "Online" - the badge says it once #}
                    {% if event.isOnline %}
                        <span class="badge bg-info text-dark">{{ 'competition.online'|trans }}</span>
                    {% else %}
                        {% if event.locationCountryCode %}
                            <span class="shadow-custom fi fi-{{ event.locationCountryCode.name }} me-2"></span>
                        {% endif %}

                        {{ event.location }}
                    {% endif %}

                    {% if event.dateFrom %}
                        <div class="mt-1">
                            <i class="ci-calendar me-2 ps-1"></i>
                            {{ include('_event_date_range.html.twig', {date_from: event.dateFrom, date_to: event.dateTo}) }}
                            <small class="text-muted ps-1">({{ event.dateFrom|ago }})</small>
                        </div>
                    {% endif %}
                </div>

                {% if event.link or event.registrationLink or event.resultsLink %}
                    <div class="col-sm-6 mt-2 mt-sm-0">
                        {% if event.link %}
                            <a target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" href="{{ event.link }}">
                                <i class="bi bi-info-circle me-1"></i>{{ 'events.website_link'|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i>
                            </a>
                        {% endif %}

                        {% if event.registrationLink %}
                            <a target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" href="{{ event.registrationLink }}">
                                <i class="bi bi-person-plus me-1"></i>{{ 'events.registration_link'|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i>
                            </a>
                        {% endif %}

                        {% if event.resultsLink %}
                            <a target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" href="{{ event.resultsLink }}">
                                <i class="bi bi-trophy me-1"></i>{{ 'events.results_link'|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i>
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            {# One compact row of the rounds whose results page has something to show, in schedule order -
               the puzzle cards link their own round too, this is the overview for whoever came for results #}
            {% if result_rounds|length > 0 %}
                <div class="d-flex flex-wrap align-items-center gap-1 mt-2" data-event-round-results>
                    <span class="small text-muted me-1"><i class="bi bi-trophy me-1"></i>{{ 'events.results_by_round'|trans }}</span>
                    {% for round in result_rounds %}
                        <a class="btn btn-outline-primary btn-xs text-nowrap" href="{{ round_results_urls[round.id] }}">
                            <span class="d-inline-block rounded-circle me-1 align-middle" style="width: .5rem; height: .5rem; background-color: {{ round.color }};" aria-hidden="true"></span>{{ round.name }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="ms-3 flex-shrink-0 event-image">
            {% if event.logo %}
                <img style="max-height: 84px;" src="{{ event.logo|thumbnail('puzzle_small') }}" alt="{{ event.name }} logo" class="img-fluid">
            {% endif %}
        </div>
    </div>

    {% if event.description %}
        {# Plain text: nl2br escapes first, then keeps the organiser's line breaks #}
        <p class="mt-3 mb-0" data-event-description>{{ event.description|nl2br }}</p>
    {% endif %}

    {# Page sections (docs/features/competitions-management/public-page.md): with the default layout the page renders
       exactly what it rendered before - puzzles, "I'm going", marketplace card, participants - plus the official
       results once a round is published and the organiser's custom sections #}
    {% for entry in page_sections %}
        {% if entry.isSystem %}
            {% if entry.key == 'schedule' %}
                {# PORT-TODO: PR #136 rendered a rounds list here (_competition_rounds_section) and hid the puzzles when the
                   event has rounds; main shows the puzzles with their round badges instead - decide (opt-in only) #}
            {% elseif entry.key == 'puzzles' %}
                <h2 class="h5 mt-4 mb-3">{{ 'events.competition_puzzles'|trans }}</h2>

                {% if puzzles|length > 0 %}
                    <div class="row g-2 g-md-3">
                        {% for puzzle in puzzles %}
                            {{ include('_puzzle_item.html.twig', {
                                'search': '',
                            }) }}
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="lead">{{ 'events.no_puzzle_text'|trans|raw }}</p>
                {% endif %}
            {% elseif entry.key == 'registration' %}
                {{ include('_competition_registration_block.html.twig') }}

                {{ include('_event_offers.html.twig', {
                    offers: event_offers,
                    competition_id: event.id,
                    attendance: attendance,
                    just_joined: event_offers_just_joined,
                }) }}
            {% elseif entry.key == 'participants' %}
                <twig:CompetitionParticipants competitionId="{{ event.id }}" />
            {% endif %}
        {% else %}
            {{ include('_page_section.html.twig', {section: entry}) }}
        {% endif %}
    {% endfor %}

{% endblock %}
