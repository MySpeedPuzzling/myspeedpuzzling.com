{% extends 'base.html.twig' %}

{# The full event name - never shortened, it is what people search - plus the year when the name has none;
   "Results" once the event is over and has results here (see EventTitle::saysResults()) - official ones too (official-results.md) #}
{% block title %}
    {%- if event_title.saysResults(results_count) -%}
        {{- 'events.meta.event_detail_title_results'|trans({'%event%': event_title.label}) -}}
    {%- else -%}
        {{- event_title.label -}}
    {%- endif -%}
{% endblock %}

{% block robots %}
    {# Unapproved/rejected events are publicly reachable at their slug URL - keep them out of the index #}
    {% if event.approvedAt is null or event.rejectedAt is not null %}
        <meta name="robots" content="noindex, nofollow">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block meta_description %}
    {%- if event_title.saysResults(results_count) -%}
        {%- set past_description_params = {
            '%count%': results_count,
            '%results%': results_count|format_number,
            '%name%': event.name,
            '%date%': event_title.startsAt|format_date('long'),
            '%location%': event.location ?? '',
        } -%}
        {%- if event.isOnline -%}
            {{- (event.hasPublishedOfficialResults ? 'events.meta.event_detail_description_past_official_online' : 'events.meta.event_detail_description_past_online')|trans(past_description_params) -}}
        {%- elseif event.location -%}
            {{- (event.hasPublishedOfficialResults ? 'events.meta.event_detail_description_past_official' : 'events.meta.event_detail_description_past')|trans(past_description_params) -}}
        {%- else -%}
            {{- (event.hasPublishedOfficialResults ? 'events.meta.event_detail_description_past_official_no_location' : 'events.meta.event_detail_description_past_no_location')|trans(past_description_params) -}}
        {%- endif -%}
    {%- elseif event.isOnline and event.dateFrom -%}
        {{- 'events.meta.event_detail_description_online'|trans({'%name%': event.name, '%date%': event.dateFrom|format_date('long')}) -}}
    {%- elseif event.isOnline -%}
        {{- 'events.meta.event_detail_description_online_no_date'|trans({'%name%': event.name}) -}}
    {%- elseif event.dateFrom and event.location -%}
        {{- 'events.meta.event_detail_description'|trans({'%name%': event.name, '%date%': event.dateFrom|format_date('long'), '%location%': event.location}) -}}
    {%- elseif event.location -%}
        {{- 'events.meta.event_detail_description_no_date'|trans({'%name%': event.name, '%location%': event.location}) -}}
    {%- elseif event.dateFrom -%}
        {{- 'events.meta.event_detail_description_no_location'|trans({'%name%': event.name, '%date%': event.dateFrom|format_date('long')}) -}}
    {%- else -%}
        {{- 'events.meta.event_detail_description_fallback'|trans({'%name%': event.name}) -}}
    {%- endif -%}
{% endblock %}

{% block json_ld %}
{{ parent() }}
{{ include('event_parts/_event_json_ld.html.twig', {meta_description: block('meta_description')|trim, series: null}) }}
{% endblock %}

{% block content %}
    {#- The event page (docs/features/events-page/detail-pages.md "Edition page and one-time event page"): B owns the
        sections below the header, C the JSON-LD -#}
    <div class="ev-detail ev-detail-event"
        {%- if online %} data-controller="event-local-time" data-event-local-time-messages-value="{{ {
            yours: 'event_detail.time.yours'|trans,
            yours_next_day: 'event_detail.time.yours_next_day'|trans,
            yours_previous_day: 'event_detail.time.yours_previous_day'|trans,
        }|json_encode }}"{% endif %}>
        {% embed 'event_parts/_detail_header.html.twig' with {
            crumbs: [{label: 'events.title'|trans, url: path('events')}],
            logo: event.logo,
            name: event.name,
            description: event.description,
            return_fallback_url: path('events'),
            return_fallback_title: 'events.title'|trans,
        } %}
            {% block facts %}
                {{- include('event_parts/_place.html.twig', {place: event_place}) }}
                {% if timeline.start %}
                    <span class="ev-detail-fact">{{ events_date_range(timeline.start, timeline.end, 'yMMMd') }}</span>
                {% else %}
                    <span class="ev-detail-fact" data-edition-date-not-set>{{ 'edition.date_not_set'|trans }}</span>
                {% endif %}
                {% if timeline.isLive %}<span class="ev-detail-fact ev-when-live">{{ include('event_parts/_live.html.twig') }}</span>{% endif %}
                
                {% if timeline.rounds|length >= 2 %}<span class="ev-detail-fact">{{ 'event_detail.facts.rounds'|trans({'%count%': timeline.rounds|length}) }}</span>{% endif %}
            {% endblock %}
            {% block actions %}
                {{ include('event_parts/_going_action.html.twig', {competition_id: event.id, attendance: attendance, is_past: event_title.isPast, is_public: is_publicly_visible}) }}
                {{ include('event_parts/_follow_action.html.twig', {follow_target: follow_target, following: following, kind: 'event', follow_name: event.name}) }}
                {% if event.registrationLink %}
                    <a class="ev-action-button" target="_blank" rel="noopener noreferrer" href="{{ event.registrationLink }}">{{ 'events.registration_link'|trans }}<span aria-hidden="true"> ↗</span></a>
                {% endif %}
                {% if event.link %}
                    <a class="ev-action-button" target="_blank" rel="noopener noreferrer" href="{{ event.link }}">{{ 'events.website_link'|trans }}<span aria-hidden="true"> ↗</span></a>
                {% endif %}
                {% if event.resultsLink %}
                    <a class="ev-action-button" target="_blank" rel="noopener noreferrer" href="{{ event.resultsLink }}">{{ 'events.results_link'|trans }}<span aria-hidden="true"> ↗</span></a>
                {% endif %}
                {% if can_add_time %}
                    <a class="ev-action-button" href="{{ path('puzzle_add', {competition: event.id}) }}">{{ 'events.add_my_time'|trans }}</a>
                {% endif %}
                {% if is_granted('IS_AUTHENTICATED_REMEMBERED') and is_granted('COMPETITION_EDIT', event.id) %}
                    {{ include('event_parts/_manage_button.html.twig', {manage: manage, return_title: event.name, delete_return: delete_return}) }}
                {% endif %}
            {% endblock %}
        {% endembed %}

        <div class="ev-detail-body">
            <div class="ev-detail-main">
                {{ include('event_parts/_facts_strip_event.html.twig') }}
                {{ include('event_parts/_rounds_timeline.html.twig', {timeline: timeline, event: event, online: online}) }}
                {{ include('event_parts/_more_puzzles.html.twig') }}
                {{ include('event_parts/_taking_part.html.twig') }}

                {{ include('_event_offers.html.twig', {
                    offers: event_offers,
                    competition_id: event.id,
                    attendance: attendance,
                    just_joined: event_offers_just_joined,
                }) }}

                {#- Organiser-written sections (competitions-management/public-page.md): after the marketplace card, before the
                    participants - nothing at all without them -#}
                {% if page_sections is not empty %}{{ include('_page_sections.html.twig', {sections: page_sections}) }}{% endif %}

                <twig:CompetitionParticipants competitionId="{{ event.id }}" />
            </div>
            {{ include('event_parts/_detail_side.html.twig') }}
        </div>

        {{ include('event_parts/_manage_menu_host.html.twig', {show_menu: is_granted('IS_AUTHENTICATED_REMEMBERED') and (is_granted('COMPETITION_EDIT', event.id) or is_granted('ADMIN_ACCESS'))}) }}
    </div>
{% endblock %}
