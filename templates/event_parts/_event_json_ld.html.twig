{#
    The Event JSON-LD of the edition and one-time event pages (owner: workstream C, docs/features/events-page/
    detail-pages.md "SEO"). Moved verbatim from the two page templates; `series` is set on the edition page only.
    Variables: the page's (event, event_title, is_publicly_visible, series), meta_description (the page's, trimmed).
#}
{% if series is defined and series is not null %}
{% if is_publicly_visible and event.dateFrom is not null and series.slug is not null and event.slug is not null %}
{% set edition_url = url('edition_detail', {'seriesSlug': series.slug, 'editionSlug': event.slug}) %}
{% set edition_image = event.logo ?? series.logo %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Event",
    "name": {{ event_title.name|json_ld }},
    "url": {{ edition_url|json_ld }},
    "startDate": {{ event.dateFrom|date('Y-m-d')|json_ld }},
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": {{ (series.isOnline ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode')|json_ld }}
    {%- if event.dateTo %},
    "endDate": {{ event.dateTo|date('Y-m-d')|json_ld }}
    {%- endif %}
    {%- if series.isOnline %},
    "location": {
        "@type": "VirtualLocation",
        "url": {{ (event.registrationLink ?? event.resultsLink ?? edition_url)|json_ld }}
    }
    {%- elseif event.location %},
    "location": {
        "@type": "Place",
        "name": {{ event.location|json_ld }},
        "address": {
            "@type": "PostalAddress",
            "addressLocality": {{ event.location|json_ld }}
            {%- if event.locationCountryCode %},
            "addressCountry": {{ event.locationCountryCode.name|upper|json_ld }}
            {%- endif %}
        }
    }
    {%- endif %}
    {%- if edition_image %},
    {# The large metadata-stripped preset (1200 px JPEG; Google wants event images >= 720 px wide) - never
       the uploaded original, older uploads may still carry EXIF/GPS #}
    "image": {{ edition_image|thumbnail('puzzle_large')|json_ld }}
    {%- endif %}
    {%- if event.description %},
    "description": {{ event.description|json_ld }}
    {%- endif %},
    "organizer": {
        "@type": "Organization",
        "name": {{ series.name|json_ld }}
    }
    {%- if event.registrationLink %},
    "offers": {
        "@type": "Offer",
        "url": {{ event.registrationLink|json_ld }}
    }
    {%- endif %}
}
</script>
{% endif %}
{% else %}
{% if event.approvedAt is not null and event.rejectedAt is null and event.dateFrom is not null and event.slug is not null %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Event",
    "name": {{ event.name|json_ld }},
    "url": {{ url('event_detail', {'slug': event.slug})|json_ld }},
    "startDate": {{ event.dateFrom|date('Y-m-d')|json_ld }},
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": {{ (event.isOnline ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode')|json_ld }}
    {%- if event.dateTo %},
    "endDate": {{ event.dateTo|date('Y-m-d')|json_ld }}
    {%- endif %}
    {%- if event.isOnline %},
    "location": {
        "@type": "VirtualLocation",
        "url": {{ (event.registrationLink ?? event.resultsLink ?? url('event_detail', {'slug': event.slug}))|json_ld }}
    }
    {%- elseif event.location %},
    "location": {
        "@type": "Place",
        "name": {{ event.location|json_ld }},
        "address": {
            "@type": "PostalAddress",
            "addressLocality": {{ event.location|json_ld }}
            {%- if event.locationCountryCode %},
            "addressCountry": {{ event.locationCountryCode.name|upper|json_ld }}
            {%- endif %}
        }
    }
    {%- endif %}
    {%- if event.logo %},
    {# The large metadata-stripped preset (1200 px JPEG; Google wants event images >= 720 px wide) - never
       the uploaded original, older uploads may still carry EXIF/GPS #}
    "image": {{ event.logo|thumbnail('puzzle_large')|json_ld }}
    {%- endif %}
    {# description is a Google-recommended Event property - always emit,
       falling back to the same text as the meta description. organizer is
       deliberately NOT emitted: added_by_player is the submitter (often an
       admin), not the organizer - see docs/features/seo/TODO.md #14. #}
    ,"description": {{ (event.description ? event.description|striptags : meta_description)|json_ld }}
    {%- if event.registrationLink %},
    "offers": {
        "@type": "Offer",
        "url": {{ event.registrationLink|json_ld }}
    }
    {%- endif %}
}
</script>
{% endif %}
{% endif %}
