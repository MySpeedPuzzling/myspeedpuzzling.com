{#
    One round of the timeline (owner: workstream B): `id="round-<id>"` - the anchor the events page and the series page
    link sessions to. Variables: item (TimelineRound), event (CompetitionEvent), online (bool); the page's
    difficulty_data, puzzle_statuses.
#}
{% set round = item.round %}
<li id="round-{{ round.id }}" class="ev-round ev-round-{{ item.status.value }}">
    {{ include('event_parts/_date_leaf.html.twig', {leaf: item.leaf}) }}
    <div class="ev-round-body">
        <span class="visually-hidden">
            {%- if item.status.value == 'next' %}{{ 'event_rounds.next_round'|trans }} {% endif -%}
            {{- item.leaf.from|events_date('yMMMMEEEEd') }}: </span>
        <div class="ev-round-head">
            <span class="badge" style="background-color: {{ round.color }}; color: {{ round.textColor }};">{{ round.name }}</span>
            <span class="badge bg-secondary" data-round-category="{{ round.category.value }}">{{ ('competition.round.category.' ~ round.category.value)|trans }}</span>
            <span class="ev-round-limit">{{ 'event_rounds.minutes'|trans({'%count%': round.minutesLimit}) }}</span>
            {{ include('event_parts/_event_time.html.twig', {time: item.time, online: online}) }}
            {% if item.when %}{{ include('event_parts/_when.html.twig', {when: item.when}) }}{% endif %}
        </div>
        {% if round.puzzles is not empty %}
            <ul class="ev-round-puzzles">
                {% for puzzle in round.puzzles %}{{ include('event_parts/_round_puzzle.html.twig', {puzzle: puzzle}) }}{% endfor %}
            </ul>
        {% elseif not item.isPast %}
            <p class="ev-round-note">{{ 'event_rounds.not_announced'|trans }}</p>
        {% endif %}
        <div class="ev-round-links">
            {% if item.resultsUrl %}
                <a href="{{ item.resultsUrl }}" data-round-results-link>{{ (item.officialResults ? 'event_rounds.official_results' : 'round_results.link')|trans }}</a>
            {% endif %}
            {% if item.addTimeUrl %}
                <a href="{{ item.addTimeUrl }}" data-round-add-time>{{ 'events.add_my_time'|trans }}</a>
            {% endif %}
            {% if item.status.value == 'next' and event.registrationLink %}
                <a href="{{ event.registrationLink }}" target="_blank" rel="noopener noreferrer">{{ 'events.registration_link'|trans }}<span aria-hidden="true"> ↗</span></a>
            {% endif %}
        </div>
        {{ include('official_results/_organiser_round_links.html.twig', {competition_id: event.id, round_id: round.id}) }}
    </div>
</li>
