{#
    One puzzle inside its round (owner: workstream B): thumbnail, name linking the puzzle, pieces · brand, the difficulty
    icon for members, the viewer's badges. A hidden picture: a neutral tile and no link (the secret puzzle rules of
    GetEditionRounds). Variables: puzzle (EditionRoundPuzzle); the page's difficulty_data, puzzle_statuses.
#}
<li class="ev-round-puzzle" data-round-puzzle="{{ puzzle.puzzleId }}">
    {% if puzzle.imageHidden %}
        <span class="ev-round-puzzle-tile" title="{{ 'event_rounds.picture_hidden'|trans }}"><span class="visually-hidden">{{ 'event_rounds.picture_hidden'|trans }}</span></span>
        <span class="ev-round-puzzle-name">{{ puzzle.puzzleName }}</span>
    {% else %}
        {% if puzzle.puzzleImage %}<img class="ev-round-puzzle-thumb" src="{{ puzzle.puzzleImage|thumbnail('puzzle_small') }}" alt="{{ puzzle.puzzleName }}" loading="lazy">{% endif %}
        <a class="ev-round-puzzle-name" href="{{ path('puzzle_detail', {puzzleId: puzzle.puzzleId}) }}">{{ puzzle.puzzleName }}</a>
    {% endif %}
    <span class="ev-round-puzzle-meta">
        {%- from '_difficulty_icon.html.twig' import icon as difficulty_icon -%}
        {%- if logged_user.profile is not null and logged_user.profile.activeMembership %}{{ difficulty_icon(difficulty_data[puzzle.puzzleId].difficultyTier ?? null, false, 18) }} {% endif -%}
        {{- 'pieces_count'|trans({'%count%': puzzle.piecesCount})|raw }}{% if puzzle.manufacturerName %} · {{ puzzle.manufacturerName }}{% endif -%}
    </span>
    {% if not puzzle.imageHidden %}{{ include('puzzle/_badges.html.twig', {puzzle_id: puzzle.puzzleId}) }}{% endif %}
</li>
