{#
    The published standings of an event or edition (competition toolkit A7) above its rounds: one link per standing.
    Variables: standings (list<TimelineStanding>).
#}
<div class="ev-standings-links d-flex flex-wrap align-items-center gap-2 mb-3" data-event-standings>
    <span class="small text-muted"><i class="bi bi-bar-chart-steps me-1" aria-hidden="true"></i>{{ 'public_standing.event_links'|trans }}</span>
    {% for standing in standings %}
        <a class="btn btn-sm btn-outline-primary" href="{{ standing.url }}" data-event-standing-link>{{ standing.name }}</a>
    {% endfor %}
</div>
