{#
    "Not on our team" (RemoveEventResultClaimController, docs/features/event-results-import/README.md "Gates").

    Inputs:
      - context: EventResultClaimContext
      - claimer: Puzzler - whose claim is taken back
      - error: null|string
      - in_modal: bool
#}
{{ include('event_result_claim/_result_summary.html.twig') }}
{{ include('event_result_claim/_error.html.twig') }}

<p class="fs-sm">
    {{ 'event_result_claim.remove.intro'|trans({'%player%': claimer.isPrivate ? 'secret_puzzler_name'|trans : (claimer.playerName ?? ('#' ~ claimer.playerCode))}) }}
</p>

<form method="post" action="{{ path('event_result_claim_remove', {timeId: context.timeId, playerId: claimer.playerId}) }}" data-testid="event-result-remove-form"{% if in_modal %} data-turbo-frame="modal-frame"{% endif %}>
    <input type="hidden" name="_token" value="{{ csrf_token('event_result_claim') }}">

    <div class="mb-3">
        <label class="form-label fs-sm" for="event-result-remove-reason">{{ 'event_result_claim.remove.reason'|trans }}</label>
        <textarea class="form-control form-control-sm" id="event-result-remove-reason" name="reason" rows="2" maxlength="500"></textarea>
    </div>

    <div class="d-flex flex-wrap gap-2 justify-content-end">
        {% if in_modal %}
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">{{ 'event_result_claim.cancel'|trans }}</button>
        {% endif %}
        <button type="submit" class="btn btn-danger btn-sm">{{ 'event_result_claim.remove.submit'|trans }}</button>
    </div>
</form>
