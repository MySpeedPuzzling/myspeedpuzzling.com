{# A confirmation about a spot of an imported event result in the modal (AbstractEventResultClaimController) #}
<turbo-frame id="modal-frame">
    <div data-modal-size="modal-md" data-modal-sheet>
        <div class="modal-header">
            <h5 class="modal-title">{{ title }}</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'forms.close'|trans }}"></button>
        </div>

        <div class="modal-body">
            {%- set links_turbo_frame = '_top' -%}
            {{ include(body_template, {in_modal: true}) }}
        </div>
    </div>
</turbo-frame>
