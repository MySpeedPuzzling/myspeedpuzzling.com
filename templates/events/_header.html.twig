{# Events page header (owner: workstream A). Variables: page #}
<header class="ev-header">
    <h1 class="ev-title">{{ 'events_page.title'|trans }}</h1>
    <p class="ev-summary">
        {{- 'events_page.summary.dates'|trans({'%count%': page.summary.upcomingDates}) -}}
        {%- if page.summary.countries > 0 %} {{ 'events_page.summary.countries'|trans({'%count%': page.summary.countries}) }}{% if page.summary.hasOnline %} {{ 'events_page.summary.and_online'|trans }}{% endif %}
        {%- elseif page.summary.hasOnline %} {{ 'events_page.summary.only_online'|trans }}{% endif -%}
        {%- if page.summary.series > 0 %} · {{ 'events_page.summary.series'|trans({'%count%': page.summary.series}) }}{% endif -%}
    </p>
    <div class="ev-header-actions">
        <a class="btn btn-sm btn-primary" href="{{ path('add_competition', {return: path('events'), return_title: 'events_page.title'|trans}) }}">+ {{ 'events_page.add_event'|trans }}</a>
        {{ include('events/_organize_button.html.twig', {count: page.organizedCount}) }}
    </div>
</header>
