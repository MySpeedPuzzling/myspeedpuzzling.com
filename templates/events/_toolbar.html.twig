{# Search, List | Calendar, scope chips (owner: workstream A). Variables: page, view, query
   Every control is a plain link or the GET form, so the page works without JavaScript; events_page_controller.js
   takes the clicks over and changes the page in place (and keeps the links' URLs in step). #}
{% set scope_key = page.scope.key %}
{% set keep = (view.value == 'calendar' ? {view: 'calendar'}|merge(month ? {month: month} : {}) : {})|merge(query ? {q: query} : {}) %}
{% set view_keep = page.scope.toQuery|merge(query ? {q: query} : {}) %}
<div class="ev-toolbar" data-events-page-target="toolbar">
    <form class="ev-search" method="get" action="{{ path('events') }}" role="search" data-action="submit->events-page#submitSearch">
        <label class="visually-hidden" for="ev-search-input">{{ 'events_page.search.label'|trans }}</label>
        <svg class="ev-search-icon" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M14 14l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="ev-search-input" class="ev-search-input" type="search" name="q" value="{{ query }}"
               placeholder="{{ 'events_page.search.placeholder'|trans }}" autocomplete="off" enterkeyhint="search" maxlength="100"
               data-events-page-target="search"
               data-action="input->events-page#search keydown.esc->events-page#clearSearch">
        <span data-events-page-target="searchHidden">
            {%- for name, value in page.scope.toQuery|merge(view.value == 'calendar' ? {view: 'calendar'} : {}) %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor -%}
        </span>
        <button type="button" class="ev-search-clear" aria-label="{{ 'events_page.search.clear'|trans }}" data-events-page-target="searchClear" data-action="events-page#clearSearch" {{ query ? '' : 'hidden' }}>
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
    </form>
    <div class="ev-toolbar-row">
        <div class="ev-view-switch" role="group" aria-label="{{ 'events_page.view.label'|trans }}">
            <a class="ev-view-option" href="{{ path('events', view_keep) }}" data-ev-view="list" data-action="events-page#chooseView" aria-current="{{ view.value == 'list' ? 'true' : 'false' }}">{{ 'events_page.view.list'|trans }}</a>
            <a class="ev-view-option" href="{{ path('events', view_keep|merge({view: 'calendar'})) }}" data-ev-view="calendar" data-action="events-page#chooseView" aria-current="{{ view.value == 'calendar' ? 'true' : 'false' }}">{{ 'events_page.view.calendar'|trans }}</a>
        </div>
        <nav class="ev-chips" aria-label="{{ 'events_page.scope.label'|trans }}" data-events-page-target="chips">
            <a class="ev-chip" href="{{ path('events', keep) }}" data-ev-scope="all" data-ev-name="{{ 'events_page.scope.everywhere'|trans }}" data-action="events-page#chooseScope" aria-current="{{ scope_key == 'all' ? 'true' : 'false' }}">
                {{- 'events_page.scope.everywhere'|trans }}{% if page.everywhereUpcoming > 0 %} <span class="ev-chip-n">{{ page.everywhereUpcoming }}</span>{% endif -%}
            </a>
            {% if page.homeCountry %}
                {% set home = page.homeCountry %}
                <a class="ev-chip ev-chip-home" href="{{ path('events', {country: home.code.name}|merge(keep)) }}" data-ev-scope="{{ home.code.name }}" data-ev-name="{{ home.name }}" data-action="events-page#chooseScope" aria-current="{{ scope_key == home.code.name ? 'true' : 'false' }}">
                    <span class="fi fi-{{ home.code.name }}" aria-hidden="true"></span> {{ home.name }}{% if home.upcoming > 0 %} <span class="ev-chip-n">{{ home.upcoming }}</span>{% endif %}
                </a>
            {% elseif not is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                {# A guest's country guessed in the browser (assets/country_guess.js) - offered, never applied #}
                <a class="ev-chip ev-chip-guess" href="{{ path('events', keep) }}" data-ev-scope="" data-events-page-target="guessChip" data-action="events-page#chooseScope" aria-current="false" title="{{ 'events_page.scope.guessed'|trans }}" hidden></a>
            {% endif %}
            <a class="ev-chip" href="{{ path('events', {onlineOnly: 1}|merge(keep)) }}" data-ev-scope="online" data-ev-name="{{ 'events_page.scope.online'|trans }}" data-action="events-page#chooseScope" aria-current="{{ scope_key == 'online' ? 'true' : 'false' }}">
                {{- 'events_page.scope.online'|trans }}{% if page.onlineUpcoming > 0 %} <span class="ev-chip-n">{{ page.onlineUpcoming }}</span>{% endif -%}
            </a>
            {% for country in page.chipCountries %}
                {% if page.homeCountry is null or country.code != page.homeCountry.code %}
                    <a class="ev-chip ev-chip-country" href="{{ path('events', {country: country.code.name}|merge(keep)) }}" data-ev-scope="{{ country.code.name }}" data-ev-name="{{ country.name }}" data-action="events-page#chooseScope" aria-current="{{ scope_key == country.code.name ? 'true' : 'false' }}">
                        <span class="fi fi-{{ country.code.name }}" aria-hidden="true"></span> {{ country.name }}{% if country.upcoming > 0 %} <span class="ev-chip-n">{{ country.upcoming }}</span>{% endif %}
                    </a>
                {% endif %}
            {% endfor %}
            <a class="ev-chip ev-chip-more" href="#ev-sheet" aria-haspopup="dialog" aria-controls="ev-sheet" data-action="events-page#openSheet">
                {{- 'events_page.scope.all_countries'|trans }} <span aria-hidden="true">▾</span>
            </a>
        </nav>
    </div>
</div>
