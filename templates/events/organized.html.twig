{% extends 'base.html.twig' %}

{#
    "You organize", route organized_events (owner: workstream C, docs/features/events-page/README.md): every event and
    series the viewer created or maintains, with its status and its actions inline (the ⋯ menu's items).
    Variables: items (list<OrganizedEvent>, sorted by the controller), today
#}

{% block title %}{{ 'events_organizer.organize.title'|trans }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, follow">{% endblock %}

{% block content %}
    {%- set title = 'events_organizer.organize.title'|trans -%}
    {%- set locale = app.request.locale -%}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events_page.title'|trans, url: path('events')},
        {label: title},
    ]}) }}

    <div class="ev-organized-page">
        <header class="ev-organized-head">
            <h1 class="ev-organized-title">{{ title }}{% if items is not empty %} <span class="ev-organized-total">{{ items|length }}</span>{% endif %}</h1>
            <p class="ev-organized-note">{{ 'events_organizer.organize.note'|trans }}</p>
        </header>

        {% if items is empty %}
            <div class="ev-organized-empty">
                <p>{{ 'events_organizer.organize.empty'|trans }}</p>
                <a class="btn btn-sm btn-primary" href="{{ path('add_competition', {return: path('organized_events'), return_title: title}) }}">+ {{ 'events_page.add_event'|trans }}</a>
            </div>
        {% else %}
            <ul class="ev-organized">
                {% for item in items %}
                    {%- set reference = item.reference -%}
                    {%- set badge = item.badge(today) -%}
                    {%- set country = item.countryCode ? item.countryCode.localizedName(locale) : null -%}
                    {%- set city = item.location is not empty and (country is null or (country|lower) not in (item.location|lower)) ? item.location : null -%}
                    <li class="ev-organized-item" data-organized-id="{{ item.id }}">
                        <div class="ev-organized-top">
                            {% if reference.routeName %}
                                <a class="ev-organized-name" href="{{ path(reference.routeName, reference.routeParameters) }}">{{ reference.displayName }}</a>
                            {% else %}
                                <span class="ev-organized-name">{{ reference.displayName }}</span>
                            {% endif %}
                            <span class="ev-badge ev-badge-{{ badge.value }}">{{ badge.translationKey|trans }}</span>
                        </div>
                        <div class="ev-organized-sub">
                            {{- ('events_organizer.type.' ~ item.kind)|trans -}}
                            {%- if item.isSeries -%}
                                {%- if item.nextEditionDate %} · {{ 'events_organizer.organize.next'|trans({'%date%': item.nextEditionDate|format_date(pattern: 'EEE d LLL yyyy', locale: locale, timezone: 'UTC')}) }}
                                {%- elseif item.lastEditionDate %} · {{ 'events_organizer.organize.last'|trans({'%date%': item.lastEditionDate|format_date(pattern: 'd LLL yyyy', locale: locale, timezone: 'UTC')}) }}
                                {%- else %} · {{ 'events_organizer.organize.no_dates'|trans }}{% endif -%}
                                {{- ' · ' }}{{ 'events_organizer.organize.editions'|trans({'%count%': item.editionCount}) -}}
                            {%- elseif item.startDate -%}
                                {{- ' · ' }}{{ item.startDate|format_date(pattern: 'd LLL yyyy', locale: locale, timezone: 'UTC') -}}
                                {%- if item.endDate %} – {{ item.endDate|format_date(pattern: 'd LLL yyyy', locale: locale, timezone: 'UTC') }}{% endif -%}
                            {%- endif -%}
                            {%- if item.isOnline %} · {{ 'events_organizer.organize.online'|trans }}
                            {%- elseif city or country %} · {% if item.countryCode %}<span class="fi fi-{{ item.countryCode.name }}" aria-hidden="true"></span> {% endif %}{{ [city, country]|filter(part => part is not null)|join(', ') }}{% endif -%}
                        </div>
                        {% if item.isRejected and item.rejectionReason %}
                            <p class="ev-organized-reason">{{ 'events_organizer.organize.reason'|trans({'%reason%': item.rejectionReason}) }}</p>
                        {% endif %}
                        {{ include('events/_manage_items.html.twig', {item: item, return_url: path('organized_events'), return_title: title, layout: 'inline'}) }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <p class="ev-organized-back"><a href="{{ path('events') }}">{{ 'events_organizer.menu.back'|trans({'%title%': 'events_page.title'|trans}) }}</a></p>
    </div>
{% endblock %}
