{% extends 'base.html.twig' %}

{#
    "You organize", route organized_events (owner: workstream C, docs/features/events-page/README.md,
    docs/features/organizations/README.md P9): the viewer's organizations first - each with its series and one-time
    events listed under it - then every other event and series the viewer created or maintains, with its status and its
    actions inline (the ⋯ menu's items).
    Variables: groups (list<{organization: OrganizedEvent, items: list<OrganizedEvent>}>), items (list<OrganizedEvent>,
    the rest - both sorted by the controller), total (organizations + the rest = the header button's count), today
#}

{% block title %}{{ 'events_organizer.organize.title'|trans }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, follow">{% endblock %}

{% block content %}
    {%- set title = 'events_organizer.organize.title'|trans -%}
    {%- set locale = app.request.locale -%}
    {%- set back = {return: path('organized_events'), return_title: title} -%}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events_page.title'|trans, url: path('events')},
        {label: title},
    ]}) }}

    <div class="ev-organized-page">
        <header class="ev-organized-head">
            <h1 class="ev-organized-title">{{ title }}{% if total > 0 %} <span class="ev-organized-total">{{ total }}</span>{% endif %}</h1>
            <p class="ev-organized-note">{{ 'organizer_tools.organize.note'|trans }}</p>
            <div class="ev-organized-actions">
                <a class="btn btn-sm btn-primary" href="{{ path('add_competition', back) }}" data-add-event>+ {{ 'events_page.add_event'|trans }}</a>
                <a class="btn btn-sm btn-outline-primary" href="{{ path('add_organization', back) }}" data-add-organization>+ {{ 'organizer_tools.organize.add_organization'|trans }}</a>
                <a class="ev-organized-directory" href="{{ path('organizations') }}">{{ 'organizer_tools.organize.directory'|trans }}</a>
            </div>
        </header>

        {% if total == 0 %}
            <div class="ev-organized-empty">
                <p>{{ 'events_organizer.organize.empty'|trans }}</p>
                <p class="ev-organized-empty-hint">{{ 'organizer_tools.organize.empty_hint'|trans }}</p>
            </div>
        {% else %}
            <ul class="ev-organized">
                {% for group in groups %}
                    {%- set nested -%}
                        {% if group.items is not empty %}
                            <ul class="ev-organized ev-organized-nested" aria-label="{{ 'organizer_tools.organize.under'|trans({'%name%': group.organization.name}) }}">
                                {% for item in group.items %}
                                    {{ include('events/_organized_item.html.twig', {item: item, today: today, return_title: title, locale: locale}, with_context = false) }}
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {%- endset -%}
                    {{ include('events/_organized_item.html.twig', {item: group.organization, today: today, return_title: title, locale: locale, nested: nested}, with_context = false) }}
                {% endfor %}
                {% for item in items %}
                    {{ include('events/_organized_item.html.twig', {item: item, today: today, return_title: title, locale: locale}, with_context = false) }}
                {% endfor %}
            </ul>
        {% endif %}

        <p class="ev-organized-back"><a href="{{ path('events') }}">{{ 'events_organizer.menu.back'|trans({'%title%': 'events_page.title'|trans}) }}</a></p>
    </div>
{% endblock %}
