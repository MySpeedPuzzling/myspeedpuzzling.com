{% extends 'base.html.twig' %}

{% block title %}{{ 'faq.meta.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'faq.meta.description'|trans }}{% endblock %}

{# Defined at top level so the JSON-LD and the visible accordion below cannot
   drift apart - they must answer every question identically. #}
{% set faq_items = ['what_is_speed_puzzling', 'how_long_1000_pieces', 'how_competitions_work', 'physical_puzzles', 'fair_play', 'qr', 'add_time_for_missing_puzzle', 'edit_or_delete_time', 'button_start_solving', 'button_add_my_time', 'duplicate_accounts', 'instagram_sign_in', 'shared_computer', 'helping'] %}

{# The 1000-piece answer quotes live community numbers. With no recorded solves
   to quote we drop the question entirely rather than publish an empty claim -
   in practice unreachable, production has thousands of 1000-piece solves. #}
{% if median_1000 is null %}
    {% set faq_items = faq_items|filter(item => item != 'how_long_1000_pieces') %}
{% endif %}

{% set faq_params = {
    '%link%': path('my_profile'),
    '%guide_link%': path('guide_what_is_speed_puzzling'),
    '%times_guide_link%': path('guide_puzzle_time_by_pieces'),
    '%events_link%': path('events'),
    '%edit_profile_link%': path('edit_profile'),
    '%median_1000%': median_1000,
    '%fast_1000%': fast_1000,
} %}

{% block json_ld %}
{{ parent() }}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {% for item in faq_items %}
        {
            "@type": "Question",
            "name": {{ ('faq.question_' ~ item)|trans(faq_params)|striptags|json_ld }},
            "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ ('faq.answer_' ~ item)|trans(faq_params)|striptags|json_ld }}
            }
        }{% if not loop.last %},{% endif %}

        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block content %}
    <h1>{{ 'faq.title'|trans }}</h1>

    {{ 'faq.intro_block'|trans|raw }}

    <p>
        <a class="btn btn-outline-primary btn-sm text-wrap" href="{{ path('getting_started') }}"><i class="bi bi-signpost-2 me-1"></i>{{ 'onboarding.guide.faq_link'|trans }}</a>
    </p>

    {# Every question has a stable anchor (underscores become dashes, e.g.
       faq#duplicate-accounts is linked from elsewhere) - faq_anchor opens it. #}
    <div class="accordion accordion-faq my-3" data-controller="faq-anchor">
        {% for item in faq_items %}
            <div class="accordion-item my-2 shadow" id="{{ item|replace({'_': '-'}) }}" style="scroll-margin-top: 6rem;">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#item-{{ item }}" aria-expanded="false" aria-controls="item-{{ item }}">
                        {# A span keeps the question one run of text: the in-text button example flows with it
                           instead of becoming a flex item of its own #}
                        <span>{{ ('faq.question_' ~ item)|trans(faq_params)|raw }}</span>
                    </button>
                </h2>
                <div id="item-{{ item }}" class="accordion-collapse collapse">
                    <div class="accordion-body">
                        {{ ('faq.answer_' ~ item)|trans(faq_params)|raw }}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
