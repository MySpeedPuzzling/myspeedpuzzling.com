{#
    The Help sheet (docs/features/navigation README §4.5, implementation plan §7, HELP-01b): the dynamic modal's content
    for a `Turbo-Frame: modal-frame` request - no layout, no Menu. A near full screen sheet on phones (data-modal-sheet)
    that a swipe down closes (bottom-sheet, GEST-02), Back closes it (data-modal-history, GEST-01); help-sheet keeps the
    feedback draft per player (data-help-sheet-player-value: never handed to the next player of a shared tab), focuses
    the field and releases the modal in the sent state (data-help-sheet-sent, after a send from here:
    FeedbackController answers into this frame).
    data-modal-fallback-url (signed in, HELP-05 (d)): where the dynamic modal goes when a send is answered by something
    else than this sheet - the session ended meanwhile and the firewall sent the POST to sign in -: the help page with
    the same page attached, as a full visit, instead of closing the sheet with the message silently lost.
#}
<turbo-frame id="modal-frame">
    <div data-modal-size="" data-modal-sheet data-modal-scrollable data-modal-history data-controller="bottom-sheet help-sheet" data-help-sheet{% if logged_user.profile is not null %} data-help-sheet-player-value="{{ logged_user.profile.playerId }}" data-modal-fallback-url="{{ path('help', context.attachedPath is not null ? {url: context.attachedPath} : {}) }}"{% endif %}{% if sent|default(false) %} data-help-sheet-sent{% endif %}>
        <div class="bottom-sheet-top" data-bottom-sheet-target="handle">
            <span class="bottom-sheet-handle" aria-hidden="true"></span>
            <div class="modal-header">
                <h2 class="modal-title h5" id="help-sheet-title" tabindex="-1" data-bottom-sheet-target="heading">{{ 'help.title'|trans }}</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'help.close'|trans }}" data-nav="help/help/close"></button>
            </div>
        </div>
        <div class="modal-body" data-bottom-sheet-target="body">
            {{ include('help/_content.html.twig', {in_frame: true}) }}
        </div>
    </div>
</turbo-frame>
