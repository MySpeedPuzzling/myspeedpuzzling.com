{#
    The Help sheet (docs/features/navigation README §4.5, implementation plan §7): the dynamic modal's content for a
    `Turbo-Frame: modal-frame` request - no layout, no Menu. A near full screen sheet on phones (data-modal-sheet), Back
    closes it (data-modal-history). HELP-01b adds the sheet controllers and the feedback box.
#}
<turbo-frame id="modal-frame">
    <div data-modal-size="" data-modal-sheet data-modal-scrollable data-modal-history data-help-sheet>
        <div class="modal-header">
            <h2 class="modal-title h5" id="help-sheet-title">{{ 'help.title'|trans }}</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'help.close'|trans }}" data-nav="help/help/close"></button>
        </div>
        <div class="modal-body">
            {{ include('help/_content.html.twig') }}
        </div>
    </div>
</turbo-frame>
