{% extends 'base.html.twig' %}

{#
    Help & feedback as a page (docs/features/navigation README §4.5): the fallback of the Help sheet - no JS, a new tab,
    the native app. Not for the index (noindex, follow); its ?url= variants are kept out of crawling by robots.txt.
    Signed-in players get the feedback box as a plain form (FeedbackController: Post/Redirect/Get, HELP-01b).
#}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'help.meta.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, follow">{% endblock %}

{% block content %}
    <div class="help-page mx-auto" style="max-width: 40rem;" data-help-sheet>
        <h1 class="mb-3">{{ 'help.title'|trans }}</h1>

        {{ include('help/_content.html.twig') }}
    </div>
{% endblock %}
