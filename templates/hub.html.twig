{% extends 'base.html.twig' %}

{# Instant Back (README §4.13 G9, GEST-15): a browse page - Turbo keeps a copy of it for Back only #}
{% block turbo_cache_control %}no-preview{% endblock %}

{% block title %}{{ 'hub.meta.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'hub.meta.description'|trans }}{% endblock %}
{# A personal dashboard that duplicates recent activity and the ladder: not a search landing page,
   but its links still lead crawlers to players and puzzles #}
{% block robots %}<meta name="robots" content="noindex, follow">{% endblock %}

{% block content %}
    {# For screen readers and the document outline only: on a phone the greeting pushed the feed and its
       "Auto-update in …" line off the first screen (Jan, 2026-10-02) #}
    <h1 class="visually-hidden">
        {% if logged_user.profile is null %}
            {{ 'hub.welcome'|trans }} {{ 'hub.seo_suffix'|trans }}
        {% else %}
            {{ 'hub.welcome_back'|trans }}, {{ logged_user.profile.playerName ?? ('#' ~ logged_user.profile.code|upper) }}
            {% if logged_user.profile.countryCode is not null %}
                <span class="shadow-custom fi fi-{{ logged_user.profile.countryCode.name }}"></span>
            {% endif %}
        {% endif %}
    </h1>

    {# The navigation launch's 30-day pointer (docs/features/navigation LAUNCH-03) - nothing while NavigationLaunch::DATE is null #}
    {{ include('navigation/_launch_pointer.html.twig', {variant: 'hub'}) }}

    {% if review_counts is not null and not review_counts.isEmpty %}
        <div class="mt-3">{{ include('review_results/_banner.html.twig', {review_counts: review_counts}) }}</div>
    {% endif %}

    {% if getting_started is not null %}
        {{ include('onboarding/_getting_started_card.html.twig', {progress: getting_started, folded: getting_started_folded}) }}
    {% endif %}

    <div class="row">
        {# Favorites | Everyone (docs/features/navigation README §3, INB-04b). Players who follow somebody start on Favorites,
           everybody else - guests included - on Everyone; the pane shown first renders with the page, the other one when it is
           first shown (loading="lazy"). Pane ids are the deep links (#recent-favorites-activity, #recent-activity). #}
        {% set profile = logged_user.profile %}
        {% set favorites_first = profile is not null and profile.favoritePlayers is not empty %}
        {% set favorites_seen_at = profile is not null ? profile.favoritesSeenAt : null %}
        {# "N new" since the last visit, counted from the rows the Favorites feed renders (FavoritesFeed: no statement of its own) #}
        {% set new_count = favorites_first ? favorites_new_count() : null %}
        {% set feed_limit = constant('SpeedPuzzling\\Web\\Navigation\\FavoritesFeed::LIMIT') %}
        {# Phones (< 768 px): both panes in one horizontal scroll-snap scroller - a swipe switches feeds, the tabs stay the main
           control (GEST-16, feed_swipe_controller.js, _hub-feeds.scss). Until the lazy controller wakes the scroller only the
           .active pane shows, as with Bootstrap's tabs, so the page loads without a shift; the pane not shown first carries
           .is-resting from the server, which takes its height only once the scroller is awake. From 768 px Bootstrap's
           tabs as before. #}
        <div class="col-lg-6 pt-lg-4" data-controller="feed-swipe">
            <ul class="nav nav-fill nav-tabs hub-feed-tabs mt-0" role="tablist" data-controller="tabs" data-feed-swipe-target="tabs">
                <li class="nav-item">
                    <a class="nav-link{{ favorites_first ? ' active' }}" href="#recent-favorites-activity" data-bs-toggle="tab" role="tab" aria-controls="recent-favorites-activity" aria-selected="{{ favorites_first ? 'true' : 'false' }}" data-action="tabs#showTab">
                        <div class="text-center">
                            <span class="media-tab-title h6 text-nowrap pt-2 mb-0">{{ 'hub.recent_favorites_activity'|trans }}</span>
                            {%- if new_count is not null and new_count > 0 %}
                                {#- The full words, or on narrow phones the number alone - the words stay in the tab's accessible
                                    name there (visually hidden), so the two tabs keep one row in every locale (_hub-feeds.scss) #}
                                <span class="hub-feed-new">
                                    {%- if new_count >= feed_limit -%}
                                        <span class="hub-feed-new-full">{{ 'hub.feed.new_capped'|trans({'%count%': feed_limit}) }}</span><span class="hub-feed-new-short" aria-hidden="true">{{ feed_limit }}+</span>
                                    {%- else -%}
                                        <span class="hub-feed-new-full">{{ 'hub.feed.new_count'|trans({'%count%': new_count}) }}</span><span class="hub-feed-new-short" aria-hidden="true">{{ new_count }}</span>
                                    {%- endif -%}
                                </span>
                            {%- endif %}
                        </div>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link{{ favorites_first ? '' : ' active' }}" href="#recent-activity" data-bs-toggle="tab" role="tab" aria-controls="recent-activity" aria-selected="{{ favorites_first ? 'false' : 'true' }}" data-action="tabs#showTab">
                        <div class="text-center">
                            <span class="media-tab-title h6 text-nowrap pt-2 mb-0">{{ 'hub.feed.everyone'|trans }}</span>
                        </div>
                    </a>
                </li>
            </ul>

            <div class="tab-content hub-feeds" data-feed-swipe-target="scroller">
                {# Both feeds refresh every minute while shown and somebody is here; the line on the "Show more" row counts down
                   and pauses (docs/features/live-activity-feed.md).
                   "New since your last visit" (INB-04a): the first time this pane is shown in a visit - at once when it is the
                   first pane - the feed is marked seen (favorites_seen_controller.js, never from an automatic refresh); the
                   feed keeps the last visit it was rendered with as `newSince`, so this visit's new rows stay new #}
                <div class="tab-pane fade{{ favorites_first ? ' show active' : ' is-resting' }}" id="recent-favorites-activity" role="tabpanel" data-feed-swipe-target="pane"
                    {%- if favorites_first %}
                    data-controller="favorites-seen"
                    data-favorites-seen-new-since-value="{{ favorites_seen_at is not null ? favorites_seen_at.timestamp : 0 }}"
                    data-favorites-seen-rendered-value="{{ 'now'|date('U') }}"
                    data-favorites-seen-interval-value="{{ constant('SpeedPuzzling\\Web\\Value\\FavoritesSeen::MARK_EVERY_SECONDS') }}"
                    {%- endif %}>
                    {% if profile is null %}
                        <div class="alert alert-accent small d-flex mt-3" role="alert">
                            <div class="alert-icon py-0">
                                <i class="ci-announcement"></i>
                            </div>
                            <div>{{ 'hub.not_logged'|trans }}</div>
                        </div>
                    {% else %}
                        <twig:RecentActivity :loading="favorites_first ? null : 'lazy'" :limit="feed_limit" :showLimit="4" :favoritesOnly="true" :autoRefresh="true" :newSince="favorites_seen_at" />
                    {% endif %}
                </div>

                <div class="tab-pane fade{{ favorites_first ? ' is-resting' : ' show active' }}" id="recent-activity" role="tabpanel" data-feed-swipe-target="pane">
                    <twig:RecentActivity :loading="favorites_first ? 'lazy' : null" limit="20" :showLimit="4" :autoRefresh="true" />
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <twig:MostActiveSoloPlayers loading="lazy" :showLimit="4" />
        </div>

        <div class="col-lg-6">
            <twig:MostSolvedPuzzles loading="lazy" :showLimit="4" />
        </div>

        <div class="col-lg-6">
            <twig:GlobalStatistics loading="lazy" />
        </div>
    </div>
{% endblock %}
