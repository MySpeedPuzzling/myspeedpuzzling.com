{% extends 'base.html.twig' %}

{% block title %}{{ 'hub.meta.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'hub.meta.description'|trans }}{% endblock %}
{# A personal dashboard that duplicates recent activity and the ladder: not a search landing page,
   but its links still lead crawlers to players and puzzles #}
{% block robots %}<meta name="robots" content="noindex, follow">{% endblock %}

{% block content %}
    {# For screen readers and the document outline only: on a phone the greeting pushed the feed and its
       "Auto-update in …" line off the first screen (Jan, 2026-10-02) #}
    <h1 class="visually-hidden">
        {% if logged_user.profile is null %}
            {{ 'hub.welcome'|trans }} {{ 'hub.seo_suffix'|trans }}
        {% else %}
            {{ 'hub.welcome_back'|trans }}, {{ logged_user.profile.playerName ?? ('#' ~ logged_user.profile.code|upper) }}
            {% if logged_user.profile.countryCode is not null %}
                <span class="shadow-custom fi fi-{{ logged_user.profile.countryCode.name }}"></span>
            {% endif %}
        {% endif %}
    </h1>

    {% if review_counts is not null and not review_counts.isEmpty %}
        <div class="mt-3">{{ include('review_results/_banner.html.twig', {review_counts: review_counts}) }}</div>
    {% endif %}

    {% if getting_started is not null %}
        {{ include('onboarding/_getting_started_card.html.twig', {progress: getting_started, folded: getting_started_folded}) }}
    {% endif %}

    <div class="row">
        {# Both feeds refresh every minute while shown and somebody is here; the line on the "Show more" row counts down
           and pauses (docs/features/live-activity-feed.md) #}
        <div class="col-lg-6 pt-lg-4">
            <ul class="nav nav-fill nav-tabs mt-0" role="tablist" data-controller="tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#recent-activity" data-bs-toggle="tab" role="tab" data-action="tabs#showTab">
                        <div class="text-center">
                            <span class="media-tab-title h6 text-nowrap pt-2 mb-0">{{ 'hub.recent_activity'|trans }}</span>
                        </div>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#recent-favorites-activity" data-bs-toggle="tab" role="tab" data-action="tabs#showTab">
                        <div class="text-center">
                            <span class="media-tab-title h6 text-nowrap pt-2 mb-0">{{ 'hub.recent_favorites_activity'|trans }}</span>
                        </div>
                    </a>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="recent-activity" role="tabpanel">
                    <twig:RecentActivity limit="20" :showLimit="4" :autoRefresh="true" />
                </div>

                {# "New since your last visit" (docs/features/navigation, INB-04a): the first time this pane is shown in a visit,
                   the feed is marked seen (favorites_seen_controller.js, never from an automatic refresh); the feed keeps the
                   last visit it was rendered with as `newSince`, so this visit's new rows stay new #}
                {% set favorites_seen_at = logged_user.profile is not null ? logged_user.profile.favoritesSeenAt : null %}
                <div class="tab-pane fade" id="recent-favorites-activity" role="tabpanel"
                    {%- if logged_user.profile is not null and logged_user.profile.favoritePlayers is not empty %}
                    data-controller="favorites-seen"
                    data-favorites-seen-new-since-value="{{ favorites_seen_at is not null ? favorites_seen_at.timestamp : 0 }}"
                    data-favorites-seen-rendered-value="{{ 'now'|date('U') }}"
                    data-favorites-seen-interval-value="{{ constant('SpeedPuzzling\\Web\\Value\\FavoritesSeen::MARK_EVERY_SECONDS') }}"
                    {%- endif %}>
                    {% if logged_user.profile is null %}
                        <div class="alert alert-accent small d-flex mt-3" role="alert">
                            <div class="alert-icon py-0">
                                <i class="ci-announcement"></i>
                            </div>
                            <div>{{ 'hub.not_logged'|trans }}</div>
                        </div>
                    {% else %}
                        <twig:RecentActivity loading="lazy" limit="20" :showLimit="4" :favoritesOnly="true" :autoRefresh="true" :newSince="favorites_seen_at" />
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <twig:MostActiveSoloPlayers loading="lazy" :showLimit="4" />
        </div>

        <div class="col-lg-6">
            <twig:MostSolvedPuzzles loading="lazy" :showLimit="4" />
        </div>

        <div class="col-lg-6">
            <twig:GlobalStatistics loading="lazy" />
        </div>
    </div>
{% endblock %}
