{% extends 'base.html.twig' %}

{% set hide_comparison_launcher = true %}
{# An event that manages registration (docs/features/competitions-management/registration.md) - nothing of it otherwise #}
{% set managed = registration is defined and registration is not null %}

{% block title %}{{ 'competition.join.title'|trans({'%competitionName%': competition.name}) }}{% endblock %}

{% block content %}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events.title'|trans, url: path('events')},
        {label: competition.name, url: competition_url},
        {label: 'competition.join.title'|trans({'%competitionName%': ''})},
    ]}) }}
    {{ include('_return_back_button.html.twig', {fallbackUrl: competition_url, fallbackTitle: competition.name}) }}

    <div class="pb-4">
        <h1 class="h2">{{ 'competition.join.title'|trans({'%competitionName%': competition.name}) }}</h1>

        <div class="p-4 mt-4 shadow mx-auto" style="max-width: 500px;">
            {% if not managed or not_connected_participants is not empty %}
            <p class="mb-3">{{ 'competition.join.picker_description'|trans }}</p>

            <form method="post" action="{{ path('join_competition', {'competitionId': competition.id}) }}">
                {% if managed %}
                    <input type="hidden" name="_token" value="{{ csrf_token(register_csrf_id) }}">
                {% endif %}
                <div class="mb-3">
                    <select name="participant_id" class="form-select" required
                            data-controller="country-autocomplete symfony--ux-autocomplete--autocomplete">
                        <option value="">{{ 'competition.join.select_name'|trans }}</option>
                        {% for participant in not_connected_participants %}
                            <option value="{{ participant.id }}" data-icon="{{ participant.countryCode ? 'fi fi-' ~ participant.countryCode.name }}"{% if managed and participant.id == matching_participant_id %} selected{% endif %}>{{ participant.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                {% if managed and registration.isRegistered and registration.playerSelfJoined %}
                    {# "Change" away from the player's own registration lets go of it (review 2, A-F4) - said before, and a
                       paid one only on an explicit yes #}
                    {% if registration.isPaid %}
                        <div class="alert alert-warning small py-2" role="alert" data-registration-release="paid">
                            <p class="mb-2">{{ 'competition_registration.join.releases_paid'|trans }}</p>
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" name="release_paid" value="1" id="release-paid" required>
                                <label class="form-check-label" for="release-paid">{{ 'competition_registration.join.releases_paid_confirm'|trans }}</label>
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-info small py-2" role="status" data-registration-release="{{ registration.isWaitlisted ? 'waitlisted' : 'reserved' }}">
                            {{ (registration.isWaitlisted ? 'competition_registration.join.releases_waitlist' : 'competition_registration.join.releases_own')|trans }}
                        </div>
                    {% endif %}
                {% endif %}

                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-check-lg me-1"></i>{{ 'competition.join.connect_confirm'|trans }}
                </button>
            </form>
            {% endif %}

            {% if managed %}
                {% if not is_self_joined %}
                    {% if not_connected_participants is not empty %}
                        <hr class="my-4">
                        <p class="text-muted small mb-2">{{ 'competition.join.not_on_list'|trans }}</p>
                    {% endif %}
                    {{ include('_competition_registration_confirm.html.twig') }}
                {% endif %}
            {% elseif not is_self_joined %}
                <hr class="my-4">

                <p class="text-muted small mb-2">{{ 'competition.join.not_on_list'|trans }}</p>

                <form method="post" action="{{ path('join_competition', {'competitionId': competition.id}) }}">
                    <input type="hidden" name="self_join" value="1">
                    <button type="submit" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-person-plus me-1"></i>{{ 'competition.join.join_as'|trans({'%name%': profile.playerName ?? profile.code, '%country%': profile_country ? profile_country.value : ''}) }}
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
