{% extends 'base.html.twig' %}

{# Instant Back (README §4.13 G9, GEST-15): a browse page - Turbo keeps a copy of it for Back only #}
{% block turbo_cache_control %}no-preview{% endblock %}

{% block title %}{{ 'ladder.meta.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'ladder.meta.description'|trans }}{% endblock %}

{% block content %}
    {{ include('_leaderboards_nav.html.twig') }}

    {# The category dropdown sits next to the heading, not inside it: every menu item used to end up in the H1 text #}
    <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
        <h1 class="mb-0">{{ 'ladder.title'|trans }}</h1>
        {{ include('_ladder_dropdown.html.twig') }}
    </div>

    {{ include('_ladder_dropdown_countries.html.twig') }}

    <div class="row">
        <div class="col-12 col-md-6">
            <h2 class="h4 mt-4">{{ 'ladder.solo'|trans }} - {{ 'pieces_count'|trans({ '%count%': 500 })|raw }} <span class="ms-2 badge bg-primary rounded-pill badge-shadow">Top 10</span></h2>

            <twig:LadderTable type="solo" :piecesCount="500" :limit="10" :countryCode="active_country ? active_country.name : null" />

            <p class="mb-3">
                <a href="{{ path('ladder_solo_500_pieces' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="btn btn-outline-primary btn-sm">{{ 'show_more'|trans }}</a>
            </p>
        </div>

        <div class="col-12 col-md-6">
            <h2 class="h4 mt-4">{{ 'ladder.solo'|trans }} - {{ 'pieces_count'|trans({ '%count%': 1000 })|raw }} <span class="ms-2 badge bg-primary rounded-pill badge-shadow">Top 10</span></h2>

            <twig:LadderTable type="solo" :piecesCount="1000" :limit="10" :countryCode="active_country ? active_country.name : null" />

            <p class="mb-3">
                <a href="{{ path('ladder_solo_1000_pieces' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="btn btn-outline-primary btn-sm">{{ 'show_more'|trans }}</a>
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-6">
            <h2 class="h4 mt-4">{{ 'ladder.duo'|trans }} - {{ 'pieces_count'|trans({ '%count%': 500 })|raw }} <span class="ms-2 badge bg-primary rounded-pill badge-shadow">Top 10</span></h2>

            <twig:LadderTable loading="lazy" type="pairs" :piecesCount="500" :limit="10" :countryCode="active_country ? active_country.name : null" />

            <p class="mb-3">
                <a href="{{ path('ladder_pairs_500_pieces' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="btn btn-outline-primary btn-sm">{{ 'show_more'|trans }}</a>
            </p>
        </div>

        <div class="col-12 col-md-6">
            <h2 class="h4 mt-4">{{ 'ladder.duo'|trans }} - {{ 'pieces_count'|trans({ '%count%': 1000 })|raw }} <span class="ms-2 badge bg-primary rounded-pill badge-shadow">Top 10</span></h2>

            <twig:LadderTable loading="lazy" type="pairs" :piecesCount="1000" :limit="10" :countryCode="active_country ? active_country.name : null" />

            <p class="mb-3">
                <a href="{{ path('ladder_pairs_1000_pieces' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="btn btn-outline-primary btn-sm">{{ 'show_more'|trans }}</a>
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-6">
            <h2 class="h4 mt-4">{{ 'ladder.team'|trans }} - {{ 'pieces_count'|trans({ '%count%': 500 })|raw }} <span class="ms-2 badge bg-primary rounded-pill badge-shadow">Top 10</span></h2>

            <twig:LadderTable loading="lazy" type="groups" :piecesCount="500" :limit="10" :countryCode="active_country ? active_country.name : null" />

            <p class="mb-3">
                <a href="{{ path('ladder_groups_500_pieces' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="btn btn-outline-primary btn-sm">{{ 'show_more'|trans }}</a>
            </p>
        </div>

        <div class="col-12 col-md-6">
            <h2 class="h4 mt-4">{{ 'ladder.team'|trans }} - {{ 'pieces_count'|trans({ '%count%': 1000 })|raw }} <span class="ms-2 badge bg-primary rounded-pill badge-shadow">Top 10</span></h2>

            <twig:LadderTable loading="lazy" type="groups" :piecesCount="1000" :limit="10" :countryCode="active_country ? active_country.name : null" />

            <p class="mb-3">
                <a href="{{ path('ladder_groups_1000_pieces' ~ (active_country ? '_country' : ''), {countryCode: active_country ? active_country.name : null}) }}" class="btn btn-outline-primary btn-sm">{{ 'show_more'|trans }}</a>
            </p>
        </div>
    </div>

    <div class="alert alert-accent small d-flex mt-3" role="alert">
        <div class="alert-icon py-0">
            <i class="ci-announcement"></i>
        </div>
        <div></div>
        {{ 'ladder.link_to_hub'|trans({'%link%': path('hub')})|raw }}
    </div>
{% endblock %}
