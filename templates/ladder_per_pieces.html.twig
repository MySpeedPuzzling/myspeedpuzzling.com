{% extends 'base.html.twig' %}

{% set currentLadder = app.request.attributes.get('_route') %}
{% set type = currentLadder starts with 'ladder_solo' ? 'solo' : (currentLadder starts with 'ladder_pairs' ? 'pairs' : 'groups') %}
{% set pieces = currentLadder matches '/1000/' ? 1000 : 500 %}
{# The country in the page's language ("Tschechien" on /de/) - intl knows every CountryCode case #}
{% set country_label = active_country ? active_country.name|upper|country_name : null %}
{# Titles answer the "fastest {N}-piece puzzle" / "record" searches these tables are the answer to #}
{% set records_key = 'ladder.meta.records.' ~ type ~ (active_country ? '.title_country' : '.title') %}
{% set records_title = records_key|trans({'%pieces%': pieces, '%country%': country_label}) %}

{% block title %}{{ records_title }}{% endblock %}
{% block meta_description %}{{ ('ladder.meta.records.' ~ type ~ (active_country ? '.description_country' : '.description'))|trans({'%pieces%': pieces, '%country%': country_label}) }}{% endblock %}

{% block content %}
    {{ include('_leaderboards_nav.html.twig') }}

    <h1 class="mb-4">{{ records_title }}</h1>

    {{ include('_ladder_dropdown.html.twig') }}

    {{ include('_ladder_dropdown_countries.html.twig') }}

    {# The whole board, where am I included: top 25, "⋯ N more", the viewer's row with 2 above and 2 below, "Show more"
       (design-spec §8.4: 25 rows before the gap on the boards, 10 on the /ladder overview) #}
    <twig:LadderTable :type="type" :piecesCount="pieces" :limit="constant('SpeedPuzzling\\Web\\Value\\LeaderboardWindow::BOARD_TOP_ROWS')" :fullBoard="true" :countryCode="active_country ? active_country.name : null" />
{% endblock %}
