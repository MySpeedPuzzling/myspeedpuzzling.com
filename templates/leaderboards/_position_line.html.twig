{#-
    INTERFACE (stable, shared by every leaderboard - docs/features/xp-levels/ux-polish/design-spec.md §4 + §8.4/§8.5):
    The viewer's position line above a board: "#1,289 of 7,878 in Czechia · top 17% · 46 XP to the top 1,000 · Jump to me".
      {{ include('leaderboards/_position_line.html.twig', {
          position: LeaderboardPosition,        (rank, total, topFraction, targetRank, targetGap)
          scope: 'in Czechia' | null,           already translated: leaderboards.position.in_country / in_favorites;
                                                null = the whole list ("worldwide") - the line always says its scope
          gap_text: '46 XP' | null,             targetGap formatted the board's way (XP, AP, karma, rating points, a time)
          jump_href: '#board-row-…' | null,     only when the own row is below the first screen (LeaderboardWindow::ownRowBelowFirstScreen())
          goal_key: 'leaderboards.times.goal' | null,  the goal's wording when "to the top N" does not fit the value (a time
                                                must get *faster*); default leaderboards.position.goal
      }) }}
    Every number goes through format_number, the share through the locale's percent format (one decimal under 10 %), the
    rank sign lives in the translations. Parts that do not fit move to the next line whole (.lb-parts).
-#}
<div class="lb-position" data-testid="lb-position"><div class="lb-parts">
    <div class="lb-parts-inner">
        <span class="lb-position-rank">
            {%- set rank_params = {'%rank%': position.rank|plain_number, '%total%': position.total|plain_number} -%}
            {%- if scope|default(null) -%}
                {{ 'leaderboards.position.rank_scoped'|trans(rank_params|merge({'%scope%': scope})) }}
            {%- else -%}
                {{ 'leaderboards.position.rank_world'|trans(rank_params) }}
            {%- endif -%}
        </span>
        {%- if position.topFraction is not null %}
            <span>{{ 'leaderboards.position.top_share'|trans({'%percent%': position.topFraction|format_percent_number({fraction_digit: position.topFraction < 0.1 ? 1 : 0})}) }}</span>
        {%- endif %}
        {%- if position.targetRank is not null and gap_text|default(null) %}
            <span>{{ (position.targetRank == 1 ? 'leaderboards.position.goal_first' : goal_key|default('leaderboards.position.goal'))|trans({'%gap%': gap_text, '%rank%': position.targetRank|plain_number}) }}</span>
        {%- endif %}
        {%- if jump_href|default(null) %}
            <span><a href="{{ jump_href }}" class="lb-position-jump" data-turbo="false">{{ 'puzzle_times.my_attempts.jump_to_me'|trans }} <i class="bi bi-arrow-down-short" aria-hidden="true"></i></a></span>
        {%- endif %}
    </div>
</div></div>
