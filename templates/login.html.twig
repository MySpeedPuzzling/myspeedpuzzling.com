{% extends '_auth_layout.html.twig' %}

{% block title %}{{ 'auth.login.title'|trans }}{% endblock %}

{# docs/features/auth-ux-redesign.md §4.1: "create an account" right under the
   heading, provider buttons first (one tap for most returning players and no
   password manager involved), then email + password with "Forgot password?"
   next to the field that fails, and the sign-in link as an honest secondary
   button - a real link to its own page, not a hidden form. #}

{% set return_path = safe_return_url(app.request.query.get('return')) %}
{% set return_params = return_path is null ? {} : {'return': return_path} %}

{% block auth_content %}
    <h1 class="auth-title">{{ 'auth.login.title'|trans }}</h1>
    <p class="auth-crosslink">
        {{ 'auth.login.new_here'|trans }}
        <a href="{{ path('register', return_params) }}">{{ 'auth.register.title'|trans }}</a>
    </p>

    {% if app.request.query.get('social') == 'expired' %}
        <div class="alert alert-warning" role="alert">
            {{ 'auth.social.attempt_expired'|trans }}
        </div>
    {% endif %}

    {% if failure_kind in ['credentials', 'throttled'] %}
        {# UX funnel §4: the same helper for every reason a password sign-in
           fails - wrong password, unknown address - so it never signals whether
           an account exists #}
        {{ include('_login_failure_helper.html.twig', {throttled: failure_kind == 'throttled', return_params: return_params}) }}
    {% elseif error %}
        <div class="alert alert-danger" role="alert">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    {{ include('_in_app_browser_notice.html.twig') }}

    {{ include('_social_login_buttons.html.twig', {existing_account_hint: true, last_used: true}) }}

    <form action="{{ path('login') }}" method="post" id="login-form" data-last-sign-in-method="password" data-action="submit->last-sign-in#remember">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        {# Where the visitor was headed before being asked to sign in. Put here
           by LoginEntryPoint as ?return=; echoed back so the destination survives
           the POST without a session. Re-validated server-side on submit. #}
        {% if return_path %}
            <input type="hidden" name="return" value="{{ return_path }}">
        {% endif %}

        <div class="mb-3">
            <div class="auth-label-row">
                <label class="form-label" for="login-email">{{ 'auth.login.email'|trans }}</label>
                <span class="auth-last-used" data-last-sign-in-target="badge" data-last-sign-in-method="password" hidden>{{ 'auth.social.last_used'|trans }}</span>
            </div>
            {# No autofocus: on arrival it would pop the keyboard over the provider
               buttons and start screen readers mid-form #}
            <input
                class="form-control"
                type="email"
                id="login-email"
                name="email"
                value="{{ last_email }}"
                autocomplete="username"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                enterkeyhint="next"
                required
            >
        </div>

        <div class="mb-3">
            {# "Forgot password?" sits on the label row: seen before anything fails,
               and in DOM order before the field it belongs to #}
            <div class="auth-label-row">
                <label class="form-label" for="login-password">{{ 'auth.login.password'|trans }}</label>
                <a class="auth-inline-link" href="{{ path('request_password_reset') }}">{{ 'auth.password_reset.link'|trans }}</a>
            </div>
            <div class="password-field">
                <input
                    class="form-control"
                    type="password"
                    id="login-password"
                    name="password"
                    autocomplete="current-password"
                    enterkeyhint="go"
                    required
                    {# After a failed attempt the address is still there - the
                       password is what needs retyping #}
                    {% if failure_kind == 'credentials' %}autofocus{% endif %}
                >
                {{ include('_password_toggle.html.twig', {input_id: 'login-password'}) }}
            </div>
        </div>

        <button type="submit" class="btn btn-primary w-100" data-turbo-submits-with="{{ 'auth.login.submitting'|trans }}">
            {{ 'auth.login.submit'|trans }}
        </button>
    </form>

    {# The permanent rescue (UX funnel §3) - an honest link to its own page; the
       typed address follows via sessionStorage (auth-email-handoff) #}
    <a class="btn btn-outline-secondary w-100 mt-3" href="{{ path('sign_in_link_request', return_params) }}">
        <i class="bi bi-envelope me-2" aria-hidden="true"></i>{{ 'auth.login.link_instead'|trans }}
    </a>
{% endblock %}
