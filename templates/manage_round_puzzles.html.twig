{% extends 'base.html.twig' %}

{% block title %}{{ 'competition.manage_puzzles'|trans }} - {{ round.name }}{% endblock %}

{% block content %}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events.title'|trans, url: path('events')},
        {label: competition.name, url: path('edit_competition', {competitionId: competition.id})},
        {label: 'competition.manage_rounds'|trans, url: path('manage_competition_rounds', {competitionId: competition.id})},
        {label: round.name},
    ]}) }}
    {{ include('_return_back_button.html.twig', {fallbackUrl: path('manage_competition_rounds', {competitionId: competition.id}), fallbackTitle: 'competition.manage_rounds'|trans}) }}

    {% set timezone = round.displayTimezone %}
    {% set timezone_assumed = round.timezoneAssumed %}

    <div class="pb-4">
        <h1 class="h2">{{ round.name }}</h1>
        <p class="text-muted mb-1">{{ competition.name }}</p>
        <p class="small text-muted" data-round-start>
            <i class="bi bi-calendar-event me-1"></i>{{ 'competition.reveal.round_start'|trans({'%time%': zoned_datetime(round.startsAt, timezone, timezone_assumed)}) }}
        </p>

        <div class="mb-3">
            <a href="{{ path('add_puzzle_to_round', {'roundId': round.id, return: path('manage_round_puzzles', {roundId: round.id}), return_title: 'competition.manage_puzzles'|trans}) }}" class="btn btn-outline-primary">
                <i class="bi bi-plus-lg me-1"></i>{{ 'competition.add_puzzle'|trans }}
            </a>
        </div>

        {% for flash_message in app.flashes('success') %}
            <div class="alert alert-success">
                <i class="ci-check-circle me-2"></i>
                {{ flash_message }}
            </div>
        {% endfor %}

        <h2 class="h4 mt-4">{{ 'competition.puzzles'|trans }}</h2>

        {% if puzzles|length > 0 %}
            <ul class="list-unstyled col-xl-9 px-0">
                {% for puzzle in puzzles %}
                    {% set image_only = puzzle.hideMode is not null and puzzle.hideMode.value == 'image_only' %}
                    <li class="card mb-3" id="round-puzzle-{{ puzzle.roundPuzzleId }}">
                        <div class="card-body">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-semibold">{{ puzzle.puzzleName }}</div>
                                    <div class="small text-muted">{{ puzzle.manufacturerName ?? '-' }} · {{ puzzle.piecesCount }} {{ 'competition.puzzle.pieces'|trans|lower }}</div>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    {% if puzzle.hidden %}
                                        {# Another round holding it longer: "Reveal now" lets it out on this round only #}
                                        {% set reveal_now_question = puzzle.status.heldByAnotherRound and puzzle.status.heldLonger
                                            ? 'competition.reveal.confirm_reveal_now_held'
                                            : 'competition.reveal.confirm_reveal_now' %}
                                        <form method="post" action="{{ path('reveal_round_puzzle_now', {roundPuzzleId: puzzle.roundPuzzleId}) }}" class="d-inline" onsubmit="return confirm('{{ reveal_now_question|trans|e('js') }}')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('reveal_round_puzzle_' ~ puzzle.roundPuzzleId) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye me-1"></i>{{ 'competition.reveal.reveal_now'|trans }}
                                            </button>
                                        </form>
                                    {% endif %}
                                    <form method="post" action="{{ path('remove_puzzle_from_round', {'roundPuzzleId': puzzle.roundPuzzleId}) }}" class="d-inline" onsubmit="return confirm('{{ 'competition.confirm_remove_puzzle'|trans|e('js') }}')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('remove_puzzle_' ~ puzzle.roundPuzzleId) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash me-1"></i>{{ 'competition.remove'|trans }}
                                        </button>
                                    </form>
                                </div>
                            </div>

                            {# The effective truth: this round's reveal combined with the puzzle's site-wide hide (RoundPuzzleStatus) #}
                            {% set status = puzzle.status %}
                            {% set status_scope = status.everywhere ? 'everywhere' : 'on_event' %}
                            <p class="mt-3 mb-1 fw-medium" data-reveal-status>
                                {% if status.kind == 'not_secret' %}
                                    <i class="bi bi-eye me-1"></i>{{ 'competition.reveal.status.not_secret'|trans }}
                                {% elseif status.kind == 'revealed' %}
                                    <i class="bi bi-eye me-1 text-success"></i>{{ 'competition.reveal.status.revealed'|trans({'%time%': zoned_datetime(status.until, timezone, timezone_assumed)}) }}
                                {% else %}
                                    {% set image_prefix = status.kind == 'image_hidden' ? 'image_' : '' %}
                                    <i class="bi bi-eye-slash me-1 text-warning"></i>
                                    {%- if status.elsewhereUntil is not null and status.until is not null -%}
                                        {{ ('competition.reveal.status.' ~ image_prefix ~ 'hidden_split')|trans({'%time%': zoned_datetime(status.until, timezone, timezone_assumed), '%elsewhere%': zoned_datetime(status.elsewhereUntil, timezone, timezone_assumed)}) }}
                                    {%- elseif status.elsewhereUntil is not null -%}
                                        {{ ('competition.reveal.status.manual_' ~ image_prefix ~ 'hidden_split')|trans({'%elsewhere%': zoned_datetime(status.elsewhereUntil, timezone, timezone_assumed)}) }}
                                    {%- elseif status.until is not null -%}
                                        {{ ('competition.reveal.status.' ~ image_prefix ~ 'hidden_' ~ status_scope)|trans({'%time%': zoned_datetime(status.until, timezone, timezone_assumed)}) }}
                                    {%- elseif status.waitsForThisRound -%}
                                        {{ ('competition.reveal.status.manual_' ~ image_prefix ~ 'hidden_' ~ status_scope)|trans }}
                                    {%- elseif status.heldByAnotherRound -%}
                                        {{ ('competition.reveal.status.held_' ~ image_prefix ~ 'hidden_everywhere')|trans }}
                                    {%- else -%}
                                        {{ ('competition.reveal.status.kept_' ~ image_prefix ~ 'hidden_everywhere')|trans }} – <a href="{{ path('feedback', {url: app.request.uri}) }}" class="fw-normal">{{ 'competition.reveal.contact_link'|trans }}</a>
                                    {%- endif -%}
                                {% endif %}
                            </p>

                            {% if puzzle.hideUntilRoundStarts and puzzle.hidden %}
                                <p class="small text-muted mb-0">
                                    {{ ('competition.reveal.source.' ~ puzzle.revealMode.value)|trans }}
                                    {% if puzzle.revealsAt is not null and puzzle.revealsAt < round.startsAt %}
                                        <span class="text-danger">{{ 'competition.reveal.source.before_round_start'|trans({'%time%': zoned_datetime(round.startsAt, timezone, timezone_assumed)}) }}</span>
                                    {% endif %}
                                </p>
                            {% endif %}
                            {% if status.kind in ['hidden', 'image_hidden'] and status.heldLonger and status.until is not null %}
                                <p class="small text-muted mb-0" data-reveal-held>
                                    {{ (status.heldByAnotherRound ? 'competition.reveal.source.held_by_other_round' : 'competition.reveal.source.held_by_site')|trans }}
                                    {% if not status.heldByAnotherRound %}
                                        <a href="{{ path('feedback', {url: app.request.uri}) }}">{{ 'competition.reveal.contact_link'|trans }}</a>
                                    {% endif %}
                                </p>
                            {% endif %}
                            {# The round is on (or over) while the puzzle is still hidden: nobody can log a time on it yet #}
                            {% if status.kind == 'hidden' and round.startsAt <= now %}
                                <p class="small text-warning-emphasis mb-0" data-participants-wait>
                                    <i class="bi bi-hourglass-split me-1"></i>{{ 'competition.reveal.source.participants_wait'|trans }}
                                </p>
                            {% endif %}

                            {# The site's hide ends before this round reveals it - the organiser may let the round keep it hidden everywhere #}
                            {% if puzzle.mayKeepHiddenEverywhere and status.elsewhereUntil is not null %}
                                <form method="post" action="{{ path('keep_round_puzzle_hidden_everywhere', {roundPuzzleId: puzzle.roundPuzzleId}) }}" class="mt-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('keep_round_puzzle_hidden_' ~ puzzle.roundPuzzleId) }}">
                                    <button type="submit" class="btn btn-sm btn-warning">
                                        <i class="bi bi-eye-slash me-1"></i>{{ puzzle.revealsAt is not null
                                            ? 'competition.reveal.keep_everywhere'|trans({'%time%': zoned_datetime(puzzle.revealsAt, timezone, timezone_assumed)})
                                            : 'competition.reveal.keep_everywhere_manual'|trans }}
                                    </button>
                                </form>
                            {% endif %}

                            {# A revealed puzzle is public - its reveal is not changed any more, and a puzzle shown on the event page
                               becomes secret only before the round starts while no other round shows it: nothing public is hidden again #}
                            {% if puzzle.hidden or puzzle.mayBecomeSecret %}
                            {% set refused = reveal_error is not null and reveal_error.roundPuzzleId == puzzle.roundPuzzleId ? reveal_error : null %}
                            {% set automatic_over = round.automaticRevealAt <= now %}
                            <details class="mt-2" {{ refused is not null ? 'open' }}>
                                <summary class="small text-primary">{{ 'competition.reveal.form.toggle'|trans }}</summary>

                                <form method="post" action="{{ path('change_round_puzzle_reveal', {roundPuzzleId: puzzle.roundPuzzleId}) }}" class="mt-2 border-start ps-3">
                                    <input type="hidden" name="_token" value="{{ csrf_token('round_puzzle_reveal_' ~ puzzle.roundPuzzleId) }}">

                                    {% if refused is not null %}
                                        <div class="alert alert-danger py-2" data-reveal-error>{{ refused.message }}</div>
                                    {% endif %}

                                    {% set current_hide_mode = refused is not null and refused.hideMode in ['entirely', 'image_only'] ? refused.hideMode : (image_only ? 'image_only' : 'entirely') %}
                                    <fieldset class="mb-3">
                                        <legend class="form-label fs-sm fw-medium">{{ 'competition.reveal.form.hide_mode'|trans }}</legend>
                                        {% for mode in ['entirely', 'image_only'] %}
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="hide_mode" value="{{ mode }}" id="hide-mode-{{ mode }}-{{ puzzle.roundPuzzleId }}" {{ current_hide_mode == mode ? 'checked' }}>
                                                <label class="form-check-label" for="hide-mode-{{ mode }}-{{ puzzle.roundPuzzleId }}">{{ ('competition.round_puzzle.form.hide_mode_' ~ mode)|trans }}</label>
                                                <div class="form-text mt-0">{{ ('competition.round_puzzle.form.hide_mode_' ~ mode ~ '_help')|trans }}</div>
                                                {# Its name still hidden: "image only" publishes it now, for good - only with a tick #}
                                                {% if mode == 'image_only' and puzzle.hidden and not image_only %}
                                                    <div class="form-check mt-1">
                                                        <input class="form-check-input" type="checkbox" name="confirm_name_public" value="1" id="confirm-name-public-{{ puzzle.roundPuzzleId }}" data-confirm-name-public>
                                                        <label class="form-check-label small" for="confirm-name-public-{{ puzzle.roundPuzzleId }}">{{ (puzzle.nameHeldByAnotherRound ? 'competition.reveal.form.confirm_name_public_event' : 'competition.reveal.form.confirm_name_public')|trans }}</label>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </fieldset>

                                    {# Never an automatic reveal that is over already - that would reveal at once (use Reveal now) #}
                                    {% set default_mode = puzzle.hideUntilRoundStarts and puzzle.hidden ? puzzle.revealMode.value : (automatic_over ? 'manual' : 'automatic') %}
                                    {% set current_mode = refused is not null and refused.revealMode in ['automatic', 'scheduled', 'manual'] ? refused.revealMode : default_mode %}
                                    {% set scheduled_value = refused is not null and refused.revealAt is not empty
                                        ? refused.revealAt
                                        : ((puzzle.revealMode.value == 'scheduled' and puzzle.revealsAt is not null ? puzzle.revealsAt : round.automaticRevealAt)|date('Y-m-d\\TH:i', timezone)) %}
                                    <fieldset class="mb-3">
                                        <legend class="form-label fs-sm fw-medium">{{ 'competition.reveal.form.when'|trans }}</legend>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="reveal_mode" value="automatic" id="reveal-automatic-{{ puzzle.roundPuzzleId }}" {{ current_mode == 'automatic' ? 'checked' }} {{ automatic_over ? 'disabled' }}>
                                            <label class="form-check-label" for="reveal-automatic-{{ puzzle.roundPuzzleId }}">
                                                {{ automatic_over
                                                    ? 'competition.reveal.form.automatic_over'|trans
                                                    : 'competition.reveal.form.automatic'|trans({'%time%': zoned_datetime(round.automaticRevealAt, timezone, timezone_assumed)}) }}
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="reveal_mode" value="scheduled" id="reveal-scheduled-{{ puzzle.roundPuzzleId }}" {{ current_mode == 'scheduled' ? 'checked' }}>
                                            <label class="form-check-label" for="reveal-scheduled-{{ puzzle.roundPuzzleId }}">{{ 'competition.reveal.form.scheduled'|trans }}</label>
                                            <div class="mt-1">
                                                <label class="form-label small mb-1" for="reveal-at-{{ puzzle.roundPuzzleId }}">{{ 'competition.reveal.form.scheduled_at'|trans({'%zone%': timezone_name(timezone, timezone_assumed)}) }}</label>
                                                <input class="form-control form-control-sm" style="max-width: 16rem;" type="datetime-local" name="reveal_at" id="reveal-at-{{ puzzle.roundPuzzleId }}" value="{{ scheduled_value }}">
                                            </div>
                                            <div class="form-text mt-1">{{ 'competition.reveal.form.participants_after_reveal'|trans }}</div>
                                        </div>
                                        <div class="form-check mt-1">
                                            <input class="form-check-input" type="radio" name="reveal_mode" value="manual" id="reveal-manual-{{ puzzle.roundPuzzleId }}" {{ current_mode == 'manual' ? 'checked' }}>
                                            <label class="form-check-label" for="reveal-manual-{{ puzzle.roundPuzzleId }}">{{ 'competition.reveal.form.manual'|trans }}</label>
                                            <div class="form-text mt-0">{{ 'competition.reveal.form.participants_after_reveal'|trans }}</div>
                                        </div>
                                    </fieldset>

                                    <button type="submit" class="btn btn-sm btn-primary">{{ 'competition.reveal.form.save'|trans }}</button>
                                </form>
                            </details>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">{{ 'competition.no_puzzles'|trans }}</p>
        {% endif %}
    </div>
{% endblock %}
