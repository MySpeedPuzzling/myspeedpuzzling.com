{#
    A marketplace listing. `event` (optional) = the event chosen in the marketplace's "Pick up at an event" filter:
    the card then says "Bringing" or offers "Ask to bring it" for that event, instead of the labels
    "Bringing to …" (everyone) and "Seller goes to …" (only the viewer it was computed for) -
    docs/features/marketplace/11-events.md. The reserve/unreserve streams render it without an event.
#}
{% set viewer = logged_user.profile %}
{% set chosen_event = event|default(null) %}
{% set is_own_listing = viewer is not null and viewer.playerId is same as item.sellerId %}
{% set reserved_for_viewer = item.reserved and viewer is not null and item.reservedForPlayerId is not null and item.reservedForPlayerId == viewer.playerId %}
{# The event the viewer picks up the puzzle they reserved at #}
{% set reserved_at_event = reserved_for_viewer ? (chosen_event is not null ? (item.bringing ? chosen_event : null) : item.bringingTo) : null %}
{# "Ask to bring it" - to this event #}
{% set ask_event = chosen_event is not null ? (item.bringing ? null : chosen_event) : item.sellerGoesTo %}
{% if is_own_listing or (item.reserved and not reserved_for_viewer) %}
    {% set ask_event = null %}
{% endif %}
<div class="card h-100 shadow position-relative">
    {% if reserved_at_event is not null %}
        {% set reserved_label = 'marketplace_events.label.reserved_for_you'|trans({'%event%': reserved_at_event.shortName, '%date%': event_dates(reserved_at_event.dateFrom, reserved_at_event.dateTo)}) %}
        <div class="position-absolute start-0 top-0 mpe-reserved-for-you" style="z-index: 2;">
            <span class="badge bg-dark text-light px-2 py-1 mt-2 mpe-badge" style="border-radius: 0 0 0.375rem 0; font-size: 0.8rem;" title="{{ reserved_label }}">
                {{- 'marketplace_events.label.reserved_for_you'|trans({'%event%': '<span class="mpe-badge-event">' ~ reserved_at_event.shortName|e ~ '</span>', '%date%': event_dates(reserved_at_event.dateFrom, reserved_at_event.dateTo)|e})|raw -}}
            </span>
        </div>
    {% elseif item.reserved %}
        <div class="position-absolute start-0 top-0" style="z-index: 2;">
            {% if logged_user.profile is not null and logged_user.profile.playerId is same as item.sellerId and item.reservedForPlayerName is not null %}
                <a href="{{ path('start_marketplace_conversation', {sellSwapListItemId: item.itemId}) }}"
                   class="badge bg-dark text-light px-2 py-1 mt-2 text-decoration-none"
                   style="border-radius: 0 0 0.375rem 0; font-size: 0.8rem; letter-spacing: 0.03em;"
                   data-turbo="true"
                   data-turbo-frame="modal-frame">{{ 'marketplace.reserved'|trans }}<br><i class="bi bi-envelope me-1"></i>{{ item.reservedForPlayerName|length > 10 ? item.reservedForPlayerName|slice(0, 10) ~ '…' : item.reservedForPlayerName }}</a>
            {% else %}
                <span class="badge bg-dark text-light px-2 py-1 mt-2" style="border-radius: 0 0 0.375rem 0; font-size: 0.8rem; letter-spacing: 0.03em;">{{ 'marketplace.reserved'|trans }}</span>
            {% endif %}
        </div>
    {% endif %}

    {% if logged_user.profile is not null and logged_user.profile.playerId is same as item.sellerId %}
        <div class="dropdown position-absolute" style="top: 0.25rem; right: 0.25rem;">
            <button class="btn btn-outline-primary shadow btn-xs dropdown-toggle"
                    type="button" data-bs-toggle="dropdown" data-bs-strategy="fixed">
                <i class="ci-menu"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" href="{{ path('edit_sell_swap_list_item', {itemId: item.itemId}) }}">
                        <i class="bi bi-pencil me-1"></i> {{ 'edit'|trans }}
                    </a>
                </li>
                {% if item.reserved %}
                    <li>
                        <form action="{{ path('sell_swap_remove_reservation', {itemId: item.itemId}) }}" method="post" data-turbo="true">
                            <input type="hidden" name="context" value="marketplace">
                            <button type="submit" class="dropdown-item">
                                <i class="bi bi-bookmark-dash me-1"></i> {{ 'sell_swap_list.remove_reservation.button'|trans }}
                                {% if item.reservedForPlayerName is not null %}
                                    <small class="text-muted">({{ item.reservedForPlayerName }})</small>
                                {% endif %}
                            </button>
                        </form>
                    </li>
                {% else %}
                    <li>
                        <a class="dropdown-item text-warning"
                           href="{{ path('sell_swap_mark_reserved', {itemId: item.itemId}) }}?context=marketplace"
                           data-turbo="true"
                           data-turbo-frame="modal-frame">
                            <i class="bi bi-bookmark-check me-1"></i> {{ 'sell_swap_list.mark_reserved.button'|trans }}
                        </a>
                    </li>
                {% endif %}
                <li>
                    <a class="dropdown-item text-success"
                       href="{{ path('sellswap_mark_sold', {itemId: item.itemId}) }}?context=marketplace"
                       data-turbo="true"
                       data-turbo-frame="modal-frame">
                        <i class="bi bi-check-circle me-1"></i> {{ 'sell_swap_list.mark_sold.button'|trans }}
                    </a>
                </li>
                <li>
                    <form action="{{ path('sellswap_remove', {puzzleId: item.puzzleId}) }}" method="post">
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="bi bi-trash me-1"></i> {{ 'sell_swap_list.remove.button'|trans }}
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    {% endif %}

    <div class="card-body p-2 d-flex flex-column">
        <a href="{{ path('puzzle_detail', {puzzleId: item.puzzleId, return: marketplaceReturnUrl|default(path('marketplace')), return_title: 'marketplace.title'|trans}) }}" class="text-decoration-none">
            {# Row 1: Image + Puzzle info #}
            <div class="d-flex gap-2 mb-1">
                <div class="flex-shrink-0 text-center" style="width: 90px;">
                    <span class="diff-corner-host">
                        {{ lazy_puzzle_image(
                            item.puzzleImage,
                            'puzzle_small',
                            item.puzzleName,
                            999,
                            90,
                            'rounded lazy-img-marketplace' ~ (item.reserved ? ' grayscale' : ''),
                            60,
                            item.puzzleImageRatio
                        ) }}

                        {# Members only - the listing passes the tiers; the reserve/unreserve streams do not, the card
                           shows no difficulty until reload #}
                        {% if difficulty_tiers|default(null) is not null %}
                            {{ include('_difficulty_corner.html.twig', {tier: difficulty_tiers[item.puzzleId] ?? null}) }}
                        {% endif %}
                    </span>
                </div>

                <div class="flex-grow-1 min-width-0">
                    <h6 class="card-title mb-0 text-dark" style="padding-right: 45px; font-size: 0.8rem; line-height: 125% !important;" title="{{ item.puzzleName }}">
                        {{ item.puzzleName|length > 55 ? item.puzzleName|slice(0, 52) ~ '...' : item.puzzleName }}
                    </h6>

                    <div class="fs-xs text-muted">
                        {{ item.piecesCount }} {{ 'marketplace.pcs'|trans }}{% if item.manufacturerName %} &middot; {{ item.manufacturerName }}{% endif %}
                    </div>

                    <div class="mt-1 d-flex align-items-center flex-wrap gap-1">
                        {% if item.listingType != 'free' and item.listingType != 'swap' %}
                            {% if item.price is not null and item.price > 0 %}
                                <span class="fw-bold text-dark" style="font-size: 0.8rem;">{{ item.price }} {{ item.sellerCustomCurrency ?? item.sellerCurrency ?? '' }}</span>
                            {% else %}
                                <small class="text-muted"><i class="bi bi-exclamation-circle me-1"></i>{{ 'marketplace.price_not_disclosed'|trans }}</small>
                            {% endif %}
                        {% endif %}

                        {% if item.listingType == 'sell' %}
                            <span class="badge bg-success" style="font-size: 0.75rem;">{{ 'marketplace.listing_type.sell'|trans }}</span>
                        {% elseif item.listingType == 'swap' %}
                            <span class="badge bg-info" style="font-size: 0.75rem;">{{ 'marketplace.listing_type.swap'|trans }}</span>
                        {% elseif item.listingType == 'both' %}
                            <span class="badge bg-primary" style="font-size: 0.75rem;">{{ 'marketplace.listing_type.both'|trans }}</span>
                        {% elseif item.listingType == 'free' %}
                            <span class="badge bg-danger" style="font-size: 0.75rem;">{{ 'marketplace.listing_type.free'|trans }}</span>
                        {% endif %}

                        {% if item.condition == 'new' %}
                            <span class="badge bg-secondary" style="font-size: 0.75rem;">{{ 'marketplace.condition.new'|trans }}</span>
                        {% elseif item.condition == 'like_new' %}
                            <span class="badge bg-secondary" style="font-size: 0.75rem;">{{ 'marketplace.condition.like_new'|trans }}</span>
                        {% elseif item.condition == 'normal' %}
                            <span class="badge bg-secondary" style="font-size: 0.75rem;">{{ 'marketplace.condition.normal'|trans }}</span>
                        {% elseif item.condition == 'not_so_good' %}
                            <span class="badge bg-secondary" style="font-size: 0.75rem;">{{ 'marketplace.condition.not_so_good'|trans }}</span>
                        {% elseif item.condition == 'missing_pieces' %}
                            <span class="badge bg-secondary" style="font-size: 0.75rem;">{{ 'marketplace.condition.missing_pieces'|trans }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </a>

        {# Marketplace at events #}
        {% if chosen_event is not null %}
            {% if item.bringing %}
                <div class="mb-1">
                    <span class="badge bg-dark mpe-badge" data-testid="listing-bringing"><i class="bi bi-bag-check me-1"></i>{{ 'marketplace_events.label.bringing'|trans }}</span>
                </div>
            {% endif %}
        {% elseif item.bringingTo is not null or (item.sellerGoesTo is not null and viewer is not null) %}
            <div class="mb-1 d-flex flex-column align-items-start gap-1 mw-100">
                {% if item.bringingTo is not null %}
                    {% set bringing_to = item.bringingTo %}
                    <span class="badge bg-dark mpe-badge" data-testid="listing-bringing-to" title="{{ 'marketplace_events.label.bringing_to'|trans({'%event%': bringing_to.name, '%date%': event_dates(bringing_to.dateFrom, bringing_to.dateTo)}) }}">
                        {{- 'marketplace_events.label.bringing_to'|trans({'%event%': '<span class="mpe-badge-event">' ~ bringing_to.shortName|e ~ '</span>', '%date%': event_dates(bringing_to.dateFrom, bringing_to.dateTo)|e})|raw -}}
                    </span>
                {% endif %}
                {% if item.sellerGoesTo is not null and viewer is not null %}
                    {% set seller_goes_to = item.sellerGoesTo %}
                    <span class="badge mpe-badge mpe-badge-outline" data-testid="listing-seller-goes-to" title="{{ 'marketplace_events.label.seller_goes_to'|trans({'%event%': seller_goes_to.name, '%date%': event_dates(seller_goes_to.dateFrom, seller_goes_to.dateTo)}) }}">
                        {{- 'marketplace_events.label.seller_goes_to'|trans({'%event%': '<span class="mpe-badge-event">' ~ seller_goes_to.shortName|e ~ '</span>', '%date%': event_dates(seller_goes_to.dateFrom, seller_goes_to.dateTo)|e})|raw -}}
                    </span>
                {% endif %}
            </div>
        {% endif %}

        {# Row 2: Comment #}
        {% if item.comment %}
            {% if item.comment|length > 80 %}
                <div class="fs-xs text-muted mb-1">
                    <span class="js-comment-short">{{ item.comment|slice(0, 77) ~ '...' }} <a href="#" class="js-comment-toggle text-primary" onclick="event.preventDefault(); var p=this.closest('div'); p.querySelector('.js-comment-short').hidden=true; p.querySelector('.js-comment-full').hidden=false;">{{ 'show_more'|trans }}</a></span>
                    <span class="js-comment-full" hidden>{{ item.comment }} <a href="#" class="js-comment-toggle text-primary" onclick="event.preventDefault(); var p=this.closest('div'); p.querySelector('.js-comment-full').hidden=true; p.querySelector('.js-comment-short').hidden=false;">{{ 'show_less'|trans }}</a></span>
                </div>
            {% else %}
                <div class="fs-xs text-muted mb-1">{{ item.comment }}</div>
            {% endif %}
        {% endif %}

        {# Row 3: Seller + Rating #}
        <div class="mt-auto d-flex align-items-center pt-1">
            <a href="{{ path('sell_swap_list_detail', {playerId: item.sellerId, return: marketplaceReturnUrl|default(path('marketplace')), return_title: 'marketplace.title'|trans}) }}" class="d-flex align-items-center min-width-0 text-primary text-decoration-underline">
                {{ include('_player_avatar.html.twig', {
                    player_id: item.sellerId,
                    name: item.sellerName ?? item.sellerCode,
                    avatar: item.sellerAvatar,
                    country_code: item.sellerCountry,
                    size: 'xs',
                }) }}
                <small class="text-truncate ms-2">{{ item.sellerName ?? item.sellerCode }}</small>
            </a>
            {% if item.sellerRatingCount is defined and item.sellerRatingCount > 0 %}
                <a href="{{ path('player_ratings', {playerId: item.sellerId}) }}" class="btn btn-outline-warning btn-sm ms-1 flex-shrink-0 py-0 px-1" style="font-size: 0.7rem;" title="{{ item.sellerAverageRating|number_format(1) }} ({{ item.sellerRatingCount }})" data-turbo="true" data-turbo-frame="modal-frame">
                    <i class="bi bi-star-fill"></i> {{ item.sellerAverageRating|number_format(1) }}
                </a>
            {% endif %}
        </div>

        {# "Ask to bring it" - a contact message with the request filled in; guests sign in first, like for "Contact seller" #}
        {% if ask_event is not null %}
            {% if viewer is not null %}
                <a href="{{ path('start_marketplace_conversation', {sellSwapListItemId: item.itemId, event: ask_event.competitionId}) }}"
                   class="btn btn-primary btn-xs w-100 mt-2"
                   data-testid="listing-ask-to-bring"
                   data-turbo="true"
                   data-turbo-frame="modal-frame">
                    <i class="bi bi-chat-dots me-1"></i>{{ 'marketplace_events.label.ask_to_bring'|trans }}
                </a>
            {% else %}
                <a href="{{ path('login', {return: marketplaceReturnUrl|default(path('marketplace'))}) }}" rel="nofollow" class="btn btn-primary btn-xs w-100 mt-2" data-testid="listing-ask-to-bring">
                    <i class="bi bi-chat-dots me-1"></i>{{ 'marketplace_events.label.ask_to_bring'|trans }}
                </a>
            {% endif %}
        {% endif %}
    </div>

    {% if logged_user.profile is not null and logged_user.profile.playerId is not same as item.sellerId %}
        <a href="{{ path('start_marketplace_conversation', {sellSwapListItemId: item.itemId}) }}" class="btn btn-outline-primary shadow btn-xs position-absolute" style="top: 0.25rem; right: 0.25rem;" title="{{ 'marketplace.contact_seller'|trans }}" data-turbo="true" data-turbo-frame="modal-frame">
            <i class="bi bi-envelope"></i>
        </a>
    {% endif %}
</div>
