{% extends 'base.html.twig' %}

{% block title %}{{ 'membership.meta.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'membership.meta.description'|trans }}{% endblock %}

{% block content %}
    <div class="pb-4">
        <div class="row gy-3 pb-3">
            <div class="col-lg-6 col-md-8">
                <h1 class="h2">{{ 'membership.title'|trans }}</h1>

                <p>{{ 'membership.intro_text'|trans }}</p>

                <p></p>

                <div class="card shadow my-4">
                    <div class="card-body">
                        {% if membership and membership.hasLifetimeGrant %}
                            <p class="text-success fs-5">
                                <i class="ci-check-circle me-2"></i> {{ 'membership.lifetime_membership_active'|trans }}
                            </p>

                            <p class="mb-0">{{ 'membership.lifetime_membership_info'|trans }}</p>

                            {% if membership.stripeSubscriptionId %}
                                <p class="mt-2 mb-1">{{ 'membership.lifetime_subscription_stopped_info'|trans }}</p>

                                {% if is_web() %}
                                    <p class="mb-1">
                                        <a data-turbo-prefetch="false" class="btn btn-outline-primary" href="{{ path('billing_portal') }}">{{ 'membership.payment_portal_button'|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i></a>
                                    </p>

                                    <p class="text-muted small mb-0">{{ 'membership.billing_portal_info'|trans }}</p>
                                {% endif %}
                            {% endif %}
                        {% elseif membership and membership.isInFreeTrial(now) %}
                            {{ include('membership/_free_trial_status.html.twig', {membership: membership, now: now}) }}

                            {{ include('membership/_subscription_plans.html.twig') }}
                        {% elseif membership and membership.isActive(now) %}
                            {% if membership.billingPeriodEndsAt %}
                                <p class="text-success fs-5">
                                    <i class="ci-check-circle me-2"></i> {{ 'membership.subscription_active'|trans }}
                                </p>

                                {% if voucher_free_periods is empty %}
                                    <p>
                                        {{ 'membership.next_payment'|trans }}: <strong>{{ membership.billingPeriodEndsAt|format_date('long') }}</strong>
                                    </p>
                                {% endif %}
                            {% elseif membership.endsAt and membership.endsAt > now %}
                                <p class="text-warning fs-5">
                                    <i class="ci-close-circle me-2"></i> {{ 'membership.membership_cancelling'|trans }}
                                </p>
                            {% elseif membership.hasActiveGrant(now) %}
                                <p class="text-success fs-5">
                                    <i class="ci-check-circle me-2"></i> {{ 'membership.free_membership_active'|trans }}
                                </p>
                            {% else %}
                                <p class="text-danger fs-5">
                                    <i class="ci-close-circle me-2"></i> {{ 'membership.membership_inactive'|trans }}
                                </p>
                            {% endif %}

                            {# Without a Stripe customer there is nothing to manage - billing_portal would bounce back to this page #}
                            {% set has_payment_portal = player.stripeCustomerId is not null %}
                            {% set has_management = (is_web() and has_payment_portal) or is_ios() or is_android() %}
                            {% set has_discount = membership.billingPeriodEndsAt and membership.discountPercent %}

                            {% if voucher_free_periods is not empty %}
                                {{ include('membership/_voucher_free_periods.html.twig', {
                                    membership: membership,
                                    periods: voucher_free_periods,
                                    now: now,
                                    last: not has_management and not has_discount,
                                }) }}
                            {% endif %}

                            {% if has_discount %}
                                {{ include('membership/_subscription_discount.html.twig', {
                                    membership: membership,
                                    last: not has_management,
                                }) }}
                            {% endif %}

                            {% if voucher_free_periods is empty and not membership.billingPeriodEndsAt and membership.activeUntil(now) %}
                                <p class="{{ has_management ? '' : 'mb-0' }}">
                                    {{ 'membership.membership_active_until'|trans }}: <strong>{{ membership.activeUntil(now)|format_date('long') }}</strong>
                                </p>
                            {% endif %}

                            {% if has_management %}
                                <p class="mb-1">
                                    {% if is_web() and has_payment_portal %}
                                        <a data-turbo-prefetch="false" class="btn btn-outline-primary" href="{{ path('billing_portal') }}">{{ 'membership.payment_portal_button'|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i></a>
                                    {% elseif is_ios() %}
                                        <a class="btn btn-outline-primary" href="itms-apps://apps.apple.com/account/subscriptions">
                                            <i class="bi bi-apple me-1"></i> {{ 'membership.manage_in_app_store'|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i>
                                        </a>
                                    {% elseif is_android() %}
                                        <a class="btn btn-outline-primary" href="https://play.google.com/store/account/subscriptions">
                                            <i class="bi bi-google-play me-1"></i> {{ 'membership.manage_in_play_store'|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i>
                                        </a>
                                    {% endif %}
                                </p>

                                <p class="text-muted small mb-0">
                                    {% if is_web() and has_payment_portal %}
                                        {{ 'membership.billing_portal_info'|trans }}
                                    {% elseif is_ios() %}
                                        {{ 'membership.manage_subscription_ios_info'|trans }}
                                    {% elseif is_android() %}
                                        {{ 'membership.manage_subscription_android_info'|trans }}
                                    {% endif %}
                                </p>
                            {% endif %}
                        {% else %}
                            {% if membership and membership.isEndedFreeTrialOnly(now) %}
                                <p class="fs-5">
                                    <i class="ci-time me-2"></i> {{ 'free_trial.status.ended'|trans }}
                                </p>
                            {% elseif membership and not membership.isActive(now) %}
                                <p class="text-danger fs-5">
                                    <i class="ci-close-circle me-2"></i> {{ 'membership.membership_expired'|trans }}
                                </p>
                            {% endif %}

                            {% if free_trial_enabled and is_web() and logged_user.profile.freeTrialAvailable %}
                                {{ include('membership/_free_trial_offer.html.twig', {
                                    days: constant('SpeedPuzzling\\Web\\Value\\FreeTrial::DAYS'),
                                }) }}
                            {% endif %}

                            <h4>{{ 'membership.choose_your_subscription'|trans }}</h4>

                            {{ include('membership/_subscription_plans.html.twig') }}
                        {% endif %}
                    </div>
                </div>

                {% if not membership or not membership.isActive(now) or membership.isInFreeTrial(now) %}
                    <twig:ReferralCodeInput />
                {% endif %}

                {% if membership and membership.isActive(now) and not membership.hasLifetimeGrant and not membership.isInFreeTrial(now) %}
                    <div class="text-center mt-3">
                        <a href="{{ path('claim_voucher') }}" class="btn btn-outline-secondary btn-sm">
                            <i class="ci-gift me-1"></i> {{ 'membership.redeem_voucher'|trans }}
                        </a>
                    </div>
                {% endif %}

                <h2 class="mt-4">{{ 'membership.description_title'|trans }}</h2>
                {{ 'membership.full_description'|trans|raw }}

            </div>

            <div class="col-lg-5 offset-lg-1 col-md-4 text-center">
                <img class="img-fluid" src="{{ asset('img/puzzlie-1.png') }}" alt="Mascot" width="1000" height="949">
            </div>
        </div>

    </div>
{% endblock %}
