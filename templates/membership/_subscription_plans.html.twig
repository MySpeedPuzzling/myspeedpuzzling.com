{# The plan picker of the membership page - web (Stripe), iOS and Android. Shown to players without a
   membership and, so that a convinced player has somewhere to click, during the free trial too.
   Two plan cards (monthly first and picked - Jan prefers the steadier monthly income) and one button; membership_plan_controller.js points the button at the picked plan. #}
{% if discountedMonthlyPrice is not null %}
    <div class="alert alert-success mb-3">
        <i class="ci-check-circle me-2"></i>
        <strong>{{ 'membership.discount_ready'|trans({'%discount%': player.claimedDiscountVoucher.percentageDiscount}) }}</strong>
        <br><small>{{ 'membership.discount_ready_info'|trans }}</small>
    </div>
{% endif %}

{% set yearly_paid = discountedYearlyPrice ?? yearlyPrice %}
{% set monthly_paid = discountedMonthlyPrice ?? monthlyPrice %}
{% set yearly_label = 'membership.price_per_year'|trans({'%price%': yearly_paid}) %}
{% set monthly_label = 'membership.price_per_month'|trans({'%price%': monthly_paid}) %}

{% if is_web() %}
    {% set plans = [
        {key: 'monthly', url: path('buy_membership'), label: monthly_label},
        {key: 'yearly', url: path('buy_membership', {period: 'yearly'}), label: yearly_label},
    ] %}
{% elseif is_ios() %}
    {% set plans = [
        {key: 'monthly', product: 'com.myspeedpuzzling.premium.monthly', label: monthly_label},
        {key: 'yearly', product: 'com.myspeedpuzzling.premium.yearly', label: yearly_label},
    ] %}
{% elseif is_android() %}
    {% set plans = [
        {key: 'monthly', product: 'premium_monthly', label: monthly_label},
        {key: 'yearly', product: 'premium_yearly', label: yearly_label},
    ] %}
{% endif %}

{% set picked = plans|first %}

<div class="membership-plans"
     data-controller="membership-plan{{ is_web() ? '' : ' native-billing' }}"
     {% if not is_web() %}data-native-billing-platform-value="{{ is_ios() ? 'ios' : 'android' }}"{% endif %}>
    <fieldset class="membership-plan-options">
        <legend class="visually-hidden">{{ 'membership.choose_your_subscription'|trans }}</legend>

        {% for plan in plans %}
            <label class="membership-plan">
                <input type="radio" name="membership_plan" value="{{ plan.key }}"{% if loop.first %} checked{% endif %}
                       data-action="membership-plan#pick"
                       data-label="{{ ('membership.plans.continue' ~ (is_web() ? '' : '_store'))|trans({'%price%': plan.label}) }}"
                       {% if plan.url is defined %}data-url="{{ plan.url }}"{% else %}data-product="{{ plan.product }}"{% endif %}>
                <span class="membership-plan-radio" aria-hidden="true"></span>
                <span class="membership-plan-name">
                    {{ ('membership.plans.' ~ plan.key)|trans }}
                    {% if plan.key == 'yearly' %}<span class="badge bg-faded-success text-success ms-1">{{ 'membership.plans.yearly_badge'|trans }}</span>{% endif %}
                    <span class="membership-plan-note">
                        {% if plan.key == 'yearly' %}
                            {{ 'membership.plans.yearly_note'|trans({'%price%': 'membership.price_per_month'|trans({'%price%': yearlyPerMonthPrice})}) }}
                        {% else %}
                            {{ 'membership.plans.monthly_note'|trans }}
                        {% endif %}
                    </span>
                </span>
                <span class="membership-plan-price">
                    {% if plan.key == 'yearly' and discountedYearlyPrice is not null %}
                        <s class="d-block">{{ 'membership.price_per_year'|trans({'%price%': yearlyPrice}) }}</s>
                    {% elseif plan.key == 'monthly' and discountedMonthlyPrice is not null %}
                        <s class="d-block">{{ 'membership.price_per_month'|trans({'%price%': monthlyPrice}) }}</s>
                    {% endif %}
                    {{ plan.label }}
                </span>
            </label>
        {% endfor %}
    </fieldset>

    {% if is_web() %}
        <a data-turbo-prefetch="false" class="btn btn-dark btn-lg w-100 text-wrap" href="{{ picked.url }}" data-membership-plan-target="button">
            <span data-membership-plan-target="label">{{ 'membership.plans.continue'|trans({'%price%': picked.label}) }}</span>
        </a>
        <p class="text-muted small text-center mt-2 mb-0">{{ 'membership.plans.secure_stripe'|trans }}</p>
    {% else %}
        <button type="button" class="btn btn-dark btn-lg w-100 text-wrap" data-action="native-billing#purchase" data-native-billing-product-param="{{ picked.product }}" data-membership-plan-target="button">
            <i class="bi {{ is_ios() ? 'bi-apple' : 'bi-google-play' }} me-1" aria-hidden="true"></i> <span data-membership-plan-target="label">{{ 'membership.plans.continue_store'|trans({'%price%': picked.label}) }}</span>
        </button>
        <p class="text-muted small text-center mt-2 mb-0">{{ (is_ios() ? 'membership.purchase_via_app_store' : 'membership.purchase_via_play_store')|trans }}</p>
    {% endif %}
</div>

<p class="text-center small mt-3 mb-0">
    <a href="{{ path('claim_voucher') }}" class="text-decoration-none"><i class="ci-gift me-1"></i> {{ 'membership.have_voucher_code'|trans }}</a>
</p>
