{% if message.isSystemMessage %}
    {{ include('messaging/_system_message_bubble.html.twig') }}
{% else %}
{# joins_previous / joins_next: the same person within 5 minutes on the same day (messaging/_message_list.html.twig,
   kept right after live updates by messaging_controller.js layout()) - one avatar, one time, close together #}
<div class="chat-row d-flex mb-3 {{ message.isOwnMessage ? 'justify-content-end' : 'justify-content-start' }}{{ joins_previous|default(false) ? ' chat-row--joined-prev' }}{{ joins_next|default(false) ? ' chat-row--joined-next' }}"
     data-message-id="{{ message.messageId }}"
     data-sender="{{ message.senderId }}"
     data-own="{{ message.isOwnMessage ? '1' : '0' }}"
     data-ts="{{ message.sentAt|date('U') }}"
     data-day="{{ message.sentAt|date('Y-m-d') }}">
    {% if not message.isOwnMessage %}
        {{ include('messaging/_avatar.html.twig', {avatar: message.senderAvatar, size: 32, class: 'chat-avatar me-2 flex-shrink-0 align-self-end'}) }}
    {% endif %}

    <div class="d-flex flex-column {{ message.isOwnMessage ? 'align-items-end' : 'align-items-start' }}" style="max-width: 75%;">
        <div class="px-3 py-2 rounded-3 chat-bubble {{ message.isOwnMessage ? 'bg-primary text-white chat-bubble--own' : 'chat-bubble--other' }}">
            <div style="white-space: pre-wrap; word-break: break-word;">{{ message.content|chat_links }}</div>
        </div>
        <div class="chat-meta text-muted mt-1" style="font-size: 0.7rem;">
            {{ message.sentAt|date('H:i') }}
            {% if message.isOwnMessage and message.readAt %}
                <i class="bi bi-check2-all message-status-icon ms-1 text-success" title="{{ 'messaging.read_status'|trans }}"></i>
            {% elseif message.isOwnMessage %}
                <i class="bi bi-check2 message-status-icon ms-1" title="{{ 'messaging.sent_status'|trans }}"></i>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}
