{% extends 'base.html.twig' %}

{% block title %}{{ 'blocklist.title'|trans }}{% endblock %}

{% block content %}
{% include '_return_back_button.html.twig' with {fallbackUrl: path('conversations_list'), fallbackTitle: 'blocklist.back_to_messages'|trans} %}

<h1 class="h3 mb-4"><i class="bi bi-slash-circle me-2"></i>{{ 'blocklist.title'|trans }}</h1>

{% if blocked_users is empty %}
    <div class="text-center py-5 text-muted">
        <i class="bi bi-person-check fs-1 d-block mb-3"></i>
        <p>{{ 'blocklist.empty'|trans }}</p>
    </div>
{% else %}
    <p class="text-muted">{{ 'blocklist.intro'|trans }}</p>

    {{ include('_blocked_players_list.html.twig') }}
{% endif %}
{% endblock %}
