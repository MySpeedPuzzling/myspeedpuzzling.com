{% extends 'base.html.twig' %}

{# The Inbox's Messages tab (docs/features/navigation INB-01); its own sub-tabs stay below the Inbox header #}
{% block title %}{{ 'inbox.tab.messages'|trans }} · {{ 'inbox.title'|trans }}{% endblock %}

{% block content %}
{% embed 'inbox/_header.html.twig' with {tab: 'messages'} %}
    {% block actions %}
        <a href="{{ path('blocked_users') }}" class="btn btn-sm btn-outline-secondary flex-shrink-0" aria-label="{{ 'blocklist.title'|trans }}">
            <i class="bi bi-slash-circle" aria-hidden="true"></i> <span class="d-none d-sm-inline ms-1">{{ 'blocklist.title'|trans }}</span>
        </a>
    {% endblock %}
{% endembed %}

<div data-bfcache-reload data-controller="conversation-list"
     data-conversation-list-refresh-url-value="{{ path('conversations_list_tab') }}"
     data-conversation-list-active-tab-value="{{ active_tab }}">
    <div data-conversation-list-target="tabContent">
        {{ include('messaging/_conversations_tab_content.html.twig') }}
    </div>
</div>
{% endblock %}
