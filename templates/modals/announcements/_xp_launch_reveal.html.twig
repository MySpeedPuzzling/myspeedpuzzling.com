{# Announcement modal "xp_launch_reveal" (docs/features/announcement-modals.md, docs/features/xp-levels/launch-2026-10.md).
   Stays in the code for good - XpLaunchRevealRule decides who gets it and ResolveAnnouncementModal that nobody gets it
   twice. The modal is the reveal's first step: the level assembles and the XP counts up (XpLaunchRevealModal);
   members continue into their achievements, free players get the member tease (achievements are a membership
   feature - how many, never which). #}
<div
    class="modal fade"
    tabindex="-1"
    role="dialog"
    id="announcement-modal"
    aria-labelledby="announcement-modal-title"
    data-controller="autoshow-modal"
    data-autoshow-modal-seen-url-value="{{ path('announcement_modal_seen') }}"
    data-autoshow-modal-name-value="{{ announcement.value }}"
>
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'forms.close'|trans }}"></button>
            </div>

            <div class="modal-body text-center pt-0 px-4 pb-4">
                <twig:XpLaunchRevealModal
                    playerId="{{ logged_user.profile.playerId }}"
                    :isMember="logged_user.profile.activeMembership"
                />
            </div>
        </div>
    </div>
</div>
