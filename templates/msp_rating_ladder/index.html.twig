{% extends 'base.html.twig' %}

{% block title %}{{ 'puzzle_intelligence.elo.meta.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'puzzle_intelligence.elo.meta.description'|trans }}{% endblock %}

{% block content %}
    {{ include('_return_back_button.html.twig') }}

    {{ include('_leaderboards_nav.html.twig') }}


    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h1 class="h2 mb-0">{{ 'puzzle_intelligence.elo.heading_500'|trans }}</h1>
                <span class="badge bg-info">{{ 'puzzle_intelligence.elo.beta_badge'|trans }}</span>
            </div>
            <p class="text-muted mb-0 fs-sm">
                {{ 'puzzle_intelligence.elo.subtitle_portfolio'|trans }}
                <a href="{{ path('methodology') }}#msp-rating" class="ms-1">{{ 'puzzle_intelligence.elo.how_it_works'|trans }}</a>
            </p>
        </div>

        {% if ranking_opted_out %}
            <div class="card shadow-custom flex-shrink-0">
                <div class="card-body py-2 px-3">
                    <small class="text-muted">
                        <i class="bi bi-eye-slash me-1"></i>
                        {{ 'puzzle_intelligence.elo.ranking_opted_out'|trans }}
                        <a href="{{ path('edit_profile') }}">{{ 'statistics.change_in_settings'|trans }}</a>
                    </small>
                </div>
            </div>
        {% endif %}
    </div>

    <p class="text-muted fs-sm text-center mb-3" data-controller="next-quarter-countdown">
        <i class="bi bi-clock me-1"></i>
        {{ 'puzzle_intelligence.elo.recalculation_countdown'|trans }}
        <strong><span data-next-quarter-countdown-target="display">--:--</span></strong>
    </p>

    {# Not on this board: say why and what to do (design-spec §8.4) - opted out is the card above, not rated yet the
       qualification banner below with what is still missing #}
    {% if logged_player is null %}
        {{ include('_leaderboard_not_on_board.html.twig', {
            text: 'leaderboards.not_on_board.guest'|trans,
            link_href: path('login', {return: app.request.requestUri}),
            link_label: 'menu.sign_in'|trans,
        }) }}
    {% elseif not ranking_opted_out and logged_player.isPrivateProfile %}
        {# Global rankings stay closed to private profiles, rated or not #}
        {{ include('_leaderboard_not_on_board.html.twig', {
            text: 'leaderboards.rating.private_note'|trans,
            link_href: path('edit_profile'),
            link_label: 'statistics.change_in_settings'|trans,
        }) }}
    {% endif %}

    {# Qualification banner — full width below header #}
    {% if not ranking_opted_out and not is_rated and logged_player is not null and not logged_player.isPrivateProfile and rating_progress is not null %}
        {# Not yet qualified — show progress toward qualification #}
        {% set fa_done = rating_progress.first_attempts >= min_first_attempts %}
        {% set ts_done = rating_progress.total_solves >= min_total_solves %}
        <div class="card mb-3 border-primary bg-primary bg-opacity-10 shadow-custom">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <i class="bi bi-trophy text-primary flex-shrink-0" style="font-size: 1.5rem;"></i>
                    <div>
                        <h6 class="mb-0">{{ 'puzzle_intelligence.elo.qualification_title'|trans }}</h6>
                        <small class="text-muted">{{ 'puzzle_intelligence.elo.qualification_desc'|trans }}</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 mb-2">
                    <small class="text-muted" style="min-width: 110px;">
                        <i class="bi bi-{{ fa_done ? 'check-circle-fill text-success' : 'x-circle text-muted' }} me-1"></i>
                        {{ 'puzzle_intelligence.elo.progress_first_attempts'|trans }}
                    </small>
                    <div class="progress flex-grow-1" style="height: 6px; background-color: #fff;">
                        {% set fa_pct = (rating_progress.first_attempts / min_first_attempts * 100) > 100 ? 100 : (rating_progress.first_attempts / min_first_attempts * 100) %}
                        <div class="progress-bar {{ fa_done ? 'bg-success' : 'bg-primary' }}" style="width: {{ fa_pct }}%;"></div>
                    </div>
                    <small class="text-muted fw-medium" style="min-width: 45px;">{{ rating_progress.first_attempts }}/{{ min_first_attempts }}</small>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted" style="min-width: 110px;">
                        <i class="bi bi-{{ ts_done ? 'check-circle-fill text-success' : 'x-circle text-muted' }} me-1"></i>
                        {{ 'puzzle_intelligence.elo.progress_total_solves'|trans }}
                    </small>
                    <div class="progress flex-grow-1" style="height: 6px; background-color: #fff;">
                        {% set ts_pct = (rating_progress.total_solves / min_total_solves * 100) > 100 ? 100 : (rating_progress.total_solves / min_total_solves * 100) %}
                        <div class="progress-bar {{ ts_done ? 'bg-success' : 'bg-primary' }}" style="width: {{ ts_pct }}%;"></div>
                    </div>
                    <small class="text-muted fw-medium" style="min-width: 45px;">{{ rating_progress.total_solves }}/{{ min_total_solves }}</small>
                </div>
            </div>
        </div>
    {% endif %}

    <twig:MspRatingLadder />
{% endblock %}
