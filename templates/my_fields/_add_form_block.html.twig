{#
    "My fields" in the add-result form (docs/features/custom-fields.md "The add form") - the inputs of a player who
    has fields for results (my_fields: CustomFieldsForm). Rendered inside _add_form_area.html.twig, and on its own by
    `my_fields_add_form_block` when the dialog closes (the browser puts what was typed back into the new inputs).

    Beside the form, never part of it: the inputs are plain inputs next to the Symfony form (like the co-puzzlers), the
    values are saved after the result by a step of their own, and nothing typed here can refuse the result.
#}
<div class="my-fields-block" data-controller="toggle" data-testid="add-form-my-fields">
    {% set my_fields_open = open|default(false) or my_fields.hasAnyInput %}
    <button type="button" class="btn btn-outline-secondary shadow w-100 mb-3 {{ my_fields_open ? 'hidden' }}" data-action="click->toggle#toggle" data-toggle-target-param="myFields" style="min-height: 44px;">
        <i class="bi bi-stars me-1"></i> {{ 'my_fields.add_form.toggle'|trans }}
    </button>

    <div class="card card-body shadow mb-3 {{ not my_fields_open ? 'hidden' }}" data-toggle-target="myFields">
        <p class="fw-semibold mb-1"><i class="bi bi-stars me-1"></i>{{ 'my_fields.add_form.title'|trans }}</p>
        <p class="form-text mt-0 mb-3">{{ 'my_fields.private_note'|trans }}</p>

        {{ include('my_fields/_inputs.html.twig', {my_fields: my_fields, id_prefix: 'add-my-field'}) }}

        <p class="form-text mb-0">
            {# Without JavaScript the link opens the manage page in a new tab, as it always did #}
            <a href="{{ path('my_fields') }}" target="_blank" rel="noopener" data-action="my-fields-panel#open">{{ 'my_fields.manage_link'|trans }}</a>
        </p>
    </div>
</div>
