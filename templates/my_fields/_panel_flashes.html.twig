{# What the last change said - in the panel there is no page around it that would show the flash #}
{# Only what the fields' own controllers say - a flash meant for the next page stays for it #}
{% for type, messages in app.flashes(['success', 'warning']) %}
    {% for message in messages %}
        <div class="alert alert-{{ type }} fs-sm py-2" role="status" data-testid="my-fields-panel-flash">{{ message }}</div>
    {% endfor %}
{% endfor %}
