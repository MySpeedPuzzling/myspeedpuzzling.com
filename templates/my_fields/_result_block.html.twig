{#
    The signed-in viewer's own fields on one attempt of the result detail (docs/features/custom-fields.md) - theirs
    alone: a pair partner looking at the same result gets their own block, or none.

    Rendered only where own_field_values is not null (the viewer has fields for results) and the viewer is on the
    attempt - a player without fields gets no block and no taller row.

    The button opens the values form in the modal frame and says where it was opened from: on the page (`context=page`:
    saved, the modal closes and the page refreshes) or inside the result detail's own modal (`context=modal`: saved, the
    detail comes back into the modal with the new values).

    Inputs: own_field_values (OwnCustomValues), time_id, result_in_modal (bool, default false)
#}
{% set filled = own_field_values.filledOn(time_id) %}
{% set edit_label = (filled is empty ? 'my_fields.result.fill' : 'my_fields.result.edit')|trans %}
<div class="d-flex align-items-start justify-content-between gap-2 fs-xs mt-1" id="my-fields-of-{{ time_id }}" data-testid="result-my-fields">
    <div class="text-break pt-1" style="min-width: 0;">
        <i class="bi bi-lock text-muted" title="{{ 'my_fields.private_note'|trans }}"></i>
        {% for entry in filled %}
            {# Text keeps its line breaks (pre-line) - shown as text, escaped like every value #}
            <span class="me-2"{% if entry.field.type.value == 'text' %} style="white-space: pre-line;"{% endif %}><span class="text-muted">{{ my_field_label(entry.field) }}:</span>
                {% if entry.field.type.value == 'rating' -%}
                    {# Stars for the eye, "4 of 5" for a screen reader and on hover #}
                    {%- set rating_text = my_field_value_text(entry.field, entry.value) -%}
                    <span role="img" aria-label="{{ rating_text }}" title="{{ rating_text }}" class="text-nowrap">{% for star in 1..5 %}{{ star <= entry.value ? '★' : '☆' }}{% endfor %}</span>
                {%- else -%}
                    {{ my_field_value_text(entry.field, entry.value) }}
                {%- endif -%}
            </span>
        {% else %}
            <span class="text-muted me-2">{{ 'my_fields.result.label'|trans }}</span>
        {% endfor %}
    </div>
    {# A 44 px target - a button, not a line of text #}
    <a href="{{ path('result_my_fields', {timeId: time_id, context: result_in_modal|default(false) ? 'modal' : 'page'}) }}"
       data-turbo-frame="modal-frame"
       class="btn btn-sm btn-outline-secondary flex-shrink-0 d-inline-flex align-items-center justify-content-center text-nowrap"
       style="min-height: 44px; min-width: 44px;"
       aria-label="{{ 'my_fields.result.label'|trans }}: {{ edit_label }}">
        <i class="ci-edit me-1" aria-hidden="true"></i>{{ edit_label }}
    </a>
</div>
