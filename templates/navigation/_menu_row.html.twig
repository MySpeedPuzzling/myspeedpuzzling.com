{#- One row of the Menu (README §4.12): icon · label (a one-line description under it only where the label is ambiguous)
    · count or status · chevron (CSS). Same translation key and icon as the destination has on every surface (the
    registry). Anchor id menu-row-<id> on the <li>, aria-current="page" on the current page's row (nav_location()
    .menuRowId). Kept lean - it repeats ~55 times on every page (chrome weight, MENU-01). The docked column's Puzzles
    place row carries its sections' links like the tab (data-nav-place, data-puzzles-sections - PUZ-01).
    `row`: MenuRowView, `viewer`: NavigationViewer -#}
{%- set entry = row.entry -%}
{%- set kind = row.kind.value -%}
{%- set only = row.only ? 'menu-only-' ~ row.only.value : '' -%}
{%- if kind == 'you_card' -%}
    {{- include('navigation/_menu_you_card.html.twig', {row: row, profile: viewer.profile, only: only}, with_context = false) -}}
{%- elseif kind == 'guest_card' -%}
    {{- include('navigation/_menu_guest_card.html.twig', {row: row, only: only}, with_context = false) -}}
{%- elseif kind == 'language' -%}
    {{- include('navigation/_menu_language.html.twig', {row: row, only: only}, with_context = false) -}}
{%- elseif kind == 'legal' -%}
    <li id="{{ row.anchorId }}" class="mr-legal{{ only ? ' ' ~ only }}"><i class="bi {{ entry.icon }}" aria-hidden="true"></i><span class="mr-links">
    {%- for link in row.links -%}
        <a href="{{ link.href }}" data-nav="{{ link.navId }}"{{ link.current ? ' aria-current="page"' }}>{{ link.entry.label|trans }}</a>
    {%- endfor -%}
    </span></li>
{%- elseif entry.count is not null and entry.count.value == 'inbox_badge' -%}
    {#- The Inbox link of every surface (INB-01/INB-02): the tab holding the unread items, the combined badge -#}
    <li id="{{ row.anchorId }}"{{ only ? (' class="' ~ only ~ '"')|raw }}>
    {%- embed 'inbox/_link.html.twig' with {nav: row.navId, class: 'mr', surface: 'menu', current: row.current, row_label: entry.label|trans, icon: entry.icon} only -%}
        {%- block content -%}<i class="bi {{ icon }}" aria-hidden="true"></i><span class="mr-l">{{ row_label }}</span> <span class="mr-c">{{ include('inbox/_badge.html.twig', {part: 'total', parts: parts, class: 'mr-badge'}) }}</span>{%- endblock -%}
    {%- endembed -%}
    </li>
{%- else -%}
    {%- set count_source = entry.count.value ?? null -%}
    {%- set stopwatch = count_source == 'stopwatch' ? viewer.profile.runningStopwatch ?? null : null -%}
    {%- set classes = [kind == 'logout' ? 'menu-logout' : '', only]|filter(c => c != '')|join(' ') -%}
    <li id="{{ row.anchorId }}"{{ classes ? (' class="' ~ classes ~ '"')|raw }}>
        {#- -#}<a class="mr{{ kind == 'place' ? ' mr--place' }}" href="{{ row.href }}" data-nav="{{ row.navId }}" data-press
        {%- if row.current %} aria-current="page"{% endif %}
        {%- if row.nofollow %} rel="nofollow"{% endif %}
        {%- if kind == 'help_sheet' %} {{ help_opener_attrs() }}{% endif %}
        {%- if kind == 'logout' %} data-turbo="false"{% endif %}
        {%- if entry.id == 'puzzles_place' %} data-nav-place="puzzles" data-puzzles-sections="{{ nav_puzzles_sections()|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}"{% endif %}>
        {#- -#}<i class="bi {{ entry.icon }}" aria-hidden="true"></i><span class="mr-l">{{ entry.label|trans }}
        {%- if stopwatch is not null -%}
            <small class="mr-d mr-running">{{ 'nav.menu.running'|trans }} · {{ include('navigation/_stopwatch_elapsed.html.twig', {stopwatch: stopwatch}, with_context = false) }}</small>
        {%- elseif count_source == 'membership_status' -%}
            <small class="mr-d">{{ include('navigation/_membership_status.html.twig', {viewer: viewer}, with_context = false) }}</small>
        {%- elseif entry.description is not null -%}
            <small class="mr-d">{{ entry.description|trans }}</small>
        {%- endif -%}
        </span>
        {%- if row.countTestId is not null %} <span class="mr-c"><span class="badge {{ row.count > 0 ? 'bg-warning text-dark' : 'bg-success' }}" data-testid="{{ row.countTestId }}">{{ row.count }}</span></span>
        {%- elseif row.lazyCount is not null %} <span class="mr-c" data-menu-count="{{ row.lazyCount }}"></span>
        {%- elseif row.count is not null %} <span class="mr-c"><span class="mr-n">{{ count_source == 'level' ? 'xp.level_chip'|trans({'%level%': row.count}) : row.count }}</span></span>
        {%- endif -%}
        </a></li>
{%- endif -%}
