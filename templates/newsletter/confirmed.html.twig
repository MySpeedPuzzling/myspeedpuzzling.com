{% extends 'base.html.twig' %}

{% block title %}{{ 'newsletter.confirm.headline'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <div class="row gy-3 pb-4">
        <div class="col-lg-6 col-md-8">
            <h1 class="h2">{{ 'newsletter.confirm.headline'|trans }}</h1>

            <div class="alert alert-success" role="alert">
                <i class="ci-check-circle me-2"></i>
                {{ 'newsletter.confirm.text'|trans }}
            </div>

            {% if not isPlayer %}
                <p>{{ 'newsletter.confirm.register_pitch'|trans }}</p>
            {% endif %}

            <p class="d-flex flex-wrap gap-2">
                {% if not isPlayer %}
                    <a class="btn btn-primary" href="{{ path('register') }}">
                        {{ 'newsletter.confirm.cta_register'|trans }}
                    </a>
                    <a class="btn btn-outline-primary" href="{{ path('homepage') }}">
                        {{ 'newsletter.confirm.cta_homepage'|trans }}
                    </a>
                {% else %}
                    <a class="btn btn-primary" href="{{ path('homepage') }}">
                        {{ 'newsletter.confirm.cta_homepage'|trans }}
                    </a>
                {% endif %}
            </p>
        </div>

        <div class="col-lg-5 offset-lg-1 col-md-4 text-center d-none d-md-block">
            <img class="img-fluid" src="{{ asset('img/puzzlie-1.png') }}" alt="" width="1000" height="949">
        </div>
    </div>
{% endblock %}
