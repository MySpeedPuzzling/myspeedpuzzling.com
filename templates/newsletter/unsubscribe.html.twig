{% extends 'base.html.twig' %}

{% block title %}{{ 'newsletter.unsubscribe.headline'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <div class="row gy-3 pb-4">
        <div class="col-lg-6 col-md-8">
            <h1 class="h2">{{ 'newsletter.unsubscribe.headline'|trans }}</h1>

            <p>{{ 'newsletter.unsubscribe.text'|trans({'%email%': email})|raw }}</p>

            <form action="{{ path('newsletter_unsubscribe_confirm', {'token': token}) }}" method="post" class="mb-3">
                <input type="hidden" name="_token" value="{{ csrf_token('newsletter-unsubscribe') }}">
                <button type="submit" class="btn btn-primary">
                    {{ 'newsletter.unsubscribe.confirm_button'|trans }}
                </button>
            </form>

            {% if isPlayer %}
                <p class="fs-sm text-muted mb-2">{{ 'newsletter.unsubscribe.manage_hint'|trans }}</p>
                <p>
                    <a class="btn btn-outline-primary btn-sm" href="{{ path('edit_profile') }}">
                        {{ 'newsletter.unsubscribe.manage_button'|trans }}
                    </a>
                </p>
            {% endif %}
        </div>

        <div class="col-lg-5 offset-lg-1 col-md-4 text-center d-none d-md-block">
            <img class="img-fluid" src="{{ asset('img/puzzlie-1.png') }}" alt="" width="1000" height="949">
        </div>
    </div>
{% endblock %}
