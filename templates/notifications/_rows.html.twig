{#
    One table row per notification, the same on the notifications page and in the bell's dropdown.
      - notifications (list<PlayerNotification>), position_offset (int, optional: rows before these - the first rows load
        their pictures eagerly)
#}
{% for notification in notifications %}
    <tr class="{{ notification.readAt is null ? 'table-active-player' }}">
        {% if notification.isChangeRequestNotification %}
            {# Puzzle change request notification #}
            <td class="text-center" style="width: 60px;">
                <i class="bi bi-pencil-square fs-3 {{ notification.notificationType.value == 'PuzzleChangeRequestApproved' ? 'text-success' : 'text-danger' }}"></i>
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>

                {% if notification.notificationType.value == 'PuzzleChangeRequestApproved' %}
                    <span class="text-success">{{ 'notifications.puzzle_report.change_approved'|trans }}</span>
                {% else %}
                    <span class="text-danger">{{ 'notifications.puzzle_report.change_rejected'|trans }}</span>
                    {% if notification.changeRequestRejectionReason %}
                        <br><small class="text-muted">{{ notification.changeRequestRejectionReason }}</small>
                    {% endif %}
                {% endif %}
                -
                <a class="text-decoration-underline" href="{{ path('puzzle_detail', {'puzzleId': notification.changeRequestPuzzleId}) }}">{{ notification.changeRequestPuzzleName }}</a>
            </td>

            <td class="" style="width: 80px;">
                {% if notification.changeRequestPuzzleImage is not null %}
                    <a href="{{ path('puzzle_detail', {puzzleId: notification.changeRequestPuzzleId}) }}">
                        {{ include('_puzzle_row_image.html.twig', {image: notification.changeRequestPuzzleImage, alt: notification.changeRequestPuzzleName, position: (position_offset ?? 0) + loop.index, ratio: null}) }}
                    </a>
                {% endif %}
            </td>
        {% elseif notification.isMergeRequestNotification %}
            {# Puzzle merge request notification #}
            <td class="text-center" style="width: 60px;">
                <i class="bi bi-files fs-3 {{ notification.notificationType.value == 'PuzzleMergeRequestApproved' ? 'text-success' : 'text-danger' }}"></i>
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>

                {% if notification.notificationType.value == 'PuzzleMergeRequestApproved' %}
                    <span class="text-success">{{ 'notifications.puzzle_report.merge_approved'|trans }}</span>
                {% else %}
                    <span class="text-danger">{{ 'notifications.puzzle_report.merge_rejected'|trans }}</span>
                    {% if notification.mergeRequestRejectionReason %}
                        <br><small class="text-muted">{{ notification.mergeRequestRejectionReason }}</small>
                    {% endif %}
                {% endif %}
                -
                <a class="text-decoration-underline" href="{{ path('puzzle_detail', {'puzzleId': notification.mergeRequestPuzzleId}) }}">{{ notification.mergeRequestPuzzleName }}</a>
            </td>

            <td class="" style="width: 80px;">
                {% if notification.mergeRequestPuzzleImage is not null %}
                    <a href="{{ path('puzzle_detail', {puzzleId: notification.mergeRequestPuzzleId}) }}">
                        {{ include('_puzzle_row_image.html.twig', {image: notification.mergeRequestPuzzleImage, alt: notification.mergeRequestPuzzleName, position: (position_offset ?? 0) + loop.index, ratio: null}) }}
                    </a>
                {% endif %}
            </td>
        {% elseif notification.isRatingNotification %}
            {# Transaction rating notification #}
            <td class="text-center" style="width: 60px;">
                <i class="bi bi-star-fill fs-3 text-warning"></i>
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>
                <span>Rate your transaction with
                    <a class="text-decoration-underline" href="{{ path('player_profile', {playerId: notification.ratingOtherPlayerId}) }}">{{ notification.ratingOtherPlayerName }}</a>
                    for <strong>{{ notification.ratingPuzzleName }}</strong>
                </span>
            </td>

            <td class="" style="width: 80px;">
                <a href="{{ path('rate_transaction', {soldSwappedItemId: notification.soldSwappedItemId, return: path('notifications')}) }}" class="btn btn-sm btn-warning">
                    <i class="bi bi-star"></i> Rate
                </a>
            </td>
        {% elseif notification.isConversationRequestNotification %}
            {# Conversation request notification #}
            <td class="text-center" style="width: 60px;">
                <a href="{{ path('conversation_detail', {conversationId: notification.conversationId}) }}">
                    {% if notification.conversationInitiatorAvatar is not null %}
                        <img class="rounded-circle" style="max-width: 50px;max-height: 50px;" alt="Avatar" src="{{ notification.conversationInitiatorAvatar|thumbnail('puzzle_small') }}">
                    {% else %}
                        <span class="avatar-name rounded-circle">{{ notification.conversationInitiatorName|slice(0, 1)|upper }}</span>
                    {% endif %}
                </a>
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>
                {% if notification.conversationIsMarketplace and notification.conversationPuzzleName is not null %}
                    {{ 'notifications.conversation_request.marketplace'|trans({
                        '%player%': '<a class="text-decoration-underline" href="' ~ path('conversation_detail', {conversationId: notification.conversationId}) ~ '">' ~ notification.conversationInitiatorName ~ '</a>',
                        '%puzzle%': notification.conversationPuzzleName
                    })|raw }}
                {% else %}
                    {{ 'notifications.conversation_request.general'|trans({
                        '%player%': '<a class="text-decoration-underline" href="' ~ path('conversation_detail', {conversationId: notification.conversationId}) ~ '">' ~ notification.conversationInitiatorName ~ '</a>'
                    })|raw }}
                {% endif %}
            </td>

            <td class="" style="width: 80px;">
                {% if notification.conversationIsMarketplace and notification.conversationPuzzleImage is not null %}
                    <a href="{{ path('conversation_detail', {conversationId: notification.conversationId}) }}">
                        {{ include('_puzzle_row_image.html.twig', {image: notification.conversationPuzzleImage, alt: notification.conversationPuzzleName, position: (position_offset ?? 0) + loop.index, ratio: null}) }}
                    </a>
                {% else %}
                    <a href="{{ path('conversation_detail', {conversationId: notification.conversationId}) }}" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-chat-dots"></i>
                    </a>
                {% endif %}
            </td>
        {% elseif notification.isModeratorRoleNotification %}
            {# Community moderator role: invited (leads to the guide), granted, revoked #}
            {% set moderator_type = notification.notificationType.value %}
            <td class="text-center" style="width: 60px;">
                <i class="bi {{ moderator_type == 'ModeratorRoleRevoked' ? 'bi-shield-x text-muted' : (moderator_type == 'ModeratorInvitationReceived' ? 'bi-envelope-heart text-primary' : 'bi-shield-check text-success') }} fs-3"></i>
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>
                {{ {
                    'ModeratorInvitationReceived': 'notifications.moderator_role.invited',
                    'ModeratorRoleGranted': 'notifications.moderator_role.granted',
                    'ModeratorRoleRevoked': 'notifications.moderator_role.revoked',
                }[moderator_type]|trans }}
            </td>

            <td class="" style="width: 80px;">
                {% if moderator_type == 'ModeratorInvitationReceived' %}
                    <a href="{{ path('moderator_guide') }}" class="btn btn-sm btn-outline-primary" aria-label="{{ 'notifications.moderator_role.open_guide'|trans }}">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                {% elseif moderator_type == 'ModeratorRoleGranted' and is_granted('PUZZLE_MODERATION_ACCESS') %}
                    <a href="{{ path('admin_puzzle_change_requests') }}" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                {% endif %}
            </td>
        {% elseif notification.isGuestLinkNotification %}
            {# "This guest of mine is you" - asked, or agreed to #}
            {% set guest_link_asked = notification.notificationType.value == 'GuestLinkRequested' %}
            <td class="text-center" style="width: 60px;">
                <i class="bi {{ guest_link_asked ? 'bi-person-plus' : 'bi-person-check text-success' }} fs-3 {{ guest_link_asked ? 'text-primary' }}"></i>
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>
                {{ (guest_link_asked ? 'notifications.guest_link.requested' : 'notifications.guest_link.accepted')|trans({'%player%': notification.targetPlayerName, '%guest%': notification.guestLinkGuestName}) }}
            </td>

            <td class="" style="width: 80px;">
                <a href="{{ guest_link_asked ? path('pairs_and_teams_guest_link', {requestId: notification.guestLinkRequestId}) : path('pairs_and_teams') }}" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-arrow-right"></i>
                </a>
            </td>
        {% elseif notification.isPartnerRequestNotification %}
            {# "I'd like to puzzle with you" on the player's partner finder listing (docs/features/partner-finder.md D6) -
               who asks is named (their consent), their profile linked only when the reader may see it #}
            {% set partner_finder_link = partner_finder_url(notification.partnerCompetitionSlug, notification.partnerSeriesSlug) %}
            {% set asker_name = notification.targetPlayerName ?? notification.targetPlayerId %}
            <td class="text-center" style="width: 60px;">
                {% if notification.targetPlayerAvatar is not null %}
                    <img class="rounded-circle" style="max-width: 50px;max-height: 50px;" alt="Avatar" src="{{ notification.targetPlayerAvatar|thumbnail('puzzle_small') }}">
                {% else %}
                    <span class="avatar-name rounded-circle">{{ asker_name|slice(0, 1)|upper }}</span>
                {% endif %}
            </td>

            <td class="align-middle fs-sm text-muted" id="partner-request-{{ notification.partnerRequestId }}">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>
                {{ ('partner_finder.notification.text_' ~ (notification.partnerRequestKind.value ?? 'pair'))|trans({
                    '%player%': notification.targetPlayerIsPrivate
                        ? '<b>' ~ asker_name|e ~ '</b>'
                        : '<a class="text-decoration-underline" href="' ~ path('player_profile', {playerId: notification.targetPlayerId}) ~ '">' ~ asker_name|e ~ '</a>',
                    '%event%': notification.partnerCompetitionName|e,
                })|raw }}
                {% if notification.partnerRequestNote is not null %}
                    <br><span class="fst-italic">“{{ notification.partnerRequestNote }}”</span>
                {% endif %}
                {% if partner_finder_link is not null %}
                    <br><a class="text-decoration-underline" href="{{ partner_finder_link }}">{{ 'partner_finder.notification.see_listings'|trans }}</a>
                {% endif %}
            </td>

            <td class="" style="width: 80px;">
                <form method="post" action="{{ path('partner_request_reply', {requestId: notification.partnerRequestId}) }}" class="m-0">
                    <input type="hidden" name="_token" value="{{ csrf_token('partner_request') }}">
                    <button type="submit" class="btn btn-sm {{ notification.partnerRequestReplied ? 'btn-outline-primary' : 'btn-primary' }} text-nowrap">
                        <i class="bi bi-chat-dots"></i> {{ (notification.partnerRequestReplied ? 'partner_finder.notification.open_chat' : 'partner_finder.notification.reply')|trans }}
                    </button>
                </form>
            </td>
        {% elseif notification.isPartnerTeamedUpNotification or notification.isPartnerGroupMemberNotification %}
            {# The actor's partner finder listing names the reader: they teamed up ("Found my partner" naming the
               reader) or the reader is in their group (docs/features/partner-finder.md "Phase 2 as built") -
               still listed at the event = the text asks to close the reader's own listing too #}
            {% set partner_finder_link = partner_finder_url(notification.partnerCompetitionSlug, notification.partnerSeriesSlug) %}
            {% set actor_name = notification.targetPlayerName ?? notification.targetPlayerId %}
            {% set partner_text = notification.isPartnerTeamedUpNotification ? 'teamed_up' : 'group_member' %}
            <td class="text-center" style="width: 60px;">
                {% if notification.targetPlayerAvatar is not null and not notification.targetPlayerIsPrivate %}
                    <img class="rounded-circle" style="max-width: 50px;max-height: 50px;" alt="Avatar" src="{{ notification.targetPlayerAvatar|thumbnail('puzzle_small') }}">
                {% else %}
                    <span class="avatar-name rounded-circle">{{ actor_name|slice(0, 1)|upper }}</span>
                {% endif %}
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>
                {{ ('partner_finder.notification.text_' ~ partner_text)|trans({
                    '%player%': notification.targetPlayerIsPrivate
                        ? '<b>' ~ actor_name|e ~ '</b>'
                        : '<a class="text-decoration-underline" href="' ~ path('player_profile', {playerId: notification.targetPlayerId}) ~ '">' ~ actor_name|e ~ '</a>',
                    '%event%': notification.partnerCompetitionName|e,
                })|raw }}
                {% if notification.partnerReaderListed %}
                    <br>{{ 'partner_finder.notification.close_yours'|trans }}
                {% endif %}
            </td>

            <td class="" style="width: 80px;">
                {% if partner_finder_link is not null %}
                    <a href="{{ partner_finder_link }}" class="btn btn-sm {{ notification.partnerReaderListed ? 'btn-primary' : 'btn-outline-primary' }} text-nowrap">
                        {{- (notification.partnerReaderListed ? 'partner_finder.notification.open_listing' : 'partner_finder.notification.see_listings')|trans -}}
                    </a>
                {% endif %}
            </td>
        {% elseif notification.isBorrowRequestNotification %}
            {# "Could I borrow these?" (docs/features/wishlist-availability.md): asked of the reader, answered or
               expired for the reader - the player shown is who asked / was asked #}
            {% set borrow_person = notification.targetPlayerName ?? ('#' ~ notification.targetPlayerCode|upper) %}
            {% set borrow_type = notification.notificationType.value %}
            <td class="text-center" style="width: 60px;">
                {% if notification.targetPlayerAvatar is not null %}
                    <img class="rounded-circle" style="max-width: 50px;max-height: 50px;" alt="Avatar" src="{{ notification.targetPlayerAvatar|thumbnail('puzzle_small') }}">
                {% else %}
                    <span class="avatar-name rounded-circle">{{ borrow_person|trim('#')|slice(0, 1)|upper }}</span>
                {% endif %}
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>
                {% set borrow_player = notification.targetPlayerIsPrivate
                    ? '<b>' ~ borrow_person|e ~ '</b>'
                    : '<a class="text-decoration-underline" href="' ~ path('player_profile', {playerId: notification.targetPlayerId}) ~ '">' ~ borrow_person|e ~ '</a>' %}
                {% if borrow_type == 'BorrowRequested' %}
                    {{ 'borrow_request.notification.requested'|trans({'%player%': borrow_player, '%count%': notification.borrowItemsTotal})|raw }}
                {% elseif borrow_type == 'BorrowRequestAnswered' %}
                    {{ 'borrow_request.notification.answered'|trans({'%player%': borrow_player, '%count%': notification.borrowItemsYes, '%total%': notification.borrowItemsTotal})|raw }}
                {% else %}
                    {{ 'borrow_request.notification.expired'|trans({'%player%': borrow_player, '%count%': notification.borrowItemsTotal})|raw }}
                {% endif %}
            </td>

            <td class="" style="width: 80px;">
                <a href="{{ path('borrow_request_detail', {requestId: notification.borrowRequestId}) }}" class="btn btn-sm {{ borrow_type == 'BorrowRequested' ? 'btn-primary' : 'btn-outline-primary' }} text-nowrap">
                    {{- (borrow_type == 'BorrowRequested' ? 'borrow_request.notification.answer' : 'borrow_request.notification.open')|trans -}}
                </a>
            </td>
        {% elseif notification.isOfficialResultNotification %}
            {# The official results of a round the player has a result in were published #}
            {% if notification.roundCompetitionSlug is null %}
                {% set official_results_url = path('events') %}
            {% elseif notification.roundSlug is not null %}
                {% set official_results_url = notification.roundSeriesSlug is not null
                    ? path('edition_round_results', {seriesSlug: notification.roundSeriesSlug, editionSlug: notification.roundCompetitionSlug, roundSlug: notification.roundSlug})
                    : path('event_round_results', {slug: notification.roundCompetitionSlug, roundSlug: notification.roundSlug}) %}
            {% else %}
                {% set official_results_url = notification.roundSeriesSlug is not null
                    ? path('edition_detail', {seriesSlug: notification.roundSeriesSlug, editionSlug: notification.roundCompetitionSlug})
                    : path('event_detail', {slug: notification.roundCompetitionSlug}) %}
            {% endif %}
            <td class="text-center" style="width: 60px;">
                <i class="bi bi-trophy fs-3 text-primary"></i>
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>
                {{ 'official_results.notification.published'|trans({'%round%': notification.roundName, '%competition%': notification.roundCompetitionName}) }}
            </td>

            <td class="" style="width: 80px;">
                <a href="{{ official_results_url }}" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-arrow-right"></i>
                </a>
            </td>
        {% elseif notification.isPuzzlingTeamRenamedNotification %}
            {# A pair/team of the player was named or renamed by another member #}
            <td class="text-center" style="width: 60px;">
                <i class="ci-user-group fs-3 text-primary"></i>
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>
                {% if notification.teamName is not null %}
                    {{ 'notifications.puzzling_team.renamed'|trans({'%player%': notification.targetPlayerName, '%name%': notification.teamName}) }}
                {% else %}
                    {{ 'notifications.puzzling_team.name_removed'|trans({'%player%': notification.targetPlayerName}) }}
                {% endif %}
            </td>

            <td class="" style="width: 80px;">
                <a href="{{ path('puzzling_team_detail', {teamId: notification.teamId, return: path('notifications'), return_title: 'notifications.title'|trans}) }}" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-arrow-right"></i>
                </a>
            </td>
        {% elseif notification.isLendingNotification %}
            {# Lending notification #}
            <td class="text-center" style="width: 60px;">
                <i class="bi bi-arrow-left-right fs-3 text-primary"></i>
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>

                {% if notification.notificationType.value == 'PuzzleLentToYou' %}
                    <span>{{ 'notifications.lending.lent_to_you'|trans({'%owner%': notification.ownerPlayerName}) }}</span>
                {% elseif notification.notificationType.value == 'PuzzleBorrowedFromYou' %}
                    <span>{{ 'notifications.lending.borrowed_from_you'|trans({'%borrower%': notification.toPlayerName}) }}</span>
                {% elseif notification.notificationType.value == 'PuzzleReturnedToYou' %}
                    <span>{{ 'notifications.lending.returned_to_you'|trans({'%holder%': notification.fromPlayerName}) }}</span>
                {% elseif notification.notificationType.value == 'PuzzleTakenBack' %}
                    <span>{{ 'notifications.lending.taken_back'|trans({'%owner%': notification.ownerPlayerName}) }}</span>
                {% elseif notification.notificationType.value == 'PuzzlePassedToYou' %}
                    <span>{{ 'notifications.lending.passed_to_you'|trans({'%from%': notification.fromPlayerName}) }}</span>
                {% elseif notification.notificationType.value == 'PuzzlePassedFromYou' %}
                    <span>{{ 'notifications.lending.passed_from_you'|trans({'%to%': notification.toPlayerName}) }}</span>
                {% elseif notification.notificationType.value == 'YourPuzzleWasPassed' %}
                    <span>{{ 'notifications.lending.your_puzzle_passed'|trans({'%from%': notification.fromPlayerName, '%to%': notification.toPlayerName}) }}</span>
                {% endif %}
                -
                <a class="text-decoration-underline" href="{{ path('puzzle_detail', {'puzzleId': notification.lendingPuzzleId}) }}">{{ notification.lendingManufacturerName }} {{ 'pieces_count'|trans({ '%count%': notification.lendingPiecesCount })|raw }}</a>
            </td>

            <td class="" style="width: 80px;">
                {% if notification.lendingPuzzleImage is not null %}
                    <a href="{{ path('puzzle_detail', {puzzleId: notification.lendingPuzzleId}) }}">
                        {{ include('_puzzle_row_image.html.twig', {image: notification.lendingPuzzleImage, alt: 'puzzle_img_alt'|trans({'%puzzle%': notification.lendingManufacturerName ~ ' ' ~ notification.lendingPuzzleName}), position: (position_offset ?? 0) + loop.index, ratio: notification.lendingPuzzleImageRatio}) }}
                    </a>
                {% endif %}
            </td>
        {% elseif notification.isGroupSolvingTimeEditedNotification %}
            {# A pair/team time the player is part of was edited - the target player is the editor #}
            <td class="text-center" style="width: 60px;">
                <a href="{{ path('player_profile', {'playerId': notification.targetPlayerId}) }}">
                    {% if notification.targetPlayerAvatar is not null %}
                        <img class="rounded-circle" style="max-width: 50px;max-height: 50px;" alt="Avatar" src="{{ notification.targetPlayerAvatar|thumbnail('puzzle_small') }}">
                    {% else %}
                        <span class="avatar-name rounded-circle">{{ notification.targetPlayerName|slice(0, 1)|upper }}</span>
                    {% endif %}
                </a>
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>

                <a class="text-decoration-underline" href="{{ path('player_profile', {playerId: notification.targetPlayerId}) }}">
                    {{ notification.targetPlayerName }}
                </a>
                {{ 'notifications.group_time_edited'|trans }}
                <a class="text-decoration-underline" href="{{ path('puzzle_detail', {'puzzleId': notification.puzzleId}) }}">{{ notification.manufacturerName }} {{ notification.puzzleName }} {{ 'pieces_count'|trans({ '%count%': notification.piecesCount })|raw }}</a>
                {% if notification.time is not null %}
                    - {{ 'notifications.group_time_edited_now'|trans }} <span style="color: #000;">{{ notification.time|puzzlingTime }}</span>
                {% endif %}
            </td>

            <td class="" style="width: 80px;">
                {% if notification.puzzleImage is not null%}
                    <a href="{{ path('puzzle_detail', {puzzleId: notification.puzzleId}) }}">
                        {{ include('_puzzle_row_image.html.twig', {image: notification.puzzleImage, alt: 'puzzle_img_alt'|trans({'%puzzle%': notification.manufacturerName ~ ' ' ~ notification.puzzleName}), position: (position_offset ?? 0) + loop.index, ratio: notification.puzzleImageRatio}) }}
                    </a>
                {% endif %}
            </td>
        {% else %}
            {# Puzzle solving notification #}
            <td class="text-center" style="width: 60px;">
                {% if notification.targetPlayerIsPrivate %}
                    <span class="avatar-name rounded-circle"><i class="bi bi-incognito"></i></span>
                {% else %}
                    <a href="{{ path('player_profile', {'playerId': notification.targetPlayerId}) }}">
                        {% if notification.targetPlayerAvatar is not null %}
                            <img class="rounded-circle" style="max-width: 50px;max-height: 50px;" alt="Avatar" src="{{ notification.targetPlayerAvatar|thumbnail('puzzle_small') }}">
                        {% else %}
                            <span class="avatar-name rounded-circle">{{ notification.targetPlayerName|slice(0, 1)|upper }}</span>
                        {% endif %}
                    </a>
                {% endif %}
            </td>

            <td class="align-middle fs-sm text-muted">
                <b style="color: #000;">{{ notification.notifiedAt|ago }}</b><br>

                {% if notification.players is null and notification.targetPlayerIsPrivate %}
                    <span class="player-name-item small text-muted">{{ 'secret_puzzler_name'|trans }}</span>
                    <i class="bi bi-incognito text-muted"></i>
                {% elseif notification.players is null %}
                    <a class="text-decoration-underline" href="{{ path('player_profile', {playerId: notification.targetPlayerId}) }}">
                        {{ notification.targetPlayerName }}
                    </a>
                    {% if notification.targetPlayerCountry is not null %}
                        <span class="shadow-custom fi fi-{{ notification.targetPlayerCountry.name }}"></span>
                    {% endif %}
                {% else %}
                    {% for puzzle_solver in notification.players %}
                        <span class="{{ not loop.first ? 'ms-1' }}">
                            {% if puzzle_solver.isPrivate %}
                                <span class="player-name-item small text-muted">{{ 'secret_puzzler_name'|trans }}</span>
                                <i class="bi bi-incognito text-muted"></i>
                            {% elseif puzzle_solver.playerId is not null %}
                                <a class="text-decoration-underline" href="{{ path('player_profile', {playerId: puzzle_solver.playerId}) }}">
                                    {{ puzzle_solver.playerName ?? ('#' ~ puzzle_solver.playerCode) }}
                                </a>
                                {% if puzzle_solver.playerCountry is not null %}
                                    <span class="shadow-custom fi fi-{{ puzzle_solver.playerCountry.name }}"></span>
                                {% endif %}
                            {% else %}
                                {{ puzzle_solver.playerName ?? ('#' ~ puzzle_solver.playerCode) }}
                            {% endif %}
                        </span>
                    {% endfor %}
                {% endif %}
                <span class="ms-1">- {{ 'notifications.solved_puzzle'|trans({'%count%': notification.players is null ? 1 : notification.players|length }) }}</span>
                <a class="text-decoration-underline" href="{{ path('puzzle_detail', {'puzzleId': notification.puzzleId}) }}">{{ notification.manufacturerName }} {{ 'pieces_count'|trans({ '%count%': notification.piecesCount })|raw }}</a>
                {% if notification.time is not null %}
                    {{ 'notifications.solved_puzzle_with_time'|trans }} <span style="color: #000;">{{ notification.time|puzzlingTime }}</span>
                {% else %}
                    <i class="bi bi-cup-hot text-muted"></i> <span class="text-muted">{{ 'badge.relax'|trans }}</span>
                {% endif %}
                {% if notification.firstAttempt %}
                    <br>
                    <span class="badge rounded-pill bg-info">{{ 'first_attempt'|trans }}</span>
                {% endif %}
                {% if notification.unboxed %}
                    <br>
                    <span class="badge rounded-pill bg-warning"><i class="bi bi-eye-slash"></i> {{ 'unboxed'|trans }}</span>
                {% endif %}
            </td>

            <td class="" style="width: 80px;">
                {% if notification.puzzleImage is not null%}
                    <a href="{{ path('puzzle_detail', {puzzleId: notification.puzzleId}) }}">
                        {{ include('_puzzle_row_image.html.twig', {image: notification.puzzleImage, alt: 'puzzle_img_alt'|trans({'%puzzle%': notification.manufacturerName ~ ' ' ~ notification.puzzleName}), position: (position_offset ?? 0) + loop.index, ratio: notification.puzzleImageRatio}) }}
                    </a>
                {% endif %}
            </td>
        {% endif %}
    </tr>
{% endfor %}
