{# The organiser's official results tools of one round - Live entry (live_results), Results (results_desk) and
   Seating (round_seating, in-person events only; "not used" while the round goes without table numbers).
   Shared by the round list, the results overview and the results desk (docs/features/competitions-management/results-desk.md).
   Expects: round_id, is_online; optional: table_numbers_off (false), current ('live' | 'desk' | 'seating' - left out),
   button_class ('btn-sm btn-outline-primary'), return_url + return_title (passed on as ?return=), with_stopwatch (false -
   also the round's stopwatch control page, for the results overview), competition_id (also "Participants": the round's
   tab of the participants sheet - organisers only, and every page including this partial is one: COMPETITION_EDIT. The
   live entry, the one tool referees open, does not include it; the round list has its own link). A round that uses
   online timing also gets Online timing (online_round_settings), Personal links (online_links), Control room
   (online_control_room) and Review (online_review) - for a viewer who may set it up (ONLINE_ROUNDS_MANAGE,
   online_round_tools()) #}
{%- set tool_query = return_url|default(null) is not null ? {return: return_url, return_title: return_title|default('')} : {} -%}
{%- set tool_button = button_class|default('btn-sm btn-outline-primary') -%}
{%- if current|default(null) != 'live' -%}
    <a href="{{ path('live_results', {roundId: round_id}|merge(tool_query)) }}" class="btn {{ tool_button }}" data-round-tool="live">
        <i class="bi bi-phone me-1" aria-hidden="true"></i>{{ 'results_desk.tools.live_entry'|trans }}
    </a>
{%- endif -%}
{%- if current|default(null) != 'desk' -%}
    <a href="{{ path('results_desk', {roundId: round_id}|merge(tool_query)) }}" class="btn {{ tool_button }}" data-round-tool="desk">
        <i class="bi bi-trophy me-1" aria-hidden="true"></i>{{ 'results_desk.tools.results'|trans }}
    </a>
{%- endif -%}
{%- if not is_online and current|default(null) != 'seating' -%}
    <a href="{{ path('round_seating', {roundId: round_id}|merge(tool_query)) }}" class="btn {{ tool_button }}" data-round-tool="seating">
        <i class="bi bi-123 me-1" aria-hidden="true"></i>{{ 'results_desk.tools.seating'|trans }}
        {%- if table_numbers_off|default(false) %} <span class="badge text-bg-light border ms-1" data-round-tool-not-used>{{ 'results_desk.tools.seating_not_used'|trans }}</span>{% endif -%}
    </a>
{%- endif -%}
{%- if competition_id|default(null) is not null -%}
    <a href="{{ path('participants_sheet', {competitionId: competition_id, tab: round_id}|merge(tool_query)) }}" class="btn {{ tool_button }}" data-round-tool="participants">
        <i class="bi bi-people me-1" aria-hidden="true"></i>{{ 'participants_sheet.title'|trans }}
    </a>
{%- endif -%}
{%- if with_stopwatch|default(false) -%}
    <a href="{{ path('manage_round_stopwatch', {roundId: round_id}) }}" class="btn {{ tool_button }}" data-round-tool="stopwatch">
        <i class="bi bi-stopwatch me-1" aria-hidden="true"></i>{{ 'competition.stopwatch.title'|trans }}
    </a>
{%- endif -%}
{#- A round that uses online timing (docs/features/online-competitions/): its settings and the event's personal links -
    only to a viewer who may set it up; asked only for online events, nothing for any other round (online_round_tools) -#}
{%- if is_online -%}
    {%- set online_tools = online_round_tools(round_id) -%}
    {%- if online_tools is not null -%}
        <a href="{{ path('online_round_settings', {roundId: round_id}|merge(tool_query)) }}" class="btn {{ tool_button }}" data-round-tool="online">
            <i class="bi bi-broadcast me-1" aria-hidden="true"></i>{{ 'online_rounds.menu.online_timing'|trans }}
        </a>
        <a href="{{ path('online_links', {competitionId: online_tools.competitionId}|merge(tool_query)) }}" class="btn {{ tool_button }}" data-round-tool="online-links">
            <i class="bi bi-link-45deg me-1" aria-hidden="true"></i>{{ 'online_rounds.menu.personal_links'|trans }}
        </a>
        {#- The round's control room and its review (stream C2) -#}
        <a href="{{ path('online_control_room', {roundId: round_id}|merge(tool_query)) }}" class="btn {{ tool_button }}" data-round-tool="online-control">
            <i class="bi bi-broadcast-pin me-1" aria-hidden="true"></i>{{ 'online_rounds.control.title'|trans }}
        </a>
        <a href="{{ path('online_review', {roundId: round_id}|merge(tool_query)) }}" class="btn {{ tool_button }}" data-round-tool="online-review">
            <i class="bi bi-check2-square me-1" aria-hidden="true"></i>{{ 'online_rounds.review.title'|trans }}
        </a>
    {%- endif -%}
{%- endif -%}
