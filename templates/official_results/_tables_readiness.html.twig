{# "Tables: 180 / 200 assigned" - the recommendation to seat every entry before an in-person round starts
   (official-results spec §5b; OfficialResultsRound::showsTablesReadiness() decides when it shows). A recommendation,
   never a block. Expects: results_round (OfficialResultsRound or null), is_online, now; optional: with_hint (true), wrapper_class #}
{%- if results_round is not null and results_round.showsTablesReadiness(is_online, now) -%}
    {%- set seated = results_round.overview.entriesWithTableNumber -%}
    {%- set total = results_round.overview.entriesTotal -%}
    <div class="small {{ wrapper_class|default('') }} {{ seated >= total ? 'text-success' : 'text-warning-emphasis' }}" data-tables-readiness data-seated="{{ seated }}" data-total="{{ total }}">
        <i class="bi {{ seated >= total ? 'bi-check-circle' : 'bi-exclamation-circle' }} me-1" aria-hidden="true"></i>{{ 'results_desk.tables_readiness'|trans({'%seated%': seated, '%total%': total}) }}
        {%- if seated < total and (with_hint ?? true) %} <span class="text-body-secondary">&middot; {{ 'results_desk.tables_readiness_hint'|trans }}</span>{% endif -%}
    </div>
{%- endif -%}
