{# People put into the round who wait on the event's waitlist are no entries of the results tools until the organiser
   gives them a spot (CompetitionParticipantGoing, GetRoundResultsOverview::peopleOnWaitlist) - the desk and the seating
   page say how many and link the People tab of the participants sheet filtered to the waitlist (`?filter=waitlist`).
   Expects: overview (RoundResultsOverview), competition_id #}
{% if overview.peopleOnWaitlist > 0 %}
    <p class="small text-body-secondary mb-2" data-round-waitlist-note>
        <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>{{ 'official_results.waitlist_note.text'|trans({'%count%': overview.peopleOnWaitlist}) }}
        <a href="{{ path('participants_sheet', {competitionId: competition_id, tab: 'people', filter: 'waitlist'}) }}" class="text-nowrap">{{ 'official_results.waitlist_note.link'|trans }}</a>
    </p>
{% endif %}
