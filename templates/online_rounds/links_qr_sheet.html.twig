<!DOCTYPE html>
{#
    The personal links as a printable sheet (docs/features/online-competitions/README.md §5.4, stream C1, route
    online_links_qr_sheet): one card per participant who is going - name, the QR to scan with the phone they compete on,
    the short link to type - all of them, or one participant's (`?participant=`, the links page's "QR code" of a row).
    Standalone like the name tags (live_results/name_tags.html.twig): its controls a <header>, the cards the <main>.
    Variables: competition, cards (list of {row: OnlineLinkRow, short_url, qr})
#}
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ 'online_rounds.links.qr_sheet.title'|trans }} - {{ competition.name }}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, Helvetica, sans-serif; color: #111; padding: 16px; font-size: 14px; }
        .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-bottom: 12px; }
        .controls a, .controls button { color: #333; }
        .controls button { min-height: 36px; padding: 4px 10px; font-size: 14px; font-weight: bold; }
        .page-title { margin-bottom: 8px; font-size: 18px; }
        .page-title span { font-weight: normal; color: #555; }
        .hint { max-width: 180mm; margin-bottom: 16px; color: #555; font-size: 13px; line-height: 1.4; }
        .sheet { display: grid; grid-template-columns: repeat(2, 90mm); grid-auto-rows: 62mm; }
        .card { display: flex; gap: 4mm; padding: 4mm 4mm 4mm 5mm; border: 1px dashed #bbb; overflow: hidden; break-inside: avoid; page-break-inside: avoid; }
        .card-text { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
        .card-event { font-size: 8pt; color: #666; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .card-name { margin-top: 2mm; font-size: 17pt; font-weight: bold; line-height: 1.12; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
        .card-name.long { font-size: 13pt; }
        .card-scan { margin-top: 2mm; font-size: 9pt; color: #444; }
        .card-link { margin-top: auto; font-family: "Courier New", Courier, monospace; font-size: 7.5pt; color: #222; overflow-wrap: anywhere; }
        .card-qr { flex: 0 0 34mm; align-self: center; }
        .card-qr svg { display: block; width: 34mm; height: 34mm; }
        .empty { color: #666; }

        /* A phone shows one card per row - the A4 sheet of two columns (180 mm) would widen the page */
        @media screen and (max-width: 720px) {
            .sheet { grid-template-columns: minmax(0, 90mm); }
        }

        @page { size: A4; margin: 10mm 15mm; }
        @media print {
            body { padding: 0; }
            .controls, .page-title, .hint { display: none; }
        }
    </style>
</head>
<body>
    <header class="controls">
        <a href="{{ path('online_links', {competitionId: competition.id}) }}">&larr; {{ 'online_rounds.links.qr_sheet.back'|trans }}</a>
        <button type="button" onclick="window.print()">{{ 'online_rounds.links.qr_sheet.print'|trans }}</button>
        <span data-online-qr-count>{{ 'online_rounds.links.qr_sheet.count'|trans({'%count%': cards|length}) }}</span>
    </header>

    <main>
        <h1 class="page-title">{{ 'online_rounds.links.qr_sheet.title'|trans }} <span>· {{ competition.name }}</span></h1>
        <p class="hint">{{ 'online_rounds.links.qr_sheet.hint'|trans }}</p>

        {% if cards is empty %}
            <p class="empty">{{ 'online_rounds.links.qr_sheet.empty'|trans }}</p>
        {% else %}
            <div class="sheet">
                {% for card in cards %}
                    <section class="card" data-online-qr-card="{{ card.row.participantId }}" aria-label="{{ card.row.name }}">
                        <div class="card-text">
                            <div class="card-event">{{ competition.name }}</div>
                            <div class="card-name{{ card.row.name|length > 24 ? ' long' }}">{{ card.row.name }}</div>
                            <div class="card-scan">{{ 'online_rounds.links.qr_sheet.scan'|trans }}</div>
                            <div class="card-link" data-online-qr-link>{{ card.short_url }}</div>
                        </div>
                        <div class="card-qr" role="img" aria-label="{{ 'online_rounds.links.qr_label'|trans({'%name%': card.row.name}) }}">{{ card.qr|raw }}</div>
                    </section>
                {% endfor %}
            </div>
        {% endif %}
    </main>
</body>
</html>
