{% extends 'base.html.twig' %}

{#
    A round's online timing (docs/features/online-competitions/, stream C1, route online_round_settings): on or off,
    the button turning it on, its settings, and whether the event's participants are entered in the round.
    Variables: competition, round (CompetitionRound), online_round (null = off), availability (OnlineTimingAvailability),
    setup (OnlineRoundSetup), form (null while off; its live video switches only while a media server is configured),
    enable_error (a translation key or null), page_url, csrf_token_id, enable_field, detection_locked (finish detection
    fixed from the round's start until a Reset - its field disabled, the reason under it), completeness_check (the
    check is on and the round uses online timing - the reference image card), reference_form (null while not),
    reference_preview_url (a short presigned GET of the uploaded reference image, null: none), finish_photos (the
    round's verified finish photos - "Check them again" from 1), back (the page's return / return_title)
#}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'online_rounds.settings.title'|trans }} - {{ round.name }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block page_stylesheets %}{{ encore_entry_link_tags('online_rounds') }}{% endblock %}

{% block content %}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events.title'|trans, url: path('events')},
        {label: competition.name, url: path('edit_competition', {competitionId: competition.id})},
        {label: 'competition.manage_rounds'|trans, url: path('manage_competition_rounds', {competitionId: competition.id})},
        {label: 'online_rounds.settings.title'|trans},
    ]}) }}
    {{ include('_return_back_button.html.twig', {fallbackUrl: path('manage_competition_rounds', {competitionId: competition.id}), fallbackTitle: 'competition.manage_rounds'|trans}) }}

    <div class="online-rounds-page pb-4" data-online-round-settings>
        <h1 class="h2">{{ 'online_rounds.settings.title'|trans }}</h1>
        <p class="h5 text-muted mb-1">{{ competition.name }} — {{ round.name }}</p>
        <p class="small text-muted">
            <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>{{ zoned_datetime(round.startsAt, round.displayTimezone, round.timezoneAssumed) }}
            <span class="mx-1">&middot;</span>
            <i class="bi bi-stopwatch me-1" aria-hidden="true"></i>{{ 'event_rounds.minutes'|trans({'%count%': round.minutesLimit}) }}
        </p>

        {% if not availability.isAvailable %}
            <div class="alert alert-secondary" role="note" data-online-timing-unavailable="{{ availability.value }}">
                {{ ('online_rounds.settings.unavailable.' ~ availability.value)|trans }}
                {% if availability.value == 'in_person_event' %}
                    <a href="{{ path('edit_competition', {competitionId: competition.id}) }}" class="alert-link">{{ 'online_rounds.settings.unavailable.edit_event'|trans }}</a>
                {% endif %}
            </div>
        {% elseif online_round is null %}
            <section class="card shadow-sm mb-4" data-online-timing-off aria-labelledby="online-timing-off-title">
                <div class="card-body">
                    <h2 class="h5" id="online-timing-off-title">{{ 'online_rounds.settings.off.title'|trans }}</h2>
                    <p class="online-rounds-prose">{{ 'online_rounds.settings.off.intro'|trans }}</p>

                    {% if enable_error is not null %}
                        <div class="alert alert-danger" role="alert" data-enable-error>{{ enable_error|trans }}</div>
                    {% endif %}

                    <form method="post" action="{{ page_url }}">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_id) }}">
                        <button type="submit" name="{{ enable_field }}" value="1" class="btn btn-primary">
                            <i class="bi bi-broadcast me-1" aria-hidden="true"></i>{{ 'online_rounds.settings.off.enable'|trans }}
                        </button>
                    </form>
                    <p class="small text-muted mt-2 mb-0">{{ 'online_rounds.settings.off.links_note'|trans }}</p>
                </div>
            </section>
        {% else %}
            <section class="card shadow-sm mb-4" data-online-timing-on aria-labelledby="online-timing-on-title">
                <div class="card-body">
                    <h2 class="h5" id="online-timing-on-title">
                        <span class="badge text-bg-success me-1">{{ 'online_rounds.settings.on.badge'|trans }}</span>
                        {{ 'online_rounds.settings.on.title'|trans }}
                    </h2>
                    <p class="small text-muted" data-online-timing-since>
                        {% set enabled_at = zoned_datetime(online_round.enabledAt, round.displayTimezone, round.timezoneAssumed) %}
                        {% if online_round.enabledBy is not null %}
                            {{ 'online_rounds.settings.on.since_by'|trans({'%date%': enabled_at, '%name%': online_round.enabledBy.name ?? ('#' ~ online_round.enabledBy.code|upper)}) }}
                        {% else %}
                            {{ 'online_rounds.settings.on.since'|trans({'%date%': enabled_at}) }}
                        {% endif %}
                    </p>

                    <div class="d-flex flex-wrap gap-2 mb-4" data-online-tools>
                        <a href="{{ path('online_links', {competitionId: competition.id}) }}" class="btn btn-sm btn-outline-primary" data-online-tool="links">
                            <i class="bi bi-link-45deg me-1" aria-hidden="true"></i>{{ 'online_rounds.menu.personal_links'|trans }}
                        </a>
                        <a href="{{ path('manage_round_stopwatch', {roundId: round.id}) }}" class="btn btn-sm btn-outline-primary" data-online-tool="stopwatch">
                            <i class="bi bi-stopwatch me-1" aria-hidden="true"></i>{{ 'competition.stopwatch.title'|trans }}
                        </a>
                        <a href="{{ path('online_control_room', {roundId: round.id}) }}" class="btn btn-sm btn-outline-primary" data-online-tool="control">
                            <i class="bi bi-broadcast-pin me-1" aria-hidden="true"></i>{{ 'online_rounds.control.title'|trans }}
                        </a>
                        <a href="{{ path('online_review', {roundId: round.id}) }}" class="btn btn-sm btn-outline-primary" data-online-tool="review">
                            <i class="bi bi-check2-square me-1" aria-hidden="true"></i>{{ 'online_rounds.review.title'|trans }}
                        </a>
                    </div>

                    {{ form_start(form, {action: page_url}) }}
                        <div class="online-rounds-settings">
                            {{ form_row(form.detectionMode) }}
                            {% if detection_locked %}
                                <p class="small text-body-secondary" data-detection-locked><i class="bi bi-lock me-1" aria-hidden="true"></i>{{ 'online_rounds.settings.detection.locked'|trans }}</p>
                            {% endif %}
                            {{ form_row(form.unfinishedMeasure) }}
                            {{ form_row(form.missingPieceRule) }}
                        </div>
                        {# Live video (contract phase-1b.md §2): only while a media server is configured #}
                        {% if form.videoEnabled is defined %}
                            <fieldset class="mb-4" data-online-video-settings>
                                <legend class="h6 mb-2">{{ 'online_rounds.settings.video.title'|trans }}</legend>
                                {{ form_row(form.videoEnabled) }}
                                {{ form_row(form.participantsSeeEachOther) }}
                            </fieldset>
                        {% endif %}
                        {# OnlineRoundSettingsLiveUpdates: a push after the save, the heartbeat's settings hash without it #}
                        <p class="small text-body-secondary" data-online-settings-live><i class="bi bi-phone me-1" aria-hidden="true"></i>{{ 'online_rounds.settings.live_note'|trans }}</p>
                        <button type="submit" class="btn btn-primary">{{ 'online_rounds.settings.save'|trans }}</button>
                    {{ form_end(form) }}
                </div>
            </section>

            {# The completeness check's reference image (README §5.8) - only while the check is on #}
            {% if completeness_check %}
                <section class="card shadow-sm mb-4" id="online-reference-image" data-online-reference-image aria-labelledby="online-reference-image-title">
                    <div class="card-body">
                        <h2 class="h5" id="online-reference-image-title">{{ 'online_rounds.settings.reference.title'|trans }}</h2>
                        <p class="online-rounds-prose">{{ 'online_rounds.settings.reference.intro'|trans }}</p>

                        {% if reference_preview_url is not null %}
                            <figure class="online-reference-preview mb-3" data-reference-preview>
                                <img src="{{ reference_preview_url }}" alt="{{ 'online_rounds.settings.reference.preview_alt'|trans({'%round%': round.name}) }}" class="img-fluid rounded border" loading="lazy" referrerpolicy="no-referrer">
                                <figcaption class="small text-muted mt-1">{{ 'online_rounds.settings.reference.in_use'|trans }}</figcaption>
                            </figure>
                            <form method="post" action="{{ path('online_round_reference_image_remove', {roundId: round.id}|merge(back)) }}" class="mb-4" data-reference-remove>
                                <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1" aria-hidden="true"></i>{{ 'online_rounds.settings.reference.remove'|trans }}
                                </button>
                            </form>
                        {% else %}
                            <p class="small text-muted" data-reference-catalogue>{{ 'online_rounds.settings.reference.catalogue'|trans }}</p>
                        {% endif %}

                        {{ form_start(reference_form, {action: page_url, attr: {'data-reference-upload': ''}}) }}
                            {{ form_row(reference_form.image) }}
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-upload me-1" aria-hidden="true"></i>{{ (reference_preview_url is null ? 'online_rounds.settings.reference.upload' : 'online_rounds.settings.reference.replace')|trans }}
                            </button>
                        {{ form_end(reference_form) }}

                        {# The verdicts made before the reference changed stay until the photos are checked again #}
                        {% if finish_photos > 0 %}
                            <div class="border-top mt-4 pt-3" data-reference-recheck>
                                <p class="small text-muted mb-2">{{ 'online_rounds.settings.reference.recheck_note'|trans({'%count%': finish_photos}) }}</p>
                                <form method="post" action="{{ path('online_round_recheck_finish_photos', {roundId: round.id}|merge(back)) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>{{ 'online_rounds.settings.reference.recheck'|trans }}
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </div>
                </section>
            {% endif %}
        {% endif %}

        {% if availability.isAvailable %}
            <section class="card shadow-sm mb-4" data-online-participants aria-labelledby="online-participants-title">
                <div class="card-body">
                    <h2 class="h5" id="online-participants-title">{{ 'online_rounds.settings.participants.title'|trans }}</h2>

                    {% if setup.going == 0 %}
                        <p class="mb-2">{{ 'online_rounds.settings.participants.none'|trans }}</p>
                        <a href="{{ path('participants_sheet', {competitionId: competition.id}) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-people me-1" aria-hidden="true"></i>{{ 'online_rounds.settings.participants.open_sheet'|trans }}
                        </a>
                    {% else %}
                        <p class="mb-2" data-online-entered>{{ 'online_rounds.settings.participants.entered'|trans({'%entered%': setup.entered, '%going%': setup.going}) }}</p>
                        {% if online_round is not null %}
                            <p class="small text-muted mb-2" data-online-with-link>{{ 'online_rounds.settings.participants.with_link'|trans({'%with_link%': setup.withLink, '%going%': setup.going}) }}</p>
                            {# Later registrants (docs/features/online-competitions/README.md §5.4) #}
                            <p class="small text-muted mb-2" data-online-later-links>{{ 'online_rounds.settings.participants.later_links'|trans }}</p>
                        {% endif %}

                        {% if setup.notEntered > 0 %}
                            {# The sheet's People tab, filtered to whoever is not in this round: tick them all, "Solo: in" #}
                            <div class="alert alert-warning mb-0" role="note" data-online-not-entered="{{ setup.notEntered }}">
                                <p class="mb-2">{{ 'online_rounds.settings.participants.not_entered'|trans({'%count%': setup.notEntered}) }}</p>
                                <a href="{{ path('participants_sheet', {competitionId: competition.id, tab: 'people', filter: 'out:' ~ round.id}) }}" class="btn btn-sm btn-warning" data-enter-participants>
                                    <i class="bi bi-person-check me-1" aria-hidden="true"></i>{{ 'online_rounds.settings.participants.enter'|trans }}
                                </a>
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            </section>
        {% endif %}
    </div>
{% endblock %}
