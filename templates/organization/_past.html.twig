{#
    The organization page's past (owner: workstream A, docs/features/organizations/README.md): one archive line per past
    occurrence of its series and one-time events, with its Results tag, by year, newest year and line first - the series
    page's markup (series/_past.html.twig), so series_archive_controller.js (lazy, unchanged) shows the year chips, keeps
    the newest year open with its first PREVIEW lines and "Show all 2026 (14)". Without JavaScript every year shows under
    its own heading with all its lines.
    Variables: page (OrganizationPage)
#}
{% set preview = 5 %}
{% if page.pastYears is not empty %}
    <section class="ev-detail-section ev-org-past" aria-labelledby="org-past-title" data-org-past
             data-controller="series-archive" data-series-archive-preview-value="{{ preview }}">
        <h2 class="ev-detail-section-title" id="org-past-title">
            {{- 'organization_page.past'|trans }} <span class="ev-section-n">{{ page.pastCount }}</span>
        </h2>
        {% if page.pastYears|length > 1 %}
            <div class="ev-years ev-series-years" role="group" aria-label="{{ 'organization_page.years'|trans }}" data-series-archive-target="chips" hidden>
                {% for year in page.pastYears %}
                    <button type="button" class="ev-chip" data-year="{{ year.year }}" aria-controls="org-past-{{ year.year }}"
                            aria-pressed="{{ loop.first ? 'true' : 'false' }}"
                            data-series-archive-target="chip" data-action="series-archive#choose">
                        {{- year.year }} <span class="ev-chip-n">{{ year.lines|length }}</span>
                    </button>
                {% endfor %}
            </div>
        {% endif %}
        {% for year in page.pastYears %}
            <section class="ev-series-year" id="org-past-{{ year.year }}" data-year="{{ year.year }}" aria-labelledby="org-past-{{ year.year }}-title" data-series-archive-target="year">
                <h3 class="ev-month-header" id="org-past-{{ year.year }}-title" data-series-archive-target="heading"><span>{{ year.year }}</span><span class="ev-month-n">{{ 'events_page.agenda.dates_count'|trans({'%count%': year.lines|length}) }}</span></h3>
                <ol class="ev-lines">
                    {% for line in year.lines %}{{ include('event_parts/_archive_line.html.twig', {line: line, template: false, with_year: false}) }}{% endfor %}
                </ol>
                {% if year.lines|length > preview %}
                    <button type="button" class="ev-more ev-series-show-all" hidden data-series-archive-target="more" data-action="series-archive#showAll">
                        {{- 'events_page.archive.show_all'|trans({'%year%': year.year, '%count%': year.lines|length}) -}}
                    </button>
                {% endif %}
            </section>
        {% endfor %}
    </section>
{% endif %}
