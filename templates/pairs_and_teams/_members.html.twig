{# Members of a pair/team, each the way this viewer may see them - the unclaimed people of an imported event result as "+N" #}
{%- for member in members|filter(m => not m.anonymous) -%}
    {%- if not loop.first %}, {% endif -%}
    {%- if member.isPrivate and (logged_user.profile is null or member.playerId != logged_user.profile.playerId) -%}
        <span class="text-muted">{{ 'secret_puzzler_name'|trans }}</span> <i class="bi bi-incognito text-muted"></i>
    {%- elseif member.playerId is not null -%}
        {#- `linked|default(true)` would turn an explicit false into true -#}
        {%- if linked is not defined or linked -%}
            <a href="{{ path('player_profile', {playerId: member.playerId}|merge(profile_filter|default({}))) }}">{{ member.playerName ?? ('#' ~ member.playerCode) }}</a>
        {%- else -%}
            {{ member.playerName ?? ('#' ~ member.playerCode) }}
        {%- endif -%}
        {%- if member.playerCountry is not null %} <small class="shadow-custom fi fi-{{ member.playerCountry.name }}"></small>{% endif -%}
    {%- else -%}
        {{ member.guestName }}
    {%- endif -%}
{%- endfor -%}
{%- set anonymous_count = members|filter(m => m.anonymous)|length -%}
{%- if anonymous_count > 0 and anonymous_count < members|length %}, +{{ anonymous_count }}{% endif -%}
