{#
    The participants spreadsheet of an event (docs/features/competitions-management/participants-spreadsheet.md):
    full screen - no site header and footer, a slim sticky bar of its own - for the event's organisers.
    Twig renders the frame; the `participants-sheet` Stimulus controller renders the tabs, the save status, undo/redo and
    the grid from the state embedded below (the JSON the state endpoint answers) and saves through the sheet's endpoints.

    Targets: tabs, status, undo, redo, main (the controller's), checklist (the setup checklist - shown while the event
    has no rounds or nobody on its list), help (the Help button - the controller opens its keyboard shortcuts dialog).
    Values: urls, csrf-token, locale, countries, texts-core, texts-round, texts-people (JSON objects of the streams'
    partials), tab (the initial tab: "people" or a round id).
#}
{% extends 'base.html.twig' %}

{% set hide_comparison_launcher = true %}
{% set competition = state.competition %}
{% set active_people = state.activePeopleCount() %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block title %}{{ 'participants_sheet.title'|trans }} - {{ competition.name }}{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block full_content %}
    <div class="participants-sheet"
         data-controller="participants-sheet"
         data-participants-sheet-urls-value="{{ urls|json_encode|e('html_attr') }}"
         data-participants-sheet-csrf-token-value="{{ csrf_token(csrf_token_id) }}"
         data-participants-sheet-locale-value="{{ app.request.locale }}"
         data-participants-sheet-countries-value="{{ countries|json_encode|e('html_attr') }}"
         data-participants-sheet-texts-core-value="{{ include('participants_sheet/_texts_core.html.twig')|e('html_attr') }}"
         data-participants-sheet-texts-round-value="{{ include('participants_sheet/_texts_round.html.twig')|e('html_attr') }}"
         data-participants-sheet-texts-people-value="{{ include('participants_sheet/_texts_people.html.twig')|e('html_attr') }}"
         data-participants-sheet-tab-value="{{ tab }}">

        <div class="participants-sheet-bar">
            <div class="participants-sheet-bar__row">
                {# Back where the organiser came from (a validated `?return=`, the controller's back_url), else the event #}
                <a href="{{ back_url }}" class="btn btn-sm btn-link participants-sheet-bar__back" aria-label="{{ back_title is not null ? 'back_to'|trans ~ ' ' ~ back_title : 'participants_sheet.page.back_label'|trans }}" data-participants-sheet-back>
                    <i class="bi bi-arrow-left" aria-hidden="true"></i><span class="participants-sheet-bar__label">{{ back_title ?? 'participants_sheet.page.back'|trans }}</span>
                </a>

                <h1 class="participants-sheet-bar__title">
                    <span class="participants-sheet-bar__event">{{ competition.name }}</span>
                    <span class="participants-sheet-bar__subtitle">{{ 'participants_sheet.title'|trans }}</span>
                </h1>

                {# Status and buttons: on the title's line on a wide screen, a line of their own on a phone #}
                <div class="participants-sheet-bar__actions">
                    <div class="participants-sheet-bar__status" data-participants-sheet-target="status"></div>

                    <div class="btn-group participants-sheet-bar__history" role="group" aria-label="{{ 'participants_sheet.page.history'|trans }}">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-participants-sheet-target="undo" disabled
                                aria-label="{{ 'participants_sheet.page.undo'|trans }}" title="{{ 'participants_sheet.page.undo_shortcut'|trans }}">
                            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-participants-sheet-target="redo" disabled
                                aria-label="{{ 'participants_sheet.page.redo'|trans }}" title="{{ 'participants_sheet.page.redo_shortcut'|trans }}">
                            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                        </button>
                    </div>

                    {{ include('participants_sheet/_tools_menu.html.twig') }}

                    <button type="button" class="btn btn-sm btn-outline-secondary participants-sheet-bar__help" data-participants-sheet-target="help"
                            aria-label="{{ 'participants_sheet.page.help'|trans }}" title="{{ 'participants_sheet.page.help'|trans }}">
                        <i class="bi bi-question-circle" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <nav class="participants-sheet-bar__tabs" aria-label="{{ 'participants_sheet.page.tabs'|trans }}" data-participants-sheet-target="tabs"></nav>
        </div>

        {% if state.rounds is empty or active_people == 0 %}
            {{ include('participants_sheet/_setup_checklist.html.twig') }}
        {% endif %}

        <div class="participants-sheet__main" data-participants-sheet-target="main">
            <noscript>
                <div class="alert alert-warning m-3" data-participants-sheet-no-js>{{ 'participants_sheet.page.needs_javascript'|trans }}</div>
            </noscript>
            <p class="participants-sheet__loading" aria-hidden="true">
                <span class="spinner-border spinner-border-sm me-2" role="presentation"></span>{{ 'participants_sheet.page.loading'|trans }}
            </p>
        </div>

        {{ include('participants_sheet/_import_dialog.html.twig') }}

        {# The state the state endpoint answers - the first paint needs no request. Escaped for a script tag
           (JSON_HEX_TAG and friends): nothing typed into a name can end it #}
        <script type="application/json" id="participants-sheet-state">{{ state_json|raw }}</script>
    </div>
{% endblock %}
