{% extends '_auth_layout.html.twig' %}

{% block title %}{{ 'auth.password_reset.title'|trans }}{% endblock %}

{# docs/features/auth-ux-redesign.md §4.6. Saving signs the browser in. #}

{% block auth_content %}
    <h1 class="auth-title">{{ 'auth.password_reset.title'|trans }}</h1>
    <p class="auth-lead">{{ 'auth.password_reset.intro'|trans }}</p>

    {{ form_start(form) }}
        {# The account's address as the username of this form: without it a
           password manager has nothing to file the new password under #}
        <input type="email" name="username" value="{{ account_email }}" autocomplete="username" readonly hidden>

        <div class="mb-3">
            {{ form_label(form.plainPassword) }}
            <div class="password-field">
                {{ form_widget(form.plainPassword) }}
                {{ include('_password_toggle.html.twig', {input_id: form.plainPassword.vars.id}) }}
            </div>
            {{ form_help(form.plainPassword) }}
            {{ form_errors(form.plainPassword) }}
        </div>

        <button type="submit" class="btn btn-primary w-100" data-turbo-submits-with="{{ 'auth.password_reset.submitting'|trans }}">
            {{ 'auth.password_reset.submit'|trans }}
        </button>
    {{ form_end(form) }}
{% endblock %}
