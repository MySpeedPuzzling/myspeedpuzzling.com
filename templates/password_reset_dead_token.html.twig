{% extends '_auth_layout.html.twig' %}

{% block title %}{{ headline }}{% endblock %}

{% block auth_content %}
    {{ include('_auth_back_link.html.twig') }}

    <h1 class="auth-title">{{ headline }}</h1>
    <p class="auth-lead">{{ message }}</p>

    <a class="btn btn-primary w-100" href="{{ path('request_password_reset') }}">
        {{ 'auth.password_reset.request_new'|trans }}
    </a>
{% endblock %}
