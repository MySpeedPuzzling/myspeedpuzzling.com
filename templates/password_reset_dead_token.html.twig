{% extends 'base.html.twig' %}

{% block title %}{{ headline }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <div class="row gy-3 pb-4">
        <div class="col-lg-6 col-md-8">
            <h1 class="h2">{{ headline }}</h1>

            <div class="alert alert-warning" role="alert">
                <i class="ci-close-circle me-2"></i>
                {{ message }}
            </div>

            <p>
                <a class="btn btn-primary" href="{{ path('request_password_reset') }}">
                    {{ 'auth.password_reset.request_submit'|trans }}
                </a>
            </p>

            <p class="fs-sm">
                <a href="{{ path('login') }}">{{ 'auth.sign_in_link.back_to_login'|trans }}</a>
            </p>
        </div>

        <div class="col-lg-5 offset-lg-1 col-md-4 text-center d-none d-md-block">
            <img class="img-fluid" src="{{ asset('img/puzzlie-1.png') }}" alt="" width="1000" height="949">
        </div>
    </div>
{% endblock %}
