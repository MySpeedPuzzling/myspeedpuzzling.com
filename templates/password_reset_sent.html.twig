{% extends '_auth_layout.html.twig' %}

{% block title %}{{ 'auth.check_email.title'|trans }}{% endblock %}

{% block auth_content %}
    {% embed '_auth_check_email.html.twig' with {
        sent_to: 'auth.check_email.reset_sent_to'|trans,
        resent_message: 'auth.check_email.resent'|trans,
        change_href: path('request_password_reset'),
        resend_action: path('request_password_reset'),
        resend_csrf_id: constant('SpeedPuzzling\\Web\\Controller\\RequestPasswordResetController::CSRF_TOKEN_ID'),
        resend_label: 'auth.check_email.resend_link'|trans,
    } %}
        {% block next_step %}
            <p class="mb-0">{{ 'auth.check_email.reset_next_step'|trans({'%minutes%': expires_in_minutes}) }}</p>
        {% endblock %}
    {% endembed %}
{% endblock %}
