{% extends 'base.html.twig' %}

{% set is_own_profile = logged_user.profile is not null and logged_user.profile.playerId is same as player.playerId %}

{# Head metadata follows the player's OWN setting, never the viewer: an allowed friend sees the
   name on the page, but their browser must not emit an indexable / unfurlable identity
   (player/_head_name.html.twig, shared with the Results page) #}
{% set is_private_in_head = player.isPrivateProfile and not is_own_profile %}
{% set player_head_name = include('player/_head_name.html.twig', {player: player})|trim %}

{% block title %}{{ 'player_profile.meta.title'|trans({'%name%': player_head_name}) }}{% endblock %}
{% block meta_description %}{{ 'player_profile.meta.description'|trans({'%name%': player_head_name}) }}{% endblock %}
{% block og_type %}profile{% endblock %}
{% block og_image %}{% if player.avatar is not null and not is_private_in_head %}{{ absolute_url(player.avatar|thumbnail('puzzle_medium')) }}{% else %}{{ parent() }}{% endif %}{% endblock %}
{% block robots %}{% if is_private_in_head %}<meta name="robots" content="noindex, nofollow">{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block json_ld %}
    {{ parent() }}
    {% if not player.isPrivateProfile %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "mainEntity": {
            "@type": "Person",
            "name": {{ (player.playerName ?? ('#' ~ player.code|upper))|json_ld }},
            "identifier": {{ player.code|upper|json_ld }},
            {% if player.avatar is not null %}
            "image": {{ absolute_url(player.avatar|thumbnail('puzzle_medium'))|json_ld }},
            {% endif %}
            "url": {{ url('player_profile', {playerId: player.playerId})|json_ld }}
        }
    }
    </script>
    {% endif %}
{% endblock %}

{% block content %}
    {{ include('_return_back_button.html.twig') }}
    {# The header's player name is the page's H1 #}
    <twig:PlayerHeader player="{{ player }}" tab="overview" :heading="true" />

    {% if overview is null %}
        {# A private profile hidden from this viewer: the header and this notice, nothing else #}
        <div class="alert alert-secondary d-flex align-items-start gap-3 p-3 rounded-3 shadow-sm">
            <i class="bi bi-incognito fs-2 text-muted flex-shrink-0"></i>
            <div class="small lh-sm">
                <p class="mb-1">
                    <strong>{{ 'secret_puzzler_name'|trans }}!</strong> {{ 'profile.private_profile_info_1'|trans }}
                </p>
                <p class="mb-0">
                    {{ 'profile.private_profile_info_2'|trans }}
                </p>
            </div>
        </div>
    {% else %}
        {# The Overview (docs/features/navigation README §4.7, PROF-03): the bests first, the owner's own cards right
           below them (PROF-01 - not an owner panel), the numbers, the latest results, achievements and About. Every
           result is on Results, the charts and the skill/rating cards on Statistics (PROF-04) #}
        {{ include('player/overview/_personal_bests.html.twig') }}

        {{ include('review_results/_banner.html.twig', {review_counts: review_counts}) }}

        {% if getting_started is not null %}
            <div class="mb-3">
                {{ include('onboarding/_getting_started_card.html.twig', {progress: getting_started, folded: false}) }}
            </div>
        {% elseif is_own_profile %}
            {# "Add your country" while the player has none - a newcomer's checklist asks for it already (docs/features/players-page/README.md) #}
            <twig:Players:CountryNudge class="mb-3" />
        {% endif %}

        {{ include('player/overview/_numbers.html.twig') }}

        <section class="pov-section" data-testid="latest-results" aria-labelledby="latest-results-title">
            <div class="pov-head">
                <h2 class="pov-title" id="latest-results-title">{{ 'player_overview.latest_results'|trans }}</h2>
            </div>

            {% set latest_results = constant('SpeedPuzzling\\Web\\Value\\PlayerOverview::LATEST_RESULTS') %}
            {% if overview.totalResults > 0 %}
                <twig:RecentActivity :playerId="player.playerId" :limit="latest_results" :isOnProfile="true" />

                {# Everything else is on Results - "Every result", newest first (PROF-05a) #}
                {% if overview.totalResults > latest_results %}
                    <p class="pov-more">
                        <a href="{{ path('player_results', {playerId: player.playerId, view: 'every'}) }}" data-testid="all-results">
                            {{- 'player_overview.all_results'|trans({'%count%': overview.totalResults}) -}}
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </p>
                {% endif %}
            {% else %}
                <p class="pov-empty">{{ 'player_results.no_results'|trans }}</p>
            {% endif %}
        </section>

        {# The member's achievements, best first (the owner's free-account line otherwise) #}
        <twig:AchievementsShowcase :player="player" class="mb-3" />

        {{ include('player/overview/_about.html.twig') }}
    {% endif %}
{% endblock %}
