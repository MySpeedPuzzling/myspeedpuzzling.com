{% extends 'base.html.twig' %}

{#
    A player's Results (docs/features/navigation README §4.7, PROF-05a): the player header, the search and the filters
    (a GET form), and the list region - a Turbo Frame the page's script can reload on its own (PROF-05c). Everything is
    rendered from the URL (PlayerResultsCriteria) by PlayerResultsController; PROF-02 adds the Results tab, PROF-07 the
    indexing rules (until then noindex).
#}

{% set is_own_profile = logged_user.profile is not null and logged_user.profile.playerId is same as player.playerId %}
{# Head metadata follows the player's OWN setting, never the viewer: an allowed friend sees the name on the page, but
   their browser must not emit an identity for a private profile (as on the profile page) #}
{% set is_private_in_head = player.isPrivateProfile and not is_own_profile %}
{% set player_head_name = is_private_in_head
    ? ('secret_puzzler_name'|trans ~ ' #' ~ player.code|upper)
    : (player.playerName ?? ('#' ~ player.code|upper))
%}

{% block title %}{{ 'player_results.meta.title'|trans({'%name%': player_head_name}) }}{% endblock %}
{% block meta_description %}{{ 'player_results.meta.description'|trans({'%name%': player_head_name}) }}{% endblock %}
{% block robots %}<meta name="robots" content="{{ is_private_in_head ? 'noindex, nofollow' : 'noindex, follow' }}">{% endblock %}

{% block content %}
    {{ include('_return_back_button.html.twig') }}
    {# The header's player name is the page's H1 #}
    <twig:PlayerHeader player="{{ player }}" :heading="true" />

    <div class="player-results mt-3" data-player-results>
        {{ include('player/results/_filters.html.twig') }}
        {{ include('player/results/_frame.html.twig') }}
    </div>
{% endblock %}
