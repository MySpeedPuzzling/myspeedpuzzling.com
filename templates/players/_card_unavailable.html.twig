{#
    The answer (404) inside the player-card frame for a player the viewer may not see - blocked, private or deleted
    read the same, so it never tells which.
#}
<turbo-frame id="player-card">
    <article class="players-card players-card-unavailable">
        <button type="button" class="btn-close players-card-close" data-players-card-close aria-label="{{ 'players.card.close'|trans }}"></button>
        <p class="mb-0">{{ 'players.card.unavailable'|trans }}</p>
    </article>
</turbo-frame>
