{# The signed-in player's own favorites, kept from the old page #}
{% if favorite_players is not null and favorite_players is not empty %}
    <section class="players-section players-favorites" aria-labelledby="players-favorites-title">
        <h2 class="players-section-title" id="players-favorites-title">{{ 'puzzlers.my_favorites'|trans }}</h2>

        <div class="players-favorites-list">
            {% for favorite_player in favorite_players %}
                {# A followed private player comes without name, country and avatar (GetFavoritePlayers) #}
                {{ include('_player_list_item.html.twig', {player: favorite_player.playerName is null ? {
                    playerId: favorite_player.playerId,
                    playerName: 'secret_puzzler_name'|trans,
                    playerCode: favorite_player.playerCode,
                    playerCountry: null,
                    playerAvatar: null,
                } : favorite_player}) }}
            {% endfor %}
        </div>
    </section>
{% endif %}
