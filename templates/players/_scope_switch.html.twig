{#
    World | <home country> | another country (docs/features/players-page/README.md). The page always opens on the
    world. Signed-in players get their profile country as the home chip; guests get a guess from the browser's
    languages, filled in by players_scope_guess_controller.js (guest HTML is shared-cached, so the server never varies
    it by Accept-Language).

    Inputs: scope (CommunityScope), home_country (null|CountryCode), scope_countries (list<CountryCode>, by name)
#}
{% set country_names = {} %}
{% for country in scope_countries %}
    {% set country_names = country_names|merge({(country.name): country.value}) %}
{% endfor %}
<nav class="players-scope"
     aria-label="{{ 'players.scope.label'|trans }}"
     data-controller="players-scope-guess"
     data-players-scope-guess-countries-value="{{ country_names|json_encode }}"
     data-players-scope-guess-skip-value="{{ home_country is not null ? 'true' : 'false' }}"
     data-players-scope-guess-current-value="{{ scope.key }}"
     data-players-scope-guess-url-value="{{ path('players') }}"
>
    <div class="players-scope-switch">
        <a href="{{ path('players') }}" class="players-scope-option{{ scope.isWorld ? ' is-active' }}"{% if scope.isWorld %} aria-current="page"{% endif %}>
            <i class="bi bi-globe2" aria-hidden="true"></i>{{ 'players.scope.world'|trans }}
        </a>
        {% if home_country is not null %}
            <a href="{{ path('players', {scope: home_country.name}) }}" class="players-scope-option{{ scope.country == home_country ? ' is-active' }}"{% if scope.country == home_country %} aria-current="page"{% endif %}>
                <i class="shadow-custom fi fi-{{ home_country.name }}" aria-hidden="true"></i>{{ home_country.value }}
            </a>
        {% endif %}
        {% if scope.country is not null and scope.country != home_country %}
            <a href="{{ path('players', {scope: scope.country.name}) }}" class="players-scope-option is-active" aria-current="page">
                <i class="shadow-custom fi fi-{{ scope.country.name }}" aria-hidden="true"></i>{{ scope.country.value }}
            </a>
        {% endif %}
        <a href="#" class="players-scope-option" hidden data-players-scope-guess-target="chip">
            <i class="shadow-custom fi" aria-hidden="true" data-players-scope-guess-target="flag"></i><span data-players-scope-guess-target="name"></span>
        </a>
    </div>

    <form method="get" action="{{ path('players') }}" class="players-scope-other">
        <label class="visually-hidden" for="players-scope-select">{{ 'players.scope.another'|trans }}</label>
        <select id="players-scope-select" name="scope" class="form-select form-select-sm" data-action="players-scope-guess#pick">
            <option value="">{{ 'players.scope.another'|trans }}</option>
            {% for country in scope_countries %}
                <option value="{{ country.name }}"{% if scope.country == country %} selected{% endif %}>{{ country.value }}</option>
            {% endfor %}
        </select>
        <noscript><button type="submit" class="btn btn-sm btn-outline-primary">{{ 'players.scope.show'|trans }}</button></noscript>
    </form>
</nav>
