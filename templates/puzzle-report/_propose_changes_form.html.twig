{#
    Propose puzzle changes form - used in both modal and full page. A field another pending proposal changes is shown
    locked with what waits for review (locks: PendingProposalLocks, puzzle-report/_locked_field.html.twig); the names
    are never locked.
#}
{% set in_modal = in_modal|default(false) %}
{% set locks = locks|default(null) %}
{% set locked_common = {puzzle_id: puzzle_id, in_modal: in_modal} %}

{{ form_start(propose_form, {
    'action': path('puzzle_suggest_change', {puzzleId: puzzle_id}),
    'attr': {
        'data-turbo': 'true',
        'data-turbo-frame': in_modal ? 'modal-frame' : '_top',
        'enctype': 'multipart/form-data'
    }
}) }}

    <p class="text-muted small mb-3">
        {{ 'puzzle_report.propose_changes.description'|trans }}
    </p>

    {{ form_errors(propose_form) }}

    <div class="mb-3">
        {{ include('puzzle/_names_editor.html.twig', {names: propose_form.names}) }}
    </div>

    {% if locks is not null and locks.fieldLocked('manufacturer') %}
        {% set waiting = locks.waitingForField('manufacturer') %}
        {{ include('puzzle-report/_locked_field.html.twig', locked_common|merge({
            label: 'puzzle_report.form.brand'|trans,
            current: puzzle.manufacturerName,
            waiting: waiting,
            waiting_shown: waiting.proposedValue ?? '',
            hidden_inputs: [{name: propose_form.brand.vars.full_name, value: puzzle.manufacturerId}],
        }), with_context = false) }}
        {% do propose_form.brand.setRendered %}
    {% else %}
        {# A brand not in the list - a misspelled one's right name - can be typed: it becomes a new brand #}
        <div data-controller="brand-picker" data-brand-picker-add-new-brand-message-value="{{ 'forms.add_new_brand'|trans }}">
            {{ form_row(propose_form.brand) }}
        </div>
    {% endif %}

    {% if locks is not null and locks.fieldLocked('piecesCount') %}
        {% set waiting = locks.waitingForField('piecesCount') %}
        {{ include('puzzle-report/_locked_field.html.twig', locked_common|merge({
            label: 'puzzle_report.form.pieces_count'|trans,
            current: puzzle.piecesCount,
            waiting: waiting,
            waiting_shown: waiting.proposedValue ?? '',
            hidden_inputs: [{name: propose_form.piecesCount.vars.full_name, value: puzzle.piecesCount}],
        }), with_context = false) }}
        {% do propose_form.piecesCount.setRendered %}
    {% else %}
        {{ form_row(propose_form.piecesCount) }}
    {% endif %}

    {% if locks is not null and locks.fieldLocked('ean') %}
        {% set waiting = locks.waitingForField('ean') %}
        {% set hidden_inputs = [] %}
        {% for code in puzzle_eans(puzzle.puzzleEan) %}
            {% set hidden_inputs = hidden_inputs|merge([{name: propose_form.eans.vars.full_name ~ '[' ~ loop.index0 ~ ']', value: code}]) %}
        {% endfor %}
        {% set proposed_codes = waiting is not null ? puzzle_eans(waiting.proposedValue) : [] %}
        {# The EAN and "the box has no barcode" lock together (PuzzleProposalField::lockedTogether()) #}
        {{ include('puzzle-report/_locked_field.html.twig', locked_common|merge({
            label: 'puzzle_report.form.ean'|trans,
            current: puzzle.puzzleEanAbsent ? 'puzzle_report.form.ean_absent_confirmed'|trans : puzzle_eans(puzzle.puzzleEan)|join(', '),
            waiting: waiting,
            waiting_shown: locks.waitingForEanAbsent() ? 'puzzle_report.locked.ean_absent'|trans : (proposed_codes is not empty ? proposed_codes|join(', ') : 'puzzle_report.locked.no_codes'|trans),
            hidden_inputs: hidden_inputs,
        }), with_context = false) }}
        {% do propose_form.eans.setRendered %}
        {% do propose_form.eanAbsent.setRendered %}
    {% else %}
    {# "The box has no barcode (EAN)" - only while the puzzle has none and is not confirmed so: ticked, the EAN inputs are
       hidden and disabled, so nothing is sent with it (ean_absent_controller.js) #}
    {% set offers_ean_absent = puzzle.puzzleEan is empty and not puzzle.puzzleEanAbsent %}
    <div {% if offers_ean_absent %}data-controller="ean-absent"{% endif %}>
    {# The scan button next to the first EAN input: a scanned code is added to the list (ean_scan_fill_controller.js) #}
    <div data-controller="barcode-scanner ean-scan-fill"
         {% if offers_ean_absent %}data-ean-absent-target="codes"{% endif %}
         data-action="barcode-scanner:scanned->ean-scan-fill#fill hide.bs.tab@document->barcode-scanner#stopScanning">
        {% set first_ean = propose_form.eans.children|first %}
        {% set first_ean_input %}
            <div class="input-group has-validation">
                {{ form_widget(first_ean) }}
                <button type="button" class="btn btn-outline-secondary"
                        data-barcode-scanner-target="toggleButton"
                        data-action="click->barcode-scanner#toggle"
                        title="{{ 'scan.title'|trans }}"
                        aria-label="{{ 'accessibility.barcode_scanner'|trans }}">
                    <i class="bi-upc-scan" aria-hidden="true"></i>
                </button>
            </div>
        {% endset %}

        {{ include('puzzle/_code_inputs.html.twig', {
            field: propose_form.eans,
            label: 'puzzle_report.form.ean'|trans,
            help: 'puzzle_report.form.ean_help'|trans,
            first_input: first_ean_input,
            wrapper_attr: {'data-ean-scan-fill-target': 'codes'},
        }, with_context = false) }}

        {{ include('_barcode_scanner_panel.html.twig') }}
    </div>
    {% if offers_ean_absent %}
        <div class="mb-3">
            {{ form_row(propose_form.eanAbsent, {attr: {
                'data-ean-absent-target': 'checkbox',
                'data-action': 'ean-absent#toggle',
            }}) }}
        </div>
    {% else %}
        {% if puzzle.puzzleEanAbsent %}
            <p class="form-text mt-n2 mb-3">
                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>{{ 'puzzle_report.form.ean_absent_confirmed_help'|trans }}
            </p>
        {% endif %}
        {% do propose_form.eanAbsent.setRendered %}
    {% endif %}
    </div>
    {% endif %}

    {% if locks is not null and locks.fieldLocked('identificationNumber') %}
        {% set waiting = locks.waitingForField('identificationNumber') %}
        {% set hidden_inputs = [] %}
        {% for code in puzzle_brand_codes(puzzle.puzzleIdentificationNumber) %}
            {% set hidden_inputs = hidden_inputs|merge([{name: propose_form.brandCodes.vars.full_name ~ '[' ~ loop.index0 ~ ']', value: code}]) %}
        {% endfor %}
        {% set proposed_codes = waiting is not null ? puzzle_brand_codes(waiting.proposedValue) : [] %}
        {{ include('puzzle-report/_locked_field.html.twig', locked_common|merge({
            label: 'puzzle_report.form.identification_number'|trans,
            current: puzzle_brand_codes(puzzle.puzzleIdentificationNumber)|join(', '),
            waiting: waiting,
            waiting_shown: proposed_codes is not empty ? proposed_codes|join(', ') : 'puzzle_report.locked.no_codes'|trans,
            hidden_inputs: hidden_inputs,
        }), with_context = false) }}
        {% do propose_form.brandCodes.setRendered %}
    {% else %}
        {{ include('puzzle/_code_inputs.html.twig', {
            field: propose_form.brandCodes,
            label: 'puzzle_report.form.identification_number'|trans,
            help: 'puzzle_report.form.identification_number_help'|trans,
        }, with_context = false) }}
    {% endif %}

    {% if locks is not null and locks.fieldLocked('image') %}
        {% set waiting = locks.waitingForField('image') %}
        <div class="mb-3" data-locked-field>
            <div class="form-label">{{ 'puzzle_report.form.photo'|trans }}</div>
            <div class="form-text">
                <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>
                {% if waiting is not null %}
                    {{ 'puzzle_report.locked.waiting'|trans({'%value%': 'puzzle_report.locked.new_photo'|trans}) }}
                {% else %}
                    {{ 'puzzle_report.locked.merge_pending'|trans }}
                {% endif %}
                <a href="{{ path('puzzle_pending_proposals', {puzzleId: puzzle_id}) }}"
                   class="ms-1"
                   data-turbo-frame="{{ in_modal ? 'modal-frame' : '_top' }}">
                    {{- 'puzzle_report.locked.show_pending'|trans -}}
                </a>
            </div>
        </div>
        {% do propose_form.photo.setRendered %}
    {% else %}
    {# Photo upload with collapsible help #}
    <div class="mb-3">
        {{ form_label(propose_form.photo) }}
        {{ include('photo_stash/_photo_drop_area.html.twig', {
            field: propose_form.photo,
            stash_field: 'photo',
            kept_photo: (kept_photos|default({})).photo ?? null,
        }, with_context = false) }}

        <button type="button" class="btn btn-link btn-sm p-0 mt-1" data-bs-toggle="collapse" data-bs-target="#photoHelp">
            <i class="bi bi-question-circle me-1"></i>{{ 'puzzle_report.form.photo_help_toggle'|trans }}
        </button>

        <div class="collapse mt-2" id="photoHelp">
            <div class="card card-body bg-light small">
                <strong>{{ 'puzzle_report.form.photo_help_title'|trans }}</strong>
                <ul class="mb-0 mt-2">
                    <li>{{ 'puzzle_report.form.photo_help_1'|trans }}</li>
                    <li>{{ 'puzzle_report.form.photo_help_2'|trans }}</li>
                    <li>{{ 'puzzle_report.form.photo_help_3'|trans }}</li>
                    <li>{{ 'puzzle_report.form.photo_help_4'|trans }}</li>
                </ul>

                <div class="d-flex gap-2 mt-3">
                    <div class="position-relative">
                        <img src="{{ asset('img/example-image-not-ok.jpg') }}" alt="Wrong example" class="rounded" width="400" height="300" style="max-height: 80px;">
                        <span class="badge bg-danger position-absolute top-0 end-0 m-1">{{ 'puzzle_report.form.photo_example_wrong'|trans }}</span>
                    </div>
                    <div class="position-relative">
                        <img src="{{ asset('img/example-image-ok.jpg') }}" alt="OK example" class="rounded" width="400" height="325" style="max-height: 80px;">
                        <span class="badge bg-info position-absolute top-0 end-0 m-1">{{ 'puzzle_report.form.photo_example_ok'|trans }}</span>
                    </div>
                    <div class="position-relative">
                        <img src="{{ asset('img/example-image-perfect.jpg') }}" alt="Perfect example" class="rounded" width="400" height="294" style="max-height: 80px;">
                        <span class="badge bg-success position-absolute top-0 end-0 m-1">{{ 'puzzle_report.form.photo_example_perfect'|trans }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% endif %}

    {% if puzzle.puzzleImage is not null %}
        <div class="mb-3">
            <label class="form-label">{{ 'puzzle_report.form.current_image'|trans }}</label>
            <div>
                <img src="{{ puzzle.puzzleImage|puzzle_image('puzzle_small') }}"
                     alt="{{ puzzle.puzzleName }}"
                     class="img-thumbnail"
                     {{ puzzle_image_dimensions(puzzle.puzzleImageRatio, 100) }}
                     style="max-height: 100px;">
            </div>
        </div>
    {% endif %}

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-loading-text="{{ 'forms.saving'|trans }}">
            {{ 'puzzle_report.form.submit_changes'|trans }}
        </button>

        {% if in_modal %}
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                {{ 'forms.cancel'|trans }}
            </button>
        {% else %}
            <a href="{{ path('puzzle_detail', {puzzleId: puzzle_id}) }}" class="btn btn-secondary">
                {{ 'forms.cancel'|trans }}
            </a>
        {% endif %}
    </div>

{{ form_end(propose_form) }}
