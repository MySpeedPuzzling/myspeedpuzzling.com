{# Report duplicate puzzle form - used in both modal and full page #}
{% set in_modal = in_modal|default(false) %}

{{ form_start(report_form, {
    'action': path('puzzle_report_duplicate', {puzzleId: puzzle_id}),
    'attr': {
        'data-turbo': 'true',
        'data-turbo-frame': in_modal ? 'modal-frame' : '_top',
        'data-controller': 'report-duplicate-form',
        'data-report-duplicate-form-current-puzzle-id-value': puzzle_id,
        'data-report-duplicate-form-ean-search-url-value': path('puzzle_by_ean_search', {ean: '__EAN__'}),
        'data-report-duplicate-form-not-found-message-value': 'puzzle_report.scan.not_found'|trans,
        'data-report-duplicate-form-same-puzzle-message-value': 'puzzle_report.scan.same_puzzle'|trans,
        'data-report-duplicate-form-multiple-puzzles-message-value': 'scan.puzzle_form.multiple_puzzles'|trans,
        'data-report-duplicate-form-search-failed-message-value': 'puzzle_report.scan.search_failed'|trans,
    }
}) }}

    <p class="text-muted small mb-3">
        {{ 'puzzle_report.report_duplicate.description'|trans }}
    </p>

    {# Why the report was refused - the form keeps everything chosen; field errors stand at their fields #}
    {% for error in report_form.vars.errors %}
        <div class="alert alert-danger small">
            <i class="bi bi-exclamation-triangle me-1"></i>
            {{ error.message }}
        </div>
    {% endfor %}

    {# Current puzzle info #}
    <div class="card mb-3">
        <div class="card-body p-2 d-flex align-items-center">
            {% if puzzle.puzzleImage is not null %}
                <img src="{{ puzzle.puzzleImage|puzzle_image('puzzle_small') }}"
                     alt="{{ puzzle.puzzleName }}"
                     class="me-2 rounded"
                     {{ puzzle_image_dimensions(puzzle.puzzleImageRatio, 50) }}
                     style="max-height: 50px;">
            {% endif %}
            <div>
                <strong>{{ puzzle.puzzleName }}</strong>
                <br>
                <small class="text-muted">{{ puzzle.manufacturerName }} - {{ 'pieces_count'|trans({'%count%': puzzle.piecesCount})|raw }}</small>
            </div>
        </div>
    </div>

    {# Scanning the other box's barcode picks its brand and puzzle below #}
    <div data-controller="barcode-scanner"
         data-action="barcode-scanner:scanned->report-duplicate-form#scanned hide.bs.tab@document->barcode-scanner#stopScanning">
        <button type="button" class="btn btn-outline-primary btn-sm w-100 mb-3"
                data-barcode-scanner-target="toggleButton"
                data-action="click->barcode-scanner#toggle">
            <i class="bi-upc-scan me-2" aria-hidden="true"></i>{{ 'puzzle_report.scan.button'|trans }}
        </button>

        {{ include('_barcode_scanner_panel.html.twig') }}
    </div>

    <div data-report-duplicate-form-target="scanMessage" class="alert alert-warning d-none small mb-3" role="status"></div>

    {{ form_row(report_form.selectedManufacturerId) }}

    {# The puzzle chosen before a refused submit: its option comes along, the picker's list is loaded by script #}
    {{ form_row(report_form.selectedPuzzleId, {attr: report_form.selectedPuzzleId.vars.attr|merge(
        selected_duplicate_option|default(null) is not null ? {'data-selected-option': selected_duplicate_option|json_encode} : {}
    )}) }}

    {# Visual OR separator #}
    <div class="d-flex align-items-center my-4">
        <hr class="flex-grow-1 m-0">
        <span class="px-3 text-muted fw-medium small text-uppercase">{{ 'puzzle_report.form.or'|trans }}</span>
        <hr class="flex-grow-1 m-0">
    </div>

    {{ form_row(report_form.duplicatePuzzleUrl) }}

    {# Optional and quiet: "this record is the Czech box" - the merge review starts from it #}
    {% set languages_id = report_form.vars.id ~ '_name_languages' %}
    {% set languages_given = report_form.sourceNameLanguage.vars.value is not empty or report_form.duplicateNameLanguage.vars.value is not empty %}
    <button type="button"
            class="btn btn-link btn-sm p-0 mb-2"
            data-bs-toggle="collapse"
            data-bs-target="#{{ languages_id }}"
            aria-expanded="{{ languages_given ? 'true' : 'false' }}"
            aria-controls="{{ languages_id }}">
        {{- 'puzzle_names.report_languages_link'|trans -}}
    </button>
    <div class="collapse {{ languages_given ? 'show' }}" id="{{ languages_id }}">
        <div class="row g-2">
            <div class="col-sm-6">
                {{ form_row(report_form.sourceNameLanguage, {label_attr: {class: 'small'}, attr: {class: 'form-select-sm', 'data-controller': 'language-select'}}) }}
            </div>
            <div class="col-sm-6">
                {{ form_row(report_form.duplicateNameLanguage, {label_attr: {class: 'small'}, attr: {class: 'form-select-sm', 'data-controller': 'language-select'}}) }}
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-warning" data-loading-text="{{ 'forms.saving'|trans }}">
            {{ 'puzzle_report.form.submit_duplicate'|trans }}
        </button>

        {% if in_modal %}
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                {{ 'forms.cancel'|trans }}
            </button>
        {% else %}
            <a href="{{ path('puzzle_detail', {puzzleId: puzzle_id}) }}" class="btn btn-secondary">
                {{ 'forms.cancel'|trans }}
            </a>
        {% endif %}
    </div>

{{ form_end(report_form) }}
