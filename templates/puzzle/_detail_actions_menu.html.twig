{#
    The puzzle page's ⋯ menu with every action on the puzzle - shown in its header and in the bar that takes the
    header's place once it scrolls away (puzzle_detail.html.twig). The collection/wishlist/sell/lend part is replaced
    by turbo streams in every copy at once (puzzle/_dropdown_actions_stream.html.twig).

    Required variables: puzzle, puzzle_statuses, offers_count
#}
{# data-nosnippet: Google used the hidden menu labels as the search snippet ("Suggest a change …");
   it is honoured on div/span/section only, not on the ul #}
<div class="dropdown more-menu" data-nosnippet>
    <button class="btn btn-outline-secondary more-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'puzzle_detail.more_actions'|trans }}" title="{{ 'puzzle_detail.more_actions'|trans }}">
        <i class="bi bi-three-dots" aria-hidden="true"></i>
    </button>

    <ul class="dropdown-menu dropdown-menu-end">
        <li>
            <a class="dropdown-item" data-turbo-frame="_top" rel="nofollow" href="{{ path('puzzle_add', {puzzleId: puzzle.puzzleId}) }}">
                <i class="ci-add me-1"></i> {{ 'add_solving'|trans }}
            </a>
        </li>
        <li>
            <a class="dropdown-item" data-turbo-frame="_top" rel="nofollow" href="{{ path('stopwatch_puzzle', {puzzleId: puzzle.puzzleId}) }}">
                <i class="ci-time me-1"></i> {{ 'start_solving'|trans }}
            </a>
        </li>

        {% if logged_user.profile is not null %}
            <li><hr class="dropdown-divider"></li>
        {% endif %}

        {{ include('puzzle/_dropdown_actions.html.twig', {
            puzzle_id: puzzle.puzzleId,
            puzzle_statuses: puzzle_statuses,
            offer_counts: { (puzzle.puzzleId): offers_count },
            puzzle_name: puzzle.puzzleName,
        }) }}

        {# Under "Suggest a change" - signed-in players while PUZZLE_NAME_SUGGESTIONS_PUBLIC is on, moderators always #}
        {% if puzzle_name_suggestions.isOpen() %}
            <li>
                <a class="dropdown-item" href="{{ path('puzzle_suggest_name', {puzzleId: puzzle.puzzleId}) }}" rel="nofollow" data-turbo="true" data-turbo-frame="modal-frame">
                    <i class="bi bi-translate me-1"></i> {{ 'puzzle_names.suggest_name.menu'|trans }}
                    <small class="d-block text-muted">{{ 'puzzle_names.suggest_name.menu_description'|trans }}</small>
                </a>
            </li>
        {% endif %}

        {% if is_granted('PUZZLE_MODERATION_ACCESS') %}
            <li><hr class="dropdown-divider"></li>
            <li><h6 class="dropdown-header">{{ 'puzzle_detail.moderation.heading'|trans }}</h6></li>
            <li>
                <a class="dropdown-item" data-turbo-frame="_top" rel="nofollow" href="{{ path('admin_edit_puzzle', {puzzleId: puzzle.puzzleId, return: app.request.requestUri, return_title: puzzle.puzzleName}) }}">
                    <i class="bi bi-pencil me-1"></i> {{ 'puzzle_detail.moderation.edit'|trans }}
                </a>
            </li>
            <li>
                <a class="dropdown-item" data-turbo-frame="_top" rel="nofollow" href="{{ path('admin_puzzle_history', {puzzleId: puzzle.puzzleId, return: app.request.requestUri, return_title: puzzle.puzzleName}) }}">
                    <i class="bi bi-clock-history me-1"></i> {{ 'puzzle_detail.moderation.history'|trans }}
                </a>
            </li>
        {% endif %}
    </ul>
</div>
