{#
    "About this puzzle" at the bottom of a puzzle page (docs/features/seo/implementation-plan-2026-10.md, WS-A): unique,
    true text for search snippets and AI overviews, built from public data only. Never Puzzle Insights - no difficulty,
    tier, percentile or "harder/easier than" wording, those are the members' exclusive.

    Structured, never one paragraph: one sentence naming the puzzle, then the codes and events as a list and the solves
    as a small table (Jan, 2026-09-30: all facts in one paragraph read as a wall of text).

    Values that carry links are built as HTML with every user-provided value escaped before it goes in; the rest is
    escaped on output.

    Expects: puzzle (PuzzleOverview), summary (PuzzleSummary), is_image_hidden (EAN and product number stay out
    while the image is embargoed, as the EAN in the header).
#}
{% set brand_html = puzzle.manufacturerSlug is not null
    ? '<a href="' ~ path('brand_puzzles', {slug: puzzle.manufacturerSlug})|e ~ '">' ~ puzzle.manufacturerName|e ~ '</a>'
    : puzzle.manufacturerName|e
%}

{# A puzzle may hold several codes, comma-separated (one per edition or region) #}
{% set summary_ean = (puzzle.puzzleEan and not is_image_hidden)
    ? puzzle.puzzleEan|split(',')|map(code => code|trim)|filter(code => code is not same as(''))|join(' / ')
    : ''
%}
{% set summary_product_number = (puzzle.puzzleIdentificationNumber and not is_image_hidden)
    ? puzzle.puzzleIdentificationNumber|split(',')|map(code => code|trim)|filter(code => code is not same as(''))|join(' / ')
    : ''
%}

{% set facts = [] %}
{% if summary_ean %}
    {% set facts = facts|merge([{label: 'puzzle_detail.summary.facts.ean'|trans, html: summary_ean|e}]) %}
{% endif %}
{% if summary_product_number %}
    {% set facts = facts|merge([{label: 'puzzle_detail.summary.facts.product_number'|trans, html: summary_product_number|e}]) %}
{% endif %}
{% set alternative_name = puzzle.puzzleAlternativeNames.legacyAlternativeName() %}
{% if alternative_name and alternative_name != puzzle.puzzleName %}
    {% set facts = facts|merge([{label: 'puzzle_detail.summary.facts.also_known_as'|trans, html: alternative_name|e}]) %}
{% endif %}
{% if summary.usedAt is not empty %}
    {# The same badges as the competition tags in the header's Details #}
    {% set used_at_badges = summary.usedAt|map(competition => competition.routeName is not null
        ? '<a class="badge bg-primary badge-shadow rounded-pill text-white link-light" href="' ~ path(competition.routeName, competition.routeParameters)|e ~ '"><i class="ci-diamond" aria-hidden="true"></i> ' ~ competition.displayName|e ~ '</a>'
        : '<span class="badge bg-primary badge-shadow rounded-pill text-white"><i class="ci-diamond" aria-hidden="true"></i> ' ~ competition.displayName|e ~ '</span>'
    ) %}
    {% set facts = facts|merge([{
        label: 'puzzle_detail.summary.facts.used_at'|trans,
        html: '<span class="puzzle-summary-badges">' ~ used_at_badges|join(' ') ~ '</span>',
    }]) %}
{% endif %}

{# A median equal to the fastest time (one solve, or everybody tied) would only repeat it #}
{% set time_rows = [] %}
{% if summary.hasSoloTimes %}
    {% set time_rows = time_rows|merge([{
        label: 'puzzle_detail.summary.times.solo'|trans,
        count: summary.soloSolvesCount,
        median: summary.hasSingleSoloTime ? null : summary.medianTimeSolo,
        fastest: summary.fastestTimeSolo,
    }]) %}
{% endif %}
{% if summary.hasDuoTimes %}
    {% set time_rows = time_rows|merge([{
        label: 'puzzle_detail.summary.times.pairs'|trans,
        count: summary.duoSolvesCount,
        median: summary.medianTimeDuo != summary.fastestTimeDuo ? summary.medianTimeDuo : null,
        fastest: summary.fastestTimeDuo,
    }]) %}
{% endif %}
{% if summary.hasTeamTimes %}
    {% set time_rows = time_rows|merge([{
        label: 'puzzle_detail.summary.times.teams'|trans,
        count: summary.teamSolvesCount,
        median: summary.medianTimeTeam != summary.fastestTimeTeam ? summary.medianTimeTeam : null,
        fastest: summary.fastestTimeTeam,
    }]) %}
{% endif %}

<section class="puzzle-summary">
    <p class="puzzle-summary-intro">{{ 'puzzle_detail.summary.intro'|trans({
        '%name%': puzzle.puzzleName|e,
        '%pieces%': puzzle.piecesCount,
        '%brand%': brand_html,
    })|raw }}</p>

    {% if facts is not empty or time_rows is not empty %}
        <div class="puzzle-summary-body">
            {% if facts is not empty %}
                <dl class="puzzle-summary-facts">
                    {% for fact in facts %}
                        <div class="puzzle-summary-fact">
                            <dt>{{ fact.label }}</dt>
                            <dd>{{ fact.html|raw }}</dd>
                        </div>
                    {% endfor %}
                </dl>
            {% endif %}

            {% if time_rows is not empty %}
                <table class="puzzle-summary-times">
                    <thead>
                        <tr>
                            <td></td>
                            <th scope="col">{{ 'puzzle_detail.summary.times.solves'|trans }}</th>
                            <th scope="col"><svg class="stat-icon" width="13" height="13" aria-hidden="true"><use href="/stat-icons-sprite.svg#stat-med"/></svg> {{ 'puzzle_detail.summary.times.median'|trans }}</th>
                            <th scope="col"><i class="bi bi-1-circle" aria-hidden="true"></i> {{ 'puzzle_detail.summary.times.fastest'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in time_rows %}
                            <tr>
                                <th scope="row">{{ row.label }}</th>
                                <td>{{ row.count|format_number([], 'decimal', 'default', app.request.locale) }}</td>
                                <td>{{ row.median is not null ? row.median|puzzlingTime : '–' }}</td>
                                <td>{{ row.fastest|puzzlingTime }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    {% endif %}

    {% if not summary.hasSoloTimes %}
        {# The add page is robots-blocked, the translated link carries rel="nofollow" #}
        <p class="mb-0 mt-3">{{ (summary.hasGroupTimes ? 'puzzle_detail.summary.no_solo_times' : 'puzzle_detail.summary.no_times')|trans({
            '%add_url%': path('puzzle_add', {puzzleId: puzzle.puzzleId})|e,
        })|raw }}</p>
    {% endif %}
</section>
