{% extends 'base.html.twig' %}

{# Page 1 carries the stats; pages 2+ (/page/{n}) are the rest of the brand's
   puzzle list with their own title - same indexability as page 1. #}
{% set is_first_page = pagination.isFirstPage %}

{% set brand_title = is_first_page
    ? 'brand_hub.meta.title'|trans({'%brand%': stats.brandName})
    : 'brand_hub.paged_title'|trans({'%brand%': stats.brandName, '%page%': pagination.page})
%}

{% set brand_meta_description = is_first_page
    ? 'brand_hub.meta.description'|trans({
        '%brand%': stats.brandName,
        '%count%': stats.puzzlesCount,
    })
    : 'brand_hub.meta.paged_description'|trans({
        '%brand%': stats.brandName,
        '%count%': pagination.totalItems|format_number,
        '%page%': pagination.page,
        '%pages%': pagination.totalPages,
    })
%}

{% block title %}{{ brand_title }}{% endblock %}
{% block meta_description %}{{ brand_meta_description }}{% endblock %}
{% block robots %}
    {% if stats.indexable %}
        <meta name="robots" content="index, follow">
    {% else %}
        {# Thin-page guardrail: too few puzzles or no recorded solves #}
        <meta name="robots" content="noindex, follow">
    {% endif %}
{% endblock %}

{% block json_ld %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": {{ 'puzzle_detail.breadcrumb.database'|trans|json_encode|raw }},
                "item": {{ url('puzzles')|json_encode|raw }}
            },
            {% if is_first_page %}
            {
                "@type": "ListItem",
                "position": 2,
                "name": {{ stats.brandName|json_encode|raw }}
            }
            {% else %}
            {
                "@type": "ListItem",
                "position": 2,
                "name": {{ stats.brandName|json_encode|raw }},
                "item": {{ url('brand_puzzles', {slug: stats.slug})|json_encode|raw }}
            },
            {
                "@type": "ListItem",
                "position": 3,
                "name": {{ 'catalogue.pagination.page'|trans({'%page%': pagination.page})|json_encode|raw }}
            }
            {% endif %}
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": {{ brand_title|json_encode|raw }},
        "description": {{ brand_meta_description|json_encode|raw }},
        "url": {{ (is_first_page ? url('brand_puzzles', {slug: stats.slug}) : url('brand_puzzles_page', {slug: stats.slug, page: pagination.page}))|json_encode|raw }},
        "about": {
            "@type": "Brand",
            "name": {{ stats.brandName|json_encode|raw }}
        }
    }
    </script>
{% endblock %}

{% block content %}
    <div class="d-flex flex-wrap align-items-baseline justify-content-between column-gap-3">
        {{ include('_breadcrumb.html.twig', {items: is_first_page
            ? [
                {label: 'puzzle_detail.breadcrumb.database'|trans, url: path('puzzles')},
                {label: stats.brandName},
            ]
            : [
                {label: 'puzzle_detail.breadcrumb.database'|trans, url: path('puzzles')},
                {label: stats.brandName, url: path('brand_puzzles', {slug: stats.slug})},
                {label: 'catalogue.pagination.page'|trans({'%page%': pagination.page})},
            ]
        }) }}
        <a class="small mb-2" href="{{ path('puzzle_brands') }}">{{ 'brand_directory.all_brands_link'|trans }}</a>
    </div>

    <h1 class="mb-2">{{ is_first_page ? 'brand_hub.title'|trans({'%brand%': stats.brandName}) : brand_title }}</h1>

    {% if is_first_page %}
        <div class="row g-2 mb-2">
            <div class="col-4">
                <div class="card card-body shadow p-2 text-center h-100">
                    <div class="fs-4 fw-bold">{{ stats.puzzlesCount }}</div>
                    <small class="text-muted">{{ 'brand_hub.stats.puzzles'|trans }}</small>
                </div>
            </div>
            <div class="col-4">
                <div class="card card-body shadow p-2 text-center h-100">
                    <div class="fs-4 fw-bold">{{ stats.solvesCount }}</div>
                    <small class="text-muted">{{ 'brand_hub.stats.solves'|trans }}</small>
                </div>
            </div>
            <div class="col-4">
                <div class="card card-body shadow p-2 text-center h-100">
                    <div class="fs-4 fw-bold">{{ stats.medianSeconds is not null ? stats.medianSeconds|compactTime : '–' }}</div>
                    <small class="text-muted">{{ 'brand_hub.stats.median_time'|trans }}</small>
                </div>
            </div>
        </div>

        <p class="text-muted small mb-3">{{ 'brand_hub.stats.provenance'|trans({'%solves%': stats.solvesCount}) }}</p>

        {% if stats.piecesMedians|length > 0 %}
            <h2 class="h5">{{ 'brand_hub.median_by_pieces'|trans }}</h2>
            <ul class="list-unstyled mb-3">
                {% for bucket in stats.piecesMedians %}
                    <li>
                        {% if stats.hasIndexablePiecesPage(bucket.piecesCount) %}
                            <a href="{{ path('brand_pieces_puzzles', {slug: stats.slug, pieces: bucket.piecesCount}) }}">{{ 'brand_hub.pieces_link'|trans({'%pieces%': bucket.piecesCount}) }}</a>:
                        {% elseif bucket.piecesCount in allowed_pieces %}
                            <a href="{{ path('pieces_puzzles', {pieces: bucket.piecesCount}) }}">{{ 'brand_hub.pieces_link'|trans({'%pieces%': bucket.piecesCount}) }}</a>:
                        {% else %}
                            {{ 'brand_hub.pieces_link'|trans({'%pieces%': bucket.piecesCount}) }}:
                        {% endif %}
                        <strong>{{ bucket.medianSeconds|compactTime }}</strong>
                        <small class="text-muted">({{ 'brand_hub.stats.provenance'|trans({'%solves%': bucket.solvesCount}) }})</small>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {% set indexable_pieces_pages = stats.indexablePiecesPages %}
        {% if indexable_pieces_pages|length > 0 %}
            <h2 class="h5">{{ 'brand_hub.by_pieces'|trans({'%brand%': stats.brandName}) }}</h2>
            <p class="mb-3">
                {% for pieces_page in indexable_pieces_pages %}
                    <a class="badge bg-primary badge-shadow rounded-pill text-white link-light" href="{{ path('brand_pieces_puzzles', {slug: stats.slug, pieces: pieces_page.piecesCount}) }}">{{ 'pieces_count'|trans({'%count%': pieces_page.piecesCount})|raw }}</a>
                {% endfor %}
            </p>
        {% endif %}
    {% endif %}

    {% if puzzles|length > 0 %}
        {% if is_first_page %}
            <h2 class="h5 mb-1">{{ 'brand_hub.all_puzzles'|trans({'%brand%': stats.brandName}) }}</h2>
        {% endif %}
        <p class="text-muted small mb-2">{{ 'catalogue.range'|trans({
            '%from%': pagination.firstItem|format_number,
            '%to%': pagination.lastItem|format_number,
            '%total%': pagination.totalItems|format_number,
        }) }}</p>
        <div class="row g-2 g-md-3">
            {{ include('puzzle/_search_result_items.html.twig', {
                'puzzles': puzzles,
                'search': null,
                'puzzle_statuses': puzzle_statuses,
                'ranking': ranking,
                'tags': tags,
                'difficulty_data': difficulty_data,
                'offer_counts': offer_counts,
            }) }}
        </div>
    {% endif %}

    {{ include('puzzle/_pagination.html.twig', {
        pagination: pagination,
        route: 'brand_puzzles',
        page_route: 'brand_puzzles_page',
        route_params: {slug: stats.slug},
    }) }}
{% endblock %}
