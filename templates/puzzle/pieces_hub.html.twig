{% extends 'base.html.twig' %}

{# Page 1 carries the stats; pages 2+ (/page/{n}) are the rest of the list
   with their own title - same indexability as page 1. #}
{% set is_first_page = pagination.isFirstPage %}

{% set pieces_title = is_first_page
    ? 'pieces_hub.meta.title'|trans({'%pieces%': stats.piecesCount})
    : 'pieces_hub.paged_title'|trans({'%pieces%': stats.piecesCount, '%page%': pagination.page})
%}

{% if is_first_page == false %}
    {% set pieces_meta_description = 'pieces_hub.meta.paged_description'|trans({
        '%pieces%': stats.piecesCount,
        '%count%': pagination.totalItems|format_number,
        '%page%': pagination.page,
        '%pages%': pagination.totalPages,
    }) %}
{% elseif stats.medianSeconds is not null %}
    {% set pieces_meta_description = 'pieces_hub.meta.description'|trans({
        '%pieces%': stats.piecesCount,
        '%median%': stats.medianSeconds|compactTime,
        '%solves%': stats.solvesCount,
        '%count%': stats.puzzlesCount,
    }) %}
{% else %}
    {% set pieces_meta_description = 'pieces_hub.meta.description_no_median'|trans({
        '%pieces%': stats.piecesCount,
        '%count%': stats.puzzlesCount,
    }) %}
{% endif %}

{% block title %}{{ pieces_title }}{% endblock %}
{% block meta_description %}{{ pieces_meta_description }}{% endblock %}

{% block json_ld %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": {{ 'puzzle_detail.breadcrumb.database'|trans|json_encode|raw }},
                "item": {{ url('puzzles')|json_encode|raw }}
            },
            {% if is_first_page %}
            {
                "@type": "ListItem",
                "position": 2,
                "name": {{ 'pieces_hub.title'|trans({'%pieces%': stats.piecesCount})|json_encode|raw }}
            }
            {% else %}
            {
                "@type": "ListItem",
                "position": 2,
                "name": {{ 'pieces_hub.title'|trans({'%pieces%': stats.piecesCount})|json_encode|raw }},
                "item": {{ url('pieces_puzzles', {pieces: stats.piecesCount})|json_encode|raw }}
            },
            {
                "@type": "ListItem",
                "position": 3,
                "name": {{ 'catalogue.pagination.page'|trans({'%page%': pagination.page})|json_encode|raw }}
            }
            {% endif %}
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": {{ pieces_title|json_encode|raw }},
        "description": {{ pieces_meta_description|json_encode|raw }},
        "url": {{ (is_first_page ? url('pieces_puzzles', {pieces: stats.piecesCount}) : url('pieces_puzzles_page', {pieces: stats.piecesCount, page: pagination.page}))|json_encode|raw }}
    }
    </script>
{% endblock %}

{% block content %}
    <h1 class="mb-2">{{ is_first_page ? 'pieces_hub.title'|trans({'%pieces%': stats.piecesCount}) : pieces_title }}</h1>

    {% if is_first_page %}
        <div class="row g-2 mb-2">
            <div class="col-4">
                <div class="card card-body shadow p-2 text-center h-100">
                    <div class="fs-4 fw-bold">{{ stats.puzzlesCount }}</div>
                    <small class="text-muted">{{ 'brand_hub.stats.puzzles'|trans }}</small>
                </div>
            </div>
            <div class="col-4">
                <div class="card card-body shadow p-2 text-center h-100">
                    <div class="fs-4 fw-bold">{{ stats.solvesCount }}</div>
                    <small class="text-muted">{{ 'brand_hub.stats.solves'|trans }}</small>
                </div>
            </div>
            <div class="col-4">
                <div class="card card-body shadow p-2 text-center h-100">
                    <div class="fs-4 fw-bold">{{ stats.medianSeconds is not null ? stats.medianSeconds|compactTime : '–' }}</div>
                    <small class="text-muted">{{ 'brand_hub.stats.median_time'|trans }}</small>
                </div>
            </div>
        </div>

        <p class="text-muted small mb-3">{{ 'brand_hub.stats.provenance'|trans({'%solves%': stats.solvesCount}) }}</p>

        {% if stats.topBrands|length > 0 %}
            <h2 class="h5">{{ 'pieces_hub.top_brands'|trans({'%pieces%': stats.piecesCount}) }}</h2>
            <p class="mb-3">
                {% for brand in stats.topBrands %}
                    {# The brand's own page for this size when it is indexable, its hub otherwise #}
                    <a class="badge bg-primary badge-shadow rounded-pill text-white link-light" href="{{ brand.hasIndexableBrandPiecesPage
                        ? path('brand_pieces_puzzles', {slug: brand.slug, pieces: stats.piecesCount})
                        : path('brand_puzzles', {slug: brand.slug}) }}">{{ brand.brandName }}</a>
                {% endfor %}
            </p>
        {% endif %}
    {% endif %}

    {% if puzzles|length > 0 %}
        {% if is_first_page %}
            <h2 class="h5 mb-1">{{ 'pieces_hub.all_puzzles'|trans({'%pieces%': stats.piecesCount}) }}</h2>
        {% endif %}
        <p class="text-muted small mb-2">{{ 'catalogue.range'|trans({
            '%from%': pagination.firstItem|format_number,
            '%to%': pagination.lastItem|format_number,
            '%total%': pagination.totalItems|format_number,
        }) }}</p>
        <div class="row g-2 g-md-3">
            {{ include('puzzle/_search_result_items.html.twig', {
                'puzzles': puzzles,
                'search': null,
                'puzzle_statuses': puzzle_statuses,
                'ranking': ranking,
                'tags': tags,
                'difficulty_data': difficulty_data,
                'offer_counts': offer_counts,
            }) }}
        </div>
    {% endif %}

    {{ include('puzzle/_pagination.html.twig', {
        pagination: pagination,
        route: 'pieces_puzzles',
        page_route: 'pieces_puzzles_page',
        route_params: {pieces: stats.piecesCount},
    }) }}

    {{ include('puzzle/_catalogue_more_links.html.twig', {
        guide_pieces: guide_path is not null ? stats.piecesCount : null,
        guide_path: guide_path,
        difficulty_pieces: has_pieces_difficulty_lists ? stats.piecesCount : null,
        difficulty_brand: null,
    }) }}
{% endblock %}
