{% extends 'base.html.twig' %}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'puzzle_names.suggest_name.title'|trans }} - {{ puzzle.puzzleName }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, follow">{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="mb-2">
                <a href="{{ path('puzzle_detail', {puzzleId: puzzle.puzzleId}) }}" class="btn btn-outline-secondary py-1 px-2" style="font-size: 0.75rem;">
                    <i class="ci-arrow-left me-1"></i> <small class="text-muted">{{ 'back_to'|trans }}</small> {{ 'puzzle_report.back_to_puzzle'|trans }}
                </a>
            </div>

            <div class="card">
                <div class="card-header">
                    <h1 class="h4 mb-0">{{ 'puzzle_names.suggest_name.title'|trans }}</h1>
                </div>

                <div class="card-body">
                    {{ include('puzzle/_suggest_name_form.html.twig', {in_modal: false}) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
