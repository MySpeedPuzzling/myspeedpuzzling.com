{% extends 'base.html.twig' %}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'puzzle_add.meta.title'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'puzzle_add.title'|trans }}</h1>

    {% if secret_puzzle_notice|default(null) is not null %}
        <div class="alert alert-warning" role="status" data-secret-puzzle-notice>{{ secret_puzzle_notice }}</div>
    {% endif %}

    {# "Add to my profile" of a round's official results filled the form in (docs/features/competitions-management/official-results.md) #}
    {% if official_entry|default(null) is not null %}
        <div class="alert alert-info" role="status" data-official-entry-notice>
            <i class="bi bi-trophy me-1" aria-hidden="true"></i>{{ 'puzzle_add.official_entry.notice'|trans({'%round%': official_entry.roundName, '%event%': official_entry.competitionName}) }}
            {% if official_entry.memberChoices is not empty %}
                {# Nobody of the pair/team is linked and the name is not clearly the player's: they say which one they are #}
                <div class="mt-2 small" data-official-entry-which-one>
                    {{ 'puzzle_add.official_entry.which_one'|trans }}
                    <span class="d-flex flex-wrap gap-2 mt-1">
                        {% for name in official_entry.memberChoices %}
                            <a class="btn btn-sm btn-outline-primary" rel="nofollow" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({official_member: loop.index0})) }}" data-official-member="{{ loop.index0 }}">{{ 'puzzle_add.official_entry.its_me'|trans({'%name%': name}) }}</a>
                        {% endfor %}
                    </span>
                </div>
            {% elseif official_entry.missingPeople > 0 %}
                <div class="mt-1 small" data-official-entry-add-people>{{ 'puzzle_add.official_entry.add_people'|trans({'%count%': official_entry.missingPeople}) }}</div>
            {% endif %}
        </div>
    {% endif %}

    <div data-controller="puzzle-add-form" data-puzzle-add-form-mode-value="{{ initial_mode|default('speed_puzzling') }}" data-puzzle-add-form-system-id-value="{{ system_collection_id }}">
        <div class="mb-4">
            <div class="btn-group w-100" role="group" aria-label="Form mode selection">
                <input type="radio" class="btn-check" name="form-mode" id="mode-speed" autocomplete="off"
                       {{ initial_mode|default('speed_puzzling') == 'speed_puzzling' ? 'checked' : '' }}
                       value="speed_puzzling"
                       data-action="change->puzzle-add-form#switchMode">
                <label class="btn btn-outline-primary py-2 px-2 d-flex flex-column align-items-center lh-sm text-wrap" for="mode-speed">
                    <i class="bi bi-stopwatch-fill"></i>
                    <small>{{ 'puzzle_add.mode.speed_puzzling'|trans }}</small>
                </label>

                <input type="radio" class="btn-check" name="form-mode" id="mode-relax" autocomplete="off"
                       {{ initial_mode|default('speed_puzzling') == 'relax' ? 'checked' : '' }}
                       value="relax"
                       data-action="change->puzzle-add-form#switchMode">
                <label class="btn btn-outline-primary py-2 px-2 d-flex flex-column align-items-center lh-sm text-wrap" for="mode-relax">
                    <i class="bi bi-cup-hot-fill"></i>
                    <small>{{ 'puzzle_add.mode.relax'|trans }}</small>
                </label>

                <input type="radio" class="btn-check" name="form-mode" id="mode-collection" autocomplete="off"
                       {{ initial_mode|default('speed_puzzling') == 'collection' ? 'checked' : '' }}
                       value="collection"
                       data-action="change->puzzle-add-form#switchMode">
                <label class="btn btn-outline-primary py-2 px-2 d-flex flex-column align-items-center lh-sm text-wrap" for="mode-collection">
                    <i class="bi bi-collection-fill"></i>
                    <small>{{ 'puzzle_add.mode.to_collection'|trans }}</small>
                </label>
            </div>
        </div>

        {{ include('_solving_time_form.html.twig', {has_active_membership: has_active_membership|default(true)}) }}
    </div>

{% endblock %}
