{% extends 'base.html.twig' %}

{# The same public facts as the summary paragraph (puzzle/_summary.html.twig), EAN only while the image is not
   embargoed. One EAN is enough here - a puzzle may list several, comma-separated. #}
{% set puzzle_meta_ean = (puzzle.puzzleEan and not is_image_hidden)
    ? 'puzzle_detail.meta.ean'|trans({'%ean%': puzzle.puzzleEan|split(',')|first|trim})
    : ''
%}
{% set puzzle_meta_parameters = {
    '%brand%': puzzle.manufacturerName,
    '%name%': puzzle.puzzleName,
    '%pieces%': puzzle.piecesCount,
    '%ean%': puzzle_meta_ean,
} %}
{% if puzzle_summary.hasSingleSoloTime %}
    {% set puzzle_meta_description = 'puzzle_detail.meta.description_with_single_time'|trans(puzzle_meta_parameters|merge({
        '%fastest%': puzzle_summary.fastestTimeSolo|compactTime,
    })) %}
{% elseif puzzle_summary.hasSoloTimes %}
    {% set puzzle_meta_description = 'puzzle_detail.meta.description_with_times'|trans(puzzle_meta_parameters|merge({
        '%median%': puzzle_summary.medianTimeSolo|compactTime,
        '%fastest%': puzzle_summary.fastestTimeSolo|compactTime,
        '%count%': puzzle_summary.soloSolvesCount,
    })) %}
{% elseif puzzle_summary.hasGroupTimes %}
    {% set puzzle_meta_description = 'puzzle_detail.meta.description_no_solo_times'|trans(puzzle_meta_parameters) %}
{% else %}
    {% set puzzle_meta_description = 'puzzle_detail.meta.description'|trans(puzzle_meta_parameters) %}
{% endif %}

{# The catalogue pages above this puzzle (PuzzleCatalogueLinks): the breadcrumb, the piece count in the header and
   the related puzzles all link the same ones. The brand × pieces page only when it is indexable, otherwise the
   pieces hub of every brand; an odd piece count has neither. #}
{% if catalogue_links.linksBrandPiecesPage %}
    {% set pieces_page = {
        url: path('brand_pieces_puzzles', {slug: catalogue_links.brandSlug, pieces: puzzle.piecesCount}),
        name: 'brand_pieces_hub.title'|trans({'%brand%': puzzle.manufacturerName, '%pieces%': puzzle.piecesCount}),
        label: 'puzzle_detail.breadcrumb.pieces'|trans({'%pieces%': puzzle.piecesCount}),
        fixed: true,
    } %}
{% elseif catalogue_links.linksPiecesHub %}
    {% set pieces_page = {
        url: path('pieces_puzzles', {pieces: puzzle.piecesCount}),
        name: 'brand_hub.pieces_link'|trans({'%pieces%': puzzle.piecesCount}),
        label: 'brand_hub.pieces_link'|trans({'%pieces%': puzzle.piecesCount}),
        fixed: true,
    } %}
{% else %}
    {% set pieces_page = null %}
{% endif %}

{# name = BreadcrumbList JSON-LD, label = the visible line, which stays short: the brand precedes the piece count.
   fixed = a short level that never gives way - a long brand or puzzle name is cut instead. #}
{% set breadcrumb = [{
    name: 'puzzle_detail.breadcrumb.database'|trans,
    label: 'puzzle_detail.breadcrumb.database'|trans,
    url: path('puzzles'),
}] %}
{% if catalogue_links.linksBrandHub %}
    {% set breadcrumb = breadcrumb|merge([{
        name: puzzle.manufacturerName,
        label: puzzle.manufacturerName,
        url: path('brand_puzzles', {slug: catalogue_links.brandSlug}),
    }]) %}
{% endif %}
{% if pieces_page is not null %}
    {% set breadcrumb = breadcrumb|merge([pieces_page]) %}
{% endif %}
{# Without a brand level the brand stays in the puzzle's own name #}
{% set breadcrumb = breadcrumb|merge([{
    name: catalogue_links.linksBrandHub ? puzzle.puzzleName : puzzle.manufacturerName ~ ' ' ~ puzzle.puzzleName,
    label: puzzle.puzzleName,
    url: null,
}]) %}

{% block title %}{{ 'puzzle_detail.meta.title'|trans({ '%brand%': puzzle.manufacturerName, '%name%': puzzle.puzzleName, '%pieces%': puzzle.piecesCount }) }}{% endblock %}
{% block meta_description %}{{ puzzle_meta_description }}{% endblock %}
{% block og_image %}{% if puzzle.puzzleImage is not null %}{{ absolute_url(puzzle.puzzleImage|thumbnail('puzzle_medium')) }}{% else %}{{ parent() }}{% endif %}{% endblock %}
{% block robots %}
    {% if is_image_hidden %}
        <meta name="robots" content="noindex, nofollow">
    {% else %}
        <meta name="robots" content="index, follow">
    {% endif %}
{% endblock %}

{% block json_ld %}
    {{ parent() }}
    {# Google requires offers, review or aggregateRating on Product — only emit the block when real marketplace offers exist #}
    {% if marketplace_offers is not empty %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ puzzle.puzzleName|json_encode|raw }},
        "brand": {
            "@type": "Brand",
            "name": {{ puzzle.manufacturerName|json_encode|raw }}
        },
        {% if puzzle.puzzleImage is not null and not is_image_hidden %}
        "image": {{ absolute_url(puzzle.puzzleImage|thumbnail('puzzle_medium'))|json_encode|raw }},
        {% endif %}
        {# The codes stay out while the image is embargoed, as everywhere else on the page #}
        {% if puzzle.puzzleEan is not null and puzzle.puzzleEan matches '/^\\d{13}$/' and not is_image_hidden %}
        "gtin13": {{ puzzle.puzzleEan|json_encode|raw }},
        {% endif %}
        {% if puzzle.puzzleIdentificationNumber is not null and not is_image_hidden %}
        "sku": {{ puzzle.puzzleIdentificationNumber|json_encode|raw }},
        "mpn": {{ puzzle.puzzleIdentificationNumber|json_encode|raw }},
        {% endif %}
        "description": {{ puzzle_meta_description|json_encode|raw }},
        "url": {{ url('puzzle_detail', {puzzleId: puzzle.puzzleId})|json_encode|raw }},
        "offers": [
            {% for offer in marketplace_offers %}
            {
                "@type": "Offer",
                "price": {{ offer.price|json_encode|raw }},
                "priceCurrency": {{ offer.currency|json_encode|raw }},
                "itemCondition": {{ offer.condition.toSchemaOrgCondition|json_encode|raw }},
                "availability": "https://schema.org/InStock",
                "url": {{ url('marketplace_puzzle', {puzzleId: puzzle.puzzleId})|json_encode|raw }}
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ],
        "additionalProperty": [
            {
                "@type": "PropertyValue",
                "name": "Number of pieces",
                "value": {{ puzzle.piecesCount|json_encode|raw }}
            }
        ]
    }
    </script>
    {% endif %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {% for level in breadcrumb %}
            {
                "@type": "ListItem",
                "position": {{ loop.index }},
                "name": {{ level.name|json_encode|raw }}{% if level.url is not null %},
                "item": {{ absolute_url(level.url)|json_encode|raw }}{% endif %}

            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    }
    </script>
{% endblock %}

{% block content %}
    <div data-nosnippet>
        {{ include('_return_back_button.html.twig') }}
    </div>

    {# One short line that never wraps - the top of the page stays the puzzle itself. Long names end in an ellipsis,
       below sm the database is just an icon and below md the puzzle's own name is left out (the H1 says it right
       underneath). The BreadcrumbList JSON-LD above carries the same levels. #}
    <nav aria-label="breadcrumb" class="puzzle-breadcrumb mb-1">
        <ol class="breadcrumb flex-nowrap mb-0" style="font-size: 0.8rem;">
            {% for level in breadcrumb %}
                {% if loop.first %}
                    <li class="breadcrumb-item flex-shrink-0">
                        <a href="{{ level.url }}" aria-label="{{ level.label }}" title="{{ level.label }}"><i class="bi bi-puzzle d-sm-none" aria-hidden="true"></i><span class="d-none d-sm-inline">{{ level.label }}</span></a>
                    </li>
                {% elseif loop.last %}
                    <li class="breadcrumb-item active text-truncate d-none d-md-block" style="min-width: 0;" aria-current="page">{{ level.label }}</li>
                {% else %}
                    <li class="breadcrumb-item {{ (level.fixed ?? false) ? 'flex-shrink-0' : 'text-truncate' }}" style="min-width: 0;"><a href="{{ level.url }}">{{ level.label }}</a></li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>

    <div class="position-relative">

        <div class="d-flex">
            <div class="flex-shrink-0 puzzle-detail-image text-center me-2 me-md-3">
                <div class="gallery">
                    {% if puzzle.puzzleImage is not null %}
                        <a class="gallery-item gallery-item-inline-block" href="{{ uploaded_asset(puzzle.puzzleImage) }}">
                            <img alt="{{ 'puzzle_img_alt'|trans({'%puzzle%': puzzle.manufacturerName ~ ' ' ~ puzzle.puzzleName}) }}" src="{{ puzzle.puzzleImage|puzzle_image('puzzle_medium') }}" {{ puzzle_image_dimensions(puzzle.puzzleImageRatio, 110) }} fetchpriority="high">
                        </a>
                    {% else %}
                        <img alt="{{ 'puzzle_img_alt'|trans({'%puzzle%': puzzle.manufacturerName ~ ' ' ~ puzzle.puzzleName}) }}" src="{{ puzzle.puzzleImage|puzzle_image('puzzle_medium') }}" {{ puzzle_image_dimensions(puzzle.puzzleImageRatio, 110) }} fetchpriority="high">
                    {% endif %}
                </div>
            </div>

            <div class="flex-wrap flex-grow-1 d-md-flex flex-sm-grow-0 me-1 me-sm-3 me-md-4">
                <div class="me-md-4">
                    <h1 class="h4 mb-0">{{ puzzle.manufacturerName }} {{ puzzle.puzzleName }} <span class="text-muted fw-normal">({{ 'pieces_count'|trans({ '%count%': puzzle.piecesCount })|raw }})</span></h1>
                    <div class="mb-1" id="puzzle-badges-{{ puzzle.puzzleId }}">
                        {{ include('puzzle/_badges.html.twig', {
                            puzzle_id: puzzle.puzzleId,
                            puzzle_statuses: puzzle_statuses,
                        }) }}
                        {% if offers_count > 0 %}
                            {% set puzzleDetailReturnUrl = path('puzzle_detail', {puzzleId: puzzle.puzzleId, return: app.request.query.get('return'), return_title: app.request.query.get('return_title')}) %}
                            <a href="{{ path('marketplace_puzzle', {puzzleId: puzzle.puzzleId, return: puzzleDetailReturnUrl, return_title: puzzle.puzzleName}) }}"
                               class="puzzle-offers-badge mt-1 badge bg-danger badge-shadow rounded-pill text-white link-light">
                                <i class="bi bi-shop me-1"></i>
                                {% if lowest_offer_prices is not empty %}
                                    {# The cheapest priced offer - the prices of the Product structured data, visible
                                       on the page. Never compared across currencies: one price per currency. #}
                                    {% set offer_prices = [] %}
                                    {% for currency, price in lowest_offer_prices %}
                                        {% set offer_prices = offer_prices|merge([price|format_currency(currency, {fraction_digit: price == price|round ? 0 : 2}, app.request.locale)]) %}
                                    {% endfor %}
                                    {{ 'puzzler_offers.badge_from'|trans({'%count%': offers_count, '%price%': offer_prices|join(' / ')}) }}
                                {% else %}
                                    {{ 'puzzler_offers.badge'|trans({'%count%': offers_count}) }}
                                {% endif %}
                            </a>
                        {% endif %}
                        {% if has_pending_proposals %}
                            <a href="{{ path('puzzle_pending_proposals', {puzzleId: puzzle.puzzleId}) }}"
                               class="mt-1 badge bg-warning text-dark rounded-pill"
                               rel="nofollow"
                               data-turbo="true"
                               data-turbo-frame="modal-frame">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                {{ 'pending_proposals.badge'|trans }}
                            </a>
                        {% endif %}
                    </div>

                    <span class="d-inline-flex align-items-center gap-1 mt-2">
                        {% if logged_user.profile is not null and logged_user.profile.activeMembership %}
                            {% if puzzle_difficulty is not null and puzzle_difficulty.difficultyScore is not null %}
                                {% set dt_name = puzzle_difficulty.difficultyTier.name|lower %}
                                {% set dt_icon_map = {'veryeasy':'diff-very-easy','easy':'diff-easy','average':'diff-average','challenging':'diff-challenging','hard':'diff-hard','veryhard':'diff-very-hard'} %}
                                <svg class="diff-icon" width="24" height="24" style="color: var(--{{ dt_icon_map[dt_name] ?? 'diff-unknown' }})"><use href="/difficulty-icons-sprite.svg#{{ dt_icon_map[dt_name] ?? 'diff-unknown' }}"/></svg>
                            {% else %}
                                <svg class="diff-icon" width="24" height="24" style="color: var(--diff-unknown)"><use href="/difficulty-icons-sprite.svg#diff-unknown"/></svg>
                            {% endif %}
                        {% else %}
                            <svg class="diff-icon" width="24" height="24" style="color: var(--diff-locked); cursor: pointer;" data-bs-toggle="modal" data-bs-target="#membersExclusiveModal"><use href="/difficulty-icons-sprite.svg#diff-locked"/></svg>
                        {% endif %}
                        {% if pieces_page is not null %}
                            {# Looks like the plain text it was; leads to the same page as the breadcrumb #}
                            <a class="text-reset" href="{{ pieces_page.url }}" title="{{ pieces_page.name }}"><small class="fw-bold">{{ 'pieces_count'|trans({ '%count%': puzzle.piecesCount })|raw }}</small></a>
                        {% else %}
                            <small class="fw-bold">{{ 'pieces_count'|trans({ '%count%': puzzle.piecesCount })|raw }}</small>
                        {% endif %}
                    </span>
                </div>
                <div>
                    <div class="fs-sm manufacturer-name">
                        {% if puzzle.manufacturerSlug is not null %}
                            <a href="{{ path('brand_puzzles', {slug: puzzle.manufacturerSlug}) }}">{{ puzzle.manufacturerName }}</a>
                        {% else %}
                            {{ puzzle.manufacturerName }}
                        {% endif %}
                        {# Like the EAN: a secret puzzle's product number would give it away while its image is embargoed #}
                        {% if puzzle.puzzleIdentificationNumber is not null and not is_image_hidden %}
                            <br class="d-none d-md-block"><small class="text-muted">{{ puzzle.puzzleIdentificationNumber }}</small>
                        {% endif %}
                    </div>

                    {% if puzzle.puzzleEan and not is_image_hidden %}
                        <small class="text-muted"><i class="bi-upc-scan"></i> {{ puzzle.puzzleEan }}</small>
                    {% endif %}

                    {% if tags %}
                        <p class="mb-0">
                            {# A tag links to its competition's page; one without a publicly visible competition stays
                               a plain badge - never a ?tag= filter URL, crawlers get an empty canonicalised shell there #}
                            {% for tag in tags %}
                                {% if tag.competition is not null and tag.competition.routeName is not null %}
                                    <a class="badge bg-primary badge-shadow rounded-pill text-white link-light" href="{{ path(tag.competition.routeName, tag.competition.routeParameters) }}"><i class="ci-diamond"></i> {{ tag.name }}</a>
                                {% else %}
                                    <span class="badge bg-primary badge-shadow rounded-pill text-white"><i class="ci-diamond"></i> {{ tag.name }}</span>
                                {% endif %}
                            {% endfor %}
                        </p>
                    {% endif %}
                </div>
            </div>

            {# data-nosnippet: Google used the hidden menu labels as the search snippet ("Suggest a change …");
               it is honoured on div/span/section only, not on the ul #}
            <div class="dropdown" data-nosnippet>
                <button class="btn btn-outline-primary shadow btn-xs dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ci-menu"></i>
                </button>

                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" data-turbo-frame="_top" rel="nofollow" href="{{ path('puzzle_add', {puzzleId: puzzle.puzzleId}) }}">
                            <i class="ci-add me-1"></i> {{  'add_solving'|trans }}
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" data-turbo-frame="_top" rel="nofollow" href="{{ path('stopwatch_puzzle', {puzzleId: puzzle.puzzleId}) }}">
                            <i class="ci-time me-1"></i> {{ 'start_solving'|trans }}
                        </a>
                    </li>

                    {% if logged_user.profile is not null %}
                        <li><hr class="dropdown-divider"></li>
                    {% endif %}

                    {{ include('puzzle/_dropdown_actions.html.twig', {
                        puzzle_id: puzzle.puzzleId,
                        puzzle_statuses: puzzle_statuses,
                        offer_counts: { (puzzle.puzzleId): offers_count },
                        puzzle_name: puzzle.puzzleName,
                    }) }}
                </ul>
            </div>

        </div>

    </div>

    {% if not puzzle.puzzleApproved %}
        <div class="alert-warning alert small my-1" data-nosnippet>{{ 'puzzle_waiting_for_approval'|trans }}</div>
    {% endif %}

    {{ include('puzzle/_difficulty_section.html.twig', {
        puzzle_difficulty: puzzle_difficulty,
        time_prediction: time_prediction,
    }) }}

    <twig:PuzzleTimes puzzleId="{{ puzzle.puzzleId }}" piecesCount="{{ puzzle.piecesCount }}" />

    {# Same brand and piece count (GetRelatedPuzzles): the three most solved plus three picked for this page, so the
       links reach the whole catalogue; the whole brand when the combination is too small #}
    {% if related.puzzles|length >= 2 %}
        <div class="puzzle-related mt-4">
            <h2 class="h5">
                {% if related.samePiecesCount %}
                    {{ 'puzzle_detail.related.title_pieces'|trans({'%brand%': puzzle.manufacturerName, '%pieces%': puzzle.piecesCount}) }}
                {% else %}
                    {{ 'puzzle_detail.related.title'|trans({'%brand%': puzzle.manufacturerName}) }}
                {% endif %}
            </h2>

            <div class="row g-2 g-md-3">
                {% for related_puzzle in related.puzzles %}
                    <div class="col-6 col-md-4 col-lg-2">
                        <a class="card card-body shadow p-2 h-100 text-decoration-none text-center" href="{{ path('puzzle_detail', {puzzleId: related_puzzle.puzzleId}) }}">
                            <img
                                class="rounded-2 mx-auto d-block"
                                style="max-width: 100%; object-fit: contain;"
                                loading="lazy"
                                alt="{{ 'puzzle_img_alt'|trans({'%puzzle%': puzzle.manufacturerName ~ ' ' ~ related_puzzle.puzzleName}) }}"
                                src="{{ related_puzzle.puzzleImage|puzzle_image('puzzle_small') }}"
                                {{ puzzle_image_dimensions(related_puzzle.puzzleImageRatio, 90) }}
                            >
                            <span class="fs-sm text-decoration-underline low-line-height d-block mt-1">{{ related_puzzle.puzzleName }}</span>
                            {# Every card shares the heading's piece count - only the brand-wide fallback names it #}
                            {% if not related.samePiecesCount %}
                                <small class="text-muted">{{ 'pieces_count'|trans({ '%count%': related_puzzle.piecesCount })|raw }}</small>
                            {% endif %}
                        </a>
                    </div>
                {% endfor %}
            </div>

            {% if related.samePiecesCount and catalogue_links.linksBrandPiecesPage %}
                <p class="mt-2 mb-0">
                    <a href="{{ pieces_page.url }}">{{ 'brand_pieces_hub.all_puzzles'|trans({'%brand%': puzzle.manufacturerName, '%pieces%': puzzle.piecesCount}) }}</a>
                </p>
            {% elseif catalogue_links.linksBrandHub %}
                <p class="mt-2 mb-0">
                    <a href="{{ path('brand_puzzles', {slug: catalogue_links.brandSlug}) }}">{{ 'puzzle_detail.related.view_all'|trans({'%brand%': puzzle.manufacturerName}) }}</a>
                </p>
            {% endif %}
        </div>
    {% endif %}

    {# Facts about the puzzle for readers who scroll this far (and for search engines) - deliberately at the
       bottom: the top of the page belongs to the puzzle and its leaderboard (Jan, 2026-09-30) #}
    <div class="mt-5 pt-3 border-top">
        <h2 class="puzzle-summary-heading h6 text-muted mb-2">{{ 'puzzle_detail.summary.heading'|trans }}</h2>
        {{ include('puzzle/_summary.html.twig', {
            puzzle: puzzle,
            summary: puzzle_summary,
            is_image_hidden: is_image_hidden,
        }) }}
    </div>

{% endblock %}
