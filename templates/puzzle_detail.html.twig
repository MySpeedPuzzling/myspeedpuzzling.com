{% extends 'base.html.twig' %}

{# The same public facts as the summary paragraph (puzzle/_summary.html.twig), EAN only while the image is not
   embargoed. One EAN is enough here - a puzzle may list several (one per edition or region). #}
{% set puzzle_meta_ean = (puzzle.puzzleEan and not is_image_hidden)
    ? 'puzzle_detail.meta.ean'|trans({'%ean%': puzzle_eans(puzzle.puzzleEan)|first})
    : ''
%}
{# What crawlers read names the puzzle in the page language too (docs/features/puzzle-names/README.md "SEO"): the
   name in the page language next to the main title - never the signed-in viewer's country language, every guest of
   one URL gets the same HTML #}
{% set page_local_name = puzzle_page_local_name(puzzle.puzzleAlternativeNames, puzzle.puzzleName) %}
{% set puzzle_meta_parameters = {
    '%brand%': puzzle.manufacturerName,
    '%name%': page_local_name is not null
        ? 'puzzle_detail.meta.name_with_local_name_description'|trans({'%name%': puzzle.puzzleName, '%local_name%': page_local_name.name})
        : puzzle.puzzleName,
    '%pieces%': puzzle.piecesCount,
    '%ean%': puzzle_meta_ean,
} %}
{% if puzzle_summary.hasSingleSoloTime %}
    {% set puzzle_meta_description = 'puzzle_detail.meta.description_with_single_time'|trans(puzzle_meta_parameters|merge({
        '%fastest%': puzzle_summary.fastestTimeSolo|compactTime,
    })) %}
{% elseif puzzle_summary.hasSoloTimes %}
    {% set puzzle_meta_description = 'puzzle_detail.meta.description_with_times'|trans(puzzle_meta_parameters|merge({
        '%median%': puzzle_summary.medianTimeSolo|compactTime,
        '%fastest%': puzzle_summary.fastestTimeSolo|compactTime,
        '%count%': puzzle_summary.soloSolvesCount,
    })) %}
{% elseif puzzle_summary.hasGroupTimes %}
    {% set puzzle_meta_description = 'puzzle_detail.meta.description_no_solo_times'|trans(puzzle_meta_parameters) %}
{% else %}
    {% set puzzle_meta_description = 'puzzle_detail.meta.description'|trans(puzzle_meta_parameters) %}
{% endif %}

{# The catalogue pages above this puzzle (PuzzleCatalogueLinks): the breadcrumb, the piece count in the header and
   the related puzzles all link the same ones. The brand × pieces page only when it is indexable, otherwise the
   pieces hub of every brand; an odd piece count has neither. #}
{% if catalogue_links.linksBrandPiecesPage %}
    {% set pieces_page = {
        url: path('brand_pieces_puzzles', {slug: catalogue_links.brandSlug, pieces: puzzle.piecesCount}),
        name: 'brand_pieces_hub.title'|trans({'%brand%': puzzle.manufacturerName, '%pieces%': puzzle.piecesCount}),
        label: 'puzzle_detail.breadcrumb.pieces'|trans({'%pieces%': puzzle.piecesCount}),
        fixed: true,
    } %}
{% elseif catalogue_links.linksPiecesHub %}
    {% set pieces_page = {
        url: path('pieces_puzzles', {pieces: puzzle.piecesCount}),
        name: 'brand_hub.pieces_link'|trans({'%pieces%': puzzle.piecesCount}),
        label: 'brand_hub.pieces_link'|trans({'%pieces%': puzzle.piecesCount}),
        fixed: true,
    } %}
{% else %}
    {% set pieces_page = null %}
{% endif %}

{# name = BreadcrumbList JSON-LD, label = the visible line, which stays short: the brand precedes the piece count.
   fixed = a short level that never gives way - a long brand or puzzle name is cut instead. #}
{% set breadcrumb = [{
    name: 'puzzle_detail.breadcrumb.database'|trans,
    label: 'puzzle_detail.breadcrumb.database'|trans,
    url: path('puzzles'),
}] %}
{% if catalogue_links.linksBrandHub %}
    {% set breadcrumb = breadcrumb|merge([{
        name: puzzle.manufacturerName,
        label: puzzle.manufacturerName,
        url: path('brand_puzzles', {slug: catalogue_links.brandSlug}),
    }]) %}
{% endif %}
{% if pieces_page is not null %}
    {% set breadcrumb = breadcrumb|merge([pieces_page]) %}
{% endif %}
{# Without a brand level the brand stays in the puzzle's own name #}
{% set breadcrumb = breadcrumb|merge([{
    name: catalogue_links.linksBrandHub ? puzzle.puzzleName : puzzle.manufacturerName ~ ' ' ~ puzzle.puzzleName,
    label: puzzle.puzzleName,
    url: null,
}]) %}

{% block title %}
    {%- if page_local_name is not null -%}
        {{ 'puzzle_detail.meta.title_with_local_name'|trans({ '%brand%': puzzle.manufacturerName, '%name%': puzzle.puzzleName, '%local_name%': page_local_name.name, '%pieces%': puzzle.piecesCount }) }}
    {%- else -%}
        {{ 'puzzle_detail.meta.title'|trans({ '%brand%': puzzle.manufacturerName, '%name%': puzzle.puzzleName, '%pieces%': puzzle.piecesCount }) }}
    {%- endif -%}
{% endblock %}
{# Google shows the site name on its own - the title is all puzzle (and long with a second name) #}
{% block title_suffix %}{% endblock %}
{% block meta_description %}{{ puzzle_meta_description }}{% endblock %}
{# puzzle_large: 1200 px JPEG with metadata stripped - link previews show a large card, and it is never
   the uploaded original (older uploads may still carry EXIF/GPS) #}
{% block og_image %}{% if puzzle.puzzleImage is not null %}{{ absolute_url(puzzle.puzzleImage|thumbnail('puzzle_large')) }}{% else %}{{ parent() }}{% endif %}{% endblock %}
{% block robots %}
    {% if is_image_hidden %}
        <meta name="robots" content="noindex, nofollow">
    {% else %}
        <meta name="robots" content="index, follow">
    {% endif %}
{% endblock %}

{% block json_ld %}
    {{ parent() }}
    {# Google requires offers, review or aggregateRating on Product — only emit the block when real marketplace offers exist #}
    {% if marketplace_offers is not empty %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ puzzle.puzzleName|json_ld }},
        {% if not puzzle.puzzleAlternativeNames.isEmpty() %}
        "alternateName": {{ puzzle.puzzleAlternativeNames.all()|map(other => other.name)|json_ld }},
        {% endif %}
        "brand": {
            "@type": "Brand",
            "name": {{ puzzle.manufacturerName|json_ld }}
        },
        {% if puzzle.puzzleImage is not null and not is_image_hidden %}
        "image": {{ absolute_url(puzzle.puzzleImage|thumbnail('puzzle_large'))|json_ld }},
        {% endif %}
        {# The codes stay out while the image is embargoed, as everywhere else on the page. Only barcodes with a right
           check digit, each one (EanList::gtins()) #}
        {% if not is_image_hidden %}
            {% for gtin_property, gtins in puzzle_gtins(puzzle.puzzleEan) %}
                {% if gtins is not empty %}
        "{{ gtin_property }}": {{ (gtins|length == 1 ? gtins|first : gtins)|json_ld }},
                {% endif %}
            {% endfor %}
        {% endif %}
        {# schema.org takes one value per property: the first brand code - the first edition's, a merge keeps the
           survivor's first #}
        {% set product_brand_code = puzzle_brand_codes(puzzle.puzzleIdentificationNumber)|first %}
        {% if product_brand_code and not is_image_hidden %}
        "sku": {{ product_brand_code|json_ld }},
        "mpn": {{ product_brand_code|json_ld }},
        {% endif %}
        "description": {{ puzzle_meta_description|json_ld }},
        "url": {{ url('puzzle_detail', {puzzleId: puzzle.puzzleId})|json_ld }},
        "offers": [
            {% for offer in marketplace_offers %}
            {
                "@type": "Offer",
                "price": {{ offer.price|json_ld }},
                "priceCurrency": {{ offer.currency|json_ld }},
                "itemCondition": {{ offer.condition.toSchemaOrgCondition|json_ld }},
                "availability": "https://schema.org/InStock",
                "url": {{ url('marketplace_puzzle', {puzzleId: puzzle.puzzleId})|json_ld }}
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ],
        "additionalProperty": [
            {
                "@type": "PropertyValue",
                "name": "Number of pieces",
                "value": {{ puzzle.piecesCount|json_ld }}
            }
        ]
    }
    </script>
    {% endif %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {% for level in breadcrumb %}
            {
                "@type": "ListItem",
                "position": {{ loop.index }},
                "name": {{ level.name|json_ld }}{% if level.url is not null %},
                "item": {{ absolute_url(level.url)|json_ld }}{% endif %}

            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    }
    </script>
{% endblock %}

{% block content %}
    <div data-nosnippet>
        {{ include('_return_back_button.html.twig') }}
    </div>

    {# One short line that never wraps - the top of the page stays the puzzle itself. Long names end in an ellipsis,
       below sm the database is just an icon and below md the puzzle's own name is left out (the H1 says it right
       underneath). The BreadcrumbList JSON-LD above carries the same levels. The icon stands alone, so it is centred on
       the line (its glyph sits too high on the baseline) without the theme's gap for a following label. #}
    {# Phones skip it: "500 pieces · Brand" right under the name links to the same two pages #}
    <nav aria-label="breadcrumb" class="puzzle-breadcrumb mb-3 d-none d-sm-block">
        <ol class="breadcrumb flex-nowrap align-items-center mb-0" style="font-size: 0.8rem;">
            {% for level in breadcrumb %}
                {% if loop.first %}
                    <li class="breadcrumb-item flex-shrink-0">
                        <a href="{{ level.url }}" aria-label="{{ level.label }}" title="{{ level.label }}"><i class="bi bi-puzzle d-block d-sm-none me-0" aria-hidden="true"></i><span class="d-none d-sm-inline">{{ level.label }}</span></a>
                    </li>
                {% elseif loop.last %}
                    <li class="breadcrumb-item active text-truncate d-none d-md-block" style="min-width: 0;" aria-current="page">{{ level.label }}</li>
                {% else %}
                    <li class="breadcrumb-item {{ (level.fixed ?? false) ? 'flex-shrink-0' : 'text-truncate' }}" style="min-width: 0;"><a href="{{ level.url }}">{{ level.label }}</a></li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>

    {# Desktop (992 px+): the puzzle on the left - large image, the core facts (name, pieces, brand, difficulty) and the
       two things people come to do (add a time, start the stopwatch) - and its rankings on the right, so a leaderboard
       row is not stretched across the whole page. Below 992 px it is one column in the same order as before: head,
       insights, rankings. Product codes, EANs and events are details, folded away (user feedback) #}
    <div class="puzzle-layout" data-controller="compact-bar">
        {# Takes the header's place once its buttons scroll away (compact_bar_controller.js): which puzzle this is, and ⋯
           with every action - the leaderboard below can be hundreds of rows long #}
        <div class="compact-bar" data-compact-bar-target="bar" inert>
            <div class="container compact-bar-inner">
                <img class="compact-bar-thumb" alt="" src="{{ puzzle.puzzleImage|puzzle_image('puzzle_small') }}" loading="lazy">
                <div class="compact-bar-text">
                    <div class="compact-bar-name">{{ puzzle.puzzleName }}</div>
                    <div class="compact-bar-meta">{{ include('_pieces_brand.html.twig', {pieces: puzzle.piecesCount, brand: puzzle.manufacturerName}) }}</div>
                </div>
                {{ include('puzzle/_detail_actions_menu.html.twig') }}
            </div>
        </div>

        <aside class="puzzle-aside">
            <div class="puzzle-head">
                <div class="puzzle-head-image">
                    <div class="gallery">
                        {% if puzzle.puzzleImage is not null %}
                            {# The large stripped preset, not the uploaded original (older uploads may carry EXIF/GPS) #}
                            <a class="gallery-item gallery-item-inline-block" href="{{ puzzle.puzzleImage|thumbnail('puzzle_large') }}">
                                {# Always the whole box in its own proportions, never cropped: at most 112 px each way on phones, 160 px on tablets,
                                   340 px wide on desktop - the 900 px preset keeps it sharp there, phones still load the 400 px one #}
                                <img alt="{{ 'puzzle_img_alt'|trans({'%puzzle%': puzzle.manufacturerName ~ ' ' ~ puzzle.puzzleName}) }}" src="{{ puzzle.puzzleImage|puzzle_image('puzzle_medium') }}" srcset="{{ puzzle.puzzleImage|puzzle_image('puzzle_medium') }} 400w, {{ puzzle.puzzleImage|puzzle_image('puzzle_large') }} 900w" sizes="(min-width: 992px) 340px, (min-width: 768px) 160px, 112px" {{ puzzle_image_dimensions(puzzle.puzzleImageRatio, 110) }} fetchpriority="high">
                            </a>
                        {% else %}
                            <img alt="{{ 'puzzle_img_alt'|trans({'%puzzle%': puzzle.manufacturerName ~ ' ' ~ puzzle.puzzleName}) }}" src="{{ puzzle.puzzleImage|puzzle_image('puzzle_medium') }}" {{ puzzle_image_dimensions(puzzle.puzzleImageRatio, 110) }} fetchpriority="high">
                        {% endif %}
                    </div>
                </div>

                <div class="puzzle-head-info">
                    {# Name, then "500 pieces · Brand" on one line under it; the piece count stays in the H1 (and links to
                       the same page as the breadcrumb) #}
                    <div class="puzzle-head-titles">
                        <h1 class="puzzle-head-title">
                            <span class="puzzle-head-name"{% if puzzle.nameLanguage is not null %} lang="{{ puzzle.nameLanguage }}"{% endif %}>{{ puzzle.puzzleName }}</span>
                            {{ include('puzzle/_name.html.twig', {
                                name: puzzle.puzzleName,
                                alternative_names: puzzle.puzzleAlternativeNames,
                                class: 'puzzle-head-local-name',
                            }, with_context = false) }}
                            <span class="puzzle-head-pieces">
                                {%- if pieces_page is not null -%}
                                    <a class="text-reset text-decoration-none" href="{{ pieces_page.url }}" title="{{ pieces_page.name }}">{{ 'pieces_count'|trans({ '%count%': puzzle.piecesCount })|raw }}</a>
                                {%- else -%}
                                    {{ 'pieces_count'|trans({ '%count%': puzzle.piecesCount })|raw }}
                                {%- endif -%}
                            </span>
                        </h1>
                        <span class="puzzle-head-brand">·
                            {% if puzzle.manufacturerSlug is not null %}
                                <a href="{{ path('brand_puzzles', {slug: puzzle.manufacturerSlug}) }}">{{ puzzle.manufacturerName }}</a>
                            {% else %}
                                {{ puzzle.manufacturerName }}
                            {% endif %}
                        </span>
                    </div>

                    <div class="puzzle-head-chips">
                        {% if logged_user.profile is not null and logged_user.profile.activeMembership %}
                            <span class="puzzle-head-difficulty">
                                {% if puzzle_difficulty is not null and puzzle_difficulty.difficultyScore is not null %}
                                    {% set dt_name = puzzle_difficulty.difficultyTier.name|lower %}
                                    {% set dt_icon_map = {'veryeasy':'diff-very-easy','easy':'diff-easy','average':'diff-average','challenging':'diff-challenging','hard':'diff-hard','veryhard':'diff-very-hard'} %}
                                    <svg class="diff-icon" width="24" height="24" style="color: var(--{{ dt_icon_map[dt_name] ?? 'diff-unknown' }})"><use href="/difficulty-icons-sprite.svg#{{ dt_icon_map[dt_name] ?? 'diff-unknown' }}"/></svg>
                                    <small>{{ puzzle_difficulty.difficultyTier.translationKey|trans }}</small>
                                {% else %}
                                    <svg class="diff-icon" width="24" height="24" style="color: var(--diff-unknown)"><use href="/difficulty-icons-sprite.svg#diff-unknown"/></svg>
                                    <small class="text-muted">{{ 'puzzle_intelligence.difficulty.not_enough_data'|trans }}</small>
                                {% endif %}
                            </span>
                        {% else %}
                            <span class="puzzle-head-difficulty" role="button" title="{{ 'difficulty_ranking.difficulty_locked'|trans }}" data-bs-toggle="modal" data-bs-target="#membersExclusiveModal">
                                <svg class="diff-icon" width="24" height="24" style="color: var(--diff-locked)"><use href="/difficulty-icons-sprite.svg#diff-locked"/></svg>
                                <small>{{ 'puzzle_intelligence.difficulty.tier_label'|trans }}</small>
                            </span>
                        {% endif %}

                        <div class="puzzle-head-badges" style="display: contents;" id="puzzle-badges-{{ puzzle.puzzleId }}">
                            {{ include('puzzle/_badges.html.twig', {
                                puzzle_id: puzzle.puzzleId,
                                puzzle_statuses: puzzle_statuses,
                            }) }}
                            {% if offers_count > 0 %}
                                {% set puzzleDetailReturnUrl = path('puzzle_detail', {puzzleId: puzzle.puzzleId, return: app.request.query.get('return'), return_title: app.request.query.get('return_title')}) %}
                                <a href="{{ path('marketplace_puzzle', {puzzleId: puzzle.puzzleId, return: puzzleDetailReturnUrl, return_title: puzzle.puzzleName}) }}"
                                   class="puzzle-offers-badge mt-1 badge bg-danger badge-shadow rounded-pill text-white link-light">
                                    <i class="bi bi-shop me-1"></i>
                                    {% if lowest_offer_prices is not empty %}
                                        {# The cheapest priced offer - the prices of the Product structured data, visible
                                           on the page. Never compared across currencies: one price per currency. #}
                                        {% set offer_prices = [] %}
                                        {% for currency, price in lowest_offer_prices %}
                                            {% set offer_prices = offer_prices|merge([price|format_currency(currency, {fraction_digit: price == price|round ? 0 : 2}, app.request.locale)]) %}
                                        {% endfor %}
                                        {{ 'puzzler_offers.badge_from'|trans({'%count%': offers_count, '%price%': offer_prices|join(' / ')}) }}
                                    {% else %}
                                        {{ 'puzzler_offers.badge'|trans({'%count%': offers_count}) }}
                                    {% endif %}
                                </a>
                            {% endif %}
                            {% if has_pending_proposals %}
                                <a href="{{ path('puzzle_pending_proposals', {puzzleId: puzzle.puzzleId}) }}"
                                   class="mt-1 badge bg-warning text-dark rounded-pill"
                                   rel="nofollow"
                                   data-turbo="true"
                                   data-turbo-frame="modal-frame">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    {{ 'pending_proposals.badge'|trans }}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {# The two things people come here to do, then ⋯ with every action on the puzzle #}
            <div class="puzzle-head-actions" data-nosnippet data-compact-bar-target="head">
                <a class="btn btn-primary" data-turbo-frame="_top" rel="nofollow" href="{{ path('puzzle_add', {puzzleId: puzzle.puzzleId}) }}">
                    <i class="ci-add me-1"></i> {{ 'add_solving'|trans }}
                </a>
                <a class="btn btn-outline-primary" data-turbo-frame="_top" rel="nofollow" href="{{ path('stopwatch_puzzle', {puzzleId: puzzle.puzzleId}) }}">
                    <i class="ci-time me-1"></i> {{ 'start_solving'|trans }}
                </a>
                {{ include('puzzle/_detail_actions_menu.html.twig') }}
            </div>

            {# Moderators and admins change the puzzle straight away and see who changed what (admin pages) #}
            {% if is_granted('PUZZLE_MODERATION_ACCESS') %}
                <div class="d-flex flex-wrap gap-2 mt-2" data-nosnippet>
                    <a class="btn btn-sm btn-outline-secondary" rel="nofollow" href="{{ path('admin_edit_puzzle', {puzzleId: puzzle.puzzleId, return: app.request.requestUri, return_title: puzzle.puzzleName}) }}">
                        <i class="bi bi-pencil me-1" aria-hidden="true"></i> {{ 'puzzle_detail.moderation.edit'|trans }}
                    </a>
                    <a class="btn btn-sm btn-outline-secondary" rel="nofollow" href="{{ path('admin_puzzle_history', {puzzleId: puzzle.puzzleId, return: app.request.requestUri, return_title: puzzle.puzzleName}) }}">
                        <i class="bi bi-clock-history me-1" aria-hidden="true"></i> {{ 'puzzle_detail.moderation.history'|trans }}
                    </a>
                </div>
            {% endif %}

            {# Like the EAN: a secret puzzle's product number would give it away while its image is embargoed #}
            {% set has_codes = not is_image_hidden and (puzzle.puzzleIdentificationNumber is not null or puzzle.puzzleEan) %}
            {# "Also known as": guests (and crawlers) get it in "About this puzzle" at the bottom, once #}
            {% set has_other_names = not show_seo_sections and not puzzle.puzzleAlternativeNames.isEmpty() %}
            {% set is_member = logged_user.profile is not null and logged_user.profile.activeMembership %}
            <div class="puzzle-head-toggles" data-nosnippet>
                <button class="puzzle-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#puzzleInsights" aria-expanded="false" aria-controls="puzzleInsights">
                    <i class="bi bi-lightbulb" aria-hidden="true"></i>
                    {{ 'puzzle_intelligence.insights.title'|trans }}
                    {% if not is_member %}<i class="ci-locked" aria-hidden="true"></i>{% endif %}
                    <i class="bi bi-chevron-down puzzle-toggle-chevron" aria-hidden="true"></i>
                </button>
                {% if has_codes or tags or has_other_names %}
                    <button class="puzzle-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#puzzleDetails" aria-expanded="false" aria-controls="puzzleDetails">
                        {{ 'puzzle_detail.details'|trans }}
                        <i class="bi bi-chevron-down puzzle-toggle-chevron" aria-hidden="true"></i>
                    </button>
                {% endif %}
            </div>

            {% if has_codes or tags or has_other_names %}
                <div class="collapse" id="puzzleDetails">
                    <div class="puzzle-details-body">
                        {% if has_other_names %}
                            <div class="puzzle-details-names small mb-1">
                                <span class="d-block text-muted">{{ 'puzzle_detail.summary.facts.also_known_as'|trans }}</span>
                                {{ include('puzzle/_other_names.html.twig', {alternative_names: puzzle.puzzleAlternativeNames}, with_context = false) }}
                            </div>
                        {% endif %}
                        {# Every code on its own line - a puzzle may carry one per edition or region #}
                        {% if not is_image_hidden %}
                            {% for brand_code in puzzle_brand_codes(puzzle.puzzleIdentificationNumber) %}
                                <div><small class="text-muted">{{ brand_code }}</small></div>
                            {% endfor %}
                            {% for ean in puzzle_eans(puzzle.puzzleEan) %}
                                <div><small class="text-muted"><i class="bi-upc-scan" aria-hidden="true"></i> {{ ean }}</small></div>
                            {% endfor %}
                        {% endif %}
                        {% if tags %}
                            <p class="mb-0 mt-1">
                                {# A tag links to its competition's page; one without a publicly visible competition stays
                                   a plain badge - never a ?tag= filter URL, crawlers get an empty canonicalised shell there #}
                                {% for tag in tags %}
                                    {% if tag.competition is not null and tag.competition.routeName is not null %}
                                        <a class="badge bg-primary badge-shadow rounded-pill text-white link-light" href="{{ path(tag.competition.routeName, tag.competition.routeParameters) }}"><i class="ci-diamond"></i> {{ tag.name }}</a>
                                    {% else %}
                                        <span class="badge bg-primary badge-shadow rounded-pill text-white"><i class="ci-diamond"></i> {{ tag.name }}</span>
                                    {% endif %}
                                {% endfor %}
                            </p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {% if not puzzle.puzzleApproved %}
                <div class="alert-warning alert small my-1" data-nosnippet>{{ 'puzzle_waiting_for_approval'|trans }}</div>
            {% endif %}

            {{ include('puzzle/_difficulty_section.html.twig', {
                puzzle_difficulty: puzzle_difficulty,
                time_prediction: time_prediction,
            }) }}

        </aside>

        <div class="puzzle-main">
            <twig:PuzzleTimes puzzleId="{{ puzzle.puzzleId }}" piecesCount="{{ puzzle.piecesCount }}" />
        </div>
    </div>

    {# Same brand and piece count (GetRelatedPuzzles): the three most solved plus three picked for this page, so the
       links reach the whole catalogue; the whole brand when the combination is too small #}
    {# This section and "About this puzzle" below: guests and search engines only (PuzzleDetailController) #}
    {% if related is not null and related.puzzles|length >= 2 %}
        <section class="puzzle-section puzzle-related">
            <h2 class="puzzle-section-title">
                {% if related.samePiecesCount %}
                    {{ 'puzzle_detail.related.title_pieces'|trans({'%brand%': puzzle.manufacturerName, '%pieces%': puzzle.piecesCount}) }}
                {% else %}
                    {{ 'puzzle_detail.related.title'|trans({'%brand%': puzzle.manufacturerName}) }}
                {% endif %}
            </h2>

            <ul class="puzzle-related-list">
                {% for related_puzzle in related.puzzles %}
                    <li>
                        <a class="puzzle-related-card" href="{{ path('puzzle_detail', {puzzleId: related_puzzle.puzzleId}) }}">
                            <span class="puzzle-related-image">
                                <img
                                    loading="lazy"
                                    alt="{{ 'puzzle_img_alt'|trans({'%puzzle%': puzzle.manufacturerName ~ ' ' ~ related_puzzle.puzzleName}) }}"
                                    src="{{ related_puzzle.puzzleImage|puzzle_image('puzzle_small') }}"
                                    {% if related_puzzle.puzzleImage %}
                                        srcset="{{ related_puzzle.puzzleImage|puzzle_image('puzzle_small') }} 200w, {{ related_puzzle.puzzleImage|puzzle_image('puzzle_medium') }} 400w"
                                        sizes="(min-width: 1200px) 190px, (min-width: 768px) 140px, 104px"
                                    {% endif %}
                                    {{ puzzle_image_dimensions(related_puzzle.puzzleImageRatio, 200) }}
                                >
                            </span>
                            <span class="puzzle-related-name">{{ related_puzzle.puzzleName }}</span>
                            {# Every card shares the heading's piece count - only the brand-wide fallback names it #}
                            {% if not related.samePiecesCount %}
                                <small class="puzzle-related-pieces">{{ 'pieces_count'|trans({ '%count%': related_puzzle.piecesCount })|raw }}</small>
                            {% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>

            {% if related.samePiecesCount and catalogue_links.linksBrandPiecesPage %}
                <p class="puzzle-related-more">
                    <a class="puzzle-related-all" href="{{ pieces_page.url }}">{{ 'brand_pieces_hub.all_puzzles'|trans({'%brand%': puzzle.manufacturerName, '%pieces%': puzzle.piecesCount}) }}<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </p>
            {% elseif catalogue_links.linksBrandHub %}
                <p class="puzzle-related-more">
                    <a class="puzzle-related-all" href="{{ path('brand_puzzles', {slug: catalogue_links.brandSlug}) }}">{{ 'puzzle_detail.related.view_all'|trans({'%brand%': puzzle.manufacturerName}) }}<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </p>
            {% endif %}
        </section>
    {% endif %}

    {# Facts about the puzzle for readers who scroll this far (and for search engines) - deliberately at the
       bottom: the top of the page belongs to the puzzle and its leaderboard (Jan, 2026-09-30) #}
    {% if show_seo_sections %}
        <div class="puzzle-section">
            <h2 class="puzzle-section-title puzzle-summary-heading">{{ 'puzzle_detail.summary.heading'|trans }}</h2>
            {{ include('puzzle/_summary.html.twig', {
                puzzle: puzzle,
                summary: puzzle_summary,
                is_image_hidden: is_image_hidden,
            }) }}
        </div>
    {% endif %}

{% endblock %}
