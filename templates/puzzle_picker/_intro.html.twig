{# The intro state of the signed-in tool (bare visit): no puzzle yet. A friendly nudge to pick a
   preset, set filters, or let the wheel decide. Expects: next_seed #}
{% set surprise_params = constant('SpeedPuzzling\\Web\\Value\\PuzzlePickerPreset::SurpriseMe').queryParams|merge({seed: next_seed}) %}
<div class="card card-body shadow text-center p-4 p-md-5 mb-4 puzzle-picker-intro">
    <div class="display-5 text-primary mb-2"><i class="bi bi-shuffle"></i></div>
    <h2 class="h4 mb-2">{{ 'puzzle_picker.intro.title'|trans }}</h2>
    <p class="text-muted mb-4 mx-auto" style="max-width: 34rem;">{{ 'puzzle_picker.intro.text'|trans }}</p>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a class="btn btn-primary btn-lg puzzle-picker-intro-surprise" rel="nofollow" href="{{ path('puzzle_picker', surprise_params) }}">
            <i class="bi bi-shuffle me-1"></i>{{ 'puzzle_picker.presets.surprise_me'|trans }}
        </a>
    </div>
</div>
