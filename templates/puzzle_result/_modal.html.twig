{#
    Result detail in the global modal: the puzzle and whose results with the best time stay pinned in the header,
    the chart and the attempts scroll - on phones it is a near full screen sheet: a swipe down from the header (or from
    the content at its top) closes it (bottom_sheet_controller.js, GEST-02, decision 58 D-2). Back closes it
    (data-modal-history, dynamic_modal_controller.js).
#}
<turbo-frame id="modal-frame">
    <div data-modal-size="modal-lg" data-modal-scrollable data-modal-sheet data-modal-history data-controller="bottom-sheet">
        <div class="bottom-sheet-top" data-bottom-sheet-target="handle">
            <span class="bottom-sheet-handle" aria-hidden="true"></span>
            <div class="modal-header pr-modal-header">
                <div class="pr-modal-header-top">
                    {{ include('puzzle_result/_puzzle.html.twig', {result: result, heading: 'h5', difficulty_tiers: difficulty_tiers}) }}
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'puzzle_result.close'|trans }}"></button>
                </div>
                {# No player card triggers inside the modal (docs/features/navigation README §4.8): the names link to the profile #}
                {{ include('puzzle_result/_head.html.twig', {result: result, in_modal: true}) }}
            </div>
        </div>
        <div class="modal-body pr-modal-body" data-bottom-sheet-target="body">
            {{ include('puzzle_result/_body.html.twig', {result: result}) }}
        </div>
    </div>
</turbo-frame>
