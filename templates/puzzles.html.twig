{% extends 'base.html.twig' %}

{% block robots %}
    {# Only a text search de-indexes the page.
       The canonical (unfiltered route URL) already de-duplicates brand/tag/pieces filtered views.
       Note: the <head> renders once on full page load, so live filter changes do not re-render this meta. #}
    {% if app.request.query.has('search') %}
        <meta name="robots" content="noindex, nofollow">
    {% else %}
        <meta name="robots" content="index, follow">
    {% endif %}
{% endblock %}

{% block title %}{{ 'puzzle_overview.meta.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'puzzle_overview.meta.description'|trans }}{% endblock %}

{% block content %}
    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
        <h1 class="mb-0">{{ 'puzzle_overview.title'|trans }}</h1>
        <a href="{{ path('puzzle_picker') }}" class="btn btn-xs btn-outline-primary ms-1 puzzle-picker-entry" title="{{ 'puzzle_picker.title'|trans }}">
            <i class="bi bi-shuffle me-1"></i>{{ 'puzzle_picker.menu_label'|trans }}
        </a>
        <a href="{{ path('puzzle_brands') }}" class="btn btn-xs btn-outline-secondary">{{ 'brand_directory.all_brands_link'|trans }}</a>
    </div>

    {# Default view renders server-side: page one comes from the app cache
       (initial_puzzles_v3), so the synchronous render is cheap and ships
       crawlable puzzle links + content in the initial HTML. Filtered/search
       deep links keep loading="defer" for a fast first paint - those states
       are noindexed or canonicalized to the clean URL anyway. #}
    {% if app.request.query.count > 0 %}
        <twig:PuzzleSearch loading="defer" />
    {% else %}
        <twig:PuzzleSearch />
    {% endif %}

    {# The database in numbers, then plain links into the catalogue pages - the most solved brands, the A–Z
       directory and every pieces hub (docs/features/seo/implementation-plan-2026-10.md, WS-F2). Under the list:
       the search comes first. #}
    <section class="puzzle-catalogue-browse mt-5 pt-3 border-top">
        <div class="mb-4">
            {{ include('_catalogue_numbers.html.twig', {catalogue: catalogue, variant: 'compact'}) }}
        </div>

        <h2 class="h6 text-muted mb-2">{{ 'puzzle_overview.browse.by_brand'|trans }}</h2>
        <p class="mb-3">
            {% for brand in popular_brands %}
                <a class="badge bg-primary badge-shadow rounded-pill text-white link-light" href="{{ path('brand_puzzles', {slug: brand.slug}) }}">{{ brand.brandName }}</a>
            {% endfor %}
            <a class="small d-inline-block ms-1" href="{{ path('puzzle_brands') }}">{{ 'brand_directory.all_brands_link'|trans }}</a>
        </p>

        <h2 class="h6 text-muted mb-2">{{ 'puzzle_overview.browse.by_size'|trans }}</h2>
        <p class="mb-0">
            {% for pieces in allowed_pieces %}
                <a class="badge bg-primary badge-shadow rounded-pill text-white link-light" href="{{ path('pieces_puzzles', {pieces: pieces}) }}">{{ 'pieces_count'|trans({'%count%': pieces})|raw }}</a>
            {% endfor %}
            {# The guides are English-only - the label says so in every other language #}
            <a class="small d-inline-block ms-1" href="{{ path('guide_average_puzzle_time') }}" hreflang="en">{{ 'catalogue.guide.average_time'|trans }}</a>
        </p>
    </section>

{% endblock %}
