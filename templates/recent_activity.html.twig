{% extends 'base.html.twig' %}

{% block title %}{{ 'recent_activity.meta.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'recent_activity.meta.description'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'recent_activity.meta.title'|trans }}</h1>

    {# Refreshes every minute while somebody looks; the line above the table counts down and pauses
       (docs/features/live-activity-feed.md) #}
    <div class="live-refresh-anchor" data-controller="live-refresh">
        {{ include('_live_refresh_status.html.twig') }}

        <twig:RecentActivity limit="100" />
    </div>
{% endblock %}
