{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.password_reset.request_title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <div class="row gy-3 pb-4">
        <div class="col-lg-6 col-md-8">
            <h1 class="h2">{{ 'auth.password_reset.request_title'|trans }}</h1>

            <p class="text-muted">{{ 'auth.password_reset.request_intro'|trans }}</p>

            <div class="card shadow my-3">
                <div class="card-body">
                    <form action="{{ path('request_password_reset') }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token(constant('SpeedPuzzling\\Web\\Controller\\RequestPasswordResetController::CSRF_TOKEN_ID')) }}">

                        <div class="mb-3">
                            <label class="form-label" for="password-reset-email">{{ 'auth.login.email'|trans }}</label>
                            <input
                                class="form-control"
                                type="email"
                                id="password-reset-email"
                                name="email"
                                value="{{ email }}"
                                autocomplete="username"
                                autofocus
                                required
                            >
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-envelope me-1"></i>{{ 'auth.password_reset.request_submit'|trans }}
                        </button>
                    </form>

                    <div class="text-center my-3 text-muted fs-sm">{{ 'auth.login.or'|trans }}</div>

                    {# The faster door for the very common case behind a forgotten password:
                       the manager filed it under the old Auth0 domain (UX funnel §3) #}
                    <a class="btn btn-outline-primary w-100" href="{{ path('sign_in_link_request', {'email': email}) }}">
                        <i class="bi bi-envelope me-1"></i>{{ 'auth.sign_in_link.submit'|trans }}
                    </a>
                </div>
            </div>

            <p class="fs-sm">
                <a href="{{ path('login') }}">{{ 'auth.sign_in_link.back_to_login'|trans }}</a>
            </p>
        </div>

        <div class="col-lg-5 offset-lg-1 col-md-4 text-center d-none d-md-block">
            <img class="img-fluid" src="{{ asset('img/puzzlie-1.png') }}" alt="" width="1000" height="949">
        </div>
    </div>
{% endblock %}
