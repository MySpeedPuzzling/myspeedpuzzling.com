{% extends '_auth_layout.html.twig' %}

{% block title %}{{ 'auth.password_reset.request_title'|trans }}{% endblock %}

{# docs/features/auth-ux-redesign.md §4.5 - one primary action per page; the
   faster door for the usual case behind a forgotten password (the manager
   filed it under the old Auth0 domain, UX funnel §3) is the text line below. #}

{% block auth_content %}
    {{ include('_auth_back_link.html.twig') }}

    <h1 class="auth-title">{{ 'auth.password_reset.request_title'|trans }}</h1>
    <p class="auth-lead">{{ 'auth.password_reset.request_intro'|trans }}</p>

    {% if alert %}
        <div class="alert alert-warning" role="alert">{{ alert }}</div>
    {% endif %}

    <form action="{{ path('request_password_reset') }}" method="post" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token(constant('SpeedPuzzling\\Web\\Controller\\RequestPasswordResetController::CSRF_TOKEN_ID')) }}">

        <div class="mb-3">
            <label class="form-label" for="password-reset-email">{{ 'auth.login.email'|trans }}</label>
            <input
                class="form-control{{ field_error ? ' is-invalid' : '' }}"
                type="email"
                id="password-reset-email"
                name="email"
                value="{{ email }}"
                autocomplete="email"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                enterkeyhint="send"
                required
                {% if field_error %}aria-invalid="true" aria-describedby="password-reset-email-error" autofocus{% elseif email == '' %}autofocus{% endif %}
            >
            {% if field_error %}
                <div class="invalid-feedback d-block" id="password-reset-email-error">{{ field_error }}</div>
            {% endif %}
        </div>

        <button type="submit" class="btn btn-primary w-100" data-turbo-submits-with="{{ 'auth.check_email.sending'|trans }}">
            {{ 'auth.password_reset.request_submit'|trans }}
        </button>
    </form>

    <p class="mt-4 mb-0">
        {{ 'auth.password_reset.just_get_in'|trans }}
        <a class="auth-inline-link" href="{{ path('sign_in_link_request') }}">{{ 'auth.password_reset.get_link_instead'|trans }}</a>
    </p>
{% endblock %}
