{#- "5 minutes ago by Jane" of an import (its importer is null once their account is gone). Variables: log (ResultsImportLog) -#}
{%- if log.importedBy -%}
    {{ 'results_import.history.byline'|trans({'%when%': log.importedAt|ago, '%name%': log.importedBy.name ?? ('#' ~ log.importedBy.code)}) }}
{%- else -%}
