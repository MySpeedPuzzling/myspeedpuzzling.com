{% extends 'base.html.twig' %}

{#
    The results import page of one results source (docs/features/event-results-import/results-import-page.md): "Check
    sheet", the result of an import just made, the latest check's events with their status against what is stored (each
    links to its preview; New and Changed ticked for "Import"), the tabs Google did not give us, the latest imports and
    how the sheet must look (the format's guide). For the organization's team and admins.
    "Your sheet" opens the source's spreadsheet in Google and changes it (results-import-page.md "As built: PR 4").
    Variables: organization (OrganizationDetail), source_id, spreadsheet_id, format (ResultsFormat),
    overview (null|ResultsImportOverview),
    history (list<ResultsImportLog>), just_imported (null|ResultsImportLog), event_links
#}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'results_import.meta_title'|trans({'%organization%': organization.name}) }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    {{ include('_breadcrumb.html.twig', {items: [
        {label: 'events.title'|trans, url: path('events')},
        {label: organization.name, url: path('organization_detail', {slug: organization.slug})},
        {label: 'results_import.title'|trans},
    ]}) }}

    <div class="results-import pb-4" data-results-import>
        <h1 class="h2 mb-2">{{ 'results_import.title'|trans }}</h1>
        <p class="text-muted mb-3">{{ 'results_import.intro'|trans }}</p>

        {% if just_imported %}
            {{ include('results_import/_import_result.html.twig', {log: just_imported}) }}
        {% endif %}

        <div class="card card-body shadow-sm mb-3" id="your-sheet" data-results-import-sheet>
            <h2 class="h6 mb-1">{{ 'results_import.sheet.heading'|trans }}</h2>
            <p class="small mb-2">
                <a href="https://docs.google.com/spreadsheets/d/{{ spreadsheet_id|url_encode }}/edit" target="_blank" rel="noopener noreferrer" class="text-break" data-results-import-sheet-link>
                    <i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i>{{ 'results_import.sheet.open'|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i>
                </a>
            </p>
            <details data-results-import-sheet-change>
                <summary class="small fw-medium">{{ 'results_import.sheet.change'|trans }}</summary>
                <form method="post" action="{{ path('results_import_sheet', {slug: organization.slug, sourceId: source_id}) }}" class="mt-2" data-results-import-sheet-form>
                    <input type="hidden" name="_token" value="{{ csrf_token('results_import_sheet_' ~ source_id) }}">
                    <label for="results-import-sheet-input" class="form-label small fw-medium mb-1">{{ 'results_import.sheet.label'|trans }}</label>
                    <input type="text" class="form-control" id="results-import-sheet-input" name="spreadsheet" required maxlength="2000" autocomplete="off" inputmode="url" placeholder="https://docs.google.com/spreadsheets/d/…" aria-describedby="results-import-sheet-hint">
                    <p class="form-text small mb-2" id="results-import-sheet-hint">{{ 'results_import.sheet.hint'|trans }}</p>
                    <button type="submit" class="btn btn-outline-primary btn-sm" data-results-import-sheet-button>{{ 'results_import.sheet.button'|trans }}</button>
                </form>
            </details>
        </div>

        <div class="card card-body shadow-sm mb-4" data-results-import-check
             data-controller="results-import-check"
             data-results-import-check-busy-value="{{ 'results_import.check.busy'|trans }}">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <form method="post" action="{{ path('results_import_check', {slug: organization.slug, sourceId: source_id}) }}" class="m-0" data-action="submit->results-import-check#start">
                    <input type="hidden" name="_token" value="{{ csrf_token('results_import_check_' ~ source_id) }}">
                    <button type="submit" class="btn btn-primary" data-results-import-check-button data-results-import-check-target="button">
                        <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>{{ 'results_import.check.button'|trans }}
                    </button>
                </form>
                <div class="small">
                    {% if overview %}
                        <div data-results-import-checked-at>
                            {%- if overview.checkedByName -%}
                                {{ 'results_import.check.last_by'|trans({'%when%': overview.checkedAt|ago, '%name%': overview.checkedByName}) }}
                            {%- else -%}
                                {{ 'results_import.check.last'|trans({'%when%': overview.checkedAt|ago}) }}
                            {%- endif -%}
                        </div>
                    {% endif %}
                    <div class="text-muted">{{ 'results_import.check.hint'|trans }}</div>
                </div>
            </div>
            {# Shown while the sheet is read (results_import_check_controller.js) #}
            <div class="mt-3" data-results-import-check-target="status" hidden role="status" aria-live="polite">
                <div class="progress mb-2" style="height: 6px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated w-100"></div>
                </div>
                <div class="small">
                    {{ 'results_import.check.reading'|trans }}
                    <span class="text-muted">({{ 'results_import.check.elapsed'|trans({'%seconds%': '<span data-results-import-check-target="elapsed">0</span>'})|raw }})</span>
                </div>
                <div class="small text-muted" data-results-import-check-target="slow" hidden>{{ 'results_import.check.slow'|trans }}</div>
            </div>
        </div>

        {% if overview is null %}
            <p class="text-muted" data-results-import-never-checked>{{ 'results_import.check.none'|trans }}</p>
        {% elseif overview.readError is not null %}
            <div class="alert alert-danger" role="alert" data-results-import-read-error>
                <p class="mb-1 fw-medium">{{ 'results_import.check.failed'|trans }}</p>
                <p class="mb-1 small">{{ 'results_import.check.failed_hint'|trans }}</p>
                <p class="mb-0 small text-muted text-break">{{ overview.readError }}</p>
            </div>
        {% else %}
            {% if overview.unreadableTabs is not empty %}
                <div class="alert alert-warning" role="status" data-results-import-unreadable>
                    <p class="mb-1">{{ 'results_import.check.unreadable_tabs'|trans }}</p>
                    <ul class="mb-0 small">
                        {% for tab in overview.unreadableTabs %}
                            <li>{{ tab.title }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% if overview.events is empty %}
                <p class="text-muted">{{ 'results_import.check.no_events'|trans }}</p>
            {% else %}
                {{ include('results_import/_event_list.html.twig') }}
            {% endif %}
        {% endif %}

        {% if history is not empty %}
            {{ include('results_import/_history.html.twig') }}
        {% endif %}

        <details class="card card-body shadow-sm mt-4 results-import-guide" data-results-import-guide>
            <summary class="fw-medium">{{ 'results_import.guide.title'|trans }}</summary>
            <div class="mt-3">
                {{ include(format.guideTemplate) }}
            </div>
        </details>
    </div>
{% endblock %}
