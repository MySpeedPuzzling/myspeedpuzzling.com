{% extends 'base.html.twig' %}

{% set round = page.round %}
{% set event = page.event %}

{# Leads with the event - its full name, with the series of an edition and the year (see EventTitle) - then the round #}
{% block title %}
    {%- if round.name|lower == event.name|lower -%}
        {# A single-round edition often names its round like itself - say it once #}
        {{- 'events.meta.event_detail_title_results'|trans({'%event%': page.eventTitle.label}) -}}
    {%- else -%}
        {{- 'round_results.meta.title'|trans({'%event%': page.eventTitle.label, '%round%': round.name}) -}}
    {%- endif -%}
{% endblock %}

{# Published official results (docs/features/competitions-management/official-results.md) say so - every expression of this page that
   depends on them sits inside an existing line or tag, so a round page without them renders byte for byte as before #}
{% block meta_description %}{{ page.officialResults is null ? 'round_results.meta.description'|trans({'%round%': round.name, '%event%': page.eventTitle.label}) : 'round_results.official.meta_description'|trans({'%count%': page.officialResults.rankedCount, '%round%': round.name, '%event%': page.eventTitle.label}) }}{% endblock %}

{% block content %}
    {{ include('_return_back_button.html.twig', {fallbackUrl: event_url, fallbackTitle: event.name}) }}

    <p class="mb-1 small">
        <a href="{{ event_url }}" class="text-muted">{{ event.name }}</a>
    </p>

    <h1 class="h4 mb-2">
        <span class="badge align-middle" style="background-color: {{ round.color }}; color: {{ round.textColor }};">{{ round.name }}</span>
        <span class="text-muted fw-normal">– {{ 'round_results.heading_suffix'|trans }}</span>
    </h1>

    <div class="text-muted small mb-3">
        <i class="bi bi-calendar-event me-1"></i>{{ round.startsAt|date('d.m.Y H:i', round.timezone) }} <span class="text-muted" data-round-zone>({{ timezone_name(round.timezone, round.timezoneAssumed) }})</span>
        <span class="mx-1">&middot;</span>
        <i class="bi bi-stopwatch me-1"></i>{{ 'round_results.time_limit'|trans({'%minutes%': round.minutesLimit}) }}
        <span class="mx-1">&middot;</span>
        <span data-round-category>{{ ('competition.round.category.' ~ round.category.value)|trans }}</span>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        {% if page.previousRound %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path(round_route, round_route_params|merge({roundSlug: page.previousRound.slug})) }}">
                <i class="bi bi-chevron-left"></i> {{ page.previousRound.name }}
            </a>
        {% endif %}

        {% if page.rounds|length > 1 %}
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    {{ 'round_results.all_rounds'|trans }}
                </button>
                <ul class="dropdown-menu">
                    {% for other_round in page.rounds %}
                        <li>
                            <a class="dropdown-item {{ other_round.id == round.id ? 'active' }}" href="{{ path(round_route, round_route_params|merge({roundSlug: other_round.slug})) }}">
                                <span class="d-inline-block rounded-circle me-2 align-middle" style="width: .625rem; height: .625rem; background-color: {{ other_round.color }};" aria-hidden="true"></span>{{ other_round.name }}
                                <small class="{{ other_round.id == round.id ? '' : 'text-muted' }} ms-1">{{ other_round.startsAt|date('d.m. H:i', other_round.timezone) }}</small>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if page.nextRound %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path(round_route, round_route_params|merge({roundSlug: page.nextRound.slug})) }}">
                {{ page.nextRound.name }} <i class="bi bi-chevron-right"></i>
            </a>
        {% endif %}

        {% if page.officialResultsLink %}
            <a class="btn btn-sm btn-outline-primary ms-md-auto" href="{{ page.officialResultsLink }}" target="_blank" rel="noopener">
                <i class="bi bi-trophy me-1"></i>{{ (page.officialResults is null ? 'round_results.official_results' : 'round_results.official.organiser_results')|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i>
            </a>
        {% endif %}
    </div>

    {# The organiser's way back to their tools of this round (official results: live entry, results desk) #}
    {% if app.user and is_granted('COMPETITION_EDIT', event.id) %}{% include 'official_results/_organiser_round_links.html.twig' ignore missing %}{% endif %}

    {% if page.officialResults is null and page.hasStarted and page.resultsCount > 0 %}
        <p class="small text-muted mb-3">
            <i class="bi bi-info-circle me-1"></i>{{ 'round_results.unofficial_note'|trans }}
            {% if page.officialResultsLink %}
                <a href="{{ page.officialResultsLink }}" target="_blank" rel="noopener" class="text-nowrap">{{ 'round_results.see_official_results'|trans }}<i class="bi bi-box-arrow-up-right ms-1 small" aria-hidden="true"></i></a>
            {% endif %}
        </p>
    {% endif %}

    {% if round.puzzles is empty and page.stillSecret is empty %}
        <p class="text-muted">{{ 'round_results.no_puzzle_yet'|trans }}</p>
    {% endif %}

    {# Revealed by this round, but another round keeps the puzzle secret on the whole site longer - left out until then #}
    {% for still_secret in page.stillSecret %}
        <p class="alert alert-info small" data-still-secret>{{ still_secret }}</p>
    {% endfor %}

    {% if page.officialResults is not null %}{{ include('round_results/_official.html.twig') }}{% else %}{% for puzzle in round.puzzles %}
        {% set puzzle_results = page.results[puzzle.puzzleId] ?? [] %}

        {{ include('round_results/_puzzle_card.html.twig') }}

        {% if not page.hasStarted %}
            <p class="text-muted mb-4">{{ 'round_results.not_started'|trans({'%when%': round.startsAt|ago}) }}</p>
        {% elseif puzzle_results is empty %}
            <p class="text-muted mb-4">{{ 'round_results.no_results'|trans }}</p>
        {% else %}
            {{ include('round_results/_player_times.html.twig') }}
        {% endif %}
    {% endfor %}{% endif %}
{% endblock %}
