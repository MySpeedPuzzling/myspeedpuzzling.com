{#- A row of a round filtered to one division (shared-puzzles-and-divisions.md D5): the big number is the division rank, the overall official place small under it -#}
<span class="d-block small text-muted text-nowrap" title="{{ 'round_results.division.overall_title'|trans }}" data-official-overall-rank="{{ entry.rank }}">{{ 'round_results.division.overall'|trans({'%rank%': entry.rank}) }}</span>
