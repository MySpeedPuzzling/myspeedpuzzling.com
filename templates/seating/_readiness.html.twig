{# The seating step of a round's management pages (SeatingReadiness::isShown() decides when):
   "Tables: 180 / 200 assigned - recommended before the round starts" + the way to the seating page.
   A recommendation, never a block. Variables: overview (RoundResultsOverview). #}
{% set seated = overview.entriesWithTableNumber >= overview.entriesTotal %}
<div class="alert {{ seated ? 'alert-light border' : 'alert-info' }} d-flex flex-wrap align-items-center gap-2 py-2" role="status" data-seating-readiness>
    <i class="bi {{ seated ? 'bi-check2-circle' : 'bi-grid-3x3-gap' }}" aria-hidden="true"></i>
    <span>
        <strong>{{ 'seating.readiness.progress'|trans({'%assigned%': overview.entriesWithTableNumber, '%total%': overview.entriesTotal}) }}</strong>
        - {{ seated ? 'seating.readiness.done'|trans : 'seating.readiness.recommended'|trans }}
    </span>
    <a href="{{ path('round_seating', {roundId: overview.roundId}) }}" class="btn btn-sm {{ seated ? 'btn-outline-secondary' : 'btn-primary' }} ms-auto">
        <i class="bi bi-123 me-1" aria-hidden="true"></i>{{ 'seating.button'|trans }}
    </a>
</div>
