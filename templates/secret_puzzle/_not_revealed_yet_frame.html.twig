{#
    A personal record on a puzzle that is secret until its reveal, refused inside a Turbo Frame (the modals):
    the message takes the frame's place (SecretPuzzleWriteRefusedSubscriber).

    Parameters:
    - frame: the id of the Turbo Frame that asked
    - message: the translated refusal
#}
<turbo-frame id="{{ frame }}">
    {% if frame == 'modal-frame' %}
        <div class="modal-header">
            <h5 class="modal-title">{{ 'secret_puzzle.not_revealed_yet_title'|trans }}</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'forms.close'|trans }}"></button>
        </div>
        <div class="modal-body">
            <div class="alert alert-warning mb-0" role="alert">{{ message }}</div>
        </div>
    {% else %}
        <div class="alert alert-warning" role="alert">{{ message }}</div>
    {% endif %}
</turbo-frame>
