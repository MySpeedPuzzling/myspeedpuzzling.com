{% extends '_auth_layout.html.twig' %}

{% block title %}{{ 'auth.set_password.title'|trans }}{% endblock %}

{% block auth_content %}
    <h1 class="auth-title">{{ 'auth.set_password.title'|trans }}</h1>
    <p class="auth-lead">{{ 'auth.set_password.intro'|trans }}</p>

    {{ form_start(form) }}
        {# The signed-in account's address as this form's username, so the
           password manager files the new password under the right account #}
        {% if app.user and app.user.email is defined %}
            <input type="email" name="username" value="{{ app.user.email }}" autocomplete="username" readonly hidden>
        {% endif %}

        <div class="mb-3">
            {{ form_label(form.plainPassword) }}
            <div class="password-field">
                {{ form_widget(form.plainPassword) }}
                {{ include('_password_toggle.html.twig', {input_id: form.plainPassword.vars.id}) }}
            </div>
            {{ form_help(form.plainPassword) }}
            {{ form_errors(form.plainPassword) }}
        </div>

        <button type="submit" class="btn btn-primary w-100">
            {{ 'auth.set_password.submit'|trans }}
        </button>
    {{ form_end(form) }}

    <p class="mt-4 mb-0">
        <a class="auth-inline-link" href="{{ path('set_password_after_sign_in_link', {'skip': 1}) }}">
            {{ 'auth.set_password.skip'|trans }}
        </a>
    </p>
{% endblock %}
