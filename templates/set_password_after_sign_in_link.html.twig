{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.set_password.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <div class="row gy-3 pb-4">
        <div class="col-lg-6 col-md-8">
            <h1 class="h2">{{ 'auth.set_password.title'|trans }}</h1>

            <p class="text-muted">{{ 'auth.set_password.intro'|trans }}</p>

            <div class="card shadow my-3" data-controller="password-suggestion">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.plainPassword) }}
                            {{ form_widget(form.plainPassword) }}
                            {{ form_help(form.plainPassword) }}
                            {{ form_errors(form.plainPassword) }}
                        </div>

                        <p class="mb-3">
                            {# Fills the field with a generated password that stays visible and
                               editable: a readonly value would block everyone who wants to use
                               their own, and managers capture the value on submit either way #}
                            <button
                                type="button"
                                class="btn btn-sm btn-outline-secondary"
                                data-action="password-suggestion#suggest"
                            >
                                <i class="bi bi-shuffle me-1"></i>{{ 'auth.set_password.suggest'|trans }}
                            </button>
                        </p>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-key me-1"></i>{{ 'auth.set_password.submit'|trans }}
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>

            <p class="fs-sm">
                <a href="{{ path('set_password_after_sign_in_link', {'skip': 1}) }}">
                    {{ 'auth.set_password.skip'|trans }}
                </a>
            </p>
        </div>
    </div>
{% endblock %}
