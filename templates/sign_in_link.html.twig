{% extends '_auth_layout.html.twig' %}

{% block title %}{{ 'auth.sign_in_link.title'|trans }}{% endblock %}

{# docs/features/auth-ux-redesign.md §4.3. Success is its own screen
   (/login-link/sent); a failure re-renders this one with 422. #}

{% set return_params = return_path is null ? {} : {'return': return_path} %}

{% block auth_content %}
    {{ include('_auth_back_link.html.twig', {href: path('login', return_params)}) }}

    <h1 class="auth-title">{{ 'auth.sign_in_link.title'|trans }}</h1>
    <p class="auth-lead">{{ 'auth.sign_in_link.intro'|trans }}</p>

    {% if alert %}
        <div class="alert alert-warning" role="alert">{{ alert }}</div>
    {% endif %}

    <form action="{{ path('sign_in_link_request') }}" method="post" novalidate data-last-sign-in-method="link" data-action="submit->last-sign-in#remember">
        <input type="hidden" name="_token" value="{{ csrf_token(constant('SpeedPuzzling\\Web\\Controller\\SignInLinkController::CSRF_TOKEN_ID')) }}">
        {% if return_path %}
            <input type="hidden" name="return" value="{{ return_path }}">
        {% endif %}

        <div class="mb-3">
            <label class="form-label" for="sign-in-link-email">{{ 'auth.login.email'|trans }}</label>
            {# A single-field page opened to type exactly this: focus it - unless the
               hand-off already filled it, which the server cannot know, so only
               when re-rendering with an error or when nothing is known yet #}
            <input
                class="form-control{{ field_error ? ' is-invalid' : '' }}"
                type="email"
                id="sign-in-link-email"
                name="email"
                value="{{ email }}"
                autocomplete="email"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                enterkeyhint="send"
                required
                {% if field_error %}aria-invalid="true" aria-describedby="sign-in-link-email-error" autofocus{% elseif email == '' %}autofocus{% endif %}
            >
            {% if field_error %}
                <div class="invalid-feedback d-block" id="sign-in-link-email-error">{{ field_error }}</div>
            {% endif %}
        </div>

        <button type="submit" class="btn btn-primary w-100" data-turbo-submits-with="{{ 'auth.check_email.sending'|trans }}">
            {{ 'auth.sign_in_link.submit'|trans }}
        </button>
    </form>
{% endblock %}
