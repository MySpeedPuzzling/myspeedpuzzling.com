{% extends '_auth_layout.html.twig' %}

{% block title %}{{ 'auth.sign_in_link.check_title'|trans }}{% endblock %}

{% block auth_content %}
    <h1 class="auth-title">{{ 'auth.sign_in_link.check_title'|trans }}</h1>
    <p class="auth-lead">{{ 'auth.sign_in_link.check_intro'|trans }}</p>

    {# Plain full-page POST, no Turbo: the response sets the session and the
       30-day remember-me cookie, and a native navigation is the one path
       every browser handles identically. No CSRF token - the signed hash
       already proves the request came from a link we issued, and the page
       is opened from an email client rather than from our own site. #}
    <form action="{{ path('sign_in_link_check') }}" method="post" id="sign-in-link-check-form" data-turbo="false">
        <input type="hidden" name="user" value="{{ user }}">
        <input type="hidden" name="expires" value="{{ expires }}">
        <input type="hidden" name="hash" value="{{ hash }}">

        <button type="submit" class="btn btn-primary w-100">
            {{ 'auth.sign_in_link.check_submit'|trans }}
        </button>
    </form>

    {# Submits the form the moment the page is parsed, so a person sees at
       most a flash of this page and lands where the link always took them.
       Mail-provider link scanners (the reason this page exists) fetch with
       a bare HTTP client that runs no JavaScript - every scanner hit in the
       audit log arrived without a User-Agent - so for them the link stays
       unused. Inline and dependency-free on purpose: it must work before
       and without the app bundle, and with Turbo out of the picture. #}
    <script>
        document.getElementById('sign-in-link-check-form').submit();
    </script>

    <p class="mt-4 mb-0">
        <a class="auth-inline-link" href="{{ path('sign_in_link_request') }}">{{ 'auth.sign_in_link.check_request_new'|trans }}</a>
    </p>
{% endblock %}
