{% extends '_auth_layout.html.twig' %}

{% block title %}{{ (is_private_relay ? 'auth.social.relay.title' : 'auth.social.confirm.title')|trans }}{% endblock %}

{# The rule-4 interstitial (docs/features/auth-ux-redesign.md §4.7). #}

{% block auth_content %}
    <h1 class="auth-title mb-3">{{ (is_private_relay ? 'auth.social.relay.title' : 'auth.social.confirm.title')|trans }}</h1>

    {% if is_private_relay %}
        {% include '_social_register_relay.html.twig' %}
    {% else %}
        <p>{{ 'auth.social.confirm.question'|trans({'%provider%': provider_name, '%email%': email}) }}</p>

        <form action="{{ path('social_register_confirm') }}" method="post">
            {# The single-use parked token doubles as the CSRF guard #}
            <input type="hidden" name="token" value="{{ token }}">

            <button type="submit" class="btn btn-primary w-100">
                {{ 'auth.social.confirm.create'|trans }}
            </button>
        </form>

        {# The whole point of this page (plan §Linking vs merging): a visitor who
           already has an account under another address must not mint a
           duplicate account. The provider profile stays parked through the
           sign-in and gets connected to whichever account they sign in to
           (SocialRegisterSignInController). #}
        <h2 class="h6 mt-4 pt-3 mb-2 border-top">{{ 'auth.social.confirm.have_account_title'|trans }}</h2>

        <form action="{{ path('social_register_sign_in') }}" method="post">
            <input type="hidden" name="token" value="{{ token }}">

            <button type="submit" class="btn btn-outline-secondary w-100">
                {{ 'auth.social.confirm.sign_in_and_connect'|trans({'%provider%': provider_name}) }}
            </button>
        </form>

        <p class="text-muted fs-sm mt-2">{{ 'auth.social.confirm.have_account'|trans({'%provider%': provider_name}) }}</p>
    {% endif %}

    <p class="text-muted fs-sm mt-4 mb-0">
        {{ 'auth.social.confirm.duplicate_accounts_help'|trans({'%faqUrl%': path('faq') ~ '#duplicate-accounts'})|raw }}
    </p>
{% endblock %}
