{% extends 'base.html.twig' %}

{% block title %}{{ collection.name }}{% if logged_user.profile is null or logged_user.profile.playerId != collection.playerId %} - {{ profile_name(player) }}{% endif %}{% endblock %}

{% block content %}
    <twig:PlayerHeader player="{{ player }}" tab="library" />

<div data-controller="collection-items collection-filter">
    {% include '_return_back_button.html.twig' with {fallbackUrl: path('puzzle_library', {playerId: player.playerId}), fallbackTitle: 'collections.back_to_library'|trans} %}

    <div class="d-flex flex-column flex-sm-row align-items-start justify-content-between gap-2 mb-4">
        <div>
            <h1 class="h3 mb-0 d-flex align-items-center">
                <span><i class="bi bi-check2-circle me-2"></i>{{ collection.name }}</span>
                {% if logged_user.profile is not null and logged_user.profile.playerId == collection.playerId %}
                    <a href="{{ path('edit_solved_puzzles', {playerId: player.playerId, 'return': path('solved_puzzles_detail', {playerId: player.playerId}), 'return_title': collection.name}) }}" data-turbo="true" data-turbo-frame="modal-frame" class="fs-sm fw-normal {{ collection.visibility.value == 'public' ? 'text-primary' : 'text-muted' }} ms-2 me-2 text-decoration-underline">
                        <i class="{{ collection.visibility.value == 'public' ? 'ci-eye' : 'ci-locked' }} me-1"></i>{{ collection.visibility.value == 'public' ? 'collections.public'|trans : 'collections.private'|trans }}
                    </a>
                    {% if collection.visibility.value != 'public' %}
                        <small class="text-muted fs-xs">{{ 'collections.change_to_public_hint'|trans }}</small>
                    {% endif %}
                {% endif %}
            </h1>
            <p class="text-muted mb-0 small">
                {% if logged_user.profile is null or logged_user.profile.playerId != collection.playerId %}
                    {{ profile_name(player) }}
                    <span class="text-muted px-2">•</span>
                {% endif %}
                <i class="bi bi-puzzle me-1"></i>
                {{ 'solved_puzzles.items_count'|trans({'%count%': '<span id="solved-count" data-collection-items-target="count">' ~ items|length ~ '</span>'})|raw }}
            </p>
            {% if collection.description %}
                <p class="text-muted small mb-0 mt-1">{{ collection.description }}</p>
            {% endif %}
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-sm-end gap-2">
            {% if logged_user.profile is not null and logged_user.profile.playerId == collection.playerId and collection.visibility.value == 'public' %}
                {{ include('_share_button.html.twig', {share_url: url('solved_puzzles_detail', {playerId: player.playerId})}) }}
            {% endif %}
            {% if logged_user.profile is not null and logged_user.profile.playerId == collection.playerId %}
                {{ include('multiscan/_entry_button.html.twig', {params: {}, label: 'multiscan.entry.library', title: 'multiscan.entry.library_title'}) }}
            {% endif %}
            {% if logged_user.profile is not null and logged_user.profile.playerId == collection.playerId %}
                <a href="{{ path('edit_solved_puzzles', {playerId: player.playerId, 'return': path('solved_puzzles_detail', {playerId: player.playerId}), 'return_title': collection.name}) }}" data-turbo="true" data-turbo-frame="modal-frame" class="btn btn-sm btn-outline-primary">
                    <i class="ci-edit me-1"></i> {{ 'edit'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    {% if items|length > 3 %}
        <div class="filters mb-3">
            <div class="row gx-2 align-items-center">
                <div class="col-12 col-sm-6 col-lg-3 mb-2">
                    <div class="position-relative">
                        <input class="form-control" type="text"
                               data-collection-filter-target="search"
                               data-action="input->collection-filter#filter"
                               placeholder="{{ 'filters.text_search_placeholder'|trans }}">
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-2 mb-2">
                    <select class="form-select" data-collection-filter-target="manufacturer" data-action="change->collection-filter#filter">
                        <option value="">{{ 'filters.manufacturer_placeholder'|trans }}</option>
                    </select>
                </div>

                <div class="col-12 col-lg-7 mb-2">
                    {{ include('_pieces_filter_client.html.twig') }}
                </div>

                {{ include('_difficulty_filter_chips.html.twig') }}
                {{ include('_difficulty_sort.html.twig') }}
            </div>
        </div>
    {% endif %}

    {% if items|length > 3 %}
        <div class="mb-2">
            <small class="text-muted">{{ 'total_found'|trans({'%count%': '<span data-collection-filter-target="visibleCount">' ~ items|length ~ '</span>'})|raw }}</small>
        </div>
    {% endif %}

    <div id="solved-list-container">
    {% if items is empty %}
        <div class="text-center py-5">
            <div class="mb-3">
                <i class="bi bi-puzzle fs-1 text-muted"></i>
            </div>
            <h4 class="text-muted">{{ 'solved_puzzles.empty.title'|trans }}</h4>
            <p class="text-muted">{{ 'solved_puzzles.empty.message'|trans }}</p>
        </div>
    {% else %}
        <div class="row g-3 mb-3">
            {% for item in items %}
                {{ include('_puzzle_library_item.html.twig', {
                    item: item,
                    page_context: 'solved',
                    collection: collection,
                    puzzle_statuses: puzzle_statuses,
                    logged_user: logged_user,
                    isOwnProfile: isOwnProfile,
                }) }}
            {% endfor %}
        </div>

        <div class="hidden" data-collection-filter-target="noResults">
            <div class="alert alert-warning mb-0">
                {{ 'filters.no_puzzle_matches_filters'|trans }}
            </div>
        </div>
    {% endif %}
    </div>
</div>
{% endblock %}
