{#- One round's score of a public standing row (competition toolkit A7). Variables: score (StandingRoundScore), round,
    hide_rank (optional - a `stages` row shows its round's place in the place column already, v2 S5).
    Competition toolkit T6: the time with the pieces missing next to it (not placed at the time's up, or missing from a
    finished puzzle) - the penalty they cost is in the row's total. A solve-all block (real events W4) adds its challenge
    times (each puzzle's own time, by label) on a line of their own - pick rounds of K ≥ 2 with splits only. -#}
{%- if score.status.value == 'finished' -%}
    {{ score.timeSeconds|puzzlingTime }}
    {%- if score.missingPieces > 0 %} <span class="text-muted" data-standing-missing="{{ score.missingPieces }}">· {{ 'finished_missing.missing_short'|trans({'%count%': score.missingPieces}) }}</span>{% endif -%}
{%- elseif score.status.value == 'unfinished' -%}
    <span title="{{ 'competition_standing.status.unfinished_help'|trans({'%pieces%': score.result.piecesPlaced}) }}">{{ score.timeSeconds|puzzlingTime }}*</span>
    {%- if score.missingPieces > 0 %} <span class="text-muted" data-standing-missing="{{ score.missingPieces }}">· {{ 'finished_missing.missing_short'|trans({'%count%': score.missingPieces}) }}</span>{% endif -%}
{%- elseif score.status.value == 'no_show' -%}
    {#- as_zero_pieces (World Series): the time limit, the penalty for all pieces is in the total -#}
    <span class="text-danger" data-standing-no-show>{{ 'competition_toolkit.standings.no_show'|trans }}</span> {{ score.timeSeconds|puzzlingTime }}
{%- elseif score.status.value == 'not_counted' -%}
    <span title="{{ 'public_standing.not_published_round'|trans }}">–</span>
{%- elseif score.status.value == 'unfinished_without_limit' -%}
    <span class="text-danger">{{ 'competition_standing.status.unfinished_without_limit'|trans }}</span>
{%- else -%}
    <span class="text-danger">–</span>
{%- endif -%}
{%- if score.rank is not null and not hide_rank|default(false) %} <span class="text-muted">({{ score.rank }}.)</span>{% endif -%}
{%- if score.challengeTimes is not empty %}<span class="d-block small text-muted fw-normal" data-standing-challenges>{% for time in score.challengeTimes %}{{ not loop.first ? ' · ' }}{{ 'competition_standing.challenge_time'|trans({'%label%': time.label, '%time%': time.seconds|puzzlingTime}) }}{% endfor %}</span>{% endif -%}
