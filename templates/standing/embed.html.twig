{#
    The embeddable standing (real events L3, StandingEmbedController, standings.md "Embeddable standing") - a page made
    for an <iframe> on an organiser's website: standalone on purpose (no base.html.twig: no navigation, footer, cookie
    banner, service worker or Turbo), the public page's table part as a guest sees it (the same partials), the event's
    and the standing's name, and "Results by MySpeedPuzzling". Every link opens in a new tab (<base target="_blank">) -
    never inside the frame or over the organiser's page. Rendered once per generation, locale and theme - nothing here
    may depend on the request beyond those two.

    assets/standing_embed.js (Encore entry `standing_embed`) refetches this page on the event's standings signal and
    swaps [data-standing-embed-table] when it differs.

    Variables: embed (PublicStandingEmbed), theme ('light' / 'dark'), live_topic.
#}
{%- set view = embed.view -%}
{%- set standing = view.standing -%}
{%- set table = view.table -%}
<!doctype html>
<html lang="{{ app.request.locale }}" class="standing-embed-root standing-embed-root--{{ theme }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <base target="_blank">
    <title>{{ standing.name }} · {{ embed.eventName }}</title>
    <style>@font-face{font-family:Rubik;font-style:normal;font-weight:300 700;font-display:swap;src:url({{ asset('fonts/rubik/rubik-latin-ext.woff2') }}) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}@font-face{font-family:Rubik;font-style:normal;font-weight:300 700;font-display:swap;src:url({{ asset('fonts/rubik/rubik-latin.woff2') }}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}</style>
    {{ encore_entry_link_tags('standing_embed') }}
    {{ encore_entry_script_tags('standing_embed') }}
</head>
<body class="standing-embed standing-embed--{{ theme }}">
    <header class="standing-embed__head">
        <p class="standing-embed__event" data-standing-embed-event>{{ embed.eventName }}</p>
        <h1 class="standing-embed__title" data-standing-title>
            {{ standing.name }}
            {# the category only when the standing's own name does not say it already (like the public page) #}
            {%- set category_label = ('competition.round.category.' ~ standing.category.value)|trans -%}
            {%- if category_label|lower not in standing.name|lower %} <span class="badge text-bg-light border align-middle fw-normal small" data-standing-category>{{ category_label }}</span>{% endif %}
        </h1>
    </header>

    <main id="standing-embed"
          data-url="{{ path('standing_embed', {standingId: standing.id, _locale: app.request.locale, theme: theme == 'dark' ? 'dark' : null}) }}"
          data-topic="{{ live_topic }}"
          data-hub="{{ mercure_public_url }}">
        <div data-standing-embed-table>
            {{- include(table.table.stages is not null ? 'standing/_public_stages.html.twig' : 'standing/_public_table.html.twig', {table: table, standing: standing, round_route: view.roundRoute, route_params: view.routeParams}, with_context = false) -}}
        </div>
    </main>

    <footer class="standing-embed__foot">
        <span class="standing-embed__updated" aria-live="polite" data-standing-embed-status data-updated="{{ 'public_standing.live.updated'|trans }}"></span>
        <a class="standing-embed__brand" href="{{ url(embed.standingRoute, embed.standingRouteParams|merge({_locale: app.request.locale})) }}" rel="noopener" data-standing-embed-brand>{{ 'standing_embed.results_by'|trans }}</a>
    </footer>
</body>
</html>
