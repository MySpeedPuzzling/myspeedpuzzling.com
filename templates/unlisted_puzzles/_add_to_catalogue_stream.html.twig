{# "Add to the catalogue" went through from the list's modal: the modal closes and the row says where the puzzle is now #}
{{ include('_modal_close_stream.html.twig') }}
<turbo-stream action="replace" target="unlisted-puzzle-{{ puzzle.id }}">
    <template>{{ include('unlisted_puzzles/_row_added.html.twig', {puzzle: puzzle, catalogue_puzzle_id: catalogue_puzzle_id}, with_context = false) }}</template>
</turbo-stream>
