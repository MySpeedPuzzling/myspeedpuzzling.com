{% extends 'base.html.twig' %}

{#
    "Unlisted puzzles" (docs/features/data-import/unlisted-puzzles.md): the reader's own puzzles that are not in the
    catalogue. Owner only - nothing of this page is ever shown to anybody else, and nothing here counts in statistics
    or rankings until a puzzle is paired with a catalogue puzzle.
#}

{% set hide_comparison_launcher = true %}

{% block title %}{{ 'unlisted_puzzles.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
{{ include('_page_crumbs.html.twig', {levels: [{name: 'data_import.home.title'|trans, url: path('data_imports')}]}) }}

<div class="mx-auto" style="max-width: 720px;" data-testid="unlisted-puzzles-page" data-puzzles="{{ summary.puzzles }}" data-results="{{ summary.results }}">
    <h1 class="h3 mb-2"><i class="bi bi-bookmark me-2" aria-hidden="true"></i>{{ 'unlisted_puzzles.title'|trans }}</h1>
    {# Two plain sentences: what an unlisted puzzle is, and what can be done with it #}
    <p class="text-muted mb-2" data-testid="unlisted-intro">{{ 'unlisted_puzzles.intro'|trans }} {{ 'unlisted_puzzles.intro_actions'|trans }}</p>
    <p class="fs-sm d-flex gap-2 p-2 rounded-2 bg-secondary" data-testid="unlisted-only-you">
        <i class="bi bi-eye-slash flex-shrink-0" aria-hidden="true"></i>
        <span>{{ 'data_import.explain.unlisted'|trans }} {{ 'data_import.explain.unlisted_more'|trans }}</span>
    </p>

    {% if summary.puzzles == 0 %}
        <p class="text-muted" data-testid="unlisted-empty">{{ 'unlisted_puzzles.empty'|trans }}</p>
        <a href="{{ path('data_imports') }}" class="btn btn-outline-primary text-wrap d-inline-flex align-items-center" style="min-height: 44px;">
            <i class="bi bi-file-earmark-spreadsheet me-2" aria-hidden="true"></i>{{ 'data_import.home.title'|trans }}
        </a>
    {% else %}
        <p class="fw-medium mb-2" data-testid="unlisted-summary">
            {{ 'unlisted_puzzles.summary.puzzles'|trans({'%number%': summary.puzzles|format_number}) }}
            · {{ 'unlisted_puzzles.summary.results'|trans({'%number%': summary.results|format_number}) }}
        </p>
        {% if summary.suggested > 0 %}
            <p class="fs-sm d-flex gap-2 p-2 rounded-2 bg-faded-primary" data-testid="unlisted-suggested-line" data-suggested="{{ summary.suggested }}">
                <i class="bi bi-bookmark-check text-primary flex-shrink-0" aria-hidden="true"></i>
                <span>{{ 'unlisted_puzzles.summary.suggested'|trans({'%number%': summary.suggested|format_number}) }}</span>
            </p>
        {% endif %}

        <div class="d-flex flex-column gap-2 mb-3">
            {% for puzzle in puzzles %}
                {{ include('unlisted_puzzles/_row.html.twig', {puzzle: puzzle}, with_context = false) }}
            {% endfor %}
        </div>

        {{ include('data_import/_pages.html.twig', {page: page, pages: pages, route: 'unlisted_puzzles', parameters: {}, label: 'unlisted_puzzles.title'|trans}, with_context = false) }}
    {% endif %}
</div>
{% endblock %}
