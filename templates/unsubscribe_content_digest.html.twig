{% extends 'base.html.twig' %}

{% block title %}{{ 'activity_digest.unsubscribe.meta_title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <div class="text-center mx-auto py-5" style="max-width: 480px;">
        {% if subscribed %}
            <i class="ci-mail" style="font-size: 3rem;" aria-hidden="true"></i>
            <h1 class="h3 mt-3">{{ 'activity_digest.unsubscribe.confirm_title'|trans }}</h1>
            <p class="text-body-secondary">{{ 'activity_digest.unsubscribe.confirm_text'|trans }}</p>
            <form method="post" action="{{ action_url }}" data-testid="content-digest-unsubscribe-form">
                <button type="submit" class="btn btn-primary">{{ 'activity_digest.unsubscribe.confirm_button'|trans }}</button>
            </form>
            {% if preferences_url %}
                <p class="fs-sm text-body-secondary mt-4 mb-0">
                    {{ 'activity_digest.unsubscribe.fewer_hint'|trans }}
                    <a class="link-underline" href="{{ preferences_url }}">{{ 'activity_digest.unsubscribe.fewer_link'|trans }}</a>
                </p>
            {% endif %}
        {% else %}
            <div data-testid="content-digest-unsubscribed">
                <i class="ci-check-circle text-success" style="font-size: 3rem;" aria-hidden="true"></i>
                <h1 class="h3 mt-3">{{ 'activity_digest.unsubscribe.done_title'|trans }}</h1>
                <p class="text-body-secondary">{{ 'activity_digest.unsubscribe.done_text'|trans }}</p>
                <a href="{{ path('homepage') }}" class="btn btn-outline-primary mt-2">{{ 'activity_digest.unsubscribe.back_home'|trans }}</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
