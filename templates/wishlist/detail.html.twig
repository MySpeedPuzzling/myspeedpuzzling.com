{% extends 'base.html.twig' %}

{% block title %}{{ collection.name }}{% if logged_user.profile is null or logged_user.profile.playerId != collection.playerId %} - {{ profile_name(player) }}{% endif %}{% endblock %}

{% block content %}
    <twig:PlayerHeader player="{{ player }}" tab="library" />

{% set can_select = logged_user.profile is not null and logged_user.profile.playerId == collection.playerId and logged_user.profile.activeMembership %}
<div data-controller="collection-items collection-filter{{ can_select ? ' collection-selection' }}"
     {% if can_select %}
     data-collection-selection-count-text-value="{{ browser_translation('collection_selection.selected_count')|json_encode }}"
     data-action="click->collection-selection#cardClick keydown.esc@document->collection-selection#escape turbo:submit-end@document->collection-selection#submitted"
     {% endif %}>
    {% include '_return_back_button.html.twig' with {fallbackUrl: path('puzzle_library', {playerId: player.playerId}), fallbackTitle: 'collections.back_to_library'|trans} %}

    <div class="d-flex flex-column flex-sm-row align-items-start justify-content-between gap-2 mb-4">
        <div>
            <h1 class="h3 mb-0 d-flex align-items-center">
                <span><i class="bi bi-heart me-2"></i>{{ collection.name }}</span>
                {% if logged_user.profile is not null and logged_user.profile.playerId == collection.playerId %}
                    <a href="{{ path('edit_wish_list', {playerId: player.playerId, 'return': path('wish_list_detail', {playerId: player.playerId}), 'return_title': collection.name}) }}" data-turbo="true" data-turbo-frame="modal-frame" class="fs-sm fw-normal {{ collection.visibility.value == 'public' ? 'text-primary' : 'text-muted' }} ms-2 me-2 text-decoration-underline">
                        <i class="{{ collection.visibility.value == 'public' ? 'ci-eye' : 'ci-locked' }} me-1"></i>{{ collection.visibility.value == 'public' ? 'collections.public'|trans : 'collections.private'|trans }}
                    </a>
                    {% if collection.visibility.value != 'public' %}
                        <small class="text-muted fs-xs">{{ 'collections.change_to_public_hint'|trans }}</small>
                    {% endif %}
                {% endif %}
            </h1>
            <p class="text-muted mb-0 small">
                {% if logged_user.profile is null or logged_user.profile.playerId != collection.playerId %}
                    {{ profile_name(player) }}
                    <span class="text-muted px-2">•</span>
                {% endif %}
                <i class="bi bi-puzzle me-1"></i>
                {{ 'wish_list.items_count'|trans({'%count%': '<span id="wishlist-count" data-collection-items-target="count">' ~ items|length ~ '</span>'})|raw }}
            </p>
            {% if collection.description %}
                <p class="text-muted small mb-0 mt-1">{{ collection.description }}</p>
            {% endif %}
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-sm-end gap-2">
            {% if logged_user.profile is not null and logged_user.profile.playerId == collection.playerId and collection.visibility.value == 'public' %}
                {{ include('_share_button.html.twig', {share_url: url('wish_list_detail', {playerId: player.playerId})}) }}
            {% endif %}
            {% if logged_user.profile is not null and logged_user.profile.playerId == collection.playerId %}
                {{ include('multiscan/_entry_button.html.twig', {params: {action: 'add_to_wishlist'}, label: 'multiscan.entry.wishlist', title: 'multiscan.entry.wishlist_title'}) }}
            {% endif %}
            {% if logged_user.profile is not null and logged_user.profile.playerId == collection.playerId %}
                <a href="{{ path('edit_wish_list', {playerId: player.playerId, 'return': path('wish_list_detail', {playerId: player.playerId}), 'return_title': collection.name}) }}" data-turbo="true" data-turbo-frame="modal-frame" class="btn btn-sm btn-outline-primary">
                    <i class="ci-edit me-1"></i> {{ 'edit'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    {% if items|length > 3 %}
        <div class="filters mb-3">
            <div class="row gx-2 align-items-center">
                <div class="col-12 col-sm-6 col-lg-3 mb-2">
                    <div class="position-relative">
                        <input class="form-control" type="text"
                               data-collection-filter-target="search"
                               data-action="input->collection-filter#filter"
                               placeholder="{{ 'filters.text_search_placeholder'|trans }}">
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-2 mb-2">
                    <select class="form-select" data-collection-filter-target="manufacturer" data-action="change->collection-filter#filter">
                        <option value="">{{ 'filters.manufacturer_placeholder'|trans }}</option>
                    </select>
                </div>

                <div class="col-12 col-lg-7 mb-2">
                    {{ include('_pieces_filter_client.html.twig') }}
                </div>

                {{ include('_difficulty_filter_chips.html.twig') }}
                {{ include('_difficulty_sort.html.twig') }}
            </div>
        </div>
    {% endif %}

    {% if items|length > 3 %}
        <div class="mb-2">
            <small class="text-muted">{{ 'total_found'|trans({'%count%': '<span data-collection-filter-target="visibleCount">' ~ items|length ~ '</span>'})|raw }}</small>
        </div>
    {% endif %}

    {% set isOwnProfile = logged_user.profile is not null and logged_user.profile.playerId == collection.playerId %}
    <div id="wishlist-list-container">
    {% if items is empty %}
        {{ include('wishlist/_empty_state.html.twig', {isOwnProfile: isOwnProfile, player: player}) }}
    {% else %}
        <div class="row g-3 mb-3">
            {% for item in items %}
                {{ include('_puzzle_library_item.html.twig', {
                    item: item,
                    page_context: 'wishlist',
                    selectable: can_select,
                    collection: collection,
                    puzzle_statuses: puzzle_statuses,
                    logged_user: logged_user,
                    isOwnProfile: isOwnProfile,
                }) }}
            {% endfor %}
        </div>

        <div class="hidden" data-collection-filter-target="noResults">
            <div class="alert alert-warning mb-0">
                {{ 'filters.no_puzzle_matches_filters'|trans }}
            </div>
        </div>
    {% endif %}
    </div>

    {% if can_select %}
        {{ include('_puzzle_selection_bar.html.twig', {actions: [
            {label: 'puzzle_selection.add_to_collection'|trans, short: 'puzzle_selection.add_to_collection_short'|trans, icon: 'bi bi-collection', url: path('puzzle_list_selected_add_to_collection', {list: 'wishlist'})},
            {label: 'collection_selection.remove'|trans, icon: 'ci-trash', url: path('puzzle_list_selected_action', {list: 'wishlist', action: 'remove'}), danger: true},
        ]}) }}
    {% endif %}
</div>
{% endblock %}
