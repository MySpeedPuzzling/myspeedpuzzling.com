{% extends 'base.html.twig' %}

{% set linked_editions = editions|filter(edition => edition.slug is not null) %}

{% block title %}{{ 'wjpc_hub.meta.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'wjpc_hub.meta.description'|trans }}{% endblock %}

{% block json_ld %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": {{ 'navigation.home'|trans|json_encode|raw }},
                "item": {{ url('homepage')|json_encode|raw }}
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": {{ 'menu.events'|trans|json_encode|raw }},
                "item": {{ url('events')|json_encode|raw }}
            },
            {
                "@type": "ListItem",
                "position": 3,
                "name": {{ 'wjpc_hub.meta.title'|trans|json_encode|raw }}
            }
        ]
    }
    </script>
    {% if linked_editions|length > 0 %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": {{ 'wjpc_hub.editions.heading'|trans|json_encode|raw }},
        "itemListElement": [
            {% for edition in linked_editions %}
            {
                "@type": "ListItem",
                "position": {{ loop.index }},
                "name": {{ edition.name|json_encode|raw }},
                "url": {{ url('event_detail', {slug: edition.slug})|json_encode|raw }}
            }{{ loop.last ? '' : ',' }}
            {% endfor %}
        ]
    }
    </script>
    {% endif %}
{% endblock %}

{% block content %}
    <h1 class="mb-3">{{ 'wjpc_hub.meta.title'|trans }}</h1>

    <p class="fs-lg">{{ 'wjpc_hub.intro'|trans }}</p>

    <h2 class="h4 mt-4">{{ 'wjpc_hub.what_is.heading'|trans }}</h2>
    <p>{{ 'wjpc_hub.what_is.p1'|trans }}</p>
    <p>{{ 'wjpc_hub.what_is.p2'|trans }}</p>
    <p>{{ 'wjpc_hub.what_is.p3'|trans }}</p>

    <h2 class="h4 mt-4">{{ 'wjpc_hub.editions.heading'|trans }}</h2>

    {% if editions|length > 0 %}
        <p>{{ 'wjpc_hub.editions.intro'|trans }}</p>

        <div class="table-responsive table-bleed mb-3">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">{{ 'wjpc_hub.editions.year'|trans }}</th>
                        <th scope="col">{{ 'wjpc_hub.editions.location'|trans }}</th>
                        <th scope="col">{{ 'wjpc_hub.editions.dates'|trans }}</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for edition in editions %}
                        <tr>
                            <th scope="row">{{ edition.dateFrom ? edition.dateFrom|date('Y') : '–' }}</th>
                            <td>
                                {% if edition.locationCountryCode %}
                                    <span class="shadow-custom fi fi-{{ edition.locationCountryCode.name }} me-2"></span>
                                {% endif %}
                                {{- edition.location }}
                            </td>
                            <td>
                                {% if edition.dateFrom %}
                                    {{ edition.dateFrom|format_date('medium') }}
                                    {%- if edition.dateTo and edition.dateTo|date('Y-m-d') != edition.dateFrom|date('Y-m-d') %}
                                        – {{ edition.dateTo|format_date('medium') }}
                                    {%- endif %}
                                {% endif %}
                            </td>
                            <td>
                                {% if edition.slug %}
                                    <a href="{{ path('event_detail', {slug: edition.slug}) }}">{{ 'wjpc_hub.editions.event_link'|trans }}</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>{{ 'wjpc_hub.editions.empty'|trans({'%events_link%': path('events')})|raw }}</p>
    {% endif %}

    {# The puzzles of every edition, newest edition first - round puzzles and the edition's tagged puzzles,
       secret ones left out until their round starts (GetCompetitionPuzzles). Every edition is folded: over a
       hundred puzzles must not push how to take part and the FAQ below out of reach, one tap opens a year. #}
    {% set editions_with_puzzles = editions|filter(edition => edition_puzzles[edition.id] is defined) %}
    {% if editions_with_puzzles|length > 0 %}
        <h2 class="h4 mt-4" id="wjpc-puzzles">{{ 'wjpc_hub.puzzles.heading'|trans }}</h2>
        <p>{{ 'wjpc_hub.puzzles.intro'|trans }}</p>

        {% for edition in editions_with_puzzles %}
            <details class="border-bottom py-2" data-wjpc-edition-puzzles="{{ edition.id }}">
                <summary class="text-primary" style="cursor: pointer;">
                    <h3 class="d-inline h6 mb-0 text-primary">{{ 'wjpc_hub.puzzles.edition_heading'|trans({'%edition%': edition.shortcut ?? edition.name}) }}</h3>
                    <span class="small text-muted ms-1">({{ edition_puzzles[edition.id]|length }})</span>
                </summary>

                <div class="row g-2 mt-1">
                    {% for puzzle in edition_puzzles[edition.id] %}
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="card card-body shadow-sm p-2 h-100">
                                <div class="d-flex align-items-center">
                                    <a class="flex-shrink-0" href="{{ path('puzzle_detail', {puzzleId: puzzle.puzzleId}) }}">
                                        {{ lazy_puzzle_image(
                                            puzzle.puzzleImage,
                                            'puzzle_small',
                                            'puzzle_img_alt'|trans({'%puzzle%': (puzzle.manufacturerName ?? '') ~ ' ' ~ puzzle.puzzleName}),
                                            999,
                                            60,
                                            'rounded-2',
                                            60,
                                            puzzle.puzzleImageRatio
                                        ) }}
                                    </a>

                                    <div class="ps-2 small lh-sm">
                                        <a class="text-decoration-underline fw-medium" href="{{ path('puzzle_detail', {puzzleId: puzzle.puzzleId}) }}">{{ puzzle.puzzleName }}</a>
                                        <div class="text-muted mt-1">
                                            {% if puzzle.manufacturerName %}{{ puzzle.manufacturerName }} &middot; {% endif %}{{ 'pieces_count'|trans({'%count%': puzzle.piecesCount})|raw }}
                                        </div>
                                        <div class="mt-1">
                                            {% if puzzle.soloSolvesCount > 0 and puzzle.medianTimeSolo is not null and puzzle.fastestTimeSolo is not null %}
                                                {{ 'median_time'|trans }} <span class="text-nowrap">{{ puzzle.medianTimeSolo|puzzlingTime }}</span>
                                                &middot; {{ 'fastest_time'|trans }} <span class="text-nowrap">{{ puzzle.fastestTimeSolo|puzzlingTime }}</span>
                                            {% elseif puzzle.fastestTimeDuo is not null %}
                                                {{ 'wjpc_hub.puzzles.fastest_pair'|trans }} <span class="text-nowrap">{{ puzzle.fastestTimeDuo|puzzlingTime }}</span>
                                            {% elseif puzzle.fastestTimeTeam is not null %}
                                                {{ 'wjpc_hub.puzzles.fastest_team'|trans }} <span class="text-nowrap">{{ puzzle.fastestTimeTeam|puzzlingTime }}</span>
                                            {% else %}
                                                <span class="text-muted">{{ 'wjpc_hub.puzzles.no_times'|trans }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {% if edition.slug %}
                    <a class="small d-inline-block mt-2" href="{{ path('event_detail', {slug: edition.slug}) }}">{{ 'wjpc_hub.editions.event_link'|trans }}</a>
                {% endif %}
            </details>
        {% endfor %}
    {% endif %}

    <h2 class="h4 mt-4">{{ 'wjpc_hub.participate.heading'|trans }}</h2>
    <p>{{ 'wjpc_hub.participate.p1'|trans({'%official_link%': 'https://worldjigsawpuzzle.org?utm_source=myspeedpuzzling'})|raw }}</p>
    <p>{{ 'wjpc_hub.participate.p2'|trans({'%events_link%': path('events')})|raw }}</p>

    <h2 class="h4 mt-4">{{ 'wjpc_hub.msp.heading'|trans }}</h2>
    <p>{{ 'wjpc_hub.msp.p1'|trans }}</p>
    <p>{{ 'wjpc_hub.msp.p2'|trans({
        '%ladder_link%': path('ladder'),
        '%events_link%': path('events'),
        '%guide_link%': path('guide_what_is_speed_puzzling'),
    })|raw }}</p>

    <h2 class="h4 mt-4">{{ 'wjpc_hub.faq.heading'|trans }}</h2>

    <h3 class="h6 mt-3">{{ 'wjpc_hub.faq.next.question'|trans }}</h3>
    {% if next_edition and next_edition.dateFrom %}
        {% set next_edition_dates = next_edition.dateFrom|format_date('long') ~ (next_edition.dateTo ? ' – ' ~ next_edition.dateTo|format_date('long') : '') %}
        <p>
            {{ 'wjpc_hub.faq.next.answer_scheduled'|trans({
                '%name%': next_edition.name,
                '%dates%': next_edition_dates,
                '%location%': next_edition.location,
            }) }}
            {% if next_edition.slug %}
                <a href="{{ path('event_detail', {slug: next_edition.slug}) }}">{{ 'wjpc_hub.faq.next.answer_event_link'|trans }}</a>
            {% endif %}
        </p>
    {% else %}
        <p>{{ 'wjpc_hub.faq.next.answer_evergreen'|trans({'%events_link%': path('events')})|raw }}</p>
    {% endif %}

    <h3 class="h6 mt-3">{{ 'wjpc_hub.faq.results.question'|trans }}</h3>
    <p>{{ 'wjpc_hub.faq.results.answer'|trans }}</p>

    <h3 class="h6 mt-3">{{ 'wjpc_hub.faq.anyone.question'|trans }}</h3>
    <p>{{ 'wjpc_hub.faq.anyone.answer'|trans }}</p>
{% endblock %}
