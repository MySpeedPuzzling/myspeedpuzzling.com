{% extends 'base.html.twig' %}

{% set board = tab.translationPrefix() %}

{% block title %}{{ (board ~ '.title')|trans }}{% endblock %}

{#
    Progression leaderboards: a tab per board (ProgressLeaderboardTab - tabs, titles and values come from that list),
    the shared leaderboard row (_leaderboard_player.html.twig, _leaderboard.scss), the viewer's own row pinned under the
    list on the same board the filters show.
#}
{% macro board_row(row, tab, board, is_viewer) %}
    <tr class="{{ is_viewer ? 'table-active-player' }}">
        <td class="rank"><span class="lb-rank{{ row.rank <= 3 ? ' lb-rank-podium lb-rank-podium-' ~ row.rank }}">{{ row.rank }}</span></td>
        <td class="lb-solver">
            {{ include('_leaderboard_player.html.twig', {player: row, show_tier: false}) }}
        </td>
        <td class="lb-time">
            <span class="lb-time-value">{{ (board ~ '.value')|trans({'%value%': row.value|format_number}) }}</span>
            {% if tab.showsLevel() %}
                <span class="lb-gap">{{ 'xp.leaderboard.level'|trans({'%level%': row.level}) }}</span>
            {% endif %}
        </td>
    </tr>
{% endmacro %}

{% block content %}
    {{ include('_leaderboards_nav.html.twig') }}

    <h1 class="mb-2">{{ 'ladder.title'|trans }}</h1>

    <p class="text-body-secondary fs-sm mb-3">
        {{ (board ~ '.subtitle')|trans }}
        <a href="{{ path(tab.hasKarmaFilters() ? 'karma_explainer' : 'progression_hub') }}" class="text-nowrap">{{ (tab.hasKarmaFilters() ? 'karma.explainer.title' : 'progression_hub.title')|trans }}</a>
    </p>

    {% if login_required %}
        <div class="xp-teaser">
            <i class="ci-user" aria-hidden="true"></i>
            <span>
                {{ (board ~ '.login_required')|trans }}
                <a href="{{ path('login', {return: app.request.requestUri}) }}" rel="nofollow">{{ 'menu.sign_in'|trans }}</a>
            </span>
        </div>
    {% else %}
        <form method="get" class="d-flex flex-wrap align-items-center gap-3 mb-3" data-turbo="false" data-controller="auto-submit" data-action="change->auto-submit#submit">
            <input type="hidden" name="tab" value="{{ tab.value }}">
            {% if tab.hasKarmaFilters() %}
                {{ include('karma/_leaderboard_filters.html.twig') }}
            {% endif %}

            <div class="d-flex align-items-center gap-2">
                <label for="board-country" class="form-label fs-sm mb-0 text-nowrap">{{ 'badges.detail.country_filter'|trans }}</label>
                <select id="board-country" name="country" class="form-select" style="max-width: 240px;">
                    <option value="">{{ 'badges.detail.all_countries'|trans }}</option>
                    {% for country in countries %}
                        <option value="{{ country.code }}" {{ selected_country == country.code ? 'selected' }}>{{ country.name }}</option>
                    {% endfor %}
                </select>
            </div>

            {% if viewer is not null %}
                <div class="form-check form-switch fs-sm mb-0 d-flex align-items-center gap-2" style="min-height: 44px;">
                    <input class="form-check-input mt-0" type="checkbox" id="favorites-only" name="favorites" value="1" {{ favorites_only ? 'checked' }}>
                    <label class="form-check-label py-2" for="favorites-only">{{ 'xp.leaderboard.favorites_only'|trans }}</label>
                </div>
            {% endif %}

            <button type="submit" class="btn btn-outline-secondary" data-auto-submit-target="fallback">{{ 'badges.detail.apply_filter'|trans }}</button>
        </form>

        {% if rows|length == 0 and self_row is null %}
            <div class="xp-teaser">
                <i class="ci-star" aria-hidden="true"></i>
                <span>{{ (board ~ '.empty')|trans }}</span>
            </div>
        {% else %}
            <div class="custom-table-wrapper lb-wrapper">
                <table class="table custom-table lb-table mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="lb-rank-head">#</th>
                            <th scope="col">{{ 'xp.leaderboard.player'|trans }}</th>
                            <th scope="col" class="text-end">{{ (board ~ '.column')|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            {{ _self.board_row(row, tab, board, viewer is not null and row.playerId == viewer.playerId) }}
                        {% endfor %}

                        {% if self_row is not null %}
                            <tr aria-hidden="true">
                                <td colspan="3" class="text-center text-body-secondary py-1">⋯</td>
                            </tr>
                            {{ _self.board_row(self_row, tab, board, true) }}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
